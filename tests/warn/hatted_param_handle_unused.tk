fn payload_only(*s: string) -> i32 {
    return s.len() as i32
}

fn handle_used(*s: string) -> bool {
    return *s == null
}

fn accept_raw(*s: string) -> bool {
    return *s == null
}

fn handle_forwarded(*s: string) -> bool {
    return accept_raw(*s)
}

fn main() -> i32 {
    return 0
}

