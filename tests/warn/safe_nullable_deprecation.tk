shape Cell(value: i32)
shape LegacyPayload(value: i32?)

fn legacy_unique(nul ^p: Cell) -> bool {
    guard ^p { return true } else { return false }
}

fn legacy_shared(nul ~p: Cell) -> bool {
    guard ~p { return true } else { return false }
}

fn raw_ffi_remains(nul *p: Cell) -> bool {
    return *p == null
}

fn main() -> i32 {
    auto value = none:i32?
    if value == none { return 0 }
    return 1
}

