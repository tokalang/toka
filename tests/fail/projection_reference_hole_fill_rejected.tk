// CHECK: error[E0410]
import core/traits::{@Encap}

shape Token(pub id: i32)

impl Token@Encap {

    fn drop(self#) {}
}

shape Pair(left: Token, right: Token)

fn fill_hole() -> i32 {
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    auto taken = cede pair.left
    
    // pair.left is Moved. Borrowing partially-moved aggregate is rejected.
    auto &borrow# = &pair
    borrow.left = Token(id = 3)
    return pair.right.id
}
