shape Cell(value: i32)

fn borrow_identity<'T>('value: T) -> &'T
where:
    'T: morphology borrow_extendable
effects: return <- 'value {
    return &'value
}

// EXPECT: error[E0621]
fn main() -> i32 {
    auto ^owner = new Cell(value = 1)
    auto &^view = &^owner
    auto invalid = borrow_identity<&^Cell>(&^owner)
    return view.value
}
