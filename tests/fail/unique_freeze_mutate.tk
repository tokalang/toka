// tests/fail/fail_unique_freeze_mutate.tk

fn main() -> i32 {
    auto ^#p = new i32(10)
    
    // Borrow p (locks the handle from replacement)
    auto &x = &p

    // ERROR: Cannot replace 'p' while it is borrowed
    ^#p = new i32(20) // EXPECT: error[E0442]:

    // Use x
    return x
}

// EXPECT: cannot modify 'p' while it is borrowed
