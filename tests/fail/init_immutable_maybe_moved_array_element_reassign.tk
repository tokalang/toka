// CHECK: error[E04572]
import core/traits::{@Encap}

shape Token(id: i32)

impl Token@Encap {
    pub id
    fn drop(self#) {}
}

fn update(flag: bool) -> i32 {
    auto values = [Token(id = 1), Token(id = 2)]
    if flag {
        auto taken = cede values[0]
    }
    values[0] = Token(id = 3)
    return values[1].id
}
