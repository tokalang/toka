// CHECK: error[E04629]
shape BuildOutcome(
    Ok(i32) |
    Err(i32)
)

fn try_build(init out: i32) -> BuildOutcome
outcomes:
    Ok => out: init
    Err => out: uninit
{
    init out = 42:i32
    return BuildOutcome::Ok(0)
}

fn main() {
    auto value = uninit:i32
    auto result = try_build(init value)
}
