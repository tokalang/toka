import core/task::{TaskHandle}

shape Stream (
    val#: i32
)

impl Stream {
    pub fn read_task(self#) -> TaskHandle<i32> {
        auto t = self#.read_impl()
        return cede t // EXPECT: error[E0454]:
    }

    fn read_impl(self#) -> async i32 {
        return self.val
    }
}

fn main() -> i32 {
    return 0
}
