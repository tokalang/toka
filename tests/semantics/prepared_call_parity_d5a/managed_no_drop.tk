import core/traits::{@Encap}

shape Managed(value: i32)

impl Managed@Encap {
    pub value
}

fn consume_managed(cede value: Managed) -> i32 {
    auto moved = cede value
    return moved.value
}

fn main() -> i32 {
    auto value = Managed(value = 42:i32)
    return consume_managed(value) - 42:i32
}
