// First-batch raw_take rejects this unqualified legacy generic shared ABI.
auto drops# = 0
shape Token(value: i32)
impl Token@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
fn roundtrip<T>(cede value: T) {
    auto *buffer# = unsafe alloc [1] T
    unsafe { buffer[0] = cede value }
    auto result = unsafe raw_take buffer[0]
    unsafe free [0] *buffer
}
fn main() -> i32 {
    {
        auto ^owner = new Token(value = 11)
        roundtrip<^Token>(cede ^owner)
        if drops != 1 { return 1 }
    }
    if drops != 1 { return 2 }
    {
        auto ~owner = new Token(value = 22)
        auto ~other = ~owner
        {
            roundtrip<~Token>(cede ~owner)
            if drops != 1 { return 3 }
        }
        if drops != 1 || other.value != 22 { return 4 }
    }
    if drops != 2 { return 5 }
    return 0
}
