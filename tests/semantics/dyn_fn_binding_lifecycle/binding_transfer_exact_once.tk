import core/traits::{@Encap}

auto drops# = 0:i32

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {
        drops += 1:i32
    }
}

fn main() -> i32 {
    {
        auto token = Token(value = 5:i32)
        auto callback = { [cede token] value =>
            return value + token.value
        }:dyn fn(i32) -> i32
        auto moved = cede callback
        if moved(7:i32) != 12:i32 { return 1:i32 }
        if drops != 0:i32 { return 2:i32 }
    }
    if drops != 1:i32 { return 3:i32 }
    return 0:i32
}
