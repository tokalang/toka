import core/intrinsics/thread_handoff_probe::{__toka_thread_probe_run}
fn main() -> i32 {
    auto callback = { => "static" }:dyn fn() -> str
    auto rejected = __toka_thread_probe_run<str, dyn fn() -> str>(cede callback)
    auto still_live = callback()
    return still_live.byte_count() as i32
}
