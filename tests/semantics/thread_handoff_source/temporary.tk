import core/intrinsics/thread_handoff_probe::{__toka_thread_probe_run, __toka_thread_probe_discard}
auto drops# = 0
shape Token(value: i32)
impl Token@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
impl Token@Send {}
fn main() -> i32 {
    auto value = Token(value = 7)
    auto result = __toka_thread_probe_run<i32, dyn fn() -> i32>(
        { [cede value] => value.value }:dyn fn() -> i32)
    if result != 7 || drops != 1 { return 1 }
    auto other = Token(value = 9)
    __toka_thread_probe_discard<i32, dyn fn() -> i32>(
        { [cede other] => other.value }:dyn fn() -> i32)
    if drops != 2 { return 2 }
    return 0
}
