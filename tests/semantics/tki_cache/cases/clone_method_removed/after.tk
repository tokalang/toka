// After: the public explicit clone method is removed.
import core/traits::{@Encap}

pub shape Resource(value: i32)

impl Resource@Encap {
    fn drop(self#) {}
}

pub fn make_resource() -> Resource {
    return Resource(value = 3)
}

pub fn read_resource(resource: Resource) -> i32 {
    return resource.value
}
