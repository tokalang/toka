shape Counter(reads#: i32, ordinary: i32)
fn main() -> i32 {
    auto ~counter = new Counter(reads = 0, ordinary = 9)
    auto values = [cede ~counter]:[~Counter; 1]
    for alias ~x in values {
        x.reads = 10
        assert(x.reads == 10 && x.ordinary == 9, "only declared interior field writable")
    }
    return 0
}
