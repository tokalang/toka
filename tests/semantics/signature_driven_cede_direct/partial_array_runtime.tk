import core/traits::{@Encap}

auto g_drops# = 0:i32

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {
        g_drops += 1:i32
    }
}

fn consume(cede value: Token) -> i32 {
    auto moved = cede value
    return moved.value
}

fn main() -> i32 {
    {
        auto values = [Token(value = 7:i32); 2]:[Token; 2]
        auto first = consume(values[0])
        if first + values[1].value != 14:i32 { return 1:i32 }
    }
    return g_drops - 2:i32
}
