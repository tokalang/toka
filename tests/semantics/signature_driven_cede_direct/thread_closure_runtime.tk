import core/traits::{@Encap}
import std/thread::{thread_spawn}

auto g_drops# = 0:i32

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {
        g_drops += 1:i32
    }
}

fn main() -> i32 {
    auto token = Token(value = 17:i32)
    auto worker = { [cede token] =>
        auto result = token.value
        return cede result
    }:fn() -> cede i32
    auto handle# = thread_spawn<i32>(worker)
    auto result = handle#.join()
    if result.is_err() { return 1:i32 }
    if result.unwrap() != 17:i32 { return 2:i32 }
    if g_drops != 1:i32 { return 3:i32 }
    return 0:i32
}
