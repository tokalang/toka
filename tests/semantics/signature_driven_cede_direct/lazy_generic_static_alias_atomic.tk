import core/traits::{@Encap}

shape Token(value: i32)
impl Token@Encap { fn drop(self#) {} }
shape GenericRunner<'T>()

impl<'T> GenericRunner<'T> {
    fn combine(cede left: T, cede right: T) -> i32 {
        auto moved_left = cede left
        auto moved_right = cede right
        return 0:i32
    }
}

fn main() -> i32 {
    auto token = Token(value = 1:i32)
    auto result = GenericRunner<Token>::combine(token, token)
    return token.value + result
}
