shape Cell(value: i32)
shape Consumer()

impl Consumer {
    fn consume(self, cede ^cell: Cell) -> i32 {
        auto ^owned = cede ^cell
        return owned.value
    }
}

fn main() -> i32 {
    auto consumer = Consumer()
    auto ^source = new Cell(value = 1:i32)
    return consumer.consume(^source)
}
