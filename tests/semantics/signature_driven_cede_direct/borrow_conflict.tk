import core/traits::{@Encap}

shape Resource(value: i32)

impl Resource@Encap {
    fn drop(self#) {}
}

fn consume(cede value: Resource) -> i32 {
    auto moved = cede value
    return moved.value
}

fn main() -> i32 {
    auto resource = Resource(value = 4:i32)
    auto &view = &resource
    auto value = consume(resource)
    return value + view.value
}
