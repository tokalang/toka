import core/traits::{@Callable}

shape Cell(value: i32)
shape Token(^cell: Cell)
shape Consumer()

impl Consumer@Callable {
    fn call(self, cede token: Token) -> i32 {
        auto owned = cede token
        return owned.cell.value
    }
}

fn main() -> i32 {
    auto consumer = Consumer()
    auto ^cell = new Cell(value = 29:i32)
    auto source = Token(^cell = ^cell)
    auto first = consumer(source)
    auto second = consumer(Token(^cell = new Cell(value = 13:i32)))
    return first + second - 42:i32
}
