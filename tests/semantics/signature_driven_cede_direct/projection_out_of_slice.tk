import core/traits::{@Encap}

shape Resource(value: i32)
shape Holder(inner: Resource)

impl Resource@Encap {
    fn drop(self#) {}
}

fn consume(cede value: Resource) -> i32 {
    auto moved = cede value
    return moved.value
}

fn main() -> i32 {
    auto holder = Holder(inner = Resource(value = 1:i32))
    return consume(holder.inner)
}
