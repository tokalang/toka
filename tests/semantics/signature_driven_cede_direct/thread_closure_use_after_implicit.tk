import core/traits::{@Encap}
import std/thread::{thread_spawn}

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {}
}

fn main() -> i32 {
    auto token = Token(value = 17:i32)
    auto worker = { [cede token] =>
        auto result = token.value
        return cede result
    }:dyn fn() -> i32
    auto spawned = thread_spawn<i32>(cede worker)
    return worker()
}
