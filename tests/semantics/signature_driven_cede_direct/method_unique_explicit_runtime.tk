shape Cell(value: i32)
shape Consumer()

impl Consumer {
    fn take(self, cede ^cell: Cell) -> i32 {
        auto ^owned = cede ^cell
        return owned.value
    }
}

fn main() -> i32 {
    auto consumer = Consumer()
    auto ^source = new Cell(value = 23:i32)
    return consumer.take(cede ^source) - 23:i32
}
