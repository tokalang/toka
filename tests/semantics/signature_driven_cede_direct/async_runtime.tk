import core/traits::{@Encap}
import std/task::{block_on}

auto g_drops# = 0:i32

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {
        g_drops += 1:i32
    }
}

fn consume_async(cede token: Token) -> async i32 {
    auto owned = cede token
    return owned.value
}

fn consume_pair_async(cede left: Token, cede right: Token) -> async i32 {
    auto moved_left = cede left
    auto moved_right = cede right
    return moved_left.value + moved_right.value
}

fn main() -> i32 {
    auto first = Token(value = 7:i32)
    auto first_task = consume_async(first).start
    if block_on<i32>(first_task) != 7:i32 { return 1:i32 }
    if g_drops != 1:i32 { return 2:i32 }

    auto left = Token(value = 11:i32)
    auto right = Token(value = 13:i32)
    auto pair_task = consume_pair_async(left, right).start
    if block_on<i32>(pair_task) != 24:i32 { return 3:i32 }
    if g_drops != 3:i32 { return 4:i32 }
    return 0:i32
}
