import core/traits::{@Callable}

shape Cell(value: i32)
shape Consumer()

impl Consumer@Callable {
    fn call(self, cede ^cell: Cell) -> i32 {
        auto ^owned = cede ^cell
        return owned.value
    }
}

fn main() -> i32 {
    auto consumer = Consumer()
    auto ^source = new Cell(value = 7:i32)
    return consumer(^source) - 7:i32
}
