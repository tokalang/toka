import std/sync::{Mutex, RwMutex}
auto drops# = 0
shape Token(value#: i32)
impl Token@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
impl Token@Send {}
impl Token@Sync {}
shape WritableView<'T>(&'value#: T)
fn main() -> i32 {
    {
        auto ^item# = new Token(value = 17)
        auto mutex = Mutex<^Token#>::new(cede ^item)
        {
            auto locked = mutex.lock().unwrap()
            WritableView<^Token#>(&value = locked.borrow_mut())
            auto &^value# = locked.borrow_mut()
            if value.value != 17 || drops != 0 { return 1 }
            value.value = 18
        }
        auto locked = mutex.lock().unwrap()
        auto &^value = locked.borrow_mut()
        if value.value != 18 || drops != 0 { return 2 }
    }
    if drops != 1 { return 3 }
    {
        auto ^item# = new Token(value = 21)
        auto mutex = RwMutex<^Token#>::new(cede ^item)
        {
            auto locked = mutex.write_lock().unwrap()
            auto &^value# = locked.borrow_mut()
            value.value = 22
        }
        auto locked = mutex.read_lock().unwrap()
        auto &^value = locked.borrow()
        if value.value != 22 || drops != 1 { return 4 }
    }
    if drops != 2 { return 5 }
    return 0
}
