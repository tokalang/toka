import std/sync::Mutex
import std/thread::thread_spawn
auto drops# = 0
shape Cell(value: i32)
impl Cell@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
impl Cell@Send {}
impl Cell@Sync {}
fn main() -> i32 {
    {
        auto initial = Cell(value = 7)
        auto ~mutex = Mutex<Cell>::make_shared(cede initial)
        auto ~worker_mutex = ~mutex
        auto callback = { [cede ~worker_mutex] =>
            auto locked = worker_mutex.lock().unwrap()
            auto &slot# = locked.borrow_mut()
            slot = Cell(value = 9)
            return 0
        }:dyn fn() -> i32
        auto created = thread_spawn<i32>(cede callback)
        auto handle# = created.unwrap()
        if handle#.join().unwrap() != 0 { return 1 }
        if drops != 1 { return 2 }
        auto locked = mutex.lock().unwrap()
        auto &slot = locked.borrow_mut()
        if slot.value != 9 { return 3 }
    }
    if drops != 2 { return 4 }
    return 0
}
