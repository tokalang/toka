import std/vec::{Vec}
import core/task::{TaskHandle}

fn worker(x: i32) -> async i32 {
    return x * 2
}

pub fn main() -> i32 {
    auto v# = Vec<TaskHandle<i32>>::new()
    auto t1 = worker(10:i32)
    auto t2 = worker(20:i32)
    
    // Pushing owned tasks into container
    v#.push(cede t1)
    v#.push(cede t2)
    
    if v.len() != 2 { return 1 }
    return 0
}
