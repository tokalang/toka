import std/vec::{Vec}
import core/task::{TaskHandle}
shape Buffer(size: i32, tag: i32)
fn process_chunk(buf: Buffer, chunk_id: i32) -> async i32 { return buf.size + chunk_id }
fn discard(cede task: TaskHandle<i32>) { auto owned = cede task }
fn main() -> i32 {
 auto buf = Buffer(size = 100:i32, tag = 1:i32)
 auto task = process_chunk(buf, 1:i32)
 discard(cede task)
 return 0:i32
}
