shape Pair(left: i32, right: i32)

impl i32 {
    fn inspect(self) -> i32 {
        return self
    }
}

fn main() -> i32 {
    auto pair = Pair(left = 3, right = 4)
    auto values = [5, 6]
    auto member_value = pair.left.inspect()
    auto index_value = values[0].inspect()
    return member_value + index_value - 8:i32
}
