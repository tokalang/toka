import core/traits::{@Encap}

shape Pair(left: i32, right: i32)
shape Resource(value: i32)

impl Resource@Encap {
    fn drop(self#) {}
}

fn consume(cede value: i32) -> i32 {
    auto moved = cede value
    return moved
}

fn consume_pair(cede value: Pair) -> i32 {
    auto moved = cede value
    return moved.left + moved.right
}

fn consume_resource(cede value: Resource) -> i32 {
    auto moved = cede value
    return moved.value
}

fn main() -> i32 {
    auto plain = 40:i32
    auto first = consume(plain)
    auto second = consume(2:i32)
    assert(plain == 40:i32, "implicit CopyValue must keep the source live")
    auto pair = Pair(left = 20:i32, right = 22:i32)
    auto pair_value = consume_pair(pair)
    assert(pair.left == 20:i32, "Copy aggregate must remain live")
    auto resource_value = consume_resource(cede Resource(value = 42:i32))
    return first + second + pair_value + resource_value - 126:i32
}
