fn consume_raw(cede *value: i32) -> i32 {
    auto *owned = cede *value
    return owned
}

fn relay(cede *value: i32) -> i32 {
    auto &borrow = &*value
    auto result = consume_raw(cede *value)
    return result + borrow - borrow
}

fn main() -> i32 {
    auto value# = 9:i32
    return relay(cede *value) - 9:i32
}
