import core/task::{TaskHandle}

pub shape RefCarrier(pub &view: i32, pub token: i32)

pub fn mix_explicit_dep(r: i32, cede c: RefCarrier) -> async i32 <- r {
    auto owned = cede c
    return r + owned.view + owned.token
}

pub fn escape_via_explicit_dep(outer: i32) -> TaskHandle<i32> <- outer {
    auto local = 99:i32
    auto c = RefCarrier(&view = &local, token = 1:i32)
    return mix_explicit_dep(outer, cede c)
}

pub fn main() -> i32 {
    return 0:i32
}
