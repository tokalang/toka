import core/task::{TaskHandle}
shape Buffer ( size: i32, tag: i32 )
shape TwoTasks ( borrowed_t#: TaskHandle<i32>, owned_t#: TaskHandle<i32> )
fn process_chunk(b: Buffer, chunk_id: i32) -> async i32 <- b {
    return b.size + chunk_id
}
fn dummy() -> async i32 { return 42:i32 }
pub fn test() -> async i32 {
    auto buf = Buffer(size = 100:i32, tag = 1:i32)
    auto c = TwoTasks(
        borrowed_t = process_chunk(buf, 1:i32),
        owned_t = dummy()
    )
    c.owned_t.start
    return c.borrowed_t.await
}
pub fn main() -> i32 { return 0:i32 }
