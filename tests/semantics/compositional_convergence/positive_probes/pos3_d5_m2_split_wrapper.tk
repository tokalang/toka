import std/async::{TaskScope, spawn_scoped, join_scoped}
import core/task::{TaskHandle}
shape Buffer ( size: i32, tag: i32 )
fn process_chunk(b: Buffer, chunk_id: i32) -> async i32 <- b {
    return b.size + chunk_id
}
pub fn split_wrapper(scope#: TaskScope, cede t: TaskHandle<i32>) -> TaskHandle<i32> <- t {
    auto h = spawn_scoped<i32>(scope#, cede t)
    return cede h
}
pub fn test_pos3() -> async i32 {
    auto buf = Buffer(size = 100:i32, tag = 1:i32)
    auto s# = TaskScope::new()
    auto t = process_chunk(buf, 1:i32)
    auto h = split_wrapper(s#, cede t)
    join_scoped(s#).await
    return 0:i32
}
pub fn main() -> i32 { return 0:i32 }
