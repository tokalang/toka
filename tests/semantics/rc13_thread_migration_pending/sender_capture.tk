// Pending positive: owning a Sender is not a new permission or unsafe escape.
// Currently rejected at thread_spawn with EnvironmentLifetimeUnproven.
// Do not register its current rejection as a successful negative oracle.
import std/channel::{channel}
import std/thread::{thread_spawn}
fn main() -> i32 {
    auto pair# = channel<i32>()
    auto sender = pair.tx#.clone()
    auto worker = { [cede sender] =>
        auto local# = cede sender
        local#.send(7).unwrap()
        return 0
    }
    auto handle# = thread_spawn<i32>(cede worker).unwrap()
    assert(pair.rx#.recv().unwrap().unwrap() == 7, "delivered")
    assert(handle#.join().unwrap() == 0, "joined")
    return 0
}
