shape Packet<'T>(Empty | Value('T))
shape Direct<'Unused>(Empty | Value(cede fn() -> i32))

fn main() -> i32 {
    auto once = { => 7 }:cede fn() -> i32
    auto packet = Packet<cede fn() -> i32>::Value(cede once)
    auto moved = cede packet
    auto another = { => 8 }:cede fn() -> i32
    auto direct = Direct<i32>::Value(cede another)
    auto direct_moved = cede direct
    return 0
}
