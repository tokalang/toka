import std/hashmap::{Entry, HashMapIterator}
import std/vec::{Vec}
extern fn run_raw_probe() -> i32
pub fn raw_probe(*key: [*i32], *val: i32) -> i32 {
    auto entry = unsafe Entry<*i32, i32>(*key = (*key as **i32), *val = *val)
    auto **k = entry.key()
    auto *v = entry.val()
    if k != 5 || v != 9 { return 1 }
    auto meta# = Vec<u8>::new()
    meta#.push(1)
    {
        auto cursor# = unsafe HashMapIterator<*i32, i32>(
            &keys = (*key as &[*i32]), &vals = ((*val as *[i32]) as &[i32]),
            &meta = (meta.*buf as &[u8]), cap = 1, pos = 0)
        auto result = cursor#.next()
        auto item = result.unwrap()
        auto **raw = item.key()
        auto *plain = item.val()
        if raw != 5 || plain != 9 { return 3 }
        if cursor#.next().is_some() { return 4 }
    }
    {
        auto cursor# = unsafe HashMapIterator<i32, *i32>(
            &keys = ((*val as *[i32]) as &[i32]), &vals = (*key as &[*i32]),
            &meta = (meta.*buf as &[u8]), cap = 1, pos = 0)
        auto result = cursor#.next()
        auto item = result.unwrap()
        auto *plain = item.key()
        auto **raw = item.val()
        if raw != 5 || plain != 9 { return 5 }
    }
    return 0
}
fn main() -> i32 {
    auto key = 5:i32
    auto val = 9:i32
    auto *key_ptr = unsafe (&key as *i32)
    auto *val_ptr = unsafe (&val as *i32)
    auto entry = Entry<i32, i32>(*key = *key_ptr, *val = *val_ptr)
    auto *k = entry.key()
    auto *v = entry.val()
    if k != 5 || v != 9 { return 2 }
    return run_raw_probe()
}
