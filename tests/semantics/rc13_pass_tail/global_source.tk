import ../tki_replay/cases/permission_005_partial_cede_lifecycle/lib::{make_pair}

auto drops# = 0:i32

fn global_pair() -> i32 {
    {
        auto pair = make_pair(drops#)
        if pair.left.id + pair.right.id != 3 { return 1 }
    }
    return drops - 2
}

fn main() -> i32 {
    {
        auto drops# = 0:i32
        {
            auto pair = make_pair(drops#)
            if pair.left.id + pair.right.id != 3 { return 2 }
        }
        if drops != 2 { return 3 }
    }
    return global_pair()
}
