auto trace# = 0
shape Token(id: i32)
impl Token@Encap {
    pub id
    fn drop(self#) { trace = trace * 10 + self.id }
}
fn main() -> i32 {
    {
        auto first = Token(id = 1)
        auto target# = { [cede first] => first.id }:dyn fn() -> i32
        auto second = Token(id = 2)
        auto incoming = { [cede second] => second.id }:dyn fn() -> i32
        target = cede incoming
        if trace != 1 || target() != 2 { return 1 }
        auto copied = target
        cede target
        if trace != 1 || copied() != 2 { return 2 }
        cede copied
        if trace != 12 { return 3 }
        auto third = Token(id = 3)
        auto once# = { [cede third] =>
            auto value = cede third
            return value.id
        }:cede dyn fn() -> i32
        auto fourth = Token(id = 4)
        auto replacement = { [cede fourth] =>
            auto value = cede fourth
            return value.id
        }:cede dyn fn() -> i32
        once = cede replacement
        if trace != 123 { return 4 }
        auto moved = cede once
        auto result = cede moved()
        if result != 4 || trace != 1234 { return 5 }
        auto thin = { => 7 }:fn() -> i32
        auto thinCopy = thin
        if thin() != 7 || thinCopy() != 7 { return 6 }
    }
    if trace != 1234 { return 7 }
    return 0
}
