auto drops# = 0
shape Token(value: i32)
impl Token@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
fn later() -> dyn fn() -> i32 {
    auto token = Token(value = 7)
    return { [cede token] => token.value }:dyn fn() -> i32
}
fn main() -> i32 {
    {
        auto first = later()
        auto second = later()
        if first() != 7 || second() != 7 || drops != 0 { return 1 }
    }
    if drops != 2 { return 2 }
    return 0
}
