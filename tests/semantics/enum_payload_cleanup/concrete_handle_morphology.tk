// Unnamed enum payloads preserve both complete handle morphologies.
shape Resource(id: i32)
impl Resource@Encap { pub id fn drop(self#) {} }
shape Event(Both(^Resource, ~Resource) | Empty)
fn main() -> i32 {
    auto ^first = new Resource(id = 1)
    auto ~second = new Resource(id = 2)
    auto event = Event::Both(cede ^first, cede ~second)
    return 0
}
