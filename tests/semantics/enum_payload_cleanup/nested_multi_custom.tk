import core/option::{Option}
auto drops# = 0
auto hooks# = 0
shape Resource(id: i32)
impl Resource@Encap {
    pub id
    fn drop(self#) { drops += 1 }
}
shape Event<'A, 'B>(
    Both('A, 'B) |
    Nested(Option<'A>) |
    Empty
)
impl<'A, 'B> Event<'A, 'B>@Encap {
    fn drop(self#) { hooks += 1 }
}
fn main() -> i32 {
    {
        auto empty = Event<^Resource, ~Resource>::Empty()
    }
    if hooks != 1 || drops != 0 { return 1 }
    {
        auto ^first = new Resource(id = 1)
        auto ~second = new Resource(id = 2)
        auto ~other = ~second
        {
            auto event = Event<^Resource, ~Resource>::Both(cede ^first, cede ~second)
        }
        if hooks != 2 { return 20 + (hooks as i32) }
        if drops != 1 { return 40 + (drops as i32) }
        if other.id != 2 { return 60 + other.id }
    }
    if drops != 2 { return 3 }
    {
        auto ^owner = new Resource(id = 3)
        auto nested = Option<^Resource>::Some(cede ^owner)
        auto event = Event<^Resource, ~Resource>::Nested(cede nested)
    }
    if hooks != 3 || drops != 3 { return 4 }
    return 0
}
