import std/slab::Slab

shape Item(value: i32)

fn main() -> i32 {
    auto slab# = Slab<Item>::new()
    auto id = slab#.insert(Item(value = 10))
    auto value# = 0:i32
    {
        match slab.lookup(id.clone()) {
            auto &item => {
                value = item.value
            }
            miss => return 1
        }
    }
    assert(value == 10, "read value during loan")
    auto removed = slab#.remove(id.clone())
    assert(removed.is_some(), "remove after loan ended succeeds")
    assert(slab#.remove(id.clone()).is_none(), "second remove misses")
    slab#.clear()
    assert(slab.get(id).is_none(), "id dead after clear")
    return 0
}
