// The harness appends the exact FromJson declaration/implementations from json.tk.
import stdx/serde/json_leaf::{parse_i32_value, parse_string_value, parse_str_view}
fn main() -> i32 {
    auto number# = 77:i32
    if !number#.parse_json("-x").is_err() || number != 77 { return 21 }
    if !number#.parse_json("12tail").unwrap().equals("tail") || number != 12 { return 22 }
    auto text# = string::from("old")
    if !text#.parse_json("\"prefix\\u1\"").is_err() || !text.as_str().equals("old") { return 23 }
    if !text#.parse_json("\"new\"!").unwrap().equals("!") || !text.as_str().equals("new") { return 24 }
    auto view# = "old"
    if !view#.parse_json("\"a\\n\"!").unwrap().equals("!") || !view.equals("a\\n") { return 25 }
    return 0
}
