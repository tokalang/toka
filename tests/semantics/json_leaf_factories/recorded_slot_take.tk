auto drops# = 0:i32
shape Item(nul *marker: i32, id: i32)
impl Item@Encap {
    pub marker, id
    fn drop(self#) { drops += 1 }
}
fn main() -> i32 {
    auto *storage# = unsafe alloc [1] Item
    auto item = Item(*marker = null, id = 7)
    unsafe {
        storage[0] = cede item
        auto taken = raw_take storage[0]
        if taken.id != 7 || drops != 0 { return 1 }
        free [0] *storage
    }
    if drops != 1 { return 2 }
    return 0
}
