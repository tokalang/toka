fn inspect(value: i32) -> i32 {
    return value
}

fn main() -> i32 {
    auto callback = { left, right =>
        auto owned_left = cede left
        auto owned_right = cede right
        return owned_left + owned_right
    }:
        fn(cede i32, cede i32) -> i32
    auto first = 1:i32
    auto second = 2:i32
    auto rejected = callback(cede first, second)
    return inspect(first) + inspect(second) + rejected
}
