shape Pair(left#:i32, right#:i32)
fn replace<T>(&slot#:T, cede incoming:T) { slot = cede incoming }
fn test(choose:bool) -> i32 {
    auto pair# = Pair(left=1, right=2)
    auto &#held = &(pair.left)
    if choose { &held = &(pair.right) }
    auto next = 7:i32
    replace<i32>(&(pair.right), cede next)
    return held + next + pair.right
}
fn main() -> i32 { return test(false) }
