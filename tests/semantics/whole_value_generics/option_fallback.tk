auto drops# = 0
shape Resource(value:i32)
impl Resource@Encap {
    pub value
    fn drop(self#) { drops += 1 }
}
fn main() -> i32 {
    {
        auto present = Option<Resource>::Some(Resource(value=7))
        auto fallback = Option<Resource>::Some(Resource(value=9))
        auto result = present.unwrap_or(cede fallback)
        if result.value != 7 || drops != 1 { return 1 }
    }
    if drops != 2 { return 2 }
    {
        auto absent = Option<Resource>::None
        auto fallback = Option<Resource>::Some(Resource(value=11))
        auto result = absent.unwrap_or(cede fallback)
        if result.value != 11 || drops != 2 { return 3 }
    }
    if drops != 3 { return 4 }
    auto number = 17:i32
    auto absent = Option<&i32>::None
    auto fallback = Option<&i32>::Some(&number)
    auto &result = absent.unwrap_or(cede fallback)
    if result != 17 { return 5 }
    return 0
}
