import std/vec::{Vec}

fn main() -> i32 {
    auto owner# = string::from("local")
    auto values# = Vec<str>::new()
    values#.push(owner.as_str())
    auto replacement# = Vec<str>::new()
    replacement#.push("static")
    values = cede replacement
    owner#.push_str("!")
    if !owner.as_str().equals("local!") ||
       !values.borrow(0:usize).equals("static") { return 1 }
    return 0
}
