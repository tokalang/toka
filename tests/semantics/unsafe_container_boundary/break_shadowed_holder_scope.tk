import std/vec::{Vec}

fn main() -> i32 {
    auto owner# = string::from("outer")
    loop {
        auto owner# = string::from("inner")
        auto values# = Vec<str>::new()
        values#.push(owner.as_str())
        break
    }
    owner#.push_str("!")
    if !owner.as_str().equals("outer!") { return 1 }
    return 0
}
