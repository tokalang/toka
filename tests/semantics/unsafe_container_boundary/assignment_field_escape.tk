import std/vec::{Vec}
import core/string::{string}

shape Box(values#: Vec<str>)

fn escaped() -> Box {
    auto owner = string::from("local")
    auto box# = Box(values = Vec<str>::new())
    auto right# = Vec<str>::new()
    right#.push(owner.as_str())
    box.values = cede right
    return cede box
}

fn main() -> i32 { return 0 }
