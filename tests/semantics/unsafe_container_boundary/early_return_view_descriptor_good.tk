import std/vec::{Vec}

auto observed# = 0:i32
shape Watch(view: str)
impl Watch@Encap {
    fn drop(self#) {
        if self.view.equals("local") { observed += 1:i32 }
    }
}

fn exercise(stop: bool) -> i32 {
    auto owner = string::from("local")
    auto values# = Vec<Watch>::new()
    auto descriptor = owner.as_str()
    values#.push(Watch(view = descriptor))
    if stop { return 0 }
    cede values
    return 0
}

fn main() -> i32 {
    exercise(true)
    exercise(false)
    if observed != 2:i32 { return 1 }
    return 0
}
