import std/vec::{Vec}

fn main() -> i32 {
    auto owner# = string::from("local")
    auto first# = Vec<str>::new()
    auto second# = Vec<str>::new()
    first#.push(owner.as_str())
    second#.push(owner.as_str())
    cede first
    cede second
    owner#.push_str("!")
    if !owner.as_str().equals("local!") { return 1 }
    return 0
}
