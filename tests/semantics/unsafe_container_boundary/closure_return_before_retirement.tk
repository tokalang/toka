auto observed# = 0:i32
shape Watch(view: str)
impl Watch@Encap {
    fn drop(self#) {
        if self.view.equals("local") { observed += 1:i32 }
    }
}

fn main() -> i32 {
    auto callback = { =>
        auto holder# = Watch(view = "static")
        auto owner = string::from("local")
        holder = Watch(view = owner.as_str())
        return 0:i32
    }:fn() -> i32
    return 0
}
