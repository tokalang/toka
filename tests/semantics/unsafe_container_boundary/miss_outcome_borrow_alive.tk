shape View(&value: i32)

fn provide(value: i32) -> View | miss
effects:
    return <- value
{
    return View(&value = &value)
}

fn main() -> i32 {
    auto owner = 7:i32
    auto outcome = uninit:(View | miss)
    init outcome = provide(owner)
    match cede outcome {
        auto value => { if value.value != 7 { return 1 } }
        miss => return 2
    }
    return 0
}
