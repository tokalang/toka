diff --git a/src/Sema/Sema_Stmt.cpp b/src/Sema/Sema_Stmt.cpp
index e9fa3c0c..68383248 100644
--- a/src/Sema/Sema_Stmt.cpp
+++ b/src/Sema/Sema_Stmt.cpp
@@ -23,0 +24 @@
+#include <cstdlib>
@@ -897,0 +899,26 @@ void Sema::checkStmt(Stmt *S) {
+      if (std::getenv("TOKA_CONTAINER_DEP_TRACE") && CurrentFunction &&
+          CurrentFunction->Name == "escaped") {
+        Expr *source = Ret->ReturnValue.get();
+        if (auto *cede = dynamic_cast<CedeExpr *>(source))
+          source = cede->Value.get();
+        auto *variable = dynamic_cast<VariableExpr *>(source);
+        SymbolInfo *binding = nullptr;
+        if (variable && variable->ResolvedBindingID)
+          CurrentScope->findSymbolByID(variable->ResolvedBindingID, binding);
+        std::cerr << "TRACE return binding_id="
+                  << (variable ? variable->ResolvedBindingID : 0)
+                  << " tracked=" << isTrackedRet << " binding_life_deps=";
+        if (binding)
+          for (const auto &dep : binding->LifeDependencySet)
+            std::cerr << dep << ",";
+        std::cerr << " binding_field_deps=";
+        if (binding)
+          for (const auto &[field, deps] : binding->FieldDependencySet)
+            for (const auto &dep : deps)
+              std::cerr << field << "<-" << dep << ",";
+        std::cerr << " last_life_deps=";
+        for (const auto &dep : m_LastLifeDependencies)
+          std::cerr << dep << ",";
+        std::cerr << "\n";
+      }
