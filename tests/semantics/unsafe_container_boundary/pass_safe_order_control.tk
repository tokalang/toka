import std/vec::{Vec}

auto observed# = 0:i32
shape Watch(view: str)
impl Watch@Encap {
    fn drop(self#) {
        if self.view.equals("local") { observed += 1:i32 }
    }
}

fn exercise(stop: bool) -> i32 {
    auto result = match stop {
        true => {
            auto owner = string::from("local")
            auto values# = Vec<Watch>::new()
            values#.push(Watch(view = owner.as_str()))
            pass 0
        }
        _ => pass 1
    }
    return result
}

fn main() -> i32 {
    if exercise(true) != 0 { return 1 }
    if exercise(false) != 1 { return 2 }
    if observed != 1:i32 { return 3 }
    return 0
}
