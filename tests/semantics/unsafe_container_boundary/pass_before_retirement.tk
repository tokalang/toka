import std/vec::{Vec}

auto observed# = 0:i32
shape Watch(view: str)
impl Watch@Encap {
    fn drop(self#) {
        if self.view.equals("local") { observed += 1:i32 }
    }
}

fn exercise(stop: bool) -> i32 {
    auto result = match stop {
        true => {
            auto values# = Vec<Watch>::new()
            auto owner = string::from("local")
            values#.push(Watch(view = owner.as_str()))
            pass 0
        }
        _ => pass 1
    }
    return result
}

fn main() -> i32 { return 0 }
