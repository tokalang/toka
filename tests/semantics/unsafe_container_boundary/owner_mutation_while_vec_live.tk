import std/vec::{Vec}
import core/string::{string}
fn main() -> i32 {
    auto owner# = string::from("local")
    auto values# = Vec<str>::new()
    values#.push(owner.as_str())
    owner#.push_str(" force the borrowed character allocation to grow beyond its original capacity")
    auto &item = values.borrow(0:usize)
    if item.equals("local") { return 0 }
    return 1
}
