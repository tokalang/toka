shape Sink()

impl Sink {
    fn consume(self, cede value: i32) -> i32 {
        return cede value
    }
}

fn main() -> i32 {
    auto sink = Sink()
    auto value = 7:i32
    auto moved = sink.consume(cede unsafe value)
    auto literal = sink.consume(unsafe 1:i32)
    return moved + literal - 8:i32
}
