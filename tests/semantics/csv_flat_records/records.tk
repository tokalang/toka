import stdx/data/csv::{CsvRecords, parse_records, write_records}
import std/vec::{Vec}
fn owned_records() -> CsvRecords {
    auto input = string::from("left,right\r\none,two\r\n")
    auto result = parse_records(input.as_str())
    assert(result.is_ok(), "owned input parses")
    auto records = result.unwrap()
    return cede records
}
fn main() -> i32 {
    auto records# = owned_records()
    assert(records.len() == 2:usize, "two rows")
    assert(records.row_len(0:usize) == 2:usize, "two columns")
    assert(records.field(0:usize, 0:usize).as_str().equals("left"), "row order")
    assert(records.field(1:usize, 1:usize).as_str().equals("two"), "column order")
    auto single# = CsvRecords::new()
    auto row# = Vec<string>::new()
    row#.push(string::from("first"))
    row#.push(string::from("last"))
    single#.push(cede row)
    auto extracted = single#.take_single_row()
    assert(extracted.get(0:usize).as_str().equals("first"), "extract restores order")
    assert(extracted.get(1:usize).as_str().equals("last"), "extract retains last")
    assert(single.len() == 0:usize, "extraction empties rows")
    auto count# = 0:i32
    loop count < 100 {
        auto result = parse_records("a,\"b,c\"\r\n")
        assert(result.is_ok(), "success loop")
        auto data = result.unwrap()
        auto output = write_records(cede data)
        assert(output.as_str().equals("a,\"b,c\"\r\n"), "round trip")
        assert(parse_records("a,b\r\nc\r\n").is_err(), "partial-record failure")
        assert(parse_records("a,\"unterminated").is_err(), "unfinished-field failure")
        count += 1
    }
    return 0
}
