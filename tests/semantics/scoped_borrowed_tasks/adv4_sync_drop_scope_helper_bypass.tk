// STAGE2-D2b: N5 bypass - passing `cede scope` to a synchronous helper marks `scope.Moved = true` and drops `scope` without joining active child
import std/async::{TaskScope, spawn_scoped}
shape Buffer(size: i32, tag: i32)
fn worker(buf: Buffer) -> async i32 { return buf.size }
fn drop_scope(cede s: TaskScope) {
    auto _s = cede s
}
pub fn sync_drop_scope_bypass() -> i32 {
    auto buf = Buffer(size = 100:i32, tag = 1:i32)
    auto scope# = TaskScope::new()
    auto t1 = spawn_scoped<i32>(scope#, cede worker(buf))
    drop_scope(cede scope)
    return 0:i32
}
