import core/string::{string}
shape Holder(view: str)
impl Holder@Encap { pub view }
impl Holder {
    fn make(view: str) -> Holder <- view {
        auto result = Holder(view = view)
        return cede result
    }
}
fn main() -> i32 {
    auto owner = string::from("owner")
    auto direct = Holder(view = owner.as_str())
    auto factory = Holder::make(owner.as_str())
    if !direct.view.equals(factory.view) { return 1 }
    return 0
}
