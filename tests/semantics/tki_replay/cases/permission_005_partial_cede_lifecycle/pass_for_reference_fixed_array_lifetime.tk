import ./lib::{Token}

fn main() -> i32 {
    auto drops# = 0
    auto values = [Token(id = 1, &drops = &drops), Token(id = 2, &drops = &drops)]:[Token; 2]
    auto total# = 0
    for auto &value in values {
        total += value.id
    }
    if total != 3 { return 1 }
    auto taken = cede values[0]
    return taken.id - 1
}
