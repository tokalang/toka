// EXPECT_TKI: pub shape SecretBox(id: i32, secret: string)
// EXPECT_TKI: impl SecretBox@Encap
import core/traits::{@Encap}

pub shape SecretBox(id: i32, secret: string)

impl SecretBox@Encap {
    fn drop(self#) {}
}

pub fn make_box() -> SecretBox {
    return SecretBox(id = 7, secret = string::from("hidden"))
}

pub fn read_id(box: SecretBox) -> i32 {
    return box.id
}
