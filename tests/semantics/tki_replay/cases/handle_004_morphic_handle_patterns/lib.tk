// EXPECT_TKI: pub shape Item<T>(val: T)
// EXPECT_TKI: pub shape Carrier<T>(Value(T) = 1)
// EXPECT_TKI: pub shape RepeatCarrier<T>(Value(T) = 1)
// EXPECT_TKI: pub shape IndexCarrier<T>(Value(T) = 1)
// EXPECT_TKI: pub shape CedeCarrier<T>(Value(T) = 1)
// EXPECT_TKI_ROUNDTRIP

import core/traits::{@Encap, @Copy}

// Payload T is real data; its cleanup body is available under the existing
// retained-template policy. The native observer is one explicit external state
// instance, not a private global re-created by source-hidden replay.
extern fn replay_item_drop() -> void
extern fn item_drop_count() -> i32
pub shape Item<T>(val: T)
impl<T> Item<T>@Encap {
    pub val
    fn drop(self#) { replay_item_drop() }
}
impl<T: @Copy> Item<T> { pub fn read(self) -> T { return self.val } }

// T is a complete value, not an implicit request to dereference an unknown hat.
// Transport it here; inspect the concrete payload in the consumer.
pub shape Carrier<T>(Value(T) = 1)
impl<T> Carrier<T> where: T: morphology non_reference {
    pub fn unsafe_exact(cede self) -> T <- self {
        match cede self { auto Carrier<T>::Value(value) => return cede value }
    }
    pub fn rewrap(cede self) -> Carrier<T> {
        match cede self { auto Carrier<T>::Value(value) => return Carrier<T>::Value(cede value) }
    }
}
impl<T: @Copy> Carrier<T> where: T: morphology reference_only {
    pub fn unsafe_exact(cede self) -> T <- self {
        match cede self { auto Carrier<T>::Value(value) => return value }
    }
    pub fn rewrap(cede self) -> Carrier<T> <- self {
        match cede self { auto Carrier<T>::Value(value) => return Carrier<T>::Value(value) }
    }
}

pub shape RepeatCarrier<T>(Value(T) = 1)
impl<T> RepeatCarrier<T> where: T: morphology non_reference {
    pub fn unsafe_exact(cede self) -> T <- self {
        match cede self { auto RepeatCarrier<T>::Value(value) => return cede value }
    }
}
impl<T: @Copy> RepeatCarrier<T> where: T: morphology reference_only {
    pub fn unsafe_exact(cede self) -> T <- self {
        match cede self { auto RepeatCarrier<T>::Value(value) => return value }
    }
}
// Deliberately invalid when instantiated: the negative must reach a real
// second explicit move, not fail on an unbounded generic payload field read.
pub fn duplicate_move<T>(cede carrier: RepeatCarrier<T>) -> RepeatCarrier<T>
where: T: morphology non_reference {
    match cede carrier {
        auto RepeatCarrier<T>::Value(value) => {
            auto first = RepeatCarrier<T>::Value(cede value)
            cede first
            return RepeatCarrier<T>::Value(cede value)
        }
    }
}

pub shape IndexCarrier<T>(Value(T) = 1)
impl<T> IndexCarrier<T> where: T: morphology non_reference {
    pub fn unsafe_exact(cede self) -> T <- self {
        match cede self { auto IndexCarrier<T>::Value(value) => return cede value }
    }
}
pub shape CedeCarrier<T>(Value(T) = 1)
impl<T> CedeCarrier<T> where: T: morphology non_reference {
    pub fn unsafe_forward(cede self) -> T <- self {
        match cede self { auto CedeCarrier<T>::Value(value) => return cede value }
    }
}
