// SOURCE_BACKED_RUNTIME

import ./lib::{Carrier, Item}

fn main() -> i32 {
    auto ~value = new Item<i32>(val = 86)
    auto carrier = Carrier<~Item<i32>>::Value(~value)
    auto rewrapped = carrier.rewrap()
    auto ~result = rewrapped.unsafe_exact()
    assert(result.val == 86, "shared aggregate transport failed")
    return 0
}
