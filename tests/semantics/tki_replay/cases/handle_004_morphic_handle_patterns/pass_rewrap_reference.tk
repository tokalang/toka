// SOURCE_BACKED_RUNTIME

import ./lib::{Carrier, Item}

fn main() -> i32 {
    auto value = Item(val = 106)
    auto carrier = Carrier<&Item>::Value(&value)
    auto rewrapped = carrier.rewrap()
    auto &result = rewrapped.unsafe_exact()
    assert(result.val == 106, "reference aggregate transport failed")
    return 0
}
