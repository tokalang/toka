// SOURCE_BACKED_RUNTIME

import ./lib::{Carrier, Item}

fn main() -> i32 {
    auto value# = Item<i32>(val = 96)
    auto *ptr = *value as *Item<i32>
    auto carrier = Carrier<*Item<i32>>::Value(*ptr)
    auto rewrapped = carrier.rewrap()
    auto *result = rewrapped.unsafe_exact()
    assert(result.val == 96, "raw aggregate transport failed")
    return 0
}
