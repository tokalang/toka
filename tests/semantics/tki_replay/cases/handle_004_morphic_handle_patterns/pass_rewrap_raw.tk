// SOURCE_BACKED_RUNTIME

import ./lib::{Carrier, Item}

fn main() -> i32 {
    auto value# = Item(val = 96)
    auto *ptr = *value as *Item
    auto carrier = Carrier<*Item>::Value(*ptr)
    auto rewrapped = carrier.rewrap()
    assert(rewrapped.field() == 96, "raw aggregate transport failed")
    return 0
}
