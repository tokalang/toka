// SOURCE_BACKED_RUNTIME

import ./lib::{Carrier, Item}

fn main() -> i32 {
    auto ^value = new Item<i32>(val = 76)
    auto carrier = Carrier<^Item<i32>>::Value(cede ^value)
    auto rewrapped = carrier.rewrap()
    auto ^result = rewrapped.unsafe_exact()
    assert(result.val == 76, "unique aggregate transport failed")
    return 0
}
