// EXPECT_TKI: pub shape Vault<T>(id: i32, ^secret: T)
// EXPECT_TKI: impl<T> Vault<T>@Encap
import core/traits::{@Encap}

pub shape Vault<T>(id: i32, ^secret: T)

impl<T> Vault<T>@Encap {
    pub id
    fn drop(self#) {}
}

pub fn make_vault() -> Vault<i32> {
    return Vault<i32>(id = 7, ^secret = new i32(11))
}

pub fn read_id(vault: Vault<i32>) -> i32 {
    return vault.id
}
