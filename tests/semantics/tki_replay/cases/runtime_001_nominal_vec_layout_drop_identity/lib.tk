// EXPECT_TKI: pub shape Item(prefix: i64, label: string, suffix: i32)
// EXPECT_TKI: pub fn make_items() -> Vec<Item>
// EXPECT_TKI: pub fn drop_count() -> i32

import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

auto g_drop_count# = 0:i32

pub shape Item(
    prefix: i64,
    label: string,
    suffix: i32
)

impl Item@Encap {
    pub prefix, label, suffix

    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

pub fn make_items() -> Vec<Item> {
    auto items# = Vec<Item>::new()
    items#.push(cede Item(prefix = 101:i64, label = string::from("one"), suffix = 11:i32))
    items#.push(cede Item(prefix = 202:i64, label = string::from("two"), suffix = 22:i32))
    items#.push(cede Item(prefix = 303:i64, label = string::from("three"), suffix = 33:i32))
    items#.push(cede Item(prefix = 404:i64, label = string::from("four"), suffix = 44:i32))
    items#.push(cede Item(prefix = 505:i64, label = string::from("five"), suffix = 55:i32))
    items#.push(cede Item(prefix = 606:i64, label = string::from("six"), suffix = 66:i32))
    items#.push(cede Item(prefix = 707:i64, label = string::from("seven"), suffix = 77:i32))
    items#.push(cede Item(prefix = 808:i64, label = string::from("eight"), suffix = 88:i32))
    items#.push(cede Item(prefix = 909:i64, label = string::from("nine"), suffix = 99:i32))
    return cede items
}

pub fn drop_count() -> i32 {
    return g_drop_count
}
