// EXPECT_TKI: pub fn consume_payload(cede p: Payload) -> i32
import core/traits::{@Encap}

pub shape Payload(val: i32)

impl Payload@Encap {
    fn drop(self#) {}
}

impl Payload {
    pub fn new(val: i32) -> Payload {
        return Payload(val = val)
    }
}

pub fn consume_payload(cede p: Payload) -> i32 {
    auto moved = cede p
    return moved.val
}
