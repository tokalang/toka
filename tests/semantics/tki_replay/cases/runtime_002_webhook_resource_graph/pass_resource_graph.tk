import ./lib as remote

fn main() -> i32 {
    auto rejected# = remote::make_hooks(-1:i32)
    if !rejected.is_err() { return 1 }
    auto error# = (cede rejected).unwrap_err()
    if !error.as_str().equals("negative seed") { return 2 }
    if !remote::make_optional_hook(-1:i32).is_none() { return 3 }

    auto round# = 0:i32
    loop round < 32:i32 {
        auto built# = remote::make_hooks(round)
        if !built.is_ok() { return 10 }
        auto hooks# = (cede built).unwrap()

        if hooks.len() != 2:usize { return 11 }
        if hooks.borrow(0:usize).prefix != 10000:i64 + round as i64 ||
           hooks.borrow(0:usize).suffix != 10:i32 + round ||
           !hooks.borrow(0:usize).name.as_str().equals("alpha-hook") {
            return 12
        }
        if hooks.borrow(0:usize).bindings.len() != 2:usize ||
           hooks.borrow(0:usize).bindings.borrow(0:usize).ordinal != 1000:i64 + round as i64 ||
           hooks.borrow(0:usize).bindings.borrow(0:usize).tail != 10:i32 + round ||
           !hooks.borrow(0:usize).bindings.borrow(0:usize).enabled ||
           !hooks.borrow(0:usize).bindings.borrow(0:usize).source.as_str().equals("/tmp/a") ||
           !hooks.borrow(0:usize).bindings.borrow(0:usize).target.as_str().equals("/srv/first") {
            return 13
        }
        if hooks.borrow(0:usize).bindings.borrow(1:usize).ordinal != 1100:i64 + round as i64 ||
           hooks.borrow(0:usize).bindings.borrow(1:usize).tail != 110:i32 + round ||
           hooks.borrow(0:usize).bindings.borrow(1:usize).enabled ||
           !hooks.borrow(0:usize).bindings.borrow(1:usize).source.as_str().equals("/tmp/b") ||
           !hooks.borrow(0:usize).bindings.borrow(1:usize).target.as_str().equals("/srv/second") {
            return 14
        }
        if hooks.borrow(0:usize).rule_score() != 215:i32 { return 15 }

        auto optional# = remote::make_optional_hook(round)
        if optional.is_none() { return 16 }
        auto extra# = (cede optional).unwrap()
        if extra.prefix != 30000:i64 + round as i64 ||
           extra.suffix != 30:i32 + round ||
           !extra.name.as_str().equals("optional-hook") ||
           extra.rule_score() != 215:i32 {
            return 17
        }
        hooks#.push(cede extra)
        if hooks.len() != 3:usize { return 18 }

        auto removed_option# = hooks#.remove(1:usize)
        if removed_option.is_none() { return 19 }
        auto removed# = (cede removed_option).unwrap()
        if removed.prefix != 20000:i64 + round as i64 ||
           removed.suffix != 20:i32 + round ||
           !removed.name.as_str().equals("beta-hook") ||
           removed.bindings.borrow(0:usize).ordinal != 2000:i64 + round as i64 ||
           removed.rule_score() != 215:i32 {
            return 20
        }

        auto returned_option# = remote::roundtrip_hook(cede removed)
        if returned_option.is_none() { return 21 }
        auto returned# = (cede returned_option).unwrap()
        hooks#.push(cede returned)

        auto forwarded_result# = remote::roundtrip_hooks(cede hooks)
        if forwarded_result.is_err() { return 22 }
        auto forwarded# = (cede forwarded_result).unwrap()
        if forwarded.len() != 3:usize { return 23 }
        if forwarded.borrow(0:usize).prefix != 10000:i64 + round as i64 ||
           forwarded.borrow(1:usize).prefix != 30000:i64 + round as i64 ||
           forwarded.borrow(2:usize).prefix != 20000:i64 + round as i64 {
            return 24
        }

        {
            auto discarded# = forwarded#.remove(1:usize).unwrap()
            if !discarded.name.as_str().equals("optional-hook") ||
               discarded.bindings.borrow(1:usize).tail != 130:i32 + round {
                return 25
            }
        }
        if forwarded.len() != 2:usize ||
           forwarded.borrow(1:usize).rule_score() != 215:i32 {
            return 26
        }
        forwarded#.clear()
        if !forwarded.is_empty() { return 27 }

        round += 1:i32
    }
    return 0
}
