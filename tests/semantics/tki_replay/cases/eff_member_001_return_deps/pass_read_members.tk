// EXPECT_EVIDENCE: EFF-MEMBER-001
import ./lib::{Engine, split_engines}

fn main() -> i32 {
    auto e1# = Engine(val = 3)
    auto e2# = Engine(val = 4)
    auto refs = split_engines(e1, e2)
    if refs.first != 3 {
        return 1
    }
    if refs.second != 4 {
        return 2
    }
    return 0
}
