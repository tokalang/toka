// EXPECT_TKI: pub shape Parcel<T>(^item: T)
// EXPECT_TKI: pub fn forward(cede self: Self) -> Self
// EXPECT_TKI: pub fn forward_parcel<T>(cede parcel: Parcel<T>) -> Parcel<T>
import core/traits::{@Encap}

pub shape Parcel<T>(^item: T)

impl<T> Parcel<T>@Encap {
    pub item
    fn drop(self#) {}
}

impl<T> Parcel<T> {
    pub fn forward(cede self) -> Self {
        return cede self
    }
}

pub fn forward_parcel<T>(cede parcel: Parcel<T>) -> Parcel<T> {
    return cede parcel
}
