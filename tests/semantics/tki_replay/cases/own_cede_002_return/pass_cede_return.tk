// Ordinary return signatures no longer carry the removed `-> cede T` contract.
// The consumer still has to explicitly transfer its named result to a callee.
// EXPECT_EVIDENCE: OWN-CEDE-001
import ./lib::{make_payload, consume_payload}

fn main() -> i32 {
    auto p = make_payload()
    auto v = consume_payload(cede p)
    if v != 7 {
        return 1
    }
    return 0
}
