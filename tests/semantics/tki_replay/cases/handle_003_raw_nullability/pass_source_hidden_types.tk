import ./lib::{accept_outer, accept_inner, accept_both}

fn main() -> i32 {
    if !accept_outer(Option<?*i32>::None) { return 1 }
    if !accept_inner(Option<*?i32>::None) { return 2 }
    if !accept_both(Option<??i32>::None) { return 3 }
    if sizeof(?*i32) == 0:usize { return 4 }
    if sizeof(*?i32) == 0:usize { return 5 }
    if sizeof(??i32) == 0:usize { return 6 }
    return 0
}
