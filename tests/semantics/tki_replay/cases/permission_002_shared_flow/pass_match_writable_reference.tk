import ./lib::{writable_option}
import core/option::{Option}

fn main() -> i32 {
    auto value# = 1
    auto option = writable_option(value)
    match option {
        auto Option<&i32#>::Some(&view#) => {
            view = 2
        }
        auto Option<&i32#>::None => {
            return 1
        }
    }
    if (value != 2) {
        return 2
    }
    return 0
}
