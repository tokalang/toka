import ./lib::{Cell, PayloadHolder, expose}

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto ~view# = expose(~source)
    auto holder = PayloadHolder(~cell = ~view)
    view.value = 2
    auto ~field_view# = holder.~cell
    field_view.value = 3
    if source.value != 3 { return 1 }
    return 0
}
