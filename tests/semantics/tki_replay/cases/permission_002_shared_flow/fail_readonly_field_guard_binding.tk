// EXPECT_ERROR: E04573
import ./lib::{Cell, ReadonlyHolder}
import core/option::{Option}

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto holder# = ReadonlyHolder(~cell = ~source)
    auto opt = Option<~Cell>::Some(holder.~cell)
    guard auto Option<~Cell>::Some(~view#) = opt else {
        return 0
    }
    view.value = 12
    return 0
}
