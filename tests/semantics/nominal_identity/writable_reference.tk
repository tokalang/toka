shape Box<T>(value#: T)
type Strong<T> = Box<T>
fn main() -> i32 {
    auto source# = 7:i32
    {
        auto holder = Strong<&i32#>(value = &source)
        holder.value = 8
        assert(holder.value == 8, "declared field capability preserves writable referent")
    }
    assert(source == 8, "borrow scope releases the source")
    return 0
}
