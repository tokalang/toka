shape Leaf(value: i32)
type Id = Leaf
shape Box<T>(value: T)
alias AliasBox = Box<Id>
fn accepts(value: Id) -> i32 { return value.value }
fn main() -> i32 {
    auto id = Id(value = 7)
    auto box = AliasBox(value = id)
    assert(accepts(box.value) == 7, "transparent alias retains nominal type arguments")
    return 0
}
