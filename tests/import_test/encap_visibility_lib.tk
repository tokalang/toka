pub shape WildcardBox (
    pub open_val: i32,
    secret_val: i32
)

impl WildcardBox@Encap {


    fn drop(self#) {}
}

impl WildcardBox {
    pub fn new(open_val: i32, secret_val: i32) -> WildcardBox {
        return WildcardBox(open_val = open_val, secret_val = secret_val)
    }

    pub fn clone(self) -> WildcardBox {
        return WildcardBox(open_val = self.open_val, secret_val = self.secret_val)
    }
}

