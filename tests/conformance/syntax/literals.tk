import std/io::{println}

fn main() -> i32 {
    auto a = 42:i32
    auto b = 1000000:u64
    auto s = "Toka Conformance":str
    
    assert(a == 42, "i32 literal mismatch")
    assert(b == 1000000:u64, "u64 literal mismatch")
    assert(s.len() == 16:usize, "str slice length mismatch")
    
    println("[Conformance] Syntax & Literals Test PASSED!")
    return 0
}
