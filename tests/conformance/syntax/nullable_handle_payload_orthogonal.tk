shape Node(val: i32)

fn check_shared_handle() -> i32 {
    auto nul ~#node#: Node? = null
    auto outcome# = 0

    guard node {
        outcome = 1
    } else {
        ~node = new Node(val = 6)
    }
    node = none
    guard node {
        outcome = 2
    } else {
        node = Node(val = 7)
    }
    guard node {
        outcome = node.val
    } else {
        outcome = 3
    }
    return outcome - 7
}

fn check_reference_payload() -> i32 {
    auto node#: Node? = none
    {
        auto &view = &node
        guard view {
            return 1
        } else {
        }
    }

    node = Node(val = 8)
    auto &view = &node
    guard view {
        if view.val != 8 {
            return 2
        }
    } else {
        return 3
    }
    return 0
}

fn check_value_payload() -> i32 {
    auto node#: Node? = none
    guard node {
        return 1
    } else {
        node = Node(val = 4)
    }
    guard node {
        if node.val != 4 {
            return 2
        }
    } else {
        return 3
    }
    return 0
}

fn main() -> i32 {
    // The outer ^# handle stays live while its nullable payload changes.
    auto nul ^#node#: Node? = new Node(val = 7)
    auto outcome# = 0

    node = none
    auto handle_is_live# = 0
    guard ^node {
        handle_is_live = 1
    } else {
        handle_is_live = 2
    }
    if handle_is_live != 1 {
        return 6
    }

    guard node {
        outcome = 1
    } else {
        node = Node(val = 9)
    }

    guard node {
        outcome = node.val
    } else {
        outcome = 2
    }

    // An empty handle is distinct from an allocated handle with an empty
    // payload.  A handle rebind establishes a fresh present payload.
    auto nul ^#absent#: Node? = null
    guard absent {
        return 3
    } else {
        ^absent = new Node(val = 5)
    }
    guard absent {
        outcome = outcome + absent.val
    } else {
        return 4
    }

    if check_shared_handle() != 0 {
        return 5
    }
    if check_reference_payload() != 0 {
        return 7
    }
    if check_value_payload() != 0 {
        return 8
    }
    return outcome - 14
}
