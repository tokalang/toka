import core/traits::{@Encap}

shape Token(id: i32)
shape Consumer()

impl Token@Encap {
    fn drop(self#) {}
}

impl Consumer@Callable {
    fn call(self, cede token: Token) -> i32 {
        auto owned = cede token
        return owned.id
    }
}

fn main() -> i32 {
    auto consumer = Consumer()
    auto source = Token(id = 3)
    return consumer(source) - 3:i32
}
