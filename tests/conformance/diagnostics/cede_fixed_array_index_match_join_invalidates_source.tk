import core/traits::{@Encap}

shape Token(id: i32)

impl Token@Encap {
    fn drop(self#) {}
}

fn main() -> i32 {
    auto selector = 0
    auto values = [Token(id = 1)]:[Token; 1]
    match selector {
        0 => {
            auto taken = cede values[0]
        }
        _ => {}
    }
    return values[0].id
}
