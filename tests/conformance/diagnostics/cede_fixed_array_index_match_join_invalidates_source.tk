import core/traits::{@encap}

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {}
    pub fn clone(self) = delete
}

fn main() -> i32 {
    auto selector = 0
    auto values: [Token; 1] = [Token(id = 1)]
    match selector {
        0 => {
            auto taken = cede values[0]
        }
        _ => {}
    }
    return values[0].id
}
