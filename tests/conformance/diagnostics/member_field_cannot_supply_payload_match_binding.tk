import core/option::{Option}

shape Cell(value: i32)

shape Holder(
    ~cell: Cell
)

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto holder# = Holder(~cell = ~source)
    auto opt = Option<~Cell>::Some(holder.~cell)
    match opt {
        auto Option<~Cell>::Some(~view#) => {
            view.value = 12
        }
        auto Option<~Cell>::None => {}
    }
    return 0
}
