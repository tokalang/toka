import core/traits::{@encap}

shape Token(value: i32)

impl Token {
    fn consume(cede self#) -> i32 {
        auto owned = cede self
        return owned.value
    }
}

shape Holder(^item#: Token)

impl Holder@encap {
    fn drop(self#) {}
    pub fn clone(self) = delete
}

fn main() -> i32 {
    auto holder = Holder(^item = new Token(value = 7))
    return holder.item#.consume()
}
