// EXPECT_ERROR: E0410
import core/traits::{@encap}

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {}
    pub fn clone(self) = delete
}

shape Pair(left: Token, right: Token)

fn main() -> i32 {
    auto selector = 0
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    match selector {
        0 => {
            auto taken = cede pair.left
        }
        _ => {}
    }
    return pair.left.id
}
