import std/task::{host_mailbox}
import std/thread::{thread_spawn}

fn main() -> i32 {
    auto mailbox# = host_mailbox<i32>()
    auto inbox = cede mailbox.inbox
    auto worker: fn() -> cede i32 = { [cede inbox] =>
        return cede 0:i32
    }
    auto handle# = thread_spawn<i32>(cede worker)
    handle#.detach()
    return 0:i32
}
