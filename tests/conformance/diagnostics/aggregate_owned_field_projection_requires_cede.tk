import core/traits::{@Encap}

shape Owner (
    value: string
)

impl Owner@Encap {
    fn drop(self#) {}
}

shape Holder (
    value: string
)

impl Holder@Encap {
    fn drop(self#) {}
}

fn main() -> i32 {
    auto owner = Owner(value = string::from("must transfer"))
    auto holder = Holder(value = owner.value)
    return 0
}
