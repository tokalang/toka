import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

shape Resource(name: string)

impl Resource@Encap {
    pub name
    fn drop(self#) {}
}

fn main() -> i32 {
    auto values# = Vec<Resource>::new()
    values#.push(cede Resource(name = string::from("owned")))
    for auto value in values {
        return 1
    }
    return 0
}
