shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {}
}

shape Pair(left: Token, right: Token)

fn main() -> i32 {
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    guard auto Pair(&borrow = .&left, ..) = pair else { return 1 }
    auto taken = cede pair.left
    return taken.id
}
// EXPECT_ERROR: E0440
