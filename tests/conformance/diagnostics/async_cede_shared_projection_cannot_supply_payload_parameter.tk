import std/task::{block_on}

shape Cell(value: i32)
shape Holder(~cell: Cell)

fn overwrite(cede ~p#: Cell) -> async i32 {
    p.value = 2
    auto ~consumed = cede ~p
    return consumed.value
}

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto holder = Holder(~cell = ~source)
    auto handle = overwrite(cede holder.~cell).start
    return block_on<i32>(handle)
}
