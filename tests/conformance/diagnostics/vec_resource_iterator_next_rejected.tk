import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

shape Resource(pub name: string)

impl Resource@Encap {

    fn drop(self#) {}
}

fn main() -> i32 {
    auto values# = Vec<Resource>::new()
    values#.push(cede Resource(name = string::from("owned")))
    auto cursor# = values.iter()
    auto copied = cursor#.next().unwrap()
    return copied.name.len() as i32
}
