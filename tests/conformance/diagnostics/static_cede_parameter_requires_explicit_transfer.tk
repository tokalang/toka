import core/traits::{@Encap}

shape Token(id: i32)

impl Token@Encap {
    fn drop(self#) {}
}

impl Token {
    fn consume(cede token: Token) -> i32 {
        auto owned = cede token
        return owned.id
    }
}

fn main() -> i32 {
    auto source = Token(id = 3)
    return Token::consume(source)
}
