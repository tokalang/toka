import core/traits::{@encap}

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {}
    pub fn clone(self) = delete
}

fn main() -> i32 {
    auto values: [Token; 1] = [Token(id = 1)]
    match values[0] {
        auto &borrow => {
            auto taken = cede values[0]
            return taken.id
        }
    }
}
// EXPECT_ERROR: E0440
