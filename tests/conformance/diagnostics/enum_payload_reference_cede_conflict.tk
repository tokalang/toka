import core/option::{Option}

shape Cell(value: i32)

fn main() -> i32 {
    auto option = Option<Cell>::Some(Cell(value = 1))
    match option {
        auto Option<Cell>::Some(&view#) => {
            auto moved = cede option
            view.value = 2
        }
        auto Option<Cell>::None => {}
    }
    return 0
}
