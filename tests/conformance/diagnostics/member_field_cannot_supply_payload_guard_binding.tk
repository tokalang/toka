import core/option::{Option}

shape Cell(value: i32)

shape Holder(
    ~cell: Cell
)

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto holder# = Holder(~cell = ~source)
    auto opt = Option<~Cell>::Some(holder.~cell)
    guard auto Option<~Cell>::Some(~view#) = opt else {
        return 0
    }
    view.value = 12
    return 0
}
