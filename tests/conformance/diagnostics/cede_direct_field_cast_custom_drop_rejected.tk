// EXPECT_ERROR: E0439
import core/traits::{@encap}

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {}
}

shape Pair(left: Token, right: Token)

impl Pair@encap {
    fn drop(self#) {}
}

fn main() -> i32 {
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    auto taken = cede (pair.left as Token)
    return taken.id
}
