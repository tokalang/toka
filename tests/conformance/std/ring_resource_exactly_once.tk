import core/traits::{@encap}
import std/ring::{RingCore}

auto g_drop_count# = 0
auto g_clone_count# = 0

shape Resource(id: i32)

impl Resource@encap {
    fn drop(self#) {
        g_drop_count += 1
    }

    pub fn clone(self) -> Resource {
        g_clone_count += 1
        return Resource(id = self.id)
    }
}

fn main() -> i32 {
    {
        auto ring# = RingCore<Resource>::new()
        auto id#: i32 = 0:i32
        loop id < 8:i32 {
            auto resource = Resource(id = id)
            ring#.push_back(cede resource)
            id += 1:i32
        }

        {
            auto removed = ring#.pop_front().unwrap()
            assert(removed.id == 0:i32,
                   "ring returns the resource removed from its shifted head")
        }
        assert(g_drop_count == 1,
               "popping a ring resource transfers exactly one drop owner")

        auto eighth = Resource(id = 8:i32)
        ring#.push_back(cede eighth)
        auto ninth = Resource(id = 9:i32)
        ring#.push_back(cede ninth)
        assert(g_drop_count == 1,
               "wrapped ring growth does not drop resources moved to new storage")
        assert(g_clone_count == 0,
               "wrapped ring growth moves resources instead of cloning them")

        ring#.clear()
        assert(g_drop_count == 10,
               "ring clear drops every remaining resource exactly once")
    }
    assert(g_drop_count == 10,
           "dropping cleared ring storage does not redrop old slots")
    return 0
}
