import stdx/serde/json::{to_json, deserialize_shape, ToJson, serialize_shape}
import std/io::{println}
import core/string::{string}

pub shape TestPayload (
    id: i32 = 0,
    title: string = string::from(""),
    enabled: bool = false
)

impl TestPayload@ToJson {
    pub fn write_json(self, buf#: string) {
        serialize_shape(self, buf#)
    }
}

fn main() -> i32 {
    auto payload = TestPayload(id = 42, title = string::from("Conformance"), enabled = true)
    auto json_str = to_json(payload)
    
    auto decoded_res = deserialize_shape<TestPayload>(json_str.as_view())
    assert(decoded_res.is_ok(), "deserialize_shape must succeed")
    auto decoded = decoded_res.unwrap()
    assert(decoded.id == 42, "Decoded payload ID mismatch")
    assert(decoded.enabled == true, "Decoded payload enabled status mismatch")
    assert(decoded.title.eq(string::from("Conformance")), "Decoded payload title mismatch")

    println("[Conformance] Real stdx/serde/json Conformance Test PASSED!")
    return 0
}
import stdx/serde/json::{@JsonFactory, Parsed, parse_document}
impl TestPayload@JsonFactory {
    pub fn parse_value(input: str) -> Result<Parsed<TestPayload>, str> <- input {
        auto attempt = parse_document(input)
        if attempt.is_err() {
            auto error = Result<Parsed<TestPayload>, str>::Err("Invalid JSON")
            return cede error
        }
        auto document = attempt.unwrap()
        if document.kind(1) != 5 {
            auto error = Result<Parsed<TestPayload>, str>::Err("Expected object")
            return cede error
        }
        if document.kind(document.find(1, "id")) != 2 {
            auto error = Result<Parsed<TestPayload>, str>::Err("Invalid field id")
            return cede error
        }
        if document.kind(document.find(1, "title")) != 3 {
            auto error = Result<Parsed<TestPayload>, str>::Err("Invalid field title")
            return cede error
        }
        if document.kind(document.find(1, "enabled")) != 1 {
            auto error = Result<Parsed<TestPayload>, str>::Err("Invalid field enabled")
            return cede error
        }
        auto value = TestPayload(id = document.number(document.find(1, "id")).unwrap() as i32, title = string::from(document.text(document.find(1, "title"))), enabled = document.boolean(document.find(1, "enabled")).unwrap())
        auto parsed = Parsed<TestPayload>(value = cede value, rest = input.substr(input.len(), 0))
        auto result = Result<Parsed<TestPayload>, str>::Ok(cede parsed)
        return cede result
    }
}
