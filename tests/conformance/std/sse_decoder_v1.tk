import core/result::{Result}
import std/bytes::{Bytes}
import std/vec::{Vec}
import stdx/net/sse::{SseDecoder, SseLimits}

fn make_bytes(value: str) -> Bytes {
    auto raw# = Vec<u8>::with_capacity(value.len())
    auto index# = 0:usize
    loop index < value.len() { raw#.push(value.byte_at(index) as u8); index += 1:usize }
    return Bytes::from_vec(cede raw)
}

fn main() -> i32 {
    auto limits = SseLimits::new(32:usize, 64:usize, 64:usize)
    if limits.is_err() { return 1 }
    auto decoder# = SseDecoder::new(limits.unwrap())
    auto first = decoder#.push(cede make_bytes("event: delta\r\ndata: hello\ndata: world\r\n"))
    if first.is_err() { return 2 }
    if first.unwrap().len() != 0:usize { return 3 }
    auto second = decoder#.push(cede make_bytes("id: 7\nretry: 125\n\n"))
    if second.is_err() { return 4 }
    auto second_events = second.unwrap()
    if second_events.len() != 1:usize { return 5 }
    auto event = second_events.get(0:usize).clone()
    if !event.event_type().as_str().equals("delta") || !event.data().as_str().equals("hello\nworld") { return 6 }
    auto id = event.id()
    if id.is_none() { return 7 }
    if !id.unwrap().as_str().equals("7") { return 8 }
    if decoder.retry_ms().is_none() || decoder.retry_ms().unwrap() != 125:i32 { return 9 }
    if decoder#.finish().is_err() { return 10 }

    auto truncated# = SseDecoder::new(SseLimits::new(32:usize, 64:usize, 64:usize).unwrap())
    if truncated#.push(cede make_bytes("data: partial\n")).is_err() { return 11 }
    auto ended = truncated#.finish()
    if ended.is_ok() { return 12 }
    if !ended.unwrap_err().kind().as_str().equals("truncated") { return 13 }

    auto limited# = SseDecoder::new(SseLimits::new(4:usize, 64:usize, 64:usize).unwrap())
    auto too_long = limited#.push(cede make_bytes("data: x"))
    if too_long.is_ok() { return 14 }
    if !too_long.unwrap_err().kind().as_str().equals("limit") { return 15 }

    auto event_limited# = SseDecoder::new(SseLimits::new(32:usize, 8:usize, 64:usize).unwrap())
    auto too_large_event = event_limited#.push(cede make_bytes("data: aa\ndata: bb\n"))
    if too_large_event.is_ok() { return 16 }
    if !too_large_event.unwrap_err().kind().as_str().equals("limit") { return 17 }

    auto buffered# = SseDecoder::new(SseLimits::new(10:usize, 64:usize, 10:usize).unwrap())
    auto too_buffered = buffered#.push(cede make_bytes("data: a\ndata: b\n"))
    if too_buffered.is_ok() { return 18 }
    if !too_buffered.unwrap_err().kind().as_str().equals("limit") { return 19 }
    return 0
}
