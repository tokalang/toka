import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

auto g_drop_count# = 0:i32

shape Resource(id: i32, name: string)

impl Resource@Encap {
    pub id, name

    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

fn make_resource(id: i32, name: str) -> Resource {
    return Resource(id = id, name = string::from(name))
}

fn main() -> i32 {
    {
        auto values# = Vec<Resource>::new()
        values#.push(cede make_resource(1, "one"))
        values#.push(cede make_resource(2, "two"))
        values#.push(cede make_resource(3, "three"))
        values#.push(cede make_resource(4, "four"))
        values#.push(cede make_resource(5, "five"))
        values#.push(cede make_resource(6, "six"))
        values#.push(cede make_resource(7, "seven"))
        values#.push(cede make_resource(8, "eight"))

        if values.len() != 8:usize || values.cap() < 8:usize { return 1 }
        if values.get_ref(0:usize).id != 1 { return 2 }
        if !values.get_ref(7:usize).name.as_str().equals("eight") { return 3 }

        {
            auto removed = values#.remove(3:usize).unwrap()
            if removed.id != 4 || !removed.name.as_str().equals("four") {
                return 4
            }
        }
        if g_drop_count != 1:i32 { return 5 }

        {
            auto popped = values#.pop().unwrap()
            if popped.id != 8 || !popped.name.as_str().equals("eight") {
                return 6
            }
        }
        if g_drop_count != 2:i32 { return 7 }

        if values.len() != 6:usize { return 8 }
        if values.get_ref(3:usize).id != 5 { return 9 }
        if values.get_ref(5:usize).id != 7 { return 10 }

        values#.clear()
        if !values.is_empty() || g_drop_count != 8:i32 { return 11 }

        values#.push(cede make_resource(9, "nine"))
        if values.get_ref(0:usize).id != 9 { return 12 }
    }

    if g_drop_count != 9:i32 { return 13 }
    return 0
}
