import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

auto g_drop_count# = 0:i32

shape Resource(id: i32, name: string)

impl Resource@Encap {
    pub id, name

    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

fn main() -> i32 {
    {
        auto values# = Vec<Resource>::new()
        values#.push(cede Resource(id = 1, name = string::from("old")))
        values#.set(
            0:usize,
            cede Resource(id = 2, name = string::from("replacement"))
        )

        if g_drop_count != 1:i32 { return 1 }
        if values.borrow(0:usize).id != 2 { return 2 }
        if !values.borrow(0:usize).name.as_str().equals("replacement") {
            return 3
        }

        values#.set(
            3:usize,
            cede Resource(id = 3, name = string::from("out-of-bounds"))
        )
        if g_drop_count != 2:i32 { return 4 }
        if values.len() != 1:usize || values.borrow(0:usize).id != 2 {
            return 5
        }
    }

    if g_drop_count != 3:i32 { return 6 }
    return 0
}
