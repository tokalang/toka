import core/string::{string}
import core/traits::{@Encap}
import std/vec::{Vec}

auto g_drop_count# = 0:i32

shape Resource(id: i32, name: string)

impl Resource@Encap {
    pub id, name

    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

fn resource(id: i32, name: str) -> Resource {
    return Resource(id = id, name = string::from(name))
}

fn main() -> i32 {
    {
        auto source# = Vec<Resource>::new()
        source#.push(cede resource(1:i32, "one"))
        source#.push(cede resource(2:i32, "two"))

        auto taken# = source#.take()
        if source.len() != 0:usize || source.cap() != 0:usize { return 1 }
        if taken.len() != 2:usize { return 2 }
        if taken.borrow(0:usize).id != 1:i32 { return 3 }
        if taken.borrow(1:usize).id != 2:i32 { return 4 }
        if g_drop_count != 0:i32 { return 5 }

        source#.push(cede resource(3:i32, "three"))
        if source.len() != 1:usize || source.borrow(0:usize).id != 3:i32 {
            return 6
        }
    }

    if g_drop_count != 3:i32 { return 7 }
    return 0
}
