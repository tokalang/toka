import core/traits::{@encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
    pub fn clone(self) = delete
}

shape Pair(left: Token, right: Token)

fn main() -> i32 {
    {
        auto i# = 0
        auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
        loop i < 1 {
            auto taken = cede pair.left
            assert(taken.id == 1, "loop-local cede owns the field")
            i += 1
        }
        assert(pair.right.id == 2, "live sibling survives loop exit")
    }
    assert(g_drop_count == 2, "loop cede drops each resource exactly once")
    return 0
}
