import core/traits::{@encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

fn main() -> i32 {
    {
        auto i# = 0
        auto values: [Token; 2] = [Token(id = 1), Token(id = 2)]
        loop i < 1 {
            auto taken = cede values[0]
            assert(taken.id == 1, "loop-local cede owns the fixed-array element")
            i += 1
        }
        assert(values[1].id == 2, "live fixed-array sibling survives loop exit")
    }
    assert(g_drop_count == 2, "loop cede drops each fixed-array resource once")
    return 0
}
