import core/traits::{@Encap}

auto g_drop_count# = 0:i32

shape Tracked(value: string)

impl Tracked@Encap {
    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

impl Tracked {
    fn read(self) -> str {
        return self.value.as_str()
    }

    fn consume(cede self#) -> usize {
        auto owned = cede self
        return owned.value.len()
    }
}

shape Envelope(
    tracked: Tracked,
    message: string
)

fn make_envelope() -> Envelope {
    return Envelope(
        tracked = Tracked(value = string::from("owned")),
        message = string::from("visible")
    )
}

fn make_unique() -> ^Tracked# {
    return new Tracked(value = string::from("unique"))
}

fn main() -> i32 {
    if !make_envelope().message.as_str().equals("visible") {
        return 1
    }
    if g_drop_count != 1:i32 {
        return 2
    }
    if !make_unique().read().equals("unique") {
        return 3
    }
    if g_drop_count != 2:i32 {
        return 4
    }
    if make_unique()#.consume() != 6:usize {
        return 5
    }
    if g_drop_count != 3:i32 {
        return 6
    }
    return 0
}
