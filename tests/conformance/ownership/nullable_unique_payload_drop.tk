import core/traits::{@encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
    pub fn clone(self) = delete
}

fn clear_payload() {
    auto ^#token#: Token? = new Token(id = 1)
    token = none
}

fn replace_payload() {
    auto ^#token#: Token? = new Token(id = 2)
    token = Token(id = 3)
}

fn rebind_after_empty_payload() {
    auto ^#token#: Token? = new Token(id = 4)
    token = none
    ^token = new Token(id = 5)
}

fn rebind_live_payload() {
    auto ^#token#: Token? = new Token(id = 6)
    ^token = new Token(id = 7)
}

fn shared_clear_payload() {
    auto nul ~#token#: Token? = null
    ~token = new Token(id = 8)
    token = none
}

fn shared_rebind_after_empty_payload() {
    auto nul ~#token#: Token? = null
    ~token = new Token(id = 9)
    token = none
    ~token = new Token(id = 10)
}

fn shared_rebind_live_payload() {
    auto nul ~#token#: Token? = null
    ~token = new Token(id = 11)
    ~token = new Token(id = 12)
}

fn main() -> i32 {
    clear_payload()
    if g_drop_count != 1 {
        return 1
    }

    replace_payload()
    if g_drop_count != 3 {
        return 2
    }

    rebind_after_empty_payload()
    if g_drop_count != 5 {
        return 3
    }

    rebind_live_payload()
    if g_drop_count != 7 {
        return 4
    }

    shared_clear_payload()
    if g_drop_count != 8 {
        return 5
    }

    shared_rebind_after_empty_payload()
    if g_drop_count != 10 {
        return 6
    }

    shared_rebind_live_payload()
    if g_drop_count != 12 {
        return 7
    }

    return 0
}
