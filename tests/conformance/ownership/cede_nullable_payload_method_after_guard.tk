shape Token(id: i32)

impl Token {
    pub fn take(cede self) -> i32 {
        auto owned = cede self
        return owned.id
    }
}

fn main() -> i32 {
    auto ^source#: Token? = new Token(id = 7)
    auto result# = 2
    guard source {
        result = source.take()
    } else {
        result = 2
    }
    return result - 7
}
