import core/traits::{@encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

fn take_and_return() -> i32 {
    auto values: [Token; 2] = [Token(id = 1), Token(id = 2)]
    auto taken = cede values[0]
    return taken.id
}

fn main() -> i32 {
    assert(take_and_return() == 1, "ceded fixed-array element returns its value")
    assert(g_drop_count == 2,
           "return unwinds the ceded element and its live sibling exactly once")
    return 0
}
