import core/traits::{@Encap}

auto g_drop_count# = 0

shape Token(value: i32)

impl Token@Encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

impl Token {
    fn consume(cede self#) -> i32 {
        auto owned = cede self
        return owned.value
    }
}

shape Holder(^item#: Token)

shape ValueHolder(item#: Token)

fn main() -> i32 {
    {
        auto holder = Holder(^item = new Token(value = 7))
        if holder.item#.consume() != 7 {
            return 1
        }
    }
    {
        auto holder = ValueHolder(item = Token(value = 9))
        if holder.item#.consume() != 9 {
            return 2
        }
    }
    return g_drop_count - 2
}
