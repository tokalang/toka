import core/traits::{@Encap}

auto g_drop_count# = 0:i32
auto g_drop_sum# = 0:i32

shape Resource(value: i32)

impl Resource@Encap {
    fn drop(self#) {
        g_drop_count += 1:i32
        g_drop_sum += self.value
    }
}

shape Holder(item#: Resource)
shape Pair(left: Resource, right: Resource)

impl Holder {
    fn replace(self#, cede next: Resource) {
        self.item = cede next
    }
}

fn main() -> i32 {
    {
        auto holder# = Holder(item = Resource(value = 1:i32))
        holder#.replace(cede Resource(value = 2:i32))
        if g_drop_count != 1:i32 || g_drop_sum != 1:i32 { return 1 }
    }
    if g_drop_count != 2:i32 || g_drop_sum != 3:i32 { return 2 }

    {
        auto values# = [Resource(value = 5:i32)]:[Resource; 1]
        values[0] = Resource(value = 6:i32)
        if g_drop_count != 3:i32 || g_drop_sum != 8:i32 { return 5 }
    }
    if g_drop_count != 4:i32 || g_drop_sum != 14:i32 { return 6 }

    {
        auto dynamic_index# = 0:usize
        auto values# = [Resource(value = 7:i32)]:[Resource; 1]
        values[dynamic_index] = Resource(value = 8:i32)
        if g_drop_count != 5:i32 || g_drop_sum != 21:i32 { return 7 }
    }
    if g_drop_count != 6:i32 || g_drop_sum != 29:i32 { return 8 }

    {
        auto pair# = Pair(
            left = Resource(value = 9:i32),
            right = Resource(value = 10:i32)
        )
        {
            auto taken = cede pair.left
            if taken.value != 9:i32 { return 9 }
        }
        if g_drop_count != 7:i32 || g_drop_sum != 38:i32 { return 10 }

        pair = Pair(
            left = Resource(value = 11:i32),
            right = Resource(value = 12:i32)
        )
        if g_drop_count != 8:i32 || g_drop_sum != 48:i32 { return 11 }
    }
    if g_drop_count != 10:i32 || g_drop_sum != 71:i32 { return 12 }

    {
        auto holder# = Holder(item = Resource(value = 13:i32))
        holder:Holder# = Holder(item = Resource(value = 14:i32))
        if holder.item.value != 14:i32 { return 13 }
        if g_drop_count != 11:i32 || g_drop_sum != 84:i32 { return 14 }
    }
    if g_drop_count != 12:i32 || g_drop_sum != 98:i32 { return 15 }

    {
        auto values# = [Resource(value = 19:i32); 65]:[Resource; 65]
        values[0] = Resource(value = 20:i32)
        if g_drop_count != 13:i32 || g_drop_sum != 117:i32 { return 25 }
    }
    if g_drop_count != 78:i32 || g_drop_sum != 1353:i32 { return 26 }
    return 0
}
