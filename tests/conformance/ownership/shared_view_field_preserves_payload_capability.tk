shape Cell(
    value: i32
)

shape Holder(
    ~cell#: Cell
)

fn main() -> i32 {
    auto ~source# = new Cell(value = 1)
    auto holder = Holder(~cell = ~source)
    holder.cell.value = 2
    auto ~field_view# = holder.~cell
    field_view.value = 3
    if source.value != 3 { return 1 }
    return 0
}
