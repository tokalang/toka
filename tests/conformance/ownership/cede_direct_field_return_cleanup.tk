import core/traits::{@Encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@Encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

shape Pair(left: Token, right: Token)

fn take_and_return() -> i32 {
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    auto taken = cede pair.left
    return taken.id
}

fn main() -> i32 {
    assert(take_and_return() == 1, "ceded field returns its value")
    assert(g_drop_count == 2,
           "return unwinds the ceded local and live sibling exactly once")
    return 0
}
