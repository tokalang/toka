import core/traits::{@encap}

auto g_drop_count# = 0

shape Token(id: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

shape Pair(item: Token?)

fn cede_member_after_guard() -> i32 {
    {
        auto pair = Pair(item = Token(id = 7))
        guard pair.item {
            auto target: Token = cede pair.item
            assert(target.id == 7, "guarded member cede owns the payload")
        } else {
            return 1
        }
    }
    return 0
}

fn cede_index_after_guard() -> i32 {
    {
        auto values: [Token?; 1] = [Token(id = 9)]
        guard values[0] {
            auto target: Token = cede values[0]
            assert(target.id == 9, "guarded index cede owns the payload")
        } else {
            return 1
        }
    }
    return 0
}

fn main() -> i32 {
    assert(cede_member_after_guard() == 0, "member transfer")
    assert(g_drop_count == 1, "guarded nullable member drops exactly once")
    assert(cede_index_after_guard() == 0, "index transfer")
    assert(g_drop_count == 2, "guarded nullable index drops exactly once")
    return 0
}
