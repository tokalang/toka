import std/io::{println}
import std/vec::{Vec}
import core/string::{string}

shape Element (
    name: string
)

impl Element@Encap {
    pub name
    fn drop(self#) {}
}

impl Element {
pub fn clone(self) -> Element {
        return Element(name = string::from(self.name.as_str()))
    }
}

fn main() -> i32 {
    auto v# = Vec<Element>::new()
    v#.push(cede Element(name = string::from("First")))
    v#.push(cede Element(name = string::from("Second")))

    // 10x repeated read via .clone() to verify vector buffer is never moved/freed
    auto i# = 0:usize
    loop i < 10:usize {
        auto elem1 = v#.get(0).clone()
        assert(elem1.name.as_str().equals("First"), "Element 0 name mismatch")

        auto elem2 = v#.get(1).clone()
        assert(elem2.name.as_str().equals("Second"), "Element 1 name mismatch")
        i += 1
    }

    assert(v.len() == 2:usize, "Vector length must remain 2 after repeated cloned reads")
    println("[Conformance] Vec::get Clone & Borrow Safety PASSED!")
    return 0
}
