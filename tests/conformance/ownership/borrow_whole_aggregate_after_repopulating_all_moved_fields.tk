import std/io::{println}
import core/traits::{@Encap}

auto g_drop_count# = 0:i32

shape Token (
    id: i32
)

impl Token@Encap {
    pub id
    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

shape Pair (
    left: Token,
    right: Token
)

fn main() -> i32 {
    {
        auto pair = Pair(
            left = Token(id = 1),
            right = Token(id = 2)
        )
        auto t1 = cede pair.left
        auto t2 = cede pair.right
        assert(t1.id == 1, "t1 id check")
        assert(t2.id == 2, "t2 id check")

        pair.left = Token(id = 3)
        pair.right = Token(id = 4)

        auto &borrow = &pair
        assert(borrow.left.id == 3, "borrow.left id check")
        assert(borrow.right.id == 4, "borrow.right id check")
    }
    // t1 dropped (1) + t2 dropped (1) + repopulated pair.left (1) + repopulated pair.right (1) = 4
    assert(g_drop_count == 4:i32, "All repopulated fields must drop exactly once along with ceded tokens")

    println("[Conformance] Borrow Whole Aggregate After Repopulating All Moved Fields PASSED!")
    return 0
}
