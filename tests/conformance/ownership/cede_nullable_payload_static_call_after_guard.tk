shape Token(id: i32)

impl Token {
    fn consume(cede token: Token) -> i32 {
        auto owned = cede token
        return owned.id
    }
}

fn main() -> i32 {
    auto ^source# = new Token(id = 7):^Token?
    auto result# = 0
    guard source {
        result = Token::consume(cede source)
    } else {
        result = -1
    }
    if result != 7 {
        return 1
    }
    return 0
}
