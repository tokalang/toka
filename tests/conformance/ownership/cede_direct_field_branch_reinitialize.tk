import std/io::{println}
import core/traits::{@Encap}

auto g_drop_count# = 0:i32

shape Token(id: i32)

impl Token@Encap {
    pub id
    fn drop(self#) {
        g_drop_count += 1:i32
    }
}

shape Pair(
    left: Token,
    right: Token
)

fn branch_then_reinitialize(take_left: bool) -> i32 {
    {
        auto pair# = Pair(left = Token(id = 1), right = Token(id = 2))
        if take_left {
            auto taken = cede pair.left
            assert(taken.id == 1, "branch transfer captures the field")
        }
        pair.left = Token(id = 3)
        assert(pair.left.id == 3, "reassignment restores definite liveness")
        assert(pair.right.id == 2, "sibling stays live across the join")
    }
    return 0
}

fn main() -> i32 {
    assert(branch_then_reinitialize(true) == 0, "ceded branch")
    assert(branch_then_reinitialize(false) == 0, "non-ceded branch")
    // Each invocation drops 3 tokens:
    // true: taken (1) + replacement (1) + right (1) = 3
    // false: replaced old-left (1) + replacement (1) + right (1) = 3
    // Total = 6
    assert(g_drop_count == 6:i32, "both branches must drop all tokens exactly once")

    println("[Conformance] Cede Direct Field Branch Reinitialize PASSED!")
    return 0
}
