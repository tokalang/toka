import core/traits::{@encap}

auto g_drop_count# = 0:i32

shape Resource (
    id: i32
)

impl Resource@encap {
    fn drop(self#) {
        g_drop_count += 1:i32
    }

}

shape Owner (
    value: Resource
)

shape Holder (
    value: Resource
)

impl Holder@encap {
    fn drop(self#) {}
}

fn main() -> i32 {
    {
        auto owner = Owner(value = Resource(id = 7:i32))
        auto holder = Holder(value = cede owner.value)
        assert(holder.value.id == 7:i32,
               "aggregate receives the explicitly ceded field")
    }
    assert(g_drop_count == 1:i32,
           "ceded aggregate field is dropped exactly once")
    return 0
}
