import core/traits::{@encap}

auto g_drop_count# = 0

shape Token (
    id: i32
)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

shape Pair (
    left: Token,
    right: Token
)

fn main() -> i32 {
    {
        auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
        auto taken = cede pair.left
        pair.left = Token(id = 3)
        assert(pair.left.id == 3, "assigned field becomes live again")
        assert(pair.right.id == 2, "sibling remains live")
        assert(taken.id == 1, "ceded field remains independently owned")
    }
    assert(g_drop_count == 3, "reinitialized field regains exactly one drop")
    return 0
}
