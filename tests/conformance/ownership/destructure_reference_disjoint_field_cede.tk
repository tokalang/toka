shape Token(id: i32)

impl Token@Encap {
    fn drop(self#) {}
}

shape Pair(left: Token, right: Token)

fn main() -> i32 {
    auto pair = Pair(left = Token(id = 1), right = Token(id = 2))
    auto Pair(&borrow = .&left, ..) = pair
    if borrow.id != 1 { return 1 }
    auto taken = cede pair.right
    return taken.id - 2
}
