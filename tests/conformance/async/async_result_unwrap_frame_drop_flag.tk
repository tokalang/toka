import core/string::{string}
import core/result::{Result}
import std/task::{block_on, sleep_async}

auto g_drop_count# = 0

shape Resource(name: string)
impl Resource@Encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

fn async_unwrap_worker() -> async i32 {
    auto res = Result<Resource, string>::Ok(Resource(name = string::from("async_res")))
    sleep_async(5:i32).await
    auto val = res.unwrap()
    sleep_async(5:i32).await
    if !val.name.as_str().equals("async_res") {
        return 1
    }
    return 0
}

fn main() -> i32 {
    auto r = block_on<i32>(async_unwrap_worker().start)
    if r != 0 { return r }
    if g_drop_count != 1 {
        return 2
    }
    return 0
}
