import core/option::{Option}
import core/result::{Result}
import std/channel::{channel}
import std/task_mailbox::{host_mailbox, host_mailbox_inbox, HostMailboxPoll}
import std/thread::{thread_spawn}

fn main() -> i32 {
    auto smoke# = host_mailbox<i32>()
    assert(smoke.inbox#.try_next().is_ok(), "host_mailbox factory remains usable")
    auto pair# = channel<i32>()
    auto inbox# = host_mailbox_inbox(cede pair.rx)
    match inbox#.try_next() {
        auto Result<HostMailboxPoll<i32>, string>::Ok(HostMailboxPoll<i32>::Empty) => {}
        _ => return 1:i32
    }

    auto sender = cede pair.tx
    auto worker = { [cede sender] =>
        if sender#.send(cede 41:i32).is_err() { return 2:i32 }
        return 0:i32
    }
    auto created = thread_spawn<i32>(cede worker)
    if created.is_err() { return 8:i32 }
    auto worker# = created.unwrap()
    auto worker_result = worker#.join()
    match cede worker_result {
        auto Result<i32, _>::Ok(status) => {
            if status != 0:i32 { return 3:i32 }
        }
        _ => return 4:i32
    }

    match inbox#.try_next() {
        auto Result<HostMailboxPoll<i32>, string>::Ok(HostMailboxPoll<i32>::Message(value)) => {
            if value != 41:i32 { return 5:i32 }
        }
        _ => return 6:i32
    }
    match inbox#.try_next() {
        auto Result<HostMailboxPoll<i32>, string>::Ok(HostMailboxPoll<i32>::Closed) => return 0:i32
        _ => return 7:i32
    }
}
