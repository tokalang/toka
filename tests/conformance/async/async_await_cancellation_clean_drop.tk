import core/string::{string}
import core/option::{Option}
import std/task::{block_on, sleep_async, task_cancel}

auto g_drop_count# = 0

shape Resource(name: string)
impl Resource@Encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

fn cancellable_worker_async() -> async i32 {
    auto local_res = Resource(name = string::from("worker_resource"))
    auto waited = sleep_async(100:i32).await
    if waited < 0:i32 {
        return -1
    }
    return 1
}

fn coordinator_async() -> async i32 {
    auto worker = cancellable_worker_async().start
    sleep_async(5:i32).await
    task_cancel<i32>(worker)
    auto outcome = worker.await?
    match cede outcome {
        auto Option<i32>::None => {
            if g_drop_count != 1 {
                return 1
            }
            return 0
        }
        _ => return 2
    }
}

fn main() -> i32 {
    return block_on<i32>(coordinator_async().start)
}
