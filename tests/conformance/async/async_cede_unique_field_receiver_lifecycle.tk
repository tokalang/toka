import core/traits::{@encap}
import std/task::{block_on}

auto g_body_runs# = 0
auto g_drop_count# = 0

shape Token(value: i32)

impl Token@encap {
    fn drop(self#) {
        g_drop_count += 1
    }
    pub fn clone(self) = delete
}

impl Token {
    fn consume(cede self#) -> async i32 {
        g_body_runs += 1
        auto owned = cede self
        return owned.value
    }
}

shape Holder(^item#: Token)

fn run_started() -> i32 {
    auto holder = Holder(^item = new Token(value = 7))
    auto handle = holder.item#.consume().start
    return block_on<i32>(handle)
}

fn create_then_drop_cold() {
    auto holder = Holder(^item = new Token(value = 9))
    auto handle = holder.item#.consume()
}

fn main() -> i32 {
    if run_started() != 7 {
        return 1
    }
    create_then_drop_cold()
    if g_body_runs != 1 {
        return 2
    }
    return g_drop_count - 2
}
