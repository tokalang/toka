// Conformance codegen test: SRET ABI attribute emission for aggregate return

shape LargeAggregate (
    f1: i64,
    f2: i64,
    f3: i64,
    f4: i64
)

fn return_large() -> LargeAggregate {
    return LargeAggregate(f1 = 1, f2 = 2, f3 = 3, f4 = 4)
}

fn main() -> i32 {
    auto agg = return_large()
    assert(agg.f1 == 1, "SRET aggregate f1 match")
    return 0
}
