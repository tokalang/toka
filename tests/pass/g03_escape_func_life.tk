
fn simple_life(a: i32) -> &i32 <- a {
    return &a
}

fn record_life(a: i32, b: i32) -> res: (first: &i32, second: &i32)
effects:
    res.first <- a
    res.second <- b
{
    return (first = &a, second = &b)
}

fn main() -> i32 {
    auto x = 10
    auto &y = simple_life(x)
    if (y != 10) return 1

    auto z = 20
    auto rec = record_life(x, z)
    // rec is an anonymous record with first/second reference fields.
    // Auto-deref should work for record members if they are refs?
    // Let's test explicit deref if needed, or implicit.
    // Based on previous simple_life, 'y' (ref) auto-derefs.
    // 'rec.first' is an access expression returning a reference.
    // So 'rec.first' should evaluate to i32 value.
    auto &v1 = rec.&first
    auto &v2 = rec.&second
    if (v1 != 10) return 2
    if (v2 != 20) return 3
    
    return 0
}
