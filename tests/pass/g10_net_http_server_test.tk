import std/io::{println}
import stdx/net/http::{HttpRequest, HttpResponse, HttpMethod, parse_http_request}
import std/net::{TcpListener, TcpStream, Ipv4Addr, SocketAddrV4}

import sys/libc
import core/types
import core/result::{Result}
import std/thread::{thread_spawn, JoinHandle}

extern fn sleep(seconds: i32) -> i32

// Basic handler router
fn handle_request(req#: HttpRequest) -> HttpResponse {
    auto is_get# = false
    match req.method {
           auto HttpMethod::GET => { is_get = true }
           _ => {}
    }
    
    auto is_home# = false
    if req.path.eq(string::from("/home")) { is_home = true }
    
    if is_get && is_home {
        auto res = HttpResponse::html(string::from("<h1>Welcome to Toka HTTP Framework</h1>"))
        return res
    }
    
    return HttpResponse::not_found()
}

pub fn main() -> i32 {
    unsafe {
        auto bind_addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16)
        auto listener# = TcpListener::bind(bind_addr)
        if !listener.is_valid() {
            println("Networking unsupported or port in use, skipping.")
            return 0
        }

        auto local_port = listener.local_port()

        // Spawn server thread
        auto server_thread# = thread_spawn<i32>(cede { [cede listener] =>
            unsafe {
                auto s# = listener#.accept()
                if !s.is_valid() { return cede 1 }

                auto buf = [0 as char; 1024]:[char; 1024]
                auto *buf_ptr# = &buf[0] as *u8

                auto read_res = s#.read(*buf_ptr, 1024)
                if read_res.is_err() { return cede 1 }

                auto n = read_res.unwrap()
                if n == 0:usize { return cede 0 }

                auto req_str = string::from_with_len(&buf[0] as *char, n as i32)
                auto req_res = parse_http_request(req_str)
                if req_res.is_err() { return cede 1 }

                auto req# = req_res.unwrap()
                auto resp# = handle_request(req)
                auto resp_str = resp#.to_string()

                auto *ptr = resp_str.c_str() as *u8
                auto w_res = s#.write(*ptr, resp_str.len() as usize)
                if w_res.is_err() { return cede 1 }

                return cede 0
            }
        })
        
        sleep(1)

        auto client_addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), local_port)
        auto stream# = TcpStream::connect(client_addr)
        assert(stream.is_valid(), "TcpStream::connect failed")

        auto req_line = string::from("GET /home HTTP/1.1\r\nHost: localhost\r\nAccept: */*\r\n\r\n")
        auto write_res = stream#.write_string(req_line)
        assert(write_res.is_ok(), "Client write failed")

        // Read response
        auto buf = [0 as char; 1024]:[char; 1024]
        auto *buf_ptr# = &buf[0] as *u8
        auto read_res = stream#.read(*buf_ptr, 1024)
        assert(read_res.is_ok(), "Client read failed")

        auto n = read_res.unwrap()
        auto resp_str = string::from_with_len(&buf[0] as *char, n as i32)
        assert(resp_str.contains("Welcome to Toka HTTP Framework"), "HTTP Response content mismatch")

        stream#.close()
        server_thread#.join()
        println("[Test] Web Server HTTP engine successful!")
        return 0
    }
}
