
fn main() -> i32 {
    auto a = 12
    auto b = 10
    
    // Test &: 1100 & 1010 = 1000 (8)
    auto c = a & b
    assert(c == 8, "& check failed")

    // Test |: 1100 | 1010 = 1110 (14)
    auto d = a | b
    assert(d == 14, "| check failed")

    // Test ^: 1100 ^ 1010 = 0110 (6)
    auto e = a ^ b
    assert(e == 6, "^ check failed")

    // Test ~: ~12 = -13 (in 2s complement)
    auto f = ~ a
    assert(f == -13, "~ check failed")

    // Test simple precedence with parens (User style)
    // (1 | 2) & 4 = 3 & 4 = 0
    auto g = (1 | 2) & 4
    assert(g == 0, "Parens precedence check failed")

    // Test without parens? 
    // Precedence: & (10) > | (5)
    // 1 | 2 & 4 = 1 | (2 & 4) = 1 | 0 = 1
    auto h = 1 | 2 & 4
    assert(h == 1, "Precedence check (& > |) failed")

    // Test <<: 1 << 2 = 4 (High precedence)
    auto i = 1 << 2
    assert(i == 4, "<< check failed")

    // Test >>: 4 >> 1 = 2 (High precedence)
    auto j = 4 >> 1
    assert(j == 2, ">> check failed")

    // Test precedence: 1 << 2 | 1
    // (1 << 2) | 1 = 4 | 1 = 5.
    // 1 << (2 | 1) = 1 << 3 = 8.
    auto k = 1 << 2 | 1
    assert(k == 5, "Precedence check (<< > |) failed")

    return 0
}
