import std/io::println
import ./nested/toka-ink as toka_ink

fn main() -> i32 {
    // 1. File path segments may use kebab-case, but the Toka alias is an identifier.
    auto res = toka_ink::render(42)
    println("res = {}", res)

    // 2. Binary minus is an operator and must stay visually separate.
    auto sub1 = 10 - 3
    auto sub2 = sub1 - 2
    println("sub2 = {}", sub2)

    return 0
}
