shape Cell(value#: i32)

fn main() -> i32 {
    auto ^first# = new Cell(value = 1)
    auto owners# = [cede ^first]

    for alias ^x# in owners {
        x.value = 2
    }
    for alias ^x in owners {
        assert(x.value == 2,
               "alias ^x# must write the original pointee payload")
    }

    for alias ^#x in owners {
        auto ^replacement = new Cell(value = 3)
        ^x = ^replacement
    }
    for alias ^x in owners {
        assert(x.value == 3,
               "alias ^#x must rebind the original handle slot")
    }
    return 0
}
