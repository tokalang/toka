import stdx/net/http::HeaderMap

fn main() -> i32 {
    auto headers# = HeaderMap::new()
    auto inserted = headers#.insert(
        string::from("content-type"),
        string::from("application/json")
    )
    if inserted.is_err() { return 1 }

    match headers.lookup("Content-Type") {
        auto &value => {
            if !value.as_str().equals("application/json") { return 2 }
        }
        miss => return 3
    }
    match headers.lookup("x-absent") {
        auto &value => return 4
        miss => {}
    }
    return 0
}
