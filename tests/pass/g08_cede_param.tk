import sys/libc::{libc_exit}

shape Resource(val: i32)

pub fn consume_resource(cede r: Resource) -> Resource {
    return cede r
}

pub fn main() -> i32 {
    auto r = Resource(val=42)
    // Correct usage: caller explicitly cedes
    auto moved = consume_resource(cede r)
    
    if moved.val != 42 {
        return 1
    }
    return 0
}
