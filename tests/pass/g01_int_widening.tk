import std/io::println

fn expect_u64(val: u64) {
    if val == 42:u64 {
        println("expect_u64 got 42")
    }
}

fn main() -> i32 {
    // 1. Literal widening
    auto a: u64 = 42
    expect_u64(a)

    // 2. Variable widening
    auto b: u32 = 42
    auto c: u64 = b
    expect_u64(c)

    // 3. Smaller to larger
    auto d: u8 = 42
    auto e: i32 = d
    if e == 42 {
        println("u8 to i32 widening passed")
    }

    // 4. Function call argument widening
    auto f: u16 = 42
    expect_u64(f)

    return 0
}
