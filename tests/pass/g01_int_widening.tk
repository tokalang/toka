import std/io::println

fn expect_u64(val: u64) {
    if val == 42:u64 {
        println("expect_u64 got 42")
    }
}

fn main() -> i32 {
    // 1. Literal widening
    auto a = 42:u64
    expect_u64(a)

    // 2. Variable widening
    auto b = 42:u32
    auto c = b:u64
    expect_u64(c)

    // 3. Smaller to larger
    auto d = 42:u8
    auto e = d:i32
    if e == 42 {
        println("u8 to i32 widening passed")
    }

    // 4. Function call argument widening
    auto f = 42:u16
    expect_u64(f)

    return 0
}
