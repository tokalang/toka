fn build(flag: bool) -> i32 {
    auto value = uninit:i32
    init value {
        if flag {
            init value = 1:i32
        } else {
            init value = 2:i32
        }
    }
    if value == 1:i32 || value == 2:i32 {
        return 0:i32
    }
    return 1:i32
}

fn main() -> i32 {
    return build(true)
}
