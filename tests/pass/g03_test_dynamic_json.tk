import stdx/serde/json::{parse_document, to_json}
fn main() -> i32 {
    auto input = string::from("{\"name\":\"Toka\",\"version\":1.0,\"is_fast\":true,\"scores\":[100,99.5],\"meta\":{\"type\":null}}")
    auto result = parse_document(input.as_str())
    if result.is_err() { return 1 }
    auto document = result.unwrap()
    if document.kind(1) != 5 { return 2 }
    if document.text(document.find(1, "name")) != "Toka" { return 3 }
    if document.number(document.find(1, "version")).unwrap() != 1.0 { return 4 }
    if !document.boolean(document.find(1, "is_fast")).unwrap() { return 5 }
    auto scores = document.find(1, "scores")
    auto first = document.first(scores)
    if document.number(first).unwrap() != 100.0 { return 6 }
    if document.number(document.next(first)).unwrap() != 99.5 { return 7 }
    auto meta = document.find(1, "meta")
    if document.kind(document.find(meta, "type")) != 0 { return 8 }
    auto serialized = to_json(document)
    auto reparsed = parse_document(serialized.as_str())
    if reparsed.is_err() { return 9 }
    return 0
}
