import std/bytes::{Bytes, bytes_from_array}
import std/vec::{Vec}
import stdx/crypto/hkdf::{derive, expand, extract}
import stdx/encoding/hex

fn sequence(length: usize, first: u8) -> Vec<u8> {
    auto values# = Vec<u8>::new()
    auto index# = 0:usize
    loop index < length {
        values#.push(first + index as u8)
        index = index + 1:usize
    }
    return values
}

fn repeated(length: usize, value: u8) -> Vec<u8> {
    auto values# = Vec<u8>::new()
    auto index# = 0:usize
    loop index < length {
        values#.push(value)
        index = index + 1:usize
    }
    return values
}

fn main() -> i32 {
    // RFC 5869, test case 1.
    auto ikm = Bytes::from_vec(cede repeated(22:usize, 0x0b:u8))
    auto salt = Bytes::from_vec(cede sequence(13:usize, 0x00:u8))
    auto info = Bytes::from_vec(cede sequence(10:usize, 0xf0:u8))

    auto prk = extract(salt.as_slice(), ikm.as_slice())
    assert(hex::encode(bytes_from_array<32>(prk)).equals(
               "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"),
           "HKDF extract must match RFC 5869 case 1 PRK")

    auto output = derive(salt.as_slice(), ikm.as_slice(), info.as_slice(), 42:usize).unwrap()
    auto output_owner = Bytes::from_vec(cede output)
    assert(hex::encode(output_owner.as_slice()).equals(
               "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"),
           "HKDF derive must match RFC 5869 case 1 OKM")

    auto prk_zero = [0:u8; 32]:[u8; 32]
    assert(expand(prk_zero, "".as_bytes(), 8161:usize).is_err(),
           "HKDF expand must reject output beyond 255 blocks")
    return 0
}
