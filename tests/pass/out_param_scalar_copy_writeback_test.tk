// Direct scalar copy through a writable out parameter must reach the payload.
// Gate for: a plain value copy into a writable payload being misread as a
// handle-authority transfer (previously rejected as a capability mismatch).
fn store(*out: u64#) {
    auto value = 123:u64
    auto *p# = *out
    p = value
}

pub fn main() -> i32 {
    auto key# = 0:u64
    store(&key as *u64#)
    if key != 123:u64 { return 1 }
    return 0
}
