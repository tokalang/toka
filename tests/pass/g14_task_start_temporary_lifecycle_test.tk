fn coordinate() -> async i32 {
    test_fresh_direct_normal().await
    test_fresh_start_normal().await
    test_named_start_normal().await
    test_member_handle_normal().await
    test_cede_handle_normal().await
    test_anonymous_unit().await
    test_fresh_start_cancel().await
    test_named_start_cancel().await
    test_fresh_direct_cancel().await
    test_named_direct_cancel().await
    return 0:i32
}

fn main() -> i32 {
    auto rc = block_on<i32>(coordinate().start)
    assert(toka_rt_live_tcb_count() == 0:u32, "TCB count zero after block_on")
    assert(toka_rt_live_wait_registry_count() == 0:u32, "wait registry count zero after block_on")
    println("All 10 lifecycle and cancellation controls passed with zero TCB residue and exact-once drop!")
    return rc
}
