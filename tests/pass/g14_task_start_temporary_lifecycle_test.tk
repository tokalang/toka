fn test_named_direct_cancel() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(90:i32)
        auto task = forwarded_named_direct(cede r)
        auto nul *tcb = task_get_coro_handle<TrackedResource>(task)
        auto *live = tcb.unwrap()
        toka_task_start(*live)
        auto polls# = 0:i32
