import std/task::{block_on, sleep_async, task_cancel}
import core/task::{TaskHandle, task_get_coro_handle, toka_task_start}
import core/option::{Option}
import std/vec::{Vec}
import std/io::{println}

extern fn toka_rt_live_tcb_count() -> u32
extern fn toka_rt_live_wait_registry_count() -> u32

auto g_drops# = 0:i32

shape TrackedResource (
    id: i32,
    buf: Vec<u8>
)

impl TrackedResource@Encap {
    fn drop(self#) {
        g_drops += 1:i32
    }
}

shape TaskHolder (
    task: TaskHandle<TrackedResource>
)

fn make_resource(id: i32) -> TrackedResource {
    auto b# = Vec<u8>::with_capacity(16:usize)
    b#.push(1:u8)
    b#.push(2:u8)
    b#.push(3:u8)
    return TrackedResource(id = id, buf = cede b)
}

fn child_immediate(cede r: TrackedResource) -> async TrackedResource {
    auto res = cede r
    return cede res
}

fn child_cancellable(cede r: TrackedResource) -> async TrackedResource {
    auto res = cede r
    auto waited = sleep_async(1000:i32).await?
    return cede res
}

fn child_unit() -> async {
    return
}

fn forwarded_fresh_start(cede r: TrackedResource) -> async TrackedResource {
    auto res = child_cancellable(cede r).start.await
    return cede res
}

fn forwarded_named_start(cede r: TrackedResource) -> async TrackedResource {
    auto h = child_cancellable(cede r).start
    auto res = h.await
    return cede res
}

fn forwarded_fresh_direct(cede r: TrackedResource) -> async TrackedResource {
    auto res = child_cancellable(cede r).await
    return cede res
}

fn forwarded_named_direct(cede r: TrackedResource) -> async TrackedResource {
    auto h = child_cancellable(cede r)
    auto res = h.await
    return cede res
}

fn test_fresh_direct_normal() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(10:i32)
        auto res = child_immediate(cede r).await
        assert(res.id == 10:i32, "fresh direct value")
        assert(g_drops == 0:i32, "not dropped during call")
    }
    assert(g_drops == 1:i32, "fresh direct dropped once on scope exit")
    return 0:i32
}

fn test_fresh_start_normal() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(20:i32)
        auto res = child_immediate(cede r).start.await
        assert(res.id == 20:i32, "fresh start value")
        assert(g_drops == 0:i32, "not dropped during call")
    }
    assert(g_drops == 1:i32, "fresh start dropped once on scope exit")
    return 0:i32
}

fn test_named_start_normal() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(30:i32)
        auto h = child_immediate(cede r).start
        auto res = h.await
        assert(res.id == 30:i32, "named start value")
        assert(g_drops == 0:i32, "not dropped during call")
    }
    assert(g_drops == 1:i32, "named start dropped once on scope exit")
    return 0:i32
}

fn test_member_handle_normal() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(40:i32)
        auto h = child_immediate(cede r)
        auto c = TaskHolder(task = cede h)
        auto res = c.task.await
        assert(res.id == 40:i32, "member handle value")
        assert(g_drops == 0:i32, "not dropped during call")
    }
    assert(g_drops == 1:i32, "member handle dropped once on scope exit")
    return 0:i32
}

fn test_cede_handle_normal() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(50:i32)
        auto h = child_immediate(cede r)
        auto res = (cede h).await
        assert(res.id == 50:i32, "cede handle value")
        assert(g_drops == 0:i32, "not dropped during call")
    }
    assert(g_drops == 1:i32, "cede handle dropped once on scope exit")
    return 0:i32
}

fn test_anonymous_unit() -> async i32 {
    child_unit().await
    return 0:i32
}

fn test_fresh_start_cancel() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(60:i32)
        auto task = forwarded_fresh_start(cede r)
        auto nul *tcb = task_get_coro_handle<TrackedResource>(task)
        auto *live = tcb.unwrap()
        toka_task_start(*live)
        auto polls# = 0:i32
        loop toka_rt_live_wait_registry_count() == 0:u32 && polls < 100:i32 {
            sleep_async(1:i32).await
            polls += 1:i32
        }
        assert(toka_rt_live_wait_registry_count() > 0:u32, "fresh_start suspended")
        task_cancel<TrackedResource>(task)
        auto out = task.await?
        assert(out.is_none(), "fresh_start cancel outcome None")
    }
    assert(g_drops == 1:i32, "fresh_start resource dropped exactly once on cancellation")
    assert(toka_rt_live_wait_registry_count() == 0:u32, "fresh_start wait cleaned up")
    return 0:i32
}

fn test_named_start_cancel() -> async i32 {
    g_drops = 0:i32
    {
        auto r = make_resource(70:i32)
        auto task = forwarded_named_start(cede r)
        auto nul *tcb = task_get_coro_handle<TrackedResource>(task)
        auto *live = tcb.unwrap()
        toka_task_start(*live)
        auto polls# = 0:i32
