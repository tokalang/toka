// tests/pass/g12_stdx_tls_test.tk — Phase 5B Real OpenSSL TLS Engine Test Suite
import std/net::{TcpListener, TcpStream, SocketAddrV4, Ipv4Addr}
import stdx/net/stream::{AsyncStream, to_u8_ptr}
import stdx/net/tls::{TlsStream}
import std/task::{sleep_async, block_on}
import core/result::{Result}
import core/types::{Addr}
import std/io::{println}
import std/vec::{Vec}

fn async_tls_server_task(cede listener: TcpListener) -> async Result<(), string> {
    auto listener# = cede listener
    if !listener.is_valid() {
        return Result<(), string>::Err(string::from("Bind failed"))
    }

    println("[TlsServer] Listening on local port...")
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() {
        return Result<(), string>::Err(string::from("Accept failed"))
    }

    println("[TlsServer] Performing server TLS handshake...")
    auto tls_res# = TlsStream::accept_async(stream).await
    if tls_res.is_err() {
        return Result<(), string>::Err(tls_res.unwrap_err())
    }
    auto async_s# = tls_res.unwrap()
    println("[TlsServer] OpenSSL TLS Server Handshake Complete!")

    // Read request payload over TLS
    auto buf# = Vec<u8>::with_capacity(128)
    auto i#: usize = 0
    loop i < 128 { buf#.push(0:u8); i += 1 }
    auto *buf_raw# = buf.unsafe_as_raw()

    auto *u8_buf# = to_u8_ptr(*buf_raw)
    auto r = async_s#.read_async(*u8_buf, 128:usize).await
    if r.is_err() {
        return Result<(), string>::Err(r.unwrap_err())
    }
    auto bytes_read = r.unwrap()
    if bytes_read == 0:usize {
        return Result<(), string>::Err(string::from("Server read 0 bytes EOF"))
    }
    println("[TlsServer] Received {} bytes encrypted payload over TLS successfully!", bytes_read)

    // Echo response over TLS
    auto resp = string::from("HTTP/1.1 200 OK\r\nContent-Length: 17\r\n\r\nHello OpenSSL 1.3")
    auto *resp_ptr# = resp.raw_ptr() as *[u8]
    auto *u8_resp# = to_u8_ptr(*resp_ptr)
    auto w = async_s#.write_all_async(*u8_resp, resp.len()).await
    if w.is_err() {
        return Result<(), string>::Err(w.unwrap_err())
    }

    sleep_async(50:u64).await
    async_s#.close()
    println("[TlsServer] TLS Server session finished cleanly.")
    return Result<(), string>::Ok(())
}

fn async_tls_client_task(port: u16) -> async Result<(), string> {
    sleep_async(50:u64).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    println("[TlsClient] Connecting to 127.0.0.1...")
    auto tcp_stream# = TcpStream::connect_async(addr).await
    if !tcp_stream.is_valid() {
        return Result<(), string>::Err(string::from("TCP connect failed"))
    }

    println("[TlsClient] Performing OpenSSL TLS handshake with SNI 'localhost' (insecure mode)...")
    auto tls_res = TlsStream::connect_insecure_async(tcp_stream, string::from("localhost")).await
    if tls_res.is_err() {
        return Result<(), string>::Err(tls_res.unwrap_err())
    }

    auto tls_stream# = tls_res.unwrap()
    println("[TlsClient] OpenSSL TLS Handshake complete! Transmitting GET request...")

    auto req = string::from("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
    auto *req_ptr# = req.raw_ptr() as *[u8]
    auto *u8_req# = to_u8_ptr(*req_ptr)

    auto w = tls_stream#.write_all_async(*u8_req, req.len()).await
    if w.is_err() {
        return Result<(), string>::Err(string::from("Write request failed"))
    }

    auto buf# = Vec<u8>::with_capacity(256)
    auto i#: usize = 0
    loop i < 256 { buf#.push(0:u8); i += 1 }
    auto *buf_raw# = buf.unsafe_as_raw()

    auto *u8_buf# = to_u8_ptr(*buf_raw)
    auto r = tls_stream#.read_async(*u8_buf, 256:usize).await
    if r.is_err() {
        return Result<(), string>::Err(r.unwrap_err())
    }
    auto n = r.unwrap()
    if n == 0:usize {
        return Result<(), string>::Err(string::from("Client received 0 bytes response over TLS"))
    }
    println("[TlsClient] Received {} bytes response payload over TLS!", n)

    tls_stream#.close()
    println("[TlsClient] TLS Client finished successfully.")
    return Result<(), string>::Ok(())
}

fn main_async() -> async i32 {
    println("--- Starting Real OpenSSL TLS Engine Qualification Test ---")
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() {
        println("[FAIL] Listener bind failed")
        return 1
    }
    auto port = listener.local_port()
    auto server_task# = async_tls_server_task(cede listener).start
    auto client_task# = async_tls_client_task(port).start

    auto c_res = client_task.await
    auto s_res = server_task.await

    if s_res.is_ok() && c_res.is_ok() {
        println("Phase 5B Real OpenSSL TLS Test PASSED Cleanly!")
        return 0
    }

    if s_res.is_err() {
        println("[FAIL] Server error: {}", s_res.unwrap_err().as_str())
    }
    if c_res.is_err() {
        println("[FAIL] Client error: {}", c_res.unwrap_err().as_str())
    }
    return 1
}

fn main() -> i32 {
    return block_on<i32>(main_async())
}
