import core/traits::{@Encap}

auto g_drop_count# = 0

shape CleanupToken(
    id: i32
)

impl CleanupToken@Encap {
    fn drop(self#) {
        g_drop_count += 1
    }
}

fn build_token(init out: CleanupToken) {
    init out = CleanupToken(id = 7)
}

fn construct_and_drop() {
    auto value = uninit:CleanupToken
    build_token(init value)
}

fn main() -> i32 {
    construct_and_drop()
    assert(g_drop_count == 1, "init formal must enable exactly one caller drop")
    return 0
}
