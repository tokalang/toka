import stdx/serde/json::{parse_document, to_json, ToJson, serialize_shape}

import std/io::{println}
import std/vec::{Vec}
import core/result::{Result}
import core/str::{str}

shape User(
    id: i32 = 0,
    name: string = string::from(""),
    active: bool = false,
    tags#: Vec<string> = Vec<string>::new(),
    email: Option<string> = Option<string>::None,
    status: Result<i32, string> = Result<i32, string>::Ok(0)
)

impl User@ToJson {
    pub fn write_json(self, buf#: string) {
        serialize_shape(self, buf#)
    }
}

fn main() -> i32 {
    auto u# = User(
        id = 1,
        name = string::from("Alice"),
        active = true,
        tags = Vec<string>::new(),
        email = Option<string>::Some(string::from("alice@example.com")),
        status = Result<i32, string>::Err(string::from("Offline"))
    )
    
    u.tags#.push(string::from("rust"))
    u.tags#.push(string::from("toka"))
    
    auto json = to_json(u)
    println("JSON: {}", json.as_view())
    
    // Read the complete serialized content through the new dynamic document API.
    auto parsed = parse_document(json.as_view())
    if parsed.is_err() { return 1 }
    auto document = parsed.unwrap()
    if document.number(document.find(1, "id")).unwrap() != 1.0 { return 2 }
    if document.text(document.find(1, "name")) != "Alice" { return 3 }
    auto tags = document.find(1, "tags")
    auto first = document.first(tags)
    if document.text(first) != "rust" { return 4 }
    if document.text(document.next(first)) != "toka" { return 5 }
    if document.text(document.find(1, "email")) != "alice@example.com" { return 6 }
    auto status = document.find(1, "status")
    if document.text(document.find(status, "Err")) != "Offline" { return 7 }
    return 0
}
