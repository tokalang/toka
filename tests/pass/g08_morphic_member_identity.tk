shape Box<T>(
  Value(T) = 1
)

fn take_identity<T>(cede box: Box<T>) -> T {
  match cede box {
    auto Box<T>::Value(data) => return cede data
  }
}

fn main() -> i32 {
  unsafe {
    auto owned = Box<^i32>::Value(new i32(5))
    auto ^p = take_identity<^i32>(cede owned)
    if p != 5 { return 1 }
  }

  auto local = 9
  auto borrowed = Box<&i32>::Value(&local)
  auto &r = take_identity<&i32>(cede borrowed)
  if r != 9 { return 2 }

  auto value = Box<i32>::Value(7)
  auto v = take_identity<i32>(cede value)
  if v != 7 { return 3 }

  return 0
}
