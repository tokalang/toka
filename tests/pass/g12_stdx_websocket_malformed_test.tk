    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()

    // Send Text Frame with Invalid UTF-8 Sequence (0xFF, 0xFF)
    auto f# = Vec<u8>::new()
    f#.push(0x81:u8) // FIN=1, Text
    f#.push(0x82:u8) // Masked, len=2
    f#.push(0x00:u8) // Mask Key
    f#.push(0x00:u8)
    f#.push(0x00:u8)
    f#.push(0x00:u8)
    f#.push(0xFF:u8) // Invalid UTF-8
    f#.push(0xFF:u8)
    auto *f_raw# = f.unsafe_as_raw()
    auto *u8_f# = to_u8_ptr(*f_raw)
    auto _w = ws.stream#.write_all_async(*u8_f, f.len()).await
    return Result<(), string>::Ok(())
}

