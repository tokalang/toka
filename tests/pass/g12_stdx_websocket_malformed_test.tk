        auto err = msg_res.unwrap_err()
        if err.as_view().index_of_str("Text message payload MUST be valid UTF-8").is_some() {
            println("[Test 7/10 PASSED] Correctly rejected invalid UTF-8 text frame!")
            return Result<(), string>::Ok(())
        }
        return Result<(), string>::Err(err)
    }
    return Result<(), string>::Err(string::from("Accepted invalid UTF-8 text frame"))
