fn run_t7_client(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
