// Test 9: Multi-Frame Fragmented UTF-8 Validation (Split multi-byte character '¢' C2 A2 across 2 fragments)
fn run_t9_server(port: u16) -> async Result<(), string> {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto listener# = TcpListener::bind(addr)
    auto stream# = listener#.accept_async().await
    auto ws_res = ws_accept_async(stream).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()
    auto msg_res = ws#.read_message_async().await
    if msg_res.is_ok() {
        auto msg = msg_res.unwrap()
        if msg.text_data.as_view().equals("¢") {
            println("[Test 9/10 PASSED] Correctly validated multi-frame split UTF-8 character '¢' across fragments!")
            return Result<(), string>::Ok(())
        }
    }
    return Result<(), string>::Err(string::from("Failed multi-frame split UTF-8 character test"))
}

fn run_t9_client(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
    auto ws_res = ws_connect_async(stream, string::from("127.0.0.1"), string::from("/ws")).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()

    // Fragment 1: FIN=0, Text (0x01), Payload = [0xC2] (first half of '¢')
    auto f1# = Vec<u8>::new()
    f1#.push(0x01:u8)
    f1#.push(0x81:u8)
    f1#.push(0x00:u8)
    f1#.push(0x00:u8)
    f1#.push(0x00:u8)
    f1#.push(0x00:u8)
    f1#.push(0xC2:u8)
    auto *f1_raw# = f1.unsafe_as_raw()
    auto *u8_f1# = to_u8_ptr(*f1_raw)
    auto _w1 = ws.stream#.write_all_async(*u8_f1, f1.len()).await

    sleep_async(20).await

    // Fragment 2: FIN=1, Continuation (0x80), Payload = [0xA2] (second half of '¢')
    auto f2# = Vec<u8>::new()
    f2#.push(0x80:u8)
    f2#.push(0x81:u8)
    f2#.push(0x00:u8)
    f2#.push(0x00:u8)
    f2#.push(0x00:u8)
    f2#.push(0x00:u8)
    f2#.push(0xA2:u8)
    auto *f2_raw# = f2.unsafe_as_raw()
    auto *u8_f2# = to_u8_ptr(*f2_raw)
    auto _w2 = ws.stream#.write_all_async(*u8_f2, f2.len()).await

    return Result<(), string>::Ok(())
}

// Test 10: Invalid Reason Phrase ("HTTP/1.1 101 Bad") Rejection
fn run_t10_server(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
    auto res = ws_connect_async(stream, string::from("127.0.0.1"), string::from("/ws")).await
    if res.is_err() {
        auto err = res.unwrap_err()
        if err.as_view().index_of_str("Response MUST be HTTP/1.1 101 Switching Protocols").is_some() {
            println("[Test 10/10 PASSED] Correctly rejected invalid status line 'HTTP/1.1 101 Bad'!")
            return Result<(), string>::Ok(())
        }
        return Result<(), string>::Err(err)
    }
    return Result<(), string>::Err(string::from("Accepted invalid status line 'HTTP/1.1 101 Bad'"))
}

fn run_t10_client(port: u16) -> async Result<(), string> {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto listener# = TcpListener::bind(addr)
    auto stream# = listener#.accept_async().await
    auto resp# = string::from("HTTP/1.1 101 Bad\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n")
    auto *p# = resp.raw_ptr() as *[u8]
    auto *u8_p# = to_u8_ptr(*p)
    auto _w = stream#.write_all_async(*u8_p, resp.len()).await
    return Result<(), string>::Ok(())
}

fn main_async() -> async i32 {
    println("--- Starting stdx/net/websocket Real Protocol Negative Qualification Test ---")

    auto s1 = run_t1_server(18101:u16).start
    auto c1 = run_t1_client(18101:u16).start
    auto _c1 = c1.await; auto r1 = s1.await
    if r1.is_err() { println("Test 1 failed!"); return 1 }

    auto s2 = run_t2_server(18102:u16).start
    auto c2 = run_t2_client(18102:u16).start
    auto _c2 = c2.await; auto r2 = s2.await
    if r2.is_err() { println("Test 2 failed!"); return 1 }

    auto s3 = run_t3_server(18103:u16).start
    auto c3 = run_t3_client(18103:u16).start
    auto _c3 = c3.await; auto r3 = s3.await
    if r3.is_err() { println("Test 3 failed!"); return 1 }

    auto s4 = run_t4_server(18104:u16).start
    auto c4 = run_t4_client(18104:u16).start
    auto _c4 = c4.await; auto r4 = s4.await
    if r4.is_err() { println("Test 4 failed!"); return 1 }

    auto s5 = run_t5_server(18105:u16).start
    auto c5 = run_t5_client(18105:u16).start
    auto _c5 = c5.await; auto r5 = s5.await
    if r5.is_err() { println("Test 5 failed!"); return 1 }

    auto s6 = run_t6_server(18106:u16).start
    auto c6 = run_t6_client(18106:u16).start
    auto _c6 = c6.await; auto r6 = s6.await
    if r6.is_err() { println("Test 6 failed!"); return 1 }

    auto s7 = run_t7_server(18107:u16).start
    auto c7 = run_t7_client(18107:u16).start
    auto _c7 = c7.await; auto r7 = s7.await
    if r7.is_err() { println("Test 7 failed!"); return 1 }

    auto s8 = run_t8_server(18108:u16).start
    auto c8 = run_t8_client(18108:u16).start
    auto _c8 = c8.await; auto r8 = s8.await
    if r8.is_err() { println("Test 8 failed!"); return 1 }

    auto s9 = run_t9_server(18109:u16).start
    auto c9 = run_t9_client(18109:u16).start
    auto _c9 = c9.await; auto r9 = s9.await
    if r9.is_err() { println("Test 9 failed!"); return 1 }

    auto s10 = run_t10_server(18110:u16).start
    auto c10 = run_t10_client(18110:u16).start
    auto _c10 = c10.await; auto r10 = s10.await
    if r10.is_err() { println("Test 10 failed!"); return 1 }

    println("g12_stdx_websocket_malformed_test PASSED ALL 10 ISOLATED TEST SUITES Cleanly!")
    return 0
}

fn main() -> i32 {
    return block_on<i32>(main_async())
}
