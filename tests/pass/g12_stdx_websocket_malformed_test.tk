// Test 6: Non-Minimal Extended Payload Length Rejection (126 encoding for 2-byte payload)
fn run_t6_server(port: u16) -> async Result<(), string> {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto listener# = TcpListener::bind(addr)
    auto stream# = listener#.accept_async().await
    auto ws_res = ws_accept_async(stream).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()
    auto msg_res = ws#.read_message_async().await
    if msg_res.is_err() {
        auto err = msg_res.unwrap_err()
        if err.as_view().index_of_str("Non-minimal length encoding").is_some() {
            println("[Test 6/10 PASSED] Correctly rejected non-minimal length encoding for 16-bit payload!")
            return Result<(), string>::Ok(())
        }
        return Result<(), string>::Err(err)
    }
    return Result<(), string>::Err(string::from("Accepted non-minimal length encoding"))
}

fn run_t6_client(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
    auto ws_res = ws_connect_async(stream, string::from("127.0.0.1"), string::from("/ws")).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()

    // Send Text Frame with Non-Minimal 16-bit Length (126) for 2-byte payload
    auto f# = Vec<u8>::new()
    f#.push(0x81:u8) // FIN=1, Text
    f#.push(0xFE:u8) // Masked, payload_len=126
    f#.push(0x00:u8) // ext len high = 0
    f#.push(0x02:u8) // ext len low = 2 (< 126!)
    f#.push(0x11:u8)
    f#.push(0x22:u8)
    f#.push(0x33:u8)
    f#.push(0x44:u8)
    f#.push(0xAA:u8)
    f#.push(0xBB:u8)
    auto *f_raw# = f.unsafe_as_raw()
    auto *u8_f# = to_u8_ptr(*f_raw)
    auto _w = ws.stream#.write_all_async(*u8_f, f.len()).await
    return Result<(), string>::Ok(())
}

