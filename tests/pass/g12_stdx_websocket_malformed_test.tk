// tests/pass/g12_stdx_websocket_malformed_test.tk — Real Protocol Negative & Security Test Suite
import std/net::{TcpListener, TcpStream, SocketAddrV4, Ipv4Addr}
import std/task::{sleep_async, block_on}
import std/io::{println}
import stdx/net/websocket::{ws_accept_async, ws_connect_async, WsConnection, WsMessage, to_u8_ptr}
import core/result::{Result}
import std/vec::{Vec}
import core/types::{Addr}

// Test 1: Invalid Upgrade Header Rejection
fn run_t1_server(port: u16) -> async Result<(), string> {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto listener# = TcpListener::bind(addr)
    auto stream# = listener#.accept_async().await
    auto ws_res = ws_accept_async(stream).await
    if ws_res.is_err() {
        auto err = ws_res.unwrap_err()
        if err.as_view().index_of_str("Upgrade header MUST contain exact token").is_some() {
            println("[Test 1/10 PASSED] Correctly rejected substring Upgrade header 'wrong_proto'!")
            return Result<(), string>::Ok(())
        }
        return Result<(), string>::Err(err)
    }
    return Result<(), string>::Err(string::from("Accepted invalid Upgrade header"))
}

fn run_t1_client(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
    auto req# = string::from("GET /ws HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: wrong_proto\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
    auto *p# = req.raw_ptr() as *[u8]
    auto *u8_p# = to_u8_ptr(*p)
    auto _w = stream#.write_all_async(*u8_p, req.len()).await
    return Result<(), string>::Ok(())
}

// Test 2: Fragmented Control Frame (FIN=0 Ping) Rejection
fn run_t2_server(port: u16) -> async Result<(), string> {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto listener# = TcpListener::bind(addr)
    auto stream# = listener#.accept_async().await
    auto ws_res = ws_accept_async(stream).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()
    auto msg_res = ws#.read_message_async().await
    if msg_res.is_err() {
        auto err = msg_res.unwrap_err()
        if err.as_view().index_of_str("Control frame MUST NOT be fragmented").is_some() {
            println("[Test 2/10 PASSED] Correctly rejected fragmented FIN=0 control frame!")
            return Result<(), string>::Ok(())
        }
        return Result<(), string>::Err(err)
    }
    return Result<(), string>::Err(string::from("Accepted FIN=0 control frame"))
}

fn run_t2_client(port: u16) -> async Result<(), string> {
    sleep_async(50).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto stream# = TcpStream::connect_async(addr).await
    auto ws_res = ws_connect_async(stream, string::from("127.0.0.1"), string::from("/ws")).await
    if ws_res.is_err() {
        return Result<(), string>::Err(ws_res.unwrap_err())
    }
    auto ws# = ws_res.unwrap()

    // Send FIN=0 Ping Frame (0x09 0x80 <mask_key>)
    auto f# = Vec<u8>::new()
    f#.push(0x09:u8)
    f#.push(0x80:u8)
    f#.push(0x11:u8)
    f#.push(0x22:u8)
    f#.push(0x33:u8)
    f#.push(0x44:u8)
    auto *f_raw# = f.unsafe_as_raw()
    auto *u8_f# = to_u8_ptr(*f_raw)
    auto _w = ws.stream#.write_all_async(*u8_f, f.len()).await
    return Result<(), string>::Ok(())
}

