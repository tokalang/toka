import std/io::{println, File, remove_file}
import std/vec::{Vec}
import stdx/data/csv::{parse_records, write_records, read_record, write_record}
import stdx/io/bufio::{BufferedReader, BufferedWriter}

fn assert_field(records#: Vec<Vec<string>>, row: usize, column: usize, expected: str) {
    auto &record = records.borrow(row)
    auto &field = record.borrow(column)
    assert(field.as_str().equals(expected), "unexpected CSV field")
}

fn test_parse_rfc4180_core() {
    auto parsed = parse_records("name,quote\r\nalice,\"hello, \"\"world\"\"\"\r\n")
    assert(parsed.is_ok(), "RFC 4180 core input must parse")
    auto records# = parsed.unwrap()
    assert(records.len() == 2, "expected two records")
    assert_field(records, 0, 0, "name")
    assert_field(records, 1, 0, "alice")
    assert_field(records, 1, 1, "hello, \"world\"")

    auto multiline = parse_records("id,notes\r\n1,\"one\r\ntwo\"\r\n")
    assert(multiline.is_ok(), "CRLF inside a quoted field must parse")
    auto multiline_records# = multiline.unwrap()
    assert_field(multiline_records, 1, 1, "one\r\ntwo")
}

fn test_write_round_trip() {
    auto first# = Vec<string>::new()
    first#.push(cede string::from("plain"))
    first#.push(cede string::from("needs,quote"))
    first#.push(cede string::from("say \"hi\""))
    auto records# = Vec<Vec<string>>::new()
    records#.push(cede first)
    auto wire = write_records(cede records)
    assert(wire.as_str().equals("plain,\"needs,quote\",\"say \"\"hi\"\"\"\r\n"),
           "CSV writer must quote delimiters and escape quotes")
    auto reparsed = parse_records(wire.as_str())
    assert(reparsed.is_ok(), "writer output must parse")
    auto rows# = reparsed.unwrap()
    assert_field(rows, 0, 1, "needs,quote")
    assert_field(rows, 0, 2, "say \"hi\"")
}

fn test_errors() {
    auto unclosed = parse_records("a,\"unterminated")
    assert(unclosed.is_err(), "unclosed quote must fail")
    auto unclosed_error = unclosed.unwrap_err()
    assert(unclosed_error.line == 1 && unclosed_error.column == 16,
           "unclosed quote must report its EOF position")
    auto bare_lf = parse_records("a,b\n")
    assert(bare_lf.is_err(), "bare LF must fail")
    auto bare_lf_error = bare_lf.unwrap_err()
    assert(bare_lf_error.line == 1 && bare_lf_error.column == 4,
           "bare LF must report its byte position")
    auto uneven = parse_records("a,b\r\nc\r\n")
    assert(uneven.is_err(), "unequal record width must fail")
}

fn test_streaming_adapters() {
    auto path = string::from("toka_csv_streaming_test.tmp")
    {
        auto file# = File::open(path.clone(), "w")
        assert(file.is_valid(), "CSV test output file must open")
        auto writer# = BufferedWriter<File>::new(cede file#.take())
        auto record# = Vec<string>::new()
        record#.push(cede string::from("1"))
        record#.push(cede string::from("one\r\ntwo"))
        assert(write_record<File>(writer, cede record).is_ok(), "streaming CSV write must succeed")
        assert(writer#.flush().is_ok(), "streaming CSV flush must succeed")
    }
    {
        auto file# = File::open(path.clone(), "r")
        assert(file.is_valid(), "CSV test input file must open")
        auto reader# = BufferedReader<File>::new(cede file#.take())
        auto next = read_record<File>(reader, 64)
        assert(next.is_ok(), "streaming CSV read must not fail")
        auto record_opt = next.unwrap()
        assert(record_opt.is_some(), "streaming CSV record must read")
        auto record = record_opt.unwrap()
        auto field = record.borrow(1).clone()
        assert(field.as_str().equals("one\r\ntwo"), "streaming CSV field mismatch")
        auto eof = read_record<File>(reader, 64)
        assert(eof.is_ok(), "streaming CSV EOF read must not fail")
        auto eof_record = eof.unwrap()
        assert(eof_record.is_none(), "streaming CSV reader must stabilize at EOF")
    }
    {
        auto file# = File::open(path.clone(), "r")
        assert(file.is_valid(), "bounded CSV test input file must open")
        auto reader# = BufferedReader<File>::new(cede file#.take())
        auto bounded = read_record<File>(reader, 4)
        assert(bounded.is_err(), "streaming CSV record limit must be enforced")
    }
    remove_file(path)
}

fn main() -> i32 {
    test_parse_rfc4180_core()
    test_write_round_trip()
    test_errors()
    test_streaming_adapters()
    println("g14_stdx_csv_test PASSED!")
    return 0
}
