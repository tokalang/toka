import std/io::{println}
import stdx/data/csv::{parse_records, write_records}

fn assert_canonical(input: str) {
    auto parsed = parse_records(input)
    assert(parsed.is_ok(), "valid CSV corpus case must parse")
    auto records = cede parsed.unwrap()
    auto canonical = write_records(cede records)
    auto reparsed = parse_records(canonical.as_str())
    assert(reparsed.is_ok(), "CSV writer output must parse")
    auto reparsed_records = cede reparsed.unwrap()
    auto recanonical = write_records(cede reparsed_records)
    assert(canonical.as_str().equals(recanonical.as_str()),
           "CSV parse/write canonicalization must be stable")
}

fn assert_rejected(input: str) {
    assert(parse_records(input).is_err(), "invalid CSV corpus case must fail")
}

fn main() -> i32 {
    // Deterministic corpus: delimiters, escaped quotes, CRLF in quoted fields,
    // empty fields, multiple records, and a final unterminated record.
    assert_canonical("")
    assert_canonical("a,b\r\n")
    assert_canonical("a,\"b,c\"\r\n")
    assert_canonical("a,\"b\"\"c\"\r\n")
    assert_canonical("id,note\r\n1,\"first\r\nsecond\"\r\n")
    assert_canonical(",,\r\n,,\r\n")
    assert_canonical("final,record")

    assert_rejected("a,b\n")
    assert_rejected("a,\"unterminated")
    assert_rejected("a\"b,c")
    assert_rejected("a,b\rc,d")
    assert_rejected("a,b\r\nc\r\n")

    println("g14_stdx_csv_corpus_test PASSED!")
    return 0
}
