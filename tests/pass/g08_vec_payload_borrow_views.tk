import std/vec::Vec

fn main() -> i32 {
    {
        auto value = 43
        auto values# = Vec<&i32>::new()
        values = values#.appended(&value)
        auto &&payload = values.borrow(0:usize)
        assert(payload == 43, "Vec<&T>.borrow preserves both reference layers")
    }

    {
        auto values# = Vec<i32>::new()
        values#.push(41)
        auto &payload# = values#.borrow_mut(0:usize)
        payload = 42
        assert(payload == 42,
               "Vec<T>.borrow_mut view must retain the written payload")
        assert(values.get(0:usize) == 42,
               "Vec<T>.borrow_mut must expose writable payload")
    }

    return 0
}
