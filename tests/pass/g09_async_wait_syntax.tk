import std/task
import std/task::{block_on, __toka_spawn_blocking}

fn fetch() -> async str {
    auto result = "hello":str
    return result
}

fn read_config() -> wait str {
    auto result = "config":str
    return result
}

fn pure_caller() {
    block_on<str>(fetch())
}

pub fn main() -> i32 {
    fetch().start
    pure_caller()
    return 0
}
