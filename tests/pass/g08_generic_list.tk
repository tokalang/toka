// tests/pass/generic_list.tk
import core/traits::{@Encap}
import std/io::println
shape Node<T> (
    val: T,
    nul ^next: Node<T>
)
impl<T> Node<T>@Encap {
    pub val
    fn drop(self#) {
        println("dropping Node")
    }
}
fn main() -> i32 {
    // Recursive instantiation check
    // Node<i32> contains ^Node<i32>
    auto ^head = new Node<i32>(val=1, ^next=null)
    
    // Explicit recursion test
    auto ^second = new Node<i32>(val=2, ^next=cede ^head)
    
    return 0
}
