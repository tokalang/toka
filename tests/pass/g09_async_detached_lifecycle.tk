import std/task::{block_on, detach_forget, sleep_async}

auto g_detached_finished# = false
auto g_detached_drops# = 0

shape DetachedProbe()

impl DetachedProbe@encap {
    fn drop(self#) {
        g_detached_drops += 1
    }

}

fn detached_child() -> async i32 {
    auto probe# = DetachedProbe()
    sleep_async(1).await
    g_detached_finished = true
    return 7
}

fn audit_detached_lifecycle() -> async i32 {
    auto child# = detached_child().start
    detach_forget<i32>(cede child)
    sleep_async(5).await
    assert(g_detached_finished, "detached task did not complete")
    assert(g_detached_drops == 1, "detached task local was not dropped exactly once")
    return 0
}

fn main() -> i32 {
    auto root# = audit_detached_lifecycle().start
    return block_on<i32>(root)
}
