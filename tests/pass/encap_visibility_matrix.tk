import tests/import_test/encap_visibility_lib::{WildcardBox, PathBox, CrateBox}

fn main() -> i32 {
    auto w = WildcardBox::new(3, 4)
    auto p = PathBox::new(5, 6)
    auto c = CrateBox::new(7, 8)

    assert(w.open_val == 3, "exactly granted field should be visible")
    assert(p.path_val == 5, "exactly granted field should be visible")
    assert(c.crate_val == 7, "exactly granted field should be visible")
    return 0
}
