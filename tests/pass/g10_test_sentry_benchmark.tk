import std/io::{File, println}

import core/str::{str}
import stdx/serde/json::{deserialize_shape, @JsonFactory, Parsed, parse_document}

pub shape SentryScope (
    _notifyingListeners: bool = false
)

impl SentryScope@JsonFactory {
    pub fn parse_value(input: str) -> Result<Parsed<SentryScope>, str> <- input {
        auto attempt = parse_document(input)
        if attempt.is_err() {
            auto error = Result<Parsed<SentryScope>, str>::Err("Invalid JSON")
            return cede error
        }
        auto document = attempt.unwrap()
        if document.kind(1) != 5 {
            auto error = Result<Parsed<SentryScope>, str>::Err("Expected object")
            return cede error
        }
        auto f_idx = document.find(1, "_notifyingListeners")
        auto notifying# = false
        if f_idx != 0:usize {
            auto bool_opt = document.boolean(f_idx)
            if bool_opt.is_some() {
                notifying = bool_opt.unwrap()
            }
        }
        auto val = SentryScope(_notifyingListeners = notifying)
        auto parsed = Parsed<SentryScope>(value = cede val, rest = input.substr(input.len(), 0))
        auto result = Result<Parsed<SentryScope>, str>::Ok(cede parsed)
        return cede result
    }
}

pub fn main() -> i32 {
    auto path_str = string::from("./tests/pass/scope_v2.json")
    auto f# = File::open(path_str, "r")
    if !f.is_valid() {
        println("File not found")
        return 1
    }
    auto read_res = f.read_to_string()
    if read_res.is_err() {
        println("Read fail")
        return 1
    }
    auto json_str = read_res.unwrap()
    auto v_str = json_str.as_str()
    
    // Benchmarking loop (1000 parsing cycles)
    auto iter# = 0:i32
    loop iter < 1000 {
        auto p_res = deserialize_shape<SentryScope>(v_str)
        if p_res.is_err() {
            println("Parse err")
            return 1
        }
        auto parsed_scope = p_res.unwrap()
        assert(parsed_scope._notifyingListeners, "parsed _notifyingListeners must be true")
        iter += 1
    }
    
    println("Successfully validated Z-Copy Scanner Throughput!")
    return 0
}
