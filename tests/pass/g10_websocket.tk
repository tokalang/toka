import std/net::{TcpListener, SocketAddrV4, Ipv4Addr, TcpStream, net_async_accept, net_async_read}
import std/task::{block_on, sleep_async}
import std/io::println

import core/result::Result
import sys/libc::{libc_memcpy}
import stdx/net/websocket::{WsConnection, ws_accept_async, ws_connect_async}

fn server_task(cede server: TcpListener) -> async i32 {
    auto owned_server# = cede server
    auto stream# = net_async_accept(owned_server).await
    if !stream.is_valid() {
        return 1
    }
    
    // Upgrade
    auto ws_conn_res = ws_accept_async(stream).await
    if ws_conn_res.is_err() {
        return 2
    }
    
    auto ws_conn# = ws_conn_res.unwrap()
    
    // Read text message
    auto msg_res = ws_conn#.read_text_async().await
    if msg_res.is_err() {
        return 3
    }
    auto msg = msg_res.unwrap()
    
    assert(msg.eq(string::from("Hello, Toka WS!")), "Message mismatch!")
    
    // Echo back
    auto wr_res = ws_conn#.write_text_async("Echo: ").await
    if wr_res.is_err() { return 4 }
    
    auto wr2 = ws_conn#.write_text_async(msg.as_view()).await
    if wr2.is_err() { return 5 }
    sleep_async(50).await
    return 0
}

fn client_task(port: u16) -> async i32 {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), port)
    
    auto stream# = TcpStream::connect(addr)
    auto retries# = 0
    loop !stream.is_valid() {
        if retries > 100 {
            assert(false, "Client connect timeout after 10s")
        }
        sleep_async(20).await
        stream = TcpStream::connect(addr)
        retries = retries + 1
    }
    
    auto ws_conn_res# = ws_connect_async(stream, string::from("localhost"), string::from("/")).await
    if ws_conn_res.is_err() {
        return 11
    }
    auto ws_conn# = ws_conn_res.unwrap()

    auto w_res = ws_conn#.write_text_async("Hello, Toka WS!").await
    if w_res.is_err() {
        return 12
    }

    auto r_res# = ws_conn#.read_text_async().await
    if r_res.is_err() {
        return 13
    }

    auto r_res2# = ws_conn#.read_text_async().await
    if r_res2.is_err() {
        return 14
    }

    println("WS E2E Client Success!")
    return 0
}

// Global test entry
fn entry_point(cede listener_arg: TcpListener, port: u16) -> async i32 {
    auto owned_listener = cede listener_arg
    auto s_handle = server_task(cede owned_listener).start
    auto c_handle = client_task(port).start
    auto c_res = c_handle.await
    auto s_res = s_handle.await
    if c_res != 0 || s_res != 0 {
        return 1
    }
    return 0
}

pub fn main() -> i32 {
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16)
    
    auto listener# = TcpListener::bind(addr)
    if !listener.is_valid() { 
        println("Networking unsupported or port in use, skipping.")
        return 0 
    }
    
    auto port = listener.local_port()
    
    // Start entry point
    auto entry = entry_point(cede listener, port).start
    auto status = block_on<i32>(entry)
    
    if status == 0 {
        println("All WebSocket E2E tasks passed!")
    } else {
        println("Failed WS tests!")
    }
    
    return status
}
