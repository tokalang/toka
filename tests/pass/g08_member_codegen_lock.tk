shape Point(
    x: i32,
    y#: i32
)

shape Container(
    ^ptr: Point
)

shape Box<'T>(
    'data: T
)

fn main() -> i32 {
    unsafe {
        auto c = Container(^ptr=new Point(x=10, y=20))

        // 1. Test suffix # in shape definition
        auto pt = Point(x=5, y=6)
        pt.y = 7
        assert(pt.y == 7, "suffix # failed")

        // 2. Test morphic identity '
        auto box = Box<i32>(data=8)
        auto v = box.'data
        assert(v == 8, "morphic identity ' failed")
    }
    return 0
}
