shape Cell(
    value#: i32
)

fn raw_identity_rebind() -> i32 {
    auto a# = 10
    auto b# = 20
    auto *#p = *#a:*i32

    if p != 10 {
        return 1
    }

    *#p = *#b
    if p != 20 {
        return 2
    }

    return 0
}

fn unique_soul_writable_only() -> i32 {
    auto ^cell# = new Cell(value = 10)
    cell.value = 11
    if cell.value != 11 {
        return 1
    }
    return 0
}

fn unique_identity_rebind() -> i32 {
    auto ^#cell = new Cell(value = 10)
    ^#cell = new Cell(value = 20)
    if cell.value != 20 {
        return 1
    }
    return 0
}

fn shared_identity_and_soul() -> i32 {
    auto ~#cell# = new Cell(value = 10)
    cell.value = 11
    if cell.value != 11 {
        return 1
    }

    ~#cell = new Cell(value = 20)
    if cell.value != 20 {
        return 2
    }

    return 0
}

fn reference_identity_and_soul() -> i32 {
    auto left# = 1
    auto right# = 2
    auto &#slot# = &left

    slot = 3
    if left != 3 {
        return 1
    }

    &slot = &right
    slot = 4
    if right != 4 {
        return 2
    }

    return 0
}

fn main() -> i32 {
    if raw_identity_rebind() != 0 {
        return 1
    }
    if unique_soul_writable_only() != 0 {
        return 2
    }
    if unique_identity_rebind() != 0 {
        return 3
    }
    if shared_identity_and_soul() != 0 {
        return 4
    }
    if reference_identity_and_soul() != 0 {
        return 5
    }
    return 0
}
