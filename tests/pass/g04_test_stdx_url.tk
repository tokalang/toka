import stdx/net/url::{url_encode, url_decode, query_decode, parse_url}

import core/result::{Result}
import std/io::{println}

pub fn main() -> i32 {
    // 1. Encode Test
    auto raw = string::from("hello world!+&你好")
    auto encoded = url_encode(raw)
    // Expected: hello%20world%21%2B%26%E4%BD%A0%E5%A5%BD
    if encoded != string::from("hello%20world%21%2B%26%E4%BD%A0%E5%A5%BD") {
        println("encode failed: {}", encoded)
        return 1
    }
    
    // 2. Decode Test
    auto decoded_res = url_decode(encoded)
    match decoded_res {
        auto Result::Err(&e) => {
            println("decode failed: {}", e)
            return 1
        }
        auto Result::Ok(&d) => {
            if d != raw {
                println("decode mismatch: {}", d)
                return 1
            }
        }
    }
    
    // 3. Query Decode (plus as space)
    auto q_raw = string::from("hello+world%2Bfoo")
    match query_decode(q_raw) {
        auto Result::Err(&e) => {
            println("query_decode failed: {}", e)
            return 1
        }
        auto Result::Ok(&d) => {
            if d != string::from("hello world+foo") {
                println("query_decode mismatch: {}", d)
                return 1
            }
        }
    }
    
    // 4. URL Parse Test
    auto url_res = parse_url(string::from("https://example.com:8080/path/to/api?query=1#frag"))
    match url_res {
        auto Result::Err(&e) => {
            println("parse_url failed: {}", e)
            return 1
        }
        auto Result::Ok(&u) => {
            if u.scheme != string::from("https") { return 1 }
            if u.host != string::from("example.com") { return 1 }
            if u.port != 8080:u16 { return 1 }
            if u.path != string::from("/path/to/api") { return 1 }
            if u.query != string::from("query=1") { return 1 }
            if u.fragment != string::from("frag") { return 1 }
        }
    }
    
    // 5. URL Parse Edge Case (No port, no scheme, only path)
    auto url_res2 = parse_url(string::from("/only/path?q=2"))
    match url_res2 {
        auto Result::Err(&e) => { return 1 }
        auto Result::Ok(&u) => {
            if u.scheme != string::from("") { return 1 }
            if u.host != string::from("") { return 1 }
            if u.port != 0:u16 { return 1 }
            if u.path != string::from("/only/path") { return 1 }
            if u.query != string::from("q=2") { return 1 }
            if u.fragment != string::from("") { return 1 }
        }
    }

    // 6. Authority boundary and bracketed IPv6.
    auto ipv6_res = parse_url(string::from("HTTPS://[2001:DB8::1]:8443/a/b?x=1#frag"))
    match ipv6_res {
        auto Result::Err(&e) => {
            println("IPv6 parse failed: {}", e)
            return 1
        }
        auto Result::Ok(&u) => {
            if u.scheme != string::from("https") { return 1 }
            if u.host != string::from("2001:db8::1") { return 1 }
            if u.port != 8443:u16 { return 1 }
            if u.path != string::from("/a/b") { return 1 }
            if u.query != string::from("x=1") { return 1 }
            if u.fragment != string::from("frag") { return 1 }
        }
    }

    // 7. Scheme-relative authority and a non-authority relative reference.
    auto authority_res = parse_url(string::from("//Example.COM:8080/a?x=1"))
    match authority_res {
        auto Result::Err(_) => { return 1 }
        auto Result::Ok(&u) => {
            if u.scheme != string::from("") || u.host != string::from("example.com") || u.port != 8080:u16 { return 1 }
            if u.path != string::from("/a") || u.query != string::from("x=1") { return 1 }
        }
    }
    auto relative_res = parse_url(string::from("docs/index.html?lang=en#top"))
    match relative_res {
        auto Result::Err(_) => { return 1 }
        auto Result::Ok(&u) => {
            if u.host != string::from("") || u.path != string::from("docs/index.html") { return 1 }
            if u.query != string::from("lang=en") || u.fragment != string::from("top") { return 1 }
        }
    }

    // 8. Authorities must be unambiguous and ports must be representable.
    if !parse_url(string::from("http://:80/")).is_err() { return 1 }
    if !parse_url(string::from("http://example.com:")).is_err() { return 1 }
    if !parse_url(string::from("http://example.com:70000/")).is_err() { return 1 }
    if !parse_url(string::from("http://::1/")).is_err() { return 1 }
    if !parse_url(string::from("http://[::1/")).is_err() { return 1 }

    return 0
}
