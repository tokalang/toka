import stdx/serde/json::{to_json, deserialize_shape, ToJson, serialize_shape}

import std/io::{println}

pub shape User (
    id: i32 = 0,
    name: string = string::from(""),
    active: bool = false
)

impl User@ToJson {
    pub fn write_json(self, buf#: string) {
        serialize_shape(self, buf#)
    }
}

pub fn main() -> i32 {
    auto u1 = User(id = 123, name = string::from("Alice"), active = true)
    
    // Test Serialization
    auto json_str = to_json(u1)
    println("Serialized: {}", json_str.as_view())
    
    // Verify content (fields might be in any order but reflect preserves definition order usually)
    assert(json_str.contains_char(':'), "JSON should contain colon")
    
    // Test Deserialization
    auto u2_res = deserialize_shape<User>(json_str.as_view())
    assert(u2_res.is_ok(), "Deserialization failed")
    
    auto u2 = u2_res.unwrap()
    println("Deserialized: id={}, name={}, active={}", u2.id, u2.name.as_view(), u2.active)
    
    assert(u2.id == 123, "ID mismatch")
    assert(u2.name.eq(string::from("Alice")), "Name mismatch")
    assert(u2.active == true, "Active mismatch")
    
    println("JSON Serde tests passed!")
    return 0
}
import stdx/serde/json::{@JsonFactory, Parsed, parse_document}
impl User@JsonFactory {
    pub fn parse_value(input: str) -> Result<Parsed<User>, str> <- input {
        auto attempt = parse_document(input)
        if attempt.is_err() {
            auto error = Result<Parsed<User>, str>::Err("Invalid JSON")
            return cede error
        }
        auto document = attempt.unwrap()
        if document.kind(1) != 5 {
            auto error = Result<Parsed<User>, str>::Err("Expected object")
            return cede error
        }
        if document.kind(document.find(1, "id")) != 2 {
            auto error = Result<Parsed<User>, str>::Err("Invalid field id")
            return cede error
        }
        if document.kind(document.find(1, "name")) != 3 {
            auto error = Result<Parsed<User>, str>::Err("Invalid field name")
            return cede error
        }
        if document.kind(document.find(1, "active")) != 1 {
            auto error = Result<Parsed<User>, str>::Err("Invalid field active")
            return cede error
        }
        auto value = User(id = document.number(document.find(1, "id")).unwrap() as i32, name = string::from(document.text(document.find(1, "name"))), active = document.boolean(document.find(1, "active")).unwrap())
        auto parsed = Parsed<User>(value = cede value, rest = input.substr(input.len(), 0))
        auto result = Result<Parsed<User>, str>::Ok(cede parsed)
        return cede result
    }
}
