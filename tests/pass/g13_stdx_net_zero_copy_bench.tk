// Phase 6 Benchmark: User-Space Zero-Secondary-Copy & Streaming Performance Qualification

import std/io::{println}
import std/task::{sleep_async, block_on, current_time_ms}
import std/vec::{Vec}
import std/net::{TcpListener, TcpStream, SocketAddrV4, Ipv4Addr}
import stdx/net/http::{HttpClient, HttpRequest, HttpMethod, HeaderMap, HttpResponseStream}
import std/bytes::{Bytes}

fn async_http_stream_server(port: u16) -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), port))
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }

    auto buf# = Vec<u8>::with_capacity(1024)
    auto r_res = stream#.read_into_async(cede buf, 1024:usize, 5000).await
    if r_res.is_err() { return 1 }

    auto resp_str = "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nContent-Type: text/plain\r\n\r\nHello Stream"
    auto resp_bytes# = Vec<u8>::with_capacity(resp_str.len())
    auto idx#: usize = 0
    loop idx < resp_str.len() {
        resp_bytes#.push(resp_str.as_bytes().at(idx).unwrap() as u8)
        idx += 1
    }

    auto _w = stream#.write_from_async(cede resp_bytes, 5000).await
    stream#.close()
    listener#.disarm()
    return 0
}

fn async_http_stream_client(port: u16) -> async i32 {
    sleep_async(20:i64).await
    auto client = HttpClient::new(5000)
    auto req = HttpRequest(
        method = HttpMethod::GET,
        path = string::from("/stream"),
        version = string::from("HTTP/1.1"),
        headers = HeaderMap::new(),
        body = string::from("")
    )
    auto s_res# = client.execute_stream_async(req, SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), port), false, string::from("")).await
    if s_res.is_err() {
        println("[FAILED] execute_stream_async failed")
        return 1
    }

    auto stream_obj# = s_res.unwrap()
    if stream_obj.status_code != 200 {
        println("[FAILED] stream status code mismatch")
        return 1
    }

    auto out_buf# = Vec<u8>::with_capacity(1024)
    auto read_res = stream_obj#.read_chunk_into_async(cede out_buf, 1024:usize, 5000).await
    if read_res.is_err() {
        println("[FAILED] read_chunk_into_async error")
        return 1
    }

    auto res# = read_res.unwrap()
    if res.bytes_read != 12:usize {
        println("[FAILED] read_chunk_into_async length mismatch")
        return 1
    }

    stream_obj#.close()
    return 0
}

pub fn main_async() -> async i32 {
    println("--- Starting Phase 6 Owner-Carrying & Streaming I/O Performance Qualification ---")
    auto start_time = current_time_ms()

    // Qualification 1: 1000x Owned Bytes container creation, from_vec/into_vec buffer stealing & Slice view
    auto iter_count#: usize = 0
    loop iter_count < 1000:usize {
        auto v# = Vec<u8>::with_capacity(1024)
        v#.push(65:u8)
        v#.push(66:u8)

        auto b# = Bytes::from_vec(cede v)
        if b.len() != 2:usize {
            println("[FAILED] Bytes::from_vec length mismatch!")
            return 1
        }
        auto recovered_v# = b#.into_vec()
        if recovered_v.len() != 2:usize {
            println("[FAILED] Bytes::into_vec length mismatch!")
            return 1
        }
        iter_count += 1
    }
    auto step1_time = current_time_ms()
    println("[Bench 1/2 PASSED] 1000x Bytes Container Buffer Stealing & Slice View in {} ms!", step1_time - start_time)

    // Qualification 2: HTTP Incremental Parser & Streaming Body read_chunk_into_async
    auto port: u16 = 39447:u16
    auto server_task = async_http_stream_server(port).start
    auto client_task = async_http_stream_client(port).start

    auto s_res = server_task.await
    assert(s_res == 0, "HTTP Stream Server failed")

    auto c_res = client_task.await
    assert(c_res == 0, "HTTP Stream Client failed")
    auto step2_time = current_time_ms()

    println("[Bench 2/2 PASSED] Incremental Streaming I/O Qualification in {} ms!", step2_time - step1_time)
    println("[Metrics] Total Qualification Suite Runtime: {} ms", step2_time - start_time)
    println("Phase 6 Owner-Carrying & Streaming I/O Qualification Suite PASSED ALL TESTS Cleanly!")
    return 0
}

fn main() -> i32 {
    auto res = block_on<i32>(main_async())
    assert(res == 0, "Phase 6 benchmark suite failed")
    return 0
}
