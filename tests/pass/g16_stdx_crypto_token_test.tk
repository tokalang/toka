import stdx/crypto/token::{hex_token, url_safe_token}

fn is_url_safe_byte(byte: u8) -> bool {
    if byte >= 'a' as u8 && byte <= 'z' as u8 { return true }
    if byte >= 'A' as u8 && byte <= 'Z' as u8 { return true }
    if byte >= '0' as u8 && byte <= '9' as u8 { return true }
    return byte == '-' as u8 || byte == '_' as u8
}

fn main() -> i32 {
    auto hex = hex_token(16:usize)
    assert(hex.is_ok(), "hex token generation must use OS randomness successfully")
    assert(hex.unwrap().len() == 32:usize, "hex token length must be two characters per byte")

    auto token = url_safe_token(16:usize)
    assert(token.is_ok(), "Base64URL token generation must use OS randomness successfully")
    auto value = token.unwrap()
    assert(value.len() == 22:usize, "16 random bytes must encode to 22 unpadded Base64URL characters")
    auto index# = 0:usize
    loop index < value.len() {
        assert(is_url_safe_byte(value.as_str().byte_at(index) as u8),
               "Base64URL token must contain only URL-safe alphabet bytes")
        index = index + 1:usize
    }

    assert(hex_token(0:usize).unwrap().len() == 0:usize, "empty hex token must remain empty")
    assert(url_safe_token(0:usize).unwrap().len() == 0:usize, "empty Base64URL token must remain empty")
    return 0
}
