import std/vec::{Vec}

pub fn main() -> i32 {
    auto values# = Vec<i32>::new()
    values#.push(1)
    values#.push(2)

    auto total# = 0
    for auto &value in values {
        total += value
    }

    values#.push(3)
    if total != 3 || values.len() != 3 {
        return 1
    }
    return 0
}
