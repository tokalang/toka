import std/io::println

fn main() -> i32 {
    auto i# = 0
    auto sum# = 0

    // Basic loop cond
    loop i < 10 {
        sum += i
        i += 1
    }

    println("Sum of 0 to 9: {}", sum)
    assert(sum == 45, "sum should be 45")
    assert(i == 10, "i should be 10")

    // Nested loop cond
    auto x# = 0
    auto nested_sum# = 0
    loop x < 3 {
        auto y# = 0
        loop y < 3 {
            nested_sum += x * y
            y += 1
        }
        x += 1
    }

    println("Nested sum: {}", nested_sum)
    assert(nested_sum == 9, "nested_sum should be 9")

    return 0
}
