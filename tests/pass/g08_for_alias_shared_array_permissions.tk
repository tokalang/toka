shape Cell(value#: i32)

fn main() -> i32 {
    auto ~first# = new Cell(value = 1)
    auto values# = [cede ~first]

    for alias ~x# in values {
        x.value = 2
    }
    for alias ~x in values {
        assert(x.value == 2,
               "shared array alias must preserve qualified pointee P")
    }

    for alias ~#x in values {
        auto ~replacement# = new Cell(value = 3)
        ~x = cede ~replacement
    }
    for alias ~x in values {
        assert(x.value == 3,
               "shared array alias must rebind the original element slot")
    }
    return 0
}
