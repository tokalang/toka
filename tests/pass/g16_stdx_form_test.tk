import std/vec::{Vec}
import stdx/data/form::{FormField, decode_component, encode_component, format, parse}

fn main() -> i32 {
    assert(encode_component("hello world+").equals("hello+world%2B"),
           "form encoding must use + only for spaces")
    assert(decode_component("hello+world%2B").unwrap().equals("hello world+"),
           "form decoding must distinguish + from percent-encoded plus")
    assert(decode_component("%zz").is_err(), "invalid form percent encoding must fail")

    auto fields# = Vec<FormField>::new()
    fields#.push(cede FormField::new(cede string::from("q"), cede string::from("hello world+")))
    fields#.push(cede FormField::new(cede string::from("tag"), cede string::from("toka")))
    fields#.push(cede FormField::new(cede string::from("tag"), cede string::from("lang")))
    fields#.push(cede FormField::new(cede string::from("empty"), cede string::from("")))
    auto encoded = format(fields)
    assert(encoded.equals("q=hello+world%2B&tag=toka&tag=lang&empty="),
           "form formatting must preserve ordering and duplicates")

    auto parsed = parse(encoded.as_str()).unwrap()
    assert(parsed.len() == 4:usize, "form parsing must preserve all fields")
    assert(parsed.borrow(0:usize).clone().value().equals("hello world+"), "decoded first field")
    assert(parsed.borrow(1:usize).clone().name().equals("tag"), "first duplicate key")
    assert(parsed.borrow(2:usize).clone().value().equals("lang"), "second duplicate value")
    assert(parsed.borrow(3:usize).clone().value().equals(""), "empty value retained")

    auto bare = parse("flag&x=1").unwrap()
    assert(bare.len() == 2:usize && bare.borrow(0:usize).clone().value().equals(""),
           "bare key must parse as an empty value")
    return 0
}
