fn preserve_frame_borrow() -> async i32 {
    auto value = 7
    auto &view = &value

    immediate(0).await
    return view
}

fn preserve_branch_init(flag: bool) -> async i32 {
    auto value#: i32 = unset

    if flag {
        value = 11
        immediate(0).await
