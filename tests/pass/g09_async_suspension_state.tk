    return value
}

fn preserve_break_init() -> async i32 {
    auto value#: i32 = unset

    loop {
        value = 17
        immediate(0).await
        break
    }

    return value
}

fn preserve_continue_state() -> async i32 {
    auto count# = 0

    loop count < 2 {
        count = count + 1
        immediate(0).await
