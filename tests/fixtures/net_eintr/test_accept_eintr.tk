import std/io::{println}
import std/vec::{Vec}
import std/net::{TcpListener, TcpStream, Ipv4Addr, SocketAddrV4}
import std/task::{block_on, sleep_async}
import std/context::{background, with_cancel, Canceler}
import core/result::{Result}

extern fn toka_test_set_accept_fault(count: i32, err: i32, target_fd: i32) -> void
extern fn toka_test_reset_stats() -> void
extern fn toka_test_get_eintr_attempts() -> i32
extern fn toka_test_get_remaining_faults() -> i32
extern fn toka_test_arm_cancel_after(attempts: i32) -> void
extern fn toka_test_is_cancel_triggered() -> i32

fn client_task_1(port: u16) -> async i32 {
    sleep_async(20:i64).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), port)
    auto client# = TcpStream::connect(addr)
    if !client.is_valid() {
        println("[C1 Client] Failed to connect")
        return -1
    }
    auto write_res = client#.write_string(string::from("PING"))
    if write_res.is_err() {
        println("[C1 Client] Failed to write")
        return -2
    }
    return 0
}

fn server_task_1(cede listener: TcpListener) -> async i32 {
    auto owned_listener# = cede listener
    auto port = owned_listener.local_port()
    auto fd = owned_listener.get_fd()
    unsafe {
        toka_test_set_accept_fault(2:i32, 4:i32, fd)
    }
    auto stream# = owned_listener#.accept_async().await
    if !stream.is_valid() {
        println("[C1 Server] accept failed, invalid stream")
        return -10
    }
    unsafe {
        auto eintr_count = toka_test_get_eintr_attempts()
        if eintr_count < 2 {
            println("[C1 Server] expected at least 2 EINTR attempts, got {}", eintr_count)
            return -11
        }
    }
    auto in_buf# = Vec<u8>::with_capacity(16:usize)
    auto read_res = stream#.read_into_async(cede in_buf, 16:usize, 5000:i32).await
    if read_res.is_err() {
        println("[C1 Server] read failed")
        return -12
    }
    auto read_obj = read_res.unwrap()
    if read_obj.bytes_read < 4:usize {
        println("[C1 Server] unexpected bytes_read")
        return -13
    }
    return 0
}

fn run_control_1() -> async i32 {
    println("[Control 1] Testing EINTR retry leading to success...")
    unsafe { toka_test_reset_stats() }
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16))
    if !listener.is_valid() {
        println("[Control 1] bind failed")
        return 1
    }
    auto port = listener.local_port()
    auto c_task = client_task_1(port).start
    auto s_task = server_task_1(cede listener).start
    auto c_res = c_task.await
    auto s_res = s_task.await
    assert(s_res == 0, "Control 1: server failed")
    assert(c_res == 0, "Control 1: client failed")
    println("[Control 1] PASS: EINTR retry succeeded and transmitted data")
    return 0
}

fn client_task_2(port: u16) -> async i32 {
    sleep_async(40:i64).await
    auto addr = SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), port)
    auto client# = TcpStream::connect(addr)
    if !client.is_valid() {
        println("[C2 Client] Failed to connect")
        return -1
    }
    return 0
}

fn server_task_2(cede listener: TcpListener) -> async i32 {
    auto owned_listener# = cede listener
    auto fd = owned_listener.get_fd()
    unsafe {
        toka_test_set_accept_fault(1:i32, 4:i32, fd)
    }
    auto stream# = owned_listener#.accept_async().await
    if !stream.is_valid() {
        println("[C2 Server] accept failed, invalid stream")
        return -20
    }
    unsafe {
        auto eintr_count = toka_test_get_eintr_attempts()
        if eintr_count < 1 {
            println("[C2 Server] expected at least 1 EINTR attempt, got {}", eintr_count)
            return -21
        }
    }
    return 0
}

fn run_control_2() -> async i32 {
    println("[Control 2] Testing EINTR retry followed by EAGAIN reactor suspension...")
    unsafe { toka_test_reset_stats() }
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16))
    if !listener.is_valid() {
        println("[Control 2] bind failed")
        return 2
    }
    auto port = listener.local_port()
    auto c_task = client_task_2(port).start
    auto s_task = server_task_2(cede listener).start
    auto c_res = c_task.await
    auto s_res = s_task.await
    assert(s_res == 0, "Control 2: server failed")
    assert(c_res == 0, "Control 2: client failed")
    println("[Control 2] PASS: EAGAIN reactor suspension and wakeup verified after EINTR")
    return 0
}

fn run_control_3() -> async i32 {
    println("[Control 3] Testing real permanent error handling...")
    unsafe { toka_test_reset_stats() }
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16))
    if !listener.is_valid() {
        println("[Control 3] bind failed")
        return 3
    }
    auto fd = listener.get_fd()

    // Test 3A: Permanent OS error EBADF (9) on net_async_accept_fd
    unsafe {
        toka_test_set_accept_fault(1:i32, 9:i32, fd)
    }
    auto stream# = listener#.accept_async().await
    assert(!stream.is_valid(), "Control 3A: permanent error must return invalid stream")

    // Test 3B: Permanent OS error EINVAL (22) on accept_async_context
    unsafe {
        toka_test_set_accept_fault(1:i32, 22:i32, fd)
    }
    auto cancel_ctx = with_cancel(cede background())
    auto res = listener#.accept_async_context(cancel_ctx.canceler).await
    match res {
        auto Result::Ok(&_s) => {
            assert(false, "Control 3B: permanent error must not return Ok")
        }
        auto Result::Err(&err) => {
            assert(err.equals("Accept error"), "Control 3B: error message must be Accept error")
        }
    }

    println("[Control 3] PASS: Permanent error dispatch observed and returned expected errors")
    return 0
}

fn run_control_4() -> async i32 {
    println("[Control 4] Testing bounded cancellation during repeated interrupts...")
    unsafe { toka_test_reset_stats() }
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127, 0, 0, 1), 0:u16))
    if !listener.is_valid() {
        println("[Control 4] bind failed")
        return 4
    }
    auto fd = listener.get_fd()

    // 4A: Pre-canceled context must exit immediately without executing syscall
    auto pre_cancel = with_cancel(cede background())
    pre_cancel.canceler.call()
    unsafe {
        toka_test_set_accept_fault(50:i32, 4:i32, fd)
    }
    auto pre_res = listener#.accept_async_context(pre_cancel.canceler).await
    match pre_res {
        auto Result::Ok(&_s) => {
            assert(false, "Control 4A: pre-canceled must not return Ok")
        }
        auto Result::Err(&err) => {
            assert(err.equals("context canceled"), "Control 4A: message must be context canceled")
        }
    }
    unsafe {
        assert(toka_test_get_remaining_faults() == 50:i32, "Control 4A: no syscalls should have been made")
    }

    // 4B: Cancellation during repeated EINTR interrupts
    unsafe {
        toka_test_reset_stats()
        toka_test_set_accept_fault(100:i32, 4:i32, fd)
        toka_test_arm_cancel_after(2:i32)
    }
    auto active_cancel = with_cancel(cede background())
    auto accept_res = listener#.accept_async_context(active_cancel.canceler.clone()).await
    match accept_res {
        auto Result::Ok(&_s) => {
            assert(false, "Control 4B: canceled accept must not return Ok")
        }
        auto Result::Err(&err) => {
            assert(err.equals("context canceled"), "Control 4B: error message must be context canceled")
        }
    }
    unsafe {
        auto eintr_seen = toka_test_get_eintr_attempts()
        assert(eintr_seen == 2:i32, "Control 4B: exactly 2 interrupts should have occurred before bounded termination")
        auto rem = toka_test_get_remaining_faults()
        assert(rem == 98:i32, "Control 4B: remaining 98 interrupts must not have executed")
    }
    assert(active_cancel.canceler.active_token_count() == 0:usize, "Control 4B: wait tokens cleanly unregistered")
    println("[Control 4] PASS: Bounded cancellation and resource cleanup during repeated interrupts verified")
    return 0
}

fn run_all() -> async i32 {
    auto r1 = run_control_1().await
    assert(r1 == 0, "Control 1 failed")
    auto r2 = run_control_2().await
    assert(r2 == 0, "Control 2 failed")
    auto r3 = run_control_3().await
    assert(r3 == 0, "Control 3 failed")
    auto r4 = run_control_4().await
    assert(r4 == 0, "Control 4 failed")
    println("All 4 EINTR/Accept controls passed successfully!")
    return 0
}

fn main() -> i32 {
    return block_on<i32>(run_all())
}
