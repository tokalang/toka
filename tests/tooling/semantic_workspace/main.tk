import tests/tooling/semantic_workspace/lib::{Box, add}

fn compute(value: i32) -> i32 {
    auto result = add(value, 1)
    if result > 0 {
        auto value = result
        return add(value, 2)
    }
    return result
}

fn main() -> i32 {
    auto item = Box(value = compute(3))
    return item.value
}
