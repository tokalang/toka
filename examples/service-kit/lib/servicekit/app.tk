// Bounded reference application: HTTP request dispatch plus SQLite persistence.
// This is intentionally application-specific; it is not a router or web framework.

import core/option::{Option}
import core/result::{Result}
import official/sqlite::{Database, SqliteError, Step}
import std/net::{SocketAddrV4}
import stdx/log/log::{LogLevel}
import stdx/net/http::{HeaderMap, HttpMethod, HttpRequest, HttpResponse, HttpServer}
import std/net::{TcpListener}
import stdx/serde/json::{ToJson, deserialize_shape, serialize_shape, to_json}

pub shape ServiceConfig (
    bind_addr: SocketAddrV4,
    database_path: string,
    log_level: LogLevel
)

pub shape NoteInput (
    body: string = string::from("")
)

pub shape Note (
    id: i64,
    body: string
)

impl Note@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        return serialize_shape(self, buf)
    }
}

pub shape NotesService (
    database#: Database,
    log_level: LogLevel
)

fn json_response(status_code: i32, cede body: string) -> HttpResponse {
    auto headers# = HeaderMap::new()
    auto inserted = headers#.insert(string::from("Content-Type"), string::from("application/json"))
    if inserted.is_err() {
        return HttpResponse::bad_request(string::from("invalid response headers"))
    }
    return HttpResponse(
        status_code = status_code,
        content_type = string::from("application/json"),
        headers = cede headers,
        body = cede body
    )
}

fn error_response(status_code: i32, message: str) -> HttpResponse {
    auto body# = string::from("{\"error\":")
    auto encoded = to_json(string::from(message))
    body#.push_str(encoded.as_str())
    body#.push_str("}")
    return json_response(status_code, cede body)
}

fn sqlite_message(error: SqliteError) -> string {
    return error.message()
}

fn parse_note_id(path: str) -> Option<i64> {
    if !path.starts_with("/notes/") || path.len() == 7:usize {
        return Option<i64>::None
    }

    auto id# = 0:i64
    auto index# = 7:usize
    loop index < path.len() {
        auto byte = path.byte_at(index)
        if byte < 48 || byte > 57 {
            return Option<i64>::None
        }
        auto digit = (byte - 48) as i64
        if id > 922337203685477580:i64 || (id == 922337203685477580:i64 && digit > 7:i64) {
            return Option<i64>::None
        }
        id = id * 10:i64 + digit
        index = index + 1:usize
    }
    return Option<i64>::Some(id)
}

impl NotesService {
    pub fn open(config: ServiceConfig) -> Result<NotesService, string> {
        auto opened = Database::open(config.database_path.as_str())
        if opened.is_err() {
            return Result<NotesService, string>::Err(sqlite_message(opened.unwrap_err()))
        }
        auto database# = opened.unwrap()
        auto schema = database#.execute("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);")
        if schema.is_err() {
            return Result<NotesService, string>::Err(sqlite_message(schema.unwrap_err()))
        }
        return Result<NotesService, string>::Ok(NotesService(
            database = cede database,
            log_level = config.log_level
        ))
    }

    pub fn log_level(self) -> LogLevel {
        return self.log_level
    }

    pub fn close(self#) -> Result<i32, string> {
        auto closed = self.database#.close()
        if closed.is_err() {
            return Result<i32, string>::Err(sqlite_message(closed.unwrap_err()))
        }
        return Result<i32, string>::Ok(closed.unwrap())
    }

    fn create_note(self#, body: str) -> Result<Note, string> {
        auto prepared = self.database#.prepare("INSERT INTO notes (body) VALUES (?);")
        if prepared.is_err() {
            return Result<Note, string>::Err(sqlite_message(prepared.unwrap_err()))
        }
        auto statement# = prepared.unwrap()
        auto bound = statement#.bind_text(1:i32, body)
        if bound.is_err() {
            return Result<Note, string>::Err(sqlite_message(bound.unwrap_err()))
        }
        auto stepped = statement#.step()
        if stepped.is_err() {
            return Result<Note, string>::Err(sqlite_message(stepped.unwrap_err()))
        }
        if stepped.unwrap() != Step::Done {
            return Result<Note, string>::Err(string::from("SQLite insert did not complete"))
        }
        auto finalized = statement#.finalize()
        if finalized.is_err() {
            return Result<Note, string>::Err(sqlite_message(finalized.unwrap_err()))
        }

        auto id_prepared = self.database#.prepare("SELECT last_insert_rowid();")
        if id_prepared.is_err() {
            return Result<Note, string>::Err(sqlite_message(id_prepared.unwrap_err()))
        }
        auto id_statement# = id_prepared.unwrap()
        auto id_stepped = id_statement#.step()
        if id_stepped.is_err() {
            return Result<Note, string>::Err(sqlite_message(id_stepped.unwrap_err()))
        }
        if id_stepped.unwrap() != Step::Row {
            return Result<Note, string>::Err(string::from("SQLite did not return inserted note id"))
        }
        auto id_read = id_statement.column_i64(0:i32)
        if id_read.is_err() {
            return Result<Note, string>::Err(sqlite_message(id_read.unwrap_err()))
        }
        auto finalized_id = id_statement#.finalize()
        if finalized_id.is_err() {
            return Result<Note, string>::Err(sqlite_message(finalized_id.unwrap_err()))
        }
        return Result<Note, string>::Ok(Note(id = id_read.unwrap(), body = string::from(body)))
    }

    fn find_note(self#, id: i64) -> Result<Option<Note>, string> {
        auto prepared = self.database#.prepare("SELECT id, body FROM notes WHERE id = ?;")
        if prepared.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(prepared.unwrap_err()))
        }
        auto statement# = prepared.unwrap()
        auto bound = statement#.bind_i64(1:i32, id)
        if bound.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(bound.unwrap_err()))
        }
        auto stepped = statement#.step()
        if stepped.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(stepped.unwrap_err()))
        }
        if stepped.unwrap() == Step::Done {
            auto finalized = statement#.finalize()
            if finalized.is_err() {
                return Result<Option<Note>, string>::Err(sqlite_message(finalized.unwrap_err()))
            }
            return Result<Option<Note>, string>::Ok(Option<Note>::None)
        }
        auto id_read = statement.column_i64(0:i32)
        if id_read.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(id_read.unwrap_err()))
        }
        auto body_read = statement.column_text(1:i32)
        if body_read.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(body_read.unwrap_err()))
        }
        auto body = body_read.unwrap()
        if body.is_none() {
            return Result<Option<Note>, string>::Err(string::from("SQLite note body was NULL"))
        }
        auto finalized = statement#.finalize()
        if finalized.is_err() {
            return Result<Option<Note>, string>::Err(sqlite_message(finalized.unwrap_err()))
        }
        return Result<Option<Note>, string>::Ok(Option<Note>::Some(Note(id = id_read.unwrap(), body = body.unwrap())))
    }

    pub fn handle(self#, request: HttpRequest) -> HttpResponse {
        if request.method == HttpMethod::GET && request.path.as_str().equals("/health") {
            return json_response(200:i32, cede string::from("{\"status\":\"ok\"}"))
        }

        if request.method == HttpMethod::POST && request.path.as_str().equals("/notes") {
            auto parsed = deserialize_shape<NoteInput>(request.body.as_str())
            if parsed.is_err() {
                return error_response(400:i32, "invalid note JSON")
            }
            auto input = parsed.unwrap()
            if input.body.len() == 0:usize {
                return error_response(400:i32, "note body must not be empty")
            }
            auto created = self#.create_note(input.body.as_str())
            if created.is_err() {
                return error_response(500:i32, created.unwrap_err().as_str())
            }
            return json_response(201:i32, cede to_json(created.unwrap()))
        }

        if request.method == HttpMethod::GET {
            auto id = parse_note_id(request.path.as_str())
            if id.is_some() {
                auto found = self#.find_note(id.unwrap())
                if found.is_err() {
                    return error_response(500:i32, found.unwrap_err().as_str())
                }
                auto note = found.unwrap()
                if note.is_some() {
                    return json_response(200:i32, cede to_json(note.unwrap()))
                }
                return error_response(404:i32, "note not found")
            }
        }

        return error_response(404:i32, "route not found")
    }
}

pub fn serve_one_async(cede config: ServiceConfig, cede listener: TcpListener, max_request_bytes: usize, timeout_ms: i32) -> async Result<i32, string> {
    auto config# = cede config
    auto listener# = cede listener
    auto opened = NotesService::open(config)
    if opened.is_err() {
        return Result<i32, string>::Err(opened.unwrap_err())
    }
    auto service# = opened.unwrap()
    auto accepted = HttpServer::accept_async(listener, max_request_bytes, timeout_ms).await
    if accepted.is_err() {
        return Result<i32, string>::Err(accepted.unwrap_err())
    }
    auto connection# = accepted.unwrap()
    auto request = connection#.read_request_async().await
    if request.is_err() {
        auto write = connection#.write_response_async(error_response(400:i32, "invalid HTTP request")).await
        connection#.close()
        if write.is_err() {
            return Result<i32, string>::Err(write.unwrap_err())
        }
        return Result<i32, string>::Ok(0:i32)
    }
    auto response = service#.handle(request.unwrap())
    auto write = connection#.write_response_async(response).await
    connection#.close()
    if write.is_err() {
        return Result<i32, string>::Err(write.unwrap_err())
    }
    return Result<i32, string>::Ok(0:i32)
}
