import servicekit/app::{ServiceConfig, serve_one_async}
import std/io::{remove_file}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener}
import std/task::{block_on, sleep_async}
import stdx/log/log::{LOG_ERROR}
import stdx/net/http::{HeaderMap, HttpClient, HttpMethod, HttpRequest, HttpResponse}

extern fn toka_sqlite_live_handle_count() -> i32
extern fn toka_sqlite_live_statement_count() -> i32

fn config(path: str) -> ServiceConfig {
    return ServiceConfig(
        bind_addr = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16),
        database_path = string::from(path),
        log_level = LOG_ERROR
    )
}

fn request(method: HttpMethod, path: str, body: str) -> HttpRequest {
    auto headers# = HeaderMap::new()
    assert(headers#.insert(string::from("Host"), string::from("127.0.0.1")).is_ok(), "request host")
    if body.len() > 0:usize {
        assert(headers#.insert(string::from("Content-Type"), string::from("application/json")).is_ok(), "request content type")
    }
    return HttpRequest(
        method = method,
        path = string::from(path),
        version = string::from("HTTP/1.1"),
        headers = headers,
        body = string::from(body)
    )
}

fn execute_once(cede supplied_config: ServiceConfig, request: HttpRequest) -> async HttpResponse {
    auto supplied = supplied_config.bind_addr
    auto listener# = TcpListener::bind(supplied)
    assert(listener.is_valid(), "service listener must bind")
    auto port = listener.local_port()
    assert(port != 0:u16, "bound listener must expose a port")
    auto server = serve_one_async(cede supplied_config, cede listener, 16384:usize, 2000:i32).start
    sleep_async(10:i32).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto response = HttpClient::new(2000:i32).execute_async(request, address).await
    auto server_result = server.await
    assert(server_result.is_ok(), "server task must complete")
    assert(server_result.unwrap() == 0:i32, "server must handle exactly one request")
    assert(response.is_ok(), "loopback client must receive a response")
    assert(toka_sqlite_live_handle_count() == 0:i32, "one request must not retain a database handle")
    assert(toka_sqlite_live_statement_count() == 0:i32, "one request must not retain a statement")
    return response.unwrap()
}

fn run(path: str) -> async i32 {
    auto health = execute_once(cede config(path), request(HttpMethod::GET, "/health", "")).await
    assert(health.status_code == 200:i32, "loopback health status")
    assert(health.body.as_str().equals("{\"status\":\"ok\"}"), "loopback health body")

    auto malformed = execute_once(cede config(path), request(HttpMethod::POST, "/notes", "{not-json}")).await
    assert(malformed.status_code == 400:i32, "loopback malformed JSON")

    auto created = execute_once(cede config(path), request(HttpMethod::POST, "/notes", "{\"body\":\"loopback note\"}")).await
    assert(created.status_code == 201:i32, "loopback create status")
    assert(created.body.contains("\"id\":1"), "loopback created id")

    auto found = execute_once(cede config(path), request(HttpMethod::GET, "/notes/1", "")).await
    assert(found.status_code == 200:i32, "loopback read status")
    assert(found.body.contains("\"body\":\"loopback note\""), "loopback read body")

    auto missing = execute_once(cede config(path), request(HttpMethod::GET, "/notes/99", "")).await
    assert(missing.status_code == 404:i32, "loopback typed not found")

    auto after_restart = execute_once(cede config(path), request(HttpMethod::GET, "/notes/1", "")).await
    assert(after_restart.status_code == 200:i32, "loopback restart persistence")
    assert(after_restart.body.contains("\"body\":\"loopback note\""), "loopback restart body")
    return 0
}

fn main() -> i32 {
    auto path = "/tmp/toka-service-kit-loopback.db"
    remove_file(string::from(path))
    auto result = block_on<i32>(run(path))
    remove_file(string::from(path))
    return result
}
