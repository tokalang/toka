// Usage: csv_transform <input.csv> <output.csv>
//
// The example parses and writes owned CSV records through the stdx buffered
// adapters. It intentionally keeps record transformation out of the example:
// the important contract is the resource-safe streaming loop.

import std/env::{args_count, get_arg}
import std/io::{File, println}
import stdx/data/csv::{read_record, write_record}
import stdx/io/bufio::{BufferedReader, BufferedWriter}

fn main() -> i32 {
    if args_count() != 3:i32 {
        println("Usage: csv_transform <input.csv> <output.csv>")
        return 2
    }

    auto input_path = get_arg(1:i32)
    auto output_path = get_arg(2:i32)
    auto input# = File::open(input_path, "r")
    auto output# = File::open(output_path, "w")
    if !input.is_valid() || !output.is_valid() {
        println("Unable to open CSV input or output")
        return 1
    }

    auto reader# = BufferedReader<File>::new(cede input#.take())
    auto writer# = BufferedWriter<File>::new(cede output#.take())
    loop true {
        auto next = read_record<File>(reader, 1048576:usize)
        if next.is_err() {
            println("CSV read failed")
            return 1
        }
        auto record_opt = next.unwrap()
        if record_opt.is_none() {
            break
        }
        auto record = record_opt.unwrap()
        auto written = write_record<File>(writer, cede record)
        if written.is_err() {
            println("CSV write failed")
            return 1
        }
    }
    if writer#.flush().is_err() {
        println("CSV flush failed")
        return 1
    }
    return 0
}
