import std/io::{println, remove_file}
import qslite/storage::{open_database}

fn main() -> i32 {
    auto path = string::from("/tmp/qslite-vertical.db")
    remove_file(path.clone())
    {
        auto opened = open_database(path.clone())
        assert(opened.is_ok(), "create failed")
        auto database# = opened.unwrap()
        assert(database#.upsert(20, string::from("twenty")).is_ok(), "insert 20 failed")
        assert(database#.upsert(10, string::from("ten")).is_ok(), "insert 10 failed")
        assert(database#.upsert(20, string::from("TWENTY")).is_ok(), "replace failed")
        assert(database.len() == 2, "unexpected row count")
        assert(database.get(20).unwrap() == "TWENTY", "replace not visible")
        assert(database.scan_text() == "10\tten\n20\tTWENTY\n", "scan is not ordered")
    }
    {
        auto reopened = open_database(path.clone())
        assert(reopened.is_ok(), "reopen failed")
        auto database# = reopened.unwrap()
        assert(database.get(10).unwrap() == "ten", "row 10 did not persist")
        assert(database.get(20).unwrap() == "TWENTY", "row 20 did not persist")
        assert(database#.remove(10).unwrap(), "delete failed")
    }
    {
        auto reopened = open_database(path.clone())
        assert(reopened.is_ok(), "second reopen failed")
        auto database = reopened.unwrap()
        assert(database.len() == 1, "delete did not persist")
        assert(database.get(10).is_none(), "deleted row returned")
        assert(database.get(20).unwrap() == "TWENTY", "remaining row changed")
    }
    remove_file(path)
    println("PASS: qslite persistent vertical slice")
    return 0
}
