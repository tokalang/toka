import core/option::{Option}
import official/openai_compat::{OpenAiCompatLimits, decode_sse_event}
import std/io::{println}
import stdx/net/sse::{SseEvent}

fn main() -> i32 {
    auto input = SseEvent::new(
        cede string::from("message"),
        cede string::from("[DONE]"),
        cede Option<string>::None
    )
    auto events = decode_sse_event(
        cede input,
        OpenAiCompatLimits::new(128:usize, 1:usize).unwrap()
    )
    if events.is_err() {
        return 1
    }
    if events.unwrap().len() != 1:usize {
        return 1
    }
    println("public openai_compat registry consumer passed")
    return 0
}
