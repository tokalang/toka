// Separate generic-result typing case, not yet classified or accepted.
fn make<T>(value: T) -> dyn fn() -> T {
    return { [copy value] => value }:dyn fn() -> T
}
fn main() -> i32 {
    auto first = make(7:i32)
    auto second = make(8:i32)
    if first() != 7 || second() != 8 { return 1 }
    return 0
}
