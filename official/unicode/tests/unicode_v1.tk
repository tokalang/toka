import core/option::{Option}
import core/string::{string}
import core/types::{byte, Char32, usize}
import official/unicode::{
    UnicodeError,
    grapheme_byte_offset,
    grapheme_count,
    grapheme_index_at_byte_offset,
    grapheme_slice
}

fn expect_some_offset(result: Result<Option<usize>, UnicodeError>, expected: usize) -> bool {
    if result.is_err() { return false }
    auto maybe = result.unwrap()
    match cede maybe {
        auto Option<usize>::Some('value) => return 'value == expected
        Option<usize>::None => return false
    }
}

fn expect_some_slice(result: Result<Option<str>, UnicodeError>, expected: str) -> bool {
    if result.is_err() { return false }
    auto maybe = result.unwrap()
    match cede maybe {
        auto Option<str>::Some('value) => return 'value.equals(expected)
        Option<str>::None => return false
    }
}

fn expect_no_slice(result: Result<Option<str>, UnicodeError>) -> bool {
    if result.is_err() { return false }
    return result.unwrap().is_none()
}

fn test_offsets_and_slices() {
    auto text# = string::from("A")
    text#.push_codepoint(0x308:Char32)
    text#.push_codepoint('B' as Char32)

    auto count = grapheme_count(text.as_str())
    assert(count.is_ok(), "combining sequence count must not reject valid UTF-8")
    assert(count.unwrap() == 2:usize,
           "combining sequence must be one extended grapheme")
    assert(expect_some_offset(grapheme_byte_offset(text.as_str(), 0:usize), 0:usize),
           "first grapheme begins at byte zero")
    assert(expect_some_offset(grapheme_byte_offset(text.as_str(), 1:usize), 3:usize),
           "second grapheme begins after A plus combining mark")
    assert(expect_some_offset(grapheme_byte_offset(text.as_str(), 2:usize), 4:usize),
           "terminal grapheme boundary is text length")
    assert(grapheme_byte_offset(text.as_str(), 3:usize).unwrap().is_none(),
           "out-of-range grapheme index has no byte offset")

    assert(expect_some_offset(grapheme_index_at_byte_offset(text.as_str(), 0:usize), 0:usize),
           "initial byte is a grapheme boundary")
    assert(expect_some_offset(grapheme_index_at_byte_offset(text.as_str(), 3:usize), 1:usize),
           "B begins at grapheme index one")
    assert(expect_some_offset(grapheme_index_at_byte_offset(text.as_str(), 4:usize), 2:usize),
           "terminal byte is a grapheme boundary")
    assert(grapheme_index_at_byte_offset(text.as_str(), 1:usize).unwrap().is_none(),
           "combining-mark byte is not a grapheme boundary")

    assert(expect_some_slice(grapheme_slice(text.as_str(), 0:usize, 1:usize), "Ä"),
           "slice must retain the complete combining cluster")
    assert(expect_some_slice(grapheme_slice(text.as_str(), 1:usize, 2:usize), "B"),
           "slice must return a later complete cluster")
    assert(expect_some_slice(grapheme_slice(text.as_str(), 1:usize, 1:usize), ""),
           "equal valid grapheme boundaries produce an empty view")
    assert(expect_no_slice(grapheme_slice(text.as_str(), 0:usize, 3:usize)),
           "out-of-range slice must be a valid None result")
    assert(expect_no_slice(grapheme_slice(text.as_str(), 2:usize, 1:usize)),
           "reversed slice boundaries must be a valid None result")
}

fn test_malformed_input_wins_over_request_miss() {
    auto malformed# = string::from("A")
    malformed#.push_byte_raw(0x80:u8)
    auto result = grapheme_slice(malformed.as_str(), 8:usize, 1:usize)
    assert(result.is_err(), "malformed UTF-8 must not be hidden by invalid slice bounds")
    auto error = result.unwrap_err()
    assert(error.invalid_byte == 0x80:byte && error.position == 1:usize,
           "UnicodeError must preserve the malformed byte and offset")
}

fn main() -> i32 {
    test_offsets_and_slices()
    test_malformed_input_wins_over_request_miss()
    return 0
}
