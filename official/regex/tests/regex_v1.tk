import official/regex::{Regex, package_name}

fn test_literals_dot_and_anchors() {
    auto literal = Regex::compile("ab.c")
    assert(literal.is_ok(), "literal and dot pattern must compile")
    auto regex = literal.unwrap()
    assert(regex.is_match("xxabzcxx"), "unanchored search must find a byte match")
    assert(!regex.is_match("abcc"), "literal bytes must retain their order")
    assert(!regex.is_match("ab\nc"), "RE2 dot must exclude LF without a dotall flag")

    auto located = regex.find("xxabzcxx")
    assert(located.is_some(), "find must return the first match")
    auto found = located.unwrap()
    assert(found.start_offset() == 2:usize && found.end_offset() == 6:usize,
           "find must report byte offsets")

    auto anchored = Regex::compile("^ab$").unwrap()
    assert(anchored.is_match("ab"), "both anchors must accept the complete input")
    assert(!anchored.is_match("zab"), "start anchor must reject a prefix")
    assert(!anchored.is_match("abz"), "end anchor must reject a suffix")
}

fn test_escapes_and_errors() {
    auto escaped = Regex::compile("a\\.b\\n")
    assert(escaped.is_ok(), "escaped metacharacters and newline must compile")
    assert(escaped.unwrap().is_match("a.b\n"), "escaped bytes must be literal")

    auto hex = Regex::compile("^\\x41[\\x42-\\x43]$").unwrap()
    assert(hex.is_match("AC"), "hexadecimal byte escapes must work inside and outside classes")
    assert(!hex.is_match("AD"), "hexadecimal class range must retain its bound")

    auto dangling = Regex::compile("abc\\")
    assert(dangling.is_err(), "dangling escape must be rejected")
    assert(dangling.unwrap_err().position() == 3:usize,
           "error must identify the dangling escape byte")
    assert(Regex::compile("[z-a]").is_err(), "descending character range must be rejected")
    assert(Regex::compile("[abc").is_err(), "unterminated character class must be rejected")
    assert(Regex::compile("[]").is_err(), "empty character class must be rejected")
    assert(Regex::compile("\\x4").is_err(), "incomplete hexadecimal escape must be rejected")
    assert(Regex::compile("\\x4g").is_err(), "invalid hexadecimal escape must be rejected")
}

fn test_grouping_alternation_and_quantifiers() {
    auto repeated = Regex::compile("a(b|c)+d?")
    assert(repeated.is_ok(), "grouping, alternation, and quantifiers must compile")
    auto regex = repeated.unwrap()
    assert(regex.is_match("xxabcbdy"), "plus and optional paths must match")
    assert(regex.is_match("ac"), "optional suffix must permit omission")
    assert(!regex.is_match("ad"), "plus must require one grouped branch")

    auto star = Regex::compile("^ab*c$").unwrap()
    assert(star.is_match("ac"), "star must permit zero repetitions")
    assert(star.is_match("abbbc"), "star must permit repeated bytes")
    assert(!star.is_match("zabbbc"), "anchored NFA must reject a prefix")

    auto ordered = Regex::compile("ab|a").unwrap()
    auto ordered_match = ordered.find("ab")
    assert(ordered_match.is_some(), "ordered alternation must find a match")
    assert(ordered_match.unwrap().end_offset() == 2:usize,
           "RE2 leftmost-first semantics must retain the earlier alternative")

    assert(Regex::compile("(ab").is_err(), "unclosed group must be rejected")
    assert(Regex::compile("a**").is_err(), "stacked quantifiers must be rejected")
}

fn test_counted_repetitions() {
    auto exact = Regex::compile("^a{3}$").unwrap()
    assert(exact.is_match("aaa"), "exact repetition must match its count")
    assert(!exact.is_match("aa"), "exact repetition must reject a short input")

    auto zero = Regex::compile("^a{0}$").unwrap()
    assert(zero.is_match(""), "zero repetition must match an empty input")
    assert(!zero.is_match("a"), "zero repetition must reject one occurrence")

    auto bounded = Regex::compile("^(ab){2,3}c$").unwrap()
    assert(bounded.is_match("ababc"), "bounded grouped repetition must match its lower bound")
    assert(bounded.is_match("abababc"), "bounded grouped repetition must match its upper bound")
    assert(!bounded.is_match("abc"), "bounded grouped repetition must reject below its lower bound")
    assert(!bounded.is_match("ababababc"), "bounded grouped repetition must reject above its upper bound")

    auto open = Regex::compile("^a{0,}b$").unwrap()
    assert(open.is_match("b"), "open repetition must allow zero occurrences")
    assert(open.is_match("aaaab"), "open repetition must allow additional occurrences")

    assert(Regex::compile("a{,2}").is_err(), "repetition must have a lower bound")
    assert(Regex::compile("a{3,2}").is_err(), "repetition upper bound must not be smaller")
    assert(Regex::compile("a{2").is_err(), "repetition must close with a brace")
    assert(Regex::compile("a{1001}").is_err(), "repetition count must respect the v1 resource limit")
}

fn test_non_backtracking_adversarial_shape() {
    auto input# = string::from("")
    auto index#: usize = 0:usize
    loop index < 1024:usize {
        input#.push_byte_raw('a' as u8)
        index = index + 1:usize
    }
    input#.push_byte_raw('c' as u8)

    auto regex = Regex::compile("(a|aa)*b").unwrap()
    assert(!regex.is_match(input.as_str()),
           "Pike NFA must reject the classic backtracking stress shape")
}

fn test_ascii_character_classes() {
    auto range = Regex::compile("^[a-c]+$").unwrap()
    assert(range.is_match("abccba"), "ASCII range class must match each range byte")
    assert(!range.is_match("abcd"), "range class must reject bytes outside the range")

    auto negated = Regex::compile("^[^0-9]+$").unwrap()
    assert(negated.is_match("toka-RE2"), "negated class must match non-digit bytes")
    assert(!negated.is_match("toka1"), "negated class must reject member bytes")

    auto punctuation = Regex::compile("^[-a\\]]+$").unwrap()
    assert(punctuation.is_match("-a]-"), "class must support leading dash and escaped close bracket")

    auto digits = Regex::compile("^\\d+$").unwrap()
    assert(digits.is_match("2026"), "RE2 digit shorthand must match ASCII digits")
    assert(!digits.is_match("20a6"), "digit shorthand must reject a letter")

    auto word = Regex::compile("^\\w+$").unwrap()
    assert(word.is_match("toka_1"), "word shorthand must include ASCII letters digits and underscore")
    assert(!word.is_match("toka-1"), "word shorthand must reject punctuation")

    auto non_space = Regex::compile("^\\S+$").unwrap()
    assert(non_space.is_match("Toka"), "uppercase shorthand must negate ASCII whitespace")
    assert(!non_space.is_match("Toka 1"), "uppercase shorthand must reject member bytes")

    auto space = Regex::compile("^\\s+$").unwrap()
    assert(space.is_match(" \t\n"), "space shorthand must include ASCII whitespace bytes")
}

fn main() -> i32 {
    assert(package_name().equals("regex"), "public package name")
    test_literals_dot_and_anchors()
    test_escapes_and_errors()
    test_grouping_alternation_and_quantifiers()
    test_counted_repetitions()
    test_non_backtracking_adversarial_shape()
    test_ascii_character_classes()
    return 0
}
