import official/regex::{Regex, package_name}

fn test_literals_dot_and_anchors() {
    auto literal = Regex::compile("ab.c")
    assert(literal.is_ok(), "literal and dot pattern must compile")
    auto regex = literal.unwrap()
    assert(regex.is_match("xxabzcxx"), "unanchored search must find a byte match")
    assert(!regex.is_match("abcc"), "literal bytes must retain their order")

    auto located = regex.find("xxabzcxx")
    assert(located.is_some(), "find must return the first match")
    auto found = located.unwrap()
    assert(found.start_offset() == 2:usize && found.end_offset() == 6:usize,
           "find must report byte offsets")

    auto anchored = Regex::compile("^ab$").unwrap()
    assert(anchored.is_match("ab"), "both anchors must accept the complete input")
    assert(!anchored.is_match("zab"), "start anchor must reject a prefix")
    assert(!anchored.is_match("abz"), "end anchor must reject a suffix")
}

fn test_escapes_and_errors() {
    auto escaped = Regex::compile("a\\.b\\n")
    assert(escaped.is_ok(), "escaped metacharacters and newline must compile")
    assert(escaped.unwrap().is_match("a.b\n"), "escaped bytes must be literal")

    auto dangling = Regex::compile("abc\\")
    assert(dangling.is_err(), "dangling escape must be rejected")
    assert(dangling.unwrap_err().position() == 3:usize,
           "error must identify the dangling escape byte")
    assert(Regex::compile("[").is_err(),
           "future RE2 character classes must fail explicitly before their NFA slice exists")
}

fn test_grouping_alternation_and_quantifiers() {
    auto repeated = Regex::compile("a(b|c)+d?")
    assert(repeated.is_ok(), "grouping, alternation, and quantifiers must compile")
    auto regex = repeated.unwrap()
    assert(regex.is_match("xxabcbdy"), "plus and optional paths must match")
    assert(regex.is_match("ac"), "optional suffix must permit omission")
    assert(!regex.is_match("ad"), "plus must require one grouped branch")

    auto star = Regex::compile("^ab*c$").unwrap()
    assert(star.is_match("ac"), "star must permit zero repetitions")
    assert(star.is_match("abbbc"), "star must permit repeated bytes")
    assert(!star.is_match("zabbbc"), "anchored NFA must reject a prefix")

    assert(Regex::compile("(ab").is_err(), "unclosed group must be rejected")
    assert(Regex::compile("a**").is_err(), "stacked quantifiers must be rejected")
}

fn test_non_backtracking_adversarial_shape() {
    auto input# = string::from("")
    auto index#: usize = 0:usize
    loop index < 1024:usize {
        input#.push_byte_raw('a' as u8)
        index = index + 1:usize
    }
    input#.push_byte_raw('c' as u8)

    auto regex = Regex::compile("(a|aa)*b").unwrap()
    assert(!regex.is_match(input.as_str()),
           "Pike NFA must reject the classic backtracking stress shape")
}

fn main() -> i32 {
    assert(package_name().equals("regex"), "public package name")
    test_literals_dot_and_anchors()
    test_escapes_and_errors()
    test_grouping_alternation_and_quantifiers()
    test_non_backtracking_adversarial_shape()
    return 0
}
