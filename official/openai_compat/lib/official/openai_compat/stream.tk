// One completed SSE event -> ordered Chat Completions semantic events.
// HTTP framing stays in stdx/net/sse; transport stays with the application.

import core/option::{Option}
import core/result::{Result}
import official/openai_compat/types::{OpenAiApiError, OpenAiCompatError, OpenAiCompatLimits, OpenAiStreamEvent, OpenAiToolCallDelta, OpenAiUsage}
import std/vec::{Vec}
import stdx/net/sse::{SseEvent}
import stdx/serde/json::{JsonNode, json_skip_whitespace}

fn string_node(cede value: JsonNode) -> Option<string> {
    match cede value {
        auto JsonNode::StrNode('text) => return Option<string>::Some(cede 'text)
        _ => return Option<string>::None
    }
}

fn integer_node(cede value: JsonNode) -> Option<i32> {
    match cede value {
        auto JsonNode::NumNode(number) => {
            if number < 0.0 || number > 2147483647.0 { return Option<i32>::None }
            return Option<i32>::Some(number as i32)
        }
        _ => return Option<i32>::None
    }
}

fn usage_number(cede value: JsonNode) -> Option<usize> {
    match cede value {
        auto JsonNode::NumNode(number) => {
            if number < 0.0 || number > 2147483647.0 { return Option<usize>::None }
            auto whole = number as i32
            if whole as f64 != number { return Option<usize>::None }
            return Option<usize>::Some(whole as usize)
        }
        _ => return Option<usize>::None
    }
}

fn decode_usage(cede value: JsonNode) -> Result<OpenAiUsage, OpenAiCompatError> {
    match cede value {
        auto JsonNode::ObjectNode('raw_usage) => {
            auto usage# = cede 'raw_usage
            auto prompt = usage#.remove(string::from("prompt_tokens"))
            auto completion = usage#.remove(string::from("completion_tokens"))
            auto total = usage#.remove(string::from("total_tokens"))
            if prompt.is_none() || completion.is_none() || total.is_none() {
                return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage is missing token counts"))
            }
            auto prompt = usage_number(cede prompt.unwrap())
            auto completion = usage_number(cede completion.unwrap())
            auto total = usage_number(cede total.unwrap())
            if prompt.is_none() || completion.is_none() || total.is_none() {
                return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage token counts must be non-negative integers"))
            }
            return OpenAiUsage::new(prompt.unwrap(), completion.unwrap(), total.unwrap())
        }
        _ => return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible usage must be an object"))
    }
}

// JsonNode and its maps own recursive storage. We therefore destructively
// remove fields from a consumed object rather than using HashMap::get(), which
// would copy a non-encapsulated JsonNode out of its owner.
fn decode_tool_call(cede value: JsonNode) -> Result<OpenAiToolCallDelta, OpenAiCompatError> {
    match cede value {
        auto JsonNode::ObjectNode('raw_object) => {
            auto object# = cede 'raw_object
            auto index_value = object#.remove(string::from("index"))
            if index_value.is_none() { return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call delta is missing index")) }
            auto index = integer_node(cede index_value.unwrap())
            if index.is_none() { return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call index must be a non-negative integer")) }
            auto id_value = object#.remove(string::from("id"))
            auto id# = Option<string>::None
            if id_value.is_some() {
                auto decoded_id = string_node(cede id_value.unwrap())
                if decoded_id.is_none() { return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call id must be string")) }
                id = decoded_id
            }
            auto name# = Option<string>::None
            auto arguments# = Option<string>::None
            auto function_value = object#.remove(string::from("function"))
            if function_value.is_some() {
                match cede function_value.unwrap() {
                    auto JsonNode::ObjectNode('raw_function) => {
                        auto function# = cede 'raw_function
                        auto name_value = function#.remove(string::from("name"))
                        if name_value.is_some() {
                            auto decoded_name = string_node(cede name_value.unwrap())
                            if decoded_name.is_none() { return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function name must be string")) }
                            name = decoded_name
                        }
                        auto arguments_value = function#.remove(string::from("arguments"))
                        if arguments_value.is_some() {
                            auto decoded_arguments = string_node(cede arguments_value.unwrap())
                            if decoded_arguments.is_none() { return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function arguments must be string")) }
                            arguments = decoded_arguments
                        }
                    }
                    _ => return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool function must be an object"))
                }
            }
            return Result<OpenAiToolCallDelta, OpenAiCompatError>::Ok(OpenAiToolCallDelta::new(index.unwrap(), cede id, cede name, cede arguments))
        }
        _ => return Result<OpenAiToolCallDelta, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call must be an object"))
    }
}

fn decode_choice(cede value: JsonNode, limit: usize, events#: Vec<OpenAiStreamEvent>) -> Result<(), OpenAiCompatError> {
    match cede value {
        auto JsonNode::ObjectNode('raw_choice) => {
            auto choice# = cede 'raw_choice
            auto choice_index = choice#.remove(string::from("index"))
            if choice_index.is_some() {
                auto index = integer_node(cede choice_index.unwrap())
                if index.is_none() {
                    return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only choice index zero"))
                }
                if index.unwrap() != 0:i32 {
                    return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports only choice index zero"))
                }
            }
            auto delta_value = choice#.remove(string::from("delta"))
            if delta_value.is_some() {
                match cede delta_value.unwrap() {
                    auto JsonNode::ObjectNode('raw_delta) => {
                        auto delta# = cede 'raw_delta
                        auto role_value = delta#.remove(string::from("role"))
                        if role_value.is_some() {
                            auto role = string_node(cede role_value.unwrap())
                            if role.is_none() { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta role must be string")) }
                            events#.push(cede OpenAiStreamEvent::RoleDelta(role.unwrap()))
                        }
                        auto content_value = delta#.remove(string::from("content"))
                        if content_value.is_some() {
                            auto content = string_node(cede content_value.unwrap())
                            if content.is_none() { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta content must be string")) }
                            events#.push(cede OpenAiStreamEvent::TextDelta(content.unwrap()))
                        }
                        auto refusal_value = delta#.remove(string::from("refusal"))
                        if refusal_value.is_some() {
                            auto refusal = string_node(cede refusal_value.unwrap())
                            if refusal.is_none() { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta refusal must be string")) }
                            events#.push(cede OpenAiStreamEvent::RefusalDelta(refusal.unwrap()))
                        }
                        auto calls_value = delta#.remove(string::from("tool_calls"))
                        if calls_value.is_some() {
                            match cede calls_value.unwrap() {
                                auto JsonNode::ArrayNode('calls) => {
                                    auto calls# = cede 'calls
                                    if calls.len() > limit { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible chunk has too many tool calls")) }
                                    // Vec::pop() is LIFO. Reverse into a second owned
                                    // vector before decoding so event order remains wire order.
                                    auto ordered_calls# = Vec<JsonNode>::new()
                                    loop calls.len() > 0:usize {
                                        ordered_calls#.push(cede calls#.pop().unwrap())
                                    }
                                    loop ordered_calls.len() > 0:usize {
                                        auto call = ordered_calls#.pop().unwrap()
                                        auto decoded = decode_tool_call(cede call)
                                        if decoded.is_err() { return Result<(), OpenAiCompatError>::Err(decoded.unwrap_err()) }
                                        events#.push(cede OpenAiStreamEvent::ToolCallDelta(decoded.unwrap()))
                                    }
                                }
                                _ => return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool_calls must be an array"))
                            }
                        }
                    }
                    _ => return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible delta must be an object"))
                }
            }
            auto finish_value = choice#.remove(string::from("finish_reason"))
            if finish_value.is_some() {
                match cede finish_value.unwrap() {
                    auto JsonNode::NullNode(_) => {}
                    auto JsonNode::StrNode('reason) => events#.push(cede OpenAiStreamEvent::Completed(Option<string>::Some(cede 'reason)))
                    _ => return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible finish_reason must be string or null"))
                }
            }
            return Result<(), OpenAiCompatError>::Ok(())
        }
        _ => return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choice must be an object"))
    }
}

// Decode one SSE data event from the OpenAI-compatible `/v1/chat/completions`
// streaming profile. `[DONE]` is provider policy, not an SSE framing rule.
pub fn decode_sse_event(cede input: SseEvent, limits: OpenAiCompatLimits) -> Result<Vec<OpenAiStreamEvent>, OpenAiCompatError> {
    auto event = cede input
    auto data = event.data()
    if data.as_str().equals("[DONE]") {
        auto completed# = Vec<OpenAiStreamEvent>::new()
        completed#.push(cede OpenAiStreamEvent::Completed(Option<string>::None))
        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede completed)
    }
    if data.len() > limits.max_json_bytes() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible SSE JSON exceeds configured byte limit")) }
    auto root# = JsonNode::NullNode(0)
    auto parsed = root#.parse_json(data.as_str())
    if parsed.is_err() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("json", "OpenAI-compatible SSE data is invalid JSON")) }
    if json_skip_whitespace(parsed.unwrap()).len() != 0:usize { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("json", "OpenAI-compatible SSE data has trailing JSON text")) }
    match cede root {
        auto JsonNode::ObjectNode('raw_root) => {
            auto root# = cede 'raw_root
            auto provider_error = root#.remove(string::from("error"))
            if provider_error.is_some() {
                match cede provider_error.unwrap() {
                    auto JsonNode::ObjectNode('raw_error) => {
                        auto failure# = cede 'raw_error
                        auto message_value = failure#.remove(string::from("message"))
                        if message_value.is_none() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error is missing message")) }
                        auto message = string_node(cede message_value.unwrap())
                        if message.is_none() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error message must be string")) }
                        auto kind_value = failure#.remove(string::from("type"))
                        auto kind# = Option<string>::None
                        if kind_value.is_some() {
                            auto decoded_kind = string_node(cede kind_value.unwrap())
                            if decoded_kind.is_none() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error type must be string")) }
                            kind = decoded_kind
                        }
                        auto code_value = failure#.remove(string::from("code"))
                        auto code# = Option<string>::None
                        if code_value.is_some() {
                            auto decoded_code = string_node(cede code_value.unwrap())
                            if decoded_code.is_none() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error code must be string")) }
                            code = decoded_code
                        }
                        auto api_events# = Vec<OpenAiStreamEvent>::new()
                        api_events#.push(cede OpenAiStreamEvent::ApiError(OpenAiApiError::new(cede message.unwrap(), cede kind, cede code)))
                        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede api_events)
                    }
                    _ => return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible error must be an object"))
                }
            }
            auto events# = Vec<OpenAiStreamEvent>::new()
            auto usage_value = root#.remove(string::from("usage"))
            if usage_value.is_some() {
                auto usage = decode_usage(cede usage_value.unwrap())
                if usage.is_err() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(usage.unwrap_err()) }
                events#.push(cede OpenAiStreamEvent::Usage(usage.unwrap()))
            }
            auto choices_value = root#.remove(string::from("choices"))
            if choices_value.is_none() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible chunk is missing choices")) }
            match cede choices_value.unwrap() {
                auto JsonNode::ArrayNode('values) => {
                    auto values# = cede 'values
                    if values.len() > 1:usize {
                        return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("scope", "OpenAI-compatible v1 supports one choice per stream chunk"))
                    }
                    // Preserve the provider's choice order while consuming JsonNode
                    // values without copying their recursive storage.
                    auto ordered_choices# = Vec<JsonNode>::new()
                    loop values.len() > 0:usize {
                        ordered_choices#.push(cede values#.pop().unwrap())
                    }
                    loop ordered_choices.len() > 0:usize {
                        auto choice = ordered_choices#.pop().unwrap()
                        auto decoded = decode_choice(cede choice, limits.max_tool_calls_per_chunk(), events)
                        if decoded.is_err() { return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(decoded.unwrap_err()) }
                    }
                }
                _ => return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible choices must be an array"))
            }
            return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Ok(cede events)
        }
        _ => return Result<Vec<OpenAiStreamEvent>, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible SSE root must be an object"))
    }
}
