// Bounded assembly of one ordered Chat Completions stream choice.

import core/option::{Option}
import core/result::{Result}
import official/openai_compat/types::{OpenAiAssistantTurn, OpenAiCompatError, OpenAiStreamEvent, OpenAiToolCall, OpenAiToolCallDelta, OpenAiUsage}
import std/vec::{Vec}

pub shape OpenAiAssemblyLimits (max_output_bytes: usize, max_tool_calls: usize, max_tool_argument_bytes: usize)

shape ToolCallState (
    id: string,
    name: string,
    arguments#: string,
    has_id: bool,
    has_name: bool
)

pub shape StreamAssembler (
    limits: OpenAiAssemblyLimits,
    role: Option<string>,
    content#: string,
    refusal#: string,
    tool_calls#: Vec<ToolCallState>,
    finish_reason: Option<string>,
    usage: Option<OpenAiUsage>,
    completed: bool
)

impl ToolCallState {
    fn new() -> ToolCallState {
        return ToolCallState(id = string::from(""), name = string::from(""), arguments = string::from(""), has_id = false, has_name = false)
    }
    fn clone(self) -> ToolCallState {
        return ToolCallState(id = self.id.clone(), name = self.name.clone(), arguments = self.arguments.clone(), has_id = self.has_id, has_name = self.has_name)
    }
}

impl ToolCallState@Encap { fn drop(self#) {} }

impl OpenAiAssemblyLimits@Encap { fn drop(self#) {} }
impl OpenAiAssemblyLimits {
    pub fn new(max_output_bytes: usize, max_tool_calls: usize, max_tool_argument_bytes: usize) -> Result<OpenAiAssemblyLimits, OpenAiCompatError> {
        if max_output_bytes == 0:usize || max_tool_calls == 0:usize || max_tool_argument_bytes == 0:usize {
            return Result<OpenAiAssemblyLimits, OpenAiCompatError>::Err(OpenAiCompatError::new("input", "OpenAI-compatible assembly limits must be positive"))
        }
        return Result<OpenAiAssemblyLimits, OpenAiCompatError>::Ok(OpenAiAssemblyLimits(max_output_bytes = max_output_bytes, max_tool_calls = max_tool_calls, max_tool_argument_bytes = max_tool_argument_bytes))
    }
    pub fn clone(self) -> OpenAiAssemblyLimits {
        return OpenAiAssemblyLimits(max_output_bytes = self.max_output_bytes, max_tool_calls = self.max_tool_calls, max_tool_argument_bytes = self.max_tool_argument_bytes)
    }
}

impl StreamAssembler@Encap { fn drop(self#) {} }
impl StreamAssembler {
    pub fn new(cede limits: OpenAiAssemblyLimits) -> StreamAssembler {
        return StreamAssembler(limits = cede limits, role = Option<string>::None, content = string::from(""), refusal = string::from(""), tool_calls = Vec<ToolCallState>::new(), finish_reason = Option<string>::None, usage = Option<OpenAiUsage>::None, completed = false)
    }

    fn append_output(self#, value: str, refusal: bool) -> Result<(), OpenAiCompatError> {
        if self.content.len() + self.refusal.len() + value.len() > self.limits.max_output_bytes {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible assembled output exceeds configured byte limit"))
        }
        if refusal { self.refusal#.push_str(value) } else { self.content#.push_str(value) }
        return Result<(), OpenAiCompatError>::Ok(())
    }

    fn apply_tool_delta(self#, delta: OpenAiToolCallDelta) -> Result<(), OpenAiCompatError> {
        if delta.index() < 0:i32 { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call index must be non-negative")) }
        auto index = delta.index() as usize
        if index > self.tool_calls.len() || index >= self.limits.max_tool_calls {
            return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible tool call index exceeds configured assembly limit"))
        }
        if index == self.tool_calls.len() {
            self.tool_calls#.push(cede ToolCallState::new())
        }
        auto *state# = self.tool_calls.get_ref(index)
        auto id = delta.id()
        match id {
            auto Option<string>::Some(&value) => {
                if state.has_id && !state.id.as_str().equals(value.as_str()) {
                    return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call id conflicts with an earlier delta"))
                }
                state.id = value.clone()
                state.has_id = true
            }
            _ => {}
        }
        auto name = delta.name()
        match name {
            auto Option<string>::Some(&value) => {
                if state.has_name && !state.name.as_str().equals(value.as_str()) {
                    return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible tool call name conflicts with an earlier delta"))
                }
                state.name = value.clone()
                state.has_name = true
            }
            _ => {}
        }
        auto arguments = delta.arguments_delta()
        match arguments {
            auto Option<string>::Some(&value) => {
            if state.arguments.len() + value.len() > self.limits.max_tool_argument_bytes {
                return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("limit", "OpenAI-compatible tool arguments exceed configured byte limit"))
            }
            state.arguments#.push_str(value.as_str())
            }
            _ => {}
        }
        return Result<(), OpenAiCompatError>::Ok(())
    }

    pub fn push(self#, event#: OpenAiStreamEvent) -> Result<(), OpenAiCompatError> {
        if self.completed { return Result<(), OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible stream event follows completion")) }
        match event {
            auto OpenAiStreamEvent::RoleDelta(&role) => {
                self.role = Option<string>::Some(role.clone())
                return Result<(), OpenAiCompatError>::Ok(())
            }
            auto OpenAiStreamEvent::TextDelta(&text) => return self#.append_output(text.as_str(), false)
            auto OpenAiStreamEvent::RefusalDelta(&text) => return self#.append_output(text.as_str(), true)
            auto OpenAiStreamEvent::ToolCallDelta(&delta) => return self#.apply_tool_delta(delta)
            auto OpenAiStreamEvent::Usage(&usage) => {
                self.usage = Option<OpenAiUsage>::Some(usage.clone())
                return Result<(), OpenAiCompatError>::Ok(())
            }
            auto OpenAiStreamEvent::Completed(&reason) => {
                self.completed = true
                match reason {
                    auto Option<string>::Some(&value) => self.finish_reason = Option<string>::Some(value.clone())
                    _ => self.finish_reason = Option<string>::None
                }
                return Result<(), OpenAiCompatError>::Ok(())
            }
            auto OpenAiStreamEvent::ApiError(&failure) => return Result<(), OpenAiCompatError>::Err(failure.clone())
        }
    }

    pub fn finish(self#) -> Result<OpenAiAssistantTurn, OpenAiCompatError> {
        if !self.completed { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible stream ended without completion")) }
        auto calls# = Vec<OpenAiToolCall>::new()
        auto index# = 0:usize
        loop index < self.tool_calls.len() {
            auto state = self.tool_calls.get(index).clone()
            if !state.has_id || !state.has_name {
                return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "OpenAI-compatible completed tool call is missing id or name"))
            }
            auto call = OpenAiToolCall::new(state.id.as_str(), state.name.as_str(), state.arguments.as_str())
            if call.is_err() { return Result<OpenAiAssistantTurn, OpenAiCompatError>::Err(call.unwrap_err()) }
            calls#.push(cede call.unwrap())
            index += 1:usize
        }
        auto content# = Option<string>::None
        if self.content.len() > 0:usize { content = Option<string>::Some(self.content.clone()) }
        auto refusal# = Option<string>::None
        if self.refusal.len() > 0:usize { refusal = Option<string>::Some(self.refusal.clone()) }
        auto role# = Option<string>::None
        match self.role {
            auto Option<string>::Some(&value) => role = Option<string>::Some(value.clone())
            _ => {}
        }
        auto finish_reason# = Option<string>::None
        match self.finish_reason {
            auto Option<string>::Some(&value) => finish_reason = Option<string>::Some(value.clone())
            _ => {}
        }
        auto usage# = Option<OpenAiUsage>::None
        match self.usage {
            auto Option<OpenAiUsage>::Some(&value) => usage = Option<OpenAiUsage>::Some(value.clone())
            _ => {}
        }
        return Result<OpenAiAssistantTurn, OpenAiCompatError>::Ok(OpenAiAssistantTurn::new(cede role, cede content, cede refusal, cede calls, cede finish_reason, cede usage))
    }
}
