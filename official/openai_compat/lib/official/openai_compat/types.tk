}

impl OpenAiUsage@Encap { fn drop(self#) {} }
impl OpenAiUsage {
    pub fn new(prompt_tokens: usize, completion_tokens: usize, total_tokens: usize) -> Result<OpenAiUsage, OpenAiCompatError> {
        if total_tokens < prompt_tokens || total_tokens < completion_tokens {
            return Result<OpenAiUsage, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "usage total_tokens is smaller than a component"))
        }
        return Result<OpenAiUsage, OpenAiCompatError>::Ok(OpenAiUsage(prompt_tokens = prompt_tokens, completion_tokens = completion_tokens, total_tokens = total_tokens))
    }
    pub fn clone(self) -> OpenAiUsage { return OpenAiUsage(prompt_tokens = self.prompt_tokens, completion_tokens = self.completion_tokens, total_tokens = self.total_tokens) }
    pub fn prompt_tokens(self) -> usize { return self.prompt_tokens }
    pub fn completion_tokens(self) -> usize { return self.completion_tokens }
    pub fn total_tokens(self) -> usize { return self.total_tokens }
}

impl OpenAiToolCall@Encap { fn drop(self#) {} }
impl OpenAiToolCall {
    pub fn new(id: str, name: str, arguments: str) -> Result<OpenAiToolCall, OpenAiCompatError> {
        if id.len() == 0:usize || name.len() == 0:usize {
            return Result<OpenAiToolCall, OpenAiCompatError>::Err(OpenAiCompatError::new("protocol", "tool call requires non-empty id and name"))
        }
        return Result<OpenAiToolCall, OpenAiCompatError>::Ok(OpenAiToolCall(id = string::from(id), name = string::from(name), arguments = string::from(arguments)))
    }
    pub fn clone(self) -> OpenAiToolCall { return OpenAiToolCall(id = self.id.clone(), name = self.name.clone(), arguments = self.arguments.clone()) }
    pub fn id(self) -> string { return self.id.clone() }
    pub fn name(self) -> string { return self.name.clone() }
    pub fn arguments(self) -> string { return self.arguments.clone() }
}

impl OpenAiAssistantTurn@Encap { fn drop(self#) {} }
impl OpenAiAssistantTurn {
    pub fn new(cede role: Option<string>, cede content: Option<string>, cede refusal: Option<string>, cede tool_calls: Vec<OpenAiToolCall>, cede finish_reason: Option<string>, cede usage: Option<OpenAiUsage>) -> OpenAiAssistantTurn {
        return OpenAiAssistantTurn(role = cede role, content = cede content, refusal = cede refusal, tool_calls = cede tool_calls, finish_reason = cede finish_reason, usage = cede usage)
    }
    pub fn clone(self) -> OpenAiAssistantTurn {
        auto role# = Option<string>::None
        match self.role {
            auto Option<string>::Some(&value) => role = Option<string>::Some(value.clone())
            _ => {}
        }
        auto content# = Option<string>::None
        match self.content {
            auto Option<string>::Some(&value) => content = Option<string>::Some(value.clone())
            _ => {}
        }
        auto refusal# = Option<string>::None
        match self.refusal {
            auto Option<string>::Some(&value) => refusal = Option<string>::Some(value.clone())
            _ => {}
        }
        auto finish_reason# = Option<string>::None
        match self.finish_reason {
            auto Option<string>::Some(&value) => finish_reason = Option<string>::Some(value.clone())
            _ => {}
        }
        auto usage# = Option<OpenAiUsage>::None
        match self.usage {
            auto Option<OpenAiUsage>::Some(&value) => usage = Option<OpenAiUsage>::Some(value.clone())
            _ => {}
        }
        return OpenAiAssistantTurn(role = cede role, content = cede content, refusal = cede refusal, tool_calls = clone_tool_calls(self.tool_calls), finish_reason = cede finish_reason, usage = cede usage)
    }
    pub fn role(self) -> Option<string> {
        match self.role {
            auto Option<string>::Some(&value) => return Option<string>::Some(value.clone())
            _ => return Option<string>::None
        }
    }
    pub fn content(self) -> Option<string> {
        match self.content {
            auto Option<string>::Some(&value) => return Option<string>::Some(value.clone())
            _ => return Option<string>::None
        }
    }
    pub fn refusal(self) -> Option<string> {
        match self.refusal {
            auto Option<string>::Some(&value) => return Option<string>::Some(value.clone())
            _ => return Option<string>::None
        }
    }
    pub fn tool_calls(self) -> Vec<OpenAiToolCall> { return clone_tool_calls(self.tool_calls) }
    pub fn finish_reason(self) -> Option<string> {
        match self.finish_reason {
            auto Option<string>::Some(&value) => return Option<string>::Some(value.clone())
            _ => return Option<string>::None
        }
    }
    pub fn usage(self) -> Option<OpenAiUsage> {
        match self.usage {
            auto Option<OpenAiUsage>::Some(&value) => return Option<OpenAiUsage>::Some(value.clone())
            _ => return Option<OpenAiUsage>::None
        }
    }
}

impl OpenAiCompletion@Encap { fn drop(self#) {} }
impl OpenAiCompletion {
    pub fn clone(self) -> OpenAiCompletion {
        match self {
            auto OpenAiCompletion::AssistantTurn(&turn) => return OpenAiCompletion::AssistantTurn(turn.clone())
            auto OpenAiCompletion::ApiError(&failure) => return OpenAiCompletion::ApiError(failure.clone())
        }
    }
}

impl OpenAiStreamEvent@Encap { fn drop(self#) {} }
impl OpenAiStreamEvent {
    pub fn clone(self) -> OpenAiStreamEvent {
        match self {
            auto OpenAiStreamEvent::RoleDelta(&role) => return OpenAiStreamEvent::RoleDelta(role.clone())
            auto OpenAiStreamEvent::TextDelta(&text) => return OpenAiStreamEvent::TextDelta(text.clone())
            auto OpenAiStreamEvent::RefusalDelta(&text) => return OpenAiStreamEvent::RefusalDelta(text.clone())
            auto OpenAiStreamEvent::ToolCallDelta(&delta) => return OpenAiStreamEvent::ToolCallDelta(delta.clone())
            auto OpenAiStreamEvent::Completed(&reason) => {
                match reason {
                    auto Option<string>::Some(&value) => return OpenAiStreamEvent::Completed(Option<string>::Some(value.clone()))
                    _ => return OpenAiStreamEvent::Completed(Option<string>::None)
                }
            }
            auto OpenAiStreamEvent::Usage(&usage) => return OpenAiStreamEvent::Usage(usage.clone())
            auto OpenAiStreamEvent::ApiError(&failure) => return OpenAiStreamEvent::ApiError(failure.clone())
        }
    }
}
