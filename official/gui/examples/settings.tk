import core/option::{Option}
import official/gui::{App, Bounds, Container, Event, EventKind, Modifiers, Rect, Scene, ScrollState, ShortcutMap, ToggleState, VirtualList, Window}

fn main() -> i32 {
    auto app# = App::new()
    auto opened = Window::open("Toka settings", 720:i32, 520:i32)
    if opened.is_err() { return 1 }
    auto window# = opened.unwrap()
    if window#.show().is_err() { return 2 }

    auto scroll# = ScrollState::new(8.0:f64, 0.56:f64).unwrap()
    auto telemetry# = ToggleState::new(1:i32, Bounds(x = 0.08:f64, y = 0.18:f64, width = 0.32:f64, height = 0.10:f64), false).unwrap()
    auto shortcuts# = ShortcutMap::new()
    shortcuts#.bind(12:i32, Modifiers::command(), 1:i32)

    loop app.is_running() && !window.is_closed() {
        app#.wait_for_event(16:i32)
        auto draining# = true
        loop draining {
            auto next = window#.poll_event().unwrap()
            match next {
                auto Option<Event>::Some(event) => {
                    if event.kind == EventKind::CloseRequested {
                        window#.close()
                        draining = false
                    }
                    if event.kind == EventKind::Scrolled {
                        if scroll#.apply_wheel(event, 0.002:f64).unwrap() { window#.request_redraw() }
                    }
                    if telemetry#.handle_event(event).unwrap() { window#.request_redraw() }
                    match shortcuts.dispatch(event) {
                        auto Option<i32>::Some(action) => {
                            if action == 1:i32 { window#.request_redraw() }
                        }
                        _ => {}
                    }
                }
                _ => draining = false
            }
        }

        if window#.take_redraw_request().unwrap() {
            auto scene# = Scene::new()
            scene#.add_rect(Rect(x = 0.0:f64, y = 0.0:f64, width = 1.0:f64, height = 1.0:f64,
                                 red = 0.08:f64, green = 0.10:f64, blue = 0.14:f64, alpha = 1.0:f64))
            scene#.add_text("Settings", 0.08:f64, 0.08:f64, 0.08:f64,
                            0.96:f64, 0.97:f64, 1.0:f64, 1.0:f64)
            if telemetry.value() {
                scene#.add_text("Telemetry enabled", 0.08:f64, 0.20:f64, 0.04:f64,
                                0.30:f64, 0.85:f64, 0.48:f64, 1.0:f64)
            } else {
                scene#.add_text("Telemetry disabled", 0.08:f64, 0.20:f64, 0.04:f64,
                                0.92:f64, 0.50:f64, 0.42:f64, 1.0:f64)
            }
            auto range = VirtualList::visible(80:i32, 0.10:f64, scroll.offset(), 0.56:f64, 1:i32).unwrap()
            auto list# = Container::new(Bounds(x = 0.08:f64, y = 0.36:f64, width = 0.76:f64, height = 0.56:f64), true).unwrap()
            auto index# = range.first
            loop index < range.last_exclusive {
                auto row = VirtualList::item_bounds(index, 0.10:f64, scroll.offset(), 1.0:f64).unwrap()
                list#.add_rect(Rect(x = 0.0:f64, y = row.y, width = row.width, height = row.height - 0.01:f64,
                                    red = 0.15:f64, green = 0.19:f64, blue = 0.27:f64, alpha = 1.0:f64))
                index += 1:i32
            }
            scene#.add_container(cede list)
            if scene.render(window#, 0.08:f64, 0.10:f64, 0.14:f64, 1.0:f64).is_err() { return 3 }
        }
    }
    app#.stop()
    return 0
}
