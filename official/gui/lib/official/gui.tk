pub shape GuiError (
    message: string
)

shape UiThreadAffinity (
    *marker: void = null as *void
)

impl UiThreadAffinity@Encap {
    fn drop(self#) {}
}

pub shape Window (
    handle#: Addr,
    thread_affinity: UiThreadAffinity,
    closed#: bool,
    frame_open#: bool
)

pub shape App (
    running#: bool,
    thread_affinity: UiThreadAffinity
)

pub shape EventKind (
    Shown = 1 |
    PointerMoved = 2 |
    PointerDown = 3 |
    PointerUp = 4 |
    KeyDown = 5 |
    Resized = 6 |
    CloseRequested = 7 |
    Scrolled = 8
)

pub shape Event (
    kind: EventKind,
    x: f64,
    y: f64,
    code: i32,
    modifiers: i32,
    width: i32,
    height: i32
)

pub shape TextEventKind (
    Committed = 1 |
    Composition = 2 |
    CompositionCleared = 3
)

pub shape TextEvent (
    kind: TextEventKind,
    text#: string
)

pub shape Modifiers ()

pub shape Rect (
    x: f64,
    y: f64,
    width: f64,
    height: f64,
    red: f64,
    green: f64,
    blue: f64,
    alpha: f64
)

pub shape Bounds (
    x: f64,
    y: f64,
    width: f64,
    height: f64
)

pub shape Size (
    width: i32,
    height: i32
)

pub shape Layout ()

pub shape VirtualList ()

pub shape VisibleRange (
    first: i32,
    last_exclusive: i32,
    content_extent: f64
)

pub shape ScrollState (
    offset#: f64,
    content_extent: f64,
    viewport_extent: f64
)

pub shape Scrollbar ()

pub shape FocusState (
    focused_id#: i32
)

pub shape ButtonState (
    id: i32,
    bounds: Bounds,
    hovered#: bool,
    pressed#: bool
)

pub shape ToggleState (
    id: i32,
    bounds: Bounds,
    value#: bool,
    hovered#: bool,
    pressed#: bool
)

shape ShortcutBinding (
    scope_id: i32,
    key_code: i32,
    modifiers: i32,
    action_id: i32
)

pub shape ShortcutMap (
    bindings#: Vec<ShortcutBinding>
)

pub shape Text (
    content#: string,
    x: f64,
    y: f64,
    size: f64,
    red: f64,
    green: f64,
    blue: f64,
    alpha: f64
)

pub shape Image (
    path#: string,
    x: f64,
    y: f64,
    width: f64,
    height: f64,
    alpha: f64
)

pub shape Container (
    bounds: Bounds,
    clip: bool,
    nodes#: Vec<SceneNode>
)

shape SceneNode (
    Rectangle(Rect) |
    Raster(Image) |
    Label(Text) |
    Group(Container)
)

pub shape Scene (
    nodes#: Vec<SceneNode>
)

fn gui_error(message: str) -> GuiError {
    return GuiError(message = string::from(message))
}

fn compose_bounds(parent: Bounds, local: Bounds) -> Bounds {
    return Bounds(x = parent.x + local.x * parent.width,
                  y = parent.y + local.y * parent.height,
                  width = local.width * parent.width,
                  height = local.height * parent.height)
}

fn event_inside(bounds: Bounds, event: Event) -> bool {
    return event.x >= bounds.x && event.y >= bounds.y &&
           event.x <= bounds.x + bounds.width && event.y <= bounds.y + bounds.height
}

impl GuiError {
    pub fn message(self) -> string { return string::from(self.message.as_str()) }
}

impl TextEvent {
    pub fn kind(self) -> TextEventKind { return self.kind }

    pub fn text(self) -> str { return self.text.as_str() }
}

impl Modifiers {
    pub fn shift() -> i32 { return 1:i32 }
    pub fn control() -> i32 { return 2:i32 }
    pub fn option() -> i32 { return 4:i32 }
    pub fn command() -> i32 { return 8:i32 }
}

impl App {
    pub fn new() -> App {
        return App(running = true,
                   thread_affinity = UiThreadAffinity(*marker = null as *void))
    }

    pub fn pump(self) -> i32 {
        if !self.running { return 0:i32 }
        return toka_gui_macos_pump_events()
    }

    pub fn wait_for_event(self, timeout_millis: i32) -> Result<bool, GuiError> {
        if timeout_millis < 0:i32 { return Result<bool, GuiError>::Err(gui_error("wait timeout must not be negative")) }
        if !self.running { return Result<bool, GuiError>::Ok(false) }
        auto handled = toka_gui_macos_wait_events(timeout_millis)
        if handled < 0:i32 { return Result<bool, GuiError>::Err(gui_error("could not wait for macOS event")) }
        return Result<bool, GuiError>::Ok(handled == 1:i32)
    }

    pub fn stop(self#) { self.running = false }

    pub fn is_running(self) -> bool { return self.running }
}

// This adapter keeps AppKit on the caller's UI thread while letting the
// standard executor account for its bounded wait.  `std/task` retains no App
// state and has no dependency on this package.
impl App@HostEventSource {
    pub fn poll_events(self#, timeout_millis: i32) -> Result<HostEventPoll, string> {
        auto waited = self.wait_for_event(timeout_millis)
        match cede waited {
            auto Result<bool, GuiError>::Ok('handled) => {
                if !self.running { return Result<HostEventPoll, string>::Ok(HostEventPoll::Stopped) }
                if 'handled { return Result<HostEventPoll, string>::Ok(HostEventPoll::Event) }
                return Result<HostEventPoll, string>::Ok(HostEventPoll::Idle)
            }
            auto Result<bool, GuiError>::Err('error) => {
                return Result<HostEventPoll, string>::Err('error.message())
            }
            _ => return Result<HostEventPoll, string>::Err(string::from("invalid GUI event result"))
        }
    }
}

impl Layout {
    pub fn inset(bounds: Bounds, amount: f64) -> Result<Bounds, GuiError> {
        if amount < 0.0:f64 || (bounds.width - amount * 2.0:f64) <= 0.0:f64 ||
           (bounds.height - amount * 2.0:f64) <= 0.0:f64 {
            return Result<Bounds, GuiError>::Err(gui_error("inset exceeds available bounds"))
        }
        return Result<Bounds, GuiError>::Ok(Bounds(x = bounds.x + amount, y = bounds.y + amount,
                                                    width = bounds.width - amount * 2.0:f64,
                                                    height = bounds.height - amount * 2.0:f64))
    }

    pub fn row(bounds: Bounds, count: i32, gap: f64) -> Result<Vec<Bounds>, GuiError> {
        if count <= 0:i32 || gap < 0.0:f64 {
            return Result<Vec<Bounds>, GuiError>::Err(gui_error("invalid row layout"))
        }
        auto item_width = (bounds.width - gap * ((count - 1:i32) as f64)) / (count as f64)
        if item_width <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("row gap exceeds available width")) }
        auto output# = Vec<Bounds>::with_capacity(count as usize)
        auto index# = 0:i32
        loop index < count {
            output#.push(Bounds(x = bounds.x + (item_width + gap) * (index as f64), y = bounds.y,
                                width = item_width, height = bounds.height))
            index += 1:i32
        }
        return Result<Vec<Bounds>, GuiError>::Ok(cede output)
    }

    pub fn column(bounds: Bounds, count: i32, gap: f64) -> Result<Vec<Bounds>, GuiError> {
        if count <= 0:i32 || gap < 0.0:f64 {
            return Result<Vec<Bounds>, GuiError>::Err(gui_error("invalid column layout"))
        }
        auto item_height = (bounds.height - gap * ((count - 1:i32) as f64)) / (count as f64)
        if item_height <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("column gap exceeds available height")) }
        auto output# = Vec<Bounds>::with_capacity(count as usize)
        auto index# = 0:i32
        loop index < count {
            output#.push(Bounds(x = bounds.x, y = bounds.y + (item_height + gap) * (index as f64),
                                width = bounds.width, height = item_height))
            index += 1:i32
        }
        return Result<Vec<Bounds>, GuiError>::Ok(cede output)
    }

    pub fn row_weighted(bounds: Bounds, weights: Vec<f64>, gap: f64) -> Result<Vec<Bounds>, GuiError> {
        if weights.len() == 0:usize || gap < 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("invalid weighted row layout")) }
        auto total# = 0.0:f64
        auto index# = 0:usize
        loop index < weights.len() {
            auto weight = weights.get(index)
            if weight <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("layout weights must be positive")) }
            total += weight
            index += 1:usize
        }
        auto available = bounds.width - gap * ((weights.len() - 1:usize) as f64)
        if available <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("row gap exceeds available width")) }
        auto output# = Vec<Bounds>::with_capacity(weights.len())
        auto cursor# = bounds.x:f64
        index = 0:usize
        loop index < weights.len() {
            auto item_width = available * weights.get(index) / total
            output#.push(Bounds(x = cursor, y = bounds.y, width = item_width, height = bounds.height))
            cursor += item_width + gap
            index += 1:usize
        }
        return Result<Vec<Bounds>, GuiError>::Ok(cede output)
    }

    pub fn column_weighted(bounds: Bounds, weights: Vec<f64>, gap: f64) -> Result<Vec<Bounds>, GuiError> {
        if weights.len() == 0:usize || gap < 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("invalid weighted column layout")) }
        auto total# = 0.0:f64
        auto index# = 0:usize
        loop index < weights.len() {
            auto weight = weights.get(index)
            if weight <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("layout weights must be positive")) }
            total += weight
            index += 1:usize
        }
        auto available = bounds.height - gap * ((weights.len() - 1:usize) as f64)
        if available <= 0.0:f64 { return Result<Vec<Bounds>, GuiError>::Err(gui_error("column gap exceeds available height")) }
        auto output# = Vec<Bounds>::with_capacity(weights.len())
        auto cursor# = bounds.y:f64
        index = 0:usize
        loop index < weights.len() {
            auto item_height = available * weights.get(index) / total
            output#.push(Bounds(x = bounds.x, y = cursor, width = bounds.width, height = item_height))
            cursor += item_height + gap
            index += 1:usize
        }
        return Result<Vec<Bounds>, GuiError>::Ok(cede output)
    }
}

impl VirtualList {
    pub fn visible(total_items: i32, item_extent: f64, scroll_offset: f64,
                   viewport_extent: f64, overscan: i32) -> Result<VisibleRange, GuiError> {
        if total_items < 0:i32 || item_extent <= 0.0:f64 || scroll_offset < 0.0:f64 ||
           viewport_extent <= 0.0:f64 || overscan < 0:i32 {
            return Result<VisibleRange, GuiError>::Err(gui_error("invalid virtual list geometry"))
        }
        auto content_extent = (total_items as f64) * item_extent
        if total_items == 0:i32 {
            return Result<VisibleRange, GuiError>::Ok(VisibleRange(first = 0:i32, last_exclusive = 0:i32,
                                                                    content_extent = content_extent))
        }
        auto first# = (scroll_offset / item_extent) as i32 - overscan
        if first < 0:i32 { first = 0:i32 }
        if first > total_items { first = total_items }
        auto last# = ((scroll_offset + viewport_extent) / item_extent) as i32 + 1:i32 + overscan
        if last < first { last = first }
        if last > total_items { last = total_items }
        return Result<VisibleRange, GuiError>::Ok(VisibleRange(first = first, last_exclusive = last,
                                                                content_extent = content_extent))
    }

    pub fn item_bounds(index: i32, item_extent: f64, scroll_offset: f64,
                       viewport_width: f64) -> Result<Bounds, GuiError> {
        if index < 0:i32 || item_extent <= 0.0:f64 || scroll_offset < 0.0:f64 || viewport_width <= 0.0:f64 {
            return Result<Bounds, GuiError>::Err(gui_error("invalid virtual list item geometry"))
        }
        return Result<Bounds, GuiError>::Ok(Bounds(x = 0.0:f64, y = (index as f64) * item_extent - scroll_offset,
                                                    width = viewport_width, height = item_extent))
    }
}

impl ScrollState {
    pub fn new(content_extent: f64, viewport_extent: f64) -> Result<ScrollState, GuiError> {
        if content_extent < 0.0:f64 || viewport_extent <= 0.0:f64 {
            return Result<ScrollState, GuiError>::Err(gui_error("invalid scroll geometry"))
        }
        return Result<ScrollState, GuiError>::Ok(ScrollState(offset = 0.0:f64, content_extent = content_extent,
                                                              viewport_extent = viewport_extent))
    }

    pub fn offset(self) -> f64 { return self.offset }

    pub fn max_offset(self) -> f64 {
        if self.content_extent <= self.viewport_extent { return 0.0:f64 }
        return self.content_extent - self.viewport_extent
    }

    pub fn scroll_by(self#, delta: f64) -> bool {
        auto next# = self.offset + delta
        if next < 0.0:f64 { next = 0.0:f64 }
        auto maximum = self.max_offset()
        if next > maximum { next = maximum }
        if next == self.offset { return false }
        self.offset = next
        return true
    }

    pub fn set_offset(self#, offset: f64) -> bool {
        return self#.scroll_by(offset - self.offset)
    }

    pub fn apply_wheel(self#, event: Event, scale: f64) -> Result<bool, GuiError> {
        if event.kind != EventKind::Scrolled || scale <= 0.0:f64 {
            return Result<bool, GuiError>::Err(gui_error("expected a scroll event and positive scale"))
        }
        return Result<bool, GuiError>::Ok(self#.scroll_by(-event.y * scale))
    }
}

impl Scrollbar {
    pub fn thumb(track: Bounds, scroll: ScrollState, min_extent: f64) -> Result<Bounds, GuiError> {
        if track.width <= 0.0:f64 || track.height <= 0.0:f64 || min_extent <= 0.0:f64 {
            return Result<Bounds, GuiError>::Err(gui_error("invalid scrollbar geometry"))
        }
        auto thumb_extent# = track.height
        if scroll.content_extent > scroll.viewport_extent {
            thumb_extent = track.height * scroll.viewport_extent / scroll.content_extent
        }
        if thumb_extent < min_extent { thumb_extent = min_extent }
        if thumb_extent > track.height { thumb_extent = track.height }
        auto travel = track.height - thumb_extent
        auto y# = track.y
        if travel > 0.0:f64 && scroll.max_offset() > 0.0:f64 {
            y += travel * scroll.offset() / scroll.max_offset()
        }
        return Result<Bounds, GuiError>::Ok(Bounds(x = track.x, y = y, width = track.width, height = thumb_extent))
    }

    pub fn drag_to(scroll#: ScrollState, track: Bounds, min_extent: f64,
                   pointer_y: f64) -> Result<bool, GuiError> {
        auto thumb = Scrollbar::thumb(track, scroll, min_extent)
        if thumb.is_err() { return Result<bool, GuiError>::Err(gui_error("invalid scrollbar drag geometry")) }
        auto resolved = thumb.unwrap()
        auto travel = track.height - resolved.height
        if travel <= 0.0:f64 { return Result<bool, GuiError>::Ok(scroll#.set_offset(0.0:f64)) }
        auto ratio# = (pointer_y - track.y - resolved.height / 2.0:f64) / travel
        if ratio < 0.0:f64 { ratio = 0.0:f64 }
        if ratio > 1.0:f64 { ratio = 1.0:f64 }
        return Result<bool, GuiError>::Ok(scroll#.set_offset(ratio * scroll.max_offset()))
    }
}

impl FocusState {
    pub fn new() -> FocusState { return FocusState(focused_id = -1:i32) }

    pub fn request(self#, id: i32) { self.focused_id = id }

    pub fn clear(self#) { self.focused_id = -1:i32 }

    pub fn is_focused(self, id: i32) -> bool { return self.focused_id == id }

    pub fn focused_id(self) -> i32 { return self.focused_id }
}

impl ButtonState {
    pub fn new(id: i32, bounds: Bounds) -> Result<ButtonState, GuiError> {
        if bounds.width <= 0.0:f64 || bounds.height <= 0.0:f64 {
            return Result<ButtonState, GuiError>::Err(gui_error("button dimensions must be positive"))
        }
        return Result<ButtonState, GuiError>::Ok(ButtonState(id = id, bounds = bounds, hovered = false, pressed = false))
    }

    pub fn is_hovered(self) -> bool { return self.hovered }

    pub fn is_pressed(self) -> bool { return self.pressed }

    pub fn handle_event(self#, event: Event) -> Result<bool, GuiError> {
        auto inside = event_inside(self.bounds, event)
        if event.kind == EventKind::PointerMoved {
            self.hovered = inside
            return Result<bool, GuiError>::Ok(false)
        }
        if event.kind == EventKind::PointerDown {
            self.hovered = inside
            self.pressed = inside
            return Result<bool, GuiError>::Ok(false)
        }
        if event.kind == EventKind::PointerUp {
            auto clicked = self.pressed && inside
            self.hovered = inside
            self.pressed = false
            return Result<bool, GuiError>::Ok(clicked)
        }
        return Result<bool, GuiError>::Ok(false)
    }
}

impl ToggleState {
    pub fn new(id: i32, bounds: Bounds, initial_value: bool) -> Result<ToggleState, GuiError> {
        if bounds.width <= 0.0:f64 || bounds.height <= 0.0:f64 {
            return Result<ToggleState, GuiError>::Err(gui_error("toggle dimensions must be positive"))
        }
        return Result<ToggleState, GuiError>::Ok(ToggleState(id = id, bounds = bounds, value = initial_value,
                                                              hovered = false, pressed = false))
    }

    pub fn value(self) -> bool { return self.value }

    pub fn is_hovered(self) -> bool { return self.hovered }

    pub fn handle_event(self#, event: Event) -> Result<bool, GuiError> {
        auto inside = event_inside(self.bounds, event)
        if event.kind == EventKind::PointerMoved {
            self.hovered = inside
            return Result<bool, GuiError>::Ok(false)
        }
        if event.kind == EventKind::PointerDown {
            self.hovered = inside
            self.pressed = inside
            return Result<bool, GuiError>::Ok(false)
        }
        if event.kind == EventKind::PointerUp {
            auto changed = self.pressed && inside
            self.hovered = inside
            self.pressed = false
            if changed { self.value = !self.value }
            return Result<bool, GuiError>::Ok(changed)
        }
        return Result<bool, GuiError>::Ok(false)
    }
}

impl ShortcutMap {
    pub fn new() -> ShortcutMap { return ShortcutMap(bindings = Vec<ShortcutBinding>::new()) }

    pub fn bind(self#, key_code: i32, modifiers: i32, action_id: i32) -> Result<i32, GuiError> {
        return self#.bind_in_scope(-1:i32, key_code, modifiers, action_id)
    }

    pub fn bind_in_scope(self#, scope_id: i32, key_code: i32, modifiers: i32, action_id: i32) -> Result<i32, GuiError> {
        auto index# = 0:usize
        loop index < self.bindings.len() {
            auto binding = self.bindings.get(index)
            if binding.scope_id == scope_id && binding.key_code == key_code && binding.modifiers == modifiers {
                return Result<i32, GuiError>::Err(gui_error("shortcut is already bound"))
            }
            index += 1:usize
        }
        self.bindings#.push(ShortcutBinding(scope_id = scope_id, key_code = key_code,
                                            modifiers = modifiers, action_id = action_id))
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn dispatch(self, event: Event) -> Option<i32> {
        return self.dispatch_for_scope(event, -1:i32)
    }

    pub fn dispatch_for_scope(self, event: Event, scope_id: i32) -> Option<i32> {
        if event.kind != EventKind::KeyDown { return Option<i32>::None }
        auto index# = 0:usize
        loop index < self.bindings.len() {
            auto binding = self.bindings.get(index)
            if binding.scope_id == scope_id && binding.key_code == event.code && binding.modifiers == event.modifiers {
                return Option<i32>::Some(binding.action_id)
            }
            index += 1:usize
        }
        if scope_id == -1:i32 { return Option<i32>::None }
        index = 0:usize
        loop index < self.bindings.len() {
            auto binding = self.bindings.get(index)
            if binding.scope_id == -1:i32 && binding.key_code == event.code && binding.modifiers == event.modifiers {
                return Option<i32>::Some(binding.action_id)
            }
            index += 1:usize
        }
        return Option<i32>::None
    }
}

impl Container {
    pub fn new(bounds: Bounds, clip: bool) -> Result<Container, GuiError> {
        if bounds.x < 0.0:f64 || bounds.y < 0.0:f64 || bounds.width <= 0.0:f64 || bounds.height <= 0.0:f64 ||
           bounds.x + bounds.width > 1.0:f64 || bounds.y + bounds.height > 1.0:f64 {
            return Result<Container, GuiError>::Err(gui_error("container must fit parent bounds"))
        }
        return Result<Container, GuiError>::Ok(Container(bounds = bounds, clip = clip, nodes = Vec<SceneNode>::new()))
    }

    pub fn add_rect(self#, rect: Rect) { self.nodes#.push(cede SceneNode::Rectangle(rect)) }

    pub fn add_text(self#, content: str, x: f64, y: f64, size: f64,
                    red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if size <= 0.0:f64 { return Result<i32, GuiError>::Err(gui_error("text size must be positive")) }
        self.nodes#.push(cede SceneNode::Label(Text(content = string::from(content), x = x, y = y, size = size,
                                                     red = red, green = green, blue = blue, alpha = alpha)))
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn add_container(self#, cede child: Container) {
        self.nodes#.push(cede SceneNode::Group(cede child))
    }

    fn render(self, window#: Window, parent: Bounds) -> Result<i32, GuiError> {
        auto current = compose_bounds(parent, self.bounds)
        if self.clip && window#.push_clip(current.x, current.y, current.width, current.height).is_err() {
            return Result<i32, GuiError>::Err(gui_error("could not push container clip"))
        }
        auto index# = 0:usize
        loop index < self.nodes.len() {
            auto *node = self.nodes.get_ref(index)
            match node {
                auto SceneNode::Rectangle(&rect) => {
                    auto absolute = compose_bounds(current, Bounds(x = rect.x, y = rect.y, width = rect.width, height = rect.height))
                    if window#.frame_rect(absolute.x, absolute.y, absolute.width, absolute.height,
                                          rect.red, rect.green, rect.blue, rect.alpha).is_err() {
                        if self.clip { window#.pop_clip() }
                        return Result<i32, GuiError>::Err(gui_error("could not render container rectangle"))
                    }
                }
                auto SceneNode::Label(&text) => {
                    if window#.frame_text(text.content.as_str(), current.x + text.x * current.width,
                                          current.y + text.y * current.height, text.size * current.height,
                                          text.red, text.green, text.blue, text.alpha).is_err() {
                        if self.clip { window#.pop_clip() }
                        return Result<i32, GuiError>::Err(gui_error("could not render container text"))
                    }
                }
                auto SceneNode::Raster(&image) => {
                    auto absolute = compose_bounds(current, Bounds(x = image.x, y = image.y, width = image.width, height = image.height))
                    if window#.frame_image(image.path.as_str(), absolute.x, absolute.y, absolute.width,
                                           absolute.height, image.alpha).is_err() {
                        if self.clip { window#.pop_clip() }
                        return Result<i32, GuiError>::Err(gui_error("could not render container image"))
                    }
                }
                auto SceneNode::Group(&child) => {
                    if child.render(window#, current).is_err() {
                        if self.clip { window#.pop_clip() }
                        return Result<i32, GuiError>::Err(gui_error("could not render nested container"))
                    }
                }
            }
            index += 1:usize
        }
        if self.clip && window#.pop_clip().is_err() {
            return Result<i32, GuiError>::Err(gui_error("could not pop container clip"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }
}

impl Scene {
    pub fn new() -> Scene { return Scene(nodes = Vec<SceneNode>::new()) }

    pub fn len(self) -> usize { return self.nodes.len() }

    pub fn add_rect(self#, rect: Rect) {
        self.nodes#.push(cede SceneNode::Rectangle(rect))
    }

    pub fn add_text(self#, content: str, x: f64, y: f64, size: f64,
                    red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if size <= 0.0:f64 { return Result<i32, GuiError>::Err(gui_error("text size must be positive")) }
        self.nodes#.push(cede SceneNode::Label(Text(content = string::from(content), x = x, y = y, size = size,
                                                     red = red, green = green, blue = blue, alpha = alpha)))
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn add_image(self#, path: str, x: f64, y: f64, width: f64, height: f64,
                     alpha: f64) -> Result<i32, GuiError> {
        if width <= 0.0:f64 || height <= 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("image dimensions must be positive"))
        }
        self.nodes#.push(cede SceneNode::Raster(Image(path = string::from(path), x = x, y = y, width = width,
                                                       height = height, alpha = alpha)))
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn add_svg_icon(self#, path: str, x: f64, y: f64, width: f64, height: f64,
                        alpha: f64) -> Result<i32, GuiError> {
        return self#.add_image(path, x, y, width, height, alpha)
    }

    pub fn add_container(self#, cede container: Container) {
        self.nodes#.push(cede SceneNode::Group(cede container))
    }

    pub fn add_row(self#, count: i32, x: f64, y: f64, width: f64, height: f64, gap: f64,
                   red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if count <= 0:i32 || width <= 0.0:f64 || height <= 0.0:f64 || gap < 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("invalid row layout"))
        }
        auto item_width = (width - gap * ((count - 1:i32) as f64)) / (count as f64)
        if item_width <= 0.0:f64 { return Result<i32, GuiError>::Err(gui_error("row gap exceeds available width")) }
        auto index# = 0:i32
        loop index < count {
            self#.add_rect(Rect(x = x + (item_width + gap) * (index as f64), y = y,
                                 width = item_width, height = height, red = red,
                                 green = green, blue = blue, alpha = alpha))
            index += 1:i32
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn add_column(self#, count: i32, x: f64, y: f64, width: f64, height: f64, gap: f64,
                      red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if count <= 0:i32 || width <= 0.0:f64 || height <= 0.0:f64 || gap < 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("invalid column layout"))
        }
        auto item_height = (height - gap * ((count - 1:i32) as f64)) / (count as f64)
        if item_height <= 0.0:f64 { return Result<i32, GuiError>::Err(gui_error("column gap exceeds available height")) }
        auto index# = 0:i32
        loop index < count {
            self#.add_rect(Rect(x = x, y = y + (item_height + gap) * (index as f64),
                                 width = width, height = item_height, red = red,
                                 green = green, blue = blue, alpha = alpha))
            index += 1:i32
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn render(self, window#: Window, red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if window#.begin_frame(red, green, blue, alpha).is_err() {
            return Result<i32, GuiError>::Err(gui_error("could not begin Scene frame"))
        }
        auto index# = 0:usize
        loop index < self.nodes.len() {
            auto *node = self.nodes.get_ref(index)
            match node {
                auto SceneNode::Rectangle(&rect) => {
                    if window#.frame_rect(rect.x, rect.y, rect.width, rect.height,
                                          rect.red, rect.green, rect.blue, rect.alpha).is_err() {
                        window#.end_frame()
                        return Result<i32, GuiError>::Err(gui_error("could not render Scene rectangle"))
                    }
                }
                auto SceneNode::Raster(&image) => {
                    if window#.frame_image(image.path.as_str(), image.x, image.y, image.width,
                                           image.height, image.alpha).is_err() {
                        window#.end_frame()
                        return Result<i32, GuiError>::Err(gui_error("could not render Scene image"))
                    }
                }
                auto SceneNode::Label(&text) => {
                    if window#.frame_text(text.content.as_str(), text.x, text.y, text.size,
                                          text.red, text.green, text.blue, text.alpha).is_err() {
                        window#.end_frame()
                        return Result<i32, GuiError>::Err(gui_error("could not render Scene text"))
                    }
                }
                auto SceneNode::Group(&container) => {
                    if container.render(window#, Bounds(x = 0.0:f64, y = 0.0:f64, width = 1.0:f64, height = 1.0:f64)).is_err() {
                        window#.end_frame()
                        return Result<i32, GuiError>::Err(gui_error("could not render Scene container"))
                    }
                }
            }
            index += 1:usize
        }
        return window#.end_frame()
    }
}

impl Scene@Encap {
    fn drop(self#) {}
}

impl Container@Encap {
    fn drop(self#) {}
}

impl ShortcutMap@Encap {
    fn drop(self#) {}
}

impl TextEvent@Encap {
    fn drop(self#) {}
}

impl Window {
    pub fn open(title: str, width: i32, height: i32) -> Result<Window, GuiError> {
        if width <= 0:i32 || height <= 0:i32 {
            return Result<Window, GuiError>::Err(gui_error("window dimensions must be positive"))
        }
        auto owned_title = string::from(title)
        auto handle = toka_gui_macos_create_window(owned_title.c_str() as Addr, width, height)
        if handle == ADDR0 {
            return Result<Window, GuiError>::Err(gui_error("could not create a macOS Metal window"))
        }
        return Result<Window, GuiError>::Ok(Window(handle = handle,
                                                   thread_affinity = UiThreadAffinity(*marker = null as *void),
                                                   closed = false, frame_open = false))
    }

    pub fn show(self#) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("show on closed window")) }
        if toka_gui_macos_show_window(self.handle) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not show macOS window"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn redraw(self#, red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("pump on closed window")) }
        if self.frame_open { return Result<i32, GuiError>::Err(gui_error("redraw while a frame is open")) }
        if toka_gui_macos_clear_window(self.handle, red, green, blue, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not render to macOS Metal window"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn request_redraw(self#) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("request redraw on closed window")) }
        if toka_gui_macos_request_redraw(self.handle) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not schedule macOS redraw"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn take_redraw_request(self#) -> Result<bool, GuiError> {
        if self.closed { return Result<bool, GuiError>::Err(gui_error("take redraw request on closed window")) }
        auto requested = toka_gui_macos_take_redraw_request(self.handle)
        if requested < 0:i32 { return Result<bool, GuiError>::Err(gui_error("could not read macOS redraw request")) }
        return Result<bool, GuiError>::Ok(requested == 1:i32)
    }

    pub fn fill_rect(self#, x: f64, y: f64, width: f64, height: f64, red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("draw on closed window")) }
        if self.frame_open { return Result<i32, GuiError>::Err(gui_error("fill_rect while a frame is open")) }
        if width <= 0.0:f64 || height <= 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("rectangle dimensions must be positive"))
        }
        if toka_gui_macos_fill_rect(self.handle, x, y, width, height, red, green, blue, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not draw rectangle to macOS Metal window"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn begin_frame(self#, red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("begin frame on closed window")) }
        if self.frame_open { return Result<i32, GuiError>::Err(gui_error("frame already open")) }
        if toka_gui_macos_begin_frame(self.handle, red, green, blue, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not begin macOS Metal frame"))
        }
        self.frame_open = true
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn frame_rect(self#, x: f64, y: f64, width: f64, height: f64, red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("draw frame rectangle on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("draw frame rectangle without begin_frame")) }
        if width <= 0.0:f64 || height <= 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("rectangle dimensions must be positive"))
        }
        if toka_gui_macos_frame_rect(self.handle, x, y, width, height, red, green, blue, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not append rectangle to macOS Metal frame"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn frame_text(self#, text: str, x: f64, y: f64, size: f64,
                      red: f64, green: f64, blue: f64, alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("draw frame text on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("draw frame text without begin_frame")) }
        if size <= 0.0:f64 { return Result<i32, GuiError>::Err(gui_error("text size must be positive")) }
        auto owned_text = string::from(text)
        if toka_gui_macos_frame_text(self.handle, owned_text.c_str() as Addr, x, y, size,
                                     red, green, blue, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not append text to macOS Metal frame"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn frame_image(self#, path: str, x: f64, y: f64, width: f64, height: f64,
                       alpha: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("draw frame image on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("draw frame image without begin_frame")) }
        if width <= 0.0:f64 || height <= 0.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("image dimensions must be positive"))
        }
        auto owned_path = string::from(path)
        if toka_gui_macos_frame_image(self.handle, owned_path.c_str() as Addr, x, y, width, height, alpha) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not append image to macOS Metal frame"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn frame_svg_icon(self#, path: str, x: f64, y: f64, width: f64, height: f64,
                          alpha: f64) -> Result<i32, GuiError> {
        return self#.frame_image(path, x, y, width, height, alpha)
    }

    pub fn clear_image_cache(self#) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("clear image cache on closed window")) }
        if toka_gui_macos_clear_image_cache(self.handle) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not clear macOS image cache"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn push_clip(self#, x: f64, y: f64, width: f64, height: f64) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("push clip on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("push clip without begin_frame")) }
        if x < 0.0:f64 || y < 0.0:f64 || width <= 0.0:f64 || height <= 0.0:f64 ||
           x + width > 1.0:f64 || y + height > 1.0:f64 {
            return Result<i32, GuiError>::Err(gui_error("clip must fit normalized window bounds"))
        }
        if toka_gui_macos_push_clip(self.handle, x, y, width, height) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not push macOS frame clip"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn pop_clip(self#) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("pop clip on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("pop clip without begin_frame")) }
        if toka_gui_macos_pop_clip(self.handle) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("cannot pop the root frame clip"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn end_frame(self#) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("end frame on closed window")) }
        if !self.frame_open { return Result<i32, GuiError>::Err(gui_error("end_frame without begin_frame")) }
        if toka_gui_macos_end_frame(self.handle) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not present macOS Metal frame"))
        }
        self.frame_open = false
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn poll_event(self#) -> Result<Option<Event>, GuiError> {
        if self.closed { return Result<Option<Event>, GuiError>::Err(gui_error("poll event on closed window")) }
        auto kind = toka_gui_macos_next_event_kind(self.handle)
        if kind == 0:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::None) }
        auto x = toka_gui_macos_event_x(self.handle)
        auto y = toka_gui_macos_event_y(self.handle)
        auto code = toka_gui_macos_event_code(self.handle)
        auto modifiers = toka_gui_macos_event_modifiers(self.handle)
        auto width = toka_gui_macos_event_width(self.handle)
        auto height = toka_gui_macos_event_height(self.handle)
        if kind == 1:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::Shown, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 2:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::PointerMoved, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 3:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::PointerDown, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 4:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::PointerUp, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 5:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::KeyDown, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 6:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::Resized, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 7:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::CloseRequested, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        if kind == 8:i32 { return Result<Option<Event>, GuiError>::Ok(Option<Event>::Some(Event(kind = EventKind::Scrolled, x = x, y = y, code = code, modifiers = modifiers, width = width, height = height))) }
        return Result<Option<Event>, GuiError>::Err(gui_error("macOS event queue returned an unknown event"))
    }

    pub fn poll_text(self#) -> Result<Option<TextEvent>, GuiError> {
        if self.closed { return Result<Option<TextEvent>, GuiError>::Err(gui_error("poll text on closed window")) }
        auto kind = toka_gui_macos_next_text_kind(self.handle)
        if kind == 0:i32 { return Result<Option<TextEvent>, GuiError>::Ok(Option<TextEvent>::None) }
        auto value = string::from_cstr(toka_gui_macos_text_value(self.handle) as *char)
        if kind == 1:i32 { return Result<Option<TextEvent>, GuiError>::Ok(Option<TextEvent>::Some(cede TextEvent(kind = TextEventKind::Committed, text = cede value))) }
        if kind == 2:i32 { return Result<Option<TextEvent>, GuiError>::Ok(Option<TextEvent>::Some(cede TextEvent(kind = TextEventKind::Composition, text = cede value))) }
        if kind == 3:i32 { return Result<Option<TextEvent>, GuiError>::Ok(Option<TextEvent>::Some(cede TextEvent(kind = TextEventKind::CompositionCleared, text = cede value))) }
        return Result<Option<TextEvent>, GuiError>::Err(gui_error("macOS text queue returned an unknown event"))
    }

    pub fn copy_text(self#, text: str) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("copy text on closed window")) }
        auto owned = string::from(text)
        if toka_gui_macos_copy_text(self.handle, owned.c_str() as Addr) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not write macOS clipboard"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn paste_text(self#) -> Result<Option<string>, GuiError> {
        if self.closed { return Result<Option<string>, GuiError>::Err(gui_error("paste text on closed window")) }
        auto value = toka_gui_macos_paste_text(self.handle)
        if value == ADDR0 { return Result<Option<string>, GuiError>::Ok(Option<string>::None) }
        return Result<Option<string>, GuiError>::Ok(Option<string>::Some(cede string::from_cstr(value as *char)))
    }

    pub fn has_metal_surface(self) -> bool {
        return !self.closed && toka_gui_macos_window_has_metal(self.handle) == 1:i32
    }

    pub fn size(self) -> Result<Size, GuiError> {
        if self.closed { return Result<Size, GuiError>::Err(gui_error("size on closed window")) }
        auto width = toka_gui_macos_window_width(self.handle)
        auto height = toka_gui_macos_window_height(self.handle)
        if width <= 0:i32 || height <= 0:i32 { return Result<Size, GuiError>::Err(gui_error("could not read macOS window size")) }
        return Result<Size, GuiError>::Ok(Size(width = width, height = height))
    }

    pub fn resize(self#, width: i32, height: i32) -> Result<i32, GuiError> {
        if self.closed { return Result<i32, GuiError>::Err(gui_error("resize on closed window")) }
        if width <= 0:i32 || height <= 0:i32 { return Result<i32, GuiError>::Err(gui_error("window dimensions must be positive")) }
        if toka_gui_macos_resize_window(self.handle, width, height) != 0:i32 {
            return Result<i32, GuiError>::Err(gui_error("could not resize macOS window"))
        }
        return Result<i32, GuiError>::Ok(0:i32)
    }

    pub fn is_closed(self) -> bool { return self.closed }

    pub fn close(self#) {
        if !self.closed {
            if self.frame_open {
                toka_gui_macos_end_frame(self.handle)
                self.frame_open = false
            }
            toka_gui_macos_destroy_window(self.handle)
            self.handle = ADDR0
            self.closed = true
        }
    }

}

impl Window@Encap {
    fn drop(self#) { self#.close() }
}
