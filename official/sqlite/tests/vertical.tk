import official/sqlite::{Database, Step}

extern fn toka_sqlite_live_handle_count() -> i32
extern fn toka_sqlite_live_statement_count() -> i32

fn close_by_scope() {
    auto opened = Database::open(":memory:")
    assert(opened.is_ok(), "RAII probe open")
    auto database# = opened.unwrap()
    assert(database#.execute("CREATE TABLE scope_probe (value INTEGER);").is_ok(), "RAII probe execute")
}

fn main() -> i32 {
    auto opened = Database::open(":memory:")
    assert(opened.is_ok(), "SQLite open must return a safe Database")
    auto database# = opened.unwrap()
    assert(database#.execute("CREATE TABLE items (value INTEGER, label TEXT, note TEXT);").is_ok(), "create table")
    auto insert = database#.prepare("INSERT INTO items VALUES (?, ?, ?);").unwrap()
    assert(insert#.bind_i64(1:i32, 7:i64).is_ok(), "bind integer")
    assert(insert#.bind_text(2:i32, "toka").is_ok(), "bind text")
    assert(insert#.bind_null(3:i32).is_ok(), "bind null")
    assert(insert#.step().unwrap() == Step::Done, "insert must finish")
    assert(insert#.reset().is_ok(), "reset statement")
    assert(insert#.finalize().is_ok(), "explicit finalize")
    assert(toka_sqlite_live_statement_count() == 0:i32, "explicit finalize must release statement")

    auto select = database#.prepare("SELECT value, label, note FROM items;").unwrap()
    assert(select#.step().unwrap() == Step::Row, "select must produce a row")
    assert(select.column_i64(0:i32).unwrap() == 7:i64, "selected integer value")
    assert(select.column_text(1:i32).unwrap().unwrap().equals("toka"), "selected text must be owned")
    assert(select.column_text(2:i32).unwrap().is_none(), "SQL NULL must not fabricate text")
    assert(select#.step().unwrap() == Step::Done, "select must finish")
    assert(select#.finalize().is_ok(), "select finalize")

    auto committed# = database#.begin().unwrap()
    assert(committed#.execute("INSERT INTO items VALUES (8, 'committed', NULL);").is_ok(), "transaction insert")
    assert(committed#.commit().is_ok(), "transaction commit")

    if true {
        auto rolled_back# = database#.begin().unwrap()
        assert(rolled_back#.execute("INSERT INTO items VALUES (9, 'rolled back', NULL);").is_ok(), "rollback probe insert")
    }
    auto count = database#.prepare("SELECT COUNT(*) FROM items;").unwrap()
    assert(count#.step().unwrap() == Step::Row, "count row")
    assert(count.column_i64(0:i32).unwrap() == 2:i64, "scope cleanup must rollback active transaction")
    assert(count#.finalize().is_ok(), "count finalize")
    assert(database#.close().is_ok(), "explicit close")
    assert(database.is_closed(), "close must disarm RAII cleanup")
    assert(database#.close().is_ok(), "close must be idempotent")
    close_by_scope()
    assert(toka_sqlite_live_handle_count() == 0:i32, "scope cleanup must close an unclosed database exactly once")
    return 0
}
