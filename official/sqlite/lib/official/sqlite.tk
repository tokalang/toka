import core/result::{Result}
import core/option::{Option}
import core/types::{Addr, ADDR0}

extern fn toka_sqlite_open_path(path: Addr) -> Addr
extern fn toka_sqlite_execute(handle: Addr, sql: Addr) -> i32
extern fn toka_sqlite_close(handle: Addr) -> i32
extern fn toka_sqlite_prepare(handle: Addr, sql: Addr) -> Addr
extern fn toka_sqlite_bind_i64(statement: Addr, index: i32, value: i64) -> i32
extern fn toka_sqlite_bind_text(statement: Addr, index: i32, value: Addr) -> i32
extern fn toka_sqlite_bind_null(statement: Addr, index: i32) -> i32
extern fn toka_sqlite_step(statement: Addr) -> i32
extern fn toka_sqlite_column_i64(statement: Addr, index: i32) -> i64
extern fn toka_sqlite_column_text(statement: Addr, index: i32) -> Addr
extern fn toka_sqlite_column_bytes(statement: Addr, index: i32) -> i32
extern fn toka_sqlite_reset(statement: Addr) -> i32
extern fn toka_sqlite_finalize(statement: Addr) -> i32

pub shape SqliteError (
    code: i32,
    message: string
)

pub shape Database (
    handle#: Addr,
    closed#: bool
)

pub shape Step (
    Row = 0 |
    Done = 1
)

pub shape Statement (
    handle#: Addr,
    finalized#: bool
)

fn sqlite_error(code: i32, operation: str) -> SqliteError {
    auto message# = string::from("SQLite ")
    message#.push_str(operation)
    message#.push_str(" failed (code ")
    message#.push_str(string::from_i64(code as i64).as_str())
    message#.push_byte_raw(')' as u8)
    return SqliteError(code = code, message = message)
}

impl SqliteError {
    pub fn code(self) -> i32 { return self.code }
    pub fn message(self) -> string { return string::from(self.message.as_str()) }
}

impl Database {
    pub fn open(path: str) -> Result<Database, SqliteError> {
        if path.len() == 0:usize {
            return Result<Database, SqliteError>::Err(sqlite_error(14:i32, "open empty path"))
        }
        auto owned_path = string::from(path)
        auto handle = toka_sqlite_open_path(owned_path.c_str() as Addr)
        if handle == ADDR0 {
            return Result<Database, SqliteError>::Err(sqlite_error(14:i32, "open"))
        }
        return Result<Database, SqliteError>::Ok(Database(handle = handle, closed = false))
    }

    pub fn execute(self#, sql: str) -> Result<i32, SqliteError> {
        if self.closed { return Result<i32, SqliteError>::Err(sqlite_error(21:i32, "execute on closed database")) }
        auto owned_sql = string::from(sql)
        auto code = toka_sqlite_execute(self.handle, owned_sql.c_str() as Addr)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "execute")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn close(self#) -> Result<i32, SqliteError> {
        if self.closed { return Result<i32, SqliteError>::Ok(0:i32) }
        auto code = toka_sqlite_close(self.handle)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "close")) }
        self.handle = ADDR0
        self.closed = true
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn is_closed(self) -> bool { return self.closed }

    pub fn prepare(self#, sql: str) -> Result<Statement, SqliteError> {
        if self.closed { return Result<Statement, SqliteError>::Err(sqlite_error(21:i32, "prepare on closed database")) }
        auto owned_sql = string::from(sql)
        auto handle = toka_sqlite_prepare(self.handle, owned_sql.c_str() as Addr)
        if handle == ADDR0 { return Result<Statement, SqliteError>::Err(sqlite_error(1:i32, "prepare")) }
        return Result<Statement, SqliteError>::Ok(Statement(handle = handle, finalized = false))
    }

    fn drop(self#) {
        if !self.closed {
            toka_sqlite_close(self.handle)
            self.handle = ADDR0
            self.closed = true
        }
    }
}

impl Statement {
    pub fn bind_i64(self#, index: i32, value: i64) -> Result<i32, SqliteError> {
        if self.finalized { return Result<i32, SqliteError>::Err(sqlite_error(21:i32, "bind on finalized statement")) }
        auto code = toka_sqlite_bind_i64(self.handle, index, value)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "bind")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn bind_text(self#, index: i32, value: str) -> Result<i32, SqliteError> {
        if self.finalized { return Result<i32, SqliteError>::Err(sqlite_error(21:i32, "bind on finalized statement")) }
        auto owned = string::from(value)
        auto code = toka_sqlite_bind_text(self.handle, index, owned.c_str() as Addr)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "bind text")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn bind_null(self#, index: i32) -> Result<i32, SqliteError> {
        if self.finalized { return Result<i32, SqliteError>::Err(sqlite_error(21:i32, "bind on finalized statement")) }
        auto code = toka_sqlite_bind_null(self.handle, index)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "bind null")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn step(self#) -> Result<Step, SqliteError> {
        if self.finalized { return Result<Step, SqliteError>::Err(sqlite_error(21:i32, "step on finalized statement")) }
        auto code = toka_sqlite_step(self.handle)
        if code == 100:i32 { return Result<Step, SqliteError>::Ok(Step::Row) }
        if code == 101:i32 { return Result<Step, SqliteError>::Ok(Step::Done) }
        return Result<Step, SqliteError>::Err(sqlite_error(code, "step"))
    }

    pub fn column_i64(self, index: i32) -> Result<i64, SqliteError> {
        if self.finalized { return Result<i64, SqliteError>::Err(sqlite_error(21:i32, "read finalized statement")) }
        return Result<i64, SqliteError>::Ok(toka_sqlite_column_i64(self.handle, index))
    }

    pub fn column_text(self, index: i32) -> Result<Option<string>, SqliteError> {
        if self.finalized { return Result<Option<string>, SqliteError>::Err(sqlite_error(21:i32, "read finalized statement")) }
        auto address = toka_sqlite_column_text(self.handle, index)
        if address == ADDR0 { return Result<Option<string>, SqliteError>::Ok(Option<string>::None) }
        auto length = toka_sqlite_column_bytes(self.handle, index)
        if length < 0:i32 { return Result<Option<string>, SqliteError>::Err(sqlite_error(1:i32, "read text")) }
        unsafe {
            auto *text = address as *char
            return Result<Option<string>, SqliteError>::Ok(Option<string>::Some(string::from_with_len(*text, length as usize)))
        }
    }

    pub fn reset(self#) -> Result<i32, SqliteError> {
        if self.finalized { return Result<i32, SqliteError>::Err(sqlite_error(21:i32, "reset finalized statement")) }
        auto code = toka_sqlite_reset(self.handle)
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "reset")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    pub fn finalize(self#) -> Result<i32, SqliteError> {
        if self.finalized { return Result<i32, SqliteError>::Ok(0:i32) }
        auto code = toka_sqlite_finalize(self.handle)
        self.handle = ADDR0
        self.finalized = true
        if code != 0:i32 { return Result<i32, SqliteError>::Err(sqlite_error(code, "finalize")) }
        return Result<i32, SqliteError>::Ok(code)
    }

    fn drop(self#) {
        if !self.finalized {
            toka_sqlite_finalize(self.handle)
            self.handle = ADDR0
            self.finalized = true
        }
    }
}

pub fn package_name() -> string {
    return string::from("sqlite")
}
