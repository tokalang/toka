import official/router::{Router, package_name}
import stdx/net/http::{HttpMethod}

fn expect_match(router: Router, method: HttpMethod, target: str, expected_name: str, parameter: str, expected_value: str) {
    auto found = router.recognize(method, target)
    assert(found.is_some(), "expected route match")
    auto matched = found.unwrap()
    assert(matched.route_name().as_str().equals(expected_name), "route name")
    auto value = matched.param(parameter)
    assert(value.is_some(), "expected route parameter")
    assert(value.unwrap().as_str().equals(expected_value), "route parameter value")
}

fn main() -> i32 {
    assert(package_name().as_str().equals("router"), "public package name")

    auto router# = Router::new()
    assert(router#.add(HttpMethod::GET, "/", "health").is_ok(), "root route")
    assert(router#.add(HttpMethod::GET, "/notes/:id", "notes.show").is_ok(), "parameter route")
    assert(router#.add(HttpMethod::GET, "/notes/new", "notes.new").is_ok(), "static route")
    assert(router#.add(HttpMethod::POST, "/notes", "notes.create").is_ok(), "post route")
    assert(router#.add(HttpMethod::GET, "/files/:name", "files.show").is_ok(), "raw parameter route")

    auto root = router.recognize(HttpMethod::GET, "/")
    match cede root {
        auto Option::Some('matched) => assert('matched.route_name().as_str().equals("health"), "root recognizes")
        _ => assert(false, "root recognizes")
    }
    expect_match(router, HttpMethod::GET, "/notes/42?view=full", "notes.show", "id", "42")
    auto static_match = router.recognize(HttpMethod::GET, "/notes/new")
    match cede static_match {
        auto Option::Some('matched) => assert('matched.route_name().as_str().equals("notes.new"), "static route wins")
        _ => assert(false, "static route wins")
    }
    expect_match(router, HttpMethod::GET, "/files/a%2Fb", "files.show", "name", "a%2Fb")

    assert(router.recognize(HttpMethod::POST, "/notes/42").is_none(), "wrong method does not match")
    auto allowed = router.allowed_methods("/notes/42")
    assert(allowed.len() == 1:usize && allowed.get(0:usize) == HttpMethod::GET, "allowed methods distinguish 405")
    assert(router.allowed_methods("/missing").len() == 0:usize, "unknown path distinguishes 404")
    assert(router.recognize(HttpMethod::GET, "/notes/").is_none(), "trailing slash is not normalized")

    assert(router#.add(HttpMethod::GET, "/items/:first", "items.first").is_ok(), "first parameter shape")
    assert(router#.add(HttpMethod::GET, "/items/:second", "items.duplicate").is_err(), "same method and shape rejected")
    assert(router#.add(HttpMethod::GET, "/pair/:id/:id", "pair.bad").is_err(), "duplicate parameter rejected")
    assert(router#.add(HttpMethod::GET, "/invalid/", "invalid.trailing").is_err(), "trailing slash definition rejected")
    assert(router#.add(HttpMethod::UNKNOWN, "/unknown", "unknown.method").is_err(), "unknown method rejected")

    auto ambiguity# = Router::new()
    assert(ambiguity#.add(HttpMethod::GET, "/:left/x", "left.x").is_ok(), "first equal-specificity route")
    assert(ambiguity#.add(HttpMethod::GET, "/x/:right", "x.right").is_err(), "equal-specificity overlap rejected")
    return 0
}
