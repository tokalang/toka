import official/redis::{RedisClient, RedisCommand, RedisPipeline, RedisValue}
import core/result::{Result}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/io::{println}
import std/task::{block_on, sleep_async}
import std/vec::{Vec}
import stdx/net/stream::{AsyncStream}
import stdx/net/tls::{TlsStream}

fn bytes_from_text(value: str) -> Vec<u8> {
    auto bytes# = Vec<u8>::with_capacity(value.len())
    auto index# = 0:usize
    loop index < value.len() {
        bytes#.push(value.byte_at(index) as u8)
        index = index + 1:usize
    }
    return bytes
}

fn read_tcp_async(stream#: TcpStream) -> async Result<Vec<u8>, string> {
    auto buffer# = Vec<u8>::with_capacity(1024:usize)
    auto read = stream#.read_into_async(cede buffer, 1024:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _buffer = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto bytes = received#.take_buffer()
    if count == 0:usize { return Result<Vec<u8>, string>::Err(string::from("unexpected EOF")) }
    return Result<Vec<u8>, string>::Ok(cede bytes)
}

fn write_tcp_async(stream#: TcpStream, response: str) -> async bool {
    auto bytes# = bytes_from_text(response)
    auto write = stream#.write_from_async(cede bytes, 1000:i32).await
    if write.is_err() { return false }
    auto completed# = write.unwrap()
    auto complete = completed.complete
    auto _bytes = completed#.take_buffer()
    return complete
}

fn read_stream_async(stream#: AsyncStream) -> async Result<Vec<u8>, string> {
    auto buffer# = Vec<u8>::with_capacity(1024:usize)
    auto read = stream#.read_into_async(cede buffer, 1024:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _buffer = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto bytes = received#.take_buffer()
    if count == 0:usize { return Result<Vec<u8>, string>::Err(string::from("unexpected EOF")) }
    return Result<Vec<u8>, string>::Ok(cede bytes)
}

fn write_stream_async(stream#: AsyncStream, response: str) -> async bool {
    auto bytes# = bytes_from_text(response)
    auto write = stream#.write_from_async(cede bytes, 1000:i32).await
    if write.is_err() { return false }
    auto completed# = write.unwrap()
    auto complete = completed.complete
    auto _bytes = completed#.take_buffer()
    return complete
}

fn pipeline_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }
    auto request = read_tcp_async(stream).await
    if request.is_err() { stream#.close(); return 2 }
    // One read must observe both command frames written by the pipeline.
    if request.unwrap().len() < 20:usize { stream#.close(); return 3 }
    if !write_tcp_async(stream, "+PONG\r\n:2\r\n").await { stream#.close(); return 4 }
    auto serial = read_tcp_async(stream).await
    if serial.is_err() { stream#.close(); return 5 }
    if !write_tcp_async(stream, "+OK\r\n").await { stream#.close(); return 6 }
    stream#.close()
    return 0
}

fn pipeline_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto connected = RedisClient::connect_async(cede address, 1000:i32).await
    if connected.is_err() { return 1 }
    auto client# = connected.unwrap()
    auto pipeline# = RedisPipeline::new()
    pipeline#.push(cede RedisCommand::new("PING"))
    pipeline#.push(cede RedisCommand::new("INCR"))
    auto replies = client#.execute_pipeline_async(cede pipeline).await
    if replies.is_err() { client#.close(); return 2 }
    auto values = replies.unwrap()
    if values.len() != 2:usize { client#.close(); return 3 }
    match values.get(0:usize) {
        auto RedisValue::SimpleString(&text) => if !text.as_str().equals("PONG") { client#.close(); return 4 }
        _ => { client#.close(); return 4 }
    }
    match values.get(1:usize) {
        auto RedisValue::Integer(value) => if value != 2:i64 { client#.close(); return 5 }
        _ => { client#.close(); return 5 }
    }
    auto serial = client#.execute_async(cede RedisCommand::new("PING")).await
    if serial.is_err() { client#.close(); return 6 }
    match serial.unwrap() {
        auto RedisValue::SimpleString('text) => if !'text.as_str().equals("OK") { client#.close(); return 7 }
        _ => { client#.close(); return 7 }
    }
    client#.close()
    return 0
}

fn tls_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto tcp# = listener#.accept_async().await
    if !tcp.is_valid() { return 1 }
    auto secured = TlsStream::accept_with_cert_file_async(tcp,
        string::from("tmp/g12_wss_cert_v1.crt"), string::from("tmp/g12_wss_cert_v1.key")).await
    if secured.is_err() { return 2 }
    auto stream# = secured.unwrap()
    if read_stream_async(stream).await.is_err() { stream#.close(); return 3 }
    if !write_stream_async(stream, "+PONG\r\n").await { stream#.close(); return 4 }
    stream#.close()
    return 0
}

fn tls_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto connected = RedisClient::connect_tls_with_ca_file_async(cede address, "localhost", "tmp/g12_wss_cert_v1.crt", 1000:i32).await
    if connected.is_err() { return 1 }
    auto client# = connected.unwrap()
    auto reply = client#.execute_async(cede RedisCommand::new("PING")).await
    if reply.is_err() { client#.close(); return 2 }
    match reply.unwrap() {
        auto RedisValue::SimpleString('text) => if !'text.as_str().equals("PONG") { client#.close(); return 3 }
        _ => { client#.close(); return 3 }
    }
    client#.close()
    return 0
}

fn main_async() -> async i32 {
    auto pipeline_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !pipeline_listener.is_valid() { return 1 }
    auto pipeline_port = pipeline_listener.local_port()
    if pipeline_port == 0:u16 { return 2 }
    auto pipeline_server = pipeline_server_async(cede pipeline_listener).start
    auto pipeline_client = pipeline_client_async(pipeline_port).start
    auto pipeline_client_status = pipeline_client.await
    auto pipeline_server_status = pipeline_server.await
    if pipeline_client_status != 0:i32 { return 20:i32 + pipeline_client_status }
    if pipeline_server_status != 0:i32 { return 40:i32 + pipeline_server_status }

    auto tls_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !tls_listener.is_valid() { return 3 }
    auto tls_port = tls_listener.local_port()
    if tls_port == 0:u16 { return 4 }
    auto tls_server = tls_server_async(cede tls_listener).start
    auto tls_client = tls_client_async(tls_port).start
    auto tls_client_status = tls_client.await
    auto tls_server_status = tls_server.await
    if tls_client_status != 0:i32 { return 60:i32 + tls_client_status }
    return tls_server_status
}

fn main() -> i32 {
    auto status = block_on(main_async())
    println("transport status {}", status)
    return status
}
