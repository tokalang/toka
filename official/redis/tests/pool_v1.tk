import official/redis::{RedisCommand, RedisPipeline, RedisPool, RedisValue}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/task::{block_on, sleep_async, task_cancel}
import std/vec::{Vec}

fn bytes_from_text(value: str) -> Vec<u8> {
    auto bytes# = Vec<u8>::with_capacity(value.len())
    auto index# = 0:usize
    loop index < value.len() {
        bytes#.push(value.byte_at(index) as u8)
        index = index + 1:usize
    }
    return bytes
}

fn read_request_async(stream#: TcpStream) -> async bool {
    auto buffer# = Vec<u8>::with_capacity(1024:usize)
    auto read = stream#.read_into_async(cede buffer, 1024:usize, 1000:i32).await
    if read.is_err() { return false }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto _buffer = received#.take_buffer()
    return count > 0:usize
}

fn write_response_async(stream#: TcpStream, response: str) -> async bool {
    auto response# = bytes_from_text(response)
    auto written = stream#.write_from_async(cede response, 1000:i32).await
    if written.is_err() { return false }
    auto completed# = written.unwrap()
    auto complete = completed.complete
    auto _buffer = completed#.take_buffer()
    return complete
}

fn is_ok(value: RedisValue) -> bool {
    match value {
        auto RedisValue::SimpleString('text) => return 'text.as_str().equals("OK")
        _ => return false
    }
}

fn wait_for_pool_async(cede pool: RedisPool) -> async i32 {
    auto pool# = cede pool
    auto acquired_outcome = pool#.acquire_async(1000:i32).await?
    if acquired_outcome.is_none() { return 0 }
    auto acquired = acquired_outcome.unwrap()
    if acquired.is_ok() {
        auto lease# = acquired.unwrap()
        lease#.close()
        return 1
    }
    auto failure = acquired.unwrap_err()
    if failure.kind.as_str().equals("pool") &&
       failure.message.as_str().equals("Redis pool acquire was canceled") {
        return 0
    }
    return 2
}

fn constructor_validation() -> i32 {
    auto invalid_address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 1:u16)
    if RedisPool::new(cede invalid_address, 100:i32, 0:usize).is_ok() { return 1 }

    auto tls_address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 1:u16)
    auto tls = RedisPool::new_tls(cede tls_address, "localhost", 100:i32, 1:usize)
    if tls.is_err() { return 2 }
    auto tls# = tls.unwrap()
    tls#.close()

    auto ca_address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 1:u16)
    auto ca = RedisPool::new_tls_with_ca_file(cede ca_address, "localhost", "test-ca.pem", 100:i32, 1:usize)
    if ca.is_err() { return 3 }
    auto ca# = ca.unwrap()
    ca#.close()
    return 0
}

fn reuse_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }
    if !read_request_async(stream).await { stream#.close(); return 2 }
    if !write_response_async(stream, "+OK\r\n").await { stream#.close(); return 3 }
    if !read_request_async(stream).await { stream#.close(); return 4 }
    if !write_response_async(stream, "+OK\r\n").await { stream#.close(); return 5 }
    stream#.close()
    return 0
}

fn reuse_client_async(port: u16) -> async i32 {
    sleep_async(10:i32).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto created = RedisPool::new(cede address, 1000:i32, 1:usize)
    if created.is_err() { return 1 }
    auto pool# = created.unwrap()
    {
        auto acquired = pool#.try_acquire_async().await
        if acquired.is_err() { return 2 }
        auto lease# = acquired.unwrap()
        auto exhausted = pool#.try_acquire_async().await
        if exhausted.is_ok() { return 3 }
        if !exhausted.unwrap_err().kind.as_str().equals("pool") { return 3 }
        auto timed_out = pool#.acquire_async(5:i32).await
        if timed_out.is_ok() { return 4 }
        if !timed_out.unwrap_err().message.as_str().equals("Redis pool acquire timed out") { return 4 }
        auto waiter = wait_for_pool_async(cede pool#.clone()).start
        sleep_async(5:i32).await
        task_cancel<i32>(waiter)
        if waiter.await != 0:i32 { return 5 }
        auto reply = lease#.execute_async(cede RedisCommand::new("PING")).await
        if reply.is_err() { return 6 }
        if !is_ok(reply.unwrap()) { return 6 }
    }
    auto reused = pool#.acquire_async(100:i32).await
    if reused.is_err() { pool#.close(); return 7 }
    auto reused# = reused.unwrap()
    auto reply = reused#.execute_async(cede RedisCommand::new("PING")).await
    if reply.is_err() { reused#.close(); pool#.close(); return 8 }
    if !is_ok(reply.unwrap()) { reused#.close(); pool#.close(); return 8 }
    pool#.close()
    return 0
}

fn poison_server_async(cede listener: TcpListener, malformed: bool) -> async i32 {
    auto listener# = cede listener
    auto first# = listener#.accept_async().await
    if !first.is_valid() { return 1 }
    if !read_request_async(first).await { first#.close(); return 2 }
    if malformed {
        if !write_response_async(first, "?bad\r\n").await { first#.close(); return 3 }
    } else {
        if !write_response_async(first, "+OK\r\n:2\r\n").await { first#.close(); return 3 }
    }
    first#.close()

    auto second# = listener#.accept_async().await
    if !second.is_valid() { return 4 }
    if !read_request_async(second).await { second#.close(); return 5 }
    if !write_response_async(second, "+OK\r\n").await { second#.close(); return 6 }
    second#.close()
    return 0
}

fn poison_client_async(port: u16, malformed: bool) -> async i32 {
    sleep_async(10:i32).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto created = RedisPool::new(cede address, 1000:i32, 1:usize)
    if created.is_err() { return 1 }
    auto pool# = created.unwrap()
    {
        auto acquired = pool#.acquire_async(100:i32).await
        if acquired.is_err() { return 2 }
        auto lease# = acquired.unwrap()
        if malformed {
            auto reply = lease#.execute_async(cede RedisCommand::new("PING")).await
            if reply.is_ok() { return 3 }
        } else {
            auto pipeline# = RedisPipeline::new()
            pipeline#.push(cede RedisCommand::new("PING"))
            auto replies = lease#.execute_pipeline_async(cede pipeline).await
            if replies.is_ok() { return 4 }
        }
        if !lease#.is_closed() { return 5 }
    }
    auto replacement = pool#.acquire_async(100:i32).await
    if replacement.is_err() { pool#.close(); return 6 }
    auto replacement# = replacement.unwrap()
    auto reply = replacement#.execute_async(cede RedisCommand::new("PING")).await
    if reply.is_err() { replacement#.close(); pool#.close(); return 7 }
    if !is_ok(reply.unwrap()) { replacement#.close(); pool#.close(); return 7 }
    pool#.close()
    return 0
}

fn run_reuse_async() -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() { return 1 }
    auto port = listener.local_port()
    if port == 0:u16 { return 2 }
    auto server = reuse_server_async(cede listener).start
    auto client = reuse_client_async(port).start
    auto client_status = client.await
    auto server_status = server.await
    if client_status != 0:i32 { return 20:i32 + client_status }
    return server_status
}

fn run_poison_async(malformed: bool) -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() { return 1 }
    auto port = listener.local_port()
    if port == 0:u16 { return 2 }
    auto server = poison_server_async(cede listener, malformed).start
    auto client = poison_client_async(port, malformed).start
    auto client_status = client.await
    auto server_status = server.await
    if client_status != 0:i32 { return 20:i32 + client_status }
    return server_status
}

fn main_async() -> async i32 {
    auto reuse = run_reuse_async().await
    if reuse != 0:i32 { return reuse }
    auto protocol = run_poison_async(true).await
    if protocol != 0:i32 { return 40:i32 + protocol }
    auto pipeline = run_poison_async(false).await
    if pipeline != 0:i32 { return 80:i32 + pipeline }
    return 0
}

fn main() -> i32 {
    if constructor_validation() != 0:i32 { return 1 }
    return block_on(main_async())
}
