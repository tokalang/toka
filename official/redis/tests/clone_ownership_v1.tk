import official/redis::{RedisCommand, RedisValue}
import std/vec::{Vec}

fn main() -> i32 {
    auto command# = RedisCommand::new("SET")
    command#.arg_text("toka:clone")
    command#.arg_text("value")
    auto copied_command = command#.clone()
    if copied_command.into_wire().is_err() { return 1 }

    auto values# = Vec<RedisValue>::new()
    values#.push(cede RedisValue::SimpleString(string::from("nested")))
    auto original = RedisValue::Array(cede values)
    auto copied_value = original.clone()
    if copied_value.array_at(0:usize).is_none() { return 2 }

    return 0
}
