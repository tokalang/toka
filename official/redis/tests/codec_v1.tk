import official/redis::{RedisCommand, RedisDecode, RedisError, RedisValue, decode_one, package_name}
import std/bytes::{Bytes}
import std/vec::{Vec}

fn wire(input: str) -> Vec<u8> {
    auto bytes# = Vec<u8>::with_capacity(input.len())
    auto index#: usize = 0
    loop index < input.len() {
        bytes#.push(input.byte_at(index) as u8)
        index = index + 1:usize
    }
    return bytes
}

fn same_wire(left: Vec<u8>, right: str) -> bool {
    if left.len() != right.len() { return false }
    auto index#: usize = 0
    loop index < left.len() {
        if left.get(index) != right.byte_at(index) as u8 { return false }
        index = index + 1:usize
    }
    return true
}

fn decode(input: str) -> Result<RedisDecode, RedisError> {
    auto bytes = wire(input)
    return decode_one(bytes)
}

fn test_command_encoding() {
    auto command# = RedisCommand::new("SET")
    command#.arg_text("a")
    auto raw# = Vec<u8>::new()
    raw#.push('b' as u8)
    raw#.push(0:u8)
    raw#.push('c' as u8)
    command#.arg_bytes(cede Bytes::from_vec(cede raw))
    auto encoded = command.into_wire().unwrap()
    assert(same_wire(encoded, "*3\r\n$3\r\nSET\r\n$1\r\na\r\n$3\r\nb\x00c\r\n"),
           "command encoding must preserve RESP lengths and binary arguments")
}

fn test_scalar_replies() {
    match decode("+OK\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::SimpleString(&value) => assert(value.equals("OK"), "simple string")
            _ => assert(false, "expected simple string")
        }
        _ => assert(false, "simple string must complete")
    }
    match decode(":-42\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::Integer(value) => assert(value == -42:i64, "integer")
            _ => assert(false, "expected integer")
        }
        _ => assert(false, "integer must complete")
    }
    match decode("-ERR denied\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::Error(&value) => assert(value.equals("ERR denied"), "server error reply")
            _ => assert(false, "expected server error value")
        }
        _ => assert(false, "error reply must complete")
    }
}

fn test_bulk_and_incremental_decode() {
    auto fragmented# = wire("$5\r\nhel")
    match decode_one(fragmented).unwrap() {
        auto RedisDecode::NeedMore() => {}
        _ => assert(false, "fragmented bulk payload must request more bytes")
    }
    fragmented#.push('l' as u8)
    fragmented#.push('o' as u8)
    fragmented#.push('\r' as u8)
    fragmented#.push('\n' as u8)
    match decode_one(fragmented).unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::Bulk(&value) => {
                auto view = value.as_slice()
                assert(view.len() == 5:usize && (view.at(0:usize).unwrap() as u8) == 'h' as u8 &&
                       (view.at(4:usize).unwrap() as u8) == 'o' as u8,
                       "completed fragmented bulk must preserve its bytes")
            }
            _ => assert(false, "expected completed bulk value")
        }
        _ => assert(false, "completed fragmented bulk must decode")
    }
    match decode("$3\r\na\x00b\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::Bulk(&value) => {
                auto view = value.as_slice()
                assert(view.len() == 3:usize && (view.at(0:usize).unwrap() as u8) == 'a' as u8 &&
                       (view.at(1:usize).unwrap() as u8) == 0:u8 && (view.at(2:usize).unwrap() as u8) == 'b' as u8,
                       "bulk reply must own binary bytes")
            }
            _ => assert(false, "expected bulk value")
        }
        _ => assert(false, "bulk reply must complete")
    }
    match decode("$-1\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => match reply.value {
            auto RedisValue::Null() => {}
            _ => assert(false, "null bulk")
        }
        _ => assert(false, "null bulk must complete")
    }
}

fn test_nested_and_errors() {
    match decode("*2\r\n:1\r\n*1\r\n+OK\r\n").unwrap() {
        auto RedisDecode::Complete(&reply) => {
            assert(reply.consumed == 17:usize, "nested aggregate consumed count")
            auto root = reply.value.clone()
            assert(root.array_len().unwrap() == 2:usize, "outer array length")
            assert(root.array_at(0:usize).unwrap().as_integer().unwrap() == 1:i64, "outer integer")
            assert(root.array_at(1:usize).unwrap().array_at(0:usize).unwrap().as_text().unwrap().equals("OK"),
                   "nested simple string")
        }
        _ => assert(false, "nested aggregate must complete")
    }
    auto malformed = decode("$x\r\n")
    assert(malformed.is_err(), "invalid bulk length must be rejected")
    auto unknown = decode("?x\r\n")
    assert(unknown.is_err(), "unknown prefix must be rejected")
    auto oversized_bulk = decode("$67108865\r\n")
    assert(oversized_bulk.is_err(), "bulk length limit must be enforced before payload allocation")
    auto oversized_array = decode("*1000001\r\n")
    assert(oversized_array.is_err(), "aggregate item limit must be enforced before decoding children")
}

fn main() -> i32 {
    assert(package_name().equals("redis"), "public package name")
    test_command_encoding()
    test_scalar_replies()
    test_bulk_and_incremental_decode()
    test_nested_and_errors()
    return 0
}
