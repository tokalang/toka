pub const AI_CONTRACT = (
    schema = "toka-official-package-v1",
    summary = "Bounded PostgreSQL v3 wire codec, TLS/SCRAM startup client, serial simple and extended queries, transactions, and a bounded pool.",
    capabilities = ("encode startup, simple-query, Parse/Bind/Execute/Sync, and statement-close messages", "incrementally decode bounded PostgreSQL backend frames", "preserve binary row values, binary parameters, and server SQLSTATE", "establish one authenticated serial session with verified TLS by default or a supplied CA file", "execute bounded serial simple and prepared queries through ReadyForQuery", "own a transaction through commit or rollback", "lease one serial connection from a bounded pool, including one-shot parameterized queries and pooled transactions", "derive and verify ASCII-profile SCRAM-SHA-256 messages"),
    non_goals = ("full SASLprep/Unicode credential normalization", "COPY", "cursor pagination", "pool-side prepared-statement cache"),
    safety = ("all frame lengths and row fields are validated before allocation; every query caller sets result-set, row, and byte limits; decoded binary data and binary parameters own their bytes; server ErrorResponse is drained to ReadyForQuery; I/O, cancellation, limit, and protocol failures poison a client; transactions own their client; an active pooled transaction closes on drop rather than returning an unresolved session; pool leases never share a socket; verified TLS and SCRAM are defaults; plaintext or unverified TLS require an explicit local/test constructor; no package-native dependency"),
    qualification = ("../../build/bin/tokac -I ../../lib -I lib tests/protocol_v1.tk -o /tmp/postgres_protocol_v1 && /tmp/postgres_protocol_v1; ../../build/bin/tokac -I ../../lib -I lib tests/client_v1.tk -o /tmp/postgres_client_v1 && /tmp/postgres_client_v1; ../../build/bin/tokac -I ../../lib -I lib tests/query_v1.tk -o /tmp/postgres_query_v1 && /tmp/postgres_query_v1; ../../build/bin/tokac -I ../../lib -I lib tests/extended_v1.tk -o /tmp/postgres_extended_v1 && /tmp/postgres_extended_v1; ../../build/bin/tokac -I ../../lib -I lib tests/pool_v1.tk -o /tmp/postgres_pool_v1 && /tmp/postgres_pool_v1; ../../build/bin/tokac -I ../../lib -I lib tests/pool_extended_v1.tk -o /tmp/postgres_pool_extended_v1 && /tmp/postgres_pool_extended_v1; python3 tests/qualify_package.py")
)
