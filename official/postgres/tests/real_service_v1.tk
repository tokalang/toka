// Contract exercised by tools/scripts/qualify_data_access_real.py against a
// loopback PostgreSQL service configured for TLS and SCRAM-SHA-256.

import official/postgres::{PostgresConfig, PostgresError, PostgresParam, PostgresPool, PostgresQueryLimits, PostgresQueryResult}
import core/option::{Option}
import core/result::{Result}
import std/bytes::{Bytes}
import std/env::{args_count, get_arg}
import std/net::{Ipv4Addr, SocketAddrV4}
import std/task::{block_on, sleep_async, task_cancel}
import std/vec::{Vec}
import stdx/encoding/hex

fn limits() -> PostgresQueryLimits {
    return PostgresQueryLimits::new(2:usize, 4:usize, 256:usize).unwrap()
}

fn text_types() -> Vec<u32> {
    auto types# = Vec<u32>::new()
    types#.push(25:u32)
    return types
}

fn text_params(value: str) -> Vec<PostgresParam> {
    auto params# = Vec<PostgresParam>::new()
    params#.push(cede PostgresParam::Text(string::from(value)))
    return params
}

fn session_name_is_set(cede result_sets: Vec<PostgresQueryResult>) -> bool {
    auto result_sets# = cede result_sets
    if result_sets.len() != 1:usize { return false }
    auto *result = result_sets.get_ref(0:usize)
    if result.rows.len() != 1:usize { return false }
    auto *row = result.rows.get_ref(0:usize)
    if row.len() != 1:usize { return false }
    auto *cell = row.get_ref(0:usize)
    match cell {
        auto Option<Bytes>::Some(&value) => return hex::encode(value.as_slice()).equals("746f6b612d636f6d7061742d7631")
        _ => return false
    }
}

fn wait_for_pool_async(cede pool: PostgresPool) -> async i32 {
    auto pool# = cede pool
    auto acquired = pool#.acquire_async(1000:i32).await
    if acquired.is_ok() {
        auto lease# = acquired.unwrap()
        lease#.close()
        return 1
    }
    auto failure = acquired.unwrap_err()
    if !failure.kind.as_str().equals("pool") ||
       !failure.message.as_str().equals("PostgreSQL pool acquire was canceled") {
        return 2
    }
    return 0
}

fn run_async(port: u16, ca_file: str) -> async i32 {
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::secure_with_ca_file(address, "localhost", "toka", "toka", "toka-password", ca_file)
    if configured.is_err() { return 1 }
    auto created = PostgresPool::new(cede configured.unwrap(), 1:usize)
    if created.is_err() { return 2 }
    auto pool# = created.unwrap()

    {
        auto acquired = pool#.acquire_async(1000:i32).await
        if acquired.is_err() { return 3 }
        auto lease# = acquired.unwrap()
        auto parameterized = lease#.query_params_async("SELECT $1::text", cede text_types(), cede text_params("bound"), limits()).await
        match cede parameterized {
            auto Result<Vec<PostgresQueryResult>, PostgresError>::Ok('values) => if 'values.len() != 1:usize { return 4 }
            _ => return 4
        }
        auto named = lease#.simple_query_async("SET application_name = 'toka-compat-v1'", limits()).await
        if named.is_err() { return 5 }

        auto waiter = wait_for_pool_async(cede pool#.clone()).start
        sleep_async(5:i32).await
        task_cancel<i32>(waiter)
        if waiter.await != 0:i32 { return 6 }
    }

    {
        auto acquired = pool#.acquire_async(1000:i32).await
        if acquired.is_err() { pool#.close(); return 7 }
        auto lease# = acquired.unwrap()
        auto show_name = lease#.simple_query_async("SHOW application_name", limits()).await
        match cede show_name {
            auto Result<Vec<PostgresQueryResult>, PostgresError>::Ok('values) => if !session_name_is_set(cede 'values) { pool#.close(); return 8 }
            _ => { pool#.close(); return 8 }
        }
        auto begun = lease#.begin_transaction_async().await
        if begun.is_err() { pool#.close(); return 9 }
        auto transaction# = begun.unwrap()
        auto in_transaction = transaction#.query_params_async("SELECT $1::text", cede text_types(), cede text_params("transaction"), limits()).await
        match cede in_transaction {
            auto Result<Vec<PostgresQueryResult>, PostgresError>::Ok('values) => if 'values.len() != 1:usize { pool#.close(); return 10 }
            _ => { pool#.close(); return 10 }
        }
        if transaction#.commit_async().await.is_err() { pool#.close(); return 11 }
    }

    {
        auto acquired = pool#.acquire_async(1000:i32).await
        if acquired.is_err() { pool#.close(); return 12 }
        auto lease# = acquired.unwrap()
        auto server_error = lease#.simple_query_async("SELECT 1 / 0", limits()).await
        match cede server_error {
            auto Result<Vec<PostgresQueryResult>, PostgresError>::Err('failure) => {
                if !'failure.kind.as_str().equals("server") || !'failure.sqlstate.as_str().equals("22012") {
                    pool#.close()
                    return 13
                }
            }
            _ => { pool#.close(); return 13 }
        }
        auto after_error = lease#.simple_query_async("SELECT 1", limits()).await
        match cede after_error {
            auto Result<Vec<PostgresQueryResult>, PostgresError>::Ok('values) => if 'values.len() != 1:usize { pool#.close(); return 14 }
            _ => { pool#.close(); return 14 }
        }
    }

    pool#.close()
    auto closed = pool#.try_acquire_async().await
    match cede closed {
        auto Result<_, PostgresError>::Err('failure) => if !'failure.kind.as_str().equals("pool") { return 15 }
        _ => return 15
    }
    return 0
}

fn main() -> i32 {
    if args_count() != 3:i32 { return 64 }
    auto parsed = get_arg(1:i32).to_i32()
    if parsed.is_none() { return 65 }
    auto port = parsed.unwrap()
    if port <= 0:i32 || port > 65535:i32 { return 66 }
    return block_on(run_async(port as u16, get_arg(2:i32).as_str()))
}
