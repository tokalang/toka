import official/postgres::{PostgresAuthPolicy, PostgresClient, PostgresConfig, scram_client_final}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/task::{block_on, sleep_async}
import std/vec::{Vec}
import stdx/net/stream::{AsyncStream}
import stdx/net/tls::{TlsStream}
import stdx/encoding/base64
import std/io::println

fn append_u32(out#: Vec<u8>, value: u32) {
    out#.push((value >> 24:u32) as u8)
    out#.push((value >> 16:u32) as u8)
    out#.push((value >> 8:u32) as u8)
    out#.push(value as u8)
}

fn append_frame(out#: Vec<u8>, tag: u8, cede body: Vec<u8>) {
    auto owned# = cede body
    out#.push(tag)
    append_u32(out, (owned.len() + 4:usize) as u32)
    auto index# = 0:usize
    loop index < owned.len() {
        out#.push(owned.get(index))
        index = index + 1:usize
    }
}

fn read_exact_tcp_async(stream#: TcpStream, length: usize) -> async bool {
    auto output# = Vec<u8>::with_capacity(length)
    loop output.len() < length {
        auto chunk# = Vec<u8>::with_capacity(length - output.len())
        auto read = stream#.read_into_async(cede chunk, length - output.len(), 1000:i32).await
        if read.is_err() { return false }
        auto received# = read.unwrap()
        auto count = received.bytes_read
        auto returned# = received#.take_buffer()
        if count == 0:usize { return false }
        auto index# = 0:usize
        loop index < count {
            output#.push(returned#.get(index))
            index = index + 1:usize
        }
    }
    return true
}

fn read_startup_async(stream#: AsyncStream) -> async bool {
    auto chunk# = Vec<u8>::with_capacity(256:usize)
    auto read = stream#.read_into_async(cede chunk, 256:usize, 1000:i32).await
    if read.is_err() { return false }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto _returned = received#.take_buffer()
    return count >= 8:usize
}

fn read_message_async(stream#: AsyncStream) -> async Result<Vec<u8>, string> {
    auto chunk# = Vec<u8>::with_capacity(512:usize)
    auto read = stream#.read_into_async(cede chunk, 512:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _returned = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto returned = received#.take_buffer()
    if count == 0:usize { return Result<Vec<u8>, string>::Err(string::from("unexpected EOF")) }
    return Result<Vec<u8>, string>::Ok(cede returned)
}

fn scram_initial_text(packet: Vec<u8>) -> Result<string, string> {
    if packet.len() < 10:usize || packet.get(0:usize) != 'p' as u8 {
        return Result<string, string>::Err(string::from("invalid SASL initial packet"))
    }
    auto cursor# = 5:usize
    loop cursor < packet.len() && packet.get(cursor) != 0:u8 {
        cursor = cursor + 1:usize
    }
    if cursor + 5:usize > packet.len() { return Result<string, string>::Err(string::from("truncated SASL mechanism")) }
    cursor = cursor + 5:usize
    auto text# = string::from("")
    loop cursor < packet.len() {
        text#.push_byte_raw(packet.get(cursor))
        cursor = cursor + 1:usize
    }
    if !text.starts_with("n,,n=app,r=") { return Result<string, string>::Err(string::from("unexpected SCRAM client-first")) }
    return Result<string, string>::Ok(cede text)
}

fn write_async(stream#: AsyncStream, cede bytes: Vec<u8>) -> async bool {
    auto written = stream#.write_from_async(cede bytes, 1000:i32).await
    if written.is_err() { return false }
    auto result# = written.unwrap()
    auto complete = result.complete
    auto _returned = result#.take_buffer()
    return complete
}

fn tls_trust_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto tcp# = listener#.accept_async().await
    if !tcp.is_valid() { return 1 }
    if !read_exact_tcp_async(tcp, 8:usize).await { tcp#.close(); return 2 }
    auto reply# = Vec<u8>::new()
    reply#.push('S' as u8)
    auto written = tcp#.write_from_async(cede reply, 1000:i32).await
    if written.is_err() { tcp#.close(); return 3 }
    auto written_result# = written.unwrap()
    auto write_complete = written_result.complete
    auto _reply = written_result#.take_buffer()
    if !write_complete { tcp#.close(); return 4 }
    auto tls = TlsStream::accept_async(tcp).await
    if tls.is_err() { return 5 }
    auto stream# = tls.unwrap()
    if !read_startup_async(stream).await { stream#.close(); return 6 }

    auto output# = Vec<u8>::new()
    auto auth# = Vec<u8>::new()
    append_u32(auth, 0:u32)
    append_frame(output, 'R' as u8, cede auth)
    auto ready# = Vec<u8>::new()
    ready#.push('I' as u8)
    append_frame(output, 'Z' as u8, cede ready)
    if !write_async(stream, cede output).await { stream#.close(); return 7 }
    stream#.close()
    return 0
}

fn tls_trust_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto config = PostgresConfig::insecure_tls_for_test(address, "localhost", "app", "notes")
    if config.is_err() { return 1 }
    auto client = PostgresClient::connect_async(cede config.unwrap()).await
    if client.is_err() { return 2 }
    auto connection# = client.unwrap()
    if connection.is_closed() { return 3 }
    connection#.close()
    return 0
}

fn tls_refusal_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto tcp# = listener#.accept_async().await
    if !tcp.is_valid() { return 1 }
    if !read_exact_tcp_async(tcp, 8:usize).await { tcp#.close(); return 2 }
    auto reply# = Vec<u8>::new()
    reply#.push('N' as u8)
    auto written = tcp#.write_from_async(cede reply, 1000:i32).await
    if written.is_err() { tcp#.close(); return 3 }
    auto result# = written.unwrap()
    auto complete = result.complete
    auto _reply = result#.take_buffer()
    tcp#.close()
    if !complete { return 4 }
    return 0
}

fn tls_refusal_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto config = PostgresConfig::secure(address, "localhost", "app", "notes", "pencil")
    if config.is_err() { return 1 }
    auto client = PostgresClient::connect_async(cede config.unwrap()).await
    if client.is_ok() { return 2 }
    return 0
}

fn tls_scram_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto tcp# = listener#.accept_async().await
    if !tcp.is_valid() { return 1 }
    if !read_exact_tcp_async(tcp, 8:usize).await { tcp#.close(); return 2 }
    auto reply# = Vec<u8>::new()
    reply#.push('S' as u8)
    auto upgrade = tcp#.write_from_async(cede reply, 1000:i32).await
    if upgrade.is_err() { tcp#.close(); return 3 }
    auto upgraded# = upgrade.unwrap()
    auto upgrade_complete = upgraded.complete
    auto _reply = upgraded#.take_buffer()
    if !upgrade_complete { tcp#.close(); return 4 }
    auto tls = TlsStream::accept_async(tcp).await
    if tls.is_err() { return 5 }
    auto stream# = tls.unwrap()
    if !read_startup_async(stream).await { stream#.close(); return 6 }

    auto offered# = Vec<u8>::new()
    append_u32(offered, 10:u32)
    auto mechanism = string::from("SCRAM-SHA-256")
    auto index# = 0:usize
    loop index < mechanism.len() { offered#.push(mechanism.byte_at(index) as u8); index = index + 1:usize }
    offered#.push(0:u8)
    offered#.push(0:u8)
    auto auth_offer# = Vec<u8>::new()
    append_frame(auth_offer, 'R' as u8, cede offered)
    if !write_async(stream, cede auth_offer).await { stream#.close(); return 7 }

    auto client_initial = read_message_async(stream).await
    if client_initial.is_err() { stream#.close(); return 8 }
    auto first_message = scram_initial_text(client_initial.unwrap())
    if first_message.is_err() { stream#.close(); return 9 }
    auto client_first = first_message.unwrap()
    auto bare = client_first.substr(3:usize, client_first.len() - 3:usize)
    auto nonce = bare.substr(8:usize, bare.len() - 8:usize)
    auto server_first# = string::from("r=")
    server_first#.push_str(nonce)
    server_first#.push_str("server,s=QSXCR+Q6sek8bf92,i=4096")
    auto expected = scram_client_final("pencil", bare, server_first)
    if expected.is_err() { stream#.close(); return 10 }
    auto expected_final = expected.unwrap()

    auto continue_body# = Vec<u8>::new()
    append_u32(continue_body, 11:u32)
    index = 0:usize
    loop index < server_first.len() { continue_body#.push(server_first.byte_at(index) as u8); index = index + 1:usize }
    auto continue_frame# = Vec<u8>::new()
    append_frame(continue_frame, 'R' as u8, cede continue_body)
    if !write_async(stream, cede continue_frame).await { stream#.close(); return 11 }
    auto client_final = read_message_async(stream).await
    if client_final.is_err() { stream#.close(); return 12 }

    auto output# = Vec<u8>::new()
    auto final_body# = Vec<u8>::new()
    append_u32(final_body, 12:u32)
    auto server_final# = string::from("v=")
    server_final#.push_str(base64::encode(expected_final.expected_server_signature.as_slice()).as_str())
    index = 0:usize
    loop index < server_final.len() { final_body#.push(server_final.byte_at(index) as u8); index = index + 1:usize }
    append_frame(output, 'R' as u8, cede final_body)
    auto auth_ok# = Vec<u8>::new()
    append_u32(auth_ok, 0:u32)
    append_frame(output, 'R' as u8, cede auth_ok)
    auto ready# = Vec<u8>::new()
    ready#.push('I' as u8)
    append_frame(output, 'Z' as u8, cede ready)
    if !write_async(stream, cede output).await { stream#.close(); return 13 }
    stream#.close()
    return 0
}

fn tls_scram_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::insecure_tls_for_test(address, "localhost", "app", "notes")
    if configured.is_err() { return 1 }
    auto config# = configured.unwrap()
    config.password = string::from("pencil")
    config.auth_policy = PostgresAuthPolicy::ScramOnly()
    auto client = PostgresClient::connect_async(cede config).await
    if client.is_err() { return 2 }
    auto connection# = client.unwrap()
    connection#.close()
    return 0
}

pub fn main_async() -> async i32 {
    auto first_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !first_listener.is_valid() { return 1 }
    auto first_port = first_listener.local_port()
    if first_port == 0:u16 { return 2 }
    auto server = tls_trust_server_async(cede first_listener).start
    auto client = tls_trust_client_async(first_port).start
    if server.await != 0:i32 { return 3 }
    if client.await != 0:i32 { return 4 }

    auto second_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !second_listener.is_valid() { return 5 }
    auto second_port = second_listener.local_port()
    if second_port == 0:u16 { return 6 }
    auto refusing_server = tls_refusal_server_async(cede second_listener).start
    auto refusing_client = tls_refusal_client_async(second_port).start
    if refusing_server.await != 0:i32 { return 7 }
    if refusing_client.await != 0:i32 { return 8 }

    auto third_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !third_listener.is_valid() { return 9 }
    auto third_port = third_listener.local_port()
    if third_port == 0:u16 { return 10 }
    auto scram_server = tls_scram_server_async(cede third_listener).start
    auto scram_client = tls_scram_client_async(third_port).start
    if scram_server.await != 0:i32 { return 11 }
    if scram_client.await != 0:i32 { return 12 }
    return 0
}

fn main() -> i32 {
    auto status = block_on(main_async())
    println("client status {}", status)
    return status
}
