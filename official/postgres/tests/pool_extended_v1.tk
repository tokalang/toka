import official/postgres::{PostgresConfig, PostgresParam, PostgresPool, PostgresQueryLimits}
import core/result::{Result}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/task::{block_on, sleep_async}
import std/vec::{Vec}

fn append_u16(out#: Vec<u8>, value: u16) {
    out#.push((value >> 8:u16) as u8)
    out#.push(value as u8)
}

fn append_u32(out#: Vec<u8>, value: u32) {
    out#.push((value >> 24:u32) as u8)
    out#.push((value >> 16:u32) as u8)
    out#.push((value >> 8:u32) as u8)
    out#.push(value as u8)
}

fn append_text(out#: Vec<u8>, value: str) {
    auto index# = 0:usize
    loop index < value.len() {
        out#.push(value.byte_at(index) as u8)
        index += 1
    }
}

fn append_cstring(out#: Vec<u8>, value: str) {
    append_text(out, value)
    out#.push(0:u8)
}

fn append_frame(out#: Vec<u8>, tag: u8, cede body: Vec<u8>) {
    auto body# = cede body
    out#.push(tag)
    append_u32(out, (body.len() + 4:usize) as u32)
    auto index# = 0:usize
    loop index < body.len() {
        out#.push(body.get(index))
        index += 1
    }
}

fn append_empty(out#: Vec<u8>, tag: u8) {
    append_frame(out, tag, cede Vec<u8>::new())
}

fn append_ready(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    body#.push('I' as u8)
    append_frame(out, 'Z' as u8, cede body)
}

fn append_command(out#: Vec<u8>, tag: str) {
    auto body# = Vec<u8>::new()
    append_cstring(body, tag)
    append_frame(out, 'C' as u8, cede body)
}

fn append_prepared(out#: Vec<u8>) {
    append_empty(out, '1' as u8)
    auto parameters# = Vec<u8>::new()
    append_u16(parameters, 1:u16)
    append_u32(parameters, 25:u32)
    append_frame(out, 't' as u8, cede parameters)
    append_empty(out, 'n' as u8)
    append_ready(out)
}

fn append_executed(out#: Vec<u8>) {
    append_empty(out, '2' as u8)
    append_command(out, "SELECT 1")
    append_ready(out)
}

fn append_closed(out#: Vec<u8>) {
    append_empty(out, '3' as u8)
    append_ready(out)
}

fn read_async(stream#: TcpStream) -> async Result<Vec<u8>, string> {
    auto buffer# = Vec<u8>::with_capacity(1024:usize)
    auto read = stream#.read_into_async(cede buffer, 1024:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _buffer = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto bytes = received#.take_buffer()
    if count == 0:usize { return Result<Vec<u8>, string>::Err(string::from("unexpected EOF")) }
    return Result<Vec<u8>, string>::Ok(cede bytes)
}

fn write_async(stream#: TcpStream, cede bytes: Vec<u8>) -> async bool {
    auto write = stream#.write_from_async(cede bytes, 1000:i32).await
    if write.is_err() { return false }
    auto completed# = write.unwrap()
    auto complete = completed.complete
    auto _bytes = completed#.take_buffer()
    return complete
}

fn has_tag(packet: Vec<u8>, tag: u8) -> bool {
    auto index# = 0:usize
    loop index < packet.len() {
        if packet.get(index) == tag { return true }
        index += 1
    }
    return false
}

fn expect_async(stream#: TcpStream, tag: u8) -> async bool {
    auto packet = read_async(stream).await
    if packet.is_err() { return false }
    return has_tag(packet.unwrap(), tag)
}

fn server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }
    if read_async(stream).await.is_err() { stream#.close(); return 2 }
    auto hello# = Vec<u8>::new()
    auto authentication# = Vec<u8>::new()
    append_u32(authentication, 0:u32)
    append_frame(hello, 'R' as u8, cede authentication)
    append_ready(hello)
    if !write_async(stream, cede hello).await { stream#.close(); return 3 }

    // Lease parameterized query, then transaction parameterized query.
    auto step# = 0:i32
    loop step < 2:i32 {
        if !expect_async(stream, 'P' as u8).await { stream#.close(); return 4 + step * 4:i32 }
        auto prepared# = Vec<u8>::new()
        append_prepared(prepared)
        if !write_async(stream, cede prepared).await { stream#.close(); return 5 + step * 4:i32 }
        if !expect_async(stream, 'B' as u8).await { stream#.close(); return 6 + step * 4:i32 }
        auto executed# = Vec<u8>::new()
        append_executed(executed)
        if !write_async(stream, cede executed).await { stream#.close(); return 7 + step * 4:i32 }
        if !expect_async(stream, 'C' as u8).await { stream#.close(); return 8 + step * 4:i32 }
        auto closed# = Vec<u8>::new()
        append_closed(closed)
        if !write_async(stream, cede closed).await { stream#.close(); return 9 + step * 4:i32 }
        if step == 0:i32 {
            if !expect_async(stream, 'Q' as u8).await { stream#.close(); return 20 }
            auto began# = Vec<u8>::new()
            append_command(began, "BEGIN")
            append_ready(began)
            if !write_async(stream, cede began).await { stream#.close(); return 21 }
        }
        step += 1
    }

    if !expect_async(stream, 'Q' as u8).await { stream#.close(); return 30 }
    auto committed# = Vec<u8>::new()
    append_command(committed, "COMMIT")
    append_ready(committed)
    if !write_async(stream, cede committed).await { stream#.close(); return 31 }
    if !expect_async(stream, 'Q' as u8).await { stream#.close(); return 32 }
    auto reused# = Vec<u8>::new()
    append_command(reused, "SELECT 1")
    append_ready(reused)
    if !write_async(stream, cede reused).await { stream#.close(); return 33 }
    stream#.close()
    return 0
}

fn types() -> Vec<u32> {
    auto values# = Vec<u32>::new()
    values#.push(25:u32)
    return values
}

fn params() -> Vec<PostgresParam> {
    auto values# = Vec<PostgresParam>::new()
    values#.push(cede PostgresParam::Text(string::from("bound")))
    return values
}

fn client_async(port: u16) -> async i32 {
    sleep_async(10:i32).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::trusted_local(address, "app", "notes")
    if configured.is_err() { return 1 }
    auto created = PostgresPool::new(cede configured.unwrap(), 1:usize)
    if created.is_err() { return 2 }
    auto pool# = created.unwrap()
    {
        auto acquired = pool#.acquire_async(100:i32).await
        if acquired.is_err() { return 3 }
        auto lease# = acquired.unwrap()
        auto result = lease#.query_params_async("SELECT $1", cede types(), cede params(), PostgresQueryLimits::new(1:usize, 0:usize, 64:usize).unwrap()).await
        if result.is_err() { return 4 }
        if result.unwrap().len() != 1:usize { return 4 }
        auto begun = lease#.begin_transaction_async().await
        if begun.is_err() { return 5 }
        auto transaction# = begun.unwrap()
        if !transaction.is_active() { return 6 }
        auto inside = transaction#.query_params_async("SELECT $1", cede types(), cede params(), PostgresQueryLimits::new(1:usize, 0:usize, 64:usize).unwrap()).await
        if inside.is_err() { return 7 }
        if inside.unwrap().len() != 1:usize { return 7 }
        if transaction#.commit_async().await.is_err() { return 8 }
    }
    auto reused = pool#.acquire_async(100:i32).await
    if reused.is_err() { pool#.close(); return 9 }
    auto reused# = reused.unwrap()
    auto result = reused#.simple_query_async("SELECT 1", PostgresQueryLimits::new(1:usize, 0:usize, 64:usize).unwrap()).await
    if result.is_err() { reused#.close(); pool#.close(); return 10 }
    if result.unwrap().len() != 1:usize { reused#.close(); pool#.close(); return 10 }
    pool#.close()
    return 0
}

fn main_async() -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() { return 1 }
    auto port = listener.local_port()
    if port == 0:u16 { return 2 }
    auto server = server_async(cede listener).start
    auto client = client_async(port).start
    auto client_status = client.await
    auto server_status = server.await
    if client_status != 0:i32 { return 100:i32 + client_status }
    return server_status
}

fn main() -> i32 {
    return block_on(main_async())
}
