import official/postgres::{PostgresClient, PostgresConfig, PostgresQueryLimits}
import core/option::{Option}
import core/result::{Result}
import std/io::{println}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/task::{block_on, sleep_async}
import std/vec::{Vec}
import stdx/encoding/hex

fn append_u16(out#: Vec<u8>, value: u16) {
    out#.push((value >> 8:u16) as u8)
    out#.push(value as u8)
}

fn append_u32(out#: Vec<u8>, value: u32) {
    out#.push((value >> 24:u32) as u8)
    out#.push((value >> 16:u32) as u8)
    out#.push((value >> 8:u32) as u8)
    out#.push(value as u8)
}

fn append_text(out#: Vec<u8>, value: str) {
    auto index# = 0:usize
    loop index < value.len() {
        out#.push(value.byte_at(index) as u8)
        index = index + 1:usize
    }
}

fn append_cstring(out#: Vec<u8>, value: str) {
    append_text(out, value)
    out#.push(0:u8)
}

fn append_frame(out#: Vec<u8>, tag: u8, cede body: Vec<u8>) {
    auto owned# = cede body
    out#.push(tag)
    append_u32(out, (owned.len() + 4:usize) as u32)
    auto index# = 0:usize
    loop index < owned.len() {
        out#.push(owned.get(index))
        index = index + 1:usize
    }
}

fn append_ready(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    body#.push('I' as u8)
    append_frame(out, 'Z' as u8, cede body)
}

fn append_auth_ok(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u32(body, 0:u32)
    append_frame(out, 'R' as u8, cede body)
}

fn append_row_description(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_cstring(body, "value")
    append_u32(body, 0:u32)
    append_u16(body, 0:u16)
    append_u32(body, 25:u32)
    append_u16(body, 65535:u16)
    append_u32(body, 4294967295:u32)
    append_u16(body, 0:u16)
    append_frame(out, 'T' as u8, cede body)
}

fn append_data_row_text(out#: Vec<u8>, value: str) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_u32(body, value.len() as u32)
    append_text(body, value)
    append_frame(out, 'D' as u8, cede body)
}

fn append_data_row_null(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_u32(body, 4294967295:u32)
    append_frame(out, 'D' as u8, cede body)
}

fn append_command_complete(out#: Vec<u8>, tag: str) {
    auto body# = Vec<u8>::new()
    append_cstring(body, tag)
    append_frame(out, 'C' as u8, cede body)
}

fn append_server_error(out#: Vec<u8>, sqlstate: str, message: str) {
    auto body# = Vec<u8>::new()
    body#.push('S' as u8)
    append_cstring(body, "ERROR")
    body#.push('C' as u8)
    append_cstring(body, sqlstate)
    body#.push('M' as u8)
    append_cstring(body, message)
    body#.push(0:u8)
    append_frame(out, 'E' as u8, cede body)
}

fn read_message_async(stream#: TcpStream) -> async Result<Vec<u8>, string> {
    auto buffer# = Vec<u8>::with_capacity(512:usize)
    auto read = stream#.read_into_async(cede buffer, 512:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _returned = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto returned = received#.take_buffer()
    if count == 0:usize {
        return Result<Vec<u8>, string>::Err(string::from("unexpected EOF"))
    }
    return Result<Vec<u8>, string>::Ok(cede returned)
}

fn write_async(stream#: TcpStream, cede bytes: Vec<u8>) -> async bool {
    auto written = stream#.write_from_async(cede bytes, 1000:i32).await
    if written.is_err() { return false }
    auto completed# = written.unwrap()
    auto complete = completed.complete
    auto _returned = completed#.take_buffer()
    return complete
}

fn is_query(packet: Vec<u8>) -> bool {
    return packet.len() >= 5:usize && packet.get(0:usize) == 'Q' as u8
}

fn query_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }

    auto startup = read_message_async(stream).await
    if startup.is_err() { stream#.close(); return 2 }
    auto hello# = Vec<u8>::new()
    append_auth_ok(hello)
    append_ready(hello)
    if !write_async(stream, cede hello).await { stream#.close(); return 3 }

    auto first_query = read_message_async(stream).await
    if first_query.is_err() { stream#.close(); return 4 }
    if !is_query(first_query.unwrap()) { stream#.close(); return 4 }
    auto first_reply# = Vec<u8>::new()
    append_row_description(first_reply)
    append_data_row_text(first_reply, "a\x00b")
    append_data_row_null(first_reply)
    append_command_complete(first_reply, "SELECT 2")
    append_command_complete(first_reply, "UPDATE 1")
    append_ready(first_reply)
    if !write_async(stream, cede first_reply).await { stream#.close(); return 5 }

    auto second_query = read_message_async(stream).await
    if second_query.is_err() { stream#.close(); return 6 }
    if !is_query(second_query.unwrap()) { stream#.close(); return 6 }
    auto error_reply# = Vec<u8>::new()
    append_server_error(error_reply, "42601", "synthetic syntax error")
    append_ready(error_reply)
    if !write_async(stream, cede error_reply).await { stream#.close(); return 7 }

    auto third_query = read_message_async(stream).await
    if third_query.is_err() { stream#.close(); return 8 }
    if !is_query(third_query.unwrap()) { stream#.close(); return 8 }
    auto malformed# = Vec<u8>::new()
    append_data_row_text(malformed, "out of sequence")
    if !write_async(stream, cede malformed).await { stream#.close(); return 9 }
    stream#.close()
    return 0
}

fn query_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::trusted_local(address, "app", "notes")
    if configured.is_err() { return 1 }
    auto client = PostgresClient::connect_async(cede configured.unwrap()).await
    if client.is_err() { return 2 }
    auto connection# = client.unwrap()

    assert(PostgresQueryLimits::new(0:usize, 1:usize, 1:usize).is_err(), "zero result-set limit is rejected")
    assert(PostgresQueryLimits::new(1:usize, 1:usize, 0:usize).is_err(), "zero byte limit is rejected")

    auto first_limits = PostgresQueryLimits::new(4:usize, 4:usize, 64:usize).unwrap()
    auto first = connection#.simple_query_async("SELECT value; UPDATE values", first_limits).await
    if first.is_err() { connection#.close(); return 3 }
    auto result_sets = first.unwrap()
    if result_sets.len() != 2:usize { connection#.close(); return 4 }
    auto *select_result = result_sets.get_ref(0:usize)
    if select_result.command_tag.as_str().equals("SELECT 2") == false ||
       select_result.columns.len() != 1:usize || select_result.rows.len() != 2:usize {
        connection#.close()
        return 5
    }
    if !select_result.columns.get(0:usize).name.as_str().equals("value") ||
       select_result.columns.get(0:usize).type_oid != 25:u32 {
        connection#.close()
        return 6
    }
    auto *first_row = select_result.rows.get_ref(0:usize)
    auto *first_value = first_row.get_ref(0:usize)
    match first_value {
        auto Option<Bytes>::Some(&value) => {
            if !hex::encode(value.as_slice()).equals("610062") { connection#.close(); return 7 }
        }
        _ => { connection#.close(); return 8 }
    }
    auto *null_row = select_result.rows.get_ref(1:usize)
    if null_row.get(0:usize).is_some() { connection#.close(); return 9 }
    auto copied_result = result_sets.get(0:usize)
    auto *copied_row = copied_result.rows.get_ref(0:usize)
    auto *copied_value = copied_row.get_ref(0:usize)
    match copied_value {
        auto Option<Bytes>::Some(&value) => {
            if !hex::encode(value.as_slice()).equals("610062") { connection#.close(); return 9 }
        }
        _ => { connection#.close(); return 9 }
    }
    auto *update_result = result_sets.get_ref(1:usize)
    if !update_result.command_tag.as_str().equals("UPDATE 1") ||
       update_result.columns.len() != 0:usize || update_result.rows.len() != 0:usize {
        connection#.close()
        return 10
    }

    auto second_limits = PostgresQueryLimits::new(2:usize, 2:usize, 16:usize).unwrap()
    auto server_error = connection#.simple_query_async("bad sql", second_limits).await
    if server_error.is_ok() { connection#.close(); return 11 }
    auto server_failure = server_error.unwrap_err()
    if !server_failure.kind.as_str().equals("server") ||
       !server_failure.sqlstate.as_str().equals("42601") || connection.is_closed() {
        connection#.close()
        return 12
    }

    auto third_limits = PostgresQueryLimits::new(1:usize, 1:usize, 16:usize).unwrap()
    auto protocol_error = connection#.simple_query_async("SELECT malformed", third_limits).await
    if protocol_error.is_ok() || !connection.is_closed() { return 13 }
    return 0
}

fn limit_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }
    auto startup = read_message_async(stream).await
    if startup.is_err() { stream#.close(); return 2 }
    auto hello# = Vec<u8>::new()
    append_auth_ok(hello)
    append_ready(hello)
    if !write_async(stream, cede hello).await { stream#.close(); return 3 }
    auto query = read_message_async(stream).await
    if query.is_err() { stream#.close(); return 4 }
    auto reply# = Vec<u8>::new()
    append_row_description(reply)
    append_data_row_text(reply, "over limit")
    append_command_complete(reply, "SELECT 1")
    append_ready(reply)
    if !write_async(stream, cede reply).await { stream#.close(); return 5 }
    stream#.close()
    return 0
}

fn limit_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::trusted_local(address, "app", "notes")
    if configured.is_err() { return 1 }
    auto client = PostgresClient::connect_async(cede configured.unwrap()).await
    if client.is_err() { return 2 }
    auto connection# = client.unwrap()
    auto limits = PostgresQueryLimits::new(1:usize, 1:usize, 3:usize).unwrap()
    auto result = connection#.simple_query_async("SELECT value", limits).await
    if result.is_ok() || !connection.is_closed() { return 3 }
    auto failure = result.unwrap_err()
    if !failure.kind.as_str().equals("limit") { return 4 }
    return 0
}

fn main_async() -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() { return 1 }
    auto port = listener.local_port()
    if port == 0:u16 { return 2 }
    auto server = query_server_async(cede listener).start
    auto client = query_client_async(port).start
    auto client_status = client.await
    auto server_status = server.await
    if client_status != 0:i32 { return 20:i32 + client_status }
    if server_status != 0:i32 { return server_status }

    auto limit_listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !limit_listener.is_valid() { return 5 }
    auto limit_port = limit_listener.local_port()
    if limit_port == 0:u16 { return 6 }
    auto limit_server = limit_server_async(cede limit_listener).start
    auto limit_client = limit_client_async(limit_port).start
    auto limit_client_status = limit_client.await
    auto limit_server_status = limit_server.await
    if limit_client_status != 0:i32 { return 60:i32 + limit_client_status }
    if limit_server_status != 0:i32 { return 40:i32 + limit_server_status }
    return 0
}

fn main() -> i32 {
    auto status = block_on(main_async())
    println("query status {}", status)
    return status
}
