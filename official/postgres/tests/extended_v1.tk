import official/postgres::{PostgresClient, PostgresConfig, PostgresParam, PostgresQueryLimits, PostgresTransaction}
import core/result::{Result}
import std/net::{Ipv4Addr, SocketAddrV4, TcpListener, TcpStream}
import std/task::{block_on, sleep_async}
import std/vec::{Vec}

fn append_u16(out#: Vec<u8>, value: u16) {
    out#.push((value >> 8:u16) as u8)
    out#.push(value as u8)
}

fn append_u32(out#: Vec<u8>, value: u32) {
    out#.push((value >> 24:u32) as u8)
    out#.push((value >> 16:u32) as u8)
    out#.push((value >> 8:u32) as u8)
    out#.push(value as u8)
}

fn append_text(out#: Vec<u8>, value: str) {
    auto index# = 0:usize
    loop index < value.len() {
        out#.push(value.byte_at(index) as u8)
        index = index + 1:usize
    }
}

fn append_cstring(out#: Vec<u8>, value: str) {
    append_text(out, value)
    out#.push(0:u8)
}

fn append_frame(out#: Vec<u8>, tag: u8, cede body: Vec<u8>) {
    auto owned# = cede body
    out#.push(tag)
    append_u32(out, (owned.len() + 4:usize) as u32)
    auto index# = 0:usize
    loop index < owned.len() {
        out#.push(owned.get(index))
        index = index + 1:usize
    }
}

fn append_empty(out#: Vec<u8>, tag: u8) {
    append_frame(out, tag, cede Vec<u8>::new())
}

fn append_auth_ok(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u32(body, 0:u32)
    append_frame(out, 'R' as u8, cede body)
}

fn append_ready(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    body#.push('I' as u8)
    append_frame(out, 'Z' as u8, cede body)
}

fn append_parameter_description(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_u32(body, 25:u32)
    append_frame(out, 't' as u8, cede body)
}

fn append_row_description(out#: Vec<u8>) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_cstring(body, "value")
    append_u32(body, 0:u32)
    append_u16(body, 0:u16)
    append_u32(body, 25:u32)
    append_u16(body, 65535:u16)
    append_u32(body, 4294967295:u32)
    append_u16(body, 0:u16)
    append_frame(out, 'T' as u8, cede body)
}

fn append_data_row(out#: Vec<u8>, value: str) {
    auto body# = Vec<u8>::new()
    append_u16(body, 1:u16)
    append_u32(body, value.len() as u32)
    append_text(body, value)
    append_frame(out, 'D' as u8, cede body)
}

fn append_command_complete(out#: Vec<u8>, tag: str) {
    auto body# = Vec<u8>::new()
    append_cstring(body, tag)
    append_frame(out, 'C' as u8, cede body)
}

fn read_message_async(stream#: TcpStream) -> async Result<Vec<u8>, string> {
    auto buffer# = Vec<u8>::with_capacity(1024:usize)
    auto read = stream#.read_into_async(cede buffer, 1024:usize, 1000:i32).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _buffer = failure#.take_buffer()
        return Result<Vec<u8>, string>::Err(message)
    }
    auto received# = read.unwrap()
    auto count = received.bytes_read
    auto bytes = received#.take_buffer()
    if count == 0:usize { return Result<Vec<u8>, string>::Err(string::from("unexpected EOF")) }
    return Result<Vec<u8>, string>::Ok(cede bytes)
}

fn write_async(stream#: TcpStream, cede bytes: Vec<u8>) -> async bool {
    auto written = stream#.write_from_async(cede bytes, 1000:i32).await
    if written.is_err() { return false }
    auto completed# = written.unwrap()
    auto complete = completed.complete
    auto _bytes = completed#.take_buffer()
    return complete
}

fn has_tag(packet: Vec<u8>, tag: u8) -> bool {
    auto index# = 0:usize
    loop index < packet.len() {
        if packet.get(index) == tag { return true }
        index = index + 1:usize
    }
    return false
}

fn extended_server_async(cede listener: TcpListener) -> async i32 {
    auto listener# = cede listener
    auto stream# = listener#.accept_async().await
    if !stream.is_valid() { return 1 }
    if read_message_async(stream).await.is_err() { stream#.close(); return 2 }
    auto hello# = Vec<u8>::new()
    append_auth_ok(hello)
    append_ready(hello)
    if !write_async(stream, cede hello).await { stream#.close(); return 3 }

    auto prepare = read_message_async(stream).await
    if prepare.is_err() { stream#.close(); return 4 }
    auto prepare_bytes = prepare.unwrap()
    if !has_tag(prepare_bytes, 'P' as u8) || !has_tag(prepare_bytes, 'D' as u8) || !has_tag(prepare_bytes, 'S' as u8) { stream#.close(); return 5 }
    auto prepared# = Vec<u8>::new()
    append_empty(prepared, '1' as u8)
    append_parameter_description(prepared)
    append_row_description(prepared)
    append_ready(prepared)
    if !write_async(stream, cede prepared).await { stream#.close(); return 6 }

    auto execute = read_message_async(stream).await
    if execute.is_err() { stream#.close(); return 7 }
    auto execute_bytes = execute.unwrap()
    if !has_tag(execute_bytes, 'B' as u8) || !has_tag(execute_bytes, 'E' as u8) || !has_tag(execute_bytes, 'S' as u8) { stream#.close(); return 8 }
    auto executed# = Vec<u8>::new()
    append_empty(executed, '2' as u8)
    append_data_row(executed, "bound")
    append_command_complete(executed, "SELECT 1")
    append_ready(executed)
    if !write_async(stream, cede executed).await { stream#.close(); return 9 }

    auto close = read_message_async(stream).await
    if close.is_err() { stream#.close(); return 10 }
    if !has_tag(close.unwrap(), 'C' as u8) { stream#.close(); return 10 }
    auto closed# = Vec<u8>::new()
    append_empty(closed, '3' as u8)
    append_ready(closed)
    if !write_async(stream, cede closed).await { stream#.close(); return 11 }

    auto begin = read_message_async(stream).await
    if begin.is_err() { stream#.close(); return 12 }
    if !has_tag(begin.unwrap(), 'Q' as u8) { stream#.close(); return 12 }
    auto began# = Vec<u8>::new()
    append_command_complete(began, "BEGIN")
    append_ready(began)
    if !write_async(stream, cede began).await { stream#.close(); return 13 }

    auto inside = read_message_async(stream).await
    if inside.is_err() { stream#.close(); return 14 }
    if !has_tag(inside.unwrap(), 'Q' as u8) { stream#.close(); return 14 }
    auto inside_reply# = Vec<u8>::new()
    append_command_complete(inside_reply, "UPDATE 1")
    append_ready(inside_reply)
    if !write_async(stream, cede inside_reply).await { stream#.close(); return 15 }

    auto commit = read_message_async(stream).await
    if commit.is_err() { stream#.close(); return 16 }
    if !has_tag(commit.unwrap(), 'Q' as u8) { stream#.close(); return 16 }
    auto committed# = Vec<u8>::new()
    append_command_complete(committed, "COMMIT")
    append_ready(committed)
    if !write_async(stream, cede committed).await { stream#.close(); return 17 }
    stream#.close()
    return 0
}

fn extended_client_async(port: u16) -> async i32 {
    sleep_async(10:i64).await
    auto address = SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), port)
    auto configured = PostgresConfig::trusted_local(address, "app", "notes")
    if configured.is_err() { return 1 }
    auto connected = PostgresClient::connect_async(cede configured.unwrap()).await
    if connected.is_err() { return 2 }
    auto client# = connected.unwrap()
    auto types# = Vec<u32>::new()
    types#.push(25:u32)
    auto statement = client#.prepare_async("SELECT $1", cede types).await
    if statement.is_err() { client#.close(); return 3 }
    auto prepared# = statement.unwrap()
    auto limits = PostgresQueryLimits::new(1:usize, 2:usize, 64:usize).unwrap()
    auto wrong_count = prepared#.execute_async(client, cede Vec<PostgresParam>::new(), limits).await
    if wrong_count.is_ok() || client.is_closed() { client#.close(); return 4 }

    auto params# = Vec<PostgresParam>::new()
    params#.push(cede PostgresParam::Text(string::from("bound")))
    auto result = prepared#.execute_async(client, cede params, PostgresQueryLimits::new(1:usize, 2:usize, 64:usize).unwrap()).await
    if result.is_err() { client#.close(); return 5 }
    auto results = result.unwrap()
    if results.len() != 1:usize || results.get(0:usize).rows.len() != 1:usize || !results.get(0:usize).command_tag.as_str().equals("SELECT 1") { client#.close(); return 6 }
    auto closed = prepared#.close_async(client).await
    if closed.is_err() || !prepared.is_closed() { client#.close(); return 7 }

    auto transaction = PostgresTransaction::begin_async(cede client).await
    if transaction.is_err() { return 8 }
    auto transaction# = transaction.unwrap()
    auto inner = transaction#.simple_query_async("UPDATE notes SET body = 'x'", PostgresQueryLimits::new(1:usize, 0:usize, 64:usize).unwrap()).await
    if inner.is_err() { return 9 }
    auto reusable = transaction#.commit_async().await
    if reusable.is_err() { return 10 }
    reusable.unwrap()#.close()
    return 0
}

fn main_async() -> async i32 {
    auto listener# = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::new(127:u8, 0:u8, 0:u8, 1:u8), 0:u16))
    if !listener.is_valid() { return 1 }
    auto port = listener.local_port()
    if port == 0:u16 { return 2 }
    auto server = extended_server_async(cede listener).start
    auto client = extended_client_async(port).start
    auto client_status = client.await
    auto server_status = server.await
    if client_status != 0:i32 { return 20:i32 + client_status }
    return server_status
}

fn main() -> i32 {
    return block_on(main_async())
}
