// Public entry module for official/postgres.
//
// The codec and serial client own every decoded binary field and never expose
// a pointer into a receive buffer. Transport runs over AsyncStream with
// explicit query-result bounds before retained rows can grow unbounded.

import core/option::{Option}
import core/result::{Result}
import core/str::{bytes}
import std/bytes::{Bytes, bytes_from_array}
import std/net::{SocketAddrV4, TcpStream}
import std/sync::{Mutex}
import std/task::{sleep_async}
import std/vec::{Vec}
import sys/libc::*
import stdx/crypto/constant_time
import stdx/crypto/hmac::{hmac_sha256}
import stdx/crypto/pbkdf2
import stdx/crypto/sha256::{Sha256}
import stdx/encoding/base64
import stdx/crypto/token
import stdx/net/stream::{AsyncStream}
import stdx/net/tls::{TlsStream}

const PROTOCOL_V3: u32 = 196608:u32
const MAX_FRAME_BYTES: usize = 16777216:usize
const MAX_COLUMNS: usize = 4096:usize
const MAX_SCRAM_SALT_BYTES: usize = 65536:usize

pub shape PostgresError (
    kind: string,
    position: usize,
    sqlstate: string,
    message: string
)

pub shape PostgresServerError (
    sqlstate: string,
    message: string
)

pub shape PostgresColumn (
    name: string,
    type_oid: u32
)

pub shape PostgresMessage (
    AuthenticationOk() = 0 |
    AuthenticationSasl(Vec<string>) = 1 |
    AuthenticationSaslContinue(string) = 2 |
    AuthenticationSaslFinal(string) = 3 |
    AuthenticationCleartextPassword() = 4 |
    AuthenticationMd5() = 5 |
    AuthenticationUnsupported(i32) = 6 |
    ParameterStatus(string, string) = 7 |
    BackendKeyData(i32, i32) = 8 |
    ReadyForQuery(u8) = 9 |
    Error(PostgresServerError) = 10 |
    Notice(PostgresServerError) = 11 |
    RowDescription(Vec<PostgresColumn>) = 12 |
    DataRow(Vec<Option<Bytes>>) = 13 |
    CommandComplete(string) = 14 |
    ParseComplete() = 15 |
    BindComplete() = 16 |
    CloseComplete() = 17 |
    NoData() = 18 |
    ParameterDescription(Vec<u32>) = 19 |
    PortalSuspended() = 20 |
    Unknown(u8, Bytes) = 21
)

pub shape PostgresBackendFrame (
    message: PostgresMessage,
    consumed: usize
)

pub shape PostgresDecode (
    NeedMore() = 0 |
    Complete(PostgresBackendFrame) = 1
)

pub shape ScramClientFirst (
    bare: string,
    message: string,
    nonce: string
)

pub shape ScramClientFinal (
    message: string,
    expected_server_signature: Bytes
)

pub shape PostgresTlsMode (
    RequireVerified() = 0 |
    InsecureForTest() = 1 |
    DisableForTrustedLocal() = 2
)

pub shape PostgresAuthPolicy (
    ScramOnly() = 0 |
    AllowTrustForLocal() = 1
)

pub shape PostgresConfig (
    address: SocketAddrV4,
    server_name: string,
    user: string,
    database: string,
    password: string,
    ca_file: string,
    timeout_ms: i32,
    tls_mode: PostgresTlsMode,
    auth_policy: PostgresAuthPolicy
)

// Every simple-query response is retained in memory. Callers must therefore
// choose bounds for the number of completed statements, rows, and data bytes
// they are willing to keep.
pub shape PostgresQueryLimits (
    max_result_sets: usize,
    max_rows: usize,
    max_bytes: usize
)

// One completed statement result from PostgreSQL's simple-query protocol.
// Values are owned Bytes so the result remains valid after another query.
pub shape PostgresQueryResult (
    columns: Vec<PostgresColumn>,
    rows: Vec<Vec<Option<Bytes>>>,
    command_tag: string
)

// Parameters retain their transport representation until Bind is written.
// Text is sent in PostgreSQL text format; Bytes is intentionally binary so a
// caller that prepares a bytea (or another binary-capable type) never loses
// embedded NUL bytes to a string conversion.
pub shape PostgresParam (
    Null() = 0 |
    Text(string) = 1 |
    Bytes(Bytes) = 2 |
    Int64(i64) = 3 |
    Bool(bool) = 4
)

// A statement is session-local. It is deliberately not Clone: copying the
// name would make it too easy to issue concurrent Bind messages on one serial
// connection.
pub shape PostgresStatement (
    name: string,
    parameter_count: usize,
    result_columns: Vec<PostgresColumn>,
    closed: bool
)

// A transaction owns its connection through commit or rollback. Dropping an
// active transaction closes the connection rather than pretending that an
// asynchronous rollback happened.
pub shape PostgresTransaction (
    client#: PostgresClient,
    active: bool
)

shape PostgresPoolState (
    config: PostgresConfig,
    idle#: Vec<PostgresClient>,
    total_connections: usize,
    max_connections: usize,
    closed: bool
)

// A pool is a cheap shared handle. Acquiring returns an exclusive lease, so a
// serial PostgreSQL socket can never be used by two requests at once.
pub shape PostgresPool (
    ~state: Mutex<PostgresPoolState>
)

pub shape PostgresPoolLease (
    client#: Vec<PostgresClient>,
    ~state: Mutex<PostgresPoolState>
)

// A pooled transaction owns the checked-out client until commit, rollback, or
// drop. An active transaction is never returned to an idle pool.
pub shape PostgresPoolTransaction (
    client#: Vec<PostgresClient>,
    ~state: Mutex<PostgresPoolState>,
    active: bool
)

pub shape PostgresClient (
    stream#: AsyncStream,
    receive#: Vec<u8>,
    timeout_ms: i32,
    closed#: bool,
    next_statement_id: u32
)

// A client owns its socket and TLS session. Moving that ownership to another
// worker is safe; using it concurrently remains impossible because every
// command requires its unique mutable owner.
impl PostgresClient @Send {}
impl PostgresConfig @Send {}
impl PostgresPoolState @Send {}

impl PostgresPoolState {
    fn take_idle(self#) -> Option<PostgresClient> {
        auto item# = self.idle#.pop()
        return cede item
    }
}

shape ParsedText (
    value: string,
    next: usize
)

shape ScramServerFirst (
    nonce: string,
    salt: Bytes,
    iterations: u32
)

fn error(kind: str, position: usize, message: str) -> PostgresError {
    return PostgresError(
        kind = string::from(kind),
        position = position,
        sqlstate = string::from(""),
        message = string::from(message)
    )
}

fn server_error(server: PostgresServerError) -> PostgresError {
    return PostgresError(
        kind = string::from("server"),
        position = 0:usize,
        sqlstate = string::from(server.sqlstate.as_str()),
        message = string::from(server.message.as_str())
    )
}

fn io_error(message: str) -> PostgresError {
    return error("transport", 0:usize, message)
}

fn protocol_error(position: usize, message: str) -> PostgresError {
    return error("protocol", position, message)
}

fn limit_error(position: usize, message: str) -> PostgresError {
    return error("limit", position, message)
}

fn append_u16_be(out#: Vec<u8>, value: u16) {
    out#.push((value >> 8:u16) as u8)
    out#.push(value as u8)
}

fn append_u32_be(out#: Vec<u8>, value: u32) {
    out#.push((value >> 24:u32) as u8)
    out#.push((value >> 16:u32) as u8)
    out#.push((value >> 8:u32) as u8)
    out#.push(value as u8)
}

fn append_text(out#: Vec<u8>, value: str) {
    auto index#: usize = 0:usize
    loop index < value.len() {
        out#.push(value.byte_at(index) as u8)
        index = index + 1:usize
    }
}

fn append_cstring(out#: Vec<u8>, value: str) {
    append_text(out, value)
    out#.push(0:u8)
}

fn contains_nul(value: str) -> bool {
    auto index#: usize = 0:usize
    loop index < value.len() {
        if value.byte_at(index) as u8 == 0:u8 { return true }
        index = index + 1:usize
    }
    return false
}

fn contains_byte(value: str, target: u8) -> bool {
    auto index#: usize = 0:usize
    loop index < value.len() {
        if value.byte_at(index) as u8 == target { return true }
        index = index + 1:usize
    }
    return false
}

fn is_ascii_credential(value: str) -> bool {
    auto index#: usize = 0:usize
    loop index < value.len() {
        auto byte = value.byte_at(index) as u8
        if byte < 32:u8 || byte > 126:u8 { return false }
        index = index + 1:usize
    }
    return true
}

fn escape_scram_username(value: str) -> string {
    auto escaped# = string::from("")
    auto index#: usize = 0:usize
    loop index < value.len() {
        auto byte = value.byte_at(index) as u8
        if byte == ',' as u8 { escaped#.push_str("=2C") }
        else if byte == '=' as u8 { escaped#.push_str("=3D") }
        else { escaped#.push_byte_raw(byte) }
        index = index + 1:usize
    }
    return escaped
}

fn parse_u32_decimal(value: str) -> Result<u32, PostgresError> {
    if value.len() == 0:usize { return Result<u32, PostgresError>::Err(error("authentication", 0:usize, "SCRAM iteration count is empty")) }
    auto parsed#: u32 = 0:u32
    auto index#: usize = 0:usize
    loop index < value.len() {
        auto byte = value.byte_at(index) as u8
        if byte < '0' as u8 || byte > '9' as u8 {
            return Result<u32, PostgresError>::Err(error("authentication", index, "SCRAM iteration count is not decimal"))
        }
        auto digit = (byte - '0' as u8) as u32
        if parsed > 429496729:u32 || (parsed == 429496729:u32 && digit > 5:u32) {
            return Result<u32, PostgresError>::Err(error("authentication", index, "SCRAM iteration count overflows u32"))
        }
        parsed = parsed * 10:u32 + digit
        index = index + 1:usize
    }
    if parsed < 4096:u32 { return Result<u32, PostgresError>::Err(error("authentication", 0:usize, "SCRAM iteration count is below the 4096-round minimum")) }
    if parsed > 1000000:u32 { return Result<u32, PostgresError>::Err(error("authentication", 0:usize, "SCRAM iteration count exceeds client limit")) }
    return Result<u32, PostgresError>::Ok(parsed)
}

fn parse_scram_server_first(value: str) -> Result<ScramServerFirst, PostgresError> {
    auto nonce# = string::from("")
    auto salt_text# = string::from("")
    auto iterations_text# = string::from("")
    auto saw_nonce# = false
    auto saw_salt# = false
    auto saw_iterations# = false
    auto cursor#: usize = 0:usize
    loop cursor < value.len() {
        auto field_end#: usize = cursor
        loop field_end < value.len() && value.byte_at(field_end) as u8 != ',' as u8 {
            field_end = field_end + 1:usize
        }
        if field_end == cursor + 1:usize || field_end <= cursor {
            return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "invalid SCRAM server-first attribute"))
        }
        if value.byte_at(cursor + 1:usize) as u8 != '=' as u8 {
            return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "SCRAM attribute is missing '='"))
        }
        auto key = value.byte_at(cursor) as u8
        auto field_value = value.substr(cursor + 2:usize, field_end - cursor - 2:usize)
        if key == 'r' as u8 {
            if saw_nonce { return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "duplicate SCRAM nonce")) }
            nonce = string::from(field_value)
            saw_nonce = true
        } else if key == 's' as u8 {
            if saw_salt { return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "duplicate SCRAM salt")) }
            salt_text = string::from(field_value)
            saw_salt = true
        } else if key == 'i' as u8 {
            if saw_iterations { return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "duplicate SCRAM iteration count")) }
            iterations_text = string::from(field_value)
            saw_iterations = true
        } else if key == 'm' as u8 {
            return Result<ScramServerFirst, PostgresError>::Err(error("authentication", cursor, "server requires unsupported SCRAM extension"))
        }
        if field_end == value.len() { cursor = field_end }
        else {
            if field_end + 1:usize == value.len() {
                return Result<ScramServerFirst, PostgresError>::Err(error("authentication", field_end, "SCRAM server-first has trailing comma"))
            }
            cursor = field_end + 1:usize
        }
    }
    if !saw_nonce || !saw_salt || !saw_iterations {
        return Result<ScramServerFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM server-first message lacks required attributes"))
    }
    auto decoded_salt = base64::decode(salt_text.as_str())
    if decoded_salt.is_err() { return Result<ScramServerFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM salt is not valid Base64")) }
    auto salt_bytes = decoded_salt.unwrap()
    if salt_bytes.len() == 0:usize || salt_bytes.len() > MAX_SCRAM_SALT_BYTES {
        return Result<ScramServerFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM salt length is outside client limits"))
    }
    auto parsed_iterations = parse_u32_decimal(iterations_text.as_str())
    if parsed_iterations.is_err() { return Result<ScramServerFirst, PostgresError>::Err(parsed_iterations.unwrap_err()) }
    return Result<ScramServerFirst, PostgresError>::Ok(ScramServerFirst(
        nonce = string::from(nonce.as_str()),
        salt = Bytes::from_vec(cede salt_bytes),
        iterations = parsed_iterations.unwrap()
    ))
}

fn sha256_bytes(value: bytes) -> [u8; 32] {
    auto hash# = Sha256::new()
    hash#.update_view(value)
    return hash#.finalize()
}

fn scram_nonce_from_bare(value: str) -> Result<string, PostgresError> {
    auto index#: usize = 0:usize
    loop index + 2:usize < value.len() {
        if value.byte_at(index) as u8 == ',' as u8 &&
           value.byte_at(index + 1:usize) as u8 == 'r' as u8 &&
           value.byte_at(index + 2:usize) as u8 == '=' as u8 {
            auto nonce = value.substr(index + 3:usize, value.len() - index - 3:usize)
            if nonce.len() == 0:usize {
                return Result<string, PostgresError>::Err(error("authentication", index, "SCRAM client nonce is empty"))
            }
            return Result<string, PostgresError>::Ok(string::from(nonce))
        }
        index = index + 1:usize
    }
    return Result<string, PostgresError>::Err(error("authentication", 0:usize, "SCRAM client-first message lacks nonce"))
}

fn read_u16_be(input: Vec<u8>, offset: usize) -> u16 {
    return ((input.get(offset) as u16) << 8:u16) |
           (input.get(offset + 1:usize) as u16)
}

fn read_u32_be(input: Vec<u8>, offset: usize) -> u32 {
    return ((input.get(offset) as u32) << 24:u32) |
           ((input.get(offset + 1:usize) as u32) << 16:u32) |
           ((input.get(offset + 2:usize) as u32) << 8:u32) |
           (input.get(offset + 3:usize) as u32)
}

fn text_range(input: Vec<u8>, start: usize, end: usize) -> string {
    auto output# = string::from("")
    auto index#: usize = start
    loop index < end {
        output#.push_byte_raw(input.get(index))
        index = index + 1:usize
    }
    return output
}

fn bytes_range(input: Vec<u8>, start: usize, end: usize) -> Bytes {
    auto output# = Vec<u8>::with_capacity(end - start)
    auto index#: usize = start
    loop index < end {
        output#.push(input.get(index))
        index = index + 1:usize
    }
    return Bytes::from_vec(cede output)
}

fn parse_cstring(input: Vec<u8>, start: usize, end: usize) -> Result<ParsedText, PostgresError> {
    auto cursor#: usize = start
    loop cursor < end {
        if input.get(cursor) == 0:u8 {
            return Result<ParsedText, PostgresError>::Ok(ParsedText(
                value = text_range(input, start, cursor),
                next = cursor + 1:usize
            ))
        }
        cursor = cursor + 1:usize
    }
    return Result<ParsedText, PostgresError>::Err(protocol_error(start, "PostgreSQL string is missing NUL terminator"))
}

fn parse_server_error(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresServerError, PostgresError> {
    auto sqlstate# = string::from("")
    auto message# = string::from("PostgreSQL server error")
    auto cursor#: usize = start
    loop cursor < end {
        auto field = input.get(cursor)
        cursor = cursor + 1:usize
        if field == 0:u8 {
            if cursor != end {
                return Result<PostgresServerError, PostgresError>::Err(protocol_error(cursor, "bytes follow PostgreSQL error terminator"))
            }
            return Result<PostgresServerError, PostgresError>::Ok(PostgresServerError(
                sqlstate = string::from(sqlstate.as_str()),
                message = string::from(message.as_str())
            ))
        }
        auto parsed = parse_cstring(input, cursor, end)
        if parsed.is_err() { return Result<PostgresServerError, PostgresError>::Err(parsed.unwrap_err()) }
        auto field_value = parsed.unwrap()
        if field == 'C' as u8 { sqlstate = string::from(field_value.value.as_str()) }
        if field == 'M' as u8 { message = string::from(field_value.value.as_str()) }
        cursor = field_value.next
    }
    return Result<PostgresServerError, PostgresError>::Err(protocol_error(start, "PostgreSQL error response is missing terminator"))
}

fn parse_authentication(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresMessage, PostgresError> {
    if end - start < 4:usize {
        return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "PostgreSQL authentication frame is too short"))
    }
    auto code = read_u32_be(input, start) as i32
    if code == 0:i32 {
        if end != start + 4:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "AuthenticationOk has unexpected data")) }
        return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationOk())
    }
    if code == 3:i32 {
        if end != start + 4:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "cleartext authentication has unexpected data")) }
        return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationCleartextPassword())
    }
    if code == 5:i32 {
        if end != start + 8:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "MD5 authentication must contain a four-byte salt")) }
        return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationMd5())
    }
    if code == 10:i32 {
        auto mechanisms# = Vec<string>::new()
        auto cursor#: usize = start + 4:usize
        loop cursor < end {
            if input.get(cursor) == 0:u8 {
                if cursor + 1:usize != end { return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "SASL mechanism list has bytes after terminator")) }
                return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationSasl(cede mechanisms))
            }
            auto parsed = parse_cstring(input, cursor, end)
            if parsed.is_err() { return Result<PostgresMessage, PostgresError>::Err(parsed.unwrap_err()) }
            auto mechanism = parsed.unwrap()
            mechanisms#.push(cede mechanism.value)
            cursor = mechanism.next
        }
        return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "SASL mechanism list is missing final terminator"))
    }
    if code == 11:i32 {
        return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationSaslContinue(
            text_range(input, start + 4:usize, end)
        ))
    }
    if code == 12:i32 {
        return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationSaslFinal(
            text_range(input, start + 4:usize, end)
        ))
    }
    return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::AuthenticationUnsupported(code))
}

fn parse_parameter_status(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresMessage, PostgresError> {
    auto name = parse_cstring(input, start, end)
    if name.is_err() { return Result<PostgresMessage, PostgresError>::Err(name.unwrap_err()) }
    auto parsed_name = name.unwrap()
    auto value = parse_cstring(input, parsed_name.next, end)
    if value.is_err() { return Result<PostgresMessage, PostgresError>::Err(value.unwrap_err()) }
    auto parsed_value = value.unwrap()
    if parsed_value.next != end { return Result<PostgresMessage, PostgresError>::Err(protocol_error(parsed_value.next, "bytes follow ParameterStatus")) }
    return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::ParameterStatus(
        cede parsed_name.value, cede parsed_value.value
    ))
}

fn parse_row_description(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresMessage, PostgresError> {
    if end - start < 2:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "RowDescription is too short")) }
    auto count = read_u16_be(input, start) as usize
    if count > MAX_COLUMNS { return Result<PostgresMessage, PostgresError>::Err(limit_error(start, "RowDescription column count exceeds limit")) }
    auto columns# = Vec<PostgresColumn>::with_capacity(count)
    auto cursor#: usize = start + 2:usize
    auto index#: usize = 0:usize
    loop index < count {
        auto name = parse_cstring(input, cursor, end)
        if name.is_err() { return Result<PostgresMessage, PostgresError>::Err(name.unwrap_err()) }
        auto parsed_name = name.unwrap()
        cursor = parsed_name.next
        if end - cursor < 18:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "RowDescription field metadata is truncated")) }
        auto type_oid = read_u32_be(input, cursor + 6:usize)
        columns#.push(cede PostgresColumn(name = cede parsed_name.value, type_oid = type_oid))
        cursor = cursor + 18:usize
        index = index + 1:usize
    }
    if cursor != end { return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "bytes follow RowDescription")) }
    return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::RowDescription(cede columns))
}

fn parse_data_row(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresMessage, PostgresError> {
    if end - start < 2:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "DataRow is too short")) }
    auto count = read_u16_be(input, start) as usize
    if count > MAX_COLUMNS { return Result<PostgresMessage, PostgresError>::Err(limit_error(start, "DataRow column count exceeds limit")) }
    auto values# = Vec<Option<Bytes>>::with_capacity(count)
    auto cursor#: usize = start + 2:usize
    auto index#: usize = 0:usize
    loop index < count {
        if end - cursor < 4:usize { return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "DataRow value length is truncated")) }
        auto encoded_length = read_u32_be(input, cursor)
        cursor = cursor + 4:usize
        if encoded_length == 4294967295:u32 {
            values#.push(cede Option<Bytes>::None)
        } else {
            auto value_length = encoded_length as usize
            if value_length > MAX_FRAME_BYTES || value_length > end - cursor {
                return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "DataRow value exceeds frame boundary"))
            }
            values#.push(cede Option<Bytes>::Some(bytes_range(input, cursor, cursor + value_length)))
            cursor = cursor + value_length
        }
        index = index + 1:usize
    }
    if cursor != end { return Result<PostgresMessage, PostgresError>::Err(protocol_error(cursor, "bytes follow DataRow")) }
    return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::DataRow(cede values))
}

fn parse_parameter_description(input: Vec<u8>, start: usize, end: usize) -> Result<PostgresMessage, PostgresError> {
    if end - start < 2:usize {
        return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "ParameterDescription is too short"))
    }
    auto count = read_u16_be(input, start) as usize
    if count > MAX_COLUMNS || end - start != 2:usize + count * 4:usize {
        return Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "ParameterDescription has invalid length"))
    }
    auto oids# = Vec<u32>::with_capacity(count)
    auto index#: usize = 0:usize
    loop index < count {
        oids#.push(read_u32_be(input, start + 2:usize + index * 4:usize))
        index = index + 1:usize
    }
    return Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::ParameterDescription(cede oids))
}

pub fn startup_message(user: str, database: str) -> Result<Vec<u8>, PostgresError> {
    if user.len() == 0:usize || database.len() == 0:usize {
        return Result<Vec<u8>, PostgresError>::Err(error("input", 0:usize, "PostgreSQL user and database must not be empty"))
    }
    if contains_nul(user) || contains_nul(database) {
        return Result<Vec<u8>, PostgresError>::Err(error("input", 0:usize, "PostgreSQL startup values must not contain NUL"))
    }
    auto payload# = Vec<u8>::new()
    append_u32_be(payload, PROTOCOL_V3)
    append_cstring(payload, "user")
    append_cstring(payload, user)
    append_cstring(payload, "database")
    append_cstring(payload, database)
    payload#.push(0:u8)
    if payload.len() + 4:usize > MAX_FRAME_BYTES {
        return Result<Vec<u8>, PostgresError>::Err(limit_error(0:usize, "StartupMessage exceeds frame limit"))
    }
    auto frame# = Vec<u8>::with_capacity(payload.len() + 4:usize)
    append_u32_be(frame, (payload.len() + 4:usize) as u32)
    auto index#: usize = 0:usize
    loop index < payload.len() {
        frame#.push(payload.get(index))
        index = index + 1:usize
    }
    return Result<Vec<u8>, PostgresError>::Ok(cede frame)
}

pub fn simple_query_message(sql: str) -> Result<Vec<u8>, PostgresError> {
    if sql.len() == 0:usize { return Result<Vec<u8>, PostgresError>::Err(error("input", 0:usize, "PostgreSQL query must not be empty")) }
    if contains_nul(sql) { return Result<Vec<u8>, PostgresError>::Err(error("input", 0:usize, "PostgreSQL query must not contain NUL")) }
    if sql.len() + 6:usize > MAX_FRAME_BYTES { return Result<Vec<u8>, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query exceeds frame limit")) }
    auto frame# = Vec<u8>::with_capacity(sql.len() + 6:usize)
    frame#.push('Q' as u8)
    append_u32_be(frame, (sql.len() + 5:usize) as u32)
    append_cstring(frame, sql)
    return Result<Vec<u8>, PostgresError>::Ok(cede frame)
}

fn append_i32_be(out#: Vec<u8>, value: i32) {
    append_u32_be(out, value as u32)
}

fn append_typed_frame(out#: Vec<u8>, tag: u8, cede body: Vec<u8>) -> Result<(), PostgresError> {
    auto owned# = cede body
    if owned.len() + 5:usize > MAX_FRAME_BYTES {
        return Result<(), PostgresError>::Err(limit_error(0:usize, "PostgreSQL extended-protocol frame exceeds limit"))
    }
    out#.push(tag)
    append_u32_be(out, (owned.len() + 4:usize) as u32)
    append_bytes(out, owned)
    return Result<(), PostgresError>::Ok(())
}

fn append_parse_message(out#: Vec<u8>, statement: str, sql: str,
                        param_type_oids: Vec<u32>) -> Result<(), PostgresError> {
    if statement.len() == 0:usize || sql.len() == 0:usize || contains_nul(statement) || contains_nul(sql) {
        return Result<(), PostgresError>::Err(error("input", 0:usize, "PostgreSQL statement name and SQL must be non-empty and NUL-free"))
    }
    if param_type_oids.len() > 65535:usize {
        return Result<(), PostgresError>::Err(limit_error(0:usize, "PostgreSQL statement has too many parameters"))
    }
    auto body# = Vec<u8>::new()
    append_cstring(body, statement)
    append_cstring(body, sql)
    append_u16_be(body, param_type_oids.len() as u16)
    auto index#: usize = 0:usize
    loop index < param_type_oids.len() {
        append_u32_be(body, param_type_oids.get(index))
        index = index + 1:usize
    }
    return append_typed_frame(out, 'P' as u8, cede body)
}

fn append_describe_statement_message(out#: Vec<u8>, statement: str) -> Result<(), PostgresError> {
    if statement.len() == 0:usize || contains_nul(statement) {
        return Result<(), PostgresError>::Err(error("input", 0:usize, "PostgreSQL statement name must be non-empty and NUL-free"))
    }
    auto body# = Vec<u8>::new()
    body#.push('S' as u8)
    append_cstring(body, statement)
    return append_typed_frame(out, 'D' as u8, cede body)
}

fn append_close_statement_message(out#: Vec<u8>, statement: str) -> Result<(), PostgresError> {
    if statement.len() == 0:usize || contains_nul(statement) {
        return Result<(), PostgresError>::Err(error("input", 0:usize, "PostgreSQL statement name must be non-empty and NUL-free"))
    }
    auto body# = Vec<u8>::new()
    body#.push('S' as u8)
    append_cstring(body, statement)
    return append_typed_frame(out, 'C' as u8, cede body)
}

fn append_sync_message(out#: Vec<u8>) -> Result<(), PostgresError> {
    return append_typed_frame(out, 'S' as u8, cede Vec<u8>::new())
}

fn append_bind_message(out#: Vec<u8>, statement: str, cede params: Vec<PostgresParam>) -> Result<(), PostgresError> {
    auto values# = cede params
    if statement.len() == 0:usize || contains_nul(statement) || values.len() > 65535:usize {
        return Result<(), PostgresError>::Err(error("input", 0:usize, "invalid PostgreSQL Bind statement or parameter count"))
    }
    auto body# = Vec<u8>::new()
    append_cstring(body, "")
    append_cstring(body, statement)
    append_u16_be(body, values.len() as u16)

    // Supply one format code per parameter. This keeps binary values binary
    // without changing the conventional text representation for scalar data.
    auto index#: usize = 0:usize
    loop index < values.len() {
        match values.get(index) {
            auto PostgresParam::Bytes(_) => append_u16_be(body, 1:u16)
            _ => append_u16_be(body, 0:u16)
        }
        index = index + 1:usize
    }

    append_u16_be(body, values.len() as u16)
    index = 0:usize
    loop index < values.len() {
        match values.get(index) {
            auto PostgresParam::Null() => append_i32_be(body, -1:i32)
            auto PostgresParam::Text(&value) => {
                if contains_nul(value.as_str()) { return Result<(), PostgresError>::Err(error("input", index, "PostgreSQL text parameter must not contain NUL")) }
                append_i32_be(body, value.len() as i32)
                append_text(body, value.as_str())
            }
            auto PostgresParam::Bytes(&value) => {
                append_i32_be(body, value.len() as i32)
                auto view = value.as_slice()
                auto byte_index#: usize = 0:usize
                loop byte_index < view.len() {
                    body#.push(view.at(byte_index).unwrap() as u8)
                    byte_index = byte_index + 1:usize
                }
            }
            auto PostgresParam::Int64(value) => {
                auto rendered = string::from_i64(value)
                append_i32_be(body, rendered.len() as i32)
                append_text(body, rendered.as_str())
            }
            auto PostgresParam::Bool(value) => {
                if value {
                    append_i32_be(body, 4:i32)
                    append_text(body, "true")
                } else {
                    append_i32_be(body, 5:i32)
                    append_text(body, "false")
                }
            }
        }
        index = index + 1:usize
    }
    append_u16_be(body, 0:u16)
    return append_typed_frame(out, 'B' as u8, cede body)
}

fn append_execute_message(out#: Vec<u8>) -> Result<(), PostgresError> {
    auto body# = Vec<u8>::new()
    append_cstring(body, "")
    append_u32_be(body, 0:u32)
    return append_typed_frame(out, 'E' as u8, cede body)
}

fn ssl_request_message() -> Vec<u8> {
    auto frame# = Vec<u8>::with_capacity(8:usize)
    append_u32_be(frame, 8:u32)
    append_u32_be(frame, 80877103:u32)
    return frame
}

fn sasl_initial_message(mechanism: str, initial: str) -> Result<Vec<u8>, PostgresError> {
    if contains_nul(mechanism) || contains_nul(initial) {
        return Result<Vec<u8>, PostgresError>::Err(error("authentication", 0:usize, "SASL message must not contain NUL"))
    }
    auto body# = Vec<u8>::new()
    append_cstring(body, mechanism)
    append_u32_be(body, initial.len() as u32)
    append_text(body, initial)
    if body.len() + 5:usize > MAX_FRAME_BYTES {
        return Result<Vec<u8>, PostgresError>::Err(limit_error(0:usize, "SASL initial response exceeds frame limit"))
    }
    auto frame# = Vec<u8>::with_capacity(body.len() + 5:usize)
    frame#.push('p' as u8)
    append_u32_be(frame, (body.len() + 4:usize) as u32)
    auto index#: usize = 0:usize
    loop index < body.len() {
        frame#.push(body.get(index))
        index = index + 1:usize
    }
    return Result<Vec<u8>, PostgresError>::Ok(cede frame)
}

fn sasl_response_message(response: str) -> Result<Vec<u8>, PostgresError> {
    if contains_nul(response) {
        return Result<Vec<u8>, PostgresError>::Err(error("authentication", 0:usize, "SASL response must not contain NUL"))
    }
    if response.len() + 5:usize > MAX_FRAME_BYTES {
        return Result<Vec<u8>, PostgresError>::Err(limit_error(0:usize, "SASL response exceeds frame limit"))
    }
    auto frame# = Vec<u8>::with_capacity(response.len() + 5:usize)
    frame#.push('p' as u8)
    append_u32_be(frame, (response.len() + 4:usize) as u32)
    append_text(frame, response)
    return Result<Vec<u8>, PostgresError>::Ok(cede frame)
}

fn append_bytes(target#: Vec<u8>, source: Vec<u8>) {
    auto index#: usize = 0:usize
    loop index < source.len() {
        target#.push(source.get(index))
        index = index + 1:usize
    }
}

fn suffix_from(input: Vec<u8>, start: usize) -> Vec<u8> {
    auto remaining# = Vec<u8>::with_capacity(input.len() - start)
    auto index#: usize = start
    loop index < input.len() {
        remaining#.push(input.get(index))
        index = index + 1:usize
    }
    return remaining
}

fn add_query_bytes(current: usize, additional: usize, maximum: usize) -> Result<usize, PostgresError> {
    if additional > maximum || current > maximum - additional {
        return Result<usize, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query result exceeds byte limit"))
    }
    return Result<usize, PostgresError>::Ok(current + additional)
}

fn data_row_bytes(values: Vec<Option<Bytes>>) -> usize {
    auto total#: usize = 0:usize
    auto index#: usize = 0:usize
    loop index < values.len() {
        auto *value = values.get_ref(index)
        match value {
            auto Option<Bytes>::Some(&bytes) => total = total + bytes.len()
            _ => {}
        }
        index = index + 1:usize
    }
    return total
}

fn contains_mechanism(values: Vec<string>, expected: str) -> bool {
    auto index#: usize = 0:usize
    loop index < values.len() {
        if values.get(index).equals(expected) { return true }
        index = index + 1:usize
    }
    return false
}

fn upgrade_stream_async(tcp#: TcpStream, config: PostgresConfig) -> async Result<AsyncStream, PostgresError> {
    match config.tls_mode {
        auto PostgresTlsMode::DisableForTrustedLocal() => {
            return Result<AsyncStream, PostgresError>::Ok(AsyncStream::from_tcp(tcp#.take()))
        }
        _ => {}
    }

    auto request = ssl_request_message()
    auto written = tcp#.write_from_async(cede request, config.timeout_ms).await
    if written.is_err() {
        auto failure# = written.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _returned = failure#.take_buffer()
        tcp#.close()
        return Result<AsyncStream, PostgresError>::Err(io_error(message.as_str()))
    }
    auto completed# = written.unwrap()
    auto complete = completed.complete
    auto _returned = completed#.take_buffer()
    if !complete {
        tcp#.close()
        return Result<AsyncStream, PostgresError>::Err(io_error("PostgreSQL SSLRequest write was incomplete"))
    }

    auto response# = Vec<u8>::with_capacity(1:usize)
    auto read = tcp#.read_into_async(cede response, 1:usize, config.timeout_ms).await
    if read.is_err() {
        auto failure# = read.unwrap_err()
        auto message = string::from(failure.message.as_str())
        auto _returned = failure#.take_buffer()
        tcp#.close()
        return Result<AsyncStream, PostgresError>::Err(io_error(message.as_str()))
    }
    auto received# = read.unwrap()
    auto bytes_read = received.bytes_read
    auto eof = received.eof
    auto response_bytes = received#.take_buffer()
    if eof || bytes_read != 1:usize {
        tcp#.close()
        return Result<AsyncStream, PostgresError>::Err(io_error("PostgreSQL server closed during SSL negotiation"))
    }
    if response_bytes.get(0:usize) != 'S' as u8 {
        tcp#.close()
        return Result<AsyncStream, PostgresError>::Err(error("tls", 0:usize, "PostgreSQL server refused required TLS"))
    }

    auto host = string::from(config.server_name.as_str())
    auto upgraded = match config.tls_mode {
        auto PostgresTlsMode::RequireVerified() => {
            if config.ca_file.len() > 0:usize {
                pass TlsStream::connect_with_ca_file_async_timeout(tcp, host, string::from(config.ca_file.as_str()), config.timeout_ms).await
            } else {
                pass TlsStream::connect_with_verify_async_timeout(tcp, host, true, config.timeout_ms).await
            }
        }
        auto PostgresTlsMode::InsecureForTest() => pass TlsStream::connect_with_verify_async_timeout(tcp, host, false, config.timeout_ms).await
        auto PostgresTlsMode::DisableForTrustedLocal() => return Result<AsyncStream, PostgresError>::Err(error("tls", 0:usize, "unreachable plaintext TLS branch"))
    }
    if upgraded.is_err() {
        auto failure = upgraded.unwrap_err()
        return Result<AsyncStream, PostgresError>::Err(io_error(failure.as_str()))
    }
    return Result<AsyncStream, PostgresError>::Ok(cede upgraded.unwrap())
}

impl PostgresConfig {
    fn copy_for_connection(self) -> PostgresConfig {
        return PostgresConfig(
            address = self.address,
            server_name = string::from(self.server_name.as_str()),
            user = string::from(self.user.as_str()),
            database = string::from(self.database.as_str()),
            password = string::from(self.password.as_str()),
            ca_file = string::from(self.ca_file.as_str()),
            timeout_ms = self.timeout_ms,
            tls_mode = self.tls_mode,
            auth_policy = self.auth_policy
        )
    }

    pub fn secure(address: SocketAddrV4, server_name: str, user: str,
                  database: str, password: str) -> Result<PostgresConfig, PostgresError> {
        if server_name.len() == 0:usize || user.len() == 0:usize || database.len() == 0:usize {
            return Result<PostgresConfig, PostgresError>::Err(error("input", 0:usize, "PostgreSQL server name, user, and database must not be empty"))
        }
        return Result<PostgresConfig, PostgresError>::Ok(PostgresConfig(
            address = address,
            server_name = string::from(server_name),
            user = string::from(user),
            database = string::from(database),
            password = string::from(password),
            ca_file = string::from(""),
            timeout_ms = 10000:i32,
            tls_mode = PostgresTlsMode::RequireVerified(),
            auth_policy = PostgresAuthPolicy::ScramOnly()
        ))
    }

    // Verified PostgreSQL deployments commonly use a private CA. Supplying
    // that CA remains a verified TLS path; it is not the insecure test mode.
    pub fn secure_with_ca_file(address: SocketAddrV4, server_name: str,
                               user: str, database: str, password: str,
                               ca_file: str) -> Result<PostgresConfig, PostgresError> {
        if ca_file.len() == 0:usize {
            return Result<PostgresConfig, PostgresError>::Err(error("input", 0:usize, "PostgreSQL CA file must not be empty"))
        }
        auto configured = PostgresConfig::secure(address, server_name, user, database, password)
        if configured.is_err() { return Result<PostgresConfig, PostgresError>::Err(configured.unwrap_err()) }
        auto config# = configured.unwrap()
        config.ca_file = string::from(ca_file)
        return Result<PostgresConfig, PostgresError>::Ok(cede config)
    }

    // This constructor is intentionally explicit: it exists for a local test
    // server or a separately secured loopback deployment, never as fallback.
    pub fn trusted_local(address: SocketAddrV4, user: str,
                         database: str) -> Result<PostgresConfig, PostgresError> {
        if user.len() == 0:usize || database.len() == 0:usize {
            return Result<PostgresConfig, PostgresError>::Err(error("input", 0:usize, "PostgreSQL user and database must not be empty"))
        }
        return Result<PostgresConfig, PostgresError>::Ok(PostgresConfig(
            address = address,
            server_name = string::from("localhost"),
            user = string::from(user),
            database = string::from(database),
            password = string::from(""),
            ca_file = string::from(""),
            timeout_ms = 10000:i32,
            tls_mode = PostgresTlsMode::DisableForTrustedLocal(),
            auth_policy = PostgresAuthPolicy::AllowTrustForLocal()
        ))
    }

    pub fn insecure_tls_for_test(address: SocketAddrV4, server_name: str,
                                 user: str, database: str) -> Result<PostgresConfig, PostgresError> {
        auto configured = PostgresConfig::trusted_local(address, user, database)
        if configured.is_err() { return Result<PostgresConfig, PostgresError>::Err(configured.unwrap_err()) }
        auto config# = configured.unwrap()
        if server_name.len() == 0:usize { return Result<PostgresConfig, PostgresError>::Err(error("input", 0:usize, "PostgreSQL server name must not be empty")) }
        config.server_name = string::from(server_name)
        config.tls_mode = PostgresTlsMode::InsecureForTest()
        return Result<PostgresConfig, PostgresError>::Ok(cede config)
    }

    pub fn set_timeout(self#, timeout_ms: i32) -> Result<(), PostgresError> {
        if timeout_ms <= 0:i32 { return Result<(), PostgresError>::Err(error("input", 0:usize, "PostgreSQL timeout must be positive")) }
        self.timeout_ms = timeout_ms
        return Result<(), PostgresError>::Ok(())
    }
}

impl PostgresQueryLimits {
    pub fn new(max_result_sets: usize, max_rows: usize, max_bytes: usize) -> Result<PostgresQueryLimits, PostgresError> {
        if max_result_sets == 0:usize {
            return Result<PostgresQueryLimits, PostgresError>::Err(error("input", 0:usize, "PostgreSQL query max_result_sets must be positive"))
        }
        if max_bytes == 0:usize {
            return Result<PostgresQueryLimits, PostgresError>::Err(error("input", 0:usize, "PostgreSQL query max_bytes must be positive"))
        }
        return Result<PostgresQueryLimits, PostgresError>::Ok(PostgresQueryLimits(
            max_result_sets = max_result_sets,
            max_rows = max_rows,
            max_bytes = max_bytes
        ))
    }
}

impl PostgresColumn@encap {
    pub name
    pub type_oid
    fn drop(self#) {}

    pub fn clone(self) -> PostgresColumn {
        return PostgresColumn(name = string::from(self.name.as_str()), type_oid = self.type_oid)
    }
}

impl PostgresQueryResult@encap {
    pub columns#
    pub rows#
    pub command_tag
    fn drop(self#) {}

    pub fn clone(self) -> PostgresQueryResult {
        auto columns# = Vec<PostgresColumn>::with_capacity(self.columns.len())
        auto column_index#: usize = 0:usize
        loop column_index < self.columns.len() {
            columns#.push(cede self.columns.get(column_index).clone())
            column_index = column_index + 1:usize
        }

        auto rows# = Vec<Vec<Option<Bytes>>>::with_capacity(self.rows.len())
        auto row_index#: usize = 0:usize
        loop row_index < self.rows.len() {
            auto *source_row = self.rows.get_ref(row_index)
            auto copied_row# = Vec<Option<Bytes>>::with_capacity(source_row.len())
            auto value_index#: usize = 0:usize
            loop value_index < source_row.len() {
                auto *source_value = source_row.get_ref(value_index)
                match source_value {
                    auto Option<Bytes>::Some(&bytes) => copied_row#.push(cede Option<Bytes>::Some(bytes.clone()))
                    _ => copied_row#.push(cede Option<Bytes>::None)
                }
                value_index = value_index + 1:usize
            }
            rows#.push(cede copied_row)
            row_index = row_index + 1:usize
        }

        return PostgresQueryResult(
            columns = cede columns,
            rows = cede rows,
            command_tag = string::from(self.command_tag.as_str())
        )
    }
}

impl PostgresClient@encap {
    fn drop(self#) {
        self#.close()
    }

}

impl PostgresClient {
    pub fn is_closed(self) -> bool {
        return self.closed
    }

    pub fn close(self#) {
        if !self.closed {
            self.stream#.close()
            self.closed = true
        }
    }

    fn poison(self#) {
        self#.close()
    }

    fn write_frame_async(self#, cede frame: Vec<u8>) -> async Result<(), PostgresError> {
        auto written = self.stream#.write_from_async(cede frame, self.timeout_ms).await
        if written.is_err() {
            auto failure# = written.unwrap_err()
            auto message = string::from(failure.message.as_str())
            auto _returned = failure#.take_buffer()
            return Result<(), PostgresError>::Err(io_error(message.as_str()))
        }
        auto completed# = written.unwrap()
        auto complete = completed.complete
        auto _returned = completed#.take_buffer()
        if !complete { return Result<(), PostgresError>::Err(io_error("PostgreSQL frame write was incomplete")) }
        return Result<(), PostgresError>::Ok(())
    }

    fn read_frame_async(self#) -> async Result<PostgresMessage, PostgresError> {
        auto chunk# = Vec<u8>::with_capacity(4096:usize)
        loop true {
            auto decoded = decode_backend_one(self.receive)
            if decoded.is_err() { return Result<PostgresMessage, PostgresError>::Err(decoded.unwrap_err()) }
            match cede decoded.unwrap() {
                auto PostgresDecode::Complete('frame) => {
                    self.receive = suffix_from(self.receive, 'frame.consumed)
                    return Result<PostgresMessage, PostgresError>::Ok(cede 'frame.message)
                }
                auto PostgresDecode::NeedMore() => {}
            }
            auto read = self.stream#.read_into_async(cede chunk, 4096:usize, self.timeout_ms).await
            if read.is_err() {
                auto failure# = read.unwrap_err()
                auto message = string::from(failure.message.as_str())
                auto _returned = failure#.take_buffer()
                return Result<PostgresMessage, PostgresError>::Err(io_error(message.as_str()))
            }
            auto received# = read.unwrap()
            auto bytes_read = received.bytes_read
            auto eof = received.eof
            chunk = received#.take_buffer()
            if eof || bytes_read == 0:usize {
                return Result<PostgresMessage, PostgresError>::Err(io_error("PostgreSQL connection closed before a complete frame"))
            }
            append_bytes(self.receive, chunk)
        }
        return Result<PostgresMessage, PostgresError>::Err(io_error("PostgreSQL receive loop exited unexpectedly"))
    }

    // An ErrorResponse is usable only after the protocol reaches its next
    // ReadyForQuery boundary. Do not expose the client to another command
    // until that boundary has been consumed.
    fn drain_error_to_ready_async(self#) -> async Result<(), PostgresError> {
        loop true {
            auto received = self#.read_frame_async().await
            if received.is_err() { return Result<(), PostgresError>::Err(received.unwrap_err()) }
            match cede received.unwrap() {
                auto PostgresMessage::ReadyForQuery(_) => return Result<(), PostgresError>::Ok(())
                auto PostgresMessage::Notice(_) => {}
                auto PostgresMessage::ParameterStatus(_, _) => {}
                _ => return Result<(), PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message while draining server error"))
            }
        }
        return Result<(), PostgresError>::Err(io_error("PostgreSQL error drain loop exited unexpectedly"))
    }

    fn authenticate_async(self#, config: PostgresConfig) -> async Result<(), PostgresError> {
        auto startup = startup_message(config.user.as_str(), config.database.as_str())
        if startup.is_err() { return Result<(), PostgresError>::Err(startup.unwrap_err()) }
        auto sent = self#.write_frame_async(cede startup.unwrap()).await
        if sent.is_err() { return Result<(), PostgresError>::Err(sent.unwrap_err()) }

        auto scram_started# = false
        auto scram_verified# = false
        auto authenticated# = false
        auto first# = Option<ScramClientFirst>::None
        auto final_message# = Option<ScramClientFinal>::None
        loop true {
            auto received = self#.read_frame_async().await
            if received.is_err() { return Result<(), PostgresError>::Err(received.unwrap_err()) }
            match cede received.unwrap() {
                auto PostgresMessage::AuthenticationSasl('mechanisms) => {
                    if scram_started || !contains_mechanism('mechanisms, "SCRAM-SHA-256") {
                        return Result<(), PostgresError>::Err(error("authentication", 0:usize, "server did not offer usable SCRAM-SHA-256"))
                    }
                    auto nonce = token::url_safe_token(18:usize)
                    if nonce.is_err() { return Result<(), PostgresError>::Err(error("authentication", 0:usize, nonce.unwrap_err().as_str())) }
                    auto client_first = scram_client_first(config.user.as_str(), nonce.unwrap().as_str())
                    if client_first.is_err() { return Result<(), PostgresError>::Err(client_first.unwrap_err()) }
                    auto first_value = client_first.unwrap()
                    auto initial = sasl_initial_message("SCRAM-SHA-256", first_value.message.as_str())
                    if initial.is_err() { return Result<(), PostgresError>::Err(initial.unwrap_err()) }
                    auto write = self#.write_frame_async(cede initial.unwrap()).await
                    if write.is_err() { return Result<(), PostgresError>::Err(write.unwrap_err()) }
                    first = Option<ScramClientFirst>::Some(cede first_value)
                    scram_started = true
                }
                auto PostgresMessage::AuthenticationSaslContinue('server_first) => {
                    if !scram_started || final_message.is_some() {
                        return Result<(), PostgresError>::Err(error("authentication", 0:usize, "unexpected SCRAM server-first message"))
                    }
                    match cede first {
                        auto Option::Some('first_value) => {
                            auto client_final = scram_client_final(config.password.as_str(), 'first_value.bare.as_str(), 'server_first.as_str())
                            if client_final.is_err() { return Result<(), PostgresError>::Err(client_final.unwrap_err()) }
                            auto final_value = client_final.unwrap()
                            auto response = sasl_response_message(final_value.message.as_str())
                            if response.is_err() { return Result<(), PostgresError>::Err(response.unwrap_err()) }
                            auto write = self#.write_frame_async(cede response.unwrap()).await
                            if write.is_err() { return Result<(), PostgresError>::Err(write.unwrap_err()) }
                            first = Option<ScramClientFirst>::None
                            final_message = Option<ScramClientFinal>::Some(cede final_value)
                        }
                        auto Option::None => return Result<(), PostgresError>::Err(error("authentication", 0:usize, "unexpected SCRAM server-first message"))
                    }
                }
                auto PostgresMessage::AuthenticationSaslFinal('server_final) => {
                    match cede final_message {
                        auto Option::Some('final_value) => {
                            auto verified = 'final_value.verify_server_final('server_final.as_str())
                            if verified.is_err() {
                                return Result<(), PostgresError>::Err(verified.unwrap_err())
                            }
                            if !verified.unwrap() {
                                return Result<(), PostgresError>::Err(error("authentication", 0:usize, "SCRAM server verifier did not match"))
                            }
                            final_message = Option<ScramClientFinal>::None
                        }
                        auto Option::None => return Result<(), PostgresError>::Err(error("authentication", 0:usize, "unexpected SCRAM server-final message"))
                    }
                    scram_verified = true
                }
                auto PostgresMessage::AuthenticationOk() => {
                    if config.auth_policy == PostgresAuthPolicy::ScramOnly() && !scram_verified {
                        return Result<(), PostgresError>::Err(error("authentication", 0:usize, "server authenticated without verified SCRAM-SHA-256"))
                    }
                    authenticated = true
                }
                auto PostgresMessage::AuthenticationCleartextPassword() => {
                    return Result<(), PostgresError>::Err(error("authentication", 0:usize, "cleartext PostgreSQL authentication is refused"))
                }
                auto PostgresMessage::AuthenticationMd5() => {
                    return Result<(), PostgresError>::Err(error("authentication", 0:usize, "MD5 PostgreSQL authentication is refused"))
                }
                auto PostgresMessage::AuthenticationUnsupported(_) => {
                    return Result<(), PostgresError>::Err(error("authentication", 0:usize, "unsupported PostgreSQL authentication method"))
                }
                auto PostgresMessage::Error('server_error) => {
                    return Result<(), PostgresError>::Err(server_error('server_error))
                }
                auto PostgresMessage::ReadyForQuery(_) => {
                    if !authenticated { return Result<(), PostgresError>::Err(error("authentication", 0:usize, "ReadyForQuery arrived before authentication completed")) }
                    return Result<(), PostgresError>::Ok(())
                }
                _ => {}
            }
        }
        return Result<(), PostgresError>::Err(io_error("PostgreSQL authentication loop exited unexpectedly"))
    }

    pub fn connect_async(cede config: PostgresConfig) -> async Result<PostgresClient, PostgresError> {
        auto config# = cede config
        if config.timeout_ms <= 0:i32 {
            return Result<PostgresClient, PostgresError>::Err(error("input", 0:usize, "PostgreSQL timeout must be positive"))
        }
        auto connected = TcpStream::connect_async_timeout(config.address, config.timeout_ms).await
        if connected.is_err() {
            return Result<PostgresClient, PostgresError>::Err(io_error(connected.unwrap_err().as_str()))
        }
        auto tcp# = connected.unwrap()
        auto upgraded = upgrade_stream_async(tcp, config).await
        if upgraded.is_err() {
            return Result<PostgresClient, PostgresError>::Err(upgraded.unwrap_err())
        }
        auto client# = PostgresClient(
            stream = cede upgraded.unwrap(),
            receive = Vec<u8>::with_capacity(4096:usize),
            timeout_ms = config.timeout_ms,
            closed = false,
            next_statement_id = 1:u32
        )
        auto authenticated = client#.authenticate_async(config).await
        if authenticated.is_err() {
            auto failure = authenticated.unwrap_err()
            client#.poison()
            return Result<PostgresClient, PostgresError>::Err(failure)
        }
        return Result<PostgresClient, PostgresError>::Ok(cede client)
    }

    // Prepare uses Parse + Describe(statement) + Sync, so the returned
    // statement has passed a server-side syntax/type check before a Bind can
    // use it. Statement names are generated per connection and never derive
    // from SQL supplied by the caller.
    pub fn prepare_async(self#, sql: str, cede param_type_oids: Vec<u32>) -> async Result<PostgresStatement, PostgresError> {
        if self.closed {
            return Result<PostgresStatement, PostgresError>::Err(error("connection", 0:usize, "PostgreSQL client is closed"))
        }
        auto parameter_count = param_type_oids.len()
        auto name# = string::from("toka_stmt_")
        name#.push_str(string::from_i64(self.next_statement_id as i64).as_str())
        if self.next_statement_id == 4294967295:u32 {
            self.next_statement_id = 1:u32
        } else {
            self.next_statement_id = self.next_statement_id + 1:u32
        }

        auto request# = Vec<u8>::new()
        auto parsed = append_parse_message(request, name.as_str(), sql, cede param_type_oids)
        if parsed.is_err() { return Result<PostgresStatement, PostgresError>::Err(parsed.unwrap_err()) }
        auto described = append_describe_statement_message(request, name.as_str())
        if described.is_err() { return Result<PostgresStatement, PostgresError>::Err(described.unwrap_err()) }
        auto synced = append_sync_message(request)
        if synced.is_err() { return Result<PostgresStatement, PostgresError>::Err(synced.unwrap_err()) }
        auto sent = self#.write_frame_async(cede request).await
        if sent.is_err() {
            self#.poison()
            return Result<PostgresStatement, PostgresError>::Err(sent.unwrap_err())
        }

        auto parse_complete# = false
        auto parameter_description# = false
        auto result_description# = false
        auto result_columns# = Vec<PostgresColumn>::new()
        loop true {
            auto received = self#.read_frame_async().await
            if received.is_err() {
                self#.poison()
                return Result<PostgresStatement, PostgresError>::Err(received.unwrap_err())
            }
            match cede received.unwrap() {
                auto PostgresMessage::ParseComplete() => {
                    if parse_complete {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "duplicate ParseComplete"))
                    }
                    parse_complete = true
                }
                auto PostgresMessage::ParameterDescription('oids) => {
                    if !parse_complete || parameter_description || 'oids.len() != parameter_count {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL ParameterDescription"))
                    }
                    parameter_description = true
                }
                auto PostgresMessage::RowDescription('columns) => {
                    if !parse_complete || !parameter_description || result_description {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL RowDescription while preparing"))
                    }
                    result_columns = cede 'columns
                    result_description = true
                }
                auto PostgresMessage::NoData() => {
                    if !parse_complete || !parameter_description || result_description {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL NoData while preparing"))
                    }
                    result_description = true
                }
                auto PostgresMessage::Error('server) => {
                    auto failure = server_error('server)
                    auto drained = self#.drain_error_to_ready_async().await
                    if drained.is_err() {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(drained.unwrap_err())
                    }
                    return Result<PostgresStatement, PostgresError>::Err(failure)
                }
                auto PostgresMessage::ReadyForQuery(_) => {
                    if !parse_complete || !parameter_description || !result_description {
                        self#.poison()
                        return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "ReadyForQuery arrived before prepared statement metadata"))
                    }
                    return Result<PostgresStatement, PostgresError>::Ok(PostgresStatement(
                        name = cede name,
                        parameter_count = parameter_count,
                        result_columns = cede result_columns,
                        closed = false
                    ))
                }
                auto PostgresMessage::Notice(_) => {}
                auto PostgresMessage::ParameterStatus(_, _) => {}
                _ => {
                    self#.poison()
                    return Result<PostgresStatement, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message while preparing"))
                }
            }
        }
        return Result<PostgresStatement, PostgresError>::Err(io_error("PostgreSQL prepare loop exited unexpectedly"))
    }

    // Executes PostgreSQL's simple-query protocol serially. One SQL string
    // may contain multiple statements, so every CommandComplete produces a
    // separate owned result. Transport or sequence failures poison the
    // connection; an ordinary server ErrorResponse is drained through
    // ReadyForQuery and leaves it reusable.
    pub fn simple_query_async(self#, sql: str, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        if self.closed {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("connection", 0:usize, "PostgreSQL client is closed"))
        }

        auto query = simple_query_message(sql)
        if query.is_err() { return Result<Vec<PostgresQueryResult>, PostgresError>::Err(query.unwrap_err()) }
        auto sent = self#.write_frame_async(cede query.unwrap()).await
        if sent.is_err() {
            self#.poison()
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(sent.unwrap_err())
        }

        auto results# = Vec<PostgresQueryResult>::new()
        auto current_columns# = Vec<PostgresColumn>::new()
        auto current_rows# = Vec<Vec<Option<Bytes>>>::new()
        auto has_row_description# = false
        auto total_rows#: usize = 0:usize
        auto total_bytes#: usize = 0:usize

        loop true {
            auto received = self#.read_frame_async().await
            if received.is_err() {
                self#.poison()
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(received.unwrap_err())
            }
            match cede received.unwrap() {
                auto PostgresMessage::RowDescription('columns) => {
                    if has_row_description {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "RowDescription arrived before the prior CommandComplete"))
                    }
                    current_columns = cede 'columns
                    current_rows = Vec<Vec<Option<Bytes>>>::new()
                    has_row_description = true
                }
                auto PostgresMessage::DataRow('values) => {
                    if !has_row_description || 'values.len() != current_columns.len() {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "DataRow does not match an active RowDescription"))
                    }
                    if total_rows >= limits.max_rows {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query result exceeds row limit"))
                    }
                    auto row_bytes = data_row_bytes('values)
                    auto updated_bytes = add_query_bytes(total_bytes, row_bytes, limits.max_bytes)
                    if updated_bytes.is_err() {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(updated_bytes.unwrap_err())
                    }
                    total_bytes = updated_bytes.unwrap()
                    total_rows = total_rows + 1:usize
                    current_rows#.push(cede 'values)
                }
                auto PostgresMessage::CommandComplete('tag) => {
                    if results.len() >= limits.max_result_sets {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query result exceeds result-set limit"))
                    }
                    auto updated_bytes = add_query_bytes(total_bytes, 'tag.len(), limits.max_bytes)
                    if updated_bytes.is_err() {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(updated_bytes.unwrap_err())
                    }
                    total_bytes = updated_bytes.unwrap()
                    results#.push(cede PostgresQueryResult(
                        columns = cede current_columns,
                        rows = cede current_rows,
                        command_tag = cede 'tag
                    ))
                    current_columns = Vec<PostgresColumn>::new()
                    current_rows = Vec<Vec<Option<Bytes>>>::new()
                    has_row_description = false
                }
                auto PostgresMessage::Error('server_error) => {
                    auto failure = server_error('server_error)
                    auto drained = self#.drain_error_to_ready_async().await
                    if drained.is_err() {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(drained.unwrap_err())
                    }
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Err(failure)
                }
                auto PostgresMessage::ReadyForQuery(_) => {
                    if has_row_description {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "ReadyForQuery arrived before CommandComplete"))
                    }
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Ok(cede results)
                }
                auto PostgresMessage::Notice(_) => {}
                auto PostgresMessage::ParameterStatus(_, _) => {}
                auto PostgresMessage::Unknown(tag, 'body) => {
                    if tag != 'I' as u8 || 'body.len() != 0:usize {
                        self#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message during simple query"))
                    }
                }
                _ => {
                    self#.poison()
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message during simple query"))
                }
            }
        }
        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(io_error("PostgreSQL simple-query loop exited unexpectedly"))
    }
}

impl PostgresParam@encap {
    fn drop(self#) {}

    pub fn clone(self) -> PostgresParam {
        match self {
            auto PostgresParam::Null() => return PostgresParam::Null()
            auto PostgresParam::Text(&value) => return PostgresParam::Text(string::from(value.as_str()))
            auto PostgresParam::Bytes(&value) => return PostgresParam::Bytes(value.clone())
            auto PostgresParam::Int64(value) => return PostgresParam::Int64(value)
            auto PostgresParam::Bool(value) => return PostgresParam::Bool(value)
        }
    }
}

impl PostgresStatement@encap {
    pub name
    pub parameter_count
    pub closed
    fn drop(self#) {}

}

impl PostgresStatement {
    pub fn is_closed(self) -> bool {
        return self.closed
    }

    // Bind + Execute + Sync is one serial exchange. All values are owned by
    // the outgoing frame before the first await, so parameter memory remains
    // valid even if the transport suspends midway through a write.
    pub fn execute_async(self#, client#: PostgresClient, cede params: Vec<PostgresParam>, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        if self.closed {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("statement", 0:usize, "PostgreSQL statement is closed"))
        }
        if client.closed {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("connection", 0:usize, "PostgreSQL client is closed"))
        }
        if params.len() != self.parameter_count {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("input", 0:usize, "PostgreSQL parameter count does not match prepared statement"))
        }

        auto request# = Vec<u8>::new()
        auto bound = append_bind_message(request, self.name.as_str(), cede params)
        if bound.is_err() { return Result<Vec<PostgresQueryResult>, PostgresError>::Err(bound.unwrap_err()) }
        auto executed = append_execute_message(request)
        if executed.is_err() { return Result<Vec<PostgresQueryResult>, PostgresError>::Err(executed.unwrap_err()) }
        auto synced = append_sync_message(request)
        if synced.is_err() { return Result<Vec<PostgresQueryResult>, PostgresError>::Err(synced.unwrap_err()) }
        auto sent = client#.write_frame_async(cede request).await
        if sent.is_err() {
            client#.poison()
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(sent.unwrap_err())
        }

        auto bind_complete# = false
        auto results# = Vec<PostgresQueryResult>::new()
        auto current_columns# = Vec<PostgresColumn>::new()
        auto current_rows# = Vec<Vec<Option<Bytes>>>::new()
        auto has_row_description# = false
        auto total_rows#: usize = 0:usize
        auto total_bytes#: usize = 0:usize

        loop true {
            auto received = client#.read_frame_async().await
            if received.is_err() {
                client#.poison()
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(received.unwrap_err())
            }
            match cede received.unwrap() {
                auto PostgresMessage::BindComplete() => {
                    if bind_complete {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "duplicate BindComplete"))
                    }
                    bind_complete = true
                    if self.result_columns.len() > 0:usize {
                        current_columns = self.result_columns.clone()
                        has_row_description = true
                    }
                }
                auto PostgresMessage::RowDescription('columns) => {
                    if !bind_complete || has_row_description {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "unexpected RowDescription during prepared execution"))
                    }
                    current_columns = cede 'columns
                    current_rows = Vec<Vec<Option<Bytes>>>::new()
                    has_row_description = true
                }
                auto PostgresMessage::DataRow('values) => {
                    if !bind_complete || !has_row_description || 'values.len() != current_columns.len() {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "DataRow does not match an active prepared result"))
                    }
                    if total_rows >= limits.max_rows {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query result exceeds row limit"))
                    }
                    auto row_bytes = data_row_bytes('values)
                    auto updated_bytes = add_query_bytes(total_bytes, row_bytes, limits.max_bytes)
                    if updated_bytes.is_err() {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(updated_bytes.unwrap_err())
                    }
                    total_bytes = updated_bytes.unwrap()
                    total_rows = total_rows + 1:usize
                    current_rows#.push(cede 'values)
                }
                auto PostgresMessage::CommandComplete('tag) => {
                    if !bind_complete || results.len() >= limits.max_result_sets {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(limit_error(0:usize, "PostgreSQL query result exceeds result-set limit"))
                    }
                    auto updated_bytes = add_query_bytes(total_bytes, 'tag.len(), limits.max_bytes)
                    if updated_bytes.is_err() {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(updated_bytes.unwrap_err())
                    }
                    total_bytes = updated_bytes.unwrap()
                    results#.push(cede PostgresQueryResult(
                        columns = cede current_columns,
                        rows = cede current_rows,
                        command_tag = cede 'tag
                    ))
                    current_columns = Vec<PostgresColumn>::new()
                    current_rows = Vec<Vec<Option<Bytes>>>::new()
                    has_row_description = false
                }
                auto PostgresMessage::PortalSuspended() => {
                    client#.poison()
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "prepared execution unexpectedly suspended a portal"))
                }
                auto PostgresMessage::Error('server) => {
                    auto failure = server_error('server)
                    auto drained = client#.drain_error_to_ready_async().await
                    if drained.is_err() {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(drained.unwrap_err())
                    }
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Err(failure)
                }
                auto PostgresMessage::ReadyForQuery(_) => {
                    if !bind_complete || has_row_description {
                        client#.poison()
                        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "ReadyForQuery arrived before prepared CommandComplete"))
                    }
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Ok(cede results)
                }
                auto PostgresMessage::Notice(_) => {}
                auto PostgresMessage::ParameterStatus(_, _) => {}
                _ => {
                    client#.poison()
                    return Result<Vec<PostgresQueryResult>, PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message during prepared execution"))
                }
            }
        }
        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(io_error("PostgreSQL prepared execution loop exited unexpectedly"))
    }

    pub fn close_async(self#, client#: PostgresClient) -> async Result<(), PostgresError> {
        if self.closed { return Result<(), PostgresError>::Ok(()) }
        if client.closed { return Result<(), PostgresError>::Err(error("connection", 0:usize, "PostgreSQL client is closed")) }
        auto request# = Vec<u8>::new()
        auto closed = append_close_statement_message(request, self.name.as_str())
        if closed.is_err() { return Result<(), PostgresError>::Err(closed.unwrap_err()) }
        auto synced = append_sync_message(request)
        if synced.is_err() { return Result<(), PostgresError>::Err(synced.unwrap_err()) }
        auto sent = client#.write_frame_async(cede request).await
        if sent.is_err() { client#.poison(); return Result<(), PostgresError>::Err(sent.unwrap_err()) }

        auto close_complete# = false
        loop true {
            auto received = client#.read_frame_async().await
            if received.is_err() { client#.poison(); return Result<(), PostgresError>::Err(received.unwrap_err()) }
            match cede received.unwrap() {
                auto PostgresMessage::CloseComplete() => {
                    if close_complete { client#.poison(); return Result<(), PostgresError>::Err(protocol_error(0:usize, "duplicate CloseComplete")) }
                    close_complete = true
                }
                auto PostgresMessage::Error('server) => {
                    auto failure = server_error('server)
                    auto drained = client#.drain_error_to_ready_async().await
                    if drained.is_err() { client#.poison(); return Result<(), PostgresError>::Err(drained.unwrap_err()) }
                    return Result<(), PostgresError>::Err(failure)
                }
                auto PostgresMessage::ReadyForQuery(_) => {
                    if !close_complete { client#.poison(); return Result<(), PostgresError>::Err(protocol_error(0:usize, "ReadyForQuery arrived before CloseComplete")) }
                    self.closed = true
                    return Result<(), PostgresError>::Ok(())
                }
                auto PostgresMessage::Notice(_) => {}
                auto PostgresMessage::ParameterStatus(_, _) => {}
                _ => { client#.poison(); return Result<(), PostgresError>::Err(protocol_error(0:usize, "unexpected PostgreSQL message while closing prepared statement")) }
            }
        }
        return Result<(), PostgresError>::Err(io_error("PostgreSQL statement close loop exited unexpectedly"))
    }
}

// A pool cannot safely hand a session-local PostgresStatement to its caller:
// the caller could retain it after the lease is returned. This one-shot form
// keeps Parse, Bind/Execute, and Close inside the exclusive owner instead.
fn query_params_once_async(client#: PostgresClient, sql: str,
                           cede param_type_oids: Vec<u32>,
                           cede params: Vec<PostgresParam>,
                           limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
    auto prepared = client#.prepare_async(sql, cede param_type_oids).await
    if prepared.is_err() {
        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(prepared.unwrap_err())
    }
    auto statement# = prepared.unwrap()
    auto executed = statement#.execute_async(client, cede params, limits).await
    if executed.is_err() {
        auto failure = executed.unwrap_err()
        if !client.is_closed() {
            auto closed = statement#.close_async(client).await
            if closed.is_err() { client#.close() }
        }
        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(failure)
    }
    auto closed = statement#.close_async(client).await
    if closed.is_err() {
        client#.close()
        return Result<Vec<PostgresQueryResult>, PostgresError>::Err(closed.unwrap_err())
    }
    return cede executed
}

fn transaction_command_async(client#: PostgresClient, sql: str, expected_tag: str) -> async Result<(), PostgresError> {
    auto limits = PostgresQueryLimits::new(1:usize, 0:usize, 64:usize).unwrap()
    auto executed = client#.simple_query_async(sql, limits).await
    if executed.is_err() { return Result<(), PostgresError>::Err(executed.unwrap_err()) }
    auto results = executed.unwrap()
    if results.len() != 1:usize || !results.get(0:usize).command_tag.as_str().equals(expected_tag) {
        return Result<(), PostgresError>::Err(protocol_error(0:usize, "PostgreSQL transaction command returned an unexpected result"))
    }
    return Result<(), PostgresError>::Ok(())
}

impl PostgresTransaction {
    pub fn begin_async(cede client: PostgresClient) -> async Result<PostgresTransaction, PostgresError> {
        auto owned# = cede client
        if owned.closed { return Result<PostgresTransaction, PostgresError>::Err(error("connection", 0:usize, "PostgreSQL client is closed")) }
        auto started = transaction_command_async(owned, "BEGIN", "BEGIN").await
        if started.is_err() {
            owned#.close()
            return Result<PostgresTransaction, PostgresError>::Err(started.unwrap_err())
        }
        return Result<PostgresTransaction, PostgresError>::Ok(PostgresTransaction(client = cede owned, active = true))
    }

    pub fn is_active(self) -> bool {
        return self.active
    }

    pub fn simple_query_async(self#, sql: str, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        if !self.active { return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL transaction is no longer active")) }
        return self.client#.simple_query_async(sql, limits).await
    }

    pub fn prepare_async(self#, sql: str, cede param_type_oids: Vec<u32>) -> async Result<PostgresStatement, PostgresError> {
        if !self.active { return Result<PostgresStatement, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL transaction is no longer active")) }
        return self.client#.prepare_async(sql, cede param_type_oids).await
    }

    pub fn commit_async(cede self) -> async Result<PostgresClient, PostgresError> {
        auto transaction# = cede self
        if !transaction.active {
            transaction.client#.close()
            return Result<PostgresClient, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL transaction is no longer active"))
        }
        auto committed = transaction_command_async(transaction.client, "COMMIT", "COMMIT").await
        if committed.is_err() {
            transaction.client#.close()
            return Result<PostgresClient, PostgresError>::Err(committed.unwrap_err())
        }
        transaction.active = false
        return Result<PostgresClient, PostgresError>::Ok(cede transaction.client)
    }

    pub fn rollback_async(cede self) -> async Result<PostgresClient, PostgresError> {
        auto transaction# = cede self
        if !transaction.active {
            transaction.client#.close()
            return Result<PostgresClient, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL transaction is no longer active"))
        }
        auto rolled_back = transaction_command_async(transaction.client, "ROLLBACK", "ROLLBACK").await
        if rolled_back.is_err() {
            transaction.client#.close()
            return Result<PostgresClient, PostgresError>::Err(rolled_back.unwrap_err())
        }
        transaction.active = false
        return Result<PostgresClient, PostgresError>::Ok(cede transaction.client)
    }
}

fn pool_error(message: str) -> PostgresError {
    return error("pool", 0:usize, message)
}

fn pool_discard_slot(state: Mutex<PostgresPoolState>) {
    auto locked = state.lock()
    if locked.is_err() { return }
    auto lock_value = locked.unwrap()
    auto *state_value# = lock_value.get_ref()
    if state_value.total_connections > 0:usize {
        state_value.total_connections = state_value.total_connections - 1:usize
    }
}

fn pool_return_client(state: Mutex<PostgresPoolState>, cede client: PostgresClient) {
    auto returned# = cede client
    auto locked = state.lock()
    if locked.is_err() {
        returned#.close()
        return
    }
    auto lock_value = locked.unwrap()
    auto *state_value# = lock_value.get_ref()
    if state_value.closed || returned.is_closed() {
        returned#.close()
        if state_value.total_connections > 0:usize {
            state_value.total_connections = state_value.total_connections - 1:usize
        }
        return
    }
    state_value.idle#.push(cede returned)
}

impl PostgresPool@encap {
    fn drop(self#) {}

    pub fn clone(self#) -> PostgresPool
    effects: return <- self.state {
        return PostgresPool(~state = self.~state)
    }
}

impl PostgresPool @Send {}

impl PostgresPool {
    pub fn new(cede config: PostgresConfig, max_connections: usize) -> Result<PostgresPool, PostgresError> {
        if max_connections == 0:usize {
            return Result<PostgresPool, PostgresError>::Err(pool_error("PostgreSQL pool max_connections must be positive"))
        }
        return Result<PostgresPool, PostgresError>::Ok(PostgresPool(
            ~state = Mutex<PostgresPoolState>::make(cede PostgresPoolState(
                config = cede config,
                idle = Vec<PostgresClient>::new(),
                total_connections = 0:usize,
                max_connections = max_connections,
                closed = false
            ))
        ))
    }

    pub fn close(self#) {
        auto locked = self.state.lock()
        if locked.is_err() { return }
        auto lock_value = locked.unwrap()
        auto *state_value# = lock_value.get_ref()
        state_value.closed = true
        loop true {
            auto idle# = state_value#.take_idle()
            match cede idle {
                auto Option<PostgresClient>::Some('client) => {
                    auto client# = cede 'client
                    client#.close()
                    if state_value.total_connections > 0:usize {
                        state_value.total_connections = state_value.total_connections - 1:usize
                    }
                }
                auto Option<PostgresClient>::None => break
            }
        }
    }

    pub fn try_acquire_async(self#) -> async Result<PostgresPoolLease, PostgresError>
    effects: return <- self.state {
        auto config# = Option<PostgresConfig>::None
        {
            auto locked = self.state.lock()
            if locked.is_err() {
                return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool mutex lock failed"))
            }
            auto lock_value = locked.unwrap()
            auto *state_value# = lock_value.get_ref()
            if state_value.closed {
                return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool is closed"))
            }
            auto idle# = state_value#.take_idle()
            match cede idle {
                auto Option<PostgresClient>::Some('client) => {
                    auto client# = cede 'client
                    auto lease_clients# = Vec<PostgresClient>::new()
                    lease_clients#.push(cede client)
                    return Result<PostgresPoolLease, PostgresError>::Ok(PostgresPoolLease(
                        client = cede lease_clients,
                        ~state = self.~state
                    ))
                }
                auto Option<PostgresClient>::None => {}
            }
            if state_value.total_connections >= state_value.max_connections {
                return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool is exhausted"))
            }
            state_value.total_connections = state_value.total_connections + 1:usize
            config = Option<PostgresConfig>::Some(state_value.config.copy_for_connection())
        }

        auto connected# = PostgresClient::connect_async(cede config.unwrap()).await
        if connected.is_err() {
            pool_discard_slot(self.state)
            return Result<PostgresPoolLease, PostgresError>::Err(connected.unwrap_err())
        }
        auto lease_clients# = Vec<PostgresClient>::new()
        lease_clients#.push(cede connected.unwrap())
        return Result<PostgresPoolLease, PostgresError>::Ok(PostgresPoolLease(
            client = cede lease_clients,
            ~state = self.~state
        ))
    }

    // A pool wait maps a direct task cancellation to a pool error. A caller
    // whose own task may be canceled uses `.await?` to make that cancellation
    // boundary explicit. Call try_acquire_async when an application already
    // has its own admission queue and wants an immediate answer.
    pub fn acquire_async(self#, timeout_ms: i32) -> async Result<PostgresPoolLease, PostgresError>
    effects: return <- self.state {
        if timeout_ms <= 0:i32 {
            return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool acquire timeout must be positive"))
        }
        auto waited#: i32 = 0:i32
        loop waited < timeout_ms {
            auto acquired# = self#.try_acquire_async().await
            if acquired.is_ok() { return cede acquired }
            auto failure = acquired.unwrap_err()
            if !failure.kind.as_str().equals("pool") || !failure.message.as_str().equals("PostgreSQL pool is exhausted") {
                return Result<PostgresPoolLease, PostgresError>::Err(failure)
            }
            if sleep_async(1:i32).await?.is_none() {
                return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool acquire was canceled"))
            }
            waited = waited + 1:i32
        }
        return Result<PostgresPoolLease, PostgresError>::Err(pool_error("PostgreSQL pool acquire timed out"))
    }
}

impl PostgresPoolLease@encap {
    fn drop(self#) {
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => pool_return_client(self.state, cede 'client)
            auto Option<PostgresClient>::None => {}
        }
    }

}

impl PostgresPoolLease {
    fn take_connection(self#) -> Option<PostgresClient> {
        auto held# = self.client#.pop()
        return cede held
    }

    pub fn is_closed(self#) -> bool {
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto closed = client.is_closed()
                self.client#.push(cede client)
                return closed
            }
            auto Option<PostgresClient>::None => return true
        }
    }

    // Proxy the normal serial command without exposing a shared socket. The
    // lease remains checked out across the await and is automatically returned
    // to its pool when the lease drops.
    pub fn simple_query_async(self#, sql: str, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto result = client#.simple_query_async(sql, limits).await
                self.client#.push(cede client)
                return result
            }
            auto Option<PostgresClient>::None => {
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(pool_error("PostgreSQL pool lease has no connection"))
            }
        }
    }

    // Uses an ephemeral server-side statement so the connection remains safe
    // to return to the pool as soon as this call completes.
    pub fn query_params_async(self#, sql: str, cede param_type_oids: Vec<u32>, cede params: Vec<PostgresParam>, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto result = query_params_once_async(client, sql, cede param_type_oids, cede params, limits).await
                self.client#.push(cede client)
                return result
            }
            auto Option<PostgresClient>::None => {
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(pool_error("PostgreSQL pool lease has no connection"))
            }
        }
    }

    // Consuming the lease makes a transaction an exclusive, non-returnable
    // state until it commits, rolls back, or is dropped.
    pub fn begin_transaction_async(cede self) -> async Result<PostgresPoolTransaction, PostgresError> {
        auto lease# = cede self
        auto held# = lease#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto started = transaction_command_async(client, "BEGIN", "BEGIN").await
                if started.is_err() {
                    auto failure = started.unwrap_err()
                    client#.close()
                    pool_return_client(lease.state, cede client)
                    return Result<PostgresPoolTransaction, PostgresError>::Err(failure)
                }
                auto transaction_client# = Vec<PostgresClient>::new()
                transaction_client#.push(cede client)
                return Result<PostgresPoolTransaction, PostgresError>::Ok(PostgresPoolTransaction(
                    client = cede transaction_client,
                    ~state = lease.~state,
                    active = true
                ))
            }
            auto Option<PostgresClient>::None => {
                return Result<PostgresPoolTransaction, PostgresError>::Err(pool_error("PostgreSQL pool lease has no connection"))
            }
        }
    }

    pub fn close(self#) {
        auto held# = self.client#.pop()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                client#.close()
                pool_return_client(self.state, cede client)
            }
            auto Option<PostgresClient>::None => {}
        }
    }
}

impl PostgresPoolTransaction@encap {
    fn drop(self#) {
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                if self.active { client#.close() }
                pool_return_client(self.state, cede client)
            }
            auto Option<PostgresClient>::None => {}
        }
    }

}

impl PostgresPoolTransaction {
    fn take_connection(self#) -> Option<PostgresClient> {
        auto held# = self.client#.pop()
        return cede held
    }

    pub fn is_active(self) -> bool {
        return self.active
    }

    pub fn simple_query_async(self#, sql: str, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        if !self.active {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL pooled transaction is no longer active"))
        }
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto result = client#.simple_query_async(sql, limits).await
                // A statement failure inside a PostgreSQL transaction leaves
                // session state ambiguous to callers, so do not reuse it.
                if result.is_err() { client#.close() }
                self.client#.push(cede client)
                return result
            }
            auto Option<PostgresClient>::None => {
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(pool_error("PostgreSQL pooled transaction has no connection"))
            }
        }
    }

    pub fn query_params_async(self#, sql: str, cede param_type_oids: Vec<u32>, cede params: Vec<PostgresParam>, limits: PostgresQueryLimits) -> async Result<Vec<PostgresQueryResult>, PostgresError> {
        if !self.active {
            return Result<Vec<PostgresQueryResult>, PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL pooled transaction is no longer active"))
        }
        auto held# = self#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto result = query_params_once_async(client, sql, cede param_type_oids, cede params, limits).await
                if result.is_err() { client#.close() }
                self.client#.push(cede client)
                return result
            }
            auto Option<PostgresClient>::None => {
                return Result<Vec<PostgresQueryResult>, PostgresError>::Err(pool_error("PostgreSQL pooled transaction has no connection"))
            }
        }
    }

    fn finish_async(cede self, sql: str, expected_tag: str) -> async Result<(), PostgresError> {
        auto transaction# = cede self
        if !transaction.active {
            return Result<(), PostgresError>::Err(error("transaction", 0:usize, "PostgreSQL pooled transaction is no longer active"))
        }
        auto held# = transaction#.take_connection()
        match cede held {
            auto Option<PostgresClient>::Some('client) => {
                auto client# = cede 'client
                auto finished = transaction_command_async(client, sql, expected_tag).await
                transaction.active = false
                if finished.is_err() { client#.close() }
                pool_return_client(transaction.state, cede client)
                return finished
            }
            auto Option<PostgresClient>::None => {
                transaction.active = false
                return Result<(), PostgresError>::Err(pool_error("PostgreSQL pooled transaction has no connection"))
            }
        }
    }

    pub fn commit_async(cede self) -> async Result<(), PostgresError> {
        return self.finish_async("COMMIT", "COMMIT").await
    }

    pub fn rollback_async(cede self) -> async Result<(), PostgresError> {
        return self.finish_async("ROLLBACK", "ROLLBACK").await
    }
}

// PostgreSQL SCRAM is specified in terms of SASLprep.  This first pure-Toka
// slice accepts the portable ASCII credential subset only; it refuses to guess
// at Unicode normalization before a qualified Unicode profile exists.
pub fn scram_client_first(user: str, nonce: str) -> Result<ScramClientFirst, PostgresError> {
    if user.len() == 0:usize || nonce.len() == 0:usize {
        return Result<ScramClientFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM user and nonce must not be empty"))
    }
    if !is_ascii_credential(user) || !is_ascii_credential(nonce) || contains_nul(user) || contains_nul(nonce) {
        return Result<ScramClientFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM v1 accepts printable ASCII credentials and nonce only"))
    }
    if contains_byte(nonce, ',' as u8) {
        return Result<ScramClientFirst, PostgresError>::Err(error("authentication", 0:usize, "SCRAM nonce must not contain comma"))
    }
    auto bare# = string::from("n=")
    bare#.push_str(escape_scram_username(user).as_str())
    bare#.push_str(",r=")
    bare#.push_str(nonce)
    auto message# = string::from("n,,")
    message#.push_str(bare.as_str())
    return Result<ScramClientFirst, PostgresError>::Ok(ScramClientFirst(
        bare = string::from(bare.as_str()),
        message = cede message,
        nonce = string::from(nonce)
    ))
}

pub fn scram_client_final(password: str, client_first_bare: str,
                          server_first: str) -> Result<ScramClientFinal, PostgresError> {
    if !is_ascii_credential(password) || contains_nul(password) {
        return Result<ScramClientFinal, PostgresError>::Err(error("authentication", 0:usize, "SCRAM v1 accepts printable ASCII password only"))
    }
    auto parsed = parse_scram_server_first(server_first)
    if parsed.is_err() { return Result<ScramClientFinal, PostgresError>::Err(parsed.unwrap_err()) }
    auto server = parsed.unwrap()
    auto client_nonce_result = scram_nonce_from_bare(client_first_bare)
    if client_nonce_result.is_err() { return Result<ScramClientFinal, PostgresError>::Err(client_nonce_result.unwrap_err()) }
    auto client_nonce = client_nonce_result.unwrap()
    if server.nonce.len() <= client_nonce.len() || !server.nonce.as_str().starts_with(client_nonce.as_str()) {
        return Result<ScramClientFinal, PostgresError>::Err(error("authentication", 0:usize, "SCRAM server nonce does not extend client nonce"))
    }
    auto salted = pbkdf2::derive_sha256(password.as_bytes(), server.salt.as_slice(), server.iterations, 32:usize)
    if salted.is_err() { return Result<ScramClientFinal, PostgresError>::Err(error("authentication", 0:usize, salted.unwrap_err().as_str())) }
    auto salted_owner = Bytes::from_vec(cede salted.unwrap())
    auto client_key = hmac_sha256(salted_owner.as_slice(), "Client Key".as_bytes())
    auto stored_key = sha256_bytes(bytes_from_array<32>(client_key))
    auto without_proof# = string::from("c=biws,r=")
    without_proof#.push_str(server.nonce.as_str())
    auto auth_message# = string::from(client_first_bare)
    auth_message#.push_str(",")
    auth_message#.push_str(server_first)
    auth_message#.push_str(",")
    auth_message#.push_str(without_proof.as_str())
    auto client_signature = hmac_sha256(bytes_from_array<32>(stored_key), auth_message.as_str().as_bytes())
    auto proof# = Vec<u8>::with_capacity(32:usize)
    auto index#: usize = 0:usize
    loop index < 32:usize {
        proof#.push(client_key[index] ^ client_signature[index])
        index = index + 1:usize
    }
    auto proof_owner = Bytes::from_vec(cede proof)
    auto server_key = hmac_sha256(salted_owner.as_slice(), "Server Key".as_bytes())
    auto server_signature = hmac_sha256(bytes_from_array<32>(server_key), auth_message.as_str().as_bytes())
    auto signature# = Vec<u8>::with_capacity(32:usize)
    index = 0:usize
    loop index < 32:usize {
        signature#.push(server_signature[index])
        index = index + 1:usize
    }
    auto message# = string::from(without_proof.as_str())
    message#.push_str(",p=")
    message#.push_str(base64::encode(proof_owner.as_slice()).as_str())
    return Result<ScramClientFinal, PostgresError>::Ok(ScramClientFinal(
        message = cede message,
        expected_server_signature = Bytes::from_vec(cede signature)
    ))
}

impl ScramClientFinal {
    pub fn verify_server_final(self, server_final: str) -> Result<bool, PostgresError> {
        if !server_final.starts_with("v=") {
            return Result<bool, PostgresError>::Err(error("authentication", 0:usize, "SCRAM server-final lacks verifier"))
        }
        auto encoded = server_final.substr(2:usize, server_final.len() - 2:usize)
        auto decoded = base64::decode(encoded)
        if decoded.is_err() { return Result<bool, PostgresError>::Err(error("authentication", 2:usize, "SCRAM server verifier is not valid Base64")) }
        auto supplied = Bytes::from_vec(cede decoded.unwrap())
        return Result<bool, PostgresError>::Ok(constant_time::equal(
            self.expected_server_signature.as_slice(), supplied.as_slice()))
    }
}

pub fn decode_backend_one(input: Vec<u8>) -> Result<PostgresDecode, PostgresError> {
    if input.len() < 5:usize { return Result<PostgresDecode, PostgresError>::Ok(PostgresDecode::NeedMore()) }
    auto tag = input.get(0:usize)
    auto length = read_u32_be(input, 1:usize) as usize
    if length < 4:usize { return Result<PostgresDecode, PostgresError>::Err(protocol_error(1:usize, "PostgreSQL frame length is less than four")) }
    if length + 1:usize > MAX_FRAME_BYTES { return Result<PostgresDecode, PostgresError>::Err(limit_error(1:usize, "PostgreSQL frame exceeds 16 MiB limit")) }
    auto total = length + 1:usize
    if input.len() < total { return Result<PostgresDecode, PostgresError>::Ok(PostgresDecode::NeedMore()) }
    auto start: usize = 5:usize
    auto end = total
    auto parsed = if tag == 'R' as u8 {
        pass parse_authentication(input, start, end)
    } else if tag == 'S' as u8 {
        pass parse_parameter_status(input, start, end)
    } else if tag == 'K' as u8 {
        if end - start != 8:usize { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "BackendKeyData must contain eight bytes")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::BackendKeyData(read_u32_be(input, start) as i32, read_u32_be(input, start + 4:usize) as i32)) }
    } else if tag == 'Z' as u8 {
        if end - start != 1:usize { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "ReadyForQuery must contain one byte")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::ReadyForQuery(input.get(start))) }
    } else if tag == 'E' as u8 {
        auto server_error = parse_server_error(input, start, end)
        if server_error.is_err() { pass Result<PostgresMessage, PostgresError>::Err(server_error.unwrap_err()) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::Error(server_error.unwrap())) }
    } else if tag == 'N' as u8 {
        auto notice = parse_server_error(input, start, end)
        if notice.is_err() { pass Result<PostgresMessage, PostgresError>::Err(notice.unwrap_err()) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::Notice(notice.unwrap())) }
    } else if tag == 'T' as u8 {
        pass parse_row_description(input, start, end)
    } else if tag == 'D' as u8 {
        pass parse_data_row(input, start, end)
    } else if tag == '1' as u8 {
        if end != start { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "ParseComplete must be empty")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::ParseComplete()) }
    } else if tag == '2' as u8 {
        if end != start { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "BindComplete must be empty")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::BindComplete()) }
    } else if tag == '3' as u8 {
        if end != start { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "CloseComplete must be empty")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::CloseComplete()) }
    } else if tag == 'n' as u8 {
        if end != start { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "NoData must be empty")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::NoData()) }
    } else if tag == 't' as u8 {
        pass parse_parameter_description(input, start, end)
    } else if tag == 's' as u8 {
        if end != start { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(start, "PortalSuspended must be empty")) }
        else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::PortalSuspended()) }
    } else if tag == 'C' as u8 {
        auto command = parse_cstring(input, start, end)
        if command.is_err() { pass Result<PostgresMessage, PostgresError>::Err(command.unwrap_err()) }
        else {
            auto parsed_command = command.unwrap()
            if parsed_command.next != end { pass Result<PostgresMessage, PostgresError>::Err(protocol_error(parsed_command.next, "bytes follow CommandComplete")) }
            else { pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::CommandComplete(cede parsed_command.value)) }
        }
    } else {
        pass Result<PostgresMessage, PostgresError>::Ok(PostgresMessage::Unknown(tag, bytes_range(input, start, end)))
    }
    if parsed.is_err() { return Result<PostgresDecode, PostgresError>::Err(parsed.unwrap_err()) }
    return Result<PostgresDecode, PostgresError>::Ok(PostgresDecode::Complete(PostgresBackendFrame(
        message = cede parsed.unwrap(),
        consumed = total
    )))
}

pub fn package_name() -> string {
    return string::from("postgres")
}
