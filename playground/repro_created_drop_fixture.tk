import std/io::{println};

auto body_run_count# = 0:i32;
auto global_drop_count# = 0:i32;

shape SharedResource(
    id: i32
)
impl SharedResource@Encap {
    fn drop(self#) {
        global_drop_count = global_drop_count + 1;
    }
    pub fn clone(self) -> SharedResource {
        return SharedResource(id = self.id);
    }
}

fn unstarted_task_fixture(cede ~res: SharedResource) -> async i32 {
    body_run_count = body_run_count + 1;
    auto ~consumed = cede ~res;
    return consumed.id + 10;
}

fn test_unstarted_created_drop() {
    body_run_count = 0;
    global_drop_count = 0;
    {
        auto ~res = new SharedResource(id = 77);
        auto h = unstarted_task_fixture(cede ~res);
    }
    println("body_run_count: {}", body_run_count);
    println("global_drop_count: {}", global_drop_count);
    assert(body_run_count == 0, "Unstarted task body executed!");
    assert(global_drop_count == 1, "Unstarted Created task handle drop failed to reclaim cede parameter!");
}

pub fn main() -> i32 {
    test_unstarted_created_drop();
    println("repro_created_drop_fixture PASSED!");
    return 0;
}
