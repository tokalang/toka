import stdx/serde/json::{to_json, deserialize_shape, ToJson, serialize_shape, @JsonFactory, Parsed, parse_document}
import std/io::{println}
import core/string::{string}

pub shape ServiceConfig (
    service: string = string::from(""),
    port: i32 = 0,
    active: bool = false
)

impl ServiceConfig@ToJson {
    pub fn write_json(self, buf#: string) {
        serialize_shape(self, buf#)
    }
}

fn main() -> i32 {
    println("--- Starting Micro-Slice 4: Real stdx/serde/json Serialization & Deserialization ---")

    // 1. Structural Serialization
    auto cfg1 = ServiceConfig(
        service = string::from("Toka-REST-Service"),
        port = 8080,
        active = true
    )
    auto json_str = to_json(cfg1)
    println("[JSON Slice 1/3] Serialized: {}", json_str.as_view())
    assert(json_str.contains_char('{'), "JSON string must start with object brace")
    assert(json_str.len() > 20:usize, "JSON string length validation")

    // 2. Typed Deserialization
    auto cfg2_res = deserialize_shape<ServiceConfig>(json_str.as_view())
    assert(cfg2_res.is_ok(), "deserialize_shape must succeed on valid JSON")
    auto cfg2 = cfg2_res.unwrap()
    assert(cfg2.port == 8080, "Deserialized port mismatch")
    assert(cfg2.active == true, "Deserialized active status mismatch")
    assert(cfg2.service.eq(string::from("Toka-REST-Service")), "Deserialized service name mismatch")
    println("[JSON Slice 2/3] Round-trip Typed Deserialization PASSED!")

    // 3. Error Handling Test on Malformed JSON
    auto bad_json = "{\"service\": \"broken\""
    auto bad_res = deserialize_shape<ServiceConfig>(bad_json)
    assert(bad_res.is_err(), "deserialize_shape must return Err on malformed JSON")
    println("[JSON Slice 3/3] Malformed JSON Error Handling PASSED!")

    println("Micro-Slice 4: Real stdx/serde/json Micro-Slice PASSED ALL SUITES Cleanly!")
    return 0
}

impl ServiceConfig@JsonFactory {
    pub fn parse_value(input: str) -> Result<Parsed<ServiceConfig>, str> <- input {
        auto attempt = parse_document(input)
        if attempt.is_err() {
            auto error = Result<Parsed<ServiceConfig>, str>::Err("Invalid JSON")
            return cede error
        }
        auto document = attempt.unwrap()
        if document.kind(1) != 5 {
            auto error = Result<Parsed<ServiceConfig>, str>::Err("Expected object")
            return cede error
        }
        if document.kind(document.find(1, "port")) != 2 {
            auto error = Result<Parsed<ServiceConfig>, str>::Err("Invalid field port")
            return cede error
        }
        if document.kind(document.find(1, "service")) != 3 {
            auto error = Result<Parsed<ServiceConfig>, str>::Err("Invalid field service")
            return cede error
        }
        if document.kind(document.find(1, "active")) != 1 {
            auto error = Result<Parsed<ServiceConfig>, str>::Err("Invalid field active")
            return cede error
        }
        auto value = ServiceConfig(port = document.number(document.find(1, "port")).unwrap() as i32, service = string::from(document.text(document.find(1, "service"))), active = document.boolean(document.find(1, "active")).unwrap())
        auto parsed = Parsed<ServiceConfig>(value = cede value, rest = input.substr(input.len(), 0))
        auto result = Result<Parsed<ServiceConfig>, str>::Ok(cede parsed)
        return cede result
    }
}
