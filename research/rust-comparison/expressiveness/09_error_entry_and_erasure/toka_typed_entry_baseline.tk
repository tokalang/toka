shape AppError(code: i32)

fn read_value(fail: bool) -> Result<i32, AppError> {
    if fail {
        return Result<i32, AppError>::Err(AppError(code = 7))
    }
    return Result<i32, AppError>::Ok(23)
}

fn main() -> i32 {
    auto result = read_value(false)
    auto status = match result {
        auto Result::Ok(value) => {
            assert(value == 23, "typed result success")
            pass 0
        }
        auto Result::Err(error) => {
            pass error.code
        }
    }
    return status
}
