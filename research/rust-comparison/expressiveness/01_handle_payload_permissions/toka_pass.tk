// A binding can expose just payload mutation, just handle replacement, or both.

shape Cell(value: i32)

fn overwrite_payload(^p#: Cell) {
    p.value = 13
}

fn replace_handle(^#p: Cell) {
    ^#p = new Cell(value = 17)
}

fn replace_and_overwrite(^#p#: Cell) {
    p.value = 19
    ^#p = new Cell(value = 23)
}

fn main() -> i32 {
    auto ^payload_only# = new Cell(value = 1)
    overwrite_payload(^payload_only)
    if payload_only.value != 13 { return 1 }

    auto ^#handle_only = new Cell(value = 2)
    replace_handle(^#handle_only)
    if handle_only.value != 17 { return 2 }

    auto ^#both# = new Cell(value = 3)
    replace_and_overwrite(^#both)
    if both.value != 23 { return 3 }
    return 0
}
