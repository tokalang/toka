import core/task::{TaskHandle}

pub shape Buffer(size: i32)
pub fn read_buf(b: Buffer) -> async i32 {
    return b.size
}
pub shape BorrowedCarrier(t: TaskHandle<i32>)
impl BorrowedCarrier {
    pub fn close(cede self) -> async i32 {
        auto owned = cede self
        return owned.t.await
    }
}
pub fn escape_inline_ctor() -> TaskHandle<i32> {
    auto buf = Buffer(size = 16:i32)
    auto t = read_buf(buf)
    return BorrowedCarrier(t = cede t).close()
}
pub fn main() -> i32 {
    return 0:i32
}
