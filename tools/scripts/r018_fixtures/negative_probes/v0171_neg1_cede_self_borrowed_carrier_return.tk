import core/task::{TaskHandle}

pub shape Buffer(pub size: i32)
pub fn read_buf(b: Buffer) -> async i32 {
    return b.size
}
pub shape BorrowedCarrier(pub t: TaskHandle<i32>)
impl BorrowedCarrier {
    pub fn close(cede self) -> async i32 {
        auto owned = cede self
        return owned.t.await
    }
}
pub fn escape_inherent_receiver() -> TaskHandle<i32> {
    auto buf = Buffer(size = 16:i32)
    auto c = BorrowedCarrier(t = read_buf(buf))
    auto out = c.close()
    return cede out
}
pub fn main() -> i32 {
    return 0:i32
}
