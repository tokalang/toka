import std/task::{block_on}

shape Token(value: i32)

impl Token {
    fn borrow_consume(self#) -> async i32 <- self {
        self.value += 1:i32
        return self.value
    }
}

shape Holder(^item#: Token)

pub fn main() -> i32 {
    auto holder# = Holder(^item = new Token(value = 7:i32))
    auto handle = holder.item#.borrow_consume().start
    return block_on<i32>(handle)
}
