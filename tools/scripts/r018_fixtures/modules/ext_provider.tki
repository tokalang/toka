import core/task :: {TaskHandle}
import std/async :: {TaskScope, spawn_scoped}

pub shape Buffer(pub size: i32, pub tag: i32)

pub fn compute_provider(buf: Buffer) -> async i32 {
  return buf.size
}
pub fn consume_external(cede t: TaskHandle<i32>) {
  auto owned = cede t
}
pub fn fwd_external(cede t: TaskHandle<i32>) -> TaskHandle<i32> <- t {
  return cede t
}
pub fn spawn_scoped_external(scope#: TaskScope, cede t: TaskHandle<i32>) -> TaskHandle<i32> <- t {
  return spawn_scoped(scope#, cede t)
}
