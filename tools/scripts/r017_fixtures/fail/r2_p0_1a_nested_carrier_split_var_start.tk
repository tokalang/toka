import core/task::{TaskHandle}
shape Buffer ( size: i32, tag: i32 )
shape TaskCarrier ( task#: TaskHandle<i32> )
shape OuterCarrier ( inner#: TaskCarrier )
fn process_chunk(b: Buffer, chunk_id: i32) -> async i32 <- b {
    return b.size + chunk_id
}
pub fn test() -> i32 {
    auto buf = Buffer(size = 100:i32, tag = 1:i32)
    auto h = process_chunk(buf, 1:i32)
    auto o = OuterCarrier(inner = TaskCarrier(task = cede h))
    o.inner.task.start
    return 0:i32
}
pub fn main() -> i32 { return test() }
