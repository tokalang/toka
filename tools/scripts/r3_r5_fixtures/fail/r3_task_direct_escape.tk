import core/task::{TaskHandle}

shape Stream (
    val#: i32
)

impl Stream {
    fn read(self#) -> async i32 {
        return self.val
    }
}

fn escape_direct() -> TaskHandle<i32> {
    auto s# = Stream(val = 42:i32)
    auto t = s#.read()
    return cede t // EXPECT: error[E0455]:
}

fn main() -> i32 {
    return 0
}
