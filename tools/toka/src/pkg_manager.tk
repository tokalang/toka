import std/io::{println}

import std/env
import std/fs::{read_to_string, exists}
import sys/libc::{libc_getenv}
import std/process::{Command}
import std/vec::{Vec}

fn package_helper_path() -> string {
    auto candidates# = Vec<string>::new()
    candidates#.push(cede string::from("lib/toolchain/toka_package.py"))
    candidates#.push(cede string::from("../lib/toolchain/toka_package.py"))
    candidates#.push(cede string::from("../../lib/toolchain/toka_package.py"))
    candidates#.push(cede string::from("../../../lib/toolchain/toka_package.py"))
    auto i# = 0:usize
    loop i < candidates.len() {
        auto candidate = candidates.get_ref(i).clone()
        if exists(candidate.clone()) { return candidate }
        i += 1
    }
    auto toka_lib = env::var(string::from("TOKA_LIB"))
    if toka_lib.is_some() {
        auto candidate# = toka_lib.unwrap()
        if !candidate.ends_with("/") && !candidate.ends_with("\\") {
            candidate#.push_str("/")
        }
        candidate#.push_str("toolchain/toka_package.py")
        if exists(candidate.clone()) { return candidate }
    }
    return string::from("")
}

fn package_command(action: string) -> Command {
    auto command# = Command::new(string::from("python3"))
    command#.arg(package_helper_path())
    command#.arg(cede action.clone())
    return command
}

pub fn cmd_fetch() -> i32 {
    auto helper = package_helper_path()
    if helper.is_empty() {
        println("error: package helper not found under lib/toolchain")
        return 1
    }
    auto command# = package_command(string::from("fetch"))
    unsafe {
        auto offline = libc_getenv(c"TOKA_OFFLINE") as Addr
        if offline != 0:Addr && string::from_cstr(offline as *char) == string::from("1") {
            command#.arg(string::from("--offline"))
        }
    }
    return command#.status()
}

pub fn cmd_fetch_quiet() -> i32 {
    auto helper = package_helper_path()
    if helper.is_empty() { return 1 }
    auto command# = package_command(string::from("fetch"))
    unsafe {
        auto offline = libc_getenv(c"TOKA_OFFLINE") as Addr
        if offline != 0:Addr && string::from_cstr(offline as *char) == string::from("1") {
            command#.arg(string::from("--offline"))
        }
    }
    auto result = command#.output()
    if result.is_err() { return 1 }
    auto output = result.unwrap()
    if !output.status.success() && !output.stderr.is_empty() {
        println("{}", output.stderr)
    }
    return output.status.legacy_code()
}

pub fn cmd_update() -> i32 {
    auto command# = package_command(string::from("fetch"))
    command#.arg(string::from("--refresh"))
    return command#.status()
}

pub fn cmd_remove(package_alias: string) -> i32 {
    auto command# = package_command(string::from("remove"))
    command#.arg(cede package_alias.clone())
    return command#.status()
}

pub fn build_pkg_mappings() -> Vec<string> {
    auto mappings# = Vec<string>::new()
    if !exists(string::from("package.lock")) { return mappings }
    auto command# = package_command(string::from("compiler-mappings"))
    auto result = command#.output()
    if result.is_err() { return mappings }
    auto output = result.unwrap()
    if !output.status.success() { return mappings }
    auto lines# = output.stdout.split('\n' as i32)
    loop !lines.is_done() {
        auto line = lines#.next()
        if !line.is_empty() {
            mappings#.push(cede line.clone())
        }
    }
    return mappings
}

pub fn build_pkg_node_mappings() -> Vec<string> {
    auto mappings# = Vec<string>::new()
    if !exists(string::from("package.lock")) { return mappings }
    auto command# = package_command(string::from("compiler-node-mappings"))
    auto result = command#.output()
    if result.is_err() { return mappings }
    auto output = result.unwrap()
    if !output.status.success() { return mappings }
    auto lines# = output.stdout.split('\n' as i32)
    loop !lines.is_done() {
        auto line = lines#.next()
        if !line.is_empty() { mappings#.push(cede line.clone()) }
    }
    return mappings
}

pub fn build_workspace_node() -> string {
    if !exists(string::from("package.tk")) { return string::from("") }
    auto command# = package_command(string::from("workspace-node"))
    auto result = command#.output()
    if result.is_err() { return string::from("") }
    auto output = result.unwrap()
    if !output.status.success() { return string::from("") }
    return output.stdout.trim()
}

pub fn cmd_publish() -> i32 {
    auto res = read_to_string(string::from("package.tk"))
    if res.is_err() {
        println("Error: package.tk not found. Are you in a Toka project?")
        return 1
    }
    
    auto content = res.unwrap()
    auto lines# = content.split('\n' as i32)
    
    auto name# = string::from("")
    auto version# = string::from("")
    
    loop !lines.is_done() {
        auto line = lines#.next().trim()
        if line.starts_with("name = ") {
            auto start_idx = line.find_str("\"")
            if start_idx != -1 {
                auto rest = line.substring(start_idx + 1, line.len() as i32)
                auto end_idx = rest.find_str("\"")
                if end_idx != -1 {
                    name = rest.substring(0, end_idx)
                }
            }
        } else if line.starts_with("version = ") {
            auto start_idx = line.find_str("\"")
            if start_idx != -1 {
                auto rest = line.substring(start_idx + 1, line.len() as i32)
                auto end_idx = rest.find_str("\"")
                if end_idx != -1 {
                    version = rest.substring(0, end_idx)
                }
            }
        }
    }
    
    if name.is_empty() || version.is_empty() {
        println("Error: Could not extract name or version from package.tk")
        return 1
    }
    
    println("Packaging {} v{}...", name, version)
    
    // Check if the name has a namespace (e.g. zhyi-dp/utils). We want to replace '/' with '-' for the file name.
    auto safe_name# = name.clone()
    auto slash_idx = safe_name.find_str("/")
    if slash_idx != -1 {
        // Since Toka string doesn't have a built in replace yet, let's just use the substring after the slash for the tarball name
        // Or we could extract just the package name for the tarball
        safe_name = safe_name.substring(slash_idx + 1, safe_name.len() as i32)
    }

    auto archive# = safe_name.clone()
    archive#.push_str("-")
    archive#.push_str(version.as_str())
    archive#.push_str(".tar.gz")
    auto tar# = Command::new(string::from("tar"))
    tar#.arg(string::from("-czf"))
    tar#.arg(cede archive.clone())
    tar#.arg(string::from("package.tk"))
    if exists(string::from("src")) {
        tar#.arg(string::from("src"))
    }
    if exists(string::from("lib")) {
        tar#.arg(string::from("lib"))
    }
    if exists(string::from("native")) {
        tar#.arg(string::from("native"))
    }
    if exists(string::from("test")) {
        tar#.arg(string::from("test"))
    }
    if exists(string::from("tests")) {
        tar#.arg(string::from("tests"))
    }
    if exists(string::from("build.tk")) {
        tar#.arg(string::from("build.tk"))
    }
    if exists(string::from("README.md")) {
        tar#.arg(string::from("README.md"))
    }
    if exists(string::from("LICENSE")) {
        tar#.arg(string::from("LICENSE"))
    }
    if tar#.status() != 0 {
        println("Error: Failed to create tar archive")
        return 1
    }
    
    println("Successfully created archive: {}-{}.tar.gz", safe_name, version)
    
    auto env_url = (unsafe libc_getenv(c"TOKA_REGISTRY_URL")) as Addr
    if env_url == 0:Addr {
        println("Archive is ready for a tagged GitHub Release.")
        println("Add its SHA-256 to the reviewed static registry catalog to publish it.")
        return 0
    }
    auto url# = string::from_cstr(env_url as *char)
    if !url.ends_with("/") {
        url#.push_str("/")
    }
    url#.push_str("api/publish")

    println("Uploading to {}...", url)
    auto form_arg# = string::from("file=@")
    form_arg#.push_str(archive.as_str())
    auto upload# = Command::new(string::from("curl"))
    upload#.arg(string::from("-sS"))
    upload#.arg(string::from("-L"))
    upload#.arg(string::from("--fail"))
    upload#.arg(string::from("-X"))
    upload#.arg(string::from("POST"))
    upload#.arg(string::from("-F"))
    upload#.arg(cede form_arg)
    auto publish_token = (unsafe libc_getenv(c"TOKA_REGISTRY_PUBLISH_TOKEN")) as Addr
    if publish_token != 0:Addr {
        auto token = string::from_cstr(publish_token as *char)
        auto authorization# = string::from("Authorization: Bearer ")
        authorization#.push_str(token.as_str())
        upload#.arg(string::from("-H"))
        upload#.arg(cede authorization)
    }
    upload#.arg(cede url)
    if upload#.status() != 0 {
        println("\x1b[31m[Error]\x1b[0m Failed to publish package to registry.")
        return 1
    }

    println("\x1b[32m[Success]\x1b[0m Package uploaded to the configured local registry!")
    return 0
}

pub fn cmd_search(query: string) -> i32 {
    println("Searching for '{}' in registry...", query)
    auto command# = package_command(string::from("registry-search"))
    command#.arg(cede query.clone())
    auto result = command#.output()
    if result.is_err() { return 1 }
    auto output = result.unwrap()
    if !output.status.success() {
        if !output.stderr.is_empty() { println("{}", output.stderr) }
        return output.status.legacy_code()
    }
    if output.stdout.is_empty() {
        println("No packages found matching '{}'.", query)
    } else {
        println("{}", output.stdout)
    }
    return 0
}
