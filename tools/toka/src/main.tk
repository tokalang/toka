import std/fs::{read_to_string, exists, create_dir, write_string, read_dir, metadata}
import sys/libc::{libc_system, libc_printf, libc_getenv}
import std/vec::{Vec}
import src/pkg_manager::{cmd_fetch, build_pkg_args, cmd_publish, cmd_search, resolve_package}


fn print_help() {
    println("Toka {}", "0.9.8")
    println("\nUsage: toka <command> [options]\n\nCommands:")
    println("  new <name>   Create a new Toka project (--lib for library)")
    println("  init         Initialize a new Toka project in the current directory")
    println("  build        Compile current project to an executable")
    println("  run [file]   Compile and execute a Toka program")
    println("  test         Run all tests in the tests/ directory")
    println("  doc          Generate API documentation")
    println("  add <url>    Add a package dependency")
    println("  rm <pkg>     Remove a package dependency")
    println("  up           Update package dependencies")
    println("  fetch        Fetch dependencies (Implicit in build)")
    println("  search <q>   Search for packages in the registry")
    println("  publish      Package and publish to the Toka registry")
    println("  fmt          Format the current project")
    println("  clean        Clean build artifacts")
    println("\nOptions:")
    println("  -v, --verbose  Enable verbose compiler output")
    println("  -f, --forge    🚀 Enable forge multi-threaded parallel incremental build engine")
}

fn check_is_windows() -> bool {
    unsafe {
        auto os_env = libc_getenv(c"OS") as Addr
        if os_env != 0:Addr {
            auto os_str = string::from_cstr(os_env as *char)
            if os_str == string::from("Windows_NT") {
                return true
            }
        }
        return false
    }
}

fn shell_quote(s: string) -> string {
    if check_is_windows() {
        auto res# = string::from("\"")
        auto view = s.as_str()
        auto len = view.len()
        auto i# = 0:usize
        loop {
            if i >= len { break }
            auto c = view.byte_at(i)
            if c == '"' {
                res#.push_str("\\\"")
            } else {
                res#.push_char(c)
            }
            i = i + 1:usize
        }
        res#.push_str("\"")
        return res
    } else {
        auto res# = string::from("'")
        auto view = s.as_str()
        auto len = view.len()
        auto i# = 0:usize
        loop {
            if i >= len { break }
            auto c = view.byte_at(i)
            if c == '\'' {
                res#.push_str("'\\''")
            } else {
                res#.push_char(c)
            }
            i = i + 1:usize
        }
        res#.push_str("'")
        return res
    }
}

fn get_dirname(path: string) -> string {
    auto idx_opt = path.as_str().last_index_of('/' as char)
    auto idx_opt2 = path.as_str().last_index_of('\\' as char)
    
    auto last_slash_pos#: i32 = -1
    if idx_opt.is_some() {
        last_slash_pos = idx_opt.unwrap() as i32
    }
    if idx_opt2.is_some() {
        auto pos2 = idx_opt2.unwrap() as i32
        if pos2 > last_slash_pos {
            last_slash_pos = pos2
        }
    }
    
    if last_slash_pos > 0 {
        return path.substring(0, last_slash_pos)
    }
    return string::from(".")
}

fn detect_default_lib_path() -> string {
    unsafe {
        auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
        if toka_lib != 0:Addr {
            return string::from_cstr(toka_lib as *char)
        }
    }
    
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        
        auto parent_dir = get_dirname(exe_dir.clone())
        auto candidate1# = parent_dir.clone()
        candidate1#.push_str("/lib")
        if exists(candidate1.clone()) {
            return candidate1
        }
        
        auto candidate2# = exe_dir.clone()
        candidate2#.push_str("/lib")
        if exists(candidate2.clone()) {
            return candidate2
        }
    }
    
    if check_is_windows() {
        auto win_fallback = string::from("C:\\ProgramData\\toka\\lib")
        if exists(win_fallback.clone()) {
            return win_fallback
        }
        return string::from("lib")
    }
    
    return string::from("/usr/local/lib/toka")
}

fn detect_tokafmt_path() -> string {
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        auto candidate# = exe_dir.clone()
        if check_is_windows() {
            candidate#.push_str("\\tokafmt.exe")
        } else {
            candidate#.push_str("/tokafmt")
        }
        if exists(candidate.clone()) {
            return candidate
        }
    }
    return string::from("tokafmt")
}

fn detect_tokac_path() -> string {
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        auto candidate# = exe_dir.clone()
        if check_is_windows() {
            candidate#.push_str("\\tokac.exe")
        } else {
            candidate#.push_str("/tokac")
        }
        if exists(candidate.clone()) {
            return candidate
        }
    }
    return string::from("tokac")
}

fn get_basename(path: string) -> string {
    auto idx_opt = path.as_str().last_index_of('/' as char)
    auto idx_opt2 = path.as_str().last_index_of('\\' as char)
    
    auto last_slash_pos#: i32 = -1
    if idx_opt.is_some() {
        last_slash_pos = idx_opt.unwrap() as i32
    }
    if idx_opt2.is_some() {
        auto pos2 = idx_opt2.unwrap() as i32
        if pos2 > last_slash_pos {
            last_slash_pos = pos2
        }
    }
    
    if last_slash_pos != -1 {
        auto result = path.substring(last_slash_pos + 1, path.len() as i32)
        if result.is_empty() || result.as_str().contains_char(':' as char) {
            return string::from("toka_project")
        }
        return result
    }
    if path.is_empty() || path.as_str().contains_char(':' as char) {
        return string::from("toka_project")
    }
    return path.clone()
}

fn generate_project_files(name: string, dest_dir: string, is_lib: bool) {
    auto pkg_content# = string::from("pub const PACKAGE = (\n    name = \"")
    pkg_content#.push_str(name.as_str())
    pkg_content#.push_str("\",\n    version = \"0.1.0\",\n    dependencies = (\n    )\n)\n")

    auto pkg_path# = string::from("")
    if !dest_dir.is_empty() {
        pkg_path#.push_str(dest_dir.as_str())
        pkg_path#.push_str("/")
    }
    pkg_path#.push_str("package.tk")
    write_string(pkg_path, pkg_content.as_str())

    if is_lib {
        auto build_content# = string::from("import build::{Library, run_build}\n\nfn main() -> i32 {\n    auto lib# = Library::make(c\"")
        build_content#.push_str(name.as_str())
        build_content#.push_str("\", c\"lib/")
        build_content#.push_str(name.as_str())
        build_content#.push_str("/mod.tk\")\n    return run_build(lib)\n}\n")

        auto build_path# = string::from("")
        if !dest_dir.is_empty() {
            build_path#.push_str(dest_dir.as_str())
            build_path#.push_str("/")
        }
        build_path#.push_str("build.tk")
        write_string(build_path, build_content.as_str())
    } else {
        auto build_content# = string::from("import build::{Executable, run_build}\n\nfn main() -> i32 {\n    auto app# = Executable::make(c\"")
        build_content#.push_str(name.as_str())
        build_content#.push_str("\", c\"src/main.tk\")\n    return run_build(app)\n}\n")

        auto build_path# = string::from("")
        if !dest_dir.is_empty() {
            build_path#.push_str(dest_dir.as_str())
            build_path#.push_str("/")
        }
        build_path#.push_str("build.tk")
        write_string(build_path, build_content.as_str())
    }
}


fn cmd_new(name: string, is_lib: bool) -> i32 {
    if exists(name.clone()) {
        println("Error: Directory '{}' already exists! Aborting.", name)
        return 1
    }
    
    if is_lib {
        // 先建母体目录，再建子目录
        create_dir(name.clone())
        
        auto lib_dir# = name.clone()
        lib_dir#.push_str("/lib")
        create_dir(lib_dir.clone())
        
        lib_dir#.push_str("/")
        lib_dir#.push_str(name.as_str())
        create_dir(lib_dir.clone())
        
        lib_dir#.push_str("/mod.tk")
        write_string(lib_dir, "// Library module\n\npub fn hello() {\n    // TODO: implement\n}\n")
        
        generate_project_files(name.clone(), name.clone(), is_lib)
        println("Created new Toka library: {}", name)
    } else {
        // 先建母体目录，再建子目录
        create_dir(name.clone())
        
        auto src_dir# = name.clone()
        src_dir#.push_str("/src")
        create_dir(src_dir.clone())
        
        src_dir#.push_str("/main.tk")
        write_string(src_dir, "import std/io::{println, File}\nimport std/fs::{read_to_string}\n\nfn main() -> i32 {\n    println(\"Hello, Toka!\")\n    return 0\n}\n")
        
        generate_project_files(name.clone(), name.clone(), is_lib)
        println("Created new Toka project: {}", name)
    }
    return 0
}

fn cmd_init(is_lib: bool) -> i32 {
    if exists(string::from("package.tk")) {
        println("Error: package.tk already exists in this directory.")
        return 1
    }
    
    auto cwd = env::current_dir()
    auto name# = get_basename(cwd)
    if name.is_empty() {
        name = string::from("my_project")
    }
    
    if is_lib {
        if !exists(string::from("lib")) {
            create_dir(string::from("lib"))
        }
        
        auto lib_dir# = string::from("lib/")
        lib_dir#.push_str(name.as_str())
        if !exists(lib_dir.clone()) {
            create_dir(lib_dir.clone())
        }
        
        lib_dir#.push_str("/mod.tk")
        write_string(lib_dir, "// Library module\n\npub fn hello() {\n}\n")
    } else {
        if !exists(string::from("src")) {
            create_dir(string::from("src"))
        }
        write_string(string::from("src/main.tk"), "import std/io::{println, File}\nimport std/fs::{read_to_string}\n\nfn main() -> i32 {\n    println(\"Hello, Toka!\")\n    return 0\n}\n")
    }
    
    generate_project_files(name, string::from(""), is_lib)
    println("Initialized Toka project in current directory.")
    return 0
}

fn cmd_add(pkg_url_or_name: string) -> i32 {
    unsafe {
        auto pkg_url# = pkg_url_or_name.clone()
        auto pkg_alias# = string::from("")
        
        // If it doesn't contain '/', it's a registry lookup
        if !pkg_url.contains("/") {
            auto resolved = resolve_package(pkg_url_or_name)
            if resolved.is_some() {
                pkg_url = resolved.unwrap()
                pkg_alias = pkg_url_or_name.clone()
                println("\x1b[32m[Registry]\x1b[0m Resolved {} to {}", pkg_url_or_name, pkg_url)
            } else {
                println("\x1b[31m[Error]\x1b[0m Package '{}' not found in registry.", pkg_url_or_name)
                return 1
            }
        } else {
            // Direct URL parsing
            auto iter = pkg_url.split('/' as i32)
            loop !iter.is_done() {
                auto part = iter#.next()
                if !part.is_empty() {
                    pkg_alias = part.clone()
                }
            }
            
            auto colon_idx = pkg_alias.find_str(":")
            if colon_idx != -1 {
                pkg_alias = pkg_alias.substring(0, colon_idx)
            }
        }
        
        if pkg_alias.is_empty() {
            println("\x1b[1;31m       Error\x1b[0m invalid package URL or name")
            return 1
        }
        
        println("\x1b[1;32m      Adding\x1b[0m package {} -> {}", pkg_alias, pkg_url)
        
        if !exists(string::from("package.tk")) {
            println("\x1b[1;31m       Error\x1b[0m package.tk not found. Are you in a Toka project?")
            return 1
        }
        
        auto res = read_to_string(string::from("package.tk"))
        if res.is_err() {
            println("\x1b[1;31m       Error\x1b[0m failed to read package.tk")
            return 1
        }
        
        auto pkg_content = res.unwrap()
        auto deps_idx = pkg_content.find_str("dependencies = (")
        if deps_idx == -1 {
            println("Error: Invalid package.tk format (missing dependencies block)")
            return 1
        }
        
        auto insert_pos = deps_idx + 16
        auto new_content# = pkg_content.substring(0, insert_pos)
        new_content#.push_str("
        ")
        new_content#.push_str(pkg_alias.as_str())
        new_content#.push_str(" = \"")
        new_content#.push_str(pkg_url.as_str())
        new_content#.push_str("\",")
        
        auto rest = pkg_content.substring(insert_pos, pkg_content.len() as i32)
        new_content#.push_str(rest.as_str())
        
        auto file# = File::open(string::from("package.tk"), "w")
        if !file.is_valid() {
            println("\x1b[1;31m       Error\x1b[0m failed to open package.tk for writing")
            return 1
        }
        file.write(new_content.as_view())
        file#.close()
        
        println("\x1b[1;32m       Added\x1b[0m {} to package.tk", pkg_alias)
        
        println("\x1b[1;32m    Updating\x1b[0m package.lock...")
        auto lock_file# = File::open(string::from("package.lock"), "a")
        if lock_file.is_valid() {
            auto lock_entry# = string::from("")
            lock_entry#.push_str(pkg_alias.as_str())
            lock_entry#.push_str(" ")
            lock_entry#.push_str(pkg_url.as_str())
            lock_entry#.push_str(" sha256:mock_hash_for_now_00000000000000000000000000
")
            lock_file.write(lock_entry.as_view())
            lock_file#.close()
        }
        
        return 0
    }
}

fn cmd_build(use_forge: bool, extra_args: Vec<string>) -> i32 {
    if use_forge {
        env::set_var(string::from("TOKA_USE_FORGE"), string::from("1"))
    } else {
        env::set_var(string::from("TOKA_USE_FORGE"), string::from("0"))
    }
    // Phase 4: Implicit fetch before build
    auto fetch_res = cmd_fetch()
    if fetch_res != 0 {
        return fetch_res
    }

    unsafe {
        auto cmd# = string::from("")
        auto tokac_path = detect_tokac_path()
        cmd#.push_str(tokac_path.as_str())
        cmd#.push_str(" ")
        auto default_lib = detect_default_lib_path()
        cmd#.push_str("-I ")
        cmd#.push_str(default_lib.as_str())
        cmd#.push_str(" ")
        
        auto pkg_args = build_pkg_args()
        if !pkg_args.is_empty() {
            cmd#.push_str(pkg_args.as_str())
            cmd#.push_str(" ")
            env::set_var(string::from("TOKA_PKG_ARGS"), pkg_args)
        } else {
            env::set_var(string::from("TOKA_PKG_ARGS"), string::from(""))
        }
        
        auto build_file# = string::from("build.tk")
        if !exists(string::from("build.tk")) {
            if exists(string::from("Project.tk")) {
                println("\n\x1b[33mWarning: Project.tk is deprecated. Please rename it to build.tk\x1b[0m\n")
                build_file = string::from("Project.tk")
            } else {
                println("\x1b[1;31m       Error\x1b[0m build.tk not found in current directory.")
                return 1
            }
        }
        
        auto is_windows = check_is_windows()
        
        cmd#.push_str(build_file.as_str())
        if is_windows {
            cmd#.push_str(" -o .toka_build_exe.exe -O3 && .toka_build_exe.exe")
        } else {
            cmd#.push_str(" -o .toka_build_exe -O3 && ./.toka_build_exe")
        }

        auto idx_extra# = 0:usize
        loop idx_extra < extra_args.len() {
            cmd#.push_str(" ")
            cmd#.push_str(shell_quote(extra_args.get(idx_extra)).as_str())
            idx_extra += 1
        }

        auto res = libc_system(cmd.c_str())
        if res != 0 {
            println("\x1b[1;31m       Error\x1b[0m executing {} -> compile failed", build_file)
        }
        if is_windows {
            remove_file(string::from(".toka_build_exe.exe"))
        } else {
            remove_file(string::from(".toka_build_exe"))
        }
        if res != 0 { return 1 }
        return 0
    }
}

fn cmd_run_single(file: string) -> i32 {
    unsafe {
        auto cmd# = string::from("")
        auto tokac_path = detect_tokac_path()
        cmd#.push_str(tokac_path.as_str())
        cmd#.push_str(" ")
        auto default_lib = detect_default_lib_path()
        cmd#.push_str("-I ")
        cmd#.push_str(default_lib.as_str())
        cmd#.push_str(" ")
        
        auto is_windows = check_is_windows()
        
        cmd#.push_str(file.as_str())
        if is_windows {
            cmd#.push_str(" -o .toka_single_exe.exe -O3 && .toka_single_exe.exe")
        } else {
            cmd#.push_str(" -o .toka_single_exe -O3 && ./.toka_single_exe")
        }

        auto res = libc_system(cmd.c_str())
        if res != 0 {
            println("\x1b[1;31m       Error\x1b[0m executing {}", file)
        }
        if is_windows {
            remove_file(string::from(".toka_single_exe.exe"))
        } else {
            remove_file(string::from(".toka_single_exe"))
        }
        if res != 0 { return 1 }
        return 0
    }
}

fn find_newest_executable(dir_path: string) -> string {
    auto newest_file# = string::from("")
    auto newest_mtime#: i64 = -2
    
    auto dir# = read_dir(dir_path.clone())
    loop {
        auto entry_opt = dir#.next()
        if entry_opt.is_none() { break }
        auto entry = entry_opt.unwrap()
        
        if entry.as_str() == "." || entry.as_str() == ".." || entry.ends_with(".ll") {
            continue
        }
        
        auto full_path# = dir_path.clone()
        full_path#.push_str("/")
        full_path#.push_str(entry.as_str())
        
        auto meta_res = metadata(full_path.clone())
        if meta_res.is_ok() {
            auto meta = meta_res.unwrap()
            if meta.is_file() {
                auto mtime = meta.modified()
                if mtime > newest_mtime {
                    newest_mtime = mtime
                    newest_file = entry.clone()
                }
            }
        }
    }
    dir#.close()
    return newest_file
}

fn cmd_run(use_forge: bool) -> i32 {
    auto extra_args = Vec<string>::new()
    auto res = cmd_build(use_forge, extra_args)
    if res != 0 { return res }
    
    auto target_dir = string::from("target/debug")
    auto newest_exe = find_newest_executable(target_dir)
    if newest_exe.is_empty() {
        println("\x1b[1;31m       Error\x1b[0m no executable found in target/debug")
        return 1
    }
    
    unsafe {
        auto is_windows# = false
        auto os_env = libc_getenv(c"OS") as Addr
        if os_env != 0:Addr {
            auto os_str = string::from_cstr(os_env as *char)
            if os_str == string::from("Windows_NT") {
                is_windows = true
            }
        }
        
        auto run_cmd# = string::from("")
        if is_windows {
            run_cmd = string::from("target\\debug\\")
            run_cmd#.push_str(newest_exe.as_str())
        } else {
            run_cmd = string::from("./target/debug/")
            run_cmd#.push_str(newest_exe.as_str())
        }
        
        auto run_res = libc_system(run_cmd.c_str())
        if run_res != 0 { return 1 }
        return 0
    }
}

fn cmd_test() -> i32 {
    println("Running Toka tests...")
    
    auto default_lib = detect_default_lib_path()
    auto script# = string::from("set -e\npassed=0\nfailed=0\n")
    script#.push_str("if [ ! -d \"tests\" ]; then echo \"No tests directory found.\"; exit 0; fi\n")
    script#.push_str("for test_file in $(find tests -name '*.tk'); do\n")
    script#.push_str("  printf \"  \\x1b[1;36mTesting\\x1b[0m %s ... \" \"$test_file\"\n")
    script#.push_str("  toka_lib_path=\"")
    script#.push_str(default_lib.as_str())
    script#.push_str("\"\n")
    script#.push_str("  if tokac -I . -I \"$toka_lib_path\" \"$test_file\" -o .toka_test_exe > .toka_test_out 2>&1; then\n")
    script#.push_str("      if ./.toka_test_exe >> .toka_test_out 2>&1; then\n")
    script#.push_str("          printf \"\\x1b[1;32m[OK]\\x1b[0m\\n\"\n")
    script#.push_str("          passed=$((passed+1))\n")
    script#.push_str("      else\n")
    script#.push_str("          printf \"\\x1b[1;31m[FAILED (Runtime)]\\x1b[0m\\n\"\n")
    script#.push_str("          cat .toka_test_out\n")
    script#.push_str("          failed=$((failed+1))\n")
    script#.push_str("      fi\n")
    script#.push_str("  else\n")
    script#.push_str("      printf \"\\x1b[1;31m[FAILED (Compile)]\\x1b[0m\\n\"\n")
    script#.push_str("      cat .toka_test_out\n")
    script#.push_str("      failed=$((failed+1))\n")
    script#.push_str("  fi\n")
    script#.push_str("  rm -f .toka_test_exe .toka_test_out\n")
    script#.push_str("done\n")
    script#.push_str("printf \"\\n\\x1b[1mTest Results:\\x1b[0m \\x1b[1;32m%d passed\\x1b[0m, \\x1b[1;31m%d failed\\x1b[0m\\n\" \"$passed\" \"$failed\"\n")
    script#.push_str("if [ \"$failed\" -gt 0 ]; then exit 1; fi\nexit 0\n")
    
    write_string(string::from(".toka_test_runner.sh"), script.as_str())
    
    unsafe {
        auto res = libc_system(c"bash .toka_test_runner.sh")
        if res != 0 && check_is_windows() {
            println("\n\x1b[33m提示：在 Windows 原生命令行下，'toka test' 需要 Bash 环境（如 Git Bash 或 MSYS2）来调度测试执行。\x1b[0m")
        }
        
        remove_file(string::from(".toka_test_runner.sh"))
        return res
    }
}

fn cmd_doc() -> i32 {
    println("Generating documentation...")
    
    auto script# = string::from("set -e\nmkdir -p docs\n")
    script#.push_str("doc_file=\"docs/API.md\"\necho \"# API Documentation\" > \"$doc_file\"\necho \"Generated by \\`toka doc\\`\" >> \"$doc_file\"\necho \"\" >> \"$doc_file\"\n")
    script#.push_str("find src lib -name '*.tk' 2>/dev/null | while read file; do\n")
    script#.push_str("  awk '\n")
    script#.push_str("    /^[[:space:]]*\\/\\/\\// {\n")
    script#.push_str("      sub(/^[[:space:]]*\\/\\/\\/[[:space:]]?/, \"\");\n")
    script#.push_str("      doc = doc $0 \"\\n\"\n")
    script#.push_str("      next\n")
    script#.push_str("    }\n")
    script#.push_str("    /^[[:space:]]*pub fn/ || /^[[:space:]]*pub shape/ || /^[[:space:]]*pub const/ {\n")
    script#.push_str("      if (doc != \"\") {\n")
    script#.push_str("        sig = $0\n")
    script#.push_str("        sub(/^[[:space:]]*/, \"\", sig)\n")
    script#.push_str("        sub(/ \\{[[:space:]]*$/, \"\", sig)\n")
    script#.push_str("        print \"### `\" sig \"`\\n\"\n")
    script#.push_str("        print doc\n")
    script#.push_str("        doc = \"\"\n")
    script#.push_str("      }\n")
    script#.push_str("      next\n")
    script#.push_str("    }\n")
    script#.push_str("    { doc = \"\" }\n")
    script#.push_str("  ' \"$file\" > .tmp_doc\n")
    script#.push_str("  if [ -s .tmp_doc ]; then\n")
    script#.push_str("    echo \"## \\`$file\\`\" >> \"$doc_file\"\n")
    script#.push_str("    echo \"\" >> \"$doc_file\"\n")
    script#.push_str("    cat .tmp_doc >> \"$doc_file\"\n")
    script#.push_str("    echo \"\" >> \"$doc_file\"\n")
    script#.push_str("  fi\n")
    script#.push_str("  rm -f .tmp_doc\n")
    script#.push_str("done\n")
    script#.push_str("echo \"Documentation generated at $doc_file\"\n")
    
    write_string(string::from(".toka_doc_generator.sh"), script.as_str())
    
    unsafe {
        auto res = libc_system(c"bash .toka_doc_generator.sh")
        if res != 0 && check_is_windows() {
            println("\n\x1b[33m提示：在 Windows 原生命令行下，'toka doc' 需要 Bash 环境（如 Git Bash 或 MSYS2）来调度文档生成。\x1b[0m")
        }
        
        remove_file(string::from(".toka_doc_generator.sh"))
        return res
    }
}

fn cmd_clean() -> i32 {
    unsafe {
        if check_is_windows() {
            libc_system(c"rmdir /s /q target build .tokapkg .toka 2>nul")
            remove_file(string::from(".toka_build_exe.exe"))
            remove_file(string::from(".toka_single_exe.exe"))
            remove_file(string::from(".toka_test_exe.exe"))
            remove_file(string::from(".toka_test_out"))
        } else {
            libc_system(c"rm -rf target build .toka_build_exe .toka_single_exe .tokapkg .toka")
        }
        println("Cleaned build artifacts.")
        return 0
    }
}

fn cmd_fmt() -> i32 {
    unsafe {
        println("Formatting project...")
        auto tokafmt = detect_tokafmt_path()
        auto is_windows = check_is_windows()
        
        auto cmd1# = tokafmt.clone()
        if is_windows {
            cmd1#.push_str(" src/ lib/ tests/ Project.tk 2>nul")
        } else {
            cmd1#.push_str(" src/ lib/ tests/ Project.tk 2>/dev/null")
        }
        
        auto res# = libc_system(cmd1.c_str())
        if res != 0 {
            auto cmd2# = tokafmt.clone()
            if is_windows {
                cmd2#.push_str(" . 2>nul")
            } else {
                cmd2#.push_str(" . 2>/dev/null")
            }
            res = libc_system(cmd2.c_str())
        }
        if res == 0 {
            println("Format complete.")
        }
        return res
    }
}

fn main() -> i32 {
    auto argc = env::args_count()
    if argc < 2 {
        print_help()
        return 1
    }
    
    auto cmd# = env::get_arg(1)
    auto shift# = 0
    // If run via lli, argv[1] might be the .ll file itself
    if cmd.ends_with(".ll") {
        shift = 1
        if argc < 3 {
            print_help()
            return 1
        }
        cmd = env::get_arg(2)
    }
    
    if cmd.eq(string::from("new")) {
        if argc < 3 + shift {
             println("Error: 'toka new' requires a project name.")
             return 1
        }
        auto name = env::get_arg(2 + shift)
        auto is_lib# = false
        if argc >= 4 + shift {
            auto flag = env::get_arg(3 + shift)
            if flag.eq(string::from("--lib")) {
                is_lib = true
            }
        }
        return cmd_new(name, is_lib)
    }
    
    if cmd.eq(string::from("init")) {
        auto is_lib# = false
        if argc >= 3 + shift {
            auto flag = env::get_arg(2 + shift)
            if flag.eq(string::from("--lib")) {
                is_lib = true
            }
        }
        return cmd_init(is_lib)
    }
    
    if cmd.eq(string::from("add")) {
        if argc < 3 + shift {
             println("Error: 'toka add' requires a package URL.")
             return 1
        }
        auto url = env::get_arg(2 + shift)
        return cmd_add(url)
    }
    
    if cmd.eq(string::from("rm")) {
        println("TODO: Implement toka rm")
        return 0
    }
    
    if cmd.eq(string::from("up")) {
        println("TODO: Implement toka up")
        return 0
    }
    
    if cmd.eq(string::from("fetch")) {
        return cmd_fetch()
    }
    
    if cmd.eq(string::from("search")) {
        if argc < 3 + shift {
             println("Error: 'toka search' requires a query string.")
             return 1
        }
        auto query = env::get_arg(2 + shift)
        return cmd_search(query)
    }
    
    if cmd.eq(string::from("publish")) {
        return cmd_publish()
    }
    
    if cmd.eq(string::from("build")) {
        auto use_forge# = false
        auto extra_args# = Vec<string>::new()
        auto idx#: i32 = (2 + shift) as i32
        loop idx < argc {
            auto arg = env::get_arg(idx)
            if arg.eq(string::from("--forge")) || arg.eq(string::from("-f")) {
                use_forge = true
            } else {
                extra_args#.push(cede arg.clone())
            }
            idx += 1
        }
        return cmd_build(use_forge, extra_args)
    }
    
    if cmd.eq(string::from("run")) {
        auto use_forge# = false
        auto idx#: i32 = (2 + shift) as i32
        auto single_file# = string::from("")
        loop idx < argc {
            auto arg = env::get_arg(idx)
            if arg.eq(string::from("--forge")) || arg.eq(string::from("-f")) {
                use_forge = true
            } else if !arg.starts_with("-") {
                single_file = arg.clone()
            }
            idx += 1
        }
        if !single_file.is_empty() {
            if use_forge {
                env::set_var(string::from("TOKA_USE_FORGE"), string::from("1"))
            } else {
                env::set_var(string::from("TOKA_USE_FORGE"), string::from("0"))
            }
            return cmd_run_single(single_file)
        }
        return cmd_run(use_forge)
    }
    
    if cmd.eq(string::from("test")) {
        return cmd_test()
    }
    
    if cmd.eq(string::from("doc")) {
        return cmd_doc()
    }
    
    if cmd.eq(string::from("clean")) {
        return cmd_clean()
    }
    
    if cmd.eq(string::from("fmt")) {
        return cmd_fmt()
    }
    
    if cmd.eq(string::from("--version")) || cmd.eq(string::from("-v")) {
        println("toka manager version 0.9.8")
        return 0
    }
    
    println("Error: unknown command '{}'", cmd)
    return 1
}
