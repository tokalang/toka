fn print_help() {
    println("Toka {}", "0.9.9-01")
    println("\nUsage: toka <command> [options]\n\nCommands:")
    println("  new <name>   Create a new Toka project (--lib for library)")
    println("  init         Initialize a new Toka project in the current directory")
    println("  build        Compile current project to an executable")
    println("  run [file]   Compile and execute a Toka program")
    println("  check        Type-check source files (--json for structured diagnostics)")
    println("  explain      Explain a diagnostic code (--json for machine output)")
    println("  context      Emit bounded semantic context for an AI/editor query")
    println("  evidence     Emit public semantic evidence JSON for a compiler check")
    println("  cede-obligations  Emit cede transfer-obligation evidence JSON")
    println("  capabilities Emit H/P call capability evidence JSON")
    println("  todo-goals   Emit typed-todo requirement evidence JSON")
    println("  conditional-facts Emit typed-todo conditional binding facts JSON")
    println("  index        Emit compiler-owned semantic index JSON for API tooling")
    println("  build --validate-semantic-manifests  Validate admitted source-less TKI sidecars")
    println("  preview      Compare base/candidate snapshots without writing either one")
    println("  query        Run a compiler semantic query (definition, references, rename)")
    println("  test         Run all tests in the tests/ directory")
    println("  doc          Generate API documentation")
    println("  add <url>    Add a package dependency")
    println("  rm <pkg>     Remove a package dependency")
    println("  up           Update package dependencies")
    println("  fetch        Fetch dependencies (Implicit in build)")
    println("  search <q>   Search for packages in the registry")
    println("  publish      Package and publish to the Toka registry")
    println("  fmt          Format the current project")
    println("  doctor       Check the installed SDK and native toolchain")
    println("  clean        Clean build artifacts")
    println("\nOptions:")
    println("  -h, --help     Show this help")
    println("  -V, --version  Show version information")
    println("  -v, --verbose  Enable verbose compiler output")
    println("  -f, --forge    Enable forge multi-threaded parallel incremental build engine")
}

fn check_is_windows() -> bool {
    unsafe {
        auto os_env = libc_getenv(c"OS") as Addr
        if os_env != 0:Addr {
            auto os_str = string::from_cstr(os_env as *char)
            if os_str == string::from("Windows_NT") {
                return true
            }
        }
        return false
    }
}

fn shell_quote(s: string) -> string {
    if check_is_windows() {
        auto res# = string::from("\"")
        auto view = s.as_str()
        auto len = view.len()
        auto i# = 0:usize
        loop {
            if i >= len { break }
            auto c = view.byte_at(i)
            if c == '"' {
                res#.push_str("\\\"")
            } else {
                res#.push_char(c)
            }
            i = i + 1:usize
        }
        res#.push_str("\"")
        return res
    } else {
        auto res# = string::from("'")
        auto view = s.as_str()
        auto len = view.len()
        auto i# = 0:usize
        loop {
            if i >= len { break }
            auto c = view.byte_at(i)
            if c == '\'' {
                res#.push_str("'\\''")
            } else {
                res#.push_char(c)
            }
            i = i + 1:usize
        }
        res#.push_str("'")
        return res
    }
}

fn get_dirname(path: string) -> string {
    auto idx_opt = path.as_str().last_index_of('/' as char)
    auto idx_opt2 = path.as_str().last_index_of('\\' as char)
    
    auto last_slash_pos# = -1:i32
    if idx_opt.is_some() {
        last_slash_pos = idx_opt.unwrap() as i32
    }
    if idx_opt2.is_some() {
        auto pos2 = idx_opt2.unwrap() as i32
        if pos2 > last_slash_pos {
            last_slash_pos = pos2
        }
    }
    
    if last_slash_pos > 0 {
        return path.substring(0, last_slash_pos)
    }
    return string::from(".")
}

fn detect_default_lib_path() -> string {
    unsafe {
        auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
        if toka_lib != 0:Addr {
            return string::from_cstr(toka_lib as *char)
        }
    }
    
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        
        auto parent_dir = get_dirname(exe_dir.clone())
        auto candidate1# = parent_dir.clone()
        candidate1#.push_str("/share/toka/lib")
        if exists(candidate1.clone()) {
            return candidate1
        }

        auto candidate_installed_lib# = parent_dir.clone()
        candidate_installed_lib#.push_str("/lib/toka")
        if exists(candidate_installed_lib.clone()) {
            return candidate_installed_lib
        }
        
        auto candidate2# = parent_dir.clone()
        candidate2#.push_str("/lib")
        if exists(candidate2.clone()) {
            auto marker# = candidate2.clone()
            marker#.push_str("/core/prelude.tk")
            if exists(marker) {
                return candidate2
            }
        }

        auto candidate3# = exe_dir.clone()
        candidate3#.push_str("/lib")
        if exists(candidate3.clone()) {
            return candidate3
        }
    }
    
    if check_is_windows() {
        auto win_fallback = string::from("C:\\ProgramData\\toka\\lib")
        if exists(win_fallback.clone()) {
            return win_fallback
        }
        return string::from("lib")
    }
    
    return string::from("/usr/local/lib/toka")
}

fn detect_tokafmt_path() -> string {
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        auto candidate# = exe_dir.clone()
        if check_is_windows() {
            candidate#.push_str("\\tokafmt.exe")
        } else {
            candidate#.push_str("/tokafmt")
        }
        if exists(candidate.clone()) {
            return candidate
        }
    }
    return string::from("tokafmt")
}

fn detect_tokac_path() -> string {
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        auto candidate# = exe_dir.clone()
        if check_is_windows() {
            candidate#.push_str("\\tokac.exe")
        } else {
            candidate#.push_str("/tokac")
        }
        if exists(candidate.clone()) {
            return candidate
        }
    }
    return string::from("tokac")
}

fn detect_semantic_preview_path() -> string {
    auto exe_path = env::get_arg(0)
    if !exe_path.is_empty() {
        auto exe_dir = get_dirname(exe_path)
        auto build_dir = get_dirname(exe_dir)
        auto source_root = get_dirname(build_dir)
        auto source_script# = source_root.clone()
        source_script#.push_str("/tools/scripts/semantic_diff_preview.py")
        if exists(source_script.clone()) {
            return source_script
        }
    }
    auto lib_path = detect_default_lib_path()
    auto installed_script# = lib_path.clone()
    installed_script#.push_str("/toolchain/semantic_diff_preview.py")
    return installed_script
}

fn print_manager_version() {
    auto compiler# = Command::new(detect_tokac_path())
    compiler#.arg(string::from("--version"))
    auto result = compiler#.output()
    if result.is_ok() {
        auto output = result.unwrap()
        if output.status.success() {
            println("toka manager {}", output.stdout)
            return
        }
    }
    println("toka manager version unavailable")
}

fn get_basename(path: string) -> string {
    auto idx_opt = path.as_str().last_index_of('/' as char)
    auto idx_opt2 = path.as_str().last_index_of('\\' as char)
    
    auto last_slash_pos# = -1:i32
    if idx_opt.is_some() {
        last_slash_pos = idx_opt.unwrap() as i32
    }
    if idx_opt2.is_some() {
        auto pos2 = idx_opt2.unwrap() as i32
        if pos2 > last_slash_pos {
            last_slash_pos = pos2
        }
    }
    
    if last_slash_pos != -1 {
        auto result = path.substring(last_slash_pos + 1, path.len() as i32)
        if result.is_empty() || result.as_str().contains_char(':' as char) {
            return string::from("toka_project")
        }
        return result
    }
    if path.is_empty() || path.as_str().contains_char(':' as char) {
        return string::from("toka_project")
    }
    return path.clone()
}

fn generate_project_files(name: string, dest_dir: string, is_lib: bool) {
    auto pkg_content# = string::from("pub const PACKAGE = (\n    name = \"")
    pkg_content#.push_str(name.as_str())
    pkg_content#.push_str("\",\n    version = \"0.1.0\",\n    dependencies = (\n    )\n)\n")

    auto pkg_path# = string::from("")
    if !dest_dir.is_empty() {
        pkg_path#.push_str(dest_dir.as_str())
        pkg_path#.push_str("/")
    }
    pkg_path#.push_str("package.tk")
    write_string(pkg_path, pkg_content.as_str())

    if is_lib {
        auto build_content# = string::from("import build::{Library, run_build}\n\nfn main() -> i32 {\n    auto lib# = Library::make(c\"")
        build_content#.push_str(name.as_str())
        build_content#.push_str("\", c\"lib/")
        build_content#.push_str(name.as_str())
        build_content#.push_str("/mod.tk\")\n    return run_build(lib)\n}\n")

        auto build_path# = string::from("")
        if !dest_dir.is_empty() {
            build_path#.push_str(dest_dir.as_str())
            build_path#.push_str("/")
        }
        build_path#.push_str("build.tk")
        write_string(build_path, build_content.as_str())
    } else {
        auto build_content# = string::from("import build::{Executable, run_build}\n\nfn main() -> i32 {\n    auto app# = Executable::make(c\"")
        build_content#.push_str(name.as_str())
        build_content#.push_str("\", c\"src/main.tk\")\n    return run_build(app)\n}\n")

        auto build_path# = string::from("")
        if !dest_dir.is_empty() {
            build_path#.push_str(dest_dir.as_str())
            build_path#.push_str("/")
        }
        build_path#.push_str("build.tk")
        write_string(build_path, build_content.as_str())
    }
}


fn cmd_new(name: string, is_lib: bool) -> i32 {
    if exists(name.clone()) {
        println("Error: Directory '{}' already exists! Aborting.", name)
        return 1
    }
    
    if is_lib {
        // 先建母体目录，再建子目录
        create_dir(name.clone())
        
        auto lib_dir# = name.clone()
        lib_dir#.push_str("/lib")
        create_dir(lib_dir.clone())
        
        lib_dir#.push_str("/")
        lib_dir#.push_str(name.as_str())
        create_dir(lib_dir.clone())
        
        lib_dir#.push_str("/mod.tk")
        write_string(lib_dir, "// Library module\n\npub fn hello() {\n    // TODO: implement\n}\n")
        
        generate_project_files(name.clone(), name.clone(), is_lib)
        println("Created new Toka library: {}", name)
    } else {
        // 先建母体目录，再建子目录
        create_dir(name.clone())
        
        auto src_dir# = name.clone()
        src_dir#.push_str("/src")
        create_dir(src_dir.clone())
        
        src_dir#.push_str("/main.tk")
        write_string(src_dir, "import std/io::{println, File}\nimport std/fs::{read_to_string}\n\nfn main() -> i32 {\n    println(\"Hello, Toka!\")\n    return 0\n}\n")
        
        generate_project_files(name.clone(), name.clone(), is_lib)
        println("Created new Toka project: {}", name)
    }
    return 0
}

fn cmd_init(is_lib: bool) -> i32 {
    if exists(string::from("package.tk")) {
        println("Error: package.tk already exists in this directory.")
        return 1
    }
    
    auto cwd = env::current_dir()
    auto name# = get_basename(cwd)
    if name.is_empty() {
        name = string::from("my_project")
    }
    
    if is_lib {
        if !exists(string::from("lib")) {
            create_dir(string::from("lib"))
        }
        
        auto lib_dir# = string::from("lib/")
        lib_dir#.push_str(name.as_str())
        if !exists(lib_dir.clone()) {
            create_dir(lib_dir.clone())
        }
        
        lib_dir#.push_str("/mod.tk")
        write_string(lib_dir, "// Library module\n\npub fn hello() {\n}\n")
    } else {
        if !exists(string::from("src")) {
            create_dir(string::from("src"))
        }
        write_string(string::from("src/main.tk"), "import std/io::{println, File}\nimport std/fs::{read_to_string}\n\nfn main() -> i32 {\n    println(\"Hello, Toka!\")\n    return 0\n}\n")
    }
    
    generate_project_files(name, string::from(""), is_lib)
    println("Initialized Toka project in current directory.")
    return 0
}

fn cmd_add(pkg_url_or_name: string) -> i32 {
    unsafe {
        auto pkg_url# = pkg_url_or_name.clone()
        auto pkg_alias# = string::from("")
        
        // If it doesn't contain '/', it's a registry lookup
        if !pkg_url.contains("/") {
            auto resolved = resolve_package(pkg_url_or_name)
            if resolved.is_some() {
                pkg_url = resolved.unwrap()
                pkg_alias = pkg_url_or_name.clone()
                println("\x1b[32m[Registry]\x1b[0m Resolved {} to {}", pkg_url_or_name, pkg_url)
            } else {
                println("\x1b[31m[Error]\x1b[0m Package '{}' not found in registry.", pkg_url_or_name)
                return 1
            }
        } else {
            // Direct URL parsing
            auto iter# = pkg_url.split('/' as i32)
            loop !iter.is_done() {
                auto part = iter#.next()
                if !part.is_empty() {
                    pkg_alias = part.clone()
                }
            }
            
            auto colon_idx = pkg_alias.find_str(":")
            if colon_idx != -1 {
                pkg_alias = pkg_alias.substring(0, colon_idx)
            }
        }
        
        if pkg_alias.is_empty() {
            println("\x1b[1;31m       Error\x1b[0m invalid package URL or name")
            return 1
        }
        
        println("\x1b[1;32m      Adding\x1b[0m package {} -> {}", pkg_alias, pkg_url)
        
        if !exists(string::from("package.tk")) {
            println("\x1b[1;31m       Error\x1b[0m package.tk not found. Are you in a Toka project?")
            return 1
        }
        
        auto res = read_to_string(string::from("package.tk"))
        if res.is_err() {
            println("\x1b[1;31m       Error\x1b[0m failed to read package.tk")
            return 1
        }
        
        auto pkg_content = res.unwrap()
        auto deps_idx = pkg_content.find_str("dependencies = (")
        if deps_idx == -1 {
            println("Error: Invalid package.tk format (missing dependencies block)")
            return 1
        }
        
        auto insert_pos = deps_idx + 16
        auto new_content# = pkg_content.substring(0, insert_pos)
        new_content#.push_str("
        ")
        new_content#.push_str(pkg_alias.as_str())
        new_content#.push_str(" = \"")
        new_content#.push_str(pkg_url.as_str())
        new_content#.push_str("\",")
        
        auto rest = pkg_content.substring(insert_pos, pkg_content.len() as i32)
        new_content#.push_str(rest.as_str())
        
        write_string(string::from("package.tk"), new_content.as_str())
        
        println("\x1b[1;32m       Added\x1b[0m {} to package.tk", pkg_alias)
        
        println("\x1b[1;32m    Resolving\x1b[0m package graph...")
        auto fetch_result = cmd_fetch()
        if fetch_result != 0 {
            write_string(string::from("package.tk"), pkg_content.as_str())
            println("\x1b[1;31m       Error\x1b[0m dependency resolution failed; package.tk restored")
            return fetch_result
        }
        return 0
    }
}

fn cmd_build(use_forge: bool, extra_args: Vec<string>) -> i32 {
    if use_forge {
        env::set_var(string::from("TOKA_USE_FORGE"), string::from("1"))
    } else {
        env::set_var(string::from("TOKA_USE_FORGE"), string::from("0"))
    }
    auto tokac_path = detect_tokac_path()
    auto default_lib = detect_default_lib_path()
    unsafe {
        libc_setenv(c"TOKA_LIB", default_lib.c_str(), 1)
        libc_setenv(c"TOKAC", tokac_path.c_str(), 1)
    }
    if exists(string::from("package.tk")) {
        auto fetch_res = cmd_fetch_quiet()
        if fetch_res != 0 {
            return fetch_res
        }
    }

    {
        auto pkg_mappings = build_pkg_mappings()
        auto pkg_node_mappings = build_pkg_node_mappings()
        auto workspace_node = build_workspace_node()
        auto mapping_env# = string::from("")
        auto mapping_index# = 0:usize
        loop mapping_index < pkg_mappings.len() {
            if mapping_index > 0:usize { mapping_env#.push_str("\n") }
            mapping_env#.push_str(pkg_mappings.get_ref(mapping_index).as_str())
            mapping_index += 1
        }
        env::set_var(string::from("TOKA_PKG_MAP_V1"), mapping_env)
        env::set_var(string::from("TOKA_PKG_ARGS"), string::from(""))
        
        auto build_file# = string::from("build.tk")
        if !exists(string::from("build.tk")) {
            if exists(string::from("Project.tk")) {
                println("\n\x1b[33mWarning: Project.tk is deprecated. Please rename it to build.tk\x1b[0m\n")
                build_file = string::from("Project.tk")
            } else {
                println("\x1b[1;31m       Error\x1b[0m build.tk not found in current directory.")
                return 1
            }
        }
        
        auto executable# = string::from(".toka_build_exe")
        if check_is_windows() { executable#.push_str(".exe") }
        auto validate_semantic_manifests# = false
        auto profile_index# = 0:usize
        loop profile_index < extra_args.len() {
            if extra_args.get_ref(profile_index).eq(string::from("--validate-semantic-manifests")) {
                validate_semantic_manifests = true
            }
            profile_index += 1
        }
        auto compile# = Command::new(cede tokac_path.clone())
        compile#.arg(string::from("-I"))
        compile#.arg(cede default_lib.clone())
        if !workspace_node.is_empty() {
            compile#.arg(string::from("--workspace-node"))
            compile#.arg(cede workspace_node.clone())
            compile#.arg(string::from("--workspace-root"))
            compile#.arg(env::current_dir())
        }
        auto pkg_index# = 0:usize
        loop pkg_index < pkg_mappings.len() {
            compile#.arg(string::from("--pkg"))
            compile#.arg(cede pkg_mappings.get_ref(pkg_index).clone())
            pkg_index += 1
        }
        auto node_index# = 0:usize
        loop node_index < pkg_node_mappings.len() {
            compile#.arg(string::from("--pkg-node"))
            compile#.arg(cede pkg_node_mappings.get_ref(node_index).clone())
            node_index += 1
        }
        if validate_semantic_manifests {
            compile#.arg(string::from("--validate-semantic-manifests"))
        }
        compile#.arg(cede build_file.clone())
        compile#.arg(string::from("-o"))
        compile#.arg(cede executable.clone())
        compile#.arg(string::from("-O3"))
        if compile#.status() != 0 {
            println("\x1b[1;31m       Error\x1b[0m executing {} -> compile failed", build_file)
            return 1
        }
        auto run_path# = string::from(".toka_build_exe")
        if check_is_windows() {
            run_path#.push_str(".exe")
        } else {
            run_path = string::from("./.toka_build_exe")
        }
        auto run# = Command::new(cede run_path)
        run#.arg(string::from("--tokac"))
        run#.arg(cede tokac_path.clone())
        run#.arg(string::from("--toka-lib"))
        run#.arg(cede default_lib.clone())
        if !workspace_node.is_empty() {
            run#.arg(string::from("--workspace-node"))
            run#.arg(cede workspace_node)
            run#.arg(string::from("--workspace-root"))
            run#.arg(env::current_dir())
        }
        auto run_node_index# = 0:usize
        loop run_node_index < pkg_node_mappings.len() {
            run#.arg(string::from("--pkg-node"))
            run#.arg(cede pkg_node_mappings.get_ref(run_node_index).clone())
            run_node_index += 1
        }
        auto idx_extra# = 0:usize
        loop idx_extra < extra_args.len() {
            run#.arg(cede extra_args.get_ref(idx_extra).clone())
            idx_extra += 1
        }
        auto run_result = run#.try_status()
        if run_result.is_err() {
            auto error = run_result.unwrap_err()
            println("\x1b[1;31m       Error\x1b[0m executing build program (process error {})", error.code)
            return 1
        }
        return run_result.unwrap().legacy_code()
    }
}

fn cmd_run_single(file: string) -> i32 {
    unsafe {
        auto cmd# = string::from("")
        auto tokac_path = detect_tokac_path()
        cmd#.push_str(tokac_path.as_str())
        cmd#.push_str(" ")
        auto default_lib = detect_default_lib_path()
        cmd#.push_str("-I ")
        cmd#.push_str(default_lib.as_str())
        cmd#.push_str(" ")
        
        auto is_windows = check_is_windows()
        
        cmd#.push_str(file.as_str())
        if is_windows {
            cmd#.push_str(" -o .toka_single_exe.exe -O3 && .toka_single_exe.exe")
        } else {
            cmd#.push_str(" -o .toka_single_exe -O3 && ./.toka_single_exe")
        }

        auto res = libc_system(cmd.c_str())
        if res != 0 {
            println("\x1b[1;31m       Error\x1b[0m executing {}", file)
        }
        if is_windows {
            remove_file(string::from(".toka_single_exe.exe"))
        } else {
            remove_file(string::from(".toka_single_exe"))
        }
        if res != 0 { return 1 }
        return 0
    }
}

fn find_newest_executable(dir_path: string) -> string {
    auto newest_file# = string::from("")
    auto newest_mtime# = -2:i64
    
    auto dir# = read_dir(dir_path.clone())
    loop {
        auto entry_opt = dir#.next()
        match cede entry_opt {
            auto Option<string>::Some('entry) => {
                if 'entry.ends_with(".ll") {
                    continue
                }
                auto full_path# = dir_path.clone()
                full_path#.push_str("/")
                full_path#.push_str('entry.as_str())
                auto meta_res = metadata(full_path.clone())
                if meta_res.is_ok() {
                    auto meta = meta_res.unwrap()
                    if meta.is_file() {
                        auto mtime = meta.modified()
                        if mtime > newest_mtime {
                            newest_mtime = mtime
                            newest_file = cede 'entry
                        }
                    }
                }
            }
            Option<string>::None => break
        }
    }
    dir#.close()
    return newest_file
}

fn cmd_run(use_forge: bool) -> i32 {
    auto extra_args = Vec<string>::new()
    auto res = cmd_build(use_forge, extra_args)
    if res != 0 { return res }
    
    auto target_dir = string::from("target/debug")
    auto newest_exe = find_newest_executable(target_dir)
    if newest_exe.is_empty() {
        println("\x1b[1;31m       Error\x1b[0m no executable found in target/debug")
        return 1
    }
    
    unsafe {
        auto is_windows# = false
        auto os_env = libc_getenv(c"OS") as Addr
        if os_env != 0:Addr {
            auto os_str = string::from_cstr(os_env as *char)
            if os_str == string::from("Windows_NT") {
                is_windows = true
            }
        }
        
        auto run_cmd# = string::from("")
        if is_windows {
            run_cmd = string::from("target\\debug\\")
            run_cmd#.push_str(newest_exe.as_str())
        } else {
            run_cmd = string::from("./target/debug/")
            run_cmd#.push_str(newest_exe.as_str())
        }
        
        auto run_res = libc_system(run_cmd.c_str())
        if run_res != 0 { return 1 }
        return 0
    }
}

fn cmd_check(argc: i32, shift: i32) -> i32 {
    if argc < 3 + shift {
        println("Error: 'toka check' requires at least one source file.")
        return 1
    }
    auto command# = Command::new(detect_tokac_path())
    command#.arg(string::from("--check-only"))
    command#.arg(string::from("-I"))
    command#.arg(detect_default_lib_path())
    auto idx# = 2 + shift
    loop idx < argc {
        auto arg = env::get_arg(idx)
        if arg.eq(string::from("--json")) {
            command#.arg(string::from("--diagnostics-json"))
        } else {
            command#.arg(cede arg)
        }
        idx += 1
    }
    return command#.status()
}

fn cmd_explain(argc: i32, shift: i32) -> i32 {
    if argc < 3 + shift {
        println("Error: 'toka explain' requires a diagnostic code.")
        return 1
    }
    auto command# = Command::new(detect_tokac_path())
    auto json# = false
    auto idx# = 3 + shift
    loop idx < argc {
        if env::get_arg(idx).eq(string::from("--json")) { json = true }
        idx += 1
    }
    if json {
        command#.arg(string::from("--explain=json"))
    } else {
        command#.arg(string::from("--explain"))
    }
    command#.arg(env::get_arg(2 + shift))
    return command#.status()
}

