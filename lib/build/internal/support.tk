import std/env
import std/path::{join, is_absolute}
import std/vec::{Vec}

pub fn __path_normalize(path: string) -> string {
    auto res# = string::from("")
    auto view = path.as_str()
    auto len = view.len()
    auto i# = 0:usize
    loop {
        if i >= len { break }
        auto c = view.byte_at(i)
        if c == '\\' {
            res#.push_char('/')
        } else {
            res#.push_char(c)
        }
        i = i + 1:usize
    }
    return res
}

pub fn __path_canonicalize(p: string) -> string {
    auto path_str# = p.clone()
    if !is_absolute(path_str.clone()) {
        auto cwd = env::current_dir()
        path_str = join(cwd, path_str)
    }

    auto norm# = __path_normalize(path_str)
    auto parts = norm.split('/' as i32)
    auto resolved_parts# = Vec<string>::new()
    resolved_parts = cede resolved_parts

    loop !parts.is_done() {
        auto part = parts#.next()
        if part.is_empty() || part == string::from(".") {
            continue
        }
        if part == string::from("..") {
            if resolved_parts.len() > 0:usize {
                resolved_parts#.pop()
            }
        } else {
            resolved_parts#.push(cede part.clone())
        }
    }

    auto res# = string::from("")
    if norm.starts_with("/") {
        res#.push_str("/")
    }

    auto i# = 0:u64
    loop i < resolved_parts.len() {
        if i > 0 {
            res#.push_str("/")
        }
        res#.push_str(resolved_parts.get_ref(i).as_str())
        i += 1
    }
    return res
}

fn u64_to_hex(val: u64) -> string {
    auto hex_chars = "0123456789abcdef"
    auto res# = string::from("")
    auto i# = 0
    auto v# = val
    loop {
        if i >= 16 { break }
        auto shift = (15 - i) * 4
        auto digit = (v >> (shift as u64)) & 15:u64
        res#.push_char(hex_chars.byte_at(digit as usize))
        i = i + 1
    }
    return res
}

pub fn __calculate_fnv1a(str: string) -> string {
    auto hash# = 14695981039346656037:u64
    auto view = str.as_str()
    auto len = view.len()
    auto i# = 0:usize
    loop {
        if i >= len { break }
        auto c = view.byte_at(i)
        hash = hash ^ (c as u64)
        hash = hash * 1099511628211:u64
        i = i + 1:usize
    }
    return u64_to_hex(hash)
}
