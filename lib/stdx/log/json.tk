// Deterministic JSON Lines logging for services.  This module owns no global
// sink: applications choose whether to render, print, or route a line.

import core/option::{Option}
import std/io::{print_line}
import std/vec::{Vec}
import stdx/log/log::{LogLevel, LOG_DEBUG, LOG_INFO, LOG_WARN, LOG_ERROR}
import stdx/serde/json::{write_escaped_json_string}

pub shape JsonField (
    key: string,
    value: string
)

impl JsonField@encap {
    pub key
    pub value
    fn drop(self#) {}
}

impl JsonField {
    pub fn clone(self) -> JsonField {
        return JsonField(
            key = string::from(self.key.as_str()),
            value = string::from(self.value.as_str())
        )
    }
}

impl JsonField {
    pub fn new(key: string, value: string) -> JsonField {
        return JsonField(key = key.clone(), value = value.clone())
    }
}

fn append_level(out#: string, level: LogLevel) {
    if level == LOG_DEBUG { write_escaped_json_string("debug", out) }
    else if level == LOG_INFO { write_escaped_json_string("info", out) }
    else if level == LOG_WARN { write_escaped_json_string("warn", out) }
    else { write_escaped_json_string("error", out) }
}

pub shape JsonLogger (
    level: LogLevel
)

impl JsonLogger {
    pub fn clone(self) -> JsonLogger {
        return JsonLogger(level = self.level)
    }
}

impl JsonLogger {
    pub fn new(level: LogLevel) -> JsonLogger {
        return JsonLogger(level = level)
    }

    pub fn set_level(self#, level: LogLevel) {
        self.level = level
    }

    // Returns None before allocating when this event is below the configured
    // threshold.  Field order is caller order, making output deterministic.
    pub fn format(self, level: LogLevel, message: string, fields#: Vec<JsonField>) -> Option<string> {
        if level < self.level {
            return Option<string>::None
        }

        auto line# = string::from("{\"level\":")
        append_level(line, level)
        line#.push_str(",\"message\":")
        write_escaped_json_string(message.as_view(), line)

        auto index# = 0:usize
        loop index < fields.len() {
            auto field = fields#.get(index).clone()
            line#.push_str(",")
            write_escaped_json_string(field.key.as_view(), line)
            line#.push_str(":")
            write_escaped_json_string(field.value.as_view(), line)
            index += 1
        }
        line#.push_str("}")
        return Option<string>::Some(cede line)
    }

    pub fn emit(self, level: LogLevel, message: string, fields#: Vec<JsonField>) {
        auto line = self.format(level, message, fields)
        match line {
            auto Option::Some(&rendered) => print_line(string::from(rendered.as_str()))
            _ => {}
        }
    }
}
