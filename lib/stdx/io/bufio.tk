import core/types::{usize, Addr}
import core/result::{Result}
import sys/libc::*
import std/io::{@Reader, @Writer}

/// BufferedReader wraps a reader and buffers its input.
pub shape BufferedReader<'R: @Reader> (
    'reader: R,
    buf: [u8; 4096],
    pos: usize,
    cap: usize
)

impl<'R: @Reader> BufferedReader<'R> {
    pub fn new(reader: cede 'R) -> BufferedReader<'R> {
        auto init_buf = [0:u8; 4096]
        return BufferedReader<'R>(
            reader = cede reader,
            buf = init_buf,
            pos = 0 as usize,
            cap = 0 as usize
        )
    }

    pub fn make(reader: cede 'R) -> ^BufferedReader<'R> {
        auto init_buf = [0:u8; 4096]
        return new BufferedReader<'R>(
            reader = cede reader,
            buf = init_buf,
            pos = 0 as usize,
            cap = 0 as usize
        )
    }

    pub fn read_bytes(self#, *out_buf: u8, len: usize) -> Result<usize, string> {
        if len == 0 as usize {
            return Result<usize, string>::Ok(0 as usize)
        }

        if self.pos >= self.cap {
            auto fill_res = self#.fill_buf()
            match fill_res {
                auto Result::Ok(n) => {
                    if n == 0 as usize {
                        return Result<usize, string>::Ok(0 as usize)
                    }
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }

        auto avail = self.cap - self.pos
        auto to_copy# = len
        if to_copy > avail {
            to_copy = avail
        }

        unsafe {
            auto *src = &self.buf[self.pos] as *u8
            libc_memcpy(*out_buf as *void, *src as *void, to_copy)
        }

        self.pos = self.pos + to_copy
        return Result<usize, string>::Ok(to_copy)
    }

    pub fn read_line(self#) -> Result<string, string> {
        auto s# = string::from("")
        auto done# = false
        
        loop !done {
            if self.pos >= self.cap {
                auto fill_res = self#.fill_buf()
                match fill_res {
                    auto Result::Ok(n) => {
                        if n == 0 as usize {
                            done = true
                            break
                        }
                    }
                    auto Result::Err(&e) => {
                        return Result<string, string>::Err(e.clone())
                    }
                }
            }
            
            auto start_pos = self.pos
            auto found_nl# = false
            auto nl_idx# = self.pos
            
            loop nl_idx < self.cap {
                auto val = self.buf[nl_idx]
                if val == 10:u8 {
                    found_nl = true
                    break
                }
                nl_idx = nl_idx + (1 as usize)
            }
            
            auto end_pos# = nl_idx
            if found_nl {
                end_pos = end_pos + (1 as usize)
                done = true
            }
            
            auto chunk_len = end_pos - start_pos
            if chunk_len > 0 as usize {
                unsafe {
                    auto *chunk_ptr = &self.buf[start_pos] as *u8
                    s#.push_buf(*chunk_ptr, chunk_len)
                }
                self.pos = end_pos
            }
        }
        
        return Result<string, string>::Ok(s)
    }

    fn fill_buf(self#) -> Result<usize, string> {
        auto *ptr = &self.buf[0] as *u8
        auto res = self.reader#.read_bytes(*ptr, 4096 as usize)
        match res {
            auto Result::Ok(n) => {
                self.pos = 0 as usize
                self.cap = n
                return Result<usize, string>::Ok(n)
            }
            auto Result::Err(&e) => {
                return Result<usize, string>::Err(e.clone())
            }
        }
    }
}

impl<'R: @Reader> BufferedReader<'R>@Reader {
    pub fn read_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.read_bytes(*buf, len)
    }
}

/// BufferedWriter wraps a writer and buffers its output.
pub shape BufferedWriter<'W: @Writer> (
    'writer: W,
    buf: [u8; 4096],
    pos: usize
)

impl<'W: @Writer> BufferedWriter<'W> {
    pub fn new(writer: cede 'W) -> BufferedWriter<'W> {
        auto init_buf = [0:u8; 4096]
        return BufferedWriter<'W>(
            writer = cede writer,
            buf = init_buf,
            pos = 0 as usize
        )
    }

    pub fn make(writer: cede 'W) -> ^BufferedWriter<'W> {
        auto init_buf = [0:u8; 4096]
        return new BufferedWriter<'W>(
            writer = cede writer,
            buf = init_buf,
            pos = 0 as usize
        )
    }

    pub fn write_bytes(self#, *in_buf: u8, len: usize) -> Result<usize, string> {
        if len == 0 as usize {
            return Result<usize, string>::Ok(0 as usize)
        }

        if len >= 4096 as usize {
            auto flush_res = self#.flush()
            match flush_res {
                auto Result::Ok(_) => {}
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
            return self.writer#.write_bytes(*in_buf, len)
        }

        if self.pos + len > 4096 as usize {
            auto flush_res = self#.flush()
            match flush_res {
                auto Result::Ok(_) => {}
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }

        unsafe {
            auto *dest = &self.buf[self.pos] as *u8
            libc_memcpy(*dest as *void, *in_buf as *void, len)
        }
        self.pos = self.pos + len
        return Result<usize, string>::Ok(len)
    }

    pub fn write_string(self#, s: string) -> Result<usize, string> {
        auto *ptr = s.c_str() as *u8
        return self#.write_bytes(*ptr, s.len() as usize)
    }

    pub fn flush(self#) -> Result<bool, string> {
        if self.pos > 0 as usize {
            auto *ptr = &self.buf[0] as *u8
            auto res = self.writer#.write_bytes(*ptr, self.pos)
            match res {
                auto Result::Ok(n) => {
                    if n < self.pos {
                        return Result<bool, string>::Err(string::from("Short write during flush"))
                    }
                    self.pos = 0 as usize
                }
                auto Result::Err(&e) => {
                    return Result<bool, string>::Err(e.clone())
                }
            }
        }
        return Result<bool, string>::Ok(true)
    }
}

impl<'W: @Writer> BufferedWriter<'W>@Writer {
    pub fn write_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.write_bytes(*buf, len)
    }
}

import std/net::{TcpStream, AsyncReadResult, AsyncIoError}
import std/vec::{Vec}

/// AsyncBufferedReader wraps a TcpStream and buffers its async reads.
pub shape AsyncBufferedReader (
    stream: TcpStream,
    buf: [u8; 4096],
    pos: usize,
    cap: usize
)

impl AsyncBufferedReader@encap {
    pub stream
    fn drop(self#) {}
    pub fn clone(self) = delete
}

impl AsyncBufferedReader {
    pub fn new(stream: cede TcpStream) -> AsyncBufferedReader {
        auto init_buf = [0:u8; 4096]
        return AsyncBufferedReader(
            stream = cede stream,
            buf = init_buf,
            pos = 0 as usize,
            cap = 0 as usize
        )
    }

    // Refill through the owner-carrying stream API. The temporary Vec remains
    // owned by the async frame until the I/O operation has completed, then its
    // initialized bytes are copied into this reader's fixed internal buffer.
    fn refill_async(self#) -> async Result<usize, string> {
        auto owner# = Vec<u8>::with_capacity(4096:usize)
        auto refill = self.stream#.read_into_async(cede owner, 4096:usize, 0:i32).await
        if refill.is_err() {
            auto failure# = refill.unwrap_err()
            auto message = failure.message.clone()
            auto _returned = failure#.take_buffer()
            return Result<usize, string>::Err(message)
        }
        auto received# = refill.unwrap()
        auto count = received.bytes_read
        auto bytes = received#.take_buffer()
        auto index#: usize = 0:usize
        loop index < count {
            self.buf[index] = bytes.get(index)
            index = index + 1:usize
        }
        self.pos = 0:usize
        self.cap = count
        return Result<usize, string>::Ok(count)
    }

    pub fn read_until_async(self#, delimiter: u8, max_bytes: usize) -> async Result<string, string> {
        auto res_str# = string::from("")
        auto done# = false
        auto total_bytes# = 0:usize

        loop !done {
            if self.pos >= self.cap {
                auto fill_res = self#.refill_async().await
                match fill_res {
                    auto Result::Ok(n) => {
                        if n == 0:usize {
                            done = true
                            break
                        }
                        self.pos = 0:usize
                        self.cap = n
                    }
                    auto Result::Err(&e) => {
                        return Result<string, string>::Err(e.clone())
                    }
                }
            }

            auto start_pos = self.pos
            auto found_delim# = false
            auto search_idx# = self.pos

            loop search_idx < self.cap {
                auto b = self.buf[search_idx]
                if b == delimiter {
                    found_delim = true
                    break
                }
                search_idx = search_idx + (1 as usize)
            }

            auto end_pos# = search_idx
            if found_delim {
                end_pos = end_pos + (1 as usize)
                done = true
            }

            auto chunk_len = end_pos - start_pos
            if total_bytes + chunk_len > max_bytes {
                return Result<string, string>::Err(string::from("Header or line size limit exceeded"))
            }

            if chunk_len > 0:usize {
                unsafe {
                    auto *chunk_ptr = &self.buf[start_pos] as *u8
                    res_str#.push_buf(*chunk_ptr, chunk_len)
                }
                self.pos = end_pos
                total_bytes = total_bytes + chunk_len
            }
        }

        return Result<string, string>::Ok(res_str)
    }

    pub fn read_line_async(self#, max_bytes: usize) -> async Result<string, string> {
        return self#.read_until_async(10:u8, max_bytes).await
    }

    // Preferred async read API. The caller keeps ownership of the buffer even
    // when the operation suspends or fails; bytes already buffered locally are
    // copied into that owner before touching the underlying stream.
    pub fn read_into_async(self#, cede owner: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        if max_len == 0:usize {
            owned#.unsafe_set_len(0:usize)
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = 0:usize,
                eof = false
            ))
        }

        if self.pos < self.cap {
            auto available = self.cap - self.pos
            auto to_copy# = max_len
            if to_copy > available {
                to_copy = available
            }
            owned#.unsafe_set_len(0:usize)
            auto index#: usize = 0:usize
            loop index < to_copy {
                owned#.push(self.buf[self.pos + index])
                index = index + 1:usize
            }
            self.pos = self.pos + to_copy
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = to_copy,
                eof = false
            ))
        }

        return self.stream#.read_into_async(cede owned, max_len, timeout_ms).await
    }

}
