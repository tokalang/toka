// stdx/net/stream.tk — unified protocol-facing stream abstraction.
//
// All TLS state and data-pointer derivation live in std/net. New protocol code
// uses the owner-carrying Vec APIs; the pointer methods below are retained only
// as source-compatible adapters for existing low-level callers.
import std/net::{TcpStream, TlsSession, AsyncReadResult, AsyncWriteResult, AsyncIoError}
import std/vec::{Vec}
import core/result::{Result}
import core/types::{Addr}

pub shape AsyncStream (
    raw_tcp: TcpStream,
    is_tls: bool,
    tls#: TlsSession
)

impl AsyncStream@encap {
    pub raw_tcp#
    pub is_tls#

    fn drop(self#) {
        if self.is_tls {
            self.tls#.close()
        }
    }

    pub fn clone(self) = delete
}

// Source-compatible helper for legacy tests and low-level callers. New
// stdx protocol code must use read_into_async/write_from_async instead.
pub fn to_u8_ptr(*raw: [u8]) -> *u8 {
    unsafe {
        return (&raw[0] as Addr) as *u8
    }
}

impl AsyncStream {
    pub fn from_tcp(stream#: TcpStream) -> AsyncStream {
        return AsyncStream(
            raw_tcp = stream#.take(),
            is_tls = false,
            tls = TlsSession::empty()
        )
    }

    pub fn from_tls(stream#: TcpStream, cede session: TlsSession) -> AsyncStream {
        auto owned_session# = cede session
        return AsyncStream(
            raw_tcp = stream#.take(),
            is_tls = true,
            tls = owned_session#.take()
        )
    }

    pub fn take(self#) -> AsyncStream {
        auto stream = AsyncStream(
            raw_tcp = self.raw_tcp#.take(),
            is_tls = self.is_tls,
            tls = self.tls#.take()
        )
        self.is_tls = false
        return stream
    }

    // Legacy pointer adapter. New protocol code must use read_into_async.
    pub fn read_async_timeout(self#, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
        if !self.is_tls {
            return self.raw_tcp#.read_async(*buf, len).await
        }
        return self.tls#.read_async(self.raw_tcp, *buf, len, timeout_ms).await
    }

    pub fn read_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        return self#.read_async_timeout(*buf, len, 10000).await
    }

    // The preferred protocol API. Its buffer owner survives suspension and is
    // returned on success, cancellation, timeout, and I/O error.
    pub fn read_into_async(self#, cede owner: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        if !self.is_tls {
            return self.raw_tcp#.read_into_async(cede owned, max_len, timeout_ms).await
        }
        return self.tls#.read_into_async(self.raw_tcp, cede owned, max_len, timeout_ms).await
    }

    pub fn write_from_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<AsyncWriteResult, AsyncIoError> {
        auto owned# = cede owner
        if !self.is_tls {
            return self.raw_tcp#.write_from_async(cede owned, timeout_ms).await
        }
        return self.tls#.write_from_async(self.raw_tcp, cede owned, timeout_ms).await
    }

    // Legacy pointer adapter. New protocol code must use write_from_async.
    pub fn read_exact_async(self#, *buf: u8, len: usize) -> async Result<(), string> {
        if !self.is_tls {
            auto r = self.raw_tcp#.read_exact_async(*buf, len).await
            match r {
                auto Result::Ok(_) => return Result<(), string>::Ok(())
                auto Result::Err(&e) => return Result<(), string>::Err(e.clone())
            }
        }
        auto total# = 0:usize
        loop total < len {
            auto cur_addr = (*buf as Addr) + (total as u64)
            auto *cur_ptr# = (cur_addr as *[0]u8) as *u8
            auto res = self#.read_async(*cur_ptr, len - total).await
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<(), string>::Err(string::from("Unexpected EOF during TLS read_exact_async"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => return Result<(), string>::Err(e.clone())
            }
        }
        return Result<(), string>::Ok(())
    }

    pub fn write_all_async_timeout(self#, *buf: u8, len: usize, timeout_ms: i32) -> async Result<(), string> {
        if !self.is_tls {
            auto r = self.raw_tcp#.write_all_async(*buf, len).await
            match r {
                auto Result::Ok(_) => return Result<(), string>::Ok(())
                auto Result::Err(&e) => return Result<(), string>::Err(e.clone())
            }
        }
        return self.tls#.write_all_async(self.raw_tcp, *buf, len, timeout_ms).await
    }

    pub fn write_all_async(self#, *buf: u8, len: usize) -> async Result<(), string> {
        return self#.write_all_async_timeout(*buf, len, 10000).await
    }

    pub fn close(self#) {
        if self.is_tls {
            self.tls#.close()
        }
        self.is_tls = false
        self.raw_tcp#.close()
    }
}
