// stdx/net/stream.tk — unified protocol-facing stream abstraction.
//
// All TLS state and data-pointer derivation live in std/net. Protocol code uses
// owner-carrying Vec APIs so buffers remain valid across async suspension.
import std/net::{TcpStream, TlsSession, AsyncReadResult, AsyncWriteResult, AsyncIoError}
import std/vec::{Vec}
import core/result::{Result}

pub shape AsyncStream (
    raw_tcp: TcpStream,
    is_tls: bool,
    tls#: TlsSession
)

impl AsyncStream@Encap {
    pub raw_tcp#
    pub is_tls#

    fn drop(self#) {
        if self.is_tls {
            self.tls#.close()
        }
    }

}

impl AsyncStream {
    pub fn from_tcp(stream#: TcpStream) -> AsyncStream {
        return AsyncStream(
            raw_tcp = stream#.take(),
            is_tls = false,
            tls = TlsSession::empty()
        )
    }

    pub fn from_tls(stream#: TcpStream, cede session: TlsSession) -> AsyncStream {
        auto owned_session# = cede session
        return AsyncStream(
            raw_tcp = stream#.take(),
            is_tls = true,
            tls = owned_session#.take()
        )
    }

    pub fn take(self#) -> AsyncStream {
        auto stream = AsyncStream(
            raw_tcp = self.raw_tcp#.take(),
            is_tls = self.is_tls,
            tls = self.tls#.take()
        )
        self.is_tls = false
        return stream
    }

    // The preferred protocol API. Its buffer owner survives suspension and is
    // returned on success, cancellation, timeout, and I/O error.
    pub fn read_into_async(self#, cede owner: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        if !self.is_tls {
            return self.raw_tcp#.read_into_async(cede owned, max_len, timeout_ms).await
        }
        return self.tls#.read_into_async(self.raw_tcp, cede owned, max_len, timeout_ms).await
    }

    pub fn write_from_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<AsyncWriteResult, AsyncIoError> {
        auto owned# = cede owner
        if !self.is_tls {
            return self.raw_tcp#.write_from_async(cede owned, timeout_ms).await
        }
        return self.tls#.write_from_async(self.raw_tcp, cede owned, timeout_ms).await
    }

    pub fn close(self#) {
        if self.is_tls {
            self.tls#.close()
        }
        self.is_tls = false
        self.raw_tcp#.close()
    }
}
