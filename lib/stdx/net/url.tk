// lib/stdx/net/url.tk

import core/result::{Result}

// Helper to check if a character is unreserved per RFC 3986
fn is_unreserved(b: u8) -> bool {
    // Alphanumeric
    if b >= 'a' as u8 && b <= 'z' as u8 { return true }
    if b >= 'A' as u8 && b <= 'Z' as u8 { return true }
    if b >= '0' as u8 && b <= '9' as u8 { return true }
    // -, _, ., ~
    if b == '-' as u8 || b == '_' as u8 || b == '.' as u8 || b == '~' as u8 { return true }
    return false
}

// Convert half-byte to hex char
fn to_hex_char(b: u8) -> char {
    if b < 10:u8 { return (b + '0' as u8) as char }
    return (b - 10:u8 + 'A' as u8) as char
}

// Convert hex char to half-byte
fn from_hex_char(c: char) -> i32 {
    auto b = c as u8
    if b >= '0' as u8 && b <= '9' as u8 { return (b - '0' as u8) as i32 }
    if b >= 'A' as u8 && b <= 'F' as u8 { return (b - 'A' as u8 + 10:u8) as i32 }
    if b >= 'a' as u8 && b <= 'f' as u8 { return (b - 'a' as u8 + 10:u8) as i32 }
    return -1
}

fn lower_ascii(input: str) -> string {
    auto output# = string::from("")
    auto index# = 0:usize
    loop index < input.len() {
        auto byte# = input.byte_at(index) as u8
        if byte >= 'A' as u8 && byte <= 'Z' as u8 {
            byte = byte + 32:u8
        }
        output#.push_byte_raw(byte)
        index = index + 1:usize
    }
    return output
}

fn is_scheme(input: str) -> bool {
    if input.len() == 0:usize { return false }
    auto first = input.byte_at(0:usize) as u8
    if !((first >= 'a' as u8 && first <= 'z' as u8) || (first >= 'A' as u8 && first <= 'Z' as u8)) {
        return false
    }
    auto index# = 1:usize
    loop index < input.len() {
        auto byte = input.byte_at(index) as u8
        if !((byte >= 'a' as u8 && byte <= 'z' as u8) ||
             (byte >= 'A' as u8 && byte <= 'Z' as u8) ||
             (byte >= '0' as u8 && byte <= '9' as u8) ||
             byte == '+' as u8 || byte == '-' as u8 || byte == '.' as u8) {
            return false
        }
        index = index + 1:usize
    }
    return true
}

fn parse_port(input: str) -> Result<u16, string> {
    if input.len() == 0:usize { return Result<u16, string>::Err(string::from("URL port is empty")) }
    auto value# = 0:i32
    auto index# = 0:usize
    loop index < input.len() {
        auto byte = input.byte_at(index) as u8
        if byte < '0' as u8 || byte > '9' as u8 {
            return Result<u16, string>::Err(string::from("invalid URL port"))
        }
        value = value * 10:i32 + (byte - '0' as u8) as i32
        if value > 65535:i32 {
            return Result<u16, string>::Err(string::from("URL port out of range"))
        }
        index = index + 1:usize
    }
    if value == 0:i32 { return Result<u16, string>::Err(string::from("URL port must be non-zero")) }
    return Result<u16, string>::Ok(value as u16)
}

fn is_valid_host(input: str, allow_colon: bool) -> bool {
    if input.len() == 0:usize { return false }
    auto index# = 0:usize
    loop index < input.len() {
        auto byte = input.byte_at(index) as u8
        if byte <= 32:u8 || byte == 127:u8 || byte == '/' as u8 || byte == '?' as u8 ||
           byte == '#' as u8 || byte == '@' as u8 || byte == '[' as u8 || byte == ']' as u8 ||
           (!allow_colon && byte == ':' as u8) {
            return false
        }
        index = index + 1:usize
    }
    return true
}

pub fn url_encode(input: string) -> string {
    auto res# = string::from("")
    auto i# = 0:usize
    auto len = input.len()
    
    loop i < len {
        auto b_opt = input.as_str().byte_at(i)
        if b_opt < 0 { break }
        auto b = b_opt as u8
        if is_unreserved(b) {
            res#.push_char(b as char)
        } else {
            res#.push_char('%')
            res#.push_char(to_hex_char(b >> 4))
            res#.push_char(to_hex_char(b & 0x0F))
        }
        i = i + 1
    }
    
    return cede res
}

// Helper for decoding
fn decode_internal(input: string, plus_as_space: bool) -> Result<string, string> {
    auto res# = string::from("")
    auto i# = 0:usize
    auto len = input.len()
    
    loop i < len {
        auto c_opt = input.as_str().at(i)
        if c_opt.is_none() { break }
        auto c = c_opt.unwrap()
        if c as char == '%' {
            if i + 2 >= len {
                return Result<string, string>::Err(string::from("invalid percent encoding: truncated"))
            }
            auto c1_opt = input.as_str().at(i + 1)
            auto c2_opt = input.as_str().at(i + 2)
            if c1_opt.is_none() || c2_opt.is_none() {
                return Result<string, string>::Err(string::from("invalid percent encoding: truncated"))
            }
            auto h1 = from_hex_char(c1_opt.unwrap() as char)
            auto h2 = from_hex_char(c2_opt.unwrap() as char)
            if h1 < 0 || h2 < 0 {
                return Result<string, string>::Err(string::from("invalid percent encoding: invalid hex characters"))
            }
            auto b = ((h1 << 4) | h2) as u8
            res#.push_char(b as char)
            i = i + 3
            continue
        } else if plus_as_space && c as char == '+' {
            res#.push_char(' ')
        } else {
            res#.push_char(c as char)
        }
        i = i + 1
    }
    
    return Result<string, string>::Ok(cede res)
}

pub fn url_decode(cede input: string) -> Result<string, string> {
    auto owned_input = cede input
    return decode_internal(cede owned_input, false)
}

pub fn query_decode(cede input: string) -> Result<string, string> {
    auto owned_input = cede input
    return decode_internal(cede owned_input, true)
}

pub shape Url (
    scheme: string,
    host: string,
    port: u16,        // 0 if none
    path: string,
    query: string,
    fragment: string
)

impl Url {
    pub fn new() -> Url {
        return Url(
            scheme = string::from(""),
            host = string::from(""),
            port = 0:u16,
            path = string::from(""),
            query = string::from(""),
            fragment = string::from("")
        )
    }

    pub fn is_tls(self) -> bool {
        auto s = self.scheme.as_str()
        return s.equals("https") || s.equals("HTTPS") || s.equals("wss") || s.equals("WSS")
    }

    pub fn effective_port(self) -> u16 {
        if self.port > 0:u16 {
            return self.port
        }
        if self.is_tls() {
            return 443:u16
        }
        return 80:u16
    }
}

pub fn parse_url(input: string) -> Result<Url, string> {
    auto url# = Url::new()
    auto rest# = input.clone()
    
    // 1. Fragment
    auto frag_idx_opt = rest.as_str().index_of('#')
    if frag_idx_opt.is_some() {
        auto frag_idx = frag_idx_opt.unwrap() as i32
        url.fragment = rest.substring(frag_idx + 1, rest.len() as i32)
        rest = rest.substring(0:i32, frag_idx)
    }
    
    // 2. Query
    auto query_idx_opt = rest.as_str().index_of('?')
    if query_idx_opt.is_some() {
        auto query_idx = query_idx_opt.unwrap() as i32
        url.query = rest.substring(query_idx + 1, rest.len() as i32)
        rest = rest.substring(0:i32, query_idx)
    }
    
    // 3. Scheme and authority.  This deliberately supports hierarchical URLs
    // and relative references, not every RFC 3986 URI scheme.
    auto scheme_idx_opt = rest.as_str().index_of_str(string::from("://").as_str())
    auto has_authority# = false
    if scheme_idx_opt.is_some() {
        auto scheme_idx = scheme_idx_opt.unwrap() as i32
        auto scheme = rest.substring(0:i32, scheme_idx)
        if !is_scheme(scheme.as_str()) {
            return Result<Url, string>::Err(string::from("invalid URL scheme"))
        }
        url.scheme = lower_ascii(scheme.as_str())
        rest = rest.substring(scheme_idx + 3, rest.len() as i32)
        has_authority = true
    } else if rest.len() >= 2:usize && rest.as_str().byte_at(0:usize) as u8 == '/' as u8 && rest.as_str().byte_at(1:usize) as u8 == '/' as u8 {
        rest = rest.substring(2:i32, rest.len() as i32)
        has_authority = true
    }

    // A relative reference never has an authority in this deliberately small API.
    if !has_authority {
        url.path = cede rest
        return Result<Url, string>::Ok(cede url)
    }

    // 4. Authority and path.  Query and fragment were removed before this point,
    // so they cannot be mistaken for authority bytes.
    auto path_idx_opt = rest.as_str().index_of('/')
    auto host_port# = string::from("")
    if path_idx_opt.is_some() {
        auto path_idx = path_idx_opt.unwrap() as i32
        host_port = rest.substring(0:i32, path_idx)
        url.path = rest.substring(path_idx, rest.len() as i32)
    } else {
        host_port = cede rest
    }

    if host_port.len() == 0:usize {
        return Result<Url, string>::Err(string::from("URL authority is empty"))
    }

    // Brackets disambiguate IPv6 literals from the host:port separator.
    if host_port.as_str().byte_at(0:usize) as u8 == '[' as u8 {
        auto close# = 1:usize
        loop close < host_port.len() && host_port.as_str().byte_at(close) as u8 != ']' as u8 {
            close = close + 1:usize
        }
        if close == host_port.len() || close == 1:usize {
            return Result<Url, string>::Err(string::from("invalid bracketed IPv6 host"))
        }
        auto ipv6 = host_port.substring(1:i32, close as i32)
        if !is_valid_host(ipv6.as_str(), true) {
            return Result<Url, string>::Err(string::from("invalid IPv6 host"))
        }
        url.host = lower_ascii(ipv6.as_str())
        if close + 1:usize < host_port.len() {
            if host_port.as_str().byte_at(close + 1:usize) as u8 != ':' as u8 {
                return Result<Url, string>::Err(string::from("invalid URL authority suffix"))
            }
            auto port_text = host_port.substring((close + 2:usize) as i32, host_port.len() as i32)
            auto parsed_port = parse_port(port_text.as_str())
            if parsed_port.is_err() { return Result<Url, string>::Err(parsed_port.unwrap_err()) }
            url.port = parsed_port.unwrap()
        }
    } else {
        auto colon# = 0:usize
        auto colon_count# = 0:usize
        auto index# = 0:usize
        loop index < host_port.len() {
            if host_port.as_str().byte_at(index) as u8 == ':' as u8 {
                colon = index
                colon_count = colon_count + 1:usize
            }
            index = index + 1:usize
        }
        if colon_count > 1:usize {
            return Result<Url, string>::Err(string::from("IPv6 URL hosts must use brackets"))
        }
        if colon_count == 1:usize {
            auto host = host_port.substring(0:i32, colon as i32)
            auto port_text = host_port.substring((colon + 1:usize) as i32, host_port.len() as i32)
            if !is_valid_host(host.as_str(), false) {
                return Result<Url, string>::Err(string::from("invalid URL host"))
            }
            auto parsed_port = parse_port(port_text.as_str())
            if parsed_port.is_err() { return Result<Url, string>::Err(parsed_port.unwrap_err()) }
            url.host = lower_ascii(host.as_str())
            url.port = parsed_port.unwrap()
        } else {
            if !is_valid_host(host_port.as_str(), false) {
                return Result<Url, string>::Err(string::from("invalid URL host"))
            }
            url.host = lower_ascii(host_port.as_str())
        }
    }
    return Result<Url, string>::Ok(cede url)
}
