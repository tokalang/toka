pub shape HttpMethod (
    GET = 0 |
    POST = 1 |
    PUT = 2 |
    DELETE = 3 |
    UNKNOWN = 4
)

pub shape HeaderEntry (
    key: string,
    value#: string
)

impl HeaderEntry@encap {
    pub key
    pub value
    fn drop(self#) {}
    pub fn clone(self) -> HeaderEntry {
        return HeaderEntry(key = self.key.clone(), value = self.value.clone())
    }
}

pub shape HeaderMap (
    entries: Vec<HeaderEntry>
)

impl HeaderMap@encap {
    pub entries
    fn drop(self#) {}
    pub fn clone(self) -> HeaderMap {
        auto new_entries# = Vec<HeaderEntry>::new()
        auto idx# = 0:usize
        loop idx < self.entries.len() {
            auto entry = self.entries.get(idx)
            new_entries#.push(cede entry.clone())
            idx = idx + 1
        }
        return HeaderMap(entries = new_entries)
    }
}

// RFC 7230 Token Validation: DIGIT, ALPHA, or ! # $ % & ' * + - . ^ _ ` | ~
pub fn is_valid_header_name(key: str) -> bool {
    if key.len() == 0 { return false }
    auto idx# = 0:usize
    auto bytes = key.as_bytes()
    loop idx < key.len() {
        auto b = bytes.at(idx).unwrap()
        if b >= 65:byte && b <= 90:byte {
            idx = idx + 1
            continue
        }
        if b >= 97:byte && b <= 122:byte {
            idx = idx + 1
            continue
        }
        if b >= 48:byte && b <= 57:byte {
            idx = idx + 1
            continue
        }
        if b == 33:byte || b == 35:byte || b == 36:byte || b == 37:byte || b == 38:byte {
            idx = idx + 1
            continue
        }
        if b == 39:byte || b == 42:byte || b == 43:byte || b == 45:byte || b == 46:byte {
            idx = idx + 1
            continue
        }
        if b == 94:byte || b == 95:byte || b == 96:byte || b == 124:byte || b == 126:byte {
            idx = idx + 1
            continue
        }
        return false
    }
    return true
}

// RFC 7230 Header Value Validation: HTAB (9), printable ASCII (32..126), or UTF-8 octets (128..255)
pub fn is_valid_header_value(val: str) -> bool {
    auto idx# = 0:usize
    auto bytes = val.as_bytes()
    loop idx < val.len() {
        auto b = bytes.at(idx).unwrap()
        if b == 9:byte {
            idx = idx + 1
            continue
        }
        if b >= 32:byte && b <= 126:byte {
            idx = idx + 1
            continue
        }
        if b >= 128:byte {
            idx = idx + 1
            continue
        }
        return false
    }
    return true
}

// RFC 7230 Section 3.3.2: Content-Length = 1*DIGIT (No '+' or '-' signs allowed)
pub fn parse_content_length(cl_str: str) -> Result<usize, string> {
    if cl_str.len() == 0 {
        return Result<usize, string>::Err(string::from("Empty Content-Length"))
    }
    auto idx# = 0:usize
    auto bytes = cl_str.as_bytes()
    auto acc# = 0:usize
    loop idx < cl_str.len() {
        auto b = bytes.at(idx).unwrap()
        if b < 48:byte || b > 57:byte {
            return Result<usize, string>::Err(string::from("Invalid Content-Length: non-digit character found"))
        }
        auto digit = (b as usize) - 48:usize
        // Overflow check (assume max usize limit)
        if acc > (9223372036854775807:usize - digit) / 10:usize {
            return Result<usize, string>::Err(string::from("Content-Length overflow"))
        }
        acc = acc * 10:usize + digit
        idx = idx + 1
    }
    return Result<usize, string>::Ok(acc)
}

impl HeaderMap {
    pub fn new() -> HeaderMap {
        return HeaderMap(entries = Vec<HeaderEntry>::new())
    }

    pub fn insert(self#, key: string, value: string) -> Result<bool, string> {
        if !is_valid_header_name(key.as_str()) {
            return Result<bool, string>::Err(string::from("Invalid Header Name: forbidden token characters or CR/LF"))
        }
        if !is_valid_header_value(value.as_str()) {
            return Result<bool, string>::Err(string::from("Invalid Header Value: forbidden control characters"))
        }
        auto norm_key = key.to_ascii_lowercase()
        auto idx# = 0:usize
        loop idx < self.entries.len() {
            auto *entry_ptr = self.entries.get_ref(idx)
            if entry_ptr.key.as_str().eq_ignore_ascii_case(key.as_str()) {
                unsafe {
                    entry_ptr.value = value
                }
                return Result<bool, string>::Ok(true)
            }
            idx = idx + 1
        }
        self.entries#.push(cede HeaderEntry(key = norm_key, value = value))
        return Result<bool, string>::Ok(true)
    }

    pub fn get(self#, key: str) -> Option<string> {
        auto idx# = 0:usize
        loop idx < self.entries.len() {
            auto *entry_ptr = self.entries.get_ref(idx)
            if entry_ptr.key.as_str().eq_ignore_ascii_case(key) {
                return Option<string>::Some(entry_ptr.value.clone())
            }
            idx = idx + 1
        }
        return Option<string>::None
    }

    pub fn contains_key(self#, key: str) -> bool {
        return self#.get(key).is_some()
    }
}

pub shape HttpRequest (
    method: HttpMethod,
    path: string,
    version: string,
    headers: HeaderMap,
    body: string
)

impl HttpRequest@encap {
    pub method
    pub path
    pub version
    pub headers
    pub body
    fn drop(self#) {}

    pub fn clone(self) -> HttpRequest {
        return HttpRequest(
            method = self.method,
            path = self.path.clone(),
            version = self.version.clone(),
            headers = self.headers.clone(),
            body = self.body.clone()
        )
    }
}

impl HttpRequest {
    pub fn to_wire_string(self) -> string {
        auto res# = string::from("")
        if self.method == HttpMethod::GET {
            res#.push_str("GET ")
        } else if self.method == HttpMethod::POST {
            res#.push_str("POST ")
        } else if self.method == HttpMethod::PUT {
            res#.push_str("PUT ")
        } else if self.method == HttpMethod::DELETE {
            res#.push_str("DELETE ")
        } else {
            res#.push_str("GET ")
        }
        res#.push_str(self.path.as_str())
        res#.push_str(" ")
        if self.version.len() > 0 {
            res#.push_str(self.version.as_str())
        } else {
            res#.push_str("HTTP/1.1")
        }
        res#.push_str("\r\n")

        auto has_host# = false
        auto has_cl# = false
        auto idx# = 0:usize
        loop idx < self.headers.entries.len() {
            auto *entry_ptr = self.headers.entries.get_ref(idx)
            if entry_ptr.key.as_str().eq_ignore_ascii_case("host") {
                has_host = true
            }
            if entry_ptr.key.as_str().eq_ignore_ascii_case("content-length") {
                has_cl = true
            }
            res#.push_str(entry_ptr.key.as_str())
            res#.push_str(": ")
            res#.push_str(entry_ptr.value.as_str())
            res#.push_str("\r\n")
            idx = idx + 1
        }

        if !has_cl && self.body.len() > 0 {
            res#.push_str("Content-Length: ")
            auto len_str = string::from_int(self.body.len())
            res#.push_str(len_str.as_str())
            res#.push_str("\r\n")
        }

        res#.push_str("\r\n")
        if self.body.len() > 0 {
            res#.push_str(self.body.as_str())
        }
        return res
    }
}

pub shape HttpResponse (
    status_code: i32,
    content_type: string,
    headers: HeaderMap,
    body: string
)

impl HttpResponse@encap {
    pub status_code
    pub content_type
    pub headers
    pub body
    fn drop(self#) {}

    pub fn clone(self) -> HttpResponse {
        return HttpResponse(
            status_code = self.status_code,
            content_type = self.content_type.clone(),
            headers = self.headers.clone(),
            body = self.body.clone()
        )
    }
}

impl HttpResponse {
    pub fn ok(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 200,
            content_type = string::from("text/plain"),
            headers = headers,
            body = body
        )
    }

    pub fn html(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/html"))
        return HttpResponse(
            status_code = 200,
            content_type = string::from("text/html"),
            headers = headers,
            body = body
        )
    }

    pub fn not_found() -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 404,
            content_type = string::from("text/plain"),
            headers = headers,
            body = string::from("404 Not Found")
        )
    }

    pub fn to_string(self) -> string {
        auto res# = string::from("HTTP/1.1 ")
        if self.status_code == 200 {
            res#.push_str("200 OK\r\n")
        } else if self.status_code == 404 {
            res#.push_str("404 Not Found\r\n")
        } else {
            res#.push_str("500 Internal Server Error\r\n")
        }

        auto has_connection# = false

        auto idx# = 0:usize
        loop idx < self.headers.entries.len() {
            auto *entry_ptr = self.headers.entries.get_ref(idx)
            if entry_ptr.key.eq(string::from("connection")) {
                has_connection = true
            }
            if entry_ptr.key.eq(string::from("content-length")) {
                idx = idx + 1
                continue
            }
            res#.push_str(entry_ptr.key.as_str())
            res#.push_str(": ")
            res#.push_str(entry_ptr.value.as_str())
            res#.push_str("\r\n")
            idx = idx + 1
        }

        if !self.headers#.contains_key("Content-Type") {
            res#.push_str("Content-Type: ")
            res#.push_str(self.content_type.as_str())
            res#.push_str("\r\n")
        }

        res#.push_str("Content-Length: ")
        auto len_str = string::from_int(self.body.len())
        res#.push_str(len_str.as_str())
        res#.push_str("\r\n")

        if !has_connection {
            res#.push_str("Connection: close\r\n")
        }
        res#.push_str("\r\n")
        res#.push_str(self.body.as_str())
        return res
    }
}

pub shape HeaderBoundary (
    index: i32,
    delim_len: usize
)

pub fn find_header_boundary(req_str: str) -> HeaderBoundary {
    auto idx# = 0:usize
    if req_str.len() < 2 { return HeaderBoundary(index = -1, delim_len = 0:usize) }
    auto bytes = req_str.as_bytes()
    loop idx + 1 < req_str.len() {
        auto b0 = bytes.at(idx).unwrap()
        auto b1 = bytes.at(idx + 1).unwrap()
        if b0 == 10:byte && b1 == 10:byte {
            return HeaderBoundary(index = idx as i32, delim_len = 2:usize)
        }
        if idx + 3 < req_str.len() {
            auto b2 = bytes.at(idx + 2).unwrap()
            auto b3 = bytes.at(idx + 3).unwrap()
            if b0 == 13:byte && b1 == 10:byte && b2 == 13:byte && b3 == 10:byte {
                return HeaderBoundary(index = idx as i32, delim_len = 4:usize)
            }
        }
        idx = idx + 1
    }
    return HeaderBoundary(index = -1, delim_len = 0:usize)
}

pub fn parse_http_request_with_limit(req_str: string, max_header_size: usize) -> Result<HttpRequest, string> {
    auto boundary = find_header_boundary(req_str.as_str())
    if boundary.index < 0 {
        return Result<HttpRequest, string>::Err(string::from("Malformed HTTP request: missing header boundary"))
    }

    auto h_len = boundary.index as usize
    if h_len > max_header_size {
        return Result<HttpRequest, string>::Err(string::from("Header size limit exceeded"))
    }

    auto header_str = string::from_with_len(req_str.c_str(), h_len)
    auto body_start = h_len + boundary.delim_len
    auto req_len = req_str.len()
    auto body_str# = string::from("")

    auto parse_res = parse_http_request_headers(header_str)
    if parse_res.is_err() {
        return parse_res
    }

    auto req# = parse_res.unwrap()

    if req.headers#.contains_key("transfer-encoding") {
        return Result<HttpRequest, string>::Err(string::from("Unsupported Transfer-Encoding header"))
    }

    auto cl_opt = req.headers#.get("content-length")
    if cl_opt.is_some() {
        auto cl_str = cl_opt.unwrap()
        auto cl_res = parse_content_length(cl_str.as_str())
        if cl_res.is_err() {
            return Result<HttpRequest, string>::Err(cl_res.unwrap_err())
        }
        auto target_cl = cl_res.unwrap()

        if body_start < req_len {
            auto *body_ptr = (req_str.c_str() as usize + body_start) as *char
            auto actual_body_len = req_len - body_start

            if target_cl > actual_body_len {
                return Result<HttpRequest, string>::Err(string::from("Content-Length exceeds payload body length"))
            }
            if target_cl < actual_body_len {
                return Result<HttpRequest, string>::Err(string::from("Trailing bytes after Content-Length payload unsupported in Phase 1"))
            }
            body_str = string::from_with_len(*body_ptr, target_cl)
        } else {
            if target_cl > 0:usize {
                return Result<HttpRequest, string>::Err(string::from("Content-Length exceeds payload body length"))
            }
        }
    } else {
        // Without Content-Length (or Transfer-Encoding), body length is strictly 0.
        // If there are trailing bytes after header boundary without Content-Length, reject in Phase 1.
        if body_start < req_len {
            return Result<HttpRequest, string>::Err(string::from("Trailing bytes without Content-Length unsupported in Phase 1"))
        }
    }

    req.body = body_str
    return Result<HttpRequest, string>::Ok(req)
}

pub fn parse_http_request(req_str: string) -> Result<HttpRequest, string> {
    return parse_http_request_with_limit(req_str, 65536)
}

fn parse_http_request_headers(header_str: string) -> Result<HttpRequest, string> {
    auto headers# = HeaderMap::new()
    auto iter# = header_str.split(10) // split by \n
    if iter#.is_done() {
        return Result<HttpRequest, string>::Err(string::from("Empty request headers"))
    }

    auto first_line# = iter#.next()
    if first_line.ends_with("\r") {
        first_line = string::from_with_len(first_line.c_str(), first_line.len() - 1:usize)
    }

    // Verify request line contains exactly 2 space delimiters (3 tokens)
    auto sp_count# = 0
    auto sp_idx# = 0:usize
    auto bytes = first_line.as_str().as_bytes()
    loop sp_idx < first_line.len() {
        if bytes.at(sp_idx).unwrap() == 32:byte {
            sp_count = sp_count + 1
        }
        sp_idx = sp_idx + 1
    }

    if sp_count != 2 {
        return Result<HttpRequest, string>::Err(string::from("Malformed request line: must contain exactly 3 SP-delimited tokens"))
    }

    auto parts_iter# = first_line.split(32)
    auto method_str = parts_iter#.next()
    auto path_str = parts_iter#.next()
    auto ver_str = parts_iter#.next()

    if method_str.len() == 0 || !is_valid_header_name(method_str.as_str()) {
        return Result<HttpRequest, string>::Err(string::from("Invalid HTTP method token"))
    }

    if path_str.len() == 0 {
        return Result<HttpRequest, string>::Err(string::from("Empty request target"))
    }

    auto target_idx# = 0:usize
    auto target_bytes = path_str.as_str().as_bytes()
    loop target_idx < path_str.len() {
        auto b = target_bytes.at(target_idx).unwrap()
        if b <= 32:byte || b == 127:byte {
            return Result<HttpRequest, string>::Err(string::from("Invalid control or whitespace character in request target"))
        }
        target_idx = target_idx + 1
    }

    if !ver_str.as_str().equals("HTTP/1.1") && !ver_str.as_str().equals("HTTP/1.0") {
        return Result<HttpRequest, string>::Err(string::from("Invalid or missing HTTP version"))
    }

    auto method# = HttpMethod::UNKNOWN
    if method_str.as_str().equals("GET") { method = HttpMethod::GET }
    else if method_str.as_str().equals("POST") { method = HttpMethod::POST }
    else if method_str.as_str().equals("PUT") { method = HttpMethod::PUT }
    else if method_str.as_str().equals("DELETE") { method = HttpMethod::DELETE }

    auto seen_cl# = false
    auto seen_host_count# = 0

    loop !iter#.is_done() {
        auto line# = iter#.next()
        line = line.trim_end()
        if line.len() == 0 { continue }

        auto colon_idx = line.find_char(58:char) // ':'
        if colon_idx <= 0 {
            return Result<HttpRequest, string>::Err(string::from("Malformed header line: missing colon delimiter"))
        }

        // Do NOT trim key! RFC 7230 forbids OWs before colon or in field-name.
        auto key = string::from_with_len(line.c_str(), colon_idx as usize)
        auto val_raw = string::from_with_len((line.c_str() as usize + colon_idx as usize + 1) as *char, (line.len() - colon_idx as usize - 1) as usize)
        auto val = val_raw.trim()

        if key.to_ascii_lowercase().eq(string::from("content-length")) {
            if seen_cl {
                return Result<HttpRequest, string>::Err(string::from("Duplicate Content-Length headers rejected"))
            }
            seen_cl = true
        }

        if key.to_ascii_lowercase().eq(string::from("host")) {
            seen_host_count = seen_host_count + 1
            if seen_host_count > 1 {
                return Result<HttpRequest, string>::Err(string::from("Duplicate Host header rejected"))
            }
        }

        auto ins_res = headers#.insert(key, val)
        if ins_res.is_err() {
            return Result<HttpRequest, string>::Err(ins_res.unwrap_err())
        }
    }

    if ver_str.as_str().equals("HTTP/1.1") && seen_host_count != 1 {
        return Result<HttpRequest, string>::Err(string::from("HTTP/1.1 request requires exactly one Host header"))
    }

    return Result<HttpRequest, string>::Ok(HttpRequest(
        method = method,
        path = path_str.clone(),
        version = ver_str,
        headers = headers,
        body = string::from("")
    ))
}

pub fn parse_hex_digit(b: byte) -> Result<usize, string> {
    if b >= 48:byte && b <= 57:byte {
        return Result<usize, string>::Ok((b as usize) - 48:usize)
    }
    if b >= 65:byte && b <= 70:byte {
        return Result<usize, string>::Ok((b as usize) - 65:usize + 10:usize)
    }
    if b >= 97:byte && b <= 102:byte {
        return Result<usize, string>::Ok((b as usize) - 97:usize + 10:usize)
    }
    return Result<usize, string>::Err(string::from("Invalid hex digit in chunk size"))
}

pub fn parse_chunk_size(chunk_line: str) -> Result<usize, string> {
    if chunk_line.len() == 0 {
        return Result<usize, string>::Err(string::from("Empty chunk size line"))
    }
    auto idx# = 0:usize
    auto bytes = chunk_line.as_bytes()
    auto acc# = 0:usize
    loop idx < chunk_line.len() {
        auto b = bytes.at(idx).unwrap()
        if b == 13:byte || b == 32:byte || b == 59:byte {
            break
        }
        auto d_res = parse_hex_digit(b)
        if d_res.is_err() {
            return d_res
        }
        acc = acc * 16:usize + d_res.unwrap()
        idx = idx + 1
    }
    return Result<usize, string>::Ok(acc)
}

pub fn parse_chunked_body(raw_body_str: str) -> Result<string, string> {
    auto res# = string::from("")
    auto cur_idx# = 0:usize
    auto bytes = raw_body_str.as_bytes()
    auto len = raw_body_str.len()

    loop cur_idx < len {
        auto size_end# = cur_idx
        loop size_end < len {
            if bytes.at(size_end).unwrap() == 10:byte {
                break
            }
            size_end = size_end + 1
        }
        if size_end >= len {
            return Result<string, string>::Err(string::from("Malformed chunked body: incomplete chunk header"))
        }

        auto line_len = size_end - cur_idx
        auto line_str = raw_body_str.substr(cur_idx, line_len).trim_end()

        auto chunk_size_res = parse_chunk_size(line_str)
        if chunk_size_res.is_err() {
            return Result<string, string>::Err(chunk_size_res.unwrap_err())
        }
        auto chunk_size = chunk_size_res.unwrap()

        cur_idx = size_end + 1:usize

        if chunk_size == 0 {
            return Result<string, string>::Ok(res)
        }

        if cur_idx + chunk_size > len {
            return Result<string, string>::Err(string::from("Chunk size exceeds body payload length"))
        }

        auto chunk_sub = raw_body_str.substr(cur_idx, chunk_size)
        res#.push_str(chunk_sub)

        cur_idx = cur_idx + chunk_size

        if cur_idx < len && bytes.at(cur_idx).unwrap() == 13:byte { cur_idx = cur_idx + 1 }
        if cur_idx < len && bytes.at(cur_idx).unwrap() == 10:byte { cur_idx = cur_idx + 1 }
    }

    return Result<string, string>::Ok(res)
}

pub fn parse_http_response_with_limit(resp_str: string, max_header_size: usize) -> Result<HttpResponse, string> {
    auto boundary = find_header_boundary(resp_str.as_str())
    if boundary.index < 0 {
        return Result<HttpResponse, string>::Err(string::from("Malformed HTTP response: missing header boundary"))
    }

    auto h_len = boundary.index as usize
    if h_len > max_header_size {
        return Result<HttpResponse, string>::Err(string::from("Response header size limit exceeded"))
    }

    auto header_str = string::from_with_len(resp_str.c_str(), h_len)
    auto body_start = h_len + boundary.delim_len
    auto resp_len = resp_str.len()

    auto headers# = HeaderMap::new()
    auto iter# = header_str.split(10)
    if iter#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Empty response headers"))
    }

    auto status_line_str = iter#.next().trim_end()
    auto status_parts# = status_line_str.split(32)
    if status_parts#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Empty HTTP status line"))
    }
    auto ver_str = status_parts#.next()
    if status_parts#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Missing HTTP status code"))
    }
    auto code_str = status_parts#.next()

    if !ver_str.as_str().equals("HTTP/1.1") && !ver_str.as_str().equals("HTTP/1.0") {
        return Result<HttpResponse, string>::Err(string::from("Invalid or missing HTTP version in status line"))
    }

    auto code_res = parse_content_length(code_str.trim().as_str())
    if code_res.is_err() {
        println("Debug code_str: '{}'", code_str.as_str())
        return Result<HttpResponse, string>::Err(string::from("Invalid HTTP status code"))
    }
    auto status_code = code_res.unwrap() as i32

    loop !iter#.is_done() {
        auto line# = iter#.next()
        line = line.trim_end()
        if line.len() == 0 { continue }

        auto colon_idx = line.find_char(58:char)
        if colon_idx <= 0 {
            return Result<HttpResponse, string>::Err(string::from("Malformed response header line"))
        }

        auto key = string::from(line.substr(0, colon_idx as usize))
        auto val = string::from(line.substr(colon_idx as usize + 1:usize, line.len() - colon_idx as usize - 1:usize).trim())

        auto _ins = headers#.insert(key, val)
    }

    auto body_str# = string::from("")
    auto raw_body_str# = string::from("")
    if body_start < resp_len {
        raw_body_str = string::from_with_len((resp_str.c_str() as usize + body_start) as *char, resp_len - body_start)
    }

    if headers#.contains_key("transfer-encoding") {
        auto te_val = headers#.get("transfer-encoding").unwrap()
        if te_val.as_str().eq_ignore_ascii_case("chunked") {
            auto chunk_res = parse_chunked_body(raw_body_str.as_str())
            if chunk_res.is_err() {
                return Result<HttpResponse, string>::Err(chunk_res.unwrap_err())
            }
            body_str = chunk_res.unwrap()
        } else {
            return Result<HttpResponse, string>::Err(string::from("Unsupported Transfer-Encoding in response"))
        }
    } else if headers#.contains_key("content-length") {
        auto cl_str = headers#.get("content-length").unwrap()
        auto cl_res = parse_content_length(cl_str.as_str())
        if cl_res.is_err() {
            return Result<HttpResponse, string>::Err(cl_res.unwrap_err())
        }
        auto target_cl = cl_res.unwrap()
        if target_cl > raw_body_str.len() {
            return Result<HttpResponse, string>::Err(string::from("Response body length less than Content-Length"))
        }
        if target_cl == raw_body_str.len() {
            body_str = raw_body_str
        } else {
            auto sub_str = raw_body_str.as_str().substr(0, target_cl)
            body_str = string::from(sub_str)
        }
    } else {
        body_str = raw_body_str
    }

    auto content_type# = string::from("text/plain")
    if headers#.contains_key("content-type") {
        content_type = headers#.get("content-type").unwrap()
    }

    return Result<HttpResponse, string>::Ok(HttpResponse(
        status_code = status_code,
        content_type = content_type,
        headers = headers,
        body = body_str
    ))
}

pub fn parse_http_response(resp_str: string) -> Result<HttpResponse, string> {
    return parse_http_response_with_limit(resp_str, 65536)
}

pub shape HttpClient (
    timeout_ms: i32
)

impl HttpClient {
    pub fn new(timeout_ms: i32) -> HttpClient {
        return HttpClient(timeout_ms = timeout_ms)
    }

    pub fn execute_stream_async(self, req: HttpRequest, addr: SocketAddrV4, is_tls: bool, host: string) -> async Result<HttpResponse, string> {
        auto conn_res# = TcpStream::connect_async_timeout(addr, self.timeout_ms).await
        if conn_res.is_err() {
            return Result<HttpResponse, string>::Err(conn_res.unwrap_err())
        }

        auto tcp_stream# = (cede conn_res).unwrap()
        if is_tls {
            auto tls_res# = TlsStream::connect_async(tcp_stream, host).await
            if tls_res.is_err() {
                return Result<HttpResponse, string>::Err(tls_res.unwrap_err())
            }
            auto stream# = tls_res.unwrap()
            return self.execute_on_stream_async(req, stream).await
        }
        auto stream# = AsyncStream::from_tcp(tcp_stream)
        return self.execute_on_stream_async(req, stream).await
    }

    pub fn execute_on_stream_async(self, req: HttpRequest, stream#: AsyncStream) -> async Result<HttpResponse, string> {
        auto req_wire = req.to_wire_string()
        auto *req_ptr# = req_wire.raw_ptr() as *[u8]
        auto *u8_req# = to_u8_ptr(*req_ptr)
        auto write_res = stream#.write_all_async(*u8_req, req_wire.len()).await
        if write_res.is_err() {
            stream#.close()
            return Result<HttpResponse, string>::Err(string::from("Failed to send HTTP request"))
        }

        auto buf_vec# = Vec<u8>::with_capacity(4096)
        auto i_init#: usize = 0
        loop i_init < 4096 { buf_vec#.push(0:u8); i_init += 1 }
        auto *buf_raw# = buf_vec.unsafe_as_raw()
        auto *u8_buf# = to_u8_ptr(*buf_raw)

        auto raw_resp# = string::from("")
        loop {
            auto read_res = stream#.read_async(*u8_buf, 4096:usize).await
            auto bytes_read# = 0:usize
            auto read_ok# = false
            match read_res {
                auto Result<usize, string>::Ok(n) => {
                    bytes_read = n
                    read_ok = true
                }
                _ => {}
            }
            if !read_ok || bytes_read == 0:usize {
                break
            }
            auto chunk_str = string::from_raw(*u8_buf, bytes_read)
            raw_resp#.push_str(chunk_str.as_str())

            if find_header_boundary(raw_resp.as_str()).index >= 0 {
                auto temp_parse = parse_http_response(raw_resp.clone())
                match temp_parse {
                    auto Result<HttpResponse, string>::Ok(_) => {
                        stream#.close()
                        return temp_parse
                    }
                    _ => {}
                }
            }
        }

        stream#.close()
        if raw_resp.len() == 0 {
            return Result<HttpResponse, string>::Err(string::from("Empty HTTP response received"))
        }

        return parse_http_response(raw_resp)
    }

    pub fn execute_async(self, req: HttpRequest, addr: SocketAddrV4) -> async Result<HttpResponse, string> {
        return self.execute_stream_async(req, addr, false, string::from("")).await
    }

    pub fn execute_url_async(self, req: HttpRequest, url_str: string, addr: SocketAddrV4) -> async Result<HttpResponse, string> {
        auto parsed_url = parse_url(url_str)
        if parsed_url.is_err() {
            return Result<HttpResponse, string>::Err(parsed_url.unwrap_err())
        }
        auto u = parsed_url.unwrap()
        return self.execute_stream_async(req, addr, u.is_tls(), u.host).await
    }
}
