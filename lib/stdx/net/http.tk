pub shape HttpMethod (
    GET = 0 |
    POST = 1 |
    PUT = 2 |
    DELETE = 3 |
    UNKNOWN = 4
)

// HttpHeaderView is a non-owning borrowed offset view into a parent raw_header_buf: Vec<u8>.
// Accessing name() or value() borrows raw_buf# by reference, constructing an owned string return value.
pub shape HttpHeaderView (
    name_offset: usize,
    name_len: usize,
    value_offset: usize,
    value_len: usize
)

impl HttpHeaderView@encap {
    pub name_offset, name_len, value_offset, value_len
    fn drop(self#) {}
    pub fn clone(self) -> HttpHeaderView {
        return HttpHeaderView(
            name_offset = self.name_offset,
            name_len = self.name_len,
            value_offset = self.value_offset,
            value_len = self.value_len
        )
    }
}

impl HttpHeaderView {
    pub fn name(self, raw_buf#: Vec<u8>) -> string {
        if self.name_offset + self.name_len > raw_buf.len() {
            return string::from("")
        }
        auto res# = string::from("")
        auto i# = self.name_offset
        auto end = self.name_offset + self.name_len
        loop i < end {
            res#.push_byte_raw(raw_buf#.get(i))
            i += 1
        }
        return res
    }

    pub fn value(self, raw_buf#: Vec<u8>) -> string {
        if self.value_offset + self.value_len > raw_buf.len() {
            return string::from("")
        }
        auto res# = string::from("")
        auto i# = self.value_offset
        auto end = self.value_offset + self.value_len
        loop i < end {
            res#.push_byte_raw(raw_buf#.get(i))
            i += 1
        }
        return res
    }
}

pub shape HeaderEntry (
    key: string,
    value: string
)

impl HeaderEntry@encap {
    pub key
    pub value
    fn drop(self#) {}
    pub fn clone(self) -> HeaderEntry {
        return HeaderEntry(
            key = string::from(self.key.as_str()),
            value = string::from(self.value.as_str())
        )
    }
}

pub shape HeaderMap (
    entries: Vec<HeaderEntry>
)

impl HeaderMap@encap {
    pub entries
    fn drop(self#) {}
    pub fn clone(self) -> HeaderMap {
        auto new_entries# = Vec<HeaderEntry>::new()
        auto idx# = 0:usize
        loop idx < self.entries.len() {
            auto entry = self.entries.get(idx).clone()
            new_entries#.push(cede entry)
            idx = idx + 1
        }
        return HeaderMap(entries = cede new_entries)
    }
}

// RFC 7230 Token Validation: DIGIT, ALPHA, or ! # $ % & ' * + - . ^ _ ` | ~
pub fn is_valid_header_name(key: str) -> bool {
    if key.len() == 0 { return false }
    auto idx# = 0:usize
    auto bytes = key.as_bytes()
    loop idx < key.len() {
        auto b = bytes.at(idx).unwrap()
        if b >= 65:byte && b <= 90:byte {
            idx = idx + 1
            continue
        }
        if b >= 97:byte && b <= 122:byte {
            idx = idx + 1
            continue
        }
        if b >= 48:byte && b <= 57:byte {
            idx = idx + 1
            continue
        }
        if b == 33:byte || b == 35:byte || b == 36:byte || b == 37:byte || b == 38:byte {
            idx = idx + 1
            continue
        }
        if b == 39:byte || b == 42:byte || b == 43:byte || b == 45:byte || b == 46:byte {
            idx = idx + 1
            continue
        }
        if b == 94:byte || b == 95:byte || b == 96:byte || b == 124:byte || b == 126:byte {
            idx = idx + 1
            continue
        }
        return false
    }
    return true
}

// RFC 7230 Header Value Validation: HTAB (9), printable ASCII (32..126), or UTF-8 octets (128..255)
pub fn is_valid_header_value(val: str) -> bool {
    auto idx# = 0:usize
    auto bytes = val.as_bytes()
    loop idx < val.len() {
        auto b = bytes.at(idx).unwrap()
        if b == 9:byte {
            idx = idx + 1
            continue
        }
        if b >= 32:byte && b <= 126:byte {
            idx = idx + 1
            continue
        }
        if b >= 128:byte {
            idx = idx + 1
            continue
        }
        return false
    }
    return true
}

// RFC 7230 Section 3.3.2: Content-Length = 1*DIGIT (No '+' or '-' signs allowed)
pub fn parse_content_length(cl_str: str) -> Result<usize, string> {
    if cl_str.len() == 0 {
        return Result<usize, string>::Err(string::from("Empty Content-Length"))
    }
    auto idx# = 0:usize
    auto bytes = cl_str.as_bytes()
    auto acc# = 0:usize
    loop idx < cl_str.len() {
        auto b = bytes.at(idx).unwrap()
        if b < 48:byte || b > 57:byte {
            return Result<usize, string>::Err(string::from("Invalid Content-Length: non-digit character found"))
        }
        auto digit = (b as usize) - 48:usize
        // Overflow check (assume max usize limit)
        if acc > (9223372036854775807:usize - digit) / 10:usize {
            return Result<usize, string>::Err(string::from("Content-Length overflow"))
        }
        acc = acc * 10:usize + digit
        idx = idx + 1
    }
    return Result<usize, string>::Ok(acc)
}

impl HeaderMap {
    pub fn new() -> HeaderMap {
        return HeaderMap(entries = Vec<HeaderEntry>::new())
    }

    pub fn insert(self#, key: string, value: string) -> Result<bool, string> {
        if !is_valid_header_name(key.as_str()) {
            return Result<bool, string>::Err(string::from("Invalid Header Name: forbidden token characters or CR/LF"))
        }
        if !is_valid_header_value(value.as_str()) {
            return Result<bool, string>::Err(string::from("Invalid Header Value: forbidden control characters"))
        }
        auto norm_key = key.to_ascii_lowercase()
        auto idx# = 0:usize
        auto found# = false
        auto found_idx#: usize = 0
        loop idx < self.entries.len() {
            auto entry = self.entries#.get(idx).clone()
            if entry.key.as_str().eq_ignore_ascii_case(key.as_str()) {
                found = true
                found_idx = idx
                break
            }
            idx = idx + 1
        }
        if found {
            auto _old = self.entries#.remove(found_idx)
        }
        self.entries#.push(cede HeaderEntry(key = cede norm_key, value = value.clone()))
        return Result<bool, string>::Ok(true)
    }

    pub fn get(self, key: str) -> Option<string> {
        auto idx# = 0:usize
        loop idx < self.entries.len() {
            auto entry = self.entries.get(idx).clone()
            if entry.key.as_str().eq_ignore_ascii_case(key) {
                return Option<string>::Some(string::from(entry.value.as_str()))
            }
            idx = idx + 1
        }
        return Option<string>::None
    }

    pub fn contains_key(self, key: str) -> bool {
        return self.get(key).is_some()
    }
}

pub shape HttpRequest (
    method: HttpMethod,
    path: string,
    version: string,
    headers: HeaderMap,
    body: string
)

impl HttpRequest@encap {
    pub method
    pub path
    pub version
    pub headers
    pub body
    fn drop(self#) {}

    pub fn clone(self#) -> HttpRequest {
        return HttpRequest(
            method = self.method,
            path = self.path.clone(),
            version = self.version.clone(),
            headers = self.headers#.clone(),
            body = self.body.clone()
        )
    }
}

impl HttpRequest {
    pub fn to_wire_string(self) -> string {
        auto res# = string::from("")
        if self.method == HttpMethod::GET {
            res#.push_str("GET ")
        } else if self.method == HttpMethod::POST {
            res#.push_str("POST ")
        } else if self.method == HttpMethod::PUT {
            res#.push_str("PUT ")
        } else if self.method == HttpMethod::DELETE {
            res#.push_str("DELETE ")
        } else {
            res#.push_str("GET ")
        }
        res#.push_str(self.path.as_str())
        res#.push_str(" ")
        if self.version.len() > 0 {
            res#.push_str(self.version.as_str())
        } else {
            res#.push_str("HTTP/1.1")
        }
        res#.push_str("\r\n")

        auto has_host# = false
        auto has_cl# = false
        auto idx# = 0:usize
        loop idx < self.headers.entries.len() {
            auto entry = self.headers.entries.get(idx).clone()
            if entry.key.as_str().eq_ignore_ascii_case("host") {
                has_host = true
            }
            if entry.key.as_str().eq_ignore_ascii_case("content-length") {
                has_cl = true
            }
            res#.push_str(entry.key.as_str())
            res#.push_str(": ")
            res#.push_str(entry.value.as_str())
            res#.push_str("\r\n")
            idx = idx + 1
        }

        if !has_cl && self.body.len() > 0 {
            res#.push_str("Content-Length: ")
            auto len_str = string::from_int(self.body.len())
            res#.push_str(len_str.as_str())
            res#.push_str("\r\n")
        }

        res#.push_str("\r\n")
        if self.body.len() > 0 {
            res#.push_str(self.body.as_str())
        }
        return res
    }

    pub fn to_wire_bytes(self) -> Vec<u8> {
        auto wire_str = self.to_wire_string()
        auto bytes# = Vec<u8>::with_capacity(wire_str.len())
        auto idx# = 0:usize
        loop idx < wire_str.len() {
            bytes#.push(wire_str.as_bytes().at(idx).unwrap() as u8)
            idx += 1
        }
        return bytes
    }
}

pub shape HttpResponse (
    status_code: i32,
    content_type: string,
    headers: HeaderMap,
    body: string
)

impl HttpResponse@encap {
    pub status_code
    pub content_type
    pub headers
    pub body
    fn drop(self#) {}

    pub fn clone(self#) -> HttpResponse {
        return HttpResponse(
            status_code = self.status_code,
            content_type = self.content_type.clone(),
            headers = self.headers#.clone(),
            body = self.body.clone()
        )
    }
}

impl HttpResponse {
    pub fn ok(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 200,
            content_type = string::from("text/plain"),
            headers = cede headers,
            body = body.clone()
        )
    }

    pub fn html(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/html"))
        return HttpResponse(
            status_code = 200,
            content_type = string::from("text/html"),
            headers = cede headers,
            body = body.clone()
        )
    }

    pub fn created(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 201,
            content_type = string::from("text/plain"),
            headers = cede headers,
            body = body.clone()
        )
    }

    pub fn bad_request(body: string) -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 400,
            content_type = string::from("text/plain"),
            headers = cede headers,
            body = body.clone()
        )
    }

    pub fn not_found() -> HttpResponse {
        auto headers# = HeaderMap::new()
        auto _res = headers#.insert(string::from("Content-Type"), string::from("text/plain"))
        return HttpResponse(
            status_code = 404,
            content_type = string::from("text/plain"),
            headers = cede headers,
            body = string::from("404 Not Found")
        )
    }

    pub fn to_string(self) -> string {
        auto res# = string::from("HTTP/1.1 ")
        if self.status_code == 200 {
            res#.push_str("200 OK\r\n")
        } else if self.status_code == 201 {
            res#.push_str("201 Created\r\n")
        } else if self.status_code == 400 {
            res#.push_str("400 Bad Request\r\n")
        } else if self.status_code == 404 {
            res#.push_str("404 Not Found\r\n")
        } else {
            res#.push_str("500 Internal Server Error\r\n")
        }

        auto has_connection# = false

        auto idx# = 0:usize
        loop idx < self.headers.entries.len() {
            auto entry = self.headers.entries.get(idx).clone()
            if entry.key.as_str().eq_ignore_ascii_case("connection") {
                has_connection = true
            }
            if entry.key.as_str().eq_ignore_ascii_case("content-length") {
                idx = idx + 1
                continue
            }
            res#.push_str(entry.key.as_str())
            res#.push_str(": ")
            res#.push_str(entry.value.as_str())
            res#.push_str("\r\n")
            idx = idx + 1
        }

        if !self.headers.contains_key("Content-Type") {
            res#.push_str("Content-Type: ")
            res#.push_str(self.content_type.as_str())
            res#.push_str("\r\n")
        }

        res#.push_str("Content-Length: ")
        auto len_str = string::from_int(self.body.len())
        res#.push_str(len_str.as_str())
        res#.push_str("\r\n")

        if !has_connection {
            res#.push_str("Connection: close\r\n")
        }
        res#.push_str("\r\n")
        res#.push_str(self.body.as_str())
        return res
    }
}

// Server-side lifecycle boundary.  Applications receive a parsed request and
// write a complete response; TCP buffering and partial writes stay here.
pub shape HttpServerConnection (
    stream#: TcpStream,
    max_request_bytes: usize,
    timeout_ms: i32,
    closed#: bool
)

fn bytes_to_string(buf#: Vec<u8>) -> string {
    auto output# = string::from("")
    auto index#: usize = 0:usize
    loop index < buf.len() {
        output#.push_byte_raw(buf#.get(index))
        index = index + 1:usize
    }
    return output
}

impl HttpServerConnection {
    pub fn read_request_async(self#) -> async Result<HttpRequest, string> {
        if self.closed { return Result<HttpRequest, string>::Err(string::from("HTTP connection is closed")) }
        auto received# = Vec<u8>::with_capacity(4096)
        auto read_buffer# = Vec<u8>::with_capacity(4096)
        auto last_error# = string::from("Malformed or incomplete HTTP request")

        loop received.len() < self.max_request_bytes {
            auto read_result = self.stream#.read_into_async(cede read_buffer, 4096:usize, self.timeout_ms).await
            if read_result.is_err() {
                auto failure# = read_result.unwrap_err()
                auto message = failure.message.clone()
                auto _buffer = failure#.take_buffer()
                return Result<HttpRequest, string>::Err(message)
            }
            auto chunk# = read_result.unwrap()
            auto n_read = chunk.bytes_read
            read_buffer = chunk#.take_buffer()
            if n_read == 0:usize {
                return Result<HttpRequest, string>::Err(last_error)
            }
            auto index#: usize = 0:usize
            loop index < n_read {
                received#.push(read_buffer#.get(index))
                index = index + 1:usize
            }
            auto candidate = bytes_to_string(received)
            auto parsed = parse_http_request_with_limit(candidate, self.max_request_bytes)
            if parsed.is_ok() { return Result<HttpRequest, string>::Ok(parsed.unwrap()) }
            last_error = parsed.unwrap_err()
        }
        return Result<HttpRequest, string>::Err(string::from("HTTP request exceeds configured size limit"))
    }

    pub fn write_response_async(self#, response: HttpResponse) -> async Result<(), string> {
        if self.closed { return Result<(), string>::Err(string::from("HTTP connection is closed")) }
        auto wire = response.to_string()
        auto bytes# = Vec<u8>::with_capacity(wire.len())
        auto index#: usize = 0:usize
        loop index < wire.len() {
            bytes#.push(wire.as_str().byte_at(index) as u8)
            index = index + 1:usize
        }
        auto written = self.stream#.write_from_async(cede bytes, self.timeout_ms).await
        if written.is_err() {
            auto failure# = written.unwrap_err()
            auto message = failure.message.clone()
            auto _buffer = failure#.take_buffer()
            return Result<(), string>::Err(message)
        }
        auto completed# = written.unwrap()
        auto complete = completed.complete
        auto _buffer = completed#.take_buffer()
        if !complete { return Result<(), string>::Err(string::from("Incomplete HTTP response write")) }
        return Result<(), string>::Ok(())
    }

    pub fn close(self#) {
        if !self.closed {
            self.stream#.close()
            self.closed = true
        }
    }
}

pub shape HttpServer ()

impl HttpServer {
    pub fn accept_async(listener#: TcpListener, max_request_bytes: usize, timeout_ms: i32) -> async Result<HttpServerConnection, string> {
        auto stream# = listener#.accept_async().await
        if !stream.is_valid() { return Result<HttpServerConnection, string>::Err(string::from("HTTP server accept failed")) }
        return Result<HttpServerConnection, string>::Ok(HttpServerConnection(
            stream = stream#.take(),
            max_request_bytes = max_request_bytes,
            timeout_ms = timeout_ms,
            closed = false
        ))
    }

    // The HTTP layer preserves std/net's cancellation contract: listener
    // ownership remains with the caller and cancellation returns its context
    // error without manufacturing an HttpServerConnection.
    pub fn accept_async_context(listener#: TcpListener, canceler: Canceler, max_request_bytes: usize, timeout_ms: i32) -> async Result<HttpServerConnection, string> {
        auto accepted = listener#.accept_async_context(canceler).await
        if accepted.is_err() {
            return Result<HttpServerConnection, string>::Err(accepted.unwrap_err())
        }
        auto stream# = accepted.unwrap()
        return Result<HttpServerConnection, string>::Ok(HttpServerConnection(
            stream = stream#.take(),
            max_request_bytes = max_request_bytes,
            timeout_ms = timeout_ms,
            closed = false
        ))
    }
}

pub shape HeaderBoundary (
    index: i32,
    delim_len: usize
)

pub fn find_header_boundary(req_str: str) -> HeaderBoundary {
    auto idx# = 0:usize
    if req_str.len() < 2 { return HeaderBoundary(index = -1, delim_len = 0:usize) }
    auto bytes = req_str.as_bytes()
    loop idx + 1 < req_str.len() {
        auto b0 = bytes.at(idx).unwrap()
        auto b1 = bytes.at(idx + 1).unwrap()
        if b0 == 10:byte && b1 == 10:byte {
            return HeaderBoundary(index = idx as i32, delim_len = 2:usize)
        }
        if idx + 3 < req_str.len() {
            auto b2 = bytes.at(idx + 2).unwrap()
            auto b3 = bytes.at(idx + 3).unwrap()
            if b0 == 13:byte && b1 == 10:byte && b2 == 13:byte && b3 == 10:byte {
                return HeaderBoundary(index = idx as i32, delim_len = 4:usize)
            }
        }
        idx = idx + 1
    }
    return HeaderBoundary(index = -1, delim_len = 0:usize)
}

pub fn find_header_boundary_vec(buf#: Vec<u8>) -> HeaderBoundary {
    auto len = buf.len()
    if len < 2 { return HeaderBoundary(index = -1, delim_len = 0:usize) }
    auto idx#: usize = 0
    loop idx + 1 < len {
        auto b0 = buf#.get(idx) as i32
        auto b1 = buf#.get(idx + 1) as i32
        if b0 == 13 {
            if idx + 3 < len {
                auto b2 = buf#.get(idx + 2) as i32
                auto b3 = buf#.get(idx + 3) as i32
                if b0 == 13 && b1 == 10 && b2 == 13 && b3 == 10 {
                    return HeaderBoundary(index = idx as i32, delim_len = 4:usize)
                }
            }
        }
        if b0 == 10 && b1 == 10 {
            return HeaderBoundary(index = idx as i32, delim_len = 2:usize)
        }
        idx += 1
    }
    return HeaderBoundary(index = -1, delim_len = 0:usize)
}

pub fn string_slice(s: string, start: usize, len: usize) -> string {
    auto end# = start + len
    if end > s.len() { end = s.len() }
    auto res# = string::from("")
    auto i#: usize = start
    auto bytes = s.as_str().as_bytes()
    loop i < end {
        res#.push_byte_raw(bytes.at(i).unwrap() as u8)
        i += 1
    }
    return res
}


pub fn parse_http_request_with_limit(req_str: string, max_header_size: usize) -> Result<HttpRequest, string> {
    auto boundary = find_header_boundary(req_str.as_str())
    if boundary.index < 0 {
        return Result<HttpRequest, string>::Err(string::from("Malformed HTTP request: missing header boundary"))
    }

    auto h_len = boundary.index as usize
    if h_len > max_header_size {
        return Result<HttpRequest, string>::Err(string::from("Header size limit exceeded"))
    }

    auto header_str = string_slice(req_str, 0, h_len)
    auto body_start = h_len + boundary.delim_len
    auto req_len = req_str.len()
    auto body_str# = string::from("")

    auto parse_res = parse_http_request_headers(header_str)
    if parse_res.is_err() {
        return parse_res
    }

    auto req# = parse_res.unwrap()

    if req.headers#.contains_key("transfer-encoding") {
        return Result<HttpRequest, string>::Err(string::from("Unsupported Transfer-Encoding header"))
    }

    auto cl_opt = req.headers#.get("content-length")
    if cl_opt.is_some() {
        auto cl_str = cl_opt.unwrap()
        auto cl_res = parse_content_length(cl_str.as_str())
        if cl_res.is_err() {
            return Result<HttpRequest, string>::Err(cl_res.unwrap_err())
        }
        auto target_cl = cl_res.unwrap()

        if body_start < req_len {
            auto actual_body_len = req_len - body_start

            if target_cl > actual_body_len {
                return Result<HttpRequest, string>::Err(string::from("Content-Length exceeds payload body length"))
            }
            if target_cl < actual_body_len {
                return Result<HttpRequest, string>::Err(string::from("Trailing bytes after Content-Length payload unsupported in Phase 1"))
            }
            body_str = string_slice(req_str, body_start, target_cl)
        } else {
            if target_cl > 0:usize {
                return Result<HttpRequest, string>::Err(string::from("Content-Length exceeds payload body length"))
            }
        }
    } else {
        // Without Content-Length (or Transfer-Encoding), body length is strictly 0.
        // If there are trailing bytes after header boundary without Content-Length, reject in Phase 1.
        if body_start < req_len {
            return Result<HttpRequest, string>::Err(string::from("Trailing bytes without Content-Length unsupported in Phase 1"))
        }
    }

    req.body = body_str
    return Result<HttpRequest, string>::Ok(req)
}

pub fn parse_http_request(req_str: string) -> Result<HttpRequest, string> {
    return parse_http_request_with_limit(req_str, 65536)
}

fn parse_http_request_headers(header_str: string) -> Result<HttpRequest, string> {
    auto headers# = HeaderMap::new()
    auto iter# = header_str.split(10) // split by \n
    if iter#.is_done() {
        return Result<HttpRequest, string>::Err(string::from("Empty request headers"))
    }

    auto first_line# = iter#.next()
    if first_line.ends_with("\r") {
        first_line = string_slice(first_line, 0, first_line.len() - 1:usize)
    }

    // Verify request line contains exactly 2 space delimiters (3 tokens)
    auto sp_count# = 0
    auto sp_idx# = 0:usize
    auto bytes = first_line.as_str().as_bytes()
    loop sp_idx < first_line.len() {
        if bytes.at(sp_idx).unwrap() == 32:byte {
            sp_count = sp_count + 1
        }
        sp_idx = sp_idx + 1
    }

    if sp_count != 2 {
        return Result<HttpRequest, string>::Err(string::from("Malformed request line: must contain exactly 3 SP-delimited tokens"))
    }

    auto parts_iter# = first_line.split(32)
    auto method_str = parts_iter#.next()
    auto path_str = parts_iter#.next()
    auto ver_str = parts_iter#.next()

    if method_str.len() == 0 || !is_valid_header_name(method_str.as_str()) {
        return Result<HttpRequest, string>::Err(string::from("Invalid HTTP method token"))
    }

    if path_str.len() == 0 {
        return Result<HttpRequest, string>::Err(string::from("Empty request target"))
    }

    auto target_idx# = 0:usize
    auto target_bytes = path_str.as_str().as_bytes()
    loop target_idx < path_str.len() {
        auto b = target_bytes.at(target_idx).unwrap()
        if b <= 32:byte || b == 127:byte {
            return Result<HttpRequest, string>::Err(string::from("Invalid control or whitespace character in request target"))
        }
        target_idx = target_idx + 1
    }

    if !ver_str.as_str().equals("HTTP/1.1") && !ver_str.as_str().equals("HTTP/1.0") {
        return Result<HttpRequest, string>::Err(string::from("Invalid or missing HTTP version"))
    }

    auto method# = HttpMethod::UNKNOWN
    if method_str.as_str().equals("GET") { method = HttpMethod::GET }
    else if method_str.as_str().equals("POST") { method = HttpMethod::POST }
    else if method_str.as_str().equals("PUT") { method = HttpMethod::PUT }
    else if method_str.as_str().equals("DELETE") { method = HttpMethod::DELETE }

    auto seen_cl# = false
    auto seen_host_count# = 0

    loop !iter#.is_done() {
        auto line# = iter#.next()
        line = line.trim_end()
        if line.len() == 0 { continue }

        auto colon_idx = line.find_char(58:char) // ':'
        if colon_idx <= 0 {
            return Result<HttpRequest, string>::Err(string::from("Malformed header line: missing colon delimiter"))
        }

        // Do NOT trim key! RFC 7230 forbids OWs before colon or in field-name.
        auto key = string_slice(line, 0, colon_idx as usize)
        auto val_raw = string_slice(line, colon_idx as usize + 1:usize, line.len() - colon_idx as usize - 1:usize)
        auto val = val_raw.trim()

        if key.to_ascii_lowercase().eq(string::from("content-length")) {
            if seen_cl {
                return Result<HttpRequest, string>::Err(string::from("Duplicate Content-Length headers rejected"))
            }
            seen_cl = true
        }

        if key.to_ascii_lowercase().eq(string::from("host")) {
            seen_host_count = seen_host_count + 1
            if seen_host_count > 1 {
                return Result<HttpRequest, string>::Err(string::from("Duplicate Host header rejected"))
            }
        }

        auto ins_res = headers#.insert(key, val)
        if ins_res.is_err() {
            return Result<HttpRequest, string>::Err(ins_res.unwrap_err())
        }
    }

    if ver_str.as_str().equals("HTTP/1.1") && seen_host_count != 1 {
        return Result<HttpRequest, string>::Err(string::from("HTTP/1.1 request requires exactly one Host header"))
    }

    return Result<HttpRequest, string>::Ok(HttpRequest(
        method = method,
        path = path_str.clone(),
        version = cede ver_str,
        headers = cede headers,
        body = string::from("")
    ))
}

pub fn parse_hex_digit(b: byte) -> Result<usize, string> {
    if b >= 48:byte && b <= 57:byte {
        return Result<usize, string>::Ok((b as usize) - 48:usize)
    }
    if b >= 65:byte && b <= 70:byte {
        return Result<usize, string>::Ok((b as usize) - 65:usize + 10:usize)
    }
    if b >= 97:byte && b <= 102:byte {
        return Result<usize, string>::Ok((b as usize) - 97:usize + 10:usize)
    }
    return Result<usize, string>::Err(string::from("Invalid hex digit in chunk size"))
}

pub fn parse_chunk_size(chunk_line: str) -> Result<usize, string> {
    if chunk_line.len() == 0 {
        return Result<usize, string>::Err(string::from("Empty chunk size line"))
    }
    auto idx# = 0:usize
    auto bytes = chunk_line.as_bytes()
    auto acc# = 0:usize
    loop idx < chunk_line.len() {
        auto b = bytes.at(idx).unwrap()
        if b == 13:byte || b == 32:byte || b == 59:byte {
            break
        }
        auto d_res = parse_hex_digit(b)
        if d_res.is_err() {
            return d_res
        }
        acc = acc * 16:usize + d_res.unwrap()
        idx = idx + 1
    }
    return Result<usize, string>::Ok(acc)
}

pub fn parse_chunked_body(raw_body_str: str) -> Result<string, string> {
    auto res# = string::from("")
    auto cur_idx# = 0:usize
    auto bytes = raw_body_str.as_bytes()
    auto len = raw_body_str.len()

    loop cur_idx < len {
        auto size_end# = cur_idx
        loop size_end < len {
            if bytes.at(size_end).unwrap() == 10:byte {
                break
            }
            size_end = size_end + 1
        }
        if size_end >= len {
            return Result<string, string>::Err(string::from("Malformed chunked body: incomplete chunk header"))
        }

        auto line_len = size_end - cur_idx
        auto line_str = raw_body_str.substr(cur_idx, line_len).trim_end()

        auto chunk_size_res = parse_chunk_size(line_str)
        if chunk_size_res.is_err() {
            return Result<string, string>::Err(chunk_size_res.unwrap_err())
        }
        auto chunk_size = chunk_size_res.unwrap()

        cur_idx = size_end + 1:usize

        if chunk_size == 0 {
            return Result<string, string>::Ok(res)
        }

        if cur_idx + chunk_size > len {
            return Result<string, string>::Err(string::from("Chunk size exceeds body payload length"))
        }

        auto chunk_sub = raw_body_str.substr(cur_idx, chunk_size)
        res#.push_str(chunk_sub)

        cur_idx = cur_idx + chunk_size

        if cur_idx < len && bytes.at(cur_idx).unwrap() == 13:byte { cur_idx = cur_idx + 1 }
        if cur_idx < len && bytes.at(cur_idx).unwrap() == 10:byte { cur_idx = cur_idx + 1 }
    }

    return Result<string, string>::Ok(res)
}

pub fn parse_http_response_with_limit(resp_str: string, max_header_size: usize) -> Result<HttpResponse, string> {
    auto boundary = find_header_boundary(resp_str.as_str())
    if boundary.index < 0 {
        return Result<HttpResponse, string>::Err(string::from("Malformed HTTP response: missing header boundary"))
    }

    auto h_len = boundary.index as usize
    if h_len > max_header_size {
        return Result<HttpResponse, string>::Err(string::from("Response header size limit exceeded"))
    }

    auto header_str = string_slice(resp_str, 0, h_len)
    auto body_start = h_len + boundary.delim_len
    auto resp_len = resp_str.len()

    auto headers# = HeaderMap::new()
    auto iter# = header_str.split(10)
    if iter#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Empty response headers"))
    }

    auto status_line_str = iter#.next().trim_end()
    auto status_parts# = status_line_str.split(32)
    if status_parts#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Empty HTTP status line"))
    }
    auto ver_str = status_parts#.next()
    if status_parts#.is_done() {
        return Result<HttpResponse, string>::Err(string::from("Missing HTTP status code"))
    }
    auto code_str = status_parts#.next()

    if !ver_str.as_str().equals("HTTP/1.1") && !ver_str.as_str().equals("HTTP/1.0") {
        return Result<HttpResponse, string>::Err(string::from("Invalid or missing HTTP version in status line"))
    }

    auto code_res = parse_content_length(code_str.trim().as_str())
    if code_res.is_err() {
        return Result<HttpResponse, string>::Err(string::from("Invalid HTTP status code"))
    }
    auto status_code = code_res.unwrap() as i32

    loop !iter#.is_done() {
        auto line# = iter#.next()
        line = line.trim_end()
        if line.len() == 0 { continue }

        auto colon_idx = line.find_char(58:char)
        if colon_idx <= 0 {
            return Result<HttpResponse, string>::Err(string::from("Malformed response header line"))
        }

        auto key = string_slice(line, 0, colon_idx as usize)
        auto val = string_slice(line, colon_idx as usize + 1:usize, line.len() - colon_idx as usize - 1:usize).trim()

        auto _ins = headers#.insert(key, val)
    }

    auto body_str# = string::from("")
    auto raw_body_str# = string::from("")
    if body_start < resp_len {
        raw_body_str = string_slice(resp_str, body_start, resp_len - body_start)
    }

    if headers#.contains_key("transfer-encoding") {
        auto te_val = headers#.get("transfer-encoding").unwrap()
        if te_val.as_str().eq_ignore_ascii_case("chunked") {
            auto chunk_res = parse_chunked_body(raw_body_str.as_str())
            if chunk_res.is_err() {
                return Result<HttpResponse, string>::Err(chunk_res.unwrap_err())
            }
            body_str = chunk_res.unwrap()
        } else {
            return Result<HttpResponse, string>::Err(string::from("Unsupported Transfer-Encoding in response"))
        }
    } else if headers#.contains_key("content-length") {
        auto cl_str = headers#.get("content-length").unwrap()
        auto cl_res = parse_content_length(cl_str.as_str())
        if cl_res.is_err() {
            return Result<HttpResponse, string>::Err(cl_res.unwrap_err())
        }
        auto target_cl = cl_res.unwrap()
        if target_cl > raw_body_str.len() {
            return Result<HttpResponse, string>::Err(string::from("Response body length less than Content-Length"))
        }
        if target_cl == raw_body_str.len() {
            body_str = raw_body_str
        } else {
            auto sub_str = raw_body_str.as_str().substr(0, target_cl)
            body_str = string::from(sub_str)
        }
    } else {
        body_str = raw_body_str
    }

    auto content_type# = string::from("text/plain")
    if headers#.contains_key("content-type") {
        content_type = headers#.get("content-type").unwrap()
    }

    return Result<HttpResponse, string>::Ok(HttpResponse(
        status_code = status_code,
        content_type = cede content_type,
        headers = cede headers,
        body = cede body_str
    ))
}

pub fn parse_http_response(resp_str: string) -> Result<HttpResponse, string> {
    return parse_http_response_with_limit(resp_str, 65536)
}

pub shape HttpResponseStream (
    status_code: i32,
    raw_header_buf#: Vec<u8>,
    headers: Vec<HttpHeaderView>,
    stream#: AsyncStream,
    content_length_remaining#: i64,
    chunk_remaining#: usize,
    is_chunked: bool,
    chunk_state#: i32,
    surplus_buf#: Vec<u8>,
    bytes_read_total#: usize,
    max_body_limit: usize,
    err_message#: string
)

impl HttpResponseStream@encap {
    pub status_code, headers, is_chunked
    fn drop(self#) {}
    pub fn clone(self) -> HttpResponseStream {
        return HttpResponseStream(
            status_code = self.status_code,
            raw_header_buf = self.raw_header_buf.clone(),
            headers = self.headers.clone(),
            stream = AsyncStream::from_tcp(TcpStream(fd=-1, closed=true)),
            content_length_remaining = self.content_length_remaining,
            chunk_remaining = self.chunk_remaining,
            is_chunked = self.is_chunked,
            chunk_state = self.chunk_state,
            surplus_buf = self.surplus_buf.clone(),
            bytes_read_total = self.bytes_read_total,
            max_body_limit = self.max_body_limit,
            err_message = self.err_message.clone()
        )
    }
}

impl HttpResponseStream {
    pub fn get_header_count(self) -> usize {
        return self.headers.len()
    }

    pub fn get_header_view(self, idx: usize) -> Option<HttpHeaderView> {
        if idx < self.headers.len() {
            return Option<HttpHeaderView>::Some(self.headers.get(idx).clone())
        }
        return Option<HttpHeaderView>::None
    }

    pub fn header_name(self#, idx: usize) -> Option<string> {
        if idx < self.headers.len() {
            auto view = self.headers#.get(idx).clone()
            return Option<string>::Some(view.name(self.raw_header_buf))
        }
        return Option<string>::None
    }

    pub fn header_value(self#, idx: usize) -> Option<string> {
        if idx < self.headers.len() {
            auto view = self.headers#.get(idx).clone()
            return Option<string>::Some(view.value(self.raw_header_buf))
        }
        return Option<string>::None
    }

    // Owner-carrying convenience API. Callers that need binary-safe or
    // allocation-conscious response handling can consume the stream directly
    // without converting the body through string.
    pub fn read_all_bytes_async(self#, timeout_ms: i32) -> async Result<Bytes, string> {
        auto body# = Vec<u8>::with_capacity(4096)
        auto chunk# = Vec<u8>::with_capacity(4096)
        loop {
            auto read_res = self#.read_chunk_into_async(cede chunk, 4096:usize, timeout_ms).await
            if read_res.is_err() {
                return Result<Bytes, string>::Err(read_res.unwrap_err().message.clone())
            }
            auto rr# = read_res.unwrap()
            auto n_read = rr.bytes_read
            chunk = rr#.take_buffer()
            if n_read == 0:usize {
                break
            }
            auto i#: usize = 0
            loop i < n_read {
                body#.push(chunk#.get(i))
                i += 1
            }
        }
        return Result<Bytes, string>::Ok(Bytes::from_vec(cede body))
    }

    pub fn read_non_chunked_into_async(self#, cede owner#: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        if self.content_length_remaining == 0:i64 {
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = 0:usize,
                eof = true
            ))
        }

        if self.bytes_read_total >= self.max_body_limit {
            return Result<AsyncReadResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = string::from("HTTP body limit exceeded")
            ))
        }

        if self.surplus_buf.len() > 0 {
            auto avail = self.surplus_buf.len()
            auto to_copy# = max_len
            if to_copy > avail { to_copy = avail }
            if self.content_length_remaining > 0:i64 {
                auto cl_usize = self.content_length_remaining as usize
                if to_copy > cl_usize { to_copy = cl_usize }
            }
            if self.bytes_read_total + to_copy > self.max_body_limit {
                to_copy = self.max_body_limit - self.bytes_read_total
            }

            owned#.clear()
            auto i# = 0:usize
            loop i < to_copy {
                owned#.push(self.surplus_buf#.get(i))
                i += 1
            }

            auto new_surplus# = Vec<u8>::with_capacity(avail - to_copy)
            auto j# = to_copy
            loop j < avail {
                new_surplus#.push(self.surplus_buf#.get(j))
                j += 1
            }
            self.surplus_buf = cede new_surplus
            self.bytes_read_total = self.bytes_read_total + to_copy

            if self.content_length_remaining > 0:i64 {
                self.content_length_remaining = self.content_length_remaining - (to_copy as i64)
            }

            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = to_copy,
                eof = false
            ))
        }

        auto read_limit# = max_len
        if self.content_length_remaining > 0:i64 {
            auto cl_usize = self.content_length_remaining as usize
            if read_limit > cl_usize { read_limit = cl_usize }
        }
        if self.bytes_read_total + read_limit > self.max_body_limit {
            read_limit = self.max_body_limit - self.bytes_read_total
        }

        auto read_res = self.stream#.read_into_async(cede owned, read_limit, timeout_ms).await
        if read_res.is_ok() {
            auto res# = read_res.unwrap()
            if res.bytes_read > 0 {
                if self.content_length_remaining > 0:i64 {
                    self.content_length_remaining = self.content_length_remaining - (res.bytes_read as i64)
                }
                self.bytes_read_total = self.bytes_read_total + res.bytes_read
                return Result<AsyncReadResult, AsyncIoError>::Ok(res)
            }
            if self.content_length_remaining > 0:i64 {
                return Result<AsyncReadResult, AsyncIoError>::Err(AsyncIoError(
                    buffer = cede res#.take_buffer(),
                    message = string::from("Unexpected EOF before Content-Length satisfied")
                ))
            }
            return Result<AsyncReadResult, AsyncIoError>::Ok(res)
        } else {
            return Result<AsyncReadResult, AsyncIoError>::Err(read_res.unwrap_err())
        }
    }

    pub fn read_chunk_into_async(self#, cede owner#: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        if max_len == 0 {
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = 0:usize,
                eof = true
            ))
        }

        if !self.is_chunked {
            return self#.read_non_chunked_into_async(cede owned, max_len, timeout_ms).await
        }

        auto copied_bytes#: usize = 0
        auto is_done# = false

        loop !is_done {
            if self.chunk_state == 5 {
                is_done = true
                break
            }
            if self.chunk_state == 4 {
                is_done = true
                break
            }
            if self.chunk_state == 0 {
                auto crlf_pos#: i32 = -1
                auto idx#: usize = 0
                loop idx + 1 < self.surplus_buf.len() {
                    if self.surplus_buf#.get(idx) == 13:u8 && self.surplus_buf#.get(idx + 1) == 10:u8 {
                        crlf_pos = idx as i32
                        break
                    }
                    idx += 1
                }

                if crlf_pos < 0 {
                    if self.surplus_buf.len() > 1024:usize {
                        self.err_message = string::from("Chunk header line exceeds 1024 bytes limit")
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto chunk_in# = Vec<u8>::with_capacity(512)
                    auto net_r = self.stream#.read_into_async(cede chunk_in, 512:usize, timeout_ms).await
                    if net_r.is_err() {
                        self.err_message = net_r.unwrap_err().message.clone()
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto nr# = net_r.unwrap()
                    if nr.bytes_read == 0 {
                        self.err_message = string::from("Unexpected EOF during chunk header read")
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto k#: usize = 0
                    loop k < nr.bytes_read {
                        self.surplus_buf#.push(nr.buffer#.get(k))
                        k += 1
                    }
                    continue
                }

                auto line_len = crlf_pos as usize
                if line_len == 0 {
                    self.err_message = string::from("Empty chunk header size")
                    self.chunk_state = 5
                    is_done = true
                    break
                }

                auto hex_val#: usize = 0
                auto valid_hex# = false
                auto parse_err# = false
                auto h_i#: usize = 0
                loop h_i < line_len {
                    auto b = self.surplus_buf#.get(h_i)
                    if b == 59:u8 { break }
                    if b == 32:u8 || b == 9:u8 {
                        h_i += 1
                        continue
                    }
                    auto digit#: usize = 0
                    if b >= 48:u8 && b <= 57:u8 {
                        digit = (b as usize) - 48:usize
                        valid_hex = true
                    } else if b >= 65:u8 && b <= 70:u8 {
                        digit = (b as usize) - 55:usize
                        valid_hex = true
                    } else if b >= 97:u8 && b <= 102:u8 {
                        digit = (b as usize) - 87:usize
                        valid_hex = true
                    } else {
                        parse_err = true
                        break
                    }
                    hex_val = hex_val * 16:usize + digit
                    h_i += 1
                }

                if parse_err || !valid_hex {
                    self.err_message = string::from("Invalid hex digit in chunk size")
                    self.chunk_state = 5
                    is_done = true
                    break
                }

                auto drain_len = (crlf_pos as usize) + 2:usize
                auto rem_surplus# = Vec<u8>::with_capacity(self.surplus_buf.len() - drain_len)
                auto d_i# = drain_len
                loop d_i < self.surplus_buf.len() {
                    rem_surplus#.push(self.surplus_buf#.get(d_i))
                    d_i += 1
                }
                self.surplus_buf = cede rem_surplus

                if hex_val == 0:usize {
                    self.chunk_state = 3
                } else {
                    self.chunk_remaining = hex_val
                    self.chunk_state = 1
                }
                continue
            }

            if self.chunk_state == 1 {
                if self.surplus_buf.len() == 0 {
                    auto read_size# = 4096:usize
                    if read_size > self.chunk_remaining { read_size = self.chunk_remaining }
                    auto in_buf# = Vec<u8>::with_capacity(read_size)
                    auto net_r = self.stream#.read_into_async(cede in_buf, read_size, timeout_ms).await
                    if net_r.is_err() {
                        self.err_message = net_r.unwrap_err().message.clone()
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto nr# = net_r.unwrap()
                    if nr.bytes_read == 0 {
                        self.err_message = string::from("Unexpected EOF during chunk payload read")
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto k#: usize = 0
                    loop k < nr.bytes_read {
                        self.surplus_buf#.push(nr.buffer#.get(k))
                        k += 1
                    }
                }

                auto avail = self.surplus_buf.len()
                auto to_copy# = max_len
                if to_copy > avail { to_copy = avail }
                if to_copy > self.chunk_remaining { to_copy = self.chunk_remaining }

                if self.bytes_read_total + to_copy > self.max_body_limit {
                    self.err_message = string::from("HTTP body limit exceeded")
                    self.chunk_state = 5
                    is_done = true
                    break
                } else {
                    owned#.clear()
                    auto c_i# = 0:usize
                    loop c_i < to_copy {
                        owned#.push(self.surplus_buf#.get(c_i))
                        c_i += 1
                    }

                    auto next_surplus# = Vec<u8>::with_capacity(avail - to_copy)
                    auto s_i# = to_copy
                    loop s_i < avail {
                        next_surplus#.push(self.surplus_buf#.get(s_i))
                        s_i += 1
                    }
                    self.surplus_buf = cede next_surplus

                    self.chunk_remaining = self.chunk_remaining - to_copy
                    self.bytes_read_total = self.bytes_read_total + to_copy

                    if self.chunk_remaining == 0 {
                        self.chunk_state = 2
                    }
                    copied_bytes = to_copy
                    is_done = true
                    break
                }
            }

            if self.chunk_state == 2 {
                if self.surplus_buf.len() < 2:usize {
                    auto crlf_in# = Vec<u8>::with_capacity(128)
                    auto net_r = self.stream#.read_into_async(cede crlf_in, 128:usize, timeout_ms).await
                    if net_r.is_err() {
                        self.err_message = net_r.unwrap_err().message.clone()
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto nr# = net_r.unwrap()
                    if nr.bytes_read == 0 {
                        self.err_message = string::from("Unexpected EOF waiting for chunk CRLF")
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto k#: usize = 0
                    loop k < nr.bytes_read {
                        self.surplus_buf#.push(nr.buffer#.get(k))
                        k += 1
                    }
                    continue
                }

                if self.surplus_buf#.get(0) != 13:u8 || self.surplus_buf#.get(1) != 10:u8 {
                    self.err_message = string::from("Invalid chunk CRLF delimiter")
                    self.chunk_state = 5
                    is_done = true
                    break
                }

                auto c_surplus# = Vec<u8>::with_capacity(self.surplus_buf.len() - 2:usize)
                auto c_i# = 2:usize
                loop c_i < self.surplus_buf.len() {
                    c_surplus#.push(self.surplus_buf#.get(c_i))
                    c_i += 1
                }
                self.surplus_buf = cede c_surplus
                self.chunk_state = 0
                continue
            }

            if self.chunk_state == 3 {
                auto crlf_pos#: i32 = -1
                auto idx#: usize = 0
                loop idx + 1 < self.surplus_buf.len() {
                    if self.surplus_buf#.get(idx) == 13:u8 && self.surplus_buf#.get(idx + 1) == 10:u8 {
                        crlf_pos = idx as i32
                        break
                    }
                    idx += 1
                }

                if crlf_pos < 0 {
                    auto tr_in# = Vec<u8>::with_capacity(512)
                    auto net_r = self.stream#.read_into_async(cede tr_in, 512:usize, timeout_ms).await
                    if net_r.is_err() {
                        self.err_message = net_r.unwrap_err().message.clone()
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto nr# = net_r.unwrap()
                    if nr.bytes_read == 0 {
                        self.err_message = string::from("Unexpected EOF during chunk trailer read")
                        self.chunk_state = 5
                        is_done = true
                        break
                    }
                    auto k#: usize = 0
                    loop k < nr.bytes_read {
                        self.surplus_buf#.push(nr.buffer#.get(k))
                        k += 1
                    }
                    continue
                }

                auto line_len = crlf_pos as usize
                auto drain_len = line_len + 2:usize
                auto next_surplus# = Vec<u8>::with_capacity(self.surplus_buf.len() - drain_len)
                auto d_i# = drain_len
                loop d_i < self.surplus_buf.len() {
                    next_surplus#.push(self.surplus_buf#.get(d_i))
                    d_i += 1
                }
                self.surplus_buf = cede next_surplus

                if line_len == 0 {
                    self.chunk_state = 4
                    is_done = true
                    break
                }
                continue
            }
        }

        if self.chunk_state == 5 {
            return Result<AsyncReadResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = self.err_message.clone()
            ))
        } else if self.chunk_state == 4 {
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = 0:usize,
                eof = true
            ))
        } else {
            return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
                buffer = cede owned,
                bytes_read = copied_bytes,
                eof = false
            ))
        }
    }

    pub fn close(self#) {
        self.stream#.close()
    }
}

pub shape HttpClient (
    timeout_ms: i32
)

impl HttpClient {
    pub fn new(timeout_ms: i32) -> HttpClient {
        return HttpClient(timeout_ms = timeout_ms)
    }

    pub fn execute_stream_async(self, req: HttpRequest, addr: SocketAddrV4, is_tls: bool, host: string) -> async Result<HttpResponseStream, string> {
        auto conn_res# = TcpStream::connect_async_timeout(addr, self.timeout_ms).await
        if conn_res.is_err() {
            return Result<HttpResponseStream, string>::Err(conn_res.unwrap_err())
        }

        auto tcp_stream# = (cede conn_res).unwrap()
        if is_tls {
            auto tls_res# = TlsStream::connect_with_verify_async_timeout(tcp_stream#.take(), host, true, self.timeout_ms).await
            if tls_res.is_err() {
                return Result<HttpResponseStream, string>::Err(tls_res.unwrap_err())
            }
            auto stream# = tls_res.unwrap()
            return self.execute_on_stream_async(req, cede stream).await
        }
        auto stream# = AsyncStream::from_tcp(tcp_stream#.take())
        return self.execute_on_stream_async(req, cede stream).await
    }

    // URL parsing selects connection address, TLS, and Host; callers retain
    // ownership of the explicit HTTP request target and streamed response.
    pub fn execute_url_stream_async(self, req: HttpRequest, url_str: string,
                                    default_addr: SocketAddrV4) -> async Result<HttpResponseStream, string> {
        auto parsed_url = parse_url(url_str)
        if parsed_url.is_err() {
            return Result<HttpResponseStream, string>::Err(parsed_url.unwrap_err())
        }
        auto url = parsed_url.unwrap()
        auto conn_addr# = default_addr
        if url.port > 0:u16 {
            conn_addr = SocketAddrV4::new(default_addr.ip, url.port)
        }
        return self.execute_stream_async(req, conn_addr, url.is_tls(), url.host).await
    }

    pub fn execute_insecure_stream_async(self, req: HttpRequest, addr: SocketAddrV4, is_tls: bool, host: string) -> async Result<HttpResponseStream, string> {
        auto conn_res# = TcpStream::connect_async_timeout(addr, self.timeout_ms).await
        if conn_res.is_err() {
            return Result<HttpResponseStream, string>::Err(conn_res.unwrap_err())
        }

        auto tcp_stream# = (cede conn_res).unwrap()
        if is_tls {
            auto tls_res# = TlsStream::connect_with_verify_async_timeout(tcp_stream#.take(), host, false, self.timeout_ms).await
            if tls_res.is_err() {
                return Result<HttpResponseStream, string>::Err(tls_res.unwrap_err())
            }
            auto stream# = tls_res.unwrap()
            return self.execute_on_stream_async(req, cede stream).await
        }
        auto stream# = AsyncStream::from_tcp(tcp_stream#.take())
        return self.execute_on_stream_async(req, cede stream).await
    }

    pub fn execute_on_stream_async(self, req: HttpRequest, cede stream#: AsyncStream) -> async Result<HttpResponseStream, string> {
        // Normalize the cede parameter into one local owner before the first
        // suspension.  Error returns then clean up the same initialized slot
        // that success moves into HttpResponseStream.
        auto owned_stream# = cede stream
        auto req_bytes = req.to_wire_bytes()
        auto write_res = owned_stream#.write_from_async(cede req_bytes, self.timeout_ms).await
        if write_res.is_err() {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Failed to send HTTP request"))
        }

        auto raw_header_buf# = Vec<u8>::with_capacity(4096)
        auto read_chunk# = Vec<u8>::with_capacity(4096)

        auto boundary_idx#: i32 = -1
        auto delim_len#: usize = 0

        loop {
            auto read_res = owned_stream#.read_into_async(cede read_chunk, 4096:usize, self.timeout_ms).await
            if read_res.is_err() {
                auto err# = read_res.unwrap_err()
                read_chunk = err#.take_buffer()
                break
            }
            auto res# = read_res.unwrap()
            auto n_read = res.bytes_read
            if n_read == 0 {
                read_chunk = res#.take_buffer()
                break
            }

            auto read_chunk# = res#.take_buffer()
            auto k#: usize = 0
            loop k < n_read {
                raw_header_buf#.push(read_chunk#.get(k))
                k += 1
            }

            auto b = find_header_boundary_vec(raw_header_buf)
            if b.index >= 0 {
                boundary_idx = b.index
                delim_len = b.delim_len
                break
            }
        }

        if boundary_idx < 0 {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Malformed HTTP response: missing header boundary"))
        }

        auto h_len = boundary_idx as usize
        auto header_str# = string::from("")
        auto h_i#: usize = 0
        loop h_i < h_len {
            header_str#.push_char(raw_header_buf#.get(h_i) as char)
            h_i += 1
        }

        auto resp_headers# = HeaderMap::new()
        auto iter# = header_str.split(10)
        if iter#.is_done() {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Empty response headers"))
        }

        auto status_line_str = iter#.next().trim_end()
        auto status_parts# = status_line_str.split(32)
        if status_parts#.is_done() {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Empty HTTP status line"))
        }
        auto ver_str = status_parts#.next()
        if status_parts#.is_done() {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Missing HTTP status code"))
        }
        auto code_str = status_parts#.next()

        if !ver_str.as_str().equals("HTTP/1.1") && !ver_str.as_str().equals("HTTP/1.0") {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Invalid or missing HTTP version in status line"))
        }

        auto code_res = parse_content_length(code_str.trim().as_str())
        if code_res.is_err() {
            owned_stream#.close()
            return Result<HttpResponseStream, string>::Err(string::from("Invalid HTTP status code"))
        }
        auto status_code = code_res.unwrap() as i32

        auto headers_view# = Vec<HttpHeaderView>::new()
        auto line_offset#: usize = status_line_str.len() + 2:usize

        loop !iter#.is_done() {
            auto line# = iter#.next()
            auto orig_l = line.len()
            line = line.trim_end()
            auto cur_len = line.len()
            if cur_len == 0 {
                line_offset += orig_l + 1:usize
                continue
            }

            auto colon_idx = line.find_char(58:char)
            if colon_idx <= 0 {
                owned_stream#.close()
                return Result<HttpResponseStream, string>::Err(string::from("Malformed response header line"))
            }

            auto key = string::from(line.substr(0, colon_idx as usize))
            auto val = string::from(line.substr(colon_idx as usize + 1:usize, cur_len - colon_idx as usize - 1:usize).trim())

            auto name_off = line_offset
            auto name_l = colon_idx as usize
            auto val_off# = line_offset + colon_idx as usize + 1:usize
            loop val_off < line_offset + cur_len {
                auto b = raw_header_buf#.get(val_off)
                if b != 32:u8 && b != 9:u8 { break }
                val_off += 1
            }
            auto val_l = (line_offset + cur_len) - val_off

            headers_view#.push(cede HttpHeaderView(
                name_offset = name_off,
                name_len = name_l,
                value_offset = val_off,
                value_len = val_l
            ))

            auto _ins = resp_headers#.insert(key, val)
            line_offset += orig_l + 1:usize
        }

        auto total_buf_len = raw_header_buf.len()
        auto body_start = h_len + delim_len
        auto surplus_buf# = Vec<u8>::new()
        if total_buf_len > body_start {
            auto s_idx#: usize = body_start
            loop s_idx < total_buf_len {
                auto sb = raw_header_buf#.get(s_idx)
                surplus_buf#.push(sb)
                s_idx += 1
            }
        }

        auto cl_rem#: i64 = -1:i64
        auto cl_opt = resp_headers#.get("content-length")
        if cl_opt.is_some() {
            auto cl_res = parse_content_length(cl_opt.unwrap().as_str())
            if cl_res.is_err() {
                owned_stream#.close()
                return Result<HttpResponseStream, string>::Err(string::from("Invalid Content-Length header value"))
            }
            cl_rem = cl_res.unwrap() as i64
        }

        auto is_chunked# = false
        auto te_opt = resp_headers#.get("transfer-encoding")
        if te_opt.is_some() {
            if te_opt.unwrap().clone().to_ascii_lowercase().eq(string::from("chunked")) {
                is_chunked = true
            }
        }

        return Result<HttpResponseStream, string>::Ok(HttpResponseStream(
            status_code = status_code,
            raw_header_buf = cede raw_header_buf,
            headers = cede headers_view,
            stream = cede owned_stream,
            content_length_remaining = cl_rem,
            chunk_remaining = 0:usize,
            is_chunked = is_chunked,
            chunk_state = 0,
            surplus_buf = cede surplus_buf,
            bytes_read_total = 0:usize,
            max_body_limit = 10485760:usize,
            err_message = string::from("")
        ))
    }

    pub fn execute_async(self, req: HttpRequest, addr: SocketAddrV4) -> async Result<HttpResponse, string> {
        auto s_res# = self.execute_stream_async(req, addr, false, string::from("")).await
        if s_res.is_err() {
            return Result<HttpResponse, string>::Err(s_res.unwrap_err())
        }
        auto stream_obj# = s_res.unwrap()
        auto body_vec# = Vec<u8>::with_capacity(4096)
        auto chunk_buf# = Vec<u8>::with_capacity(4096)

        loop {
            auto read_res = stream_obj#.read_chunk_into_async(cede chunk_buf, 4096:usize, self.timeout_ms).await
            if read_res.is_err() {
                auto err# = read_res.unwrap_err()
                stream_obj#.close()
                return Result<HttpResponse, string>::Err(err.message.clone())
            }
            auto res# = read_res.unwrap()
            auto n_read = res.bytes_read
            chunk_buf = res#.take_buffer()
            if n_read == 0 {
                break
            }
            auto k#: usize = 0
            loop k < n_read {
                body_vec#.push(chunk_buf#.get(k))
                k += 1
            }
        }
        auto status_code = stream_obj.status_code
        stream_obj#.close()

        auto body_str# = string::from("")
        auto b_idx#: usize = 0
        loop b_idx < body_vec.len() {
            auto b_val = body_vec#.get(b_idx)
            body_str#.push_byte_raw(b_val)
            b_idx += 1
        }
        return Result<HttpResponse, string>::Ok(HttpResponse(
            status_code = status_code,
            content_type = string::from("text/plain"),
            headers = HeaderMap::new(),
            body = cede body_str
        ))
    }

    pub fn execute_url_async(self, req: HttpRequest, url_str: string, default_addr: SocketAddrV4) -> async Result<HttpResponse, string> {
        auto parsed_url = parse_url(url_str)
        if parsed_url.is_err() {
            return Result<HttpResponse, string>::Err(parsed_url.unwrap_err())
        }
        auto u = parsed_url.unwrap()
        auto conn_addr# = default_addr
        if u.port > 0:u16 {
            conn_addr = SocketAddrV4::new(default_addr.ip, u.port)
        }
        auto s_res# = self.execute_stream_async(req, conn_addr, u.is_tls(), u.host).await
        if s_res.is_err() {
            return Result<HttpResponse, string>::Err(s_res.unwrap_err())
        }
        auto stream_obj# = s_res.unwrap()
        auto body_vec# = Vec<u8>::with_capacity(4096)
        auto chunk_buf# = Vec<u8>::with_capacity(4096)

        loop {
            auto read_res = stream_obj#.read_chunk_into_async(cede chunk_buf, 4096:usize, self.timeout_ms).await
            if read_res.is_err() {
                auto err# = read_res.unwrap_err()
                stream_obj#.close()
                return Result<HttpResponse, string>::Err(err.message.clone())
            }
            auto res# = read_res.unwrap()
            auto n_read = res.bytes_read
            chunk_buf = res#.take_buffer()
            if n_read == 0 {
                break
            }
            auto k#: usize = 0
            loop k < n_read {
                body_vec#.push(chunk_buf#.get(k))
                k += 1
            }
        }
        auto status_code = stream_obj.status_code
        stream_obj#.close()

        auto body_str# = string::from("")
        auto b_idx#: usize = 0
        loop b_idx < body_vec.len() {
            auto b_val = body_vec#.get(b_idx)
            body_str#.push_byte_raw(b_val)
            b_idx += 1
        }
        return Result<HttpResponse, string>::Ok(HttpResponse(
            status_code = status_code,
            content_type = string::from("text/plain"),
            headers = HeaderMap::new(),
            body = cede body_str
        ))
    }

    pub fn execute_insecure_url_async(self, req: HttpRequest, url_str: string, default_addr: SocketAddrV4) -> async Result<HttpResponse, string> {
        auto parsed_url = parse_url(url_str)
        if parsed_url.is_err() {
            return Result<HttpResponse, string>::Err(parsed_url.unwrap_err())
        }
        auto u = parsed_url.unwrap()
        auto conn_addr# = default_addr
        if u.port > 0:u16 {
            conn_addr = SocketAddrV4::new(default_addr.ip, u.port)
        }
        auto s_res# = self.execute_insecure_stream_async(req, conn_addr, u.is_tls(), u.host).await
        if s_res.is_err() {
            return Result<HttpResponse, string>::Err(s_res.unwrap_err())
        }
        auto stream_obj# = s_res.unwrap()
        auto body_vec# = Vec<u8>::with_capacity(4096)
        auto chunk_buf# = Vec<u8>::with_capacity(4096)

        loop {
            auto read_res = stream_obj#.read_chunk_into_async(cede chunk_buf, 4096:usize, self.timeout_ms).await
            if read_res.is_err() {
                auto err# = read_res.unwrap_err()
                stream_obj#.close()
                return Result<HttpResponse, string>::Err(err.message.clone())
            }
            auto res# = read_res.unwrap()
            auto n_read = res.bytes_read
            chunk_buf = res#.take_buffer()
            if n_read == 0 {
                break
            }
            auto k#: usize = 0
            loop k < n_read {
                body_vec#.push(chunk_buf#.get(k))
                k += 1
            }
        }
        auto status_code = stream_obj.status_code
        stream_obj#.close()

        auto body_str# = string::from("")
        auto b_idx#: usize = 0
        loop b_idx < body_vec.len() {
            auto b_val = body_vec#.get(b_idx)
            body_str#.push_byte_raw(b_val)
            b_idx += 1
        }
        return Result<HttpResponse, string>::Ok(HttpResponse(
            status_code = status_code,
            content_type = string::from("text/plain"),
            headers = HeaderMap::new(),
            body = cede body_str
        ))
    }
}
