// stdx/net/websocket.tk — RFC 6455 Production-Grade WebSocket Implementation
import std/net::{TcpStream, SocketAddrV4}
import stdx/net/stream::{AsyncStream}
import stdx/net/tls::{TlsStream}
import stdx/net/url::{Url, parse_url}
import std/task::{sleep_async}
import stdx/crypto/sha1::{Sha1}
import stdx/encoding/base64
import core/result::{Result}
import core/types::{Addr}
import std/io::{println}
import std/vec::{Vec}

extern fn toka_random_bytes(*buf: void, len: usize) -> i32

pub shape WsOpcode (
    CONTINUATION = 0x0 |
    TEXT = 0x1 |
    BINARY = 0x2 |
    CLOSE = 0x8 |
    PING = 0x9 |
    PONG = 0xA |
    UNKNOWN = 0x99
)

pub shape WsMessage (
    is_text: bool,
    text_data: string,
    binary_data: Vec<u8>
)

pub shape WsConnection (
    stream: AsyncStream,
    is_client: bool,
    max_payload_size: usize,
    surplus_vec: Vec<u8>,
    surplus_offset: usize,
    in_fragment: bool,
    fragment_is_text: bool,
    current_msg_len: usize
)

impl WsConnection@encap {
    pub stream
    pub is_client
    pub max_payload_size
    pub surplus_vec
    pub surplus_offset
    pub in_fragment
    pub fragment_is_text
    pub current_msg_len
    fn drop(self#) {}
    pub fn clone(self) = delete
}

pub fn to_u8_ptr(*raw: [u8]) -> *u8 {
    unsafe {
        return (&raw[0] as Addr) as *u8
    }
}

pub fn to_slice_ptr(*raw: [u8]) -> *[u8] {
    return (*raw as Addr) as *[u8]
}

pub fn to_lower_char(c: char) -> char {
    auto code = c as i32
    if code >= 65 && code <= 90 {
        return (code + 32) as char
    }
    return c
}

pub fn to_lower_string(s: str) -> string {
    auto res# = string::from("")
    auto i#: usize = 0
    auto len = s.len()
    auto *ptr# = s.raw_ptr() as *[char]
    loop i < len {
        unsafe res#.push_char(to_lower_char(ptr[i]))
        i += 1
    }
    return res
}

pub fn has_exact_token(val_str: str, target: str) -> bool {
    auto iter# = val_str.split(",")
    loop true {
        auto opt = iter#.next()
        if opt.is_none() {
            break
        }
        auto token = opt.unwrap().trim()
        auto lower_token = to_lower_string(token)
        if lower_token.as_str().equals(target) {
            return true
        }
    }
    return false
}

pub fn is_valid_base64_key(s: str) -> bool {
    if s.len() != 24 { return false }
    auto *ptr# = s.raw_ptr() as *[char]
    unsafe {
        if ptr[22] != (61 as char) || ptr[23] != (61 as char) {
            return false
        }
        // Base64 padding bits check for 16-byte raw nonce: 22nd char low 4 bits MUST be 0 ('A', 'Q', 'g', 'w')
        auto p21 = ptr[21]
        if p21 != (65 as char) && p21 != (81 as char) && p21 != (103 as char) && p21 != (119 as char) {
            return false
        }
        auto i#: usize = 0
        loop i < 22 {
            auto c = ptr[i] as i32
            auto is_alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
            auto is_num = (c >= 48 && c <= 57)
            auto is_sym = (c == 43 || c == 47)
            if !is_alpha && !is_num && !is_sym {
                return false
            }
            i += 1
        }
    }
    return true
}

pub fn is_valid_utf8(*buf_slice#: [u8], len: usize) -> bool {
    auto i#: usize = 0
    unsafe {
        loop i < len {
            auto b = buf_slice[i] as u32
            if b <= 0x7F:u32 {
                i += 1
            } else {
                if ((b & 0xE0:u32) == 0xC0:u32) {
                    if i + 1 >= len { return false }
                    auto b1 = buf_slice[i + 1] as u32
                    if ((b1 & 0xC0:u32) != 0x80:u32) { return false }
                    if b < 0xC2:u32 { return false }
                    i += 2
                } else {
                    if ((b & 0xF0:u32) == 0xE0:u32) {
                        if i + 2 >= len { return false }
                        auto b1 = buf_slice[i + 1] as u32
                        auto b2 = buf_slice[i + 2] as u32
                        if (((b1 & 0xC0:u32) != 0x80:u32) || ((b2 & 0xC0:u32) != 0x80:u32)) { return false }
                        if b == 0xE0:u32 && b1 < 0xA0:u32 { return false }
                        if b == 0xED:u32 && b1 >= 0xA0:u32 { return false }
                        i += 3
                    } else {
                        if ((b & 0xF8:u32) == 0xF0:u32) {
                            if i + 3 >= len { return false }
                            auto b1 = buf_slice[i + 1] as u32
                            auto b2 = buf_slice[i + 2] as u32
                            auto b3 = buf_slice[i + 3] as u32
                            if (((b1 & 0xC0:u32) != 0x80:u32) || ((b2 & 0xC0:u32) != 0x80:u32) || ((b3 & 0xC0:u32) != 0x80:u32)) { return false }
                            if b == 0xF0:u32 && b1 < 0x90:u32 { return false }
                            if b > 0xF4:u32 || (b == 0xF4:u32 && b1 > 0x8F:u32) { return false }
                            i += 4
                        } else {
                            return false
                        }
                    }
                }
            }
        }
    }
    return true
}

pub fn ws_accept_stream_async(stream#: AsyncStream) -> async Result<WsConnection, string> {
    auto req_str# = string::from("")
    auto headers_done# = false

    auto crlf_crlf# = string::from("")
    crlf_crlf#.push_char(13 as char)
    crlf_crlf#.push_char(10 as char)
    crlf_crlf#.push_char(13 as char)
    crlf_crlf#.push_char(10 as char)

    auto crlf_single# = string::from("")
    crlf_single#.push_char(13 as char)
    crlf_single#.push_char(10 as char)

    auto tries#: usize = 0
    auto buf_vec# = Vec<u8>::with_capacity(1024)
    auto i_init#: usize = 0
    loop i_init < 1024 { buf_vec#.push(0:u8); i_init += 1 }

    auto *buf_raw# = buf_vec.unsafe_as_raw()
    auto *u8_buf# = to_u8_ptr(*buf_raw)

    auto total_read_bytes# = Vec<u8>::new()
    auto header_end_idx#: usize = 0

    loop !headers_done {
        auto read_res = stream#.read_async(*u8_buf, 1024:usize).await
        auto bytes_read# = 0:usize
        match read_res {
            auto Result<usize, string>::Ok(n) => {
                bytes_read = n
            }
            auto Result<usize, string>::Err(&e) => {
                return Result<WsConnection, string>::Err(e.clone())
            }
        }

        if bytes_read == 0 {
            return Result<WsConnection, string>::Err(string::from("Connection closed before headers"))
        }

        auto i#: usize = 0
        loop i < bytes_read {
            unsafe total_read_bytes#.push(buf_raw[i])
            i += 1
        }

        auto temp_chunk = string::from_raw(*u8_buf, bytes_read)
        req_str#.push_str(temp_chunk.as_str())

        auto rv = req_str.as_view()
        auto crlf_opt = rv.index_of_str(crlf_crlf.as_view())
        if crlf_opt.is_some() {
            headers_done = true
            header_end_idx = crlf_opt.unwrap() + 4
        }

        tries += 1
        if tries > 40 {
            return Result<WsConnection, string>::Err(string::from("Header too large or timeout"))
        }
    }

    // Strict Line-by-Line HTTP Request Header Parser (RFC 6455)
    auto end_pos = (header_end_idx - 4) as i32
    auto headers_text = req_str.substring(0, end_pos)
    auto line_iter# = headers_text.as_view().split(crlf_single.as_view())

    auto is_first_line# = true
    auto has_valid_get# = false
    auto count_upgrade#: usize = 0
    auto count_connection#: usize = 0
    auto count_version#: usize = 0
    auto count_key#: usize = 0
    auto sec_key# = string::from("")

    loop true {
        auto opt_line = line_iter#.next()
        if opt_line.is_none() {
            break
        }
        auto line = opt_line.unwrap().trim()
        if line.len() == 0 {
            continue
        }

        if is_first_line {
            is_first_line = false
            if line.starts_with("GET ") && line.ends_with(" HTTP/1.1") {
                has_valid_get = true
            }
        } else {
            auto colon_opt = line.index_of_str(":")
            if colon_opt.is_some() {
                auto colon_pos = colon_opt.unwrap()
                auto key_str = line.substring(0:usize, colon_pos).trim()
                auto val_str = line.substring(colon_pos + 1, line.len()).trim()
                auto key_lower = to_lower_string(key_str)

                if key_lower.as_str().equals("upgrade") {
                    count_upgrade += 1
                    if has_exact_token(val_str, "websocket") {
                        // valid
                    } else {
                        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Upgrade header MUST contain exact token 'websocket'"))
                    }
                } else {
                    if key_lower.as_str().equals("connection") {
                        count_connection += 1
                        if has_exact_token(val_str, "upgrade") {
                            // valid
                        } else {
                            return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Connection header MUST contain exact token 'upgrade'"))
                        }
                    } else {
                        if key_lower.as_str().equals("sec-websocket-version") {
                            count_version += 1
                            if val_str.equals("13") {
                                // valid
                            } else {
                                return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Sec-WebSocket-Version MUST equal '13'"))
                            }
                        } else {
                            if key_lower.as_str().equals("sec-websocket-key") {
                                count_key += 1
                                sec_key = val_str.to_string()
                            }
                        }
                    }
                }
            }
        }
    }

    if !has_valid_get {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Request MUST be GET ... HTTP/1.1"))
    }
    if count_upgrade != 1 || count_connection != 1 || count_version != 1 || count_key != 1 {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Duplicate or missing required HTTP Upgrade headers"))
    }
    if !is_valid_base64_key(sec_key.as_str()) {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Sec-WebSocket-Key MUST be valid 16-byte Base64 key"))
    }

    auto swk# = sec_key.clone()
    swk#.push_str("258EAFA5-E914-47DA-95CA-C5AB0DC85B11")

    auto sha1# = Sha1::new()
    sha1#.update(swk.as_view())
    auto hash_res = sha1#.finalize()
    auto sha1_addr = (&hash_res as Addr)
    auto *sha1_ptr# = sha1_addr as *[u8]
    auto b64_res = base64::encode_bytes(*sha1_ptr, 20:usize)

    // Single complete buffer transmission via write_all_async to eliminate partial write
    auto resp_str# = string::from("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
    resp_str#.push_str(b64_res.as_str())
    resp_str#.push_str("\r\n\r\n")

    auto *resp_ptr# = resp_str.raw_ptr() as *[u8]
    auto *u8_resp# = to_u8_ptr(*resp_ptr)
    auto w_res = stream#.write_all_async(*u8_resp, resp_str.len()).await
    if w_res.is_err() {
        return Result<WsConnection, string>::Err(string::from("Failed sending handshake response"))
    }

    // Extract surplus bytes beyond headers for frame reader
    auto surplus# = Vec<u8>::new()
    auto total_read_len = total_read_bytes.len()
    if total_read_len > header_end_idx {
        auto *tot_raw# = total_read_bytes.unsafe_as_raw()
        auto k# = header_end_idx
        loop k < total_read_len {
            unsafe surplus#.push(tot_raw[k])
            k += 1
        }
    }

    return Result<WsConnection, string>::Ok(WsConnection(
        stream = stream,
        is_client = false,
        max_payload_size = 16777216:usize,
        surplus_vec = surplus,
        surplus_offset = 0:usize,
        in_fragment = false,
        fragment_is_text = false,
        current_msg_len = 0:usize
    ))
}

pub fn ws_accept_async(tcp_stream#: TcpStream) -> async Result<WsConnection, string> {
    return ws_accept_stream_async(AsyncStream::from_tcp(tcp_stream)).await
}

pub fn ws_connect_stream_async(stream#: AsyncStream, host: string, path: string) -> async Result<WsConnection, string> {
    auto crlf_crlf# = string::from("")
    crlf_crlf#.push_char(13 as char)
    crlf_crlf#.push_char(10 as char)
    crlf_crlf#.push_char(13 as char)
    crlf_crlf#.push_char(10 as char)

    auto crlf_single# = string::from("")
    crlf_single#.push_char(13 as char)
    crlf_single#.push_char(10 as char)

    // Generate Sec-WebSocket-Key (16 bytes secure OS random, base64-encoded)
    auto raw_key_vec# = Vec<u8>::with_capacity(16)
    auto i_rk#: usize = 0
    loop i_rk < 16 { raw_key_vec#.push(0:u8); i_rk += 1 }
    auto *raw_key# = raw_key_vec.unsafe_as_raw()
    auto *key_u8# = to_u8_ptr(*raw_key)
    auto rng_ok = unsafe toka_random_bytes(*key_u8, 16:usize)
    if rng_ok != 0 {
        return Result<WsConnection, string>::Err(string::from("OS secure random bytes generation failed"))
    }

    auto sec_key = base64::encode_bytes(*raw_key, 16:usize)

    // Compute expected Sec-WebSocket-Accept
    auto expected_swk# = sec_key.clone()
    expected_swk#.push_str("258EAFA5-E914-47DA-95CA-C5AB0DC85B11")
    auto sha1# = Sha1::new()
    sha1#.update(expected_swk.as_view())
    auto hash_res = sha1#.finalize()
    auto sha1_addr = (&hash_res as Addr)
    auto *sha1_ptr# = sha1_addr as *[u8]
    auto expected_accept = base64::encode_bytes(*sha1_ptr, 20:usize)

    // Send HTTP Upgrade Request via write_all_async
    auto req_buf# = string::from("GET ")
    req_buf#.push_str(path.as_str())
    req_buf#.push_str(" HTTP/1.1\r\nHost: ")
    req_buf#.push_str(host.as_str())
    req_buf#.push_str("\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ")
    req_buf#.push_str(sec_key.as_str())
    req_buf#.push_str("\r\nSec-WebSocket-Version: 13\r\n\r\n")

    auto *req_ptr# = req_buf.raw_ptr() as *[u8]
    auto *u8_req# = to_u8_ptr(*req_ptr)
    auto write_res = stream#.write_all_async(*u8_req, req_buf.len()).await
    if write_res.is_err() {
        return Result<WsConnection, string>::Err(string::from("Failed to send WebSocket handshake request"))
    }

    // Read Handshake Response
    auto resp_str# = string::from("")
    auto headers_done# = false
    auto tries#: usize = 0
    auto buf_vec# = Vec<u8>::with_capacity(1024)
    auto i_cl_init#: usize = 0
    loop i_cl_init < 1024 { buf_vec#.push(0:u8); i_cl_init += 1 }
    auto *buf_raw# = buf_vec.unsafe_as_raw()
    auto *u8_buf# = to_u8_ptr(*buf_raw)

    auto total_read_bytes# = Vec<u8>::new()
    auto header_end_idx#: usize = 0

    loop !headers_done {
        auto read_res = stream#.read_async(*u8_buf, 1024:usize).await
        auto bytes_read# = 0:usize
        match read_res {
            auto Result<usize, string>::Ok(n) => {
                bytes_read = n
            }
            auto Result<usize, string>::Err(&e) => {
                return Result<WsConnection, string>::Err(e.clone())
            }
        }

        if bytes_read == 0 {
            return Result<WsConnection, string>::Err(string::from("Server closed connection during handshake"))
        }

        auto i#: usize = 0
        loop i < bytes_read {
            unsafe total_read_bytes#.push(buf_raw[i])
            i += 1
        }

        auto temp_chunk = string::from_raw(*u8_buf, bytes_read)
        resp_str#.push_str(temp_chunk.as_str())

        auto rv = resp_str.as_view()
        auto crlf_opt = rv.index_of_str(crlf_crlf.as_view())
        if crlf_opt.is_some() {
            headers_done = true
            header_end_idx = crlf_opt.unwrap() + 4
        }

        tries += 1
        if tries > 40 {
            return Result<WsConnection, string>::Err(string::from("Handshake response headers too large or timeout"))
        }
    }

    // Strict Line-by-Line HTTP Response Header Parser (RFC 6455)
    auto resp_end_pos = (header_end_idx - 4) as i32
    auto resp_headers_text = resp_str.substring(0, resp_end_pos)
    auto line_iter# = resp_headers_text.as_view().split(crlf_single.as_view())

    auto is_first_line# = true
    auto has_valid_101# = false
    auto count_upgrade#: usize = 0
    auto count_connection#: usize = 0
    auto count_accept#: usize = 0
    auto server_accept# = string::from("")

    loop true {
        auto opt_line = line_iter#.next()
        if opt_line.is_none() {
            break
        }
        auto line = opt_line.unwrap().trim()
        if line.len() == 0 {
            continue
        }

        if is_first_line {
            is_first_line = false
            // Strict status line matching to require HTTP/1.1 101 Switching Protocols
            auto line_lower = to_lower_string(line)
            if line_lower.as_str().equals("http/1.1 101 switching protocols") {
                has_valid_101 = true
            }
        } else {
            auto colon_opt = line.index_of_str(":")
            if colon_opt.is_some() {
                auto colon_pos = colon_opt.unwrap()
                auto key_str = line.substring(0:usize, colon_pos).trim()
                auto val_str = line.substring(colon_pos + 1, line.len()).trim()
                auto key_lower = to_lower_string(key_str)

                if key_lower.as_str().equals("upgrade") {
                    count_upgrade += 1
                    if has_exact_token(val_str, "websocket") {
                        // valid
                    } else {
                        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Server Upgrade header MUST contain exact token 'websocket'"))
                    }
                } else {
                    if key_lower.as_str().equals("connection") {
                        count_connection += 1
                        if has_exact_token(val_str, "upgrade") {
                            // valid
                        } else {
                            return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Server Connection header MUST contain exact token 'upgrade'"))
                        }
                    } else {
                        if key_lower.as_str().equals("sec-websocket-accept") {
                            count_accept += 1
                            server_accept = val_str.to_string()
                        }
                    }
                }
            }
        }
    }

    if !has_valid_101 {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Response MUST be HTTP/1.1 101 Switching Protocols"))
    }
    if count_upgrade != 1 || count_connection != 1 || count_accept != 1 {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Duplicate or missing required response headers"))
    }
    if !server_accept.as_str().equals(expected_accept.as_str()) {
        return Result<WsConnection, string>::Err(string::from("RFC 6455 Error: Sec-WebSocket-Accept mismatch"))
    }

    // Extract surplus bytes beyond headers for frame reader
    auto surplus# = Vec<u8>::new()
    auto total_read_len = total_read_bytes.len()
    if total_read_len > header_end_idx {
        auto *tot_raw# = total_read_bytes.unsafe_as_raw()
        auto k# = header_end_idx
        loop k < total_read_len {
            unsafe surplus#.push(tot_raw[k])
            k += 1
        }
    }

    return Result<WsConnection, string>::Ok(WsConnection(
        stream = stream,
        is_client = true,
        max_payload_size = 16777216:usize,
        surplus_vec = surplus,
        surplus_offset = 0:usize,
        in_fragment = false,
        fragment_is_text = false,
        current_msg_len = 0:usize
    ))
}

pub fn ws_connect_async(tcp_stream#: TcpStream, host: string, path: string) -> async Result<WsConnection, string> {
    return ws_connect_stream_async(AsyncStream::from_tcp(tcp_stream), host, path).await
}

pub fn ws_connect_tls_async(tcp_stream: TcpStream, host: string, path: string) -> async Result<WsConnection, string> {
    auto tls_res# = TlsStream::connect_async(tcp_stream, host).await
    if tls_res.is_err() {
        return Result<WsConnection, string>::Err(tls_res.unwrap_err())
    }
    auto stream# = tls_res.unwrap()
    return ws_connect_stream_async(stream, host, path).await
}

pub fn ws_connect_url_async(url_str: string, addr: SocketAddrV4) -> async Result<WsConnection, string> {
    auto parsed = parse_url(url_str)
    if parsed.is_err() {
        return Result<WsConnection, string>::Err(parsed.unwrap_err())
    }
    auto u = parsed.unwrap()
    auto tcp_res# = TcpStream::connect_async(addr).await
    if !tcp_res.is_valid() {
        return Result<WsConnection, string>::Err(string::from("TCP connect failed"))
    }
    if u.is_tls() {
        return ws_connect_tls_async(tcp_res, u.host, u.path).await
    }
    return ws_connect_async(tcp_res, u.host, u.path).await
}

impl WsConnection {
    pub fn send_protocol_error_close_async(self#) -> async void {
        auto close_payload# = Vec<u8>::with_capacity(2)
        close_payload#.push(0x03:u8)
        close_payload#.push(0xEA:u8)
        auto _w = self#.write_control_frame_async(0x08:u8, close_payload).await
    }

    pub fn read_exact_bytes_async(self#, *buf_slice#: [u8], len: usize) -> async Result<(), string> {
        auto read_count#: usize = 0
        auto *surplus_raw# = self.surplus_vec.unsafe_as_raw()
        auto surplus_len = self.surplus_vec.len()

        // Drain surplus buffer first
        loop read_count < len && self.surplus_offset < surplus_len {
            unsafe buf_slice[read_count] = surplus_raw[self.surplus_offset]
            self.surplus_offset += 1
            read_count += 1
        }

        // Delegate remaining bytes to stream#.read_exact_async
        if read_count < len {
            auto rem_len = len - read_count
            auto *base_ptr# = to_u8_ptr(*buf_slice)
            auto cur_addr = ((*base_ptr as Addr)) + (read_count as u64)
            auto *cur_ptr# = (cur_addr as *[0]u8) as *u8
            auto r = self.stream#.read_exact_async(*cur_ptr, rem_len).await
            if r.is_err() {
                return Result<(), string>::Err(r.unwrap_err())
            }
        }
        return Result<(), string>::Ok(())
    }

    pub fn read_message_async(self#) -> async Result<WsMessage, string> {
        auto msg_bin# = Vec<u8>::new()
        auto is_text# = false

        loop true {
            // Read 2-byte header via surplus-aware reader
            auto head_vec# = Vec<u8>::with_capacity(2)
            head_vec#.push(0:u8)
            head_vec#.push(0:u8)
            auto *head_raw# = head_vec.unsafe_as_raw()
            auto r_head = self#.read_exact_bytes_async(*head_raw, 2:usize).await
            if r_head.is_err() {
                return Result<WsMessage, string>::Err(r_head.unwrap_err())
            }

            auto b0 = unsafe head_raw[0]
            auto b1 = unsafe head_raw[1]

            auto fin = (b0 & 0x80:u8) != 0:u8
            auto rsv = b0 & 0x70:u8
            if rsv != 0:u8 {
                self#.send_protocol_error_close_async().await
                return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Reserved bits RSV1/2/3 MUST be 0"))
            }

            auto opcode_raw = (b0 & 0x0F:u8) as i32
            auto masked = (b1 & 0x80:u8) != 0:u8

            // Enforcement of masking direction according to RFC 6455
            if self.is_client && masked {
                self#.send_protocol_error_close_async().await
                return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Server-to-Client frame must NOT be masked"))
            }
            if !self.is_client && !masked {
                self#.send_protocol_error_close_async().await
                return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Client-to-Server frame MUST be masked"))
            }

            auto payload_len# = (b1 & 0x7F:u8) as usize

            // Control Frame Validation (Opcode >= 0x8)
            if opcode_raw >= 0x8 {
                if !fin {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Control frame MUST NOT be fragmented (FIN=0)"))
                }
                if payload_len > 125 {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Control frame payload MUST NOT exceed 125 bytes"))
                }
                if opcode_raw != 0x8 && opcode_raw != 0x9 && opcode_raw != 0xA {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Invalid Control Opcode"))
                }
            }

            // Extended Length Reading, Non-minimal length encoding & 64-bit Overflow Validation
            if payload_len == 126 {
                auto ext2_vec# = Vec<u8>::with_capacity(2)
                ext2_vec#.push(0:u8)
                ext2_vec#.push(0:u8)
                auto *ext2_raw# = ext2_vec.unsafe_as_raw()
                auto r_ext2 = self#.read_exact_bytes_async(*ext2_raw, 2:usize).await
                if r_ext2.is_err() {
                    return Result<WsMessage, string>::Err(string::from("Failed reading 16-bit extended length"))
                }
                payload_len = ((unsafe ext2_raw[0] as usize) << 8) | (unsafe ext2_raw[1] as usize)
                if payload_len < 126 {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Non-minimal length encoding for 16-bit payload"))
                }
            } else {
                if payload_len == 127 {
                    auto ext8_vec# = Vec<u8>::with_capacity(8)
                    auto i_8#: usize = 0
                    loop i_8 < 8 { ext8_vec#.push(0:u8); i_8 += 1 }
                    auto *ext8_raw# = ext8_vec.unsafe_as_raw()
                    auto r_ext8 = self#.read_exact_bytes_async(*ext8_raw, 8:usize).await
                    if r_ext8.is_err() {
                        return Result<WsMessage, string>::Err(string::from("Failed reading 64-bit extended length"))
                    }

                    // Validate high 32 bits (overflow check)
                    auto hi = ((unsafe ext8_raw[0] as usize) << 24) | ((unsafe ext8_raw[1] as usize) << 16) | ((unsafe ext8_raw[2] as usize) << 8) | (unsafe ext8_raw[3] as usize)
                    auto lo = ((unsafe ext8_raw[4] as usize) << 24) | ((unsafe ext8_raw[5] as usize) << 16) | ((unsafe ext8_raw[6] as usize) << 8) | (unsafe ext8_raw[7] as usize)

                    if hi != 0 || lo > self.max_payload_size {
                        self#.send_protocol_error_close_async().await
                        return Result<WsMessage, string>::Err(string::from("WebSocket 64-bit payload size exceeds maximum limit"))
                    }
                    if lo <= 65535 {
                        self#.send_protocol_error_close_async().await
                        return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Non-minimal length encoding for 64-bit payload"))
                    }
                    payload_len = lo
                }
            }

            // Enforce accumulated multi-frame payload limit
            if self.current_msg_len + payload_len > self.max_payload_size {
                self#.send_protocol_error_close_async().await
                return Result<WsMessage, string>::Err(string::from("WebSocket total accumulated payload size exceeds maximum limit"))
            }

            auto mask_vec# = Vec<u8>::with_capacity(4)
            if masked {
                auto i_m#: usize = 0
                loop i_m < 4 { mask_vec#.push(0:u8); i_m += 1 }
                auto *m_raw# = mask_vec.unsafe_as_raw()
                auto r_mask = self#.read_exact_bytes_async(*m_raw, 4:usize).await
                if r_mask.is_err() {
                    return Result<WsMessage, string>::Err(string::from("Failed reading mask key"))
                }
            }
            auto *mask_raw# = mask_vec.unsafe_as_raw()

            // Read payload data
            auto payload_vec# = Vec<u8>::with_capacity(payload_len)
            if payload_len > 0 {
                auto i_p#: usize = 0
                loop i_p < payload_len { payload_vec#.push(0:u8); i_p += 1 }
                auto *payload_raw# = payload_vec.unsafe_as_raw()
                auto r_pay = self#.read_exact_bytes_async(*payload_raw, payload_len).await
                if r_pay.is_err() {
                    return Result<WsMessage, string>::Err(string::from("Failed reading WebSocket payload data"))
                }
            }

            // Unmask if masked
            if masked && payload_len > 0 {
                auto *payload_raw# = payload_vec.unsafe_as_raw()
                auto j#: usize = 0
                loop j < payload_len {
                    unsafe payload_raw[j] = (payload_raw[j] as u8) ^ (mask_raw[j % 4] as u8)
                    j += 1
                }
            }

            // Handle Control Frames (Ping 0x9, Pong 0xA, Close 0x8)
            if opcode_raw == 0x9 {
                // Ping: send Pong auto-reply with identical payload, propagating write errors
                auto w_pong = self#.write_control_frame_async(0x0A:u8, payload_vec).await
                if w_pong.is_err() {
                    return Result<WsMessage, string>::Err(w_pong.unwrap_err())
                }
                continue
            } else {
                if opcode_raw == 0xA {
                    // Pong: ignore
                    continue
                } else {
                    if opcode_raw == 0x8 {
                        // Close frame: payload cannot be 1 byte
                        if payload_len == 1 {
                            self#.send_protocol_error_close_async().await
                            return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Close frame payload length cannot be 1"))
                        }
                        // Validate 2-byte code if payload >= 2
                        if payload_len >= 2 {
                            auto *p_close# = payload_vec.unsafe_as_raw()
                            auto code = ((unsafe p_close[0] as i32) << 8) | (unsafe p_close[1] as i32)
                            if (code < 1000 || code > 4999 || code == 1004 || code == 1005 || code == 1006 || code == 1015) {
                                self#.send_protocol_error_close_async().await
                                return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Invalid Close status code"))
                            }
                            // Validate Close reason UTF-8 encoding
                            if payload_len > 2 {
                                auto reason_addr = ((*p_close as Addr)) + 2:u64
                                auto *reason_raw# = (reason_addr as *[0]u8) as *[u8]
                                if !is_valid_utf8(*reason_raw, payload_len - 2) {
                                    self#.send_protocol_error_close_async().await
                                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Close reason payload MUST be valid UTF-8"))
                                }
                            }
                        }
                        // Echo Close frame and close stream
                        auto _w_close = self#.write_control_frame_async(0x08:u8, payload_vec).await
                        self.stream#.close()
                        return Result<WsMessage, string>::Err(string::from("WebSocket closed by peer"))
                    }
                }
            }

            // Fragmentation State Machine Validation
            if opcode_raw == 0x0 {
                // Continuation frame
                if !self.in_fragment {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Unexpected Continuation frame without starting data frame"))
                }
                is_text = self.fragment_is_text
            } else {
                if opcode_raw == 0x1 || opcode_raw == 0x2 {
                    if self.in_fragment {
                        self#.send_protocol_error_close_async().await
                        return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Cannot start new data frame while fragmentation is in progress"))
                    }
                    is_text = (opcode_raw == 0x1)
                    self.fragment_is_text = is_text
                } else {
                    self#.send_protocol_error_close_async().await
                    return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Unknown WebSocket Opcode"))
                }
            }

            self.current_msg_len += payload_len

            if !fin {
                self.in_fragment = true
            } else {
                self.in_fragment = false
                self.current_msg_len = 0:usize
            }

            // Append raw payload bytes across fragments into msg_bin
            if payload_len > 0 {
                auto *p_raw# = payload_vec.unsafe_as_raw()
                auto k#: usize = 0
                loop k < payload_len {
                    unsafe msg_bin#.push(p_raw[k])
                    k += 1
                }
            }

            // When final fragment received (fin == true):
            if fin {
                auto msg_text# = string::from("")
                if is_text {
                    auto total_bin_len = msg_bin.len()
                    if total_bin_len > 0 {
                        auto *bin_raw# = msg_bin.unsafe_as_raw()
                        auto *bin_u8# = to_u8_ptr(*bin_raw)
                        // Validate UTF-8 across the fully concatenated message
                        if !is_valid_utf8(*bin_raw, total_bin_len) {
                            self#.send_protocol_error_close_async().await
                            return Result<WsMessage, string>::Err(string::from("RFC 6455 Protocol Error: Text message payload MUST be valid UTF-8"))
                        }
                        msg_text = string::from_raw(*bin_u8, total_bin_len)
                    }
                }

                return Result<WsMessage, string>::Ok(WsMessage(
                    is_text = is_text,
                    text_data = msg_text,
                    binary_data = msg_bin
                ))
            }
        }
        return Result<WsMessage, string>::Err(string::from("Loop exited unexpectedly"))
    }

    pub fn read_text_async(self#) -> async Result<string, string> {
        auto msg_res = self#.read_message_async().await
        match msg_res {
            auto Result<WsMessage, string>::Ok(&msg) => {
                return Result<string, string>::Ok(msg.text_data.clone())
            }
            auto Result<WsMessage, string>::Err(&e) => {
                return Result<string, string>::Err(e.clone())
            }
        }
    }

    pub fn write_text_async(self#, s: str) -> async Result<usize, string> {
        auto p_len = s.len()
        if p_len > self.max_payload_size {
            return Result<usize, string>::Err(string::from("Outbound text payload size exceeds 16MB maximum limit"))
        }

        auto head_vec# = Vec<u8>::with_capacity(14)
        head_vec#.push(0:u8)
        head_vec#.push(0:u8)
        auto *head# = head_vec.unsafe_as_raw()
        auto *head_u8# = to_u8_ptr(*head)

        unsafe head[0] = 0x81:u8
        auto head_len#: usize = 2

        auto mask_bit#: u8 = 0:u8
        if self.is_client {
            mask_bit = 0x80:u8
        }

        if p_len < 126 {
            unsafe head[1] = (p_len as u8) + mask_bit
        } else {
            if p_len < 65536 {
                unsafe head[1] = 126:u8 + mask_bit
                unsafe head[2] = ((p_len >> 8) & 0xFF) as u8
                unsafe head[3] = (p_len & 0xFF) as u8
                head_len = 4
            } else {
                unsafe head[1] = 127:u8 + mask_bit
                unsafe head[2] = 0:u8
                unsafe head[3] = 0:u8
                unsafe head[4] = 0:u8
                unsafe head[5] = 0:u8
                unsafe head[6] = ((p_len >> 24) & 0xFF) as u8
                unsafe head[7] = ((p_len >> 16) & 0xFF) as u8
                unsafe head[8] = ((p_len >> 8) & 0xFF) as u8
                unsafe head[9] = (p_len & 0xFF) as u8
                head_len = 10
            }
        }

        if self.is_client {
            auto mask_key_vec# = Vec<u8>::with_capacity(4)
            auto i_mk#: usize = 0
            loop i_mk < 4 { mask_key_vec#.push(0:u8); i_mk += 1 }
            auto *mask_key# = mask_key_vec.unsafe_as_raw()
            auto *mask_u8# = to_u8_ptr(*mask_key)
            auto rng_ok = unsafe toka_random_bytes(*mask_u8, 4:usize)
            if rng_ok != 0 {
                return Result<usize, string>::Err(string::from("Failed generating random mask key"))
            }

            auto k#: usize = 0
            loop k < 4 {
                unsafe head[head_len + k] = mask_key[k]
                k += 1
            }
            head_len += 4

            auto w_head = self.stream#.write_all_async(*head_u8, head_len).await
            if w_head.is_err() {
                return Result<usize, string>::Err(w_head.unwrap_err())
            }

            if p_len > 0 {
                auto masked_payload_vec# = Vec<u8>::with_capacity(p_len)
                auto i_mp#: usize = 0
                loop i_mp < p_len { masked_payload_vec#.push(0:u8); i_mp += 1 }
                auto *masked_pay# = masked_payload_vec.unsafe_as_raw()
                auto *masked_u8# = to_u8_ptr(*masked_pay)
                auto *s_ptr# = s.raw_ptr() as *[u8]
                auto i#: usize = 0
                loop i < p_len {
                    unsafe masked_pay[i] = (s_ptr[i] as u8) ^ (mask_key[i % 4] as u8)
                    i += 1
                }
                auto w_pay = self.stream#.write_all_async(*masked_u8, p_len).await
                if w_pay.is_err() {
                    return Result<usize, string>::Err(w_pay.unwrap_err())
                }
            }
        } else {
            auto w_head = self.stream#.write_all_async(*head_u8, head_len).await
            if w_head.is_err() {
                return Result<usize, string>::Err(w_head.unwrap_err())
            }

            if p_len > 0 {
                auto *s_ptr# = s.raw_ptr() as *[u8]
                auto *u8_s# = to_u8_ptr(*s_ptr)
                auto w_pay = self.stream#.write_all_async(*u8_s, p_len).await
                if w_pay.is_err() {
                    return Result<usize, string>::Err(w_pay.unwrap_err())
                }
            }
        }

        return Result<usize, string>::Ok(p_len)
    }

    pub fn write_binary_async(self#, payload: Vec<u8>) -> async Result<usize, string> {
        auto p_len = payload.len()
        if p_len > self.max_payload_size {
            return Result<usize, string>::Err(string::from("Outbound binary payload size exceeds 16MB maximum limit"))
        }

        auto head_vec# = Vec<u8>::with_capacity(14)
        head_vec#.push(0:u8)
        head_vec#.push(0:u8)
        auto *head# = head_vec.unsafe_as_raw()
        auto *head_u8# = to_u8_ptr(*head)

        unsafe head[0] = 0x82:u8
        auto head_len#: usize = 2

        auto mask_bit#: u8 = 0:u8
        if self.is_client {
            mask_bit = 0x80:u8
        }

        if p_len < 126 {
            unsafe head[1] = (p_len as u8) + mask_bit
        } else {
            if p_len < 65536 {
                unsafe head[1] = 126:u8 + mask_bit
                unsafe head[2] = ((p_len >> 8) & 0xFF) as u8
                unsafe head[3] = (p_len & 0xFF) as u8
                head_len = 4
            } else {
                unsafe head[1] = 127:u8 + mask_bit
                unsafe head[2] = 0:u8
                unsafe head[3] = 0:u8
                unsafe head[4] = 0:u8
                unsafe head[5] = 0:u8
                unsafe head[6] = ((p_len >> 24) & 0xFF) as u8
                unsafe head[7] = ((p_len >> 16) & 0xFF) as u8
                unsafe head[8] = ((p_len >> 8) & 0xFF) as u8
                unsafe head[9] = (p_len & 0xFF) as u8
                head_len = 10
            }
        }

        if self.is_client {
            auto mask_key_vec# = Vec<u8>::with_capacity(4)
            auto i_mk#: usize = 0
            loop i_mk < 4 { mask_key_vec#.push(0:u8); i_mk += 1 }
            auto *mask_key# = mask_key_vec.unsafe_as_raw()
            auto *mask_u8# = to_u8_ptr(*mask_key)
            auto rng_ok = unsafe toka_random_bytes(*mask_u8, 4:usize)
            if rng_ok != 0 {
                return Result<usize, string>::Err(string::from("Failed generating random mask key"))
            }

            auto k#: usize = 0
            loop k < 4 {
                unsafe head[head_len + k] = mask_key[k]
                k += 1
            }
            head_len += 4

            auto w_head = self.stream#.write_all_async(*head_u8, head_len).await
            if w_head.is_err() {
                return Result<usize, string>::Err(w_head.unwrap_err())
            }

            if p_len > 0 {
                auto *pay_raw# = payload.unsafe_as_raw()
                auto masked_payload_vec# = Vec<u8>::with_capacity(p_len)
                auto i_mp#: usize = 0
                loop i_mp < p_len { masked_payload_vec#.push(0:u8); i_mp += 1 }
                auto *masked_pay# = masked_payload_vec.unsafe_as_raw()
                auto *masked_u8# = to_u8_ptr(*masked_pay)
                auto i#: usize = 0
                loop i < p_len {
                    unsafe masked_pay[i] = (pay_raw[i] as u8) ^ (mask_key[i % 4] as u8)
                    i += 1
                }
                auto w_pay = self.stream#.write_all_async(*masked_u8, p_len).await
                if w_pay.is_err() {
                    return Result<usize, string>::Err(w_pay.unwrap_err())
                }
            }
        } else {
            auto w_head = self.stream#.write_all_async(*head_u8, head_len).await
            if w_head.is_err() {
                return Result<usize, string>::Err(w_head.unwrap_err())
            }

            if p_len > 0 {
                auto *pay_raw# = payload.unsafe_as_raw()
                auto *pay_u8# = to_u8_ptr(*pay_raw)
                auto w_pay = self.stream#.write_all_async(*pay_u8, p_len).await
                if w_pay.is_err() {
                    return Result<usize, string>::Err(w_pay.unwrap_err())
                }
            }
        }

        return Result<usize, string>::Ok(p_len)
    }

    pub fn write_control_frame_async(self#, opcode: u8, payload: Vec<u8>) -> async Result<usize, string> {
        if opcode != 0x8:u8 && opcode != 0x9:u8 && opcode != 0xA:u8 {
            return Result<usize, string>::Err(string::from("RFC 6455 Error: Invalid outbound control opcode"))
        }

        auto p_len = payload.len()
        if p_len > 125 {
            return Result<usize, string>::Err(string::from("RFC 6455 Error: Control frame payload MUST NOT exceed 125 bytes"))
        }

        auto head_vec# = Vec<u8>::with_capacity(6)
        head_vec#.push(0:u8)
        head_vec#.push(0:u8)
        auto *head# = head_vec.unsafe_as_raw()
        auto *head_u8# = to_u8_ptr(*head)

        unsafe head[0] = 0x80:u8 + opcode

        auto mask_bit#: u8 = 0:u8
        if self.is_client {
            mask_bit = 0x80:u8
        }
        unsafe head[1] = (p_len as u8) + mask_bit
        auto head_len#: usize = 2

        if self.is_client {
            auto mask_key_vec# = Vec<u8>::with_capacity(4)
            auto i_mk#: usize = 0
            loop i_mk < 4 { mask_key_vec#.push(0:u8); i_mk += 1 }
            auto *mask_key# = mask_key_vec.unsafe_as_raw()
            auto *mask_u8# = to_u8_ptr(*mask_key)
            auto rng_ok = unsafe toka_random_bytes(*mask_u8, 4:usize)
            if rng_ok != 0 {
                return Result<usize, string>::Err(string::from("Failed generating random mask key for control frame"))
            }

            auto k#: usize = 0
            loop k < 4 {
                unsafe head[head_len + k] = mask_key[k]
                k += 1
            }
            head_len += 4

            auto w1 = self.stream#.write_all_async(*head_u8, head_len).await
            if w1.is_err() {
                return Result<usize, string>::Err(w1.unwrap_err())
            }

            if p_len > 0 {
                auto *pay_raw# = payload.unsafe_as_raw()
                auto masked_payload_vec# = Vec<u8>::with_capacity(p_len)
                auto i_mp#: usize = 0
                loop i_mp < p_len { masked_payload_vec#.push(0:u8); i_mp += 1 }
                auto *masked_pay# = masked_payload_vec.unsafe_as_raw()
                auto *masked_u8# = to_u8_ptr(*masked_pay)
                auto i#: usize = 0
                loop i < p_len {
                    unsafe masked_pay[i] = (pay_raw[i] as u8) ^ (mask_key[i % 4] as u8)
                    i += 1
                }
                auto w2 = self.stream#.write_all_async(*masked_u8, p_len).await
                if w2.is_err() {
                    return Result<usize, string>::Err(w2.unwrap_err())
                }
            }
        } else {
            auto w1 = self.stream#.write_all_async(*head_u8, 2:usize).await
            if w1.is_err() {
                return Result<usize, string>::Err(w1.unwrap_err())
            }

            if p_len > 0 {
                auto *pay_raw# = payload.unsafe_as_raw()
                auto *pay_u8# = to_u8_ptr(*pay_raw)
                auto w2 = self.stream#.write_all_async(*pay_u8, p_len).await
                if w2.is_err() {
                    return Result<usize, string>::Err(w2.unwrap_err())
                }
            }
        }
        return Result<usize, string>::Ok(p_len)
    }

    pub fn close_async(self#) -> async Result<(), string> {
        auto empty_payload = Vec<u8>::new()
        auto w_res = self#.write_control_frame_async(0x08:u8, empty_payload).await
        self.stream#.close()
        match w_res {
            auto Result<usize, string>::Ok(_) => {
                return Result<(), string>::Ok(())
            }
            auto Result<usize, string>::Err(&e) => {
                return Result<(), string>::Err(e.clone())
            }
        }
    }
}
