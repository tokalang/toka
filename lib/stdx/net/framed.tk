//
// stdx/net/framed.tk — 4-byte big-endian length-prefixed framing protocol.
//
// Implements robust framing over any @AsyncTransport, with owner-carrying
// buffer lifecycle management, resumable cursor range write driving loops,
// bounded zero-progress defense, premature EOF / truncated frame detection,
// cancel unwinding cleanup via scope-bound guards, range and completion fact
// consistency validation, and consistent terminal resource cleanup.
//
// Progress consistency semantics:
// - Offset is the byte offset into the caller's retained buffer.
// - Transport write operations must satisfy: bytes_written <= total_len - offset.
// - Transport complete flag must be true iff (offset + bytes_written) == total_len.
// - Contradictory progress (bytes_written > remaining, or bytes_written == remaining
//   with !complete, or bytes_written < remaining with complete) constitutes a fatal
//   transport violation and transitions state to FRAMED_STATE_TERMINATED (5).
// - Unhandled task cancellation drops the frame's scope-bound guard, which
//   transitions state to FRAMED_STATE_TERMINATED (5) and closes the underlying transport.

import std/vec::{Vec}
import core/result::{Result}
import core/string::{string}
import core/types::{Addr}
import stdx/net/transport::{@AsyncTransport}

pub const MAX_FRAME_SIZE: usize = 16777216:usize // 16MB

pub const FRAMED_STATE_READY: i32 = 0:i32
pub const FRAMED_STATE_READING_HEADER: i32 = 1:i32
pub const FRAMED_STATE_READING_PAYLOAD: i32 = 2:i32
pub const FRAMED_STATE_WRITING: i32 = 3:i32
pub const FRAMED_STATE_EOF: i32 = 4:i32
pub const FRAMED_STATE_TERMINATED: i32 = 5:i32

pub const FRAMED_ERR_TRUNCATED: i32 = 1:i32
pub const FRAMED_ERR_TOO_LARGE: i32 = 2:i32
pub const FRAMED_ERR_ZERO_PROGRESS: i32 = 3:i32
pub const FRAMED_ERR_IO: i32 = 4:i32
pub const FRAMED_ERR_TERMINATED: i32 = 5:i32

pub shape FramedReadResult (
    buffer#: Vec<u8>,
    payload_len: usize,
    eof: bool
)

impl FramedReadResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }
}

pub shape FramedWriteResult (
    buffer#: Vec<u8>,
    bytes_written: usize
)

impl FramedWriteResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }
}

pub shape FramedError (
    kind: i32,
    buffer#: Vec<u8>,
    message: string
)

impl FramedError {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }

    pub fn is_truncated(self) -> bool {
        return self.kind == 1:i32
    }

    pub fn is_too_large(self) -> bool {
        return self.kind == 2:i32
    }

    pub fn is_zero_progress(self) -> bool {
        return self.kind == 3:i32
    }

    pub fn is_io(self) -> bool {
        return self.kind == 4:i32
    }

    pub fn is_terminated(self) -> bool {
        return self.kind == 5:i32
    }
}

pub shape FramedStream<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_read: usize,
    frames_written: usize
)

shape FramedStreamCancelGuard<T> (
    framed_addr: Addr,
    active: bool
)

impl<T> FramedStreamCancelGuard<T>@Encap {
    fn drop(self#) {
        if self.active {
            auto *f# = unsafe (self.framed_addr as *FramedStream<T>#)
            f#.close()
        }
    }
}

impl<T: @AsyncTransport> FramedStream<T> {
    pub fn new(transport: cede T) -> FramedStream<T> {
        return FramedStream<T>(
            transport = cede transport,
            state = 0:i32,
            frames_read = 0:usize,
            frames_written = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_read(self) -> usize {
        return self.frames_read
    }

    pub fn get_frames_written(self) -> usize {
        return self.frames_written
    }

    pub fn read_frame_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<FramedReadResult, FramedError> {
        auto owned# = cede owner
        if self.state == 5:i32 {
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned,
                message = string::from("FramedStream is terminated")
            ))
        }
        if self.state == 4:i32 {
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        auto cancel_guard# = FramedStreamCancelGuard<T>(
            framed_addr = unsafe (&self as Addr),
            active = true
        )

        self.state = 1:i32
        auto header_bytes# = Vec<u8>::with_capacity(4:usize)
        auto header_collected# = 0:usize
        auto zero_prog_count# = 0:i32
        auto temp_chunk# = Vec<u8>::with_capacity(4:usize)
        auto failed# = false
        auto err_kind# = 0:i32
        auto err_msg# = string::from("")
        auto is_clean_eof# = false

        loop header_collected < 4:usize {
            auto need = 4:usize - header_collected
            auto read_res = self.transport#.read_into_async(cede temp_chunk, need, timeout_ms).await
            match cede read_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    temp_chunk = read_succ#.take_buffer()

                    if n > need {
                        failed = true
                        err_kind = 4:i32
                        err_msg = string::from("Inconsistent transport read progress: count exceeds requested range")
                        break
                    }

                    if is_eof && n == 0:usize {
                        if header_collected == 0:usize {
                            is_clean_eof = true
                        } else {
                            failed = true
                            err_kind = 1:i32
                            err_msg = string::from("Truncated frame header: unexpected EOF")
                        }
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame header read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto idx# = 0:usize
                        loop idx < n {
                            header_bytes#.push(temp_chunk.get(idx))
                            idx += 1:usize
                        }
                        header_collected += n
                    }
                }
            }
        }

        if is_clean_eof {
            cancel_guard.active = false
            self.state = 4:i32
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        auto b0 = header_bytes.get(0) as usize
        auto b1 = header_bytes.get(1) as usize
        auto b2 = header_bytes.get(2) as usize
        auto b3 = header_bytes.get(3) as usize
        auto payload_len = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned,
                message = string::from("Frame length exceeds MAX_FRAME_SIZE (16MB)")
            ))
        }

        if payload_len == 0:usize {
            owned#.clear()
            self.frames_read += 1:usize
            self.state = 0:i32
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = false
            ))
        }

        self.state = 2:i32
        owned#.clear()
        auto payload_collected# = 0:usize
        zero_prog_count = 0:i32
        auto chunk_buf# = Vec<u8>::with_capacity(4096:usize)

        loop payload_collected < payload_len {
            auto rem = payload_len - payload_collected
            auto need# = rem
            if need > 4096:usize {
                need = 4096:usize
            }
            auto payload_res = self.transport#.read_into_async(cede chunk_buf, need, timeout_ms).await
            match cede payload_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    chunk_buf = read_succ#.take_buffer()

                    if n > need {
                        failed = true
                        err_kind = 4:i32
                        err_msg = string::from("Inconsistent transport read progress: count exceeds requested range")
                        break
                    }

                    if is_eof && n == 0:usize {
                        failed = true
                        err_kind = 1:i32
                        err_msg = string::from("Truncated frame payload: unexpected EOF")
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame payload read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto pidx# = 0:usize
                        loop pidx < n {
                            owned#.push(chunk_buf.get(pidx))
                            pidx += 1:usize
                        }
                        payload_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        self.frames_read += 1:usize
        self.state = 0:i32
        cancel_guard.active = false
        return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
            buffer = cede owned,
            payload_len = payload_len,
            eof = false
        ))
    }

    pub fn write_frame_async(self#, cede payload: Vec<u8>, timeout_ms: i32) -> async Result<FramedWriteResult, FramedError> {
        auto owned_payload# = cede payload
        if self.state == 5:i32 {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("FramedStream is terminated")
            ))
        }

        auto payload_len = owned_payload.len()
        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned_payload,
                message = string::from("Payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        auto cancel_guard# = FramedStreamCancelGuard<T>(
            framed_addr = unsafe (&self as Addr),
            active = true
        )

        auto header_buf# = Vec<u8>::with_capacity(4:usize)
        header_buf#.push(((payload_len >> 24) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 16) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 8) & 0xFF) as u8)
        header_buf#.push((payload_len & 0xFF) as u8)

        self.state = 3:i32
        auto header_offset# = 0:usize
        auto zero_prog_count# = 0:i32
        auto header_failed# = false
        auto header_err_kind# = 0:i32
        auto header_err_msg# = string::from("")

        loop header_offset < 4:usize {
            auto header_res = self.transport#.write_from_async(cede header_buf, header_offset, timeout_ms).await
            match cede header_res {
                auto Result::Err(io_err#) => {
                    header_failed = true
                    header_err_kind = 4:i32
                    header_err_msg = io_err.message.clone()
                    header_buf = io_err#.take_buffer()
                    break
                }
                auto Result::Ok(write_succ#) => {
                    auto n = write_succ.bytes_written
                    auto comp = write_succ.complete
                    header_buf = write_succ#.take_buffer()
                    auto rem = 4:usize - header_offset
                    if header_buf.len() != 4:usize || n > rem || (n == rem && !comp) || (n < rem && comp) {
                        header_failed = true
                        header_err_kind = 4:i32
                        header_err_msg = string::from("Inconsistent transport write progress: count exceeds range or contradicts complete status")
                        break
                    }
                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            header_failed = true
                            header_err_kind = 3:i32
                            header_err_msg = string::from("Zero progress detected during frame header write")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        header_offset += n
                    }
                }
            }
        }

        if header_failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = header_err_kind,
                buffer = cede owned_payload,
                message = cede header_err_msg
            ))
        }

        if payload_len > 0:usize {
            auto payload_offset# = 0:usize
            zero_prog_count = 0:i32
            auto payload_failed# = false
            auto payload_err_kind# = 0:i32
            auto payload_err_msg# = string::from("")

            loop payload_offset < payload_len {
                auto payload_res = self.transport#.write_from_async(cede owned_payload, payload_offset, timeout_ms).await
                match cede payload_res {
                    auto Result::Err(io_err#) => {
                        payload_failed = true
                        payload_err_kind = 4:i32
                        payload_err_msg = io_err.message.clone()
                        owned_payload = io_err#.take_buffer()
                        break
                    }
                    auto Result::Ok(write_succ#) => {
                        auto n = write_succ.bytes_written
                        auto comp = write_succ.complete
                        owned_payload = write_succ#.take_buffer()
                        auto rem = payload_len - payload_offset
                        if owned_payload.len() != payload_len || n > rem || (n == rem && !comp) || (n < rem && comp) {
                            payload_failed = true
                            payload_err_kind = 4:i32
                            payload_err_msg = string::from("Inconsistent transport write progress: count exceeds range or contradicts complete status")
                            break
                        }
                        if n == 0:usize {
                            zero_prog_count += 1:i32
                            if zero_prog_count >= 16:i32 {
                                payload_failed = true
                                payload_err_kind = 3:i32
                                payload_err_msg = string::from("Zero progress detected during frame payload write")
                                break
                            }
                        } else {
                            zero_prog_count = 0:i32
                            payload_offset += n
                        }
                    }
                }
            }

            if payload_failed {
                self.state = 5:i32
                self.transport#.close()
                cancel_guard.active = false
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = payload_err_kind,
                    buffer = cede owned_payload,
                    message = cede payload_err_msg
                ))
            }
        }

        self.frames_written += 1:usize
        self.state = 0:i32
        cancel_guard.active = false
        return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
            buffer = cede owned_payload,
            bytes_written = payload_len
        ))
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}

pub shape FramedReader<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_read: usize
)

shape FramedReaderCancelGuard<T> (
    reader_addr: Addr,
    active: bool
)

impl<T> FramedReaderCancelGuard<T>@Encap {
    fn drop(self#) {
        if self.active {
            auto *f# = unsafe (self.reader_addr as *FramedReader<T>#)
            f#.close()
        }
    }
}

impl<T: @AsyncTransport> FramedReader<T> {
    pub fn new(transport: cede T) -> FramedReader<T> {
        return FramedReader<T>(
            transport = cede transport,
            state = 0:i32,
            frames_read = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_read(self) -> usize {
        return self.frames_read
    }

    pub fn read_frame_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<FramedReadResult, FramedError> {
        auto owned# = cede owner
        if self.state == 5:i32 {
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned,
                message = string::from("FramedReader is terminated")
            ))
        }
        if self.state == 4:i32 {
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        auto cancel_guard# = FramedReaderCancelGuard<T>(
            reader_addr = unsafe (&self as Addr),
            active = true
        )

        self.state = 1:i32
        auto header_bytes# = Vec<u8>::with_capacity(4:usize)
        auto header_collected# = 0:usize
        auto zero_prog_count# = 0:i32
        auto temp_chunk# = Vec<u8>::with_capacity(4:usize)
        auto failed# = false
        auto err_kind# = 0:i32
        auto err_msg# = string::from("")
        auto is_clean_eof# = false

        loop header_collected < 4:usize {
            auto need = 4:usize - header_collected
            auto read_res = self.transport#.read_into_async(cede temp_chunk, need, timeout_ms).await
            match cede read_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    temp_chunk = read_succ#.take_buffer()

                    if n > need {
                        failed = true
                        err_kind = 4:i32
                        err_msg = string::from("Inconsistent transport read progress: count exceeds requested range")
                        break
                    }

                    if is_eof && n == 0:usize {
                        if header_collected == 0:usize {
                            is_clean_eof = true
                        } else {
                            failed = true
                            err_kind = 1:i32
                            err_msg = string::from("Truncated frame header: unexpected EOF")
                        }
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame header read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto idx# = 0:usize
                        loop idx < n {
                            header_bytes#.push(temp_chunk.get(idx))
                            idx += 1:usize
                        }
                        header_collected += n
                    }
                }
            }
        }

        if is_clean_eof {
            cancel_guard.active = false
            self.state = 4:i32
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        auto b0 = header_bytes.get(0) as usize
        auto b1 = header_bytes.get(1) as usize
        auto b2 = header_bytes.get(2) as usize
        auto b3 = header_bytes.get(3) as usize
        auto payload_len = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned,
                message = string::from("Frame length exceeds MAX_FRAME_SIZE (16MB)")
            ))
        }

        if payload_len == 0:usize {
            owned#.clear()
            self.frames_read += 1:usize
            self.state = 0:i32
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = false
            ))
        }

        self.state = 2:i32
        owned#.clear()
        auto payload_collected# = 0:usize
        zero_prog_count = 0:i32
        auto chunk_buf# = Vec<u8>::with_capacity(4096:usize)

        loop payload_collected < payload_len {
            auto rem = payload_len - payload_collected
            auto need# = rem
            if need > 4096:usize {
                need = 4096:usize
            }
            auto payload_res = self.transport#.read_into_async(cede chunk_buf, need, timeout_ms).await
            match cede payload_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    chunk_buf = read_succ#.take_buffer()

                    if n > need {
                        failed = true
                        err_kind = 4:i32
                        err_msg = string::from("Inconsistent transport read progress: count exceeds requested range")
                        break
                    }

                    if is_eof && n == 0:usize {
                        failed = true
                        err_kind = 1:i32
                        err_msg = string::from("Truncated frame payload: unexpected EOF")
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame payload read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto pidx# = 0:usize
                        loop pidx < n {
                            owned#.push(chunk_buf.get(pidx))
                            pidx += 1:usize
                        }
                        payload_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        self.frames_read += 1:usize
        self.state = 0:i32
        cancel_guard.active = false
        return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
            buffer = cede owned,
            payload_len = payload_len,
            eof = false
        ))
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}

pub shape FramedWriter<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_written: usize
)

shape FramedWriterCancelGuard<T> (
    writer_addr: Addr,
    active: bool
)

impl<T> FramedWriterCancelGuard<T>@Encap {
    fn drop(self#) {
        if self.active {
            auto *f# = unsafe (self.writer_addr as *FramedWriter<T>#)
            f#.close()
        }
    }
}

impl<T: @AsyncTransport> FramedWriter<T> {
    pub fn new(transport: cede T) -> FramedWriter<T> {
        return FramedWriter<T>(
            transport = cede transport,
            state = 0:i32,
            frames_written = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_written(self) -> usize {
        return self.frames_written
    }

    pub fn write_frame_async(self#, cede payload: Vec<u8>, timeout_ms: i32) -> async Result<FramedWriteResult, FramedError> {
        auto owned_payload# = cede payload
        if self.state == 5:i32 {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("FramedWriter is terminated")
            ))
        }

        auto payload_len = owned_payload.len()
        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned_payload,
                message = string::from("Payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        auto cancel_guard# = FramedWriterCancelGuard<T>(
            writer_addr = unsafe (&self as Addr),
            active = true
        )

        auto header_buf# = Vec<u8>::with_capacity(4:usize)
        header_buf#.push(((payload_len >> 24) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 16) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 8) & 0xFF) as u8)
        header_buf#.push((payload_len & 0xFF) as u8)

        self.state = 3:i32
        auto header_offset# = 0:usize
        auto zero_prog_count# = 0:i32
        auto header_failed# = false
        auto header_err_kind# = 0:i32
        auto header_err_msg# = string::from("")

        loop header_offset < 4:usize {
            auto header_res = self.transport#.write_from_async(cede header_buf, header_offset, timeout_ms).await
            match cede header_res {
                auto Result::Err(io_err#) => {
                    header_failed = true
                    header_err_kind = 4:i32
                    header_err_msg = io_err.message.clone()
                    header_buf = io_err#.take_buffer()
                    break
                }
                auto Result::Ok(write_succ#) => {
                    auto n = write_succ.bytes_written
                    auto comp = write_succ.complete
                    header_buf = write_succ#.take_buffer()
                    auto rem = 4:usize - header_offset
                    if header_buf.len() != 4:usize || n > rem || (n == rem && !comp) || (n < rem && comp) {
                        header_failed = true
                        header_err_kind = 4:i32
                        header_err_msg = string::from("Inconsistent transport write progress: count exceeds range or contradicts complete status")
                        break
                    }
                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            header_failed = true
                            header_err_kind = 3:i32
                            header_err_msg = string::from("Zero progress detected during frame header write")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        header_offset += n
                    }
                }
            }
        }

        if header_failed {
            self.state = 5:i32
            self.transport#.close()
            cancel_guard.active = false
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = header_err_kind,
                buffer = cede owned_payload,
                message = cede header_err_msg
            ))
        }

        if payload_len > 0:usize {
            auto payload_offset# = 0:usize
            zero_prog_count = 0:i32
            auto payload_failed# = false
            auto payload_err_kind# = 0:i32
            auto payload_err_msg# = string::from("")

            loop payload_offset < payload_len {
                auto payload_res = self.transport#.write_from_async(cede owned_payload, payload_offset, timeout_ms).await
                match cede payload_res {
                    auto Result::Err(io_err#) => {
                        payload_failed = true
                        payload_err_kind = 4:i32
                        payload_err_msg = io_err.message.clone()
                        owned_payload = io_err#.take_buffer()
                        break
                    }
                    auto Result::Ok(write_succ#) => {
                        auto n = write_succ.bytes_written
                        auto comp = write_succ.complete
                        owned_payload = write_succ#.take_buffer()
                        auto rem = payload_len - payload_offset
                        if owned_payload.len() != payload_len || n > rem || (n == rem && !comp) || (n < rem && comp) {
                            payload_failed = true
                            payload_err_kind = 4:i32
                            payload_err_msg = string::from("Inconsistent transport write progress: count exceeds range or contradicts complete status")
                            break
                        }
                        if n == 0:usize {
                            zero_prog_count += 1:i32
                            if zero_prog_count >= 16:i32 {
                                payload_failed = true
                                payload_err_kind = 3:i32
                                payload_err_msg = string::from("Zero progress detected during frame payload write")
                                break
                            }
                        } else {
                            zero_prog_count = 0:i32
                            payload_offset += n
                        }
                    }
                }
            }

            if payload_failed {
                self.state = 5:i32
                self.transport#.close()
                cancel_guard.active = false
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = payload_err_kind,
                    buffer = cede owned_payload,
                    message = cede payload_err_msg
                ))
            }
        }

        self.frames_written += 1:usize
        self.state = 0:i32
        cancel_guard.active = false
        return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
            buffer = cede owned_payload,
            bytes_written = payload_len
        ))
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}
