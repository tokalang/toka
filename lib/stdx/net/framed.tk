// stdx/net/framed.tk — 4-byte big-endian length-prefixed framing protocol.
//
// Implements robust framing over any @AsyncTransport, with zero-copy
// owner-carrying buffers, zero-progress detection, premature EOF / truncated
// frame detection, and cancellation resource safety.
import std/vec::{Vec}
import core/result::{Result}
import core/string::{string}
import stdx/net/transport::{@AsyncTransport}

pub const MAX_FRAME_SIZE: usize = 16777216:usize // 16MB

pub const FRAMED_STATE_READY: i32 = 0:i32
pub const FRAMED_STATE_READING_HEADER: i32 = 1:i32
pub const FRAMED_STATE_READING_PAYLOAD: i32 = 2:i32
pub const FRAMED_STATE_WRITING: i32 = 3:i32
pub const FRAMED_STATE_EOF: i32 = 4:i32
pub const FRAMED_STATE_TERMINATED: i32 = 5:i32

pub const FRAMED_ERR_TRUNCATED: i32 = 1:i32
pub const FRAMED_ERR_TOO_LARGE: i32 = 2:i32
pub const FRAMED_ERR_ZERO_PROGRESS: i32 = 3:i32
pub const FRAMED_ERR_IO: i32 = 4:i32
pub const FRAMED_ERR_TERMINATED: i32 = 5:i32

pub shape FramedReadResult (
    buffer#: Vec<u8>,
    payload_len: usize,
    eof: bool
)

impl FramedReadResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }
}

pub shape FramedWriteResult (
    buffer#: Vec<u8>,
    bytes_written: usize
)

impl FramedWriteResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }
}

pub shape FramedError (
    kind: i32,
    buffer#: Vec<u8>,
    message: string
)

impl FramedError {
    pub fn take_buffer(cede self) -> Vec<u8> {
        auto result = self.buffer#.take()
        cede self
        return cede result
    }

    pub fn is_truncated(self) -> bool {
        return self.kind == 1:i32
    }

    pub fn is_too_large(self) -> bool {
        return self.kind == 2:i32
    }

    pub fn is_zero_progress(self) -> bool {
        return self.kind == 3:i32
    }

    pub fn is_io(self) -> bool {
        return self.kind == 4:i32
    }

    pub fn is_terminated(self) -> bool {
        return self.kind == 5:i32
    }
}

pub shape FramedStream<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_read: usize,
    frames_written: usize
)

impl<T: @AsyncTransport> FramedStream<T> {
    pub fn new(transport: cede T) -> FramedStream<T> {
        return FramedStream<T>(
            transport = cede transport,
            state = 0:i32,
            frames_read = 0:usize,
            frames_written = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_read(self) -> usize {
        return self.frames_read
    }

    pub fn get_frames_written(self) -> usize {
        return self.frames_written
    }

    pub fn read_frame_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<FramedReadResult, FramedError> {
        auto owned# = cede owner
        if self.state == 5:i32 {
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned,
                message = string::from("FramedStream is terminated")
            ))
        }
        if self.state == 4:i32 {
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        self.state = 1:i32
        auto header_bytes# = Vec<u8>::with_capacity(4:usize)
        auto header_collected# = 0:usize
        auto zero_prog_count# = 0:i32
        auto temp_chunk# = Vec<u8>::with_capacity(4:usize)
        auto failed# = false
        auto err_kind# = 0:i32
        auto err_msg# = string::from("")
        auto is_clean_eof# = false

        loop header_collected < 4:usize {
            auto need = 4:usize - header_collected
            auto awaited_read = self.transport#.read_into_async(cede temp_chunk, need, timeout_ms).await?
            if awaited_read.is_none() {
                failed = true
                err_kind = 5:i32
                err_msg = string::from("Cancelled during frame header read")
                break
            }
            auto read_res = awaited_read.unwrap()
            match cede read_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    temp_chunk = read_succ#.take_buffer()

                    if is_eof && n == 0:usize {
                        if header_collected == 0:usize {
                            is_clean_eof = true
                        } else {
                            failed = true
                            err_kind = 1:i32
                            err_msg = string::from("Truncated frame header: unexpected EOF")
                        }
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame header read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto idx# = 0:usize
                        loop idx < n {
                            header_bytes#.push(temp_chunk.get(idx))
                            idx += 1:usize
                        }
                        header_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        if is_clean_eof {
            self.state = 4:i32
            owned#.clear()
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        auto b0 = header_bytes.get(0) as usize
        auto b1 = header_bytes.get(1) as usize
        auto b2 = header_bytes.get(2) as usize
        auto b3 = header_bytes.get(3) as usize
        auto payload_len = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned,
                message = string::from("Frame payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        if payload_len == 0:usize {
            owned#.clear()
            self.frames_read += 1:usize
            self.state = 0:i32
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = false
            ))
        }

        self.state = 2:i32
        owned#.clear()
        auto payload_collected# = 0:usize
        zero_prog_count = 0:i32
        auto chunk_buf# = Vec<u8>::with_capacity(4096:usize)

        loop payload_collected < payload_len {
            auto need = payload_len - payload_collected
            auto awaited_payload = self.transport#.read_into_async(cede chunk_buf, need, timeout_ms).await?
            if awaited_payload.is_none() {
                failed = true
                err_kind = 5:i32
                err_msg = string::from("Cancelled during frame payload read")
                break
            }
            auto payload_res = awaited_payload.unwrap()
            match cede payload_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    chunk_buf = read_succ#.take_buffer()

                    if is_eof && n == 0:usize {
                        failed = true
                        err_kind = 1:i32
                        err_msg = string::from("Truncated frame payload: unexpected EOF")
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame payload read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto pidx# = 0:usize
                        loop pidx < n {
                            owned#.push(chunk_buf.get(pidx))
                            pidx += 1:usize
                        }
                        payload_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        self.frames_read += 1:usize
        self.state = 0:i32
        return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
            buffer = cede owned,
            payload_len = payload_len,
            eof = false
        ))
    }

    pub fn write_frame_async(self#, cede payload: Vec<u8>, timeout_ms: i32) -> async Result<FramedWriteResult, FramedError> {
        auto owned_payload# = cede payload
        if self.state == 5:i32 {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("FramedStream is terminated")
            ))
        }

        auto payload_len = owned_payload.len()
        if payload_len > 16777216:usize {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned_payload,
                message = string::from("Payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        auto header_buf# = Vec<u8>::with_capacity(4:usize)
        header_buf#.push(((payload_len >> 24) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 16) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 8) & 0xFF) as u8)
        header_buf#.push((payload_len & 0xFF) as u8)

        self.state = 3:i32
        auto header_write_opt = self.transport#.write_from_async(cede header_buf, timeout_ms).await?
        if header_write_opt.is_none() {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("Cancelled during frame header write")
            ))
        }
        auto header_write_res = header_write_opt.unwrap()
        match cede header_write_res {
            auto Result::Err(io_err#) => {
                self.state = 5:i32
                self.transport#.close()
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = 4:i32,
                    buffer = cede owned_payload,
                    message = io_err.message.clone()
                ))
            }
            auto Result::Ok(write_succ#) => {}
        }

        if payload_len > 0:usize {
            auto payload_write_opt = self.transport#.write_from_async(cede owned_payload, timeout_ms).await?
            if payload_write_opt.is_none() {
                self.state = 5:i32
                self.transport#.close()
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = 5:i32,
                    buffer = Vec<u8>::new(),
                    message = string::from("Cancelled during frame payload write")
                ))
            }
            auto payload_write_res = payload_write_opt.unwrap()
            match cede payload_write_res {
                auto Result::Err(io_err#) => {
                    self.state = 5:i32
                    auto ret_msg = io_err.message.clone()
                    auto ret_buf = io_err#.take_buffer()
                    return Result<FramedWriteResult, FramedError>::Err(FramedError(
                        kind = 4:i32,
                        buffer = cede ret_buf,
                        message = cede ret_msg
                    ))
                }
                auto Result::Ok(write_succ#) => {
                    auto ret_buf = write_succ#.take_buffer()
                    self.frames_written += 1:usize
                    self.state = 0:i32
                    return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
                        buffer = cede ret_buf,
                        bytes_written = payload_len
                    ))
                }
            }
        } else {
            self.frames_written += 1:usize
            self.state = 0:i32
            return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
                buffer = cede owned_payload,
                bytes_written = 0:usize
            ))
        }
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}

pub shape FramedReader<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_read: usize
)

impl<T: @AsyncTransport> FramedReader<T> {
    pub fn new(transport: cede T) -> FramedReader<T> {
        return FramedReader<T>(
            transport = cede transport,
            state = 0:i32,
            frames_read = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_read(self) -> usize {
        return self.frames_read
    }

    pub fn read_frame_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<FramedReadResult, FramedError> {
        auto owned# = cede owner
        if self.state == 5:i32 {
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned,
                message = string::from("FramedReader is terminated")
            ))
        }
        if self.state == 4:i32 {
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        self.state = 1:i32
        auto header_bytes# = Vec<u8>::with_capacity(4:usize)
        auto header_collected# = 0:usize
        auto zero_prog_count# = 0:i32
        auto temp_chunk# = Vec<u8>::with_capacity(4:usize)
        auto failed# = false
        auto err_kind# = 0:i32
        auto err_msg# = string::from("")
        auto is_clean_eof# = false

        loop header_collected < 4:usize {
            auto need = 4:usize - header_collected
            auto awaited_read = self.transport#.read_into_async(cede temp_chunk, need, timeout_ms).await?
            if awaited_read.is_none() {
                failed = true
                err_kind = 5:i32
                err_msg = string::from("Cancelled during frame header read")
                break
            }
            auto read_res = awaited_read.unwrap()
            match cede read_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    temp_chunk = read_succ#.take_buffer()

                    if is_eof && n == 0:usize {
                        if header_collected == 0:usize {
                            is_clean_eof = true
                        } else {
                            failed = true
                            err_kind = 1:i32
                            err_msg = string::from("Truncated frame header: unexpected EOF")
                        }
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame header read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto idx# = 0:usize
                        loop idx < n {
                            header_bytes#.push(temp_chunk.get(idx))
                            idx += 1:usize
                        }
                        header_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        if is_clean_eof {
            self.state = 4:i32
            owned#.clear()
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = true
            ))
        }

        auto b0 = header_bytes.get(0) as usize
        auto b1 = header_bytes.get(1) as usize
        auto b2 = header_bytes.get(2) as usize
        auto b3 = header_bytes.get(3) as usize
        auto payload_len = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

        if payload_len > 16777216:usize {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned,
                message = string::from("Frame payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        if payload_len == 0:usize {
            owned#.clear()
            self.frames_read += 1:usize
            self.state = 0:i32
            return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
                buffer = cede owned,
                payload_len = 0:usize,
                eof = false
            ))
        }

        self.state = 2:i32
        owned#.clear()
        auto payload_collected# = 0:usize
        zero_prog_count = 0:i32
        auto chunk_buf# = Vec<u8>::with_capacity(4096:usize)

        loop payload_collected < payload_len {
            auto need = payload_len - payload_collected
            auto awaited_payload = self.transport#.read_into_async(cede chunk_buf, need, timeout_ms).await?
            if awaited_payload.is_none() {
                failed = true
                err_kind = 5:i32
                err_msg = string::from("Cancelled during frame payload read")
                break
            }
            auto payload_res = awaited_payload.unwrap()
            match cede payload_res {
                auto Result::Err(io_err#) => {
                    failed = true
                    err_kind = 4:i32
                    err_msg = io_err.message.clone()
                    break
                }
                auto Result::Ok(read_succ#) => {
                    auto n = read_succ.bytes_read
                    auto is_eof = read_succ.eof
                    chunk_buf = read_succ#.take_buffer()

                    if is_eof && n == 0:usize {
                        failed = true
                        err_kind = 1:i32
                        err_msg = string::from("Truncated frame payload: unexpected EOF")
                        break
                    }

                    if n == 0:usize {
                        zero_prog_count += 1:i32
                        if zero_prog_count >= 16:i32 {
                            failed = true
                            err_kind = 3:i32
                            err_msg = string::from("Zero progress detected during frame payload read")
                            break
                        }
                    } else {
                        zero_prog_count = 0:i32
                        auto pidx# = 0:usize
                        loop pidx < n {
                            owned#.push(chunk_buf.get(pidx))
                            pidx += 1:usize
                        }
                        payload_collected += n
                    }
                }
            }
        }

        if failed {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedReadResult, FramedError>::Err(FramedError(
                kind = err_kind,
                buffer = cede owned,
                message = cede err_msg
            ))
        }

        self.frames_read += 1:usize
        self.state = 0:i32
        return Result<FramedReadResult, FramedError>::Ok(FramedReadResult(
            buffer = cede owned,
            payload_len = payload_len,
            eof = false
        ))
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}

pub shape FramedWriter<T: @AsyncTransport> (
    transport: T,
    state: i32,
    frames_written: usize
)

impl<T: @AsyncTransport> FramedWriter<T> {
    pub fn new(transport: cede T) -> FramedWriter<T> {
        return FramedWriter<T>(
            transport = cede transport,
            state = 0:i32,
            frames_written = 0:usize
        )
    }

    pub fn get_state(self) -> i32 {
        return self.state
    }

    pub fn get_frames_written(self) -> usize {
        return self.frames_written
    }

    pub fn write_frame_async(self#, cede payload: Vec<u8>, timeout_ms: i32) -> async Result<FramedWriteResult, FramedError> {
        auto owned_payload# = cede payload
        if self.state == 5:i32 {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("FramedWriter is terminated")
            ))
        }

        auto payload_len = owned_payload.len()
        if payload_len > 16777216:usize {
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 2:i32,
                buffer = cede owned_payload,
                message = string::from("Payload size exceeds MAX_FRAME_SIZE")
            ))
        }

        auto header_buf# = Vec<u8>::with_capacity(4:usize)
        header_buf#.push(((payload_len >> 24) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 16) & 0xFF) as u8)
        header_buf#.push(((payload_len >> 8) & 0xFF) as u8)
        header_buf#.push((payload_len & 0xFF) as u8)

        self.state = 3:i32
        auto header_write_opt = self.transport#.write_from_async(cede header_buf, timeout_ms).await?
        if header_write_opt.is_none() {
            self.state = 5:i32
            self.transport#.close()
            return Result<FramedWriteResult, FramedError>::Err(FramedError(
                kind = 5:i32,
                buffer = cede owned_payload,
                message = string::from("Cancelled during frame header write")
            ))
        }
        auto header_write_res = header_write_opt.unwrap()
        match cede header_write_res {
            auto Result::Err(io_err#) => {
                self.state = 5:i32
                self.transport#.close()
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = 4:i32,
                    buffer = cede owned_payload,
                    message = io_err.message.clone()
                ))
            }
            auto Result::Ok(write_succ#) => {}
        }

        if payload_len > 0:usize {
            auto payload_write_opt = self.transport#.write_from_async(cede owned_payload, timeout_ms).await?
            if payload_write_opt.is_none() {
                self.state = 5:i32
                self.transport#.close()
                return Result<FramedWriteResult, FramedError>::Err(FramedError(
                    kind = 5:i32,
                    buffer = Vec<u8>::new(),
                    message = string::from("Cancelled during frame payload write")
                ))
            }
            auto payload_write_res = payload_write_opt.unwrap()
            match cede payload_write_res {
                auto Result::Err(io_err#) => {
                    self.state = 5:i32
                    auto ret_msg = io_err.message.clone()
                    auto ret_buf = io_err#.take_buffer()
                    return Result<FramedWriteResult, FramedError>::Err(FramedError(
                        kind = 4:i32,
                        buffer = cede ret_buf,
                        message = cede ret_msg
                    ))
                }
                auto Result::Ok(write_succ#) => {
                    auto ret_buf = write_succ#.take_buffer()
                    self.frames_written += 1:usize
                    self.state = 0:i32
                    return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
                        buffer = cede ret_buf,
                        bytes_written = payload_len
                    ))
                }
            }
        } else {
            self.frames_written += 1:usize
            self.state = 0:i32
            return Result<FramedWriteResult, FramedError>::Ok(FramedWriteResult(
                buffer = cede owned_payload,
                bytes_written = 0:usize
            ))
        }
    }

    pub fn close(self#) {
        self.state = 5:i32
        self.transport#.close()
    }
}
