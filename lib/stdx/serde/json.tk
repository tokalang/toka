// lib/stdx/serde/json.tk
// Standard Serialization for JSON using Toka Comptime Reflection

import core/str::{str, str}
import std/hashmap::{HashMap}
import std/vec::{Vec}
import core/comptime::{reflect}
import stdx/serde/json_leaf::{leaf_skip_whitespace, parse_i32_value, parse_string_value, parse_str_view}

// Result type for parsing: Ok(remaining_json) or Err(error_message)
pub alias JsonRes = Result<str, str>
pub import stdx/serde/json_factory::{@JsonFactory, Parsed, json_skip_value}

pub shape JsonNode (
    NullNode(i32) = 0 |
    BoolNode(bool) = 1 |
    NumNode(f64) = 2 |
    StrNode(string) = 3 |
    ArrayNode(Vec<JsonNode>) = 4 |
    ObjectNode(HashMap<string, JsonNode>) = 5
)

// --- ToJson Trait ---

pub trait @ToJson {
    // Append JSON representation to the caller-owned buffer.
    pub fn write_json(self, buf#: string)
}

impl<'T: @ToJson> &'T@ToJson {
    pub fn write_json(self, buf#: string) {
        // [Compiler Magic] This will call the write_json on the soul
        self.write_json(buf#)
    }
}

impl i32@ToJson {
    pub fn write_json(self, buf#: string) {
        auto tmp = string::from_int(self)
        buf#.push_view(tmp.as_view())
    }
}

impl i64@ToJson {
    pub fn write_json(self, buf#: string) {
        auto tmp = string::from_i64(self)
        buf#.push_view(tmp.as_view())
    }
}

impl f64@ToJson {
    pub fn write_json(self, buf#: string) {
        auto tmp = string::from_f64(self)
        buf#.push_view(tmp.as_view())
    }
}

impl bool@ToJson {
    pub fn write_json(self, buf#: string) {
        if self { buf#.push_str("true") } else { buf#.push_str("false") }
    }
}

// Append one complete RFC 8259 JSON string literal.  Bytes below U+0020 must
// always be escaped, including control bytes without a short escape spelling.
pub fn write_escaped_json_string(s: str, buf#: string) {
    buf#.push_str("\"")
    auto i# = 0:usize
    loop i < s.len() {
        auto c = s.byte_at(i)
        if c == 34 { buf#.push_str("\\\"") }      // '"'
        else if c == 92 { buf#.push_str("\\\\") } // '\'
        else if c == 8 { buf#.push_str("\\b") }
        else if c == 12 { buf#.push_str("\\f") }
        else if c == 10 { buf#.push_str("\\n") }
        else if c == 13 { buf#.push_str("\\r") }
        else if c == 9 { buf#.push_str("\\t") }
        else if c < 32 {
            auto byte = c as u8
            auto high = byte >> 4:u8
            auto low = byte & 15:u8
            buf#.push_str("\\u00")
            if high < 10:u8 { buf#.push_byte_raw(48:u8 + high) }
            else { buf#.push_byte_raw(87:u8 + high) }
            if low < 10:u8 { buf#.push_byte_raw(48:u8 + low) }
            else { buf#.push_byte_raw(87:u8 + low) }
        }
        else { buf#.push_char(c as char) }
        i = i + 1
    }
    buf#.push_str("\"")
}

impl str@ToJson {
    pub fn write_json(self, buf#: string) {
        write_escaped_json_string(self, buf#)
    }
}

impl string@ToJson {
    pub fn write_json(self, buf#: string) {
        write_escaped_json_string(self.as_view(), buf#)
    }
}

// Reflection-based serializer for structural Shapes
pub fn serialize_shape<'T>('obj: T, buf#: string) {
    buf#.push_str("{")
    auto first# = true
    for auto f in reflect<'T>().fields {
        if !first { buf#.push_str(",") }
        first = false
        
        buf#.push_str("\"")
        buf#.push_view(f.name)
        buf#.push_str("\":")
        
        f.get('obj).write_json(buf#)
    }
    buf#.push_str("}")
}

impl<'T: @ToJson> Vec<'T>@ToJson {
    pub fn write_json(self, buf#: string) {
        buf#.push_str("[")
        auto first# = true
        auto i# = 0:usize
        loop i < self.len() {
            if !first { buf#.push_str(",") }
            first = false
            self.borrow(i).write_json(buf#)
            i = i + 1
        }
        buf#.push_str("]")
    }
}

impl<'K: @ToJson, 'V: @ToJson> HashMap<'K, 'V>@ToJson {
    pub fn write_json(self, buf#: string) {
        buf#.push_str("{")
        auto first# = true
        auto iter# = self.iter()
        loop true {
            auto opt = iter#.next_ref()
            if opt.is_none() { break }
            auto entry = opt.unwrap()
            
            if !first { buf#.push_str(",") }
            first = false
            
            entry.key().write_json(buf#)
            buf#.push_str(":")
            entry.val().write_json(buf#)
        }
        buf#.push_str("}")
    }
}

impl<'T: @ToJson> Option<'T>@ToJson {
    pub fn write_json(self, buf#: string) {
        match self {
            auto Option<'T>::Some(&val) => val.write_json(buf#)
            _ => {
                buf#.push_str("null")
            }
        }
    }
}

impl<'T: @ToJson, 'E: @ToJson> Result<'T, 'E>@ToJson {
    pub fn write_json(self, buf#: string) {
        buf#.push_str("{\"")
        match self {
            auto Result<'T, 'E>::Ok(&val) => {
                buf#.push_str("Ok\":")
                val.write_json(buf#)
            }
            auto Result<'T, 'E>::Err(&e) => {
                buf#.push_str("Err\":")
                e.write_json(buf#)
            }
        }
        buf#.push_str("}")
    }
}

pub fn to_json<'T: @ToJson>('obj: T) -> string {
    auto res# = string::from("")
    'obj.write_json(res#)
    return cede res
}

// --- FromJson Trait ---

pub trait @FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json
}

pub fn json_skip_whitespace(json: str) -> str <- json {
    return leaf_skip_whitespace(json)
}

fn _str_cast(s: str) -> str <- s {
    return s.clone()
}

impl i32@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto result = parse_i32_value(json)
        if result.is_err() {
            auto error = JsonRes::Err(result.unwrap_err())
            return cede error
        }
        auto parsed = result.unwrap()
        auto value = parsed.value
        self = value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl bool@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem = json_skip_whitespace(json)
        if rem.starts_with("true") {
            self = true
            auto outcome_243 = JsonRes::Ok(rem.substr(4, rem.len() - 4))
            return cede outcome_243
        } else if rem.starts_with("false") {
            self = false
            auto outcome_246 = JsonRes::Ok(rem.substr(5, rem.len() - 5))
            return cede outcome_246
        }
        auto outcome_248 = JsonRes::Err("Invalid bool")
        return cede outcome_248
    }
}

impl f64@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto result = f64::parse_value(json)
        if result.is_err() {
            auto error = JsonRes::Err(result.unwrap_err())
            return cede error
        }
        auto parsed = result.unwrap()
        self = parsed.value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl string@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto result = parse_string_value(json)
        if result.is_err() {
            auto error = JsonRes::Err(result.unwrap_err())
            return cede error
        }
        auto parsed = result.unwrap()
        auto value = cede parsed.value
        self = cede value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl str@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto result = parse_str_view(json)
        if result.is_err() {
            auto error = JsonRes::Err(result.unwrap_err())
            return cede error
        }
        auto parsed = result.unwrap()
        auto value = parsed.value
        self = value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

// Construction is factory-first. Generic mutation is restricted to values
// with complete, independent contents; borrowed values use the factory API.
impl<'T: @JsonFactory> Option<'T>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto attempt = Option<'T>::parse_value(json)
        if attempt.is_err() {
            auto error = JsonRes::Err(attempt.unwrap_err())
            return cede error
        }
        auto parsed = attempt.unwrap()
        auto 'new_value = cede parsed.value
        self = cede 'new_value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl<'T: @JsonFactory, 'E: @JsonFactory> Result<'T, 'E>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto attempt = Result<'T, 'E>::parse_value(json)
        if attempt.is_err() {
            auto error = JsonRes::Err(attempt.unwrap_err())
            return cede error
        }
        auto parsed = attempt.unwrap()
        auto 'new_value = cede parsed.value
        self = cede 'new_value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl<'K: @JsonFactory, 'V: @JsonFactory> HashMap<'K, 'V>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto attempt = HashMap<'K, 'V>::parse_value(json)
        if attempt.is_err() {
            auto error = JsonRes::Err(attempt.unwrap_err())
            return cede error
        }
        auto parsed = attempt.unwrap()
        auto 'new_value = cede parsed.value
        self = cede 'new_value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

impl<'T: @JsonFactory> Vec<'T>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto attempt = Vec<'T>::parse_value(json)
        if attempt.is_err() {
            auto error = JsonRes::Err(attempt.unwrap_err())
            return cede error
        }
        auto parsed = attempt.unwrap()
        auto 'new_value = cede parsed.value
        self = cede 'new_value
        auto status = JsonRes::Ok(parsed.rest)
        return cede status
    }
}

// The initialized field is used only for type inference; it is never consumed
// or passed to a parser as an uninitialized construction target.
fn parse_field_value<'F: @JsonFactory>('hint: F, json: str) -> Result<Parsed<'F>, str> <- json {
    auto result = F::parse_value(json)
    return cede result
}

pub fn deserialize_nested_shape<'T>('obj#: T, json_str: str) -> JsonRes <- json_str {
    auto res# = json_skip_whitespace(json_str)
    if res.len() == 0 || res.byte_at(0) != 123 {
        auto outcome_637 = JsonRes::Err("Expected {")
        return cede outcome_637
    }
    res = res.substr(1, res.len() - 1)
    
    auto first# = true
    loop true {
        res = json_skip_whitespace(res)
        if res.len() > 0 && res.byte_at(0) == 125 { res = res.substr(1, res.len() - 1); break }
        if !first {
            if res.len() == 0 || res.byte_at(0) != 44 {
                auto outcome_645 = JsonRes::Err("Expected ,")
                return cede outcome_645
            }
            res = res.substr(1, res.len() - 1)
        }
        first = false
        res = json_skip_whitespace(res)
        auto key_result = parse_str_view(res)!
        auto key_view = key_result.value
        res = key_result.rest
        res = json_skip_whitespace(res)
        if res.len() == 0 || res.byte_at(0) != 58 {
            auto outcome_653 = JsonRes::Err("Expected :")
            return cede outcome_653
        }
        res = res.substr(1, res.len() - 1)
        auto found# = false
        for auto f in reflect<'T>().fields {
            if key_view.equals(f.name) {
                found = true
                auto field_result = parse_field_value(f.get('obj), res)!
                res = field_result.rest
                auto 'value = cede field_result.value
                f.set('obj, cede 'value)
                continue
            }
        }
        if !found { res = json_skip_value(res)! }
    }
    auto outcome_667 = JsonRes::Ok(res)
    return cede outcome_667
}

pub fn deserialize_shape<'T>(json_str: str) -> Result<'T, str> <- json_str {
    auto res# = json_skip_whitespace(json_str)
    if res.len() == 0 || res.byte_at(0) != 123 {
        auto outcome = Result<'T, str>::Err("Expected {")
        return cede outcome
    }
    res = res.substr(1, res.len() - 1)
    
    auto 'obj# = 'T(..)
    auto first# = true
    loop true {
        res = json_skip_whitespace(res)
        if res.len() > 0 && res.byte_at(0) == 125 { res = res.substr(1, res.len() - 1); break }
        if !first {
            if res.len() == 0 || res.byte_at(0) != 44 {
                auto outcome = Result<'T, str>::Err("Expected ,")
                return cede outcome
            }
            res = res.substr(1, res.len() - 1)
        }
        first = false
        res = json_skip_whitespace(res)
        auto key_result = parse_str_view(res)!
        auto key_view = key_result.value
        res = key_result.rest
        res = json_skip_whitespace(res)
        if res.len() == 0 || res.byte_at(0) != 58 {
            auto outcome = Result<'T, str>::Err("Expected :")
            return cede outcome
        }
        res = res.substr(1, res.len() - 1)
        auto found# = false
        for auto f in reflect<'T>().fields {
            if key_view.equals(f.name) {
                found = true
                auto field_result = parse_field_value(f.get('obj), res)!
                res = field_result.rest
                auto 'value = cede field_result.value
                f.set('obj, cede 'value)
                continue
            }
        }
        if !found { res = json_skip_value(res)! }
    }
    auto outcome = Result<'T, str>::Ok(cede 'obj)
    return cede outcome
}

impl JsonNode@JsonFactory {
    pub fn parse_value(json: str) -> Result<Parsed<JsonNode>, str> <- json {
        auto result = parse_node_value(json, 0)
        return cede result
    }
}
impl JsonNode@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto result = self#.parse_json_internal(json, 0)
        return cede result
    }
}
impl JsonNode {
    pub fn parse_json_internal(self#, json: str, depth: usize) -> JsonRes <- json {
        auto attempt = parse_node_value(json, depth)
        if attempt.is_err() {
            auto error = JsonRes::Err(attempt.unwrap_err())
            return cede error
        }
        auto parsed = attempt.unwrap()
        auto value = cede parsed.value
        self = cede value
        auto result = JsonRes::Ok(parsed.rest)
        return cede result
    }
}

// A recursive parse owns its completed children until the final delimiter has
// been validated. No partial JsonNode is installed in a caller's receiver.
fn parse_node_value(json: str, depth: usize) -> Result<Parsed<JsonNode>, str> <- json {
    if depth > 128 {
        auto error = Result<Parsed<JsonNode>, str>::Err("Depth limit exceeded")
        return cede error
    }
    auto rem# = json_skip_whitespace(json)
    if rem.len() == 0 {
        auto error = Result<Parsed<JsonNode>, str>::Err("Unexpected EOF")
        return cede error
    }
    auto c = rem.byte_at(0)
    if c == 123 {
        auto values# = HashMap<string, JsonNode>::new()
        rem = rem.substr(1, rem.len() - 1)
        auto first# = true
        loop true {
            rem = json_skip_whitespace(rem)
            if rem.len() > 0 && rem.byte_at(0) == 125 {
                rem = rem.substr(1, rem.len() - 1)
                break
            }
            if !first {
                if rem.len() == 0 || rem.byte_at(0) != 44 {
                    auto error = Result<Parsed<JsonNode>, str>::Err("Expected ,")
                    return cede error
                }
                rem = json_skip_whitespace(rem.substr(1, rem.len() - 1))
            }
            first = false
            auto key_result = parse_string_value(rem)
            if key_result.is_err() {
                auto error = Result<Parsed<JsonNode>, str>::Err(key_result.unwrap_err())
                return cede error
            }
            auto key = key_result.unwrap()
            rem = json_skip_whitespace(key.rest)
            if rem.len() == 0 || rem.byte_at(0) != 58 {
                auto error = Result<Parsed<JsonNode>, str>::Err("Expected :")
                return cede error
            }
            auto child_result = parse_node_value(rem.substr(1, rem.len() - 1), depth + 1)
            if child_result.is_err() {
                auto error = Result<Parsed<JsonNode>, str>::Err(child_result.unwrap_err())
                return cede error
            }
            auto child = child_result.unwrap()
            auto name = cede key.value
            auto value = cede child.value
            values#.insert(cede name, cede value)
            rem = child.rest
        }
        auto value = JsonNode::ObjectNode(cede values)
        auto parsed = Parsed<JsonNode>(value = cede value, rest = rem)
        auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
        return cede result
    }
    if c == 91 {
        auto values# = Vec<JsonNode>::new()
        rem = rem.substr(1, rem.len() - 1)
        auto first# = true
        loop true {
            rem = json_skip_whitespace(rem)
            if rem.len() > 0 && rem.byte_at(0) == 93 {
                rem = rem.substr(1, rem.len() - 1)
                break
            }
            if !first {
                if rem.len() == 0 || rem.byte_at(0) != 44 {
                    auto error = Result<Parsed<JsonNode>, str>::Err("Expected ,")
                    return cede error
                }
                rem = json_skip_whitespace(rem.substr(1, rem.len() - 1))
            }
            first = false
            auto child_result = parse_node_value(rem, depth + 1)
            if child_result.is_err() {
                auto error = Result<Parsed<JsonNode>, str>::Err(child_result.unwrap_err())
                return cede error
            }
            auto child = child_result.unwrap()
            auto value = cede child.value
            values#.push(cede value)
            rem = child.rest
        }
        auto value = JsonNode::ArrayNode(cede values)
        auto parsed = Parsed<JsonNode>(value = cede value, rest = rem)
        auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
        return cede result
    }
    if c == 34 {
        auto leaf = parse_string_value(rem)
        if leaf.is_err() {
            auto error = Result<Parsed<JsonNode>, str>::Err(leaf.unwrap_err())
            return cede error
        }
        auto child = leaf.unwrap()
        auto text = cede child.value
        auto value = JsonNode::StrNode(cede text)
        auto parsed = Parsed<JsonNode>(value = cede value, rest = child.rest)
        auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
        return cede result
    }
    if rem.starts_with("true") || rem.starts_with("false") {
        auto leaf = bool::parse_value(rem)
        if leaf.is_err() {
            auto error = Result<Parsed<JsonNode>, str>::Err(leaf.unwrap_err())
            return cede error
        }
        auto child = leaf.unwrap()
        auto value = JsonNode::BoolNode(child.value)
        auto parsed = Parsed<JsonNode>(value = cede value, rest = child.rest)
        auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
        return cede result
    }
    if rem.starts_with("null") {
        auto value = JsonNode::NullNode(0)
        auto parsed = Parsed<JsonNode>(value = cede value, rest = rem.substr(4, rem.len() - 4))
        auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
        return cede result
    }
    auto leaf = f64::parse_value(rem)
    if leaf.is_err() {
        auto error = Result<Parsed<JsonNode>, str>::Err(leaf.unwrap_err())
        return cede error
    }
    auto child = leaf.unwrap()
    auto value = JsonNode::NumNode(child.value)
    auto parsed = Parsed<JsonNode>(value = cede value, rest = child.rest)
    auto result = Result<Parsed<JsonNode>, str>::Ok(cede parsed)
    return cede result
}
