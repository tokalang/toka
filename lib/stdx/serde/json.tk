// lib/stdx/serde/json.tk
// Standard Serialization for JSON using Toka Comptime Reflection

import core/str::{str, str}
import std/hashmap::{HashMap}
import std/vec::{Vec}
import std/math
import sys/libc::{libc_memset}
import core/comptime::{reflect}

// Result type for parsing: Ok(remaining_json) or Err(error_message)
pub alias JsonRes = Result<str, str>

pub shape JsonNode (
    NullNode(i32) = 0 |
    BoolNode(bool) = 1 |
    NumNode(f64) = 2 |
    StrNode(string) = 3 |
    ArrayNode(Vec<JsonNode>) = 4 |
    ObjectNode(HashMap<string, JsonNode>) = 5
)

// --- ToJson Trait ---

pub trait @ToJson {
    // Append JSON representation to the buffer and return the updated buffer
    pub fn write_json(self, buf#: string) -> string
}

impl<'T: @ToJson> &'T@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        // [Compiler Magic] This will call the write_json on the soul
        return self.write_json(buf)
    }
}

impl i32@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        auto tmp = string::from_int(self)
        buf#.push_view(tmp.as_view())
        return buf
    }
}

impl i64@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        auto tmp = string::from_i64(self)
        buf#.push_view(tmp.as_view())
        return buf
    }
}

impl f64@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        auto tmp = string::from_f64(self)
        buf#.push_view(tmp.as_view())
        return buf
    }
}

impl bool@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        if self { buf#.push_str("true") } else { buf#.push_str("false") }
        return buf
    }
}

// Append one complete RFC 8259 JSON string literal.  Bytes below U+0020 must
// always be escaped, including control bytes without a short escape spelling.
pub fn write_escaped_json_string(s: str, buf#: string) {
    buf#.push_str("\"")
    auto i# = 0:usize
    loop i < s.len() {
        auto c = s.byte_at(i)
        if c == 34 { buf#.push_str("\\\"") }      // '"'
        else if c == 92 { buf#.push_str("\\\\") } // '\'
        else if c == 8 { buf#.push_str("\\b") }
        else if c == 12 { buf#.push_str("\\f") }
        else if c == 10 { buf#.push_str("\\n") }
        else if c == 13 { buf#.push_str("\\r") }
        else if c == 9 { buf#.push_str("\\t") }
        else if c < 32 {
            auto byte = c as u8
            auto high = byte >> 4:u8
            auto low = byte & 15:u8
            buf#.push_str("\\u00")
            if high < 10:u8 { buf#.push_byte_raw(48:u8 + high) }
            else { buf#.push_byte_raw(87:u8 + high) }
            if low < 10:u8 { buf#.push_byte_raw(48:u8 + low) }
            else { buf#.push_byte_raw(87:u8 + low) }
        }
        else { buf#.push_char(c as char) }
        i = i + 1
    }
    buf#.push_str("\"")
}

impl str@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        write_escaped_json_string(self, buf)
        return buf
    }
}

impl string@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        write_escaped_json_string(self.as_view(), buf)
        return buf
    }
}

// Reflection-based serializer for structural Shapes
pub fn serialize_shape<'T>('obj: T, buf#: string) -> string {
    buf#.push_str("{")
    auto first# = true
    for auto f in reflect<'T>().fields {
        if !first { buf#.push_str(",") }
        first = false
        
        buf#.push_str("\"")
        buf#.push_view(f.name)
        buf#.push_str("\":")
        
        buf = f.get('obj).write_json(buf)
    }
    buf#.push_str("}")
    return buf
}

impl<'T: @ToJson> Vec<'T>@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        buf#.push_str("[")
        auto first# = true
        auto i# = 0:usize
        loop i < self.len() {
            if !first { buf#.push_str(",") }
            first = false
            buf = self.at(i).write_json(buf)
            i = i + 1
        }
        buf#.push_str("]")
        return buf
    }
}

impl<'K: @ToJson, 'V: @ToJson> HashMap<'K, 'V>@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        buf#.push_str("{")
        auto first# = true
        auto iter# = self.iter()
        loop true {
            auto opt = iter#.next_ref()
            if opt.is_none() { break }
            auto entry = opt.unwrap()
            
            if !first { buf#.push_str(",") }
            first = false
            
            buf = entry.key().write_json(buf)
            buf#.push_str(":")
            buf = entry.val().write_json(buf)
        }
        buf#.push_str("}")
        return buf
    }
}

impl<'T: @ToJson> Option<'T>@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        match self {
            auto Option<'T>::Some(&val) => return val.write_json(buf)
            _ => {
                buf#.push_str("null")
                return buf
            }
        }
    }
}

impl<'T: @ToJson, 'E: @ToJson> Result<'T, 'E>@ToJson {
    pub fn write_json(self, buf#: string) -> string {
        buf#.push_str("{\"")
        match self {
            auto Result<'T, 'E>::Ok(&val) => {
                buf#.push_str("Ok\":")
                buf = val.write_json(buf)
            }
            auto Result<'T, 'E>::Err(&e) => {
                buf#.push_str("Err\":")
                buf = e.write_json(buf)
            }
        }
        buf#.push_str("}")
        return buf
    }
}

pub fn to_json<'T: @ToJson>('obj: T) -> string {
    auto res# = string::from("")
    res = 'obj.write_json(res)
    return res
}

// --- FromJson Trait ---

pub trait @FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json
}

pub fn json_skip_whitespace(json: str) -> str <- json {
    auto res# = json
    loop res.len() > 0 {
        auto c = res.byte_at(0)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            res = res.substr(1, res.len() - 1)
        } else { break }
    }
    return res
}

fn _str_cast(s: str) -> str <- s {
    return s.clone()
}

impl i32@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem# = json_skip_whitespace(json)
        if rem.len() == 0 { return JsonRes::Err("EOF") }
        auto i# = 0:usize
        auto neg# = false
        if rem.byte_at(0) == 45 { neg = true; i = 1 }
        auto val# = 0:i32
        auto found# = false
        loop i < rem.len() {
            auto c = rem.byte_at(i)
            if c >= 48 && c <= 57 {
                val = val * 10 + ((c - 48) as i32)
                found = true
                i = i + 1
            } else { break }
        }
        if !found { return JsonRes::Err("Invalid i32") }
        if neg { val = 0 - val }
        self = val
        return JsonRes::Ok(rem.substr(i, rem.len() - i))
    }
}

impl bool@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem = json_skip_whitespace(json)
        if rem.starts_with("true") {
            self = true
            return JsonRes::Ok(rem.substr(4, rem.len() - 4))
        } else if rem.starts_with("false") {
            self = false
            return JsonRes::Ok(rem.substr(5, rem.len() - 5))
        }
        return JsonRes::Err("Invalid bool")
    }
}

pub fn json_skip_value(json_in: str) -> JsonRes <- json_in {
    return _json_skip_value(json_in, 0)
}

fn _json_skip_value(json_in: str, depth: usize) -> JsonRes <- json_in {
    if depth > 128 { return JsonRes::Err("Depth limit exceeded") }
    auto json# = json_skip_whitespace(json_in)
    if json.len() == 0 { return JsonRes::Err("Unexpected EOF") }
    
    auto c = json.byte_at(0)
    if c == 123 { // '{'
        json = json.substr(1, json.len() - 1)
        loop json.len() > 0 && json.byte_at(0) != 125 {
            json = json_skip_whitespace(json)
            if json.len() > 0 && json.byte_at(0) == 125 { break }
            json = _json_skip_value(json, depth + 1)!
            json = json_skip_whitespace(json)
            if json.len() > 0 && json.byte_at(0) == 58 { json = json.substr(1, json.len() - 1) }
            json = _json_skip_value(json, depth + 1)!
            json = json_skip_whitespace(json)
            if json.len() > 0 && json.byte_at(0) == 44 { json = json.substr(1, json.len() - 1) }
        }
        if json.len() > 0 { json = json.substr(1, json.len() - 1) }
        return JsonRes::Ok(json)
    } else if c == 91 { // '['
        json = json.substr(1, json.len() - 1)
        loop json.len() > 0 && json.byte_at(0) != 93 {
            json = json_skip_whitespace(json)
            if json.len() > 0 && json.byte_at(0) == 93 { break }
            json = _json_skip_value(json, depth + 1)!
            json = json_skip_whitespace(json)
            if json.len() > 0 && json.byte_at(0) == 44 { json = json.substr(1, json.len() - 1) }
        }
        if json.len() > 0 { json = json.substr(1, json.len() - 1) }
        return JsonRes::Ok(json)
    } else if c == 34 { // '"'
        auto i# = 1:usize
        loop i < json.len() {
            auto ch = json.byte_at(i)
            if ch == 34 { return JsonRes::Ok(json.substr(i + 1, json.len() - i - 1)) }
            if ch == 92 { i += 1 }
            i += 1
        }
        return JsonRes::Err("Unterminated string")
    } else {
        auto i# = 0:usize
        loop i < json.len() {
            auto b = json.byte_at(i)
            if b == 32 || b == 10 || b == 13 || b == 9 || b == 44 || b == 125 || b == 93 { break }
            i += 1
        }
        return JsonRes::Ok(json.substr(i, json.len() - i))
    }
}

impl f64@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem = json_skip_whitespace(json)
        auto skip_res = json_skip_value(rem)!
        auto val_str = rem.substr(0, rem.len() - skip_res.len())
        
        auto i# = 0:usize
        auto n = val_str.len()
        auto result# = 0.0:f64
        auto sign# = 1.0:f64
        
        if i < n && val_str.byte_at(i) == 45 { sign = -1.0; i += 1 }
        else if i < n && val_str.byte_at(i) == 43 { i += 1 }
        
        loop i < n && val_str.byte_at(i) >= 48 && val_str.byte_at(i) <= 57 {
            result = result * 10.0 + ((val_str.byte_at(i) - 48) as f64)
            i += 1
        }
        if i < n && val_str.byte_at(i) == 46 { // '.'
            i += 1
            auto frac# = 0.1:f64
            loop i < n && val_str.byte_at(i) >= 48 && val_str.byte_at(i) <= 57 {
                result = result + ((val_str.byte_at(i) - 48) as f64) * frac
                frac = frac * 0.1
                i += 1
            }
        }
        if i < n && (val_str.byte_at(i) == 101 || val_str.byte_at(i) == 69) {
            i += 1
            auto exp_sign# = 1.0:f64
            if i < n && val_str.byte_at(i) == 45 { exp_sign = -1.0; i += 1 }
            else if i < n && val_str.byte_at(i) == 43 { i += 1 }
            auto exp# = 0.0:f64
            loop i < n && val_str.byte_at(i) >= 48 && val_str.byte_at(i) <= 57 {
                exp = exp * 10.0 + ((val_str.byte_at(i) - 48) as f64)
                i += 1
            }
            if exp != 0.0 { result = result * math::pow(10.0, exp * exp_sign) }
        }
        self = sign * result
        return JsonRes::Ok(skip_res)
    }
}

fn json_parse_hex4(rem: str, start: usize) -> u32 {
    auto cp# = 0:u32
    auto j# = 0:usize
    loop j < 4 {
        auto c = rem.byte_at(start + j)
        auto val# = 0:u32
        if c >= 48 && c <= 57 { val = (c - 48) as u32 }
        else if c >= 65 && c <= 70 { val = ((c - 65) + 10) as u32 }
        else if c >= 97 && c <= 102 { val = ((c - 97) + 10) as u32 }
        cp = (cp * 16:u32) + val
        j += 1
    }
    return cp
}

fn json_push_utf8(str#: string, cp: u32) {
    if cp <= 127:u32 { str#.push_char(cp as char) }
    else if cp <= 2047:u32 {
        str#.push_char((192:u32 + (cp / 64:u32)) as char)
        str#.push_char((128:u32 + (cp % 64:u32)) as char)
    } else if cp <= 65535:u32 {
        str#.push_char((224:u32 + (cp / 4096:u32)) as char)
        str#.push_char((128:u32 + ((cp / 64:u32) % 64:u32)) as char)
        str#.push_char((128:u32 + (cp % 64:u32)) as char)
    } else {
        str#.push_char((240:u32 + (cp / 262144:u32)) as char)
        str#.push_char((128:u32 + ((cp / 4096:u32) % 64:u32)) as char)
        str#.push_char((128:u32 + ((cp / 64:u32) % 64:u32)) as char)
        str#.push_char((128:u32 + (cp % 64:u32)) as char)
    }
}

impl string@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem = json_skip_whitespace(json)
        if rem.len() == 0 || rem.byte_at(0) != 34 { return JsonRes::Err("Expected string") }
        auto i# = 1:usize
        auto closed# = false
        loop i < rem.len() {
            auto c = rem.byte_at(i)
            if c == 34 { closed = true; break }
            if c == 92 { i += 1 }
            i += 1
        }
        if !closed { return JsonRes::Err("Unterminated string") }
        auto new_str# = string::from("")
        auto j# = 1:usize
        loop j < i {
            auto c = rem.byte_at(j)
            if c == 92 {
                j += 1
                auto ec = rem.byte_at(j)
                if ec == 34 { new_str#.push_char(34 as char) }
                else if ec == 92 { new_str#.push_char(92 as char) }
                else if ec == 47 { new_str#.push_char(47 as char) }
                else if ec == 98 { new_str#.push_char(8 as char) }
                else if ec == 102 { new_str#.push_char(12 as char) }
                else if ec == 110 { new_str#.push_char(10 as char) }
                else if ec == 114 { new_str#.push_char(13 as char) }
                else if ec == 116 { new_str#.push_char(9 as char) }
                else if ec == 117 {
                    auto cp# = json_parse_hex4(rem, j + 1)
                    j += 4
                    if cp >= 55296:u32 && cp <= 56319:u32 {
                        if j + 2 < i && rem.byte_at(j+1) == 92 && rem.byte_at(j+2) == 117 {
                            auto low_cp = json_parse_hex4(rem, j + 3)
                            cp = ((cp - 55296:u32) * 1024:u32) + (low_cp - 56320:u32) + 65536:u32
                            j += 6
                        }
                    }
                    json_push_utf8(new_str, cp)
                } else { new_str#.push_char(ec as char) }
            } else { new_str#.push_char(c as char) }
            j += 1
        }
        self = cede new_str
        return JsonRes::Ok(rem.substr(i + 1, rem.len() - i - 1))
    }
}

impl str@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem = json_skip_whitespace(json)
        if rem.len() == 0 || rem.byte_at(0) != 34 { return JsonRes::Err("Expected string") }
        auto i# = 1:usize
        loop i < rem.len() {
            auto c = rem.byte_at(i)
            if c == 34 {
                self = rem.substr(1, i - 1)
                return JsonRes::Ok(rem.substr(i + 1, rem.len() - i - 1))
            }
            if c == 92 { i += 1 }
            i += 1
        }
        return JsonRes::Err("Unterminated string")
    }
}

impl<'T: @FromJson> Option<'T>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem# = json_skip_whitespace(json)
        if rem.starts_with("null") {
            self = Option<'T>::None
            return JsonRes::Ok(rem.substr(4, rem.len() - 4))
        }
        
        unsafe {
            auto ^buf = new [1]Uninit<'T>()
            libc_memset(*buf as *void, 0, sizeof('T))
            auto *'val# = (*buf + 0) as *'T:*T
            rem = 'val#.parse_json(rem)!
            self = Option<'T>::Some(cede 'val)
            return JsonRes::Ok(rem)
        }
    }
}

impl<'T: @FromJson, 'E: @FromJson> Result<'T, 'E>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto rem# = json_skip_whitespace(json)
        if rem.len() == 0 || rem.byte_at(0) != 123 { return JsonRes::Err("Expected { for Result") }
        rem = rem.substr(1, rem.len() - 1)
        rem = json_skip_whitespace(rem)
        
        auto key# = ""
        rem = key#.parse_json(rem)!
        rem = json_skip_whitespace(rem)
        if rem.len() == 0 || rem.byte_at(0) != 58 { return JsonRes::Err("Expected : for Result") }
        rem = rem.substr(1, rem.len() - 1)
        
        unsafe {
            if key.equals("Ok") {
                auto ^buf = new [1]Uninit<'T>()
                libc_memset(*buf as *void, 0, sizeof('T))
                auto *'val# = (*buf + 0) as *'T:*T
                rem = 'val#.parse_json(rem)!
                self = Result<'T, 'E>::Ok(cede 'val)
            } else if key.equals("Err") {
                auto ^buf = new [1]Uninit<'E>()
                libc_memset(*buf as *void, 0, sizeof('E))
                auto *'e# = (*buf + 0) as *'E:*E
                rem = 'e#.parse_json(rem)!
                self = Result<'T, 'E>::Err(cede 'e)
            } else {
                return JsonRes::Err("Invalid key for Result")
            }
        }
        
        rem = json_skip_whitespace(rem)
        if rem.len() == 0 || rem.byte_at(0) != 125 { return JsonRes::Err("Expected } for Result") }
        return JsonRes::Ok(rem.substr(1, rem.len() - 1))
    }
}

impl<'K: @FromJson, 'V: @FromJson> HashMap<'K, 'V>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto res# = json_skip_whitespace(json)
        if res.len() == 0 || res.byte_at(0) != 123 { return JsonRes::Err("Expected { for HashMap") }
        res = res.substr(1, res.len() - 1)
        self = HashMap<'K, 'V>::new()
        auto first# = true
        loop true {
            res = json_skip_whitespace(res)
            if res.len() > 0 && res.byte_at(0) == 125 { res = res.substr(1, res.len() - 1); break }
            if !first {
                if res.len() == 0 || res.byte_at(0) != 44 { return JsonRes::Err("Expected ,") }
                res = res.substr(1, res.len() - 1)
                res = json_skip_whitespace(res)
            }
            first = false
            
            unsafe {
                auto ^k_buf = new [1]Uninit<'K>()
                libc_memset(*k_buf as *void, 0, sizeof('K))
                auto *'key# = (*k_buf + 0) as *'K:*K
                res = 'key#.parse_json(res)!
                
                res = json_skip_whitespace(res)
                if res.len() == 0 || res.byte_at(0) != 58 { return JsonRes::Err("Expected :") }
                res = res.substr(1, res.len() - 1)
                
                auto ^v_buf = new [1]Uninit<'V>()
                libc_memset(*v_buf as *void, 0, sizeof('V))
                auto *'val# = (*v_buf + 0) as *'V:*V
                res = 'val#.parse_json(res)!
                
                self#.insert(cede 'key, cede 'val)
            }
        }
        return JsonRes::Ok(res)
    }
}
impl<'T: @FromJson> Vec<'T>@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        auto res# = json_skip_whitespace(json)
        if res.len() == 0 || res.byte_at(0) != 91 { return JsonRes::Err("Expected [") }
        res = res.substr(1, res.len() - 1)
        self = Vec<'T>::new()
        auto first# = true
        loop true {
            res = json_skip_whitespace(res)
            if res.len() > 0 && res.byte_at(0) == 93 { res = res.substr(1, res.len() - 1); break }
            if !first {
                if res.len() == 0 || res.byte_at(0) != 44 { return JsonRes::Err("Expected ,") }
                res = res.substr(1, res.len() - 1)
                res = json_skip_whitespace(res)
            }
            first = false
            unsafe {
                auto ^item_buf = new [1]Uninit<'T>()
                libc_memset(*item_buf as *void, 0, sizeof('T))
                auto *'item# = (*item_buf + 0) as *'T:*T
                res = 'item#.parse_json(res)!
                self#.push(cede 'item)
            }
        }
        return JsonRes::Ok(res)
    }
}

pub fn deserialize_nested_shape<'T>('obj#: T, json_str: str) -> JsonRes <- json_str {
    auto res# = json_skip_whitespace(json_str)
    if res.len() == 0 || res.byte_at(0) != 123 { return JsonRes::Err("Expected {") }
    res = res.substr(1, res.len() - 1)
    
    auto first# = true
    loop true {
        res = json_skip_whitespace(res)
        if res.len() > 0 && res.byte_at(0) == 125 { res = res.substr(1, res.len() - 1); break }
        if !first {
            if res.len() == 0 || res.byte_at(0) != 44 { return JsonRes::Err("Expected ,") }
            res = res.substr(1, res.len() - 1)
        }
        first = false
        res = json_skip_whitespace(res)
        auto key_view# = ""
        res = key_view#.parse_json(res)!
        res = json_skip_whitespace(res)
        if res.len() == 0 || res.byte_at(0) != 58 { return JsonRes::Err("Expected :") }
        res = res.substr(1, res.len() - 1)
        auto found# = false
        for auto f in reflect<'T>().fields {
            if key_view.equals(f.name) {
                found = true
                auto 'val# = f.get('obj)
                res = 'val#.parse_json(res)!
                f.set('obj, cede 'val)
                continue
            }
        }
        if !found { res = json_skip_value(res)! }
    }
    return JsonRes::Ok(res)
}

pub fn deserialize_shape<'T>(json_str: str) -> Result<'T, str> {
    auto res# = json_skip_whitespace(json_str)
    if res.len() == 0 || res.byte_at(0) != 123 { return Result<'T, str>::Err("Expected {") }
    res = res.substr(1, res.len() - 1)
    
    auto 'obj# = 'T(..)
    auto first# = true
    loop true {
        res = json_skip_whitespace(res)
        if res.len() > 0 && res.byte_at(0) == 125 { res = res.substr(1, res.len() - 1); break }
        if !first {
            if res.len() == 0 || res.byte_at(0) != 44 { return Result<'T, str>::Err("Expected ,") }
            res = res.substr(1, res.len() - 1)
        }
        first = false
        res = json_skip_whitespace(res)
        auto key_view# = ""
        res = key_view#.parse_json(res)!
        res = json_skip_whitespace(res)
        if res.len() == 0 || res.byte_at(0) != 58 { return Result<'T, str>::Err("Expected :") }
        res = res.substr(1, res.len() - 1)
        auto found# = false
        for auto f in reflect<'T>().fields {
            if key_view.equals(f.name) {
                found = true
                auto 'val# = f.get('obj)
                res = 'val#.parse_json(res)!
                f.set('obj, cede 'val)
                continue
            }
        }
        if !found { res = json_skip_value(res)! }
    }
    return Result<'T, str>::Ok(cede 'obj)
}

impl JsonNode@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        return self#.parse_json_internal(json, 0)
    }
}

impl JsonNode {
    pub fn parse_json_internal(self#, json_in: str, depth: usize) -> JsonRes <- json_in {
        if depth > 128 { return JsonRes::Err("Depth limit exceeded") }
        auto rem# = json_skip_whitespace(json_in)
        if rem.len() == 0 { return JsonRes::Err("Unexpected EOF") }
        
        auto c = rem.byte_at(0)
        if c == 123 { // '{'
            auto map# = HashMap<string, JsonNode>::new()
            rem = rem.substr(1, rem.len() - 1)
            auto first# = true
            loop true {
                rem = json_skip_whitespace(rem)
                if rem.len() > 0 && rem.byte_at(0) == 125 { rem = rem.substr(1, rem.len() - 1); break }
                if !first {
                    if rem.len() == 0 || rem.byte_at(0) != 44 { return JsonRes::Err("Expected ,") }
                    rem = rem.substr(1, rem.len() - 1)
                    rem = json_skip_whitespace(rem)
                }
                first = false
                auto key# = string::from("")
                rem = key#.parse_json(rem)!
                rem = json_skip_whitespace(rem)
                if rem.len() == 0 || rem.byte_at(0) != 58 { return JsonRes::Err("Expected :") }
                rem = rem.substr(1, rem.len() - 1)
                auto val# = JsonNode::NullNode(0):JsonNode
                rem = val#.parse_json_internal(rem, depth + 1)!
                map#.insert(cede key, cede val)
            }
            self = JsonNode::ObjectNode(cede map)
            return JsonRes::Ok(rem)
        } else if c == 91 { // '['
            auto arr# = Vec<JsonNode>::new()
            rem = rem.substr(1, rem.len() - 1)
            auto first# = true
            loop true {
                rem = json_skip_whitespace(rem)
                if rem.len() > 0 && rem.byte_at(0) == 93 { rem = rem.substr(1, rem.len() - 1); break }
                if !first {
                    if rem.len() == 0 || rem.byte_at(0) != 44 { return JsonRes::Err("Expected ,") }
                    rem = rem.substr(1, rem.len() - 1)
                    rem = json_skip_whitespace(rem)
                }
                first = false
                auto val# = JsonNode::NullNode(0):JsonNode
                rem = val#.parse_json_internal(rem, depth + 1)!
                arr#.push(cede val)
            }
            self = JsonNode::ArrayNode(cede arr)
            return JsonRes::Ok(rem)
        } else if c == 34 { // '"'
            auto s# = string::from("")
            rem = s#.parse_json(rem)!
            self = JsonNode::StrNode(cede s)
            return JsonRes::Ok(rem)
        } else if rem.starts_with("true") || rem.starts_with("false") {
            auto b# = false
            rem = b#.parse_json(rem)!
            self = JsonNode::BoolNode(b)
            return JsonRes::Ok(rem)
        } else if rem.starts_with("null") {
            self = JsonNode::NullNode(0)
            return JsonRes::Ok(rem.substr(4, rem.len() - 4))
        } else {
            auto f# = 0.0
            rem = f#.parse_json(rem)!
            self = JsonNode::NumNode(f)
            return JsonRes::Ok(rem)
        }
    }
}
