// Internal concrete JSON construction. No JsonNode or generic parser capability.
// Existing mutation entry points in json.tk delegate to these factories.
pub shape Parsed<'T>('value: T, rest: str)

fn hex(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32 }
    if c >= 65 && c <= 70 { return (c - 55) as i32 }
    if c >= 97 && c <= 102 { return (c - 87) as i32 }
    return -1
}
fn unicode4(input: str, start: usize) -> i32 {
    if start > input.len() || input.len() - start < 4 { return -1 }
    auto value# = 0:i32
    auto i# = 0:usize
    loop i < 4 {
        auto digit = hex(input.byte_at(start + i) as u8)
        if digit < 0 { return -1 }
        value = value * 16 + digit
        i += 1
    }
    return value
}
// Validate before using the shared decoder, including surrogate pairing and UTF-8.
pub fn json_string_valid(input: str, start: usize) -> bool {
    if start >= input.len() || input.byte_at(start) != 34 { return false }
    auto p# = start + 1
    loop p < input.len() {
        auto c = input.byte_at(p) as u8
        if c == 34 { return true }
        if c < 32 { return false }
        if c == 92 {
            p += 1
            if p >= input.len() { return false }
            auto e = input.byte_at(p)
            if e == 117 {
                auto cp = unicode4(input, p + 1)
                if cp < 0 || (cp >= 56320 && cp <= 57343) { return false }
                p += 5
                if cp >= 55296 && cp <= 56319 {
                    if input.len() - p < 6 || input.byte_at(p) != 92 || input.byte_at(p + 1) != 117 { return false }
                    auto low = unicode4(input, p + 2)
                    if low < 56320 || low > 57343 { return false }
                    p += 6
                }
            } else {
                if e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116 { return false }
                p += 1
            }
        } else if c >= 128 {
            auto width# = 0:usize
            if c >= 194 && c <= 223 { width = 2 }
            else if c >= 224 && c <= 239 { width = 3 }
            else if c >= 240 && c <= 244 { width = 4 }
            else { return false }
            if input.len() - p < width { return false }
            auto second = input.byte_at(p + 1) as u8
            if c == 224 && second < 160 { return false }
            if c == 237 && second >= 160 { return false }
            if c == 240 && second < 144 { return false }
            if c == 244 && second >= 144 { return false }
            auto k# = 1:usize
            loop k < width {
                auto byte = input.byte_at(p + k) as u8
                if byte < 128 || byte > 191 { return false }
                k += 1
            }
            p += width
        } else { p += 1 }
    }
    return false
}

pub fn leaf_skip_whitespace(json: str) -> str <- json {
    auto res# = json
    loop res.len() > 0 {
        auto c = res.byte_at(0)
        if c == 32 || c == 9 || c == 13 || c == 10 {
            res = res.substr(1, res.len() - 1)
        } else { break }
    }
    return cede res
}

// 0: no opening quote; len: unterminated; otherwise the closing quote index.
fn scan_string_end(rem: str) -> usize {
    if rem.len() == 0 || rem.byte_at(0) != 34 {
        return 0
    }
    auto i# = 1:usize
    loop i < rem.len() {
        auto c = rem.byte_at(i)
        if c == 34 {
            return i
        }
        if c == 92 { i += 1 }
        i += 1
    }
    return rem.len()
}

fn parse_hex4(rem: str, start: usize) -> u32 {
    auto cp# = 0:u32
    auto j# = 0:usize
    loop j < 4 {
        auto c = rem.byte_at(start + j)
        auto val# = 0:u32
        if c >= 48 && c <= 57 { val = (c - 48) as u32 }
        else if c >= 65 && c <= 70 { val = ((c - 65) + 10) as u32 }
        else if c >= 97 && c <= 102 { val = ((c - 97) + 10) as u32 }
        cp = (cp * 16:u32) + val
        j += 1
    }
    return cp
}

fn push_utf8(out#: string, cp: u32) {
    if cp <= 127:u32 { out#.push_char(cp as char) }
    else if cp <= 2047:u32 {
        out#.push_char((192:u32 + (cp / 64:u32)) as char)
        out#.push_char((128:u32 + (cp % 64:u32)) as char)
    } else if cp <= 65535:u32 {
        out#.push_char((224:u32 + (cp / 4096:u32)) as char)
        out#.push_char((128:u32 + ((cp / 64:u32) % 64:u32)) as char)
        out#.push_char((128:u32 + (cp % 64:u32)) as char)
    } else {
        out#.push_char((240:u32 + (cp / 262144:u32)) as char)
        out#.push_char((128:u32 + ((cp / 4096:u32) % 64:u32)) as char)
        out#.push_char((128:u32 + ((cp / 64:u32) % 64:u32)) as char)
        out#.push_char((128:u32 + (cp % 64:u32)) as char)
    }
}

pub fn parse_i32_value(json: str) -> Result<Parsed<i32>, str> <- json {
    auto rem = leaf_skip_whitespace(json)
    if rem.len() == 0 {
        auto error = Result<Parsed<i32>, str>::Err("EOF")
        return cede error
    }
    auto i# = 0:usize
    auto neg# = false
    if rem.byte_at(0) == 45 { neg = true; i = 1 }
    auto val# = 0:i32
    auto found# = false
    loop i < rem.len() {
        auto c = rem.byte_at(i)
        if c >= 48 && c <= 57 {
            val = val * 10 + ((c - 48) as i32)
            found = true
            i += 1
        } else { break }
    }
    if !found {
        auto error = Result<Parsed<i32>, str>::Err("Invalid i32")
        return cede error
    }
    if neg { val = 0 - val }
    auto parsed = Parsed<i32>(value = val, rest = rem.substr(i, rem.len() - i))
    auto result = Result<Parsed<i32>, str>::Ok(cede parsed)
    return cede result
}

pub fn parse_string_value(json: str) -> Result<Parsed<string>, str> <- json {
    auto rem = leaf_skip_whitespace(json)
    if !json_string_valid(rem, 0) {
        auto error = Result<Parsed<string>, str>::Err("Invalid JSON string")
        return cede error
    }
    auto i = scan_string_end(rem)
    if i == 0 {
        auto error = Result<Parsed<string>, str>::Err("Expected string")
        return cede error
    }
    if i == rem.len() {
        auto error = Result<Parsed<string>, str>::Err("Unterminated string")
        return cede error
    }
    auto decoded# = string::from("")
    auto j# = 1:usize
    loop j < i {
        auto c = rem.byte_at(j)
        if c == 92 {
            j += 1
            auto ec = rem.byte_at(j)
            if ec == 34 { decoded#.push_char(34 as char) }
            else if ec == 92 { decoded#.push_char(92 as char) }
            else if ec == 47 { decoded#.push_char(47 as char) }
            else if ec == 98 { decoded#.push_char(8 as char) }
            else if ec == 102 { decoded#.push_char(12 as char) }
            else if ec == 110 { decoded#.push_char(10 as char) }
            else if ec == 114 { decoded#.push_char(13 as char) }
            else if ec == 116 { decoded#.push_char(9 as char) }
            else if ec == 117 {
                // Do not read past the closing quote on a truncated escape.
                if i - j <= 4 {
                    auto error = Result<Parsed<string>, str>::Err("Incomplete unicode escape")
                    return cede error
                }
                auto cp# = parse_hex4(rem, j + 1)
                j += 4
                if cp >= 55296:u32 && cp <= 56319:u32 {
                    if i - j > 2 && rem.byte_at(j + 1) == 92 && rem.byte_at(j + 2) == 117 {
                        if i - j <= 6 {
                            auto error = Result<Parsed<string>, str>::Err("Incomplete unicode escape")
                            return cede error
                        }
                        auto low_cp = parse_hex4(rem, j + 3)
                        cp = ((cp - 55296:u32) * 1024:u32) + (low_cp - 56320:u32) + 65536:u32
                        j += 6
                    }
                }
                push_utf8(decoded#, cp)
            } else { decoded#.push_char(ec as char) }
        } else { decoded#.push_char(c as char) }
        j += 1
    }
    auto parsed = Parsed<string>(value = cede decoded, rest = rem.substr(i + 1, rem.len() - i - 1))
    auto result = Result<Parsed<string>, str>::Ok(cede parsed)
    return cede result
}

pub fn parse_str_view(json: str) -> Result<Parsed<str>, str> <- json {
    auto rem = leaf_skip_whitespace(json)
    if !json_string_valid(rem, 0) {
        auto error = Result<Parsed<str>, str>::Err("Invalid JSON string")
        return cede error
    }
    auto i = scan_string_end(rem)
    if i == 0 {
        auto error = Result<Parsed<str>, str>::Err("Expected string")
        return cede error
    }
    if i == rem.len() {
        auto error = Result<Parsed<str>, str>::Err("Unterminated string")
        return cede error
    }
    // This is the original input slice, including escape text, never decoded storage.
    auto parsed = Parsed<str>(value = rem.substr(1, i - 1), rest = rem.substr(i + 1, rem.len() - i - 1))
    auto result = Result<Parsed<str>, str>::Ok(cede parsed)
    return cede result
}
