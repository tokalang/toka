// HKDF-SHA-256 (RFC 5869).

import core/result::{Result}
import core/str::{bytes}
import std/bytes::{Bytes, bytes_from_array}
import std/vec::{Vec}
import stdx/crypto/hmac::{hmac_sha256}

const HASH_LEN: usize = 32
const MAX_OUTPUT_LEN: usize = 8160

pub fn extract(salt: bytes, input_key_material: bytes) -> [u8; 32] {
    if salt.len() == 0:usize {
        auto zero_salt = [0:u8; 32]:[u8; 32]
        return hmac_sha256(bytes_from_array<32>(zero_salt), input_key_material)
    }
    return hmac_sha256(salt, input_key_material)
}

pub fn expand(pseudorandom_key: [u8; 32], info: bytes,
              output_len: usize) -> Result<Vec<u8>, string> {
    if output_len > MAX_OUTPUT_LEN {
        return Result<Vec<u8>, string>::Err(string::from("HKDF-SHA-256 output exceeds 255 hash blocks"))
    }

    auto output# = Vec<u8>::with_capacity(output_len)
    auto previous# = [0:u8; 32]:[u8; 32]
    auto block_index# = 1:u8
    loop output.len() < output_len {
        auto input# = Vec<u8>::new()
        if block_index > 1:u8 {
            auto previous_index# = 0:usize
            loop previous_index < HASH_LEN {
                input#.push(previous[previous_index])
                previous_index = previous_index + 1:usize
            }
        }
        auto info_index# = 0:usize
        loop info_index < info.len() {
            input#.push(info.at(info_index).unwrap() as u8)
            info_index = info_index + 1:usize
        }
        input#.push(block_index)

        auto input_owner = Bytes::from_vec(cede input)
        previous = hmac_sha256(bytes_from_array<32>(pseudorandom_key), input_owner.as_slice())

        auto digest_index# = 0:usize
        loop digest_index < HASH_LEN && output.len() < output_len {
            output#.push(previous[digest_index])
            digest_index = digest_index + 1:usize
        }
        block_index = block_index + 1:u8
    }
    return Result<Vec<u8>, string>::Ok(cede output)
}

pub fn derive(salt: bytes, input_key_material: bytes, info: bytes,
              output_len: usize) -> Result<Vec<u8>, string> {
    auto pseudorandom_key = extract(salt, input_key_material)
    return expand(pseudorandom_key, info, output_len)
}
