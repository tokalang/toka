// OS-random tokens for protocols that need opaque, bearer-safe values.

import core/result::{Result}
import std/bytes::{Bytes}
import std/random::{secure_random_bytes}
import stdx/encoding/base64
import stdx/encoding/hex

pub fn hex_token(random_bytes: usize) -> Result<string, string> {
    auto generated = secure_random_bytes(random_bytes)
    if generated.is_err() {
        return Result<string, string>::Err(generated.unwrap_err())
    }
    auto owner = Bytes::from_vec(cede generated.unwrap())
    return Result<string, string>::Ok(hex::encode(owner.as_slice()))
}

pub fn url_safe_token(random_bytes: usize) -> Result<string, string> {
    auto generated = secure_random_bytes(random_bytes)
    if generated.is_err() {
        return Result<string, string>::Err(generated.unwrap_err())
    }
    auto owner = Bytes::from_vec(cede generated.unwrap())
    return Result<string, string>::Ok(base64::encode_url_safe_no_pad(owner.as_slice()))
}
