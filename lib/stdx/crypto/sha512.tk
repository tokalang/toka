import core/str::{bytes}
import stdx/encoding/hex

const SHA512_K: [u64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

pub shape Sha512(
    state: [u64; 8],
    data: [u8; 128],
    datalen: u64,
    bitlen: u64
)

fn rotr(value: u64, amount: u64) -> u64 {
    return (value >> amount) | (value << (64:u64 - amount))
}

fn ch(x: u64, y: u64, z: u64) -> u64 { return (x & y) ^ ((~ x) & z) }
fn maj(x: u64, y: u64, z: u64) -> u64 { return (x & y) ^ (x & z) ^ (y & z) }
fn ep0(x: u64) -> u64 { return rotr(x, 28) ^ rotr(x, 34) ^ rotr(x, 39) }
fn ep1(x: u64) -> u64 { return rotr(x, 14) ^ rotr(x, 18) ^ rotr(x, 41) }
fn sig0(x: u64) -> u64 { return rotr(x, 1) ^ rotr(x, 8) ^ (x >> 7) }
fn sig1(x: u64) -> u64 { return rotr(x, 19) ^ rotr(x, 61) ^ (x >> 6) }

impl Sha512 {
    fn process_block(self#) {
        auto words# = [0:u64; 80]:[u64; 80]
        auto index# = 0:usize
        loop index < 16:usize {
            auto offset = index * 8:usize
            words[index] = (u64(self.data[offset]) << 56) |
                           (u64(self.data[offset + 1]) << 48) |
                           (u64(self.data[offset + 2]) << 40) |
                           (u64(self.data[offset + 3]) << 32) |
                           (u64(self.data[offset + 4]) << 24) |
                           (u64(self.data[offset + 5]) << 16) |
                           (u64(self.data[offset + 6]) << 8) |
                           u64(self.data[offset + 7])
            index += 1
        }
        loop index < 80:usize {
            words[index] = sig1(words[index - 2]) + words[index - 7] +
                           sig0(words[index - 15]) + words[index - 16]
            index += 1
        }

        auto a# = self.state[0]
        auto b# = self.state[1]
        auto c# = self.state[2]
        auto d# = self.state[3]
        auto e# = self.state[4]
        auto f# = self.state[5]
        auto g# = self.state[6]
        auto h# = self.state[7]
        index = 0
        loop index < 80:usize {
            auto temp1 = h + ep1(e) + ch(e, f, g) + SHA512_K[index] + words[index]
            auto temp2 = ep0(a) + maj(a, b, c)
            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            index += 1
        }
        self.state[0] = self.state[0] + a
        self.state[1] = self.state[1] + b
        self.state[2] = self.state[2] + c
        self.state[3] = self.state[3] + d
        self.state[4] = self.state[4] + e
        self.state[5] = self.state[5] + f
        self.state[6] = self.state[6] + g
        self.state[7] = self.state[7] + h
    }

    pub fn new() -> Sha512 {
        return Sha512(
            state = [
                0x6a09e667f3bcc908, 0xbb67ae8584caa73b,
                0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
                0x510e527fade682d1, 0x9b05688c2b3e6c1f,
                0x1f83d9abfb41bd6b, 0x5be0cd19137e2179
            ],
            data = [0:u8; 128], datalen = 0, bitlen = 0
        )
    }

    pub fn update_view(self#, input: bytes) {
        auto index# = 0:usize
        loop index < input.len() {
            auto data_index = self.datalen as usize
            self.data[data_index] = input.at(index).unwrap() as u8
            self.datalen += 1
            if self.datalen == 128:u64 {
                self#.process_block()
                self.bitlen += 1024:u64
                self.datalen = 0
            }
            index += 1
        }
    }

    pub fn finalize(self#) -> [u8; 64] {
        auto index# = self.datalen as usize
        self.data[index] = 0x80:u8
        index += 1
        if index > 112:usize {
            loop index < 128:usize { self.data[index] = 0:u8; index += 1 }
            self#.process_block()
            index = 0
        }
        loop index < 112:usize { self.data[index] = 0:u8; index += 1 }
        self.bitlen += self.datalen * 8:u64
        index = 0
        loop index < 8:usize { self.data[112 + index] = 0:u8; index += 1 }
        index = 0
        loop index < 8:usize {
            self.data[120 + index] = u8(self.bitlen >> ((7:usize - index) * 8:usize))
            index += 1
        }
        self#.process_block()

        auto digest# = [0:u8; 64]:[u8; 64]
        index = 0
        loop index < 8:usize {
            auto offset = index * 8:usize
            digest[offset] = u8(self.state[index] >> 56)
            digest[offset + 1] = u8(self.state[index] >> 48)
            digest[offset + 2] = u8(self.state[index] >> 40)
            digest[offset + 3] = u8(self.state[index] >> 32)
            digest[offset + 4] = u8(self.state[index] >> 24)
            digest[offset + 5] = u8(self.state[index] >> 16)
            digest[offset + 6] = u8(self.state[index] >> 8)
            digest[offset + 7] = u8(self.state[index])
            index += 1
        }
        return digest
    }

    pub fn finalize_hex(self#) -> string {
        return hex::encode_fixed64(self#.finalize())
    }
}
