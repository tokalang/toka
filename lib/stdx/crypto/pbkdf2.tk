// PBKDF2-HMAC-SHA-256 (RFC 8018).
//
// This is a bounded derivation primitive.  Callers choose the work factor;
// protocol adapters should use their protocol's fixed output size rather than
// treating this as a password-storage policy.

import core/result::{Result}
import core/str::{bytes}
import std/bytes::{Bytes, bytes_from_array}
import std/vec::{Vec}
import stdx/crypto/hmac::{hmac_sha256}

const HASH_LEN: usize = 32:usize
const MAX_OUTPUT_LEN: usize = 67108864:usize

fn append_salt_and_block(salt: bytes, block_index: u32) -> Bytes {
    auto input# = Vec<u8>::with_capacity(salt.len() + 4:usize)
    auto index# = 0:usize
    loop index < salt.len() {
        input#.push(salt.at(index).unwrap() as u8)
        index = index + 1:usize
    }
    input#.push((block_index >> 24:u32) as u8)
    input#.push((block_index >> 16:u32) as u8)
    input#.push((block_index >> 8:u32) as u8)
    input#.push(block_index as u8)
    return Bytes::from_vec(cede input)
}

// Derive `output_len` bytes.  The return value is owned so it can be passed
// directly into protocol code without retaining a borrowed scratch buffer.
pub fn derive_sha256(password: bytes, salt: bytes, iterations: u32,
                     output_len: usize) -> Result<Vec<u8>, string> {
    if iterations == 0:u32 {
        return Result<Vec<u8>, string>::Err(string::from("PBKDF2 iteration count must be positive"))
    }
    if output_len > MAX_OUTPUT_LEN {
        return Result<Vec<u8>, string>::Err(string::from("PBKDF2 output exceeds 64 MiB limit"))
    }

    auto output# = Vec<u8>::with_capacity(output_len)
    auto block_index# = 1:u32
    loop output.len() < output_len {
        auto input = append_salt_and_block(salt, block_index)
        auto u# = hmac_sha256(password, input.as_slice())
        auto accumulated# = u
        auto round# = 1:u32
        loop round < iterations {
            u = hmac_sha256(password, bytes_from_array<32>(u))
            auto index# = 0:usize
            loop index < HASH_LEN {
                accumulated[index] = accumulated[index] ^ u[index]
                index = index + 1:usize
            }
            round = round + 1:u32
        }

        auto index# = 0:usize
        loop index < HASH_LEN && output.len() < output_len {
            output#.push(accumulated[index])
            index = index + 1:usize
        }
        if block_index == 4294967295:u32 && output.len() < output_len {
            return Result<Vec<u8>, string>::Err(string::from("PBKDF2 block index overflow"))
        }
        block_index = block_index + 1:u32
    }
    return Result<Vec<u8>, string>::Ok(cede output)
}
