// RFC 4180 core CSV parser and writer.

import std/vec::{Vec}
import std/io::{@Reader, @Writer}
import stdx/io/bufio::{BufferedReader, BufferedWriter}

pub shape CsvError(
    line: usize,
    column: usize,
    message: string
)

shape CsvWidth(
    columns: usize,
    established: bool
)

fn parse_error(line: usize, column: usize, message: string) -> CsvError {
    return CsvError(line = line, column = column, message = message.clone())
}

fn append_record(records#: Vec<Vec<string>>, cede row: Vec<string>,
                 width: CsvWidth, line: usize, column: usize)
                 -> Result<CsvWidth, CsvError> {
    if width.established && row.len() != width.columns {
        return Result<CsvWidth, CsvError>::Err(parse_error(
            line, column, string::from("inconsistent field count")))
    }
    auto next_width# = CsvWidth(columns = row.len(), established = true)
    if width.established {
        next_width.columns = width.columns
    }
    records#.push(cede row)
    return Result<CsvWidth, CsvError>::Ok(next_width)
}

// Parse RFC 4180 records into owned fields. Every returned string owns its
// bytes; callers never retain a view into `input`.
pub fn parse_records(input: str) -> Result<Vec<Vec<string>>, CsvError> {
    auto records# = Vec<Vec<string>>::new()
    auto row# = Vec<string>::new()
    auto field# = string::from("")
    auto width# = CsvWidth(columns = 0:usize, established = false)
    auto in_quotes# = false
    auto quote_closed# = false
    auto record_started# = false
    auto i# = 0:usize
    auto line# = 1:usize
    auto column# = 1:usize

    loop i < input.len() {
        auto byte = input.byte_at(i) as u8
        if in_quotes {
            if byte == 34:u8 {
                if i + 1 < input.len() && input.byte_at(i + 1) as u8 == 34:u8 {
                    field#.push_byte_raw(34:u8)
                    i = i + 2
                    column = column + 2
                } else {
                    in_quotes = false
                    quote_closed = true
                    i = i + 1
                    column = column + 1
                }
                continue
            }
            if byte == 13:u8 {
                if i + 1 >= input.len() || input.byte_at(i + 1) as u8 != 10:u8 {
                    return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                        line, column, string::from("bare CR in quoted field")))
                }
                field#.push_byte_raw(13:u8)
                field#.push_byte_raw(10:u8)
                i = i + 2
                line = line + 1
                column = 1
                continue
            }
            if byte == 10:u8 {
                return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                    line, column, string::from("bare LF in quoted field")))
            }
            field#.push_byte_raw(byte)
            i = i + 1
            column = column + 1
            continue
        }

        if quote_closed {
            if byte != 44:u8 && byte != 13:u8 {
                return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                    line, column, string::from("unexpected byte after closing quote")))
            }
            quote_closed = false
        }

        if byte == 44:u8 {
            row#.push(cede field)
            field = string::from("")
            record_started = true
            i = i + 1
            column = column + 1
            continue
        }
        if byte == 34:u8 {
            if field.len() != 0 {
                return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                    line, column, string::from("quote must begin a field")))
            }
            in_quotes = true
            record_started = true
            i = i + 1
            column = column + 1
            continue
        }
        if byte == 13:u8 {
            if i + 1 >= input.len() || input.byte_at(i + 1) as u8 != 10:u8 {
                return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                    line, column, string::from("record terminator must be CRLF")))
            }
            row#.push(cede field)
            auto appended = append_record(records, cede row, width, line, column)
            if appended.is_err() {
                return Result<Vec<Vec<string>>, CsvError>::Err(appended.unwrap_err())
            }
            width = appended.unwrap()
            row = Vec<string>::new()
            field = string::from("")
            record_started = false
            i = i + 2
            line = line + 1
            column = 1
            continue
        }
        if byte == 10:u8 {
            return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
                line, column, string::from("record terminator must be CRLF")))
        }

        field#.push_byte_raw(byte)
        record_started = true
        i = i + 1
        column = column + 1
    }

    if in_quotes {
        return Result<Vec<Vec<string>>, CsvError>::Err(parse_error(
            line, column, string::from("unclosed quoted field")))
    }
    if record_started {
        row#.push(cede field)
        auto appended = append_record(records, cede row, width, line, column)
        if appended.is_err() {
            return Result<Vec<Vec<string>>, CsvError>::Err(appended.unwrap_err())
        }
    }
    return Result<Vec<Vec<string>>, CsvError>::Ok(cede records)
}

fn write_field(cede field: string, output#: string) {
    auto owned_field = cede field
    auto quoted# = false
    auto i# = 0:usize
    loop i < owned_field.len() {
        auto byte = owned_field.as_str().byte_at(i) as u8
        if byte == 44:u8 || byte == 34:u8 || byte == 13:u8 || byte == 10:u8 {
            quoted = true
        }
        i = i + 1
    }
    if quoted { output#.push_byte_raw(34:u8) }
    i = 0:usize
    loop i < owned_field.len() {
        auto byte = owned_field.as_str().byte_at(i) as u8
        if byte == 34:u8 { output#.push_byte_raw(34:u8) }
        output#.push_byte_raw(byte)
        i = i + 1
    }
    if quoted { output#.push_byte_raw(34:u8) }
}

pub fn write_records(cede records: Vec<Vec<string>>) -> string {
    auto owned_records = cede records
    auto output# = string::from("")
    auto row_index# = 0:usize
    loop row_index < owned_records.len() {
        auto &row = owned_records.borrow(row_index)
        auto field_index# = 0:usize
        loop field_index < row.len() {
            if field_index > 0 { output#.push_byte_raw(44:u8) }
            auto field = row.borrow(field_index).clone()
            write_field(cede field, output)
            field_index = field_index + 1:usize
        }
        output#.push_byte_raw(13:u8)
        output#.push_byte_raw(10:u8)
        row_index = row_index + 1
    }
    return cede output
}

fn quotes_closed(input: str) -> bool {
    auto in_quotes# = false
    auto i# = 0:usize
    loop i < input.len() {
        auto byte = input.byte_at(i) as u8
        if byte == 34:u8 {
            if in_quotes && i + 1 < input.len() &&
               input.byte_at(i + 1) as u8 == 34:u8 {
                i = i + 2
                continue
            }
            in_quotes = !in_quotes
        }
        i = i + 1
    }
    return !in_quotes
}

// Read one logical record through the existing buffered reader. This keeps
// the adapter generic without introducing another owning wrapper around R.
pub fn read_record<'R: @Reader>(reader#: BufferedReader<'R>, max_record_bytes: usize)
                             -> Result<Option<Vec<string>>, CsvError> {
    auto record# = string::from("")
    auto line# = 1:usize
    loop true {
        auto line_result = reader#.read_line()
        if line_result.is_err() {
            return Result<Option<Vec<string>>, CsvError>::Err(parse_error(
                line, 1:usize, line_result.unwrap_err()))
        }
        auto fragment = cede line_result.unwrap()
        if fragment.len() == 0:usize {
            if record.len() == 0:usize {
                return Result<Option<Vec<string>>, CsvError>::Ok(Option<Vec<string>>::None)
            }
            if !quotes_closed(record.as_str()) {
                return Result<Option<Vec<string>>, CsvError>::Err(parse_error(
                    line, 1:usize, string::from("unclosed quoted field at EOF")))
            }
        } else {
            if record.len() + fragment.len() > max_record_bytes {
                return Result<Option<Vec<string>>, CsvError>::Err(parse_error(
                    line, 1:usize, string::from("CSV record size limit exceeded")))
            }
            record#.push_str(fragment.as_str())
            line = line + 1:usize
            if !quotes_closed(record.as_str()) {
                continue
            }
        }

        auto parsed = parse_records(record.as_str())
        if parsed.is_err() {
            return Result<Option<Vec<string>>, CsvError>::Err(parsed.unwrap_err())
        }
        auto rows# = cede parsed.unwrap()
        if rows.len() != 1:usize {
            return Result<Option<Vec<string>>, CsvError>::Err(parse_error(
                1:usize, 1:usize, string::from("expected exactly one CSV record")))
        }
        auto row = rows#.remove(0:usize).unwrap()
        return Result<Option<Vec<string>>, CsvError>::Ok(
            Option<Vec<string>>::Some(cede row))
    }
    unreachable
}

// Write one owned record through the existing buffered writer. The caller
// controls flushing, which keeps batching policy explicit.
pub fn write_record<'W: @Writer>(writer#: BufferedWriter<'W>, cede record: Vec<string>)
                              -> Result<(), CsvError> {
    auto records# = Vec<Vec<string>>::new()
    records#.push(cede record)
    auto wire = write_records(cede records)
    auto written = writer#.write_string(wire.clone())
    if written.is_err() {
        return Result<(), CsvError>::Err(parse_error(
            1:usize, 1:usize, written.unwrap_err()))
    }
    if written.unwrap() != wire.len() {
        return Result<(), CsvError>::Err(parse_error(
            1:usize, 1:usize, string::from("short CSV write")))
    }
    return Result<(), CsvError>::Ok(())
}
