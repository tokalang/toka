import core/result::{Result}
import core/str::{bytes}
import std/vec::{Vec}

pub shape DecodeError (
    position: usize,
    message: string
)

fn decode_error(position: usize, message: str) -> DecodeError {
    return DecodeError(position = position, message = string::from(message))
}

fn upper_hex_character(value: u8) -> u8 {
    if value < 10:u8 { return '0' as u8 + value }
    return 'A' as u8 + value - 10:u8
}

fn hex_value(value: u8) -> i32 {
    if value >= '0' as u8 && value <= '9' as u8 { return (value - '0' as u8) as i32 }
    if value >= 'a' as u8 && value <= 'f' as u8 { return (value - 'a' as u8) as i32 + 10:i32 }
    if value >= 'A' as u8 && value <= 'F' as u8 { return (value - 'A' as u8) as i32 + 10:i32 }
    return -1:i32
}

fn is_unreserved(value: u8) -> bool {
    if value >= 'a' as u8 && value <= 'z' as u8 { return true }
    if value >= 'A' as u8 && value <= 'Z' as u8 { return true }
    if value >= '0' as u8 && value <= '9' as u8 { return true }
    return value == '-' as u8 || value == '.' as u8 || value == '_' as u8 || value == '~' as u8
}

pub fn encode(input: bytes) -> string {
    auto encoded# = string::from("")
    auto index# = 0:usize
    loop index < input.len() {
        auto value = input.at(index).unwrap() as u8
        if is_unreserved(value) {
            encoded#.push_byte_raw(value)
        } else {
            encoded#.push_byte_raw('%' as u8)
            encoded#.push_byte_raw(upper_hex_character(value >> 4:u8))
            encoded#.push_byte_raw(upper_hex_character(value & 15:u8))
        }
        index = index + 1:usize
    }
    return encoded
}

pub fn decode(input: str) -> Result<Vec<u8>, DecodeError> {
    auto input_len = input.len()
    auto decoded# = Vec<u8>::with_capacity(input_len)
    auto index# = 0:usize
    loop index < input_len {
        auto value = input.byte_at(index) as u8
        if value != '%' as u8 {
            decoded#.push(value)
            index = index + 1:usize
            continue
        }
        if index + 2 >= input_len { return Result<Vec<u8>, DecodeError>::Err(decode_error(index, "truncated percent escape")) }
        auto high = hex_value(input.byte_at(index + 1:usize) as u8)
        if high < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 1:usize, "invalid percent escape")) }
        auto low = hex_value(input.byte_at(index + 2:usize) as u8)
        if low < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 2:usize, "invalid percent escape")) }
        decoded#.push(((high << 4:i32) | low) as u8)
        index = index + 3:usize
    }
    return Result<Vec<u8>, DecodeError>::Ok(cede decoded)
}

impl DecodeError {
    pub fn position(self) -> usize { return self.position }
    pub fn message(self) -> string { return string::from(self.message.as_str()) }
}
