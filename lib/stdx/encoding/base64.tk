import core/result::{Result}
import core/str::{bytes}
import std/bytes::{Bytes}
import std/vec::{Vec}

pub shape DecodeError (
    position: usize,
    message: string
)

fn decode_error(position: usize, message: str) -> DecodeError {
    return DecodeError(position = position, message = string::from(message))
}

fn base64_character(value: u8) -> u8 {
    if value < 26:u8 { return 'A' as u8 + value }
    if value < 52:u8 { return 'a' as u8 + value - 26:u8 }
    if value < 62:u8 { return '0' as u8 + value - 52:u8 }
    if value == 62:u8 { return '+' as u8 }
    return '/' as u8
}

fn base64_url_character(value: u8) -> u8 {
    if value < 26:u8 { return 'A' as u8 + value }
    if value < 52:u8 { return 'a' as u8 + value - 26:u8 }
    if value < 62:u8 { return '0' as u8 + value - 52:u8 }
    if value == 62:u8 { return '-' as u8 }
    return '_' as u8
}

fn base64_value(value: u8) -> i32 {
    if value >= 'A' as u8 && value <= 'Z' as u8 { return (value - 'A' as u8) as i32 }
    if value >= 'a' as u8 && value <= 'z' as u8 { return (value - 'a' as u8) as i32 + 26:i32 }
    if value >= '0' as u8 && value <= '9' as u8 { return (value - '0' as u8) as i32 + 52:i32 }
    if value == '+' as u8 { return 62:i32 }
    if value == '/' as u8 { return 63:i32 }
    return -1:i32
}

pub fn encode(input: bytes) -> string {
    auto encoded# = string::from("")
    auto index#: usize = 0:usize
    loop index < input.len() {
        auto remaining = input.len() - index
        auto first = input.at(index).unwrap() as u32
        auto second#: u32 = 0:u32
        auto third#: u32 = 0:u32
        if remaining > 1:usize { second = input.at(index + 1:usize).unwrap() as u32 }
        if remaining > 2:usize { third = input.at(index + 2:usize).unwrap() as u32 }
        auto triple = (first << 16:u32) | (second << 8:u32) | third
        encoded#.push_byte_raw(base64_character(((triple >> 18:u32) & 63:u32) as u8))
        encoded#.push_byte_raw(base64_character(((triple >> 12:u32) & 63:u32) as u8))
        if remaining > 1:usize {
            encoded#.push_byte_raw(base64_character(((triple >> 6:u32) & 63:u32) as u8))
        } else { encoded#.push_byte_raw('=' as u8) }
        if remaining > 2:usize {
            encoded#.push_byte_raw(base64_character((triple & 63:u32) as u8))
        } else { encoded#.push_byte_raw('=' as u8) }
        index = index + 3:usize
    }
    return encoded
}

pub fn encode_vec(cede input: Vec<u8>) -> string {
    auto owned = Bytes::from_vec(cede input)
    return encode(owned.as_slice())
}

// RFC 4648 §5 alphabet without '=' padding, suitable for URL path and query values.
pub fn encode_url_safe_no_pad(input: bytes) -> string {
    auto encoded# = string::from("")
    auto index#: usize = 0:usize
    loop index < input.len() {
        auto remaining = input.len() - index
        auto first = input.at(index).unwrap() as u32
        auto second#: u32 = 0:u32
        auto third#: u32 = 0:u32
        if remaining > 1:usize { second = input.at(index + 1:usize).unwrap() as u32 }
        if remaining > 2:usize { third = input.at(index + 2:usize).unwrap() as u32 }
        auto triple = (first << 16:u32) | (second << 8:u32) | third
        encoded#.push_byte_raw(base64_url_character(((triple >> 18:u32) & 63:u32) as u8))
        encoded#.push_byte_raw(base64_url_character(((triple >> 12:u32) & 63:u32) as u8))
        if remaining > 1:usize {
            encoded#.push_byte_raw(base64_url_character(((triple >> 6:u32) & 63:u32) as u8))
        }
        if remaining > 2:usize {
            encoded#.push_byte_raw(base64_url_character((triple & 63:u32) as u8))
        }
        index = index + 3:usize
    }
    return encoded
}

pub fn encode_fixed20(data: [u8; 20]) -> string {
    auto values# = Vec<u8>::with_capacity(20:usize)
    auto index#: usize = 0:usize
    loop index < 20:usize {
        values#.push(data[index])
        index = index + 1:usize
    }
    return encode_vec(cede values)
}

pub fn decode(input: str) -> Result<Vec<u8>, DecodeError> {
    if input.len() % 4:usize != 0:usize {
        return Result<Vec<u8>, DecodeError>::Err(
            decode_error(input.len(), "Base64 input length must be a multiple of four"))
    }
    auto decoded# = Vec<u8>::with_capacity((input.len() / 4:usize) * 3:usize)
    auto index#: usize = 0:usize
    loop index < input.len() {
        auto first = base64_value(input.byte_at(index) as u8)
        if first < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index, "invalid Base64 character")) }
        auto second = base64_value(input.byte_at(index + 1:usize) as u8)
        if second < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 1:usize, "invalid Base64 character")) }
        auto third_byte = input.byte_at(index + 2:usize) as u8
        auto fourth_byte = input.byte_at(index + 3:usize) as u8
        auto is_last = index + 4:usize == input.len()
        if third_byte == '=' as u8 {
            if fourth_byte != '=' as u8 || !is_last { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 2:usize, "invalid Base64 padding")) }
            if second % 16:i32 != 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 1:usize, "non-canonical Base64 padding bits")) }
            decoded#.push(((first << 2:i32) | (second >> 4:i32)) as u8)
            break
        }
        auto third = base64_value(third_byte)
        if third < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 2:usize, "invalid Base64 character")) }
        decoded#.push(((first << 2:i32) | (second >> 4:i32)) as u8)
        if fourth_byte == '=' as u8 {
            if !is_last { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 3:usize, "invalid Base64 padding")) }
            if third % 4:i32 != 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 2:usize, "non-canonical Base64 padding bits")) }
            decoded#.push((((second & 15:i32) << 4:i32) | (third >> 2:i32)) as u8)
            break
        }
        auto fourth = base64_value(fourth_byte)
        if fourth < 0:i32 { return Result<Vec<u8>, DecodeError>::Err(decode_error(index + 3:usize, "invalid Base64 character")) }
        decoded#.push((((second & 15:i32) << 4:i32) | (third >> 2:i32)) as u8)
        decoded#.push((((third & 3:i32) << 6:i32) | fourth) as u8)
        index = index + 4:usize
    }
    return Result<Vec<u8>, DecodeError>::Ok(cede decoded)
}

impl DecodeError {
    pub fn position(self) -> usize { return self.position }
    pub fn message(self) -> string { return string::from(self.message.as_str()) }
}
