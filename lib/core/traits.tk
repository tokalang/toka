import core/option::{Option}

// Marker trait for types that can be safely moved.
pub trait @Move {}

// @Copy is an empty compiler-recognized marker. Structural eligibility is
// verified by the compiler; library code never supplies an operation body.
pub trait @Copy {}

// @Dup is the explicit, non-implicit duplication capability.
pub trait @Dup {
    pub fn dup(self) -> Self
}

// Trait for types that have a default value.
pub trait @Default {
    pub fn init(self)
}

pub trait @PartialOrd {
    pub fn cmp(self, other: Self) -> i32
}

// @Encap is an empty compiler-recognized policy marker. Its implementation
// carries exact field grants and, optionally, one private lifecycle hook.
pub trait @Encap {}

pub trait @Hash {
    pub fn hash(self) -> u64
}

pub trait @PartialEq {
    pub fn eq(self, other: Self) -> bool
}


pub trait @Send {}
pub trait @Sync {}

// Invocation permission is carried by call(self), call(self#), or
// call(cede self), not by separate nominal callable traits. Output is derived
// from that call declaration; implementations do not repeat it manually.
pub trait @Callable {
    type Output
}

// Error propagation performs at most one explicit, consuming conversion.
pub trait @ErrorInto<Target> {
    pub fn into_error(cede self) -> Target
}

pub trait @Iterator {
    type Item
    pub fn next(self#) -> Option<Item>
}

// A consuming source facet is deliberately separate from @Iterable::iter.
// It transfers the source into an owned cursor and carries no borrow
// dependency back to the original collection.
pub trait @IntoIterable {
    type IntoIter
    pub fn into_iter(cede self) -> IntoIter
}

pub trait @BorrowIterator {
    type BorrowedItem
    pub fn next_ref(self#) -> Option<BorrowedItem> <- self
}

pub trait @MutableBorrowIterator {
    type BorrowedItem
    pub fn next_mut(self#) -> Option<BorrowedItem> <- self
}

pub trait @Iterable {
    type Iter
    pub fn iter(self) -> Iter <- self
}

pub trait @Delegate<T> {
    pub fn target(self) -> T
}
