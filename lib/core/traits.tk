import core/option::{Option}

pub trait @PartialOrd {
    pub fn cmp(self, other: Self) -> i32
}

pub trait @encap {
    //pub *
    pub fn clone(self) -> Self
    fn drop(self#)
}

pub trait @Hash {
    pub fn hash(self) -> u64
}

pub trait @PartialEq {
    pub fn eq(self, other: Self) -> bool
}


pub trait @Send {}
pub trait @Sync {}

// Invocation permission is carried by call(self), call(self#), or
// call(cede self), not by separate nominal callable traits.
pub trait @Callable {}

// Error propagation performs at most one explicit, consuming conversion.
pub trait @ErrorInto<Target> {
    pub fn into_error(cede self) -> Target
}

pub trait @Iterator {
    type Item
    pub fn next(self#) -> Option<Item>
}

pub trait @BorrowIterator {
    type BorrowedItem
    pub fn next_ref(self#) -> Option<BorrowedItem> <- self
}

pub trait @Iterable {
    type Iter
    pub fn iter(self) -> Iter <- self
}

pub trait @delegate<T> {
    pub fn target(self) -> T
}
