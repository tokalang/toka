

extern fn libc_exit(status: i32) -> void

pub shape Result<'T, 'E> (
    Ok('T) = 1 |
    Err('E) = 0
)

impl<'T, 'E> Result<'T, 'E> {
    pub fn is_ok(self) -> bool {
        match self {
            auto Result<'T, 'E>::Ok(_) => return true
            _ => return false
        }
    }

    pub fn is_err(self) -> bool {
        return self.is_ok() == false
    }

    pub fn unwrap(cede self) -> 'T {
        match cede self {
            auto Result<'T, 'E>::Ok('val) => return 'val
            _ => {
                libc_exit(1)
                unreachable
            }
        }
    }

    pub fn unwrap_err(cede self) -> 'E {
        match cede self {
            auto Result<'T, 'E>::Err('e) => return 'e
            _ => {
                libc_exit(1)
                unreachable
            }
        }
    }
}
