

extern fn libc_exit(status: i32) -> void

pub shape Result<T, E> (
    Ok(T) = 1 |
    Err(E) = 0
)

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool {
        match self {
            auto Result<T, E>::Ok(_) => return true
            _ => return false
        }
    }

    pub fn is_err(self) -> bool {
        return self.is_ok() == false
    }

    // The ordinary route retains static/field source classification; the
    // external route carries a payload's outside owner past this envelope.
    pub fn unwrap(cede self) -> T <- self
    effects:
        return <- self.external
    {
        match cede self {
            auto Result<T, E>::Ok(val) => return cede val
            _ => {
                libc_exit(1)
                unreachable
            }
        }
    }

    pub fn unwrap_err(cede self) -> E <- self
    effects:
        return <- self.external
    {
        match cede self {
            auto Result<T, E>::Err(e) => return cede e
            _ => {
                libc_exit(1)
                unreachable
            }
        }
    }
}
