import core/types::{usize, Addr, ADDR0}
import core/option::{Option}

import sys/libc::*
import sys/os/abi::*

pub fn opendir_impl(path: Addr) -> Addr {
    unsafe {
        return toka_opendir_impl(path)
    }
}

pub fn readdir_impl(dir_handle: Addr) -> Option<string> {
    unsafe {
        auto entry = toka_readdir_impl(dir_handle)
        if entry == ADDR0 {
            return Option<string>::None
        }
        
        auto *name_ptr = toka_readdir_name(entry) as *char
        return Option<string>::Some(string::from_cstr(*name_ptr))
    }
}

pub fn closedir_impl(dir_handle: Addr) {
    unsafe {
        toka_closedir_impl(dir_handle)
    }
}

pub fn mkdir_impl(path: Addr) -> bool {
    unsafe {
        // 0755 = 493 in decimal
        return libc_mkdir(path as *char, 493) == 0
    }
}

pub fn rmdir_impl(path: Addr) -> bool {
    unsafe {
        return libc_rmdir(path as *char) == 0
    }
}

pub fn path_exists(path: Addr) -> bool {
    unsafe {
        // Use access(path, F_OK=0)
        return libc_access(path as *char, 0) == 0
    }
}

// Keeps the C pointer ABI below std. The runtime creates the sibling temporary
// file with exclusive creation and atomically replaces the target on success.
pub fn atomic_write_string_impl(path: string, content: string) -> bool {
    auto *path_ptr# = path.c_str()
    auto *data_ptr# = content.c_str() as *u8
    return unsafe toka_atomic_write_file(*path_ptr, *data_ptr, content.len()) == 0
}

pub fn temp_file_create_impl(directory: string) -> Addr {
    auto *directory_ptr# = directory.c_str()
    return unsafe toka_temp_file_create(*directory_ptr)
}

pub fn temp_file_path_impl(handle: Addr) -> Option<string> {
    unsafe {
        auto *path = toka_temp_file_path(handle)
        if *path == (ADDR0 as *char) {
            return Option<string>::None
        }
        return Option<string>::Some(string::from_cstr(*path))
    }
}

pub fn temp_file_write_impl(handle: Addr, content: str) -> i64 {
    auto owned_content = string::from(content)
    auto *data_ptr# = owned_content.c_str() as *u8
    return unsafe toka_temp_file_write(handle, *data_ptr, owned_content.len())
}

pub fn temp_file_close_impl(handle: Addr) -> i32 {
    return unsafe toka_temp_file_close(handle)
}

pub fn temp_file_remove_impl(handle: Addr) -> i32 {
    return unsafe toka_temp_file_remove(handle)
}

pub fn temp_file_destroy_impl(handle: Addr) {
    unsafe {
        toka_temp_file_destroy(handle)
    }
}

pub fn stat_impl(path: Addr) -> Addr {
    unsafe { return toka_stat_impl(path) }
}

pub fn stat_free_impl(handle: Addr) {
    unsafe { toka_stat_free(handle) }
}

pub fn stat_get_mode_impl(handle: Addr) -> u32 {
    unsafe { return toka_stat_mode(handle) }
}

pub fn stat_get_size_impl(handle: Addr) -> u64 {
    unsafe { return toka_stat_size(handle) }
}

pub fn stat_get_mtime_impl(handle: Addr) -> i64 {
    unsafe { return toka_stat_mtime(handle) }
}

// 0xF000 = 61440
// 0x4000 = 16384 (DIR)
// 0x8000 = 32768 (REG)
pub fn stat_is_dir_impl(mode: u32) -> bool {
    return (mode & 61440:u32) == 16384:u32
}

pub fn stat_is_file_impl(mode: u32) -> bool {
    return (mode & 61440:u32) == 32768:u32
}
