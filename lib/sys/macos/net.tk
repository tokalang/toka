import core/types::{char, usize, Addr, ADDR0}
import sys/libc::*
import sys/os/abi::*

// === Networking ===

pub fn get_last_error() -> i32 {
    unsafe {
        auto *addr# = libc___error()
        if *addr as usize == 0 { return 0 }
        return addr
    }
}

pub fn net_socket_impl() -> i32 {
    unsafe {
        return libc_socket(2, 1, 0)
    }
}

pub fn net_socket_udp_impl() -> i32 {
    unsafe {
        return libc_socket(2, 2, 0)
    }
}

pub fn net_setsockopt_reuse_impl(fd: i32) -> i32 {
    unsafe {
        auto *opt# = unsafe alloc [4] byte as *[i32]
        opt[0] = 1
        auto res = libc_setsockopt(fd, 65535, 4, *opt as *void, 4)
        libc_free(*opt as *void)
        return res
    }
}

fn fill_sockaddr_in(*addr_buf: char, ip: u32, port: u16) -> bool {
    unsafe {
        auto *base_ptr# = *addr_buf
        base_ptr = 16 as char
        auto *p1# = (*base_ptr as usize + 1) as *char
        p1 = 2 as char
        auto nport: u16 = (port bshr 8) bor (port bshl 8) // htons for little endian
        auto *p_port# = (*base_ptr as usize + 2) as *u16
        p_port = nport
        auto *p_addr# = (*base_ptr as usize + 4) as *u32
        p_addr = ip
        auto i# = 8
        loop i < 16 {
            auto *p_z# = (*base_ptr as usize + i) as *char
            p_z = 0 as char
            i += 1
        }
        return true
    }
}

pub fn get_errno_impl() -> i32 {
    unsafe {
        auto *addr# = libc___error()
        if *addr as usize == 0 { return 0 }
        return addr
    }
}

pub fn net_getsockopt_error_impl(fd: i32) -> i32 {
    unsafe {
        auto pval = unsafe alloc [4] byte as Addr
        auto pvlen = unsafe alloc [4] byte as Addr
        auto *val# = pval as *i32
        auto *vlen# = pvlen as *u32
        val = 0
        vlen = 4:u32
        auto res = getsockopt(fd, 0xffff, 0x1007, pval as *void, pvlen as *u32)
        auto err = val
        libc_free(pval as *void)
        libc_free(pvlen as *void)
        if res != 0 { return -1 }
        return err
    }
}



pub fn net_bind_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        // Allocate 32 bytes to be safe
        auto *addr_buf# = unsafe alloc [32] byte as *char

        if *addr_buf as usize == 0 {
             return -1
        }

        if !fill_sockaddr_in(*addr_buf, ip, port) {
            libc_free(*addr_buf as *void)
            return -1
        }

        // Use bind
        auto res = bind(fd, *addr_buf as *void, 16)
        libc_free(*addr_buf as *void)
        return res
    }
}

pub fn net_local_port_impl(fd: i32) -> i32 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char
        auto *addr_len# = unsafe alloc [1] u32
        addr_len[0] = 32:u32
        auto res = getsockname(fd, *addr_buf as *void, *addr_len as *u32)
        if res != 0 {
            libc_free(*addr_buf as *void)
            libc_free(*addr_len as *void)
            return -1
        }
        auto *port_ptr# = (*addr_buf as usize + 2) as *u16
        auto port = libc_htons(port_ptr) as i32
        libc_free(*addr_buf as *void)
        libc_free(*addr_len as *void)
        return port
    }
}

pub fn net_listen_impl(fd: i32) -> i32 {
    unsafe {
        // Backlog 128
        return libc_listen(fd, 128)
    }
}

pub fn net_connect_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char

        if *addr_buf as usize == 0 {
             return -2
        }

        if !fill_sockaddr_in(*addr_buf, ip, port) {
            libc_free(*addr_buf as *void)
            return -3
        }

        // Use connect with correct handle
        auto res = connect(fd, *addr_buf as *void, 16)
        libc_free(*addr_buf as *void)
        return res
    }
}

pub fn net_accept_impl(fd: i32) -> i32 {
    unsafe {
        // We ignore the peer address for now in this impl
        auto *addr_len_ptr# = unsafe alloc [4] byte as *[u32]
        addr_len_ptr[0] = 16
        auto *addr_buf# = unsafe alloc [16] byte as *void

        auto res = libc_accept(fd, *addr_buf, *addr_len_ptr as *u32)

        libc_free(*addr_len_ptr as *void)
        libc_free(*addr_buf)
        return res
    }
}

pub fn net_close_impl(fd: i32) {
    unsafe {
        libc_close(fd)
    }
}

pub fn net_read_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        // Pass *buf (pointer) to libc_read
        return libc_read(fd, *buf, len as i64)
    }
}

pub fn net_write_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        // Pass *buf (pointer) to libc_write
        return libc_write(fd, *buf, len as i64)
    }
}

pub fn net_sendto_impl(fd: i32, *buf: u8, len: usize, host: usize, port: i32) -> i64 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char
        if *addr_buf as usize == 0 { return -1 }
        if !fill_sockaddr_in(*addr_buf, host as u32, port as u16) {
            libc_free(*addr_buf as *void)
            return -1
        }
        auto res = libc_sendto(fd, *buf as *void, len, 0, *addr_buf as *void, 16:u32)
        libc_free(*addr_buf as *void)
        return res
    }
}

pub fn net_recvfrom_impl(fd: i32, *buf: u8, len: usize, *out_host: usize, *out_port: i32) -> i64 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char
        auto *addrlen# = unsafe alloc [4] byte as *u32
        addrlen = 16:u32

        auto res = libc_recvfrom(fd, *buf as *void, len, 0, *addr_buf as *void, *addrlen)
        if res >= 0:i64 {
            auto *p0 = (*addr_buf as usize + 2) as *u8
            auto *p1 = (*addr_buf as usize + 3) as *u8
            auto *pp# = *out_port
            pp = ((p0 as i32) bshl 8) bor (p1 as i32)

            auto *a = (*addr_buf as usize + 4) as *u8
            auto *b = (*addr_buf as usize + 5) as *u8
            auto *c = (*addr_buf as usize + 6) as *u8
            auto *d = (*addr_buf as usize + 7) as *u8
            auto au = a as usize
            auto bu = b as usize
            auto cu = c as usize
            auto du = d as usize
            auto *ph# = *out_host
            ph = au bor (bu bshl 8) bor (cu bshl 16) bor (du bshl 24)
        }
        libc_free(*addr_buf as *void)
        libc_free(*addrlen as *void)
        return res
    }
}

pub fn get_eagain_impl() -> i32 {
    return 35
}

pub fn net_set_nonblocking_impl(fd: i32) -> bool {
    unsafe {
        auto flags = fcntl(fd, 3, 0)
        if flags < 0 {
            return false
        }
        return fcntl(fd, 4, flags bor 4) == 0
    }
}

pub fn reactor_create_impl() -> i32 {
    unsafe {
        return kqueue()
    }
}

pub fn reactor_add_read_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    unsafe {
        auto *ev# = unsafe alloc [32] byte as *char
        if *ev as usize == 0 {
             return false
        }

        auto base = *ev as usize

        // ident = fd (u64)
        auto *p_ident# = base as *u64
        p_ident = fd as u64

        // filter = EVFILT_READ (-1)
        auto *p_filter# = (base + 8) as *i16
        p_filter = -1:i16

        // flags = EV_ADD (1) | EV_ONESHOT (16) | EV_ENABLE (4) = 21 (0x15)
        auto *p_flags# = (base + 10) as *u16
        p_flags = 21:u16

        // fflags = 0
        auto *p_fflags# = (base + 12) as *u32
        p_fflags = 0:u32

        // data = 0
        auto *p_data# = (base + 16) as *i64
        p_data = 0

        // udata = event_key
        auto *p_udata# = (base + 24) as *Addr
        p_udata = event_key

        auto res = kevent(reactor_fd, *ev as *void, 1, 0:Addr as *void, 0, 0:Addr as *void)
        libc_free(*ev as *void)
        return res != -1
    }
}

pub fn reactor_add_write_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    unsafe {
        auto *ev# = unsafe alloc [32] byte as *char
        if *ev as usize == 0 {
             return false
        }

        auto base = *ev as usize

        // ident = fd (u64)
        auto *p_ident# = base as *u64
        p_ident = fd as u64

        // filter = EVFILT_WRITE (-2)
        auto *p_filter# = (base + 8) as *i16
        p_filter = -2:i16

        // flags = EV_ADD (1) | EV_ONESHOT (16) | EV_ENABLE (4) = 21 (0x15)
        auto *p_flags# = (base + 10) as *u16
        p_flags = 21:u16

        // fflags = 0
        auto *p_fflags# = (base + 12) as *u32
        p_fflags = 0:u32

        // data = 0
        auto *p_data# = (base + 16) as *i64
        p_data = 0

        // udata = event_key
        auto *p_udata# = (base + 24) as *Addr
        p_udata = event_key

        auto res = kevent(reactor_fd, *ev as *void, 1, 0:Addr as *void, 0, 0:Addr as *void)
        libc_free(*ev as *void)
        return res != -1
    }
}

pub fn reactor_wait_impl(reactor_fd: i32, timeout_ms: i32, *out_events: Addr, max: i32) -> i32 {
    unsafe {
        auto *events# = unsafe alloc [32 * max] byte as *void
        if *events as usize == 0 {
            return -1
        }

        auto *ts_ptr# = unsafe alloc [16] byte as *void
        if *ts_ptr as usize == 0 {
            libc_free(*events)
            return -1
        }

        auto ts_arg# = *ts_ptr as Addr
        if timeout_ms < 0 {
            ts_arg = 0:Addr
        } else {
            auto ts_base = *ts_ptr as usize
            auto *tv_sec# = ts_base as *i64
            tv_sec = (timeout_ms / 1000) as i64
            auto *tv_nsec# = (ts_base + 8) as *i64
            tv_nsec = ((timeout_ms % 1000) * 1000000) as i64
        }

        auto n = kevent(reactor_fd, 0:Addr as *void, 0, *events, max, ts_arg as *void)

        // copy udata to out_events
        auto i# = 0
        loop i < n {
            auto ev_base = *events as usize + ((32 * i) as usize)
            auto *p_udata = (ev_base + 24) as *Addr
            auto h = p_udata // value
            auto *dest# = (*out_events as usize + ((8 * i) as usize)) as *Addr
            dest = h
            i += 1
        }

        libc_free(*events)
        libc_free(*ts_ptr)
        return n
    }
}

