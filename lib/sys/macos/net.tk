import core/types::{char, usize, Addr, ADDR0}
import sys/libc::*
import sys/os/abi::*

// === Networking ===

extern fn toka_get_errno_impl() -> i32

pub fn get_last_error() -> i32 {
    unsafe {
        return toka_get_errno_impl()
    }
}

pub fn net_socket_impl() -> i32 {
    unsafe {
        return libc_socket(2, 1, 0)
    }
}

pub fn net_dup_impl(fd: i32) -> i32 {
    unsafe {
        return libc_dup(fd)
    }
}

pub fn net_socket_udp_impl() -> i32 {
    unsafe {
        return libc_socket(2, 2, 0)
    }
}

pub fn net_setsockopt_reuse_impl(fd: i32) -> i32 {
    unsafe {
        auto *opt# = unsafe alloc [4] byte as *[i32]
        opt[0] = 1
        auto res = libc_setsockopt(fd, 65535, 4, *opt as *void, 4)
        libc_free(*opt as *void)
        return res
    }
}

fn fill_sockaddr_in(*addr_buf: char, ip: u32, port: u16) -> bool {
    unsafe {
        auto base_addr = *addr_buf as usize
        auto *p_len# = base_addr as *char
        p_len = 16 as char
        auto *p1# = (base_addr + 1) as *char
        p1 = 2 as char
        auto nport = (port >> 8) | (port << 8):u16 // htons for little endian
        auto *p_port# = (base_addr + 2) as *u16
        p_port = nport
        auto *p_addr# = (base_addr + 4) as *u32
        p_addr = ip
        auto i# = 8:usize
        loop i < 16:usize {
            auto *p_z# = (base_addr + i) as *char
            p_z = 0 as char
            i += 1:usize
        }
        return true
    }
}

pub fn get_errno_impl() -> i32 {
    unsafe {
        return toka_get_errno_impl()
    }
}

pub fn net_getsockopt_error_impl(fd: i32) -> i32 {
    unsafe {
        auto pval = unsafe alloc [4] byte as Addr
        auto pvlen = unsafe alloc [4] byte as Addr
        auto *val# = pval as *i32
        auto *vlen# = pvlen as *u32
        val = 0
        vlen = 4:u32
        auto res = getsockopt(fd, 0xffff, 0x1007, pval as *void, pvlen as *u32)
        auto err = val
        libc_free(pval as *void)
        libc_free(pvlen as *void)
        if res != 0 { return -1 }
        return err
    }
}



pub fn net_bind_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        auto err# = 0:i32
        auto *sockaddr_buf# = unsafe alloc [16] u8
        auto res = toka_rt_bind_with_diag(fd, ip, port, &err as *i32, *sockaddr_buf as *u8)
        toka_set_errno_impl(err)
        libc_free(*sockaddr_buf as *void)
        return res
    }
}

pub fn net_bind_with_diag_impl(fd: i32, ip: u32, port: u16, *out_errno: i32, *out_sockaddr: u8) -> i32 {
    unsafe {
        return toka_rt_bind_with_diag(fd, ip, port, out_errno as *i32, out_sockaddr as *u8)
    }
}

pub fn net_local_port_impl(fd: i32) -> i32 {
    unsafe {
        auto err# = 0:i32
        auto port = toka_rt_local_port_with_diag(fd, &err as *i32)
        toka_set_errno_impl(err)
        return port
    }
}

pub fn net_listen_impl(fd: i32) -> i32 {
    unsafe {
        auto err# = 0:i32
        auto res = toka_rt_listen_with_diag(fd, 128:i32, &err as *i32)
        toka_set_errno_impl(err)
        return res
    }
}

pub fn net_connect_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        auto err# = 0:i32
        auto res = toka_rt_connect_with_diag(fd, ip, port, &err as *i32)
        toka_set_errno_impl(err)
        return res
    }
}

pub fn net_accept_impl(fd: i32) -> i32 {
    unsafe {
        // We ignore the peer address for now in this impl
        auto *addr_len_ptr# = unsafe alloc [4] byte as *[u32]
        addr_len_ptr[0] = 16
        auto *addr_buf# = unsafe alloc [16] byte as *void

        auto res = libc_accept(fd, *addr_buf, *addr_len_ptr as *u32)

        libc_free(*addr_len_ptr as *void)
        libc_free(*addr_buf)
        return res
    }
}

extern fn toka_trace_cleanup_fd(fd: i32) -> void

pub fn net_close_impl(fd: i32) {
    unsafe {
        if fd >= 0 {
            toka_trace_cleanup_fd(fd)
        }
        libc_close(fd)
    }
}

pub fn net_read_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        return libc_read(fd, *buf as *void, len) as i64
    }
}

pub fn net_write_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        return libc_write(fd, *buf as *void, len) as i64
    }
}

pub fn net_sendto_impl(fd: i32, *buf: u8, len: usize, host: usize, port: i32) -> i64 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char
        if *addr_buf as usize == 0 { return -1 }
        if !fill_sockaddr_in(*addr_buf, host as u32, port as u16) {
            libc_free(*addr_buf as *void)
            return -1
        }
        auto res = libc_sendto(fd, *buf as *void, len, 0, *addr_buf as *void, 16:u32)
        libc_free(*addr_buf as *void)
        return res
    }
}

pub fn net_recvfrom_impl(fd: i32, *buf: u8, len: usize, *out_host: usize, *out_port: i32) -> i64 {
    unsafe {
        auto *addr_buf# = unsafe alloc [32] byte as *char
        auto *addrlen# = unsafe alloc [4] byte as *u32
        addrlen = 16:u32

        auto res = libc_recvfrom(fd, *buf as *void, len, 0, *addr_buf as *void, *addrlen)
        if res >= 0:i64 {
            auto *p0 = (*addr_buf as usize + 2) as *u8
            auto *p1 = (*addr_buf as usize + 3) as *u8
            auto *pp# = *out_port
            pp = ((p0 as i32) << 8) | (p1 as i32)

            auto *a = (*addr_buf as usize + 4) as *u8
            auto *b = (*addr_buf as usize + 5) as *u8
            auto *c = (*addr_buf as usize + 6) as *u8
            auto *d = (*addr_buf as usize + 7) as *u8
            auto au = a as usize
            auto bu = b as usize
            auto cu = c as usize
            auto du = d as usize
            auto *ph# = *out_host
            ph = au | (bu << 8) | (cu << 16) | (du << 24)
        }
        libc_free(*addr_buf as *void)
        libc_free(*addrlen as *void)
        return res
    }
}

pub fn get_eagain_impl() -> i32 {
    return 35
}

pub fn net_set_nonblocking_impl(fd: i32) -> bool {
    unsafe {
        auto flags = fcntl(fd, 3, 0)
        if flags < 0 {
            return false
        }
        return fcntl(fd, 4, flags | 4) == 0
    }
}

extern fn toka_reactor_register_fd(rfd: i32) -> i32

pub fn reactor_create_impl() -> i32 {
    unsafe {
        auto rfd = kqueue()
        toka_reactor_register_fd(rfd)
        return rfd
    }
}

extern fn toka_reactor_del_fd(reactor_fd: i32, fd: i32) -> void
extern fn toka_reactor_del_read(reactor_fd: i32, fd: i32, expected_key: u64) -> void
extern fn toka_reactor_del_write(reactor_fd: i32, fd: i32, expected_key: u64) -> void
extern fn toka_reactor_add_read(reactor_fd: i32, fd: i32, key: u64) -> i32
extern fn toka_reactor_add_write(reactor_fd: i32, fd: i32, key: u64) -> i32

pub fn reactor_add_read_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    unsafe {
        return toka_reactor_add_read(reactor_fd, fd, event_key as u64) == 0
    }
}

pub fn reactor_add_write_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    unsafe {
        return toka_reactor_add_write(reactor_fd, fd, event_key as u64) == 0
    }
}

extern fn toka_reactor_wait(reactor_fd: i32, timeout_ms: i32, *out_events: Addr, max: i32) -> i32

pub fn reactor_wait_impl(reactor_fd: i32, timeout_ms: i32, *out_events: Addr, max: i32) -> i32 {
    unsafe {
        return toka_reactor_wait(reactor_fd, timeout_ms, *out_events, max)
    }
}

pub fn reactor_del_fd_impl(reactor_fd: i32, fd: i32) {
    unsafe {
        toka_reactor_del_fd(reactor_fd, fd)
    }
}

pub fn reactor_del_read_impl(reactor_fd: i32, fd: i32, event_key: Addr) {
    unsafe {
        toka_reactor_del_read(reactor_fd, fd, event_key as u64)
    }
}

pub fn reactor_del_write_impl(reactor_fd: i32, fd: i32, event_key: Addr) {
    unsafe {
        toka_reactor_del_write(reactor_fd, fd, event_key as u64)
    }
}
