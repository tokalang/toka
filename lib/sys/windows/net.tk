import core/types::{char, usize, Addr, ADDR0}
import sys/libc::*
import sys/os/abi::*

pub fn get_last_error() -> i32 {
    unsafe { return WSAGetLastError() }
}

pub fn get_errno_impl() -> i32 {
    unsafe { return WSAGetLastError() }
}

pub fn get_eagain_impl() -> i32 {
    return 10035 // WSAEWOULDBLOCK
}

pub fn net_socket_impl() -> i32 {
    unsafe {
        toka_ensure_wsa_initialized()
        return socket(2, 1, 0)
    }
}

pub fn net_dup_impl(fd: i32) -> i32 {
    unsafe {
        return libc_dup(fd)
    }
}

pub fn net_socket_udp_impl() -> i32 {
    unsafe {
        toka_ensure_wsa_initialized()
        return socket(2, 2, 0)
    }
}

pub fn net_setsockopt_reuse_impl(fd: i32) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto *opt# = unsafe alloc [4] byte as *[i32]
        opt[0] = 1
        auto res = setsockopt(fd, 0xFFFF, 4, *opt as *void, 4)
        libc_free(*opt as *void)
        return res
    }
}

fn fill_sockaddr_in(*addr_buf: char, ip: usize, port: i32) -> bool {
    unsafe {
        auto base_addr = *addr_buf as usize

        // Offset 0: family = 2 (u16)
        auto *p_family# = base_addr as *u16
        p_family = 2:u16

        // Offset 2: port (u16)
        auto nport = libc_htons(port as u16):u16
        auto *p_port# = (base_addr + 2) as *u16
        p_port = nport

        // Offset 4: addr (u32)
        auto *p_addr# = (base_addr + 4) as *u32
        p_addr = ip as u32

        // Offset 8..16: Zero
        auto i# = 8:usize
        loop i < 16:usize {
            auto *p_z# = (base_addr + i) as *char
            p_z = 0 as char
            i += 1:usize
        }
        return true
    }
}

pub fn net_bind_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto err# = 0:i32
        auto *sockaddr_buf# = unsafe alloc [16] u8
        auto res = toka_rt_bind_with_diag(fd, ip, port, &err as *i32, *sockaddr_buf as *u8)
        toka_set_errno_impl(err)
        libc_free(*sockaddr_buf as *void)
        return res
    }
}

pub fn net_local_port_impl(fd: i32) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto err# = 0:i32
        auto port = toka_rt_local_port_with_diag(fd, &err as *i32)
        toka_set_errno_impl(err)
        return port
    }
}

pub fn net_listen_impl(fd: i32) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto err# = 0:i32
        auto res = toka_rt_listen_with_diag(fd, 128:i32, &err as *i32)
        toka_set_errno_impl(err)
        return res
    }
}

pub fn net_connect_impl(fd: i32, ip: u32, port: u16) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto err# = 0:i32
        auto res = toka_rt_connect_with_diag(fd, ip, port, &err as *i32)
        toka_set_errno_impl(err)
        return res
    }
}

pub fn net_accept_impl(fd: i32) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto *addr_len_ptr# = unsafe alloc [4] byte as *[i32]
        addr_len_ptr[0] = 16
        auto *addr_buf# = unsafe alloc [16] byte as *void

        auto res = accept(fd, *addr_buf, *addr_len_ptr as *i32)

        libc_free(*addr_len_ptr as *void)
        libc_free(*addr_buf)
        return res
    }
}

pub fn net_close_impl(fd: i32) {
    if fd == -1 { return }
    unsafe {
        closesocket(fd)
    }
}

pub fn net_read_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        if fd == -1 { return -1 }
        return recv(fd, *buf as *void, len as i32, 0) as i64
    }
}

pub fn net_write_impl(fd: i32, *buf: u8, len: usize) -> i64 {
    unsafe {
        if fd == -1 { return -1 }
        return send(fd, *buf as *void, len as i32, 0) as i64
    }
}

pub fn net_sendto_impl(fd: i32, *buf: u8, len: usize, host: usize, port: i32) -> i64 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto *addr_buf# = unsafe alloc [32] byte as *char
        if *addr_buf as usize == 0 { return -1 }
        if !fill_sockaddr_in(*addr_buf, host, port) {
            libc_free(*addr_buf as *void)
            return -1
        }
        auto res = sendto(fd, *buf as *void, len as i32, 0, *addr_buf as *void, 16)
        libc_free(*addr_buf as *void)
        return res as i64
    }
}

pub fn net_recvfrom_impl(fd: i32, *buf: u8, len: usize, *out_host: usize, *out_port: i32) -> i64 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto *addr_buf# = unsafe alloc [32] byte as *char
        auto *addrlen# = unsafe alloc [4] byte as *i32
        addrlen = 16

        auto res = recvfrom(fd, *buf as *void, len as i32, 0, *addr_buf as *void, *addrlen)
        if res >= 0 {
            auto *p0 = (*addr_buf as usize + 2) as *u8
            auto *p1 = (*addr_buf as usize + 3) as *u8
            auto *pp# = *out_port
            pp = ((p0 as i32) << 8) | (p1 as i32)

            auto *a = (*addr_buf as usize + 4) as *u8
            auto *b = (*addr_buf as usize + 5) as *u8
            auto *c = (*addr_buf as usize + 6) as *u8
            auto *d = (*addr_buf as usize + 7) as *u8
            auto au = a as usize
            auto bu = b as usize
            auto cu = c as usize
            auto du = d as usize
            auto *ph# = *out_host
            ph = au | (bu << 8) | (cu << 16) | (du << 24)
        }
        libc_free(*addr_buf as *void)
        libc_free(*addrlen as *void)
        return res as i64
    }
}

pub fn net_getsockopt_error_impl(fd: i32) -> i32 {
    unsafe {
        if fd == -1 { return -1 }
        toka_ensure_wsa_initialized()
        auto pval = unsafe alloc [4] byte as Addr
        auto pvlen = unsafe alloc [4] byte as Addr
        auto *val# = pval as *i32
        auto *vlen# = pvlen as *i32
        val = 0
        vlen = 4
        auto res = getsockopt(fd, 0xFFFF, 0x1007, pval as *void, pvlen as *i32)
        auto err = val
        libc_free(pval as *void)
        libc_free(pvlen as *void)
        if res != 0 { return -1 }
        return err
    }
}

pub fn net_set_nonblocking_impl(fd: i32) -> bool {
    unsafe {
        if fd == -1 { return false }
        toka_ensure_wsa_initialized()
        auto mode# = 1:u32
        return ioctlsocket(fd, 0x8004667e:u32, *(mode) as *u32) == 0
    }
}

pub shape WinReactor (
    fds: Addr,
    coros: Addr,
    is_write: Addr,
    count#: i32,
    capacity: i32
)

auto g_win_reactor# = 0:Addr

fn win_reactor_add(fd: i32, coro: Addr, is_write: bool) -> bool {
    unsafe {
        if g_win_reactor == 0:Addr {
            auto *r# = libc_malloc(sizeof(WinReactor)) as *WinReactor
            r.fds = libc_malloc(128 * 4:usize) as Addr
            r.coros = libc_malloc(128 * 8:usize) as Addr
            r.is_write = libc_malloc(128 * 4:usize) as Addr
            r.count = 0
            r.capacity = 128
            g_win_reactor = *r as Addr
        }

        auto *r# = g_win_reactor as *WinReactor
        // Check if already exists
        auto i# = 0
        loop i < r.count {
            auto *p_fd = (r.fds as usize + (i as usize) * 4:usize) as *i32
            auto *p_is_write = (r.is_write as usize + (i as usize) * 4:usize) as *i32

            auto expected_is_write# = 0:i32
            if is_write {
                expected_is_write = 1
            }

            if p_fd == fd && p_is_write == expected_is_write {
                auto *p_coro# = (r.coros as usize + (i as usize) * 8:usize) as *Addr
                p_coro = coro
                if is_write {
                    toka_reactor_add_write(0, fd, coro as u64)
                } else {
                    toka_reactor_add_read(0, fd, coro as u64)
                }
                return true
            }
            i += 1
        }

        // Strict boundary check (Max 64 concurrent descriptors in Windows select)
        if r.count >= 64 {
            auto msg = "Windows Select Reactor capacity exceeded (Max 64 concurrent descriptors)":str
            toka_panic(msg.raw_ptr() as *char, msg.len() as i32)
            return false
        }

        auto *p_fd# = (r.fds as usize + (r.count as usize) * 4:usize) as *i32
        p_fd = fd
        auto *p_coro# = (r.coros as usize + (r.count as usize) * 8:usize) as *Addr
        p_coro = coro

        auto is_w# = 0:i32
        if is_write {
            is_w = 1
        }
        auto *p_is_write# = (r.is_write as usize + (r.count as usize) * 4:usize) as *i32
        p_is_write = is_w

        if is_write {
            toka_reactor_add_write(0, fd, coro as u64)
        } else {
            toka_reactor_add_read(0, fd, coro as u64)
        }

        r.count = r.count + 1
        return true
    }
}

pub fn reactor_create_impl() -> i32 {
    unsafe {
        if g_win_reactor == 0:Addr {
            auto *r# = libc_malloc(sizeof(WinReactor)) as *WinReactor
            r.fds = libc_malloc(128 * 4:usize) as Addr
            r.coros = libc_malloc(128 * 8:usize) as Addr
            r.is_write = libc_malloc(128 * 4:usize) as Addr
            r.count = 0
            r.capacity = 128
            g_win_reactor = *r as Addr
        }
        return 1
    }
}

pub fn reactor_add_read_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    return win_reactor_add(fd, event_key, false)
}

pub fn reactor_add_write_impl(reactor_fd: i32, fd: i32, event_key: Addr) -> bool {
    return win_reactor_add(fd, event_key, true)
}

pub fn reactor_wait_impl(reactor_fd: i32, timeout_ms: i32, *out_events: Addr, max: i32) -> i32 {
    unsafe {
        if g_win_reactor == 0:Addr {
            if timeout_ms > 0 {
                libc_usleep((timeout_ms * 1000) as u32)
            }
            return 0
        }

        auto *r# = g_win_reactor as *WinReactor
        if r.count == 0 {
            if timeout_ms > 0 {
                libc_usleep((timeout_ms * 1000) as u32)
            }
            return 0
        }

        auto *readfds# = libc_malloc(1024) as *char
        auto *writefds# = libc_malloc(1024) as *char
        auto *exceptfds# = libc_malloc(1024) as *char

        auto *read_count# = *readfds as *u32
        read_count = 0:u32
        auto *write_count# = *writefds as *u32
        write_count = 0:u32
        auto *except_count# = *exceptfds as *u32
        except_count = 0:u32

        // Populate fd_sets
        auto idx# = 0
        loop idx < r.count {
            auto *p_fd = (r.fds as usize + (idx as usize) * 4:usize) as *i32
            auto *p_is_write = (r.is_write as usize + (idx as usize) * 4:usize) as *i32
            auto fd_val = p_fd

            auto is_w = p_is_write
            if is_w == 0 {
                auto rc = read_count
                auto *p_sock# = (*readfds as usize + 8:usize + (rc as usize) * 8:usize) as *Addr
                p_sock = fd_val as Addr
                read_count = rc + 1:u32
            } else {
                auto wc = write_count
                auto *p_sock# = (*writefds as usize + 8:usize + (wc as usize) * 8:usize) as *Addr
                p_sock = fd_val as Addr
                write_count = wc + 1:u32

                auto ec = except_count
                auto *p_sock_ex# = (*exceptfds as usize + 8:usize + (ec as usize) * 8:usize) as *Addr
                p_sock_ex = fd_val as Addr
                except_count = ec + 1:u32
            }
            idx += 1
        }

        auto *tv# = libc_malloc(8) as *i32
        auto *tv_sec# = *tv as *i32
        tv_sec = timeout_ms / 1000
        auto *tv_usec# = (*tv as usize + 4:usize) as *i32
        tv_usec = (timeout_ms % 1000) * 1000

        auto *readfds_u32 = *readfds as *u32
        auto rf_count = readfds_u32
        auto *socket_u64 = (*readfds as usize + 8:usize) as *u64
        auto sock_val = socket_u64
        libc_printf(c"reactor_wait_impl: count=%d, readfds_count=%u, socket0=%llu\n", r.count, rf_count, sock_val)
        auto res = select(0, *readfds as *void, *writefds as *void, *exceptfds as *void, *tv as *void)
        if res < 0 {
            libc_printf(c"select failed, error: %d\n", WSAGetLastError())
        }

        auto n_out# = 0
        if res > 0 {
            // Process ready read events
            auto rc = read_count
            auto i# = 0:u32
            loop i < rc {
                auto *p_sock = (*readfds as usize + 8:usize + (i as usize) * 8:usize) as *Addr
                auto sock_fd = p_sock as i32

                auto k# = 0
                loop k < r.count {
                    auto *p_fd = (r.fds as usize + (k as usize) * 4:usize) as *i32
                    auto *p_is_write = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                    auto fd_val = p_fd
                    auto is_w = p_is_write
                    if fd_val == sock_fd && is_w == 0 {
                        auto *p_coro = (r.coros as usize + (k as usize) * 8:usize) as *Addr

                        if n_out < max {
                            auto *out_ev# = (*out_events as usize + (n_out as usize) * 8:usize) as *Addr
                            out_ev = p_coro
                            n_out = n_out + 1
                        }

                        if k < r.count - 1 {
                            auto last_idx = (r.count - 1) as usize
                            auto *last_fd = (r.fds as usize + last_idx * 4:usize) as *i32
                            auto *last_coro = (r.coros as usize + last_idx * 8:usize) as *Addr
                            auto *last_is_write = (r.is_write as usize + last_idx * 4:usize) as *i32

                            auto *curr_fd# = (r.fds as usize + (k as usize) * 4:usize) as *i32
                            curr_fd = last_fd
                            auto *curr_coro# = (r.coros as usize + (k as usize) * 8:usize) as *Addr
                            curr_coro = last_coro
                            auto *curr_is_write# = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                            curr_is_write = last_is_write
                        }
                        r.count = r.count - 1
                        break
                    }
                    k += 1
                }
                i += 1
            }

            // Process ready write events
            auto wc = write_count
            auto j# = 0:u32
            loop j < wc {
                auto *p_sock = (*writefds as usize + 8:usize + (j as usize) * 8:usize) as *Addr
                auto sock_fd = p_sock as i32

                auto k# = 0
                loop k < r.count {
                    auto *p_fd = (r.fds as usize + (k as usize) * 4:usize) as *i32
                    auto *p_is_write = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                    auto fd_val = p_fd
                    auto is_w = p_is_write
                    if fd_val == sock_fd && is_w == 1 {
                        auto *p_coro = (r.coros as usize + (k as usize) * 8:usize) as *Addr

                        if n_out < max {
                            auto *out_ev# = (*out_events as usize + (n_out as usize) * 8:usize) as *Addr
                            out_ev = p_coro
                            n_out = n_out + 1
                        }

                        if k < r.count - 1 {
                            auto last_idx = (r.count - 1) as usize
                            auto *last_fd = (r.fds as usize + last_idx * 4:usize) as *i32
                            auto *last_coro = (r.coros as usize + last_idx * 8:usize) as *Addr
                            auto *last_is_write = (r.is_write as usize + last_idx * 4:usize) as *i32

                            auto *curr_fd# = (r.fds as usize + (k as usize) * 4:usize) as *i32
                            curr_fd = last_fd
                            auto *curr_coro# = (r.coros as usize + (k as usize) * 8:usize) as *Addr
                            curr_coro = last_coro
                            auto *curr_is_write# = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                            curr_is_write = last_is_write
                        }
                        r.count = r.count - 1
                        break
                    }
                    k += 1
                }
                j += 1
            }

            // Process ready exception events (connection failures)
            auto ec = except_count
            auto j_ex# = 0:u32
            loop j_ex < ec {
                auto *p_sock = (*exceptfds as usize + 8:usize + (j_ex as usize) * 8:usize) as *Addr
                auto sock_fd = p_sock as i32

                auto k# = 0
                loop k < r.count {
                    auto *p_fd = (r.fds as usize + (k as usize) * 4:usize) as *i32
                    auto *p_is_write = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                    auto fd_val = p_fd
                    auto is_w = p_is_write
                    if fd_val == sock_fd && is_w == 1 {
                        auto *p_coro = (r.coros as usize + (k as usize) * 8:usize) as *Addr

                        if n_out < max {
                            auto *out_ev# = (*out_events as usize + (n_out as usize) * 8:usize) as *Addr
                            out_ev = p_coro
                            n_out = n_out + 1
                        }

                        if k < r.count - 1 {
                            auto last_idx = (r.count - 1) as usize
                            auto *last_fd = (r.fds as usize + last_idx * 4:usize) as *i32
                            auto *last_coro = (r.coros as usize + last_idx * 8:usize) as *Addr
                            auto *last_is_write = (r.is_write as usize + last_idx * 4:usize) as *i32

                            auto *curr_fd# = (r.fds as usize + (k as usize) * 4:usize) as *i32
                            curr_fd = last_fd
                            auto *curr_coro# = (r.coros as usize + (k as usize) * 8:usize) as *Addr
                            curr_coro = last_coro
                            auto *curr_is_write# = (r.is_write as usize + (k as usize) * 4:usize) as *i32
                            curr_is_write = last_is_write
                        }
                        r.count = r.count - 1
                        break
                    }
                    k += 1
                }
                j_ex += 1
            }
        }

        libc_free(*readfds as *void)
        libc_free(*writefds as *void)
        libc_free(*exceptfds as *void)
        libc_free(*tv as *void)
        return n_out
    }
}

fn win_reactor_del(fd: i32, is_write_val: i32, expected_key: Addr) {
    unsafe {
        if g_win_reactor == 0:Addr { return }
        auto *r# = g_win_reactor as *WinReactor
        auto i# = 0
        loop i < r.count {
            auto *curr_fd = (r.fds as usize + (i as usize) * 4:usize) as *i32
            auto *curr_coro = (r.coros as usize + (i as usize) * 8:usize) as *Addr
            auto *curr_is_write = (r.is_write as usize + (i as usize) * 4:usize) as *i32
            if curr_fd == fd && (is_write_val == -1 || curr_is_write == is_write_val) {
                if expected_key != 0:Addr && curr_coro != expected_key {
                    i += 1
                    continue
                }
                if i < r.count - 1 {
                    auto last_idx = (r.count - 1) as usize
                    auto *last_fd = (r.fds as usize + last_idx * 4:usize) as *i32
                    auto *last_coro = (r.coros as usize + last_idx * 8:usize) as *Addr
                    auto *last_is_write = (r.is_write as usize + last_idx * 4:usize) as *i32

                    auto *target_fd# = (r.fds as usize + (i as usize) * 4:usize) as *i32
                    target_fd = last_fd
                    auto *target_coro# = (r.coros as usize + (i as usize) * 8:usize) as *Addr
                    target_coro = last_coro
                    auto *target_is_write# = (r.is_write as usize + (i as usize) * 4:usize) as *i32
                    target_is_write = last_is_write
                }
                if is_write_val == 1 {
                    toka_reactor_del_write(0, fd, expected_key as u64)
                } else if is_write_val == 0 {
                    toka_reactor_del_read(0, fd, expected_key as u64)
                } else {
                    toka_reactor_del_fd(0, fd)
                }
                r.count = r.count - 1
                continue
            }
            i += 1
        }
    }
}

pub fn reactor_del_fd_impl(reactor_fd: i32, fd: i32) {
    unsafe {
        win_reactor_del(fd, -1, 0:Addr)
        toka_reactor_del_fd(0, fd)
    }
}

pub fn reactor_del_read_impl(reactor_fd: i32, fd: i32, event_key: Addr) {
    unsafe {
        win_reactor_del(fd, 0, event_key)
        toka_reactor_del_read(0, fd, event_key as u64)
    }
}

pub fn reactor_del_write_impl(reactor_fd: i32, fd: i32, event_key: Addr) {
    unsafe {
        win_reactor_del(fd, 1, event_key)
        toka_reactor_del_write(0, fd, event_key as u64)
    }
}
