import core/types::{usize, Addr, ADDR0}
import core/option::{Option}
import sys/libc::{libc_malloc, libc_free}
import sys/os/abi::*
import sys/os/base::{to_utf16, from_utf16}

pub shape WIN32_FIND_DATAW (
    dwFileAttributes: u32,
    ftCreationTime_dwLowDateTime: u32,
    ftCreationTime_dwHighDateTime: u32,
    ftLastAccessTime_dwLowDateTime: u32,
    ftLastAccessTime_dwHighDateTime: u32,
    ftLastWriteTime_dwLowDateTime: u32,
    ftLastWriteTime_dwHighDateTime: u32,
    nFileSizeHigh: u32,
    nFileSizeLow: u32,
    dwReserved0: u32,
    dwReserved1: u32,
    cFileName: [u16; 260],
    cAlternateFileName: [u16; 14]
)

pub shape WinDir (
    handle#: HANDLE,
    find_data#: WIN32_FIND_DATAW,
    first#: bool
)

pub fn opendir_impl(path: Addr) -> Addr {
    unsafe {
        auto path_str = string::from_cstr(path as *char)
        auto path_normalized = path_str.replace('/' as char, '\\' as char)
        
        // FindFirstFile needs a wildcard like \*
        auto search_path# = path_normalized.clone()
        if !search_path.ends_with("\\") {
            search_path#.push_str("\\")
        }
        auto star = string::from("*")
        search_path#.push_str(star.as_str())
        auto *wsearch = to_utf16(search_path.c_str())
        
        auto *wd# = libc_malloc(sizeof(WinDir)) as *WinDir
        auto h = FindFirstFileW(*wsearch, *(wd.find_data) as Addr)
        
        libc_free(*wsearch as *void)
        
        if h as Addr == 0xFFFFFFFFFFFFFFFF:Addr {
            libc_free(*wd as *void)
            return ADDR0
        }
        
        wd.handle = h
        wd.first = true
        return *wd as Addr
    }
}

pub fn readdir_impl(dir_handle: Addr) -> Option<string> {
    unsafe {
        auto *wd = dir_handle as *WinDir
        if wd.first {
            wd.first = false
            return Option<string>::Some(from_utf16(*(wd.find_data.cFileName[0])))
        }
        
        if FindNextFileW(wd.handle, *(wd.find_data) as Addr) != 0 {
            return Option<string>::Some(from_utf16(*(wd.find_data.cFileName[0])))
        }
        
        return Option<string>::None
    }
}

pub fn closedir_impl(dir_handle: Addr) {
    unsafe {
        auto *wd = dir_handle as *WinDir
        FindClose(wd.handle)
        libc_free(dir_handle as *void)
    }
}

pub fn mkdir_impl(path: Addr) -> bool {
    unsafe {
        auto path_str = string::from_cstr(path as *char)
        auto path_normalized = path_str.replace('/' as char, '\\' as char)
        auto *wpath = to_utf16(path_normalized.c_str())
        auto res = CreateDirectoryW(*wpath, ADDR0)
        libc_free(*wpath as *void)
        return res != 0
    }
}

pub fn rmdir_impl(path: Addr) -> bool {
    unsafe {
        auto path_str = string::from_cstr(path as *char)
        auto path_normalized = path_str.replace('/' as char, '\\' as char)
        auto *wpath = to_utf16(path_normalized.c_str())
        auto res = RemoveDirectoryW(*wpath)
        libc_free(*wpath as *void)
        return res != 0
    }
}

pub fn path_exists(path: Addr) -> bool {
    unsafe {
        auto path_str = string::from_cstr(path as *char)
        auto path_normalized# = path_str.replace('/' as char, '\\' as char)
        auto len = path_normalized.len()
        if len > 3 && path_normalized.ends_with("\\") {
            path_normalized = path_normalized.substring(0, (len - 1) as i32)
        }
        auto *wpath = to_utf16(path_normalized.c_str())
        auto res = GetFileAttributesW(*wpath)
        libc_free(*wpath as *void)
        return res != 0xFFFFFFFF:u32
    }
}

// The runtime currently returns failure on Windows until its UTF-16 atomic
// replacement adapter is introduced; std/fs exposes that as Result::Err.
pub fn atomic_write_string_impl(path: string, content: string) -> bool {
    auto *path_ptr# = path.c_str()
    auto *data_ptr# = content.c_str() as *u8
    return unsafe toka_atomic_write_file(*path_ptr, *data_ptr, content.len()) == 0
}

pub shape WinStat (
    size: u64,
    mode: u32,
    mtime: i64
)

pub fn stat_impl(path: Addr) -> Addr {
    unsafe {
        auto path_str = string::from_cstr(path as *char)
        auto path_normalized# = path_str.replace('/' as char, '\\' as char)
        auto len = path_normalized.len()
        if len > 3 && path_normalized.ends_with("\\") {
            path_normalized = path_normalized.substring(0, (len - 1) as i32)
        }
        auto *wpath = to_utf16(path_normalized.c_str())
        auto attr = GetFileAttributesW(*wpath)
        if attr == 0xFFFFFFFF:u32 {
            libc_free(*wpath as *void)
            return ADDR0
        }
        
        auto *ws# = libc_malloc(sizeof(WinStat)) as *WinStat
        ws.size = 0
        ws.mode = 0x8000 // REG
        auto is_dir = (attr band 0x00000010:u32) != 0
        if is_dir {
            ws.mode = 0x4000 // DIR
        } else {
            auto *fd# = libc_malloc(sizeof(WIN32_FIND_DATAW)) as *WIN32_FIND_DATAW
            auto h = FindFirstFileW(*wpath, *fd as Addr)
            if h as Addr != 0xFFFFFFFFFFFFFFFF:Addr {
                ws.size = ((fd.nFileSizeHigh as u64) bshl 32) bor (fd.nFileSizeLow as u64)
                FindClose(h)
            }
            libc_free(*fd as *void)
        }
        ws.mtime = 0
        
        libc_free(*wpath as *void)
        return *ws as Addr
    }
}

pub fn stat_free_impl(handle: Addr) {
    unsafe { libc_free(handle as *void) }
}

pub fn stat_get_mode_impl(handle: Addr) -> u32 {
    unsafe {
        auto *ws = handle as *WinStat
        return ws.mode
    }
}

pub fn stat_get_size_impl(handle: Addr) -> u64 {
    unsafe {
        auto *ws = handle as *WinStat
        return ws.size
    }
}

pub fn stat_get_mtime_impl(handle: Addr) -> i64 {
    unsafe {
        auto *ws = handle as *WinStat
        return ws.mtime
    }
}

pub fn stat_is_dir_impl(mode: u32) -> bool {
    return (mode band 0x4000) != 0
}

pub fn stat_is_file_impl(mode: u32) -> bool {
    return (mode band 0x8000) != 0
}
