fn plan_to_json('plan: RebuildPlan) -> string {
    auto buf# = string::from("")
    buf#.push_str("{\"status\":")
    json_write_string('plan.status.as_str(), buf)
    buf#.push_str(",\"dirty_roots\":[")
    auto i# = 0:usize
    loop i < 'plan.dirty_roots.len() {
        if i > 0 { buf#.push_str(",") }
        json_write_string('plan.dirty_roots.get_ref(i).as_str(), buf)
        i += 1
    }
    buf#.push_str("],\"dirty_modules\":{")
    auto iter# = 'plan.dirty_modules.iter()
    auto first# = true
    loop {
        auto opt = iter#.next_ref()
        if opt.is_none() { break }
        auto entry = opt.unwrap()
        if !first { buf#.push_str(",") }
        first = false
        auto &key = entry.key()
        json_write_string(key.as_str(), buf)
        buf#.push_str(":")
        auto &val = entry.val()
        auto info_str = info_to_json(val)
        buf#.push_str(info_str.as_str())
    }
    buf#.push_str("}}")
    return buf
}

impl RebuildPlan@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes {
