pub shape ModuleOutputs (
    interface: string = string::from(""),
    object: string = string::from(""),
    executable: string = string::from("")
)

impl ModuleOutputs@encap {
    pub(build/internal/codec) interface
    pub(build/internal/codec) object
    pub(build/internal/codec) executable

    fn drop(self#) { }
    pub fn clone(self) -> ModuleOutputs {
        return ModuleOutputs(
            interface = self.interface.clone(),
            object = self.object.clone(),
            executable = self.executable.clone()
        )
    }
}

fn json_write_string(s: str, buf#: string) {
    buf#.push_str("\"")
    buf#.push_str(s)
    buf#.push_str("\"")
}
fn outputs_to_json(outputs: ModuleOutputs, buf#: string) -> string {
    buf#.push_str("{\"interface\":")
    json_write_string(outputs.interface.as_str(), buf)
    buf#.push_str(",\"object\":")
    json_write_string(outputs.object.as_str(), buf)
    buf#.push_str(",\"executable\":")
    json_write_string(outputs.executable.as_str(), buf)
    buf#.push_str("}")
    return buf
}
impl ModuleOutputs@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        return __deserialize_nested_shape<ModuleOutputs>(self, json)
    }
}

pub shape ModuleSnapshot (
    kind: string = string::from(""),
    fallback_triggered: bool = false,
    cache_status: string = string::from(""),
    cache_status_reason: string = string::from(""),
    target_triple: string = string::from(""),
    compiler_version: string = string::from(""),
    interface_version: string = string::from(""),
    source_hash: string = string::from(""),
    content_hash: string = string::from(""),
    outputs: ModuleOutputs = ModuleOutputs(),
    dependencies: Vec<string> = Vec<string>::new()
)

impl ModuleSnapshot@encap {
    pub(build/internal/codec) kind
    pub(build/internal/codec) fallback_triggered
    pub(build/internal/codec) cache_status
    pub(build/internal/codec) cache_status_reason
    pub(build/internal/codec) target_triple
    pub(build/internal/codec) compiler_version
    pub(build/internal/codec) interface_version
    pub(build/internal/codec) source_hash
    pub(build/internal/codec) content_hash
    pub(build/internal/codec) outputs
    pub(build/internal/codec) dependencies

    fn drop(self#) { }
    pub fn clone(self) -> ModuleSnapshot {
        auto c_dependencies# = Vec<string>::new()
        auto i# = 0:usize
        loop i < self.dependencies.len() {
            c_dependencies#.push(cede self.dependencies.get_ref(i).clone())
            i += 1
        }
        return ModuleSnapshot(
            kind = self.kind.clone(),
            fallback_triggered = self.fallback_triggered,
            cache_status = self.cache_status.clone(),
            cache_status_reason = self.cache_status_reason.clone(),
            target_triple = self.target_triple.clone(),
            compiler_version = self.compiler_version.clone(),
            interface_version = self.interface_version.clone(),
            source_hash = self.source_hash.clone(),
            content_hash = self.content_hash.clone(),
            outputs = self.outputs.clone(),
            dependencies = cede c_dependencies
        )
    }
}

fn snapshot_to_json(snapshot: ModuleSnapshot, buf#: string) -> string {
    buf#.push_str("{\"kind\":")
    json_write_string(snapshot.kind.as_str(), buf)
    buf#.push_str(",\"fallback_triggered\":")
    if snapshot.fallback_triggered { buf#.push_str("true") } else { buf#.push_str("false") }
    buf#.push_str(",\"cache_status\":")
    json_write_string(snapshot.cache_status.as_str(), buf)
    buf#.push_str(",\"cache_status_reason\":")
    json_write_string(snapshot.cache_status_reason.as_str(), buf)
    buf#.push_str(",\"target_triple\":")
    json_write_string(snapshot.target_triple.as_str(), buf)
    buf#.push_str(",\"compiler_version\":")
    json_write_string(snapshot.compiler_version.as_str(), buf)
    buf#.push_str(",\"interface_version\":")
    json_write_string(snapshot.interface_version.as_str(), buf)
    buf#.push_str(",\"source_hash\":")
    json_write_string(snapshot.source_hash.as_str(), buf)
    buf#.push_str(",\"content_hash\":")
    json_write_string(snapshot.content_hash.as_str(), buf)
    buf#.push_str(",\"outputs\":")
    buf = outputs_to_json(snapshot.outputs.clone(), buf)
    buf#.push_str(",\"dependencies\":[")
    auto i# = 0:usize
    loop i < snapshot.dependencies.len() {
        if i > 0 { buf#.push_str(",") }
        json_write_string(snapshot.dependencies.get_ref(i).as_str(), buf)
        i += 1
    }
    buf#.push_str("]}")
    return buf
}

impl ModuleSnapshot@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        return __deserialize_nested_shape<ModuleSnapshot>(self, json)
    }
}

pub shape DependencyManifest (
    manifest_version: string = string::from(""),
    roots: Vec<string> = Vec<string>::new(),
    modules: HashMap<string, ModuleSnapshot> = HashMap<string, ModuleSnapshot>::new()
)

impl DependencyManifest@encap {
    pub(build/internal/codec) manifest_version
    pub(build/internal/codec) roots
    pub(build/internal/codec) modules

    fn drop(self#) { }
    pub fn clone(self) -> DependencyManifest {
        auto c_roots# = Vec<string>::new()
        auto i# = 0:usize
        loop i < self.roots.len() {
            c_roots#.push(cede self.roots.get_ref(i).clone())
            i += 1
        }
        auto c_modules# = HashMap<string, ModuleSnapshot>::new()
        auto iter# = self.modules.iter()
        loop {
            auto entry_opt = iter#.next_ref()
            if entry_opt.is_none() { break }
            auto entry = entry_opt.unwrap()
            auto &key = entry.key()
            auto &val = entry.val()
            c_modules#.insert(cede key.clone(), cede val.clone())
        }
        return DependencyManifest(
            manifest_version = self.manifest_version.clone(),
            roots = cede c_roots,
            modules = cede c_modules
        )
    }
}

fn manifest_to_json(manifest: DependencyManifest, buf#: string) -> string {
    buf#.push_str("{\"manifest_version\":")
    json_write_string(manifest.manifest_version.as_str(), buf)
    buf#.push_str(",\"roots\":[")
    auto i# = 0:usize
    loop i < manifest.roots.len() {
        if i > 0 { buf#.push_str(",") }
        json_write_string(manifest.roots.get_ref(i).as_str(), buf)
        i += 1
    }
    buf#.push_str("],\"modules\":{")
    auto iter# = manifest.modules.iter()
    auto first# = true
    loop {
        auto opt = iter#.next_ref()
        if opt.is_none() { break }
        auto entry = opt.unwrap()
        if !first { buf#.push_str(",") }
        first = false
        auto &key = entry.key()
        json_write_string(key.as_str(), buf)
        buf#.push_str(":")
        auto &val = entry.val()
        buf = snapshot_to_json(val.clone(), buf)
    }
    buf#.push_str("}}")
    return buf
}

impl DependencyManifest@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        return __deserialize_nested_shape<DependencyManifest>(self, json)
    }
}

