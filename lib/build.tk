pub shape RebuildPlan (
    status: string = string::from(""),
    dirty_roots: Vec<string> = Vec<string>::new(),
    dirty_modules: HashMap<string, RebuildModuleInfo> = HashMap<string, RebuildModuleInfo>::new()
)

impl RebuildPlan@encap {
    pub(build/internal/codec) status
    pub(build/internal/codec) dirty_roots
    pub(build/internal/codec) dirty_modules

    fn drop(self#) { }
    pub fn clone(self) -> RebuildPlan {
        auto c_dirty_roots# = Vec<string>::new()
        auto i# = 0:usize
        loop i < self.dirty_roots.len() {
            c_dirty_roots#.push(cede self.dirty_roots.get_ref(i).clone())
            i += 1
        }
        auto c_dirty_modules# = HashMap<string, RebuildModuleInfo>::new()
        auto iter# = self.dirty_modules.iter()
        loop {
            auto entry_opt = iter#.next_ref()
            if entry_opt.is_none() { break }
            auto entry = entry_opt.unwrap()
            auto &key = entry.key()
            auto &val = entry.val()
            c_dirty_modules#.insert(cede key.clone(), cede val.clone())
        }
        return RebuildPlan(
            status = self.status.clone(),
            dirty_roots = cede c_dirty_roots,
            dirty_modules = cede c_dirty_modules
        )
    }
}

fn plan_to_json('plan: RebuildPlan) -> string {
    auto buf# = string::from("")
    buf#.push_str("{\"status\":")
    json_write_string('plan.status.as_str(), buf)
    buf#.push_str(",\"dirty_roots\":[")
    auto i# = 0:usize
    loop i < 'plan.dirty_roots.len() {
        if i > 0 { buf#.push_str(",") }
        json_write_string('plan.dirty_roots.get_ref(i).as_str(), buf)
        i += 1
    }
    buf#.push_str("],\"dirty_modules\":{")
    auto iter# = 'plan.dirty_modules.iter()
    auto first# = true
    loop {
        auto opt = iter#.next_ref()
        if opt.is_none() { break }
        auto entry = opt.unwrap()
        if !first { buf#.push_str(",") }
        first = false
        auto &key = entry.key()
        json_write_string(key.as_str(), buf)
        buf#.push_str(":")
        auto &val = entry.val()
        auto info_str = info_to_json(val)
        buf#.push_str(info_str.as_str())
    }
    buf#.push_str("}}")
    return buf
}

impl RebuildPlan@FromJson {
    pub fn parse_json(self#, json: str) -> JsonRes <- json {
        return __deserialize_nested_shape<RebuildPlan>(self, json)
    }
}

pub shape DfsResult (
    is_dirty: bool = false,
    reason: string = string::from(""),
    chain: Vec<string> = Vec<string>::new()
)

impl DfsResult@encap {
    fn drop(self#) { }
    pub fn clone(self) -> DfsResult {
        auto c_chain# = Vec<string>::new()
        auto i# = 0:usize
        loop i < self.chain.len() {
            c_chain#.push(cede self.chain.get_ref(i).clone())
            i += 1
        }
        return DfsResult(
            is_dirty = self.is_dirty,
            reason = cede self.reason.clone(),
            chain = cede c_chain
        )
    }
}

fn vec_contains('vec: Vec<string>, 'item: string) -> bool {
    auto i# = 0:usize
    loop i < 'vec.len() {
        if 'vec.get_ref(i).as_str().equals('item.as_str()) {
            return true
        }
        i += 1
    }
    return false
}

fn roots_equal('a: Vec<string>, 'b: Vec<string>) -> bool {
    if 'a.len() != 'b.len() { return false }
    auto i# = 0:usize
    loop i < 'a.len() {
        if !vec_contains('b, 'a.get_ref(i).clone()) {
            return false
        }
        i += 1
    }
    return true
}

fn is_std_or_core(path: string) -> bool {
    auto path_norm = __path_normalize(__path_canonicalize(path))
    auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
    if toka_lib != 0:Addr {
        auto env_lib = __path_normalize(__path_canonicalize(string::from_cstr(toka_lib as *char)))
        if path_norm.starts_with(env_lib.as_str()) {
            return true
        }
    }
    auto std_usr = string::from("/usr/local/lib/toka")
    if path_norm.starts_with(std_usr.as_str()) {
        return true
    }
    if path_norm.contains("/lib/core/") ||
       path_norm.contains("/lib/std/") ||
       path_norm.contains("/lib/sys/") ||
       path_norm.contains("/lib/stdx/") ||
       path_norm.contains("/lib/prim/") ||
       path_norm.contains("/lib/hal/") ||
       path_norm.contains("/lib/toolchain/") ||
       path_norm.ends_with("/lib/build.tk") {
        return true
    }
    return false
}

fn collect_submodule_output_updates('graph: DependencyManifest, build_dir: string,
                                    updates#: HashMap<string, ModuleSnapshot>) {
    auto iter# = 'graph.modules.iter()
    loop {
        auto entry_opt = iter#.next_ref()
        if entry_opt.is_none() { break }
        auto entry = entry_opt.unwrap()
        auto &key = entry.key()
        auto &val = entry.val()
        auto m_path = key.clone()
        auto info# = val.clone()

        if !vec_contains('graph.roots, m_path) && info.kind.as_str().equals("source") {
            if is_std_or_core(m_path.clone()) {
                continue
            }
            auto h = __calculate_fnv1a(m_path.clone())

            auto obj_path# = build_dir.clone()
            obj_path#.push_str("/objects/")
            obj_path#.push_str(h.as_str())
            obj_path#.push_str(".o")
            auto obj_path_canon = __path_canonicalize(obj_path)

            auto tki_path# = build_dir.clone()
            tki_path#.push_str("/interfaces/")
            tki_path#.push_str(h.as_str())
            tki_path#.push_str(".tki")
            auto tki_path_canon = __path_canonicalize(tki_path)

            auto new_outputs = ModuleOutputs(
                interface = tki_path_canon,
                object = obj_path_canon,
                executable = string::from("")
            )

            info.outputs = new_outputs
            updates#.insert(cede m_path, cede info)
        }
    }
}

fn populate_submodule_outputs('graph#: DependencyManifest, build_dir: string) {
    auto updates# = HashMap<string, ModuleSnapshot>::new()
    collect_submodule_output_updates('graph, build_dir, updates)

    auto updates_iter# = updates.iter()
    loop {
        auto entry_opt = updates_iter#.next_ref()
        if entry_opt.is_none() { break }
        auto entry = entry_opt.unwrap()
        auto &key = entry.key()
        auto &val = entry.val()
        'graph.modules#.insert(cede key.clone(), cede val.clone())
    }
}

fn calculate_file_hash(path: string) -> string {
    if !exists(path.clone()) {
        return string::from("")
    }
    auto content_res = read_to_string(path)
    if content_res.is_ok() {
        return __calculate_fnv1a(content_res.unwrap())
    }
    return string::from("")
}

fn check_dirty_recursive(
    node: string,
    current_graph: DependencyManifest,
    dirty_map: HashMap<string, string>,
    memo#: HashMap<string, DfsResult>,
    visiting#: HashMap<string, bool>
) -> DfsResult {
    auto memo_opt = memo.get(node)
    if memo_opt.is_none() == false {
        return cede memo_opt.unwrap().clone()
    }

    auto visiting_opt = visiting.get(node)
    if visiting_opt.is_none() == false {
        return DfsResult(
            is_dirty = false,
            reason = cede string::from(""),
            chain = cede Vec<string>::new()
        )
    }
    
    auto dirty_reason_opt = dirty_map.get(node)
    if dirty_reason_opt.is_none() == false {
        auto res = DfsResult(
            is_dirty = true,
            reason = cede dirty_reason_opt.unwrap().clone(),
            chain = cede Vec<string>::new()
        )
        memo#.insert(cede node.clone(), cede res.clone())
        return cede res
    }
    
    auto curr_info_opt = current_graph.modules.get_ref(node)
    if curr_info_opt.is_none() {
        auto res = DfsResult(
            is_dirty = true,
            reason = cede string::from("missing module info"),
            chain = cede Vec<string>::new()
        )
        memo#.insert(cede node.clone(), cede res.clone())
        return cede res
    }
    auto &curr_info = curr_info_opt.unwrap()
    visiting#.insert(cede node.clone(), true)
    
    auto i# = 0:usize
    loop i < curr_info.dependencies.len() {
        auto dep = curr_info.dependencies.get_ref(i).clone()
        if vec_contains(current_graph.roots, dep) && !vec_contains(current_graph.roots, node) {
            i += 1
            continue
        }
        auto dep_res = check_dirty_recursive(dep.clone(), current_graph, dirty_map, memo, visiting)
        if dep_res.is_dirty {
            auto chain# = Vec<string>::new()
            chain#.push(cede dep.clone())
            auto j# = 0:usize
            loop j < dep_res.chain.len() {
                chain#.push(cede dep_res.chain.get_ref(j).clone())
                j += 1
            }
            auto res = DfsResult(
                is_dirty = true,
                reason = cede string::from("dependency changed"),
                chain = cede chain
            )
            auto _removed = visiting#.remove(node)
            memo#.insert(cede node.clone(), cede res.clone())
            return cede res
        }
        i += 1
    }
    
    auto res = DfsResult(
        is_dirty = false,
        reason = cede string::from(""),
        chain = cede Vec<string>::new()
    )
    auto _removed = visiting#.remove(node)
    memo#.insert(cede node.clone(), cede res.clone())
    return cede res
}

fn generate_rebuild_plan(
    current_graph: DependencyManifest,
    old_manifest: DependencyManifest,
    plan#: RebuildPlan
) {
    if old_manifest.manifest_version.len() == 0 {
        plan.status = cede string::from("dirty")
        auto i# = 0:usize
        loop i < current_graph.roots.len() {
            plan.dirty_roots#.push(cede current_graph.roots.get_ref(i).clone())
            i += 1
        }
        auto iter# = current_graph.modules.iter()
        loop {
            auto entry_opt = iter#.next_ref()
            if entry_opt.is_none() { break }
            auto entry = entry_opt.unwrap()
            auto &m_path = entry.key()
            auto k# = m_path.clone()
            auto info# = RebuildModuleInfo(
                reason = cede string::from("first build"), ..
            )
            plan.dirty_modules#.insert(cede k, cede info)
        }
        return
    }

    if !old_manifest.manifest_version.starts_with("1.") {
        plan.status = cede string::from("dirty")
        auto i# = 0:usize
        loop i < current_graph.roots.len() {
            plan.dirty_roots#.push(cede current_graph.roots.get_ref(i).clone())
            i += 1
        }
        auto iter# = current_graph.modules.iter()
        loop {
            auto entry_opt = iter#.next_ref()
            if entry_opt.is_none() { break }
            auto entry = entry_opt.unwrap()
            auto &m_path = entry.key()
            auto k# = m_path.clone()
            auto info# = RebuildModuleInfo(
                reason = cede string::from("version/target changed"), ..
            )
            plan.dirty_modules#.insert(cede k, cede info)
        }
        return
    }

    if !roots_equal(current_graph.roots, old_manifest.roots) {
        plan.status = cede string::from("dirty")
        auto i# = 0:usize
        loop i < current_graph.roots.len() {
            plan.dirty_roots#.push(cede current_graph.roots.get_ref(i).clone())
            i += 1
        }
        auto iter# = current_graph.modules.iter()
        loop {
            auto entry_opt = iter#.next_ref()
            if entry_opt.is_none() { break }
            auto entry = entry_opt.unwrap()
            auto &m_path = entry.key()
            auto k# = m_path.clone()
            auto info# = RebuildModuleInfo(
                reason = cede string::from("roots changed"), ..
            )
            plan.dirty_modules#.insert(cede k, cede info)
        }
        return
    }

    auto dirty_map# = HashMap<string, string>::new()
    auto iter# = current_graph.modules.iter()
    loop {
        auto entry_opt = iter#.next_ref()
        if entry_opt.is_none() { break }
        auto entry = entry_opt.unwrap()
        auto &m_path_ref = entry.key()
        auto m_path = m_path_ref.clone()
        auto &curr_info = entry.val()
        
        auto old_info_opt = old_manifest.modules.get_ref(m_path)
        if old_info_opt.is_none() {
            dirty_map#.insert(cede m_path.clone(), cede string::from("new module"))
            continue
        }
        auto &old_info = old_info_opt.unwrap()
        
        if !curr_info.target_triple.as_str().equals(old_info.target_triple.as_str()) ||
           !curr_info.compiler_version.as_str().equals(old_info.compiler_version.as_str()) ||
           !curr_info.interface_version.as_str().equals(old_info.interface_version.as_str()) {
            dirty_map#.insert(cede m_path.clone(), cede string::from("version/target changed"))
            continue
        }
        
        if !curr_info.outputs.interface.as_str().equals(old_info.outputs.interface.as_str()) ||
           !curr_info.outputs.object.as_str().equals(old_info.outputs.object.as_str()) ||
           !curr_info.outputs.executable.as_str().equals(old_info.outputs.executable.as_str()) {
            dirty_map#.insert(cede m_path.clone(), cede string::from("outputs changed"))
            continue
        }
        
        auto outputs_missing# = false
        if curr_info.outputs.interface.len() > 0 && !exists(curr_info.outputs.interface.clone()) {
            outputs_missing = true
        }
        if curr_info.outputs.object.len() > 0 && !exists(curr_info.outputs.object.clone()) {
            outputs_missing = true
        }
        if curr_info.outputs.executable.len() > 0 && !exists(curr_info.outputs.executable.clone()) {
            outputs_missing = true
        }
        if outputs_missing {
            dirty_map#.insert(cede m_path.clone(), cede string::from("missing output"))
            continue
        }
        
        if !exists(m_path.clone()) {
            dirty_map#.insert(cede m_path.clone(), cede string::from("file missing"))
            continue
        }
        
        auto curr_hash = calculate_file_hash(m_path.clone())
        if !curr_hash.as_str().equals(old_info.content_hash.as_str()) {
            auto reason# = string::from("")
            if curr_info.kind.as_str().equals("source") {
                reason = string::from("hash changed")
            } else {
                reason = string::from("stale interface")
            }
            dirty_map#.insert(cede m_path.clone(), cede reason)
            continue
        }
    }

    auto memo# = HashMap<string, DfsResult>::new()
    auto visiting# = HashMap<string, bool>::new()
    plan.status = cede string::from("clean")
    
    auto iter2# = current_graph.modules.iter()
    loop {
        auto entry_opt = iter2#.next_ref()
        if entry_opt.is_none() { break }
        auto entry = entry_opt.unwrap()
        auto &m_path_ref = entry.key()
        auto m_path = m_path_ref.clone()
        
        auto res = check_dirty_recursive(m_path.clone(), current_graph, dirty_map, memo, visiting)
        if res.is_dirty {
            plan.status = cede string::from("dirty")
            
            auto chain# = Vec<string>::new()
            auto j# = 0:usize
            loop j < res.chain.len() {
                chain#.push(cede res.chain.get_ref(j).clone())
                j += 1
            }
            auto k# = m_path.clone()
            auto info# = RebuildModuleInfo(
                reason = cede res.reason.clone(),
                dirty_deps = cede chain
            )
            plan.dirty_modules#.insert(cede k, cede info)
            
            if vec_contains(current_graph.roots, m_path) {
                if !vec_contains(plan.dirty_roots, m_path) {
                    plan.dirty_roots#.push(cede m_path.clone())
                }
            }
        }
    }
    return
}

fn run_build_impl(
    *name: char,
    *version: char,
    *src: char,
    deps: string,
    c_srcs: string,
    lib_dirs: string,
    libs: string,
    include_dirs: string,
    ldflags: string,
    is_lib_target: bool
) -> i32 {
    unsafe {
        auto *n = *name
        auto *v = *version
        auto *s = *src

        if deps.len() > 0:usize {
            auto deps_iter = deps.split(',' as i32)
            loop {
                auto pkg_url = deps_iter#.next()
                if pkg_url.len() == 0:usize { break }

                auto add_cmd# = Command::new(string::from("toka"))
                add_cmd#.arg(string::from("add"))
                add_cmd#.arg(cede pkg_url.clone())
                if add_cmd#.status() != 0 {
                    println("error: failed to add dependency {}", pkg_url)
                    return 1
                }
            }
        }

        auto is_windows# = false
        auto os_env = libc_getenv(c"OS") as Addr
        if os_env != 0:Addr {
            auto os_str = string::from_cstr(os_env as *char)
            if os_str == string::from("Windows_NT") {
                is_windows = true
            }
        }
        if libc_access(c"build/bin/tokac.exe", 0) == 0 {
            is_windows = true
        }

        if !exists(string::from("target")) && !create_dir(string::from("target")) {
            println("error: failed to create target directory")
            return 1
        }
        if !exists(string::from("target/debug")) && !create_dir(string::from("target/debug")) {
            println("error: failed to create target/debug directory")
            return 1
        }

        auto use_forge# = false
        auto forge_path# = string::from("")
        auto forge_env = libc_getenv(c"TOKA_USE_FORGE") as Addr
        if forge_env != 0:Addr {
            auto forge_env_str = string::from_cstr(forge_env as *char)
            if forge_env_str == string::from("1") {
                if libc_access(c"build/bin/forge", 0) == 0 {
                    use_forge = true
                    forge_path = string::from("build/bin/forge")
                } else if libc_access(c"../build/bin/forge", 0) == 0 {
                    use_forge = true
                    forge_path = string::from("../build/bin/forge")
                } else if libc_access(c"../../build/bin/forge", 0) == 0 {
                    use_forge = true
                    forge_path = string::from("../../build/bin/forge")
                } else if libc_access(c"../../../build/bin/forge", 0) == 0 {
                    use_forge = true
                    forge_path = string::from("../../../build/bin/forge")
                } else if libc_access(c"/usr/local/bin/forge", 0) == 0 {
                    use_forge = true
                    forge_path = string::from("/usr/local/bin/forge")
                } else {
                    println("warning: forge engine not found. Falling back to single-threaded compilation. Please run ./rebuild.sh first.")
                }
            }
        }

        if use_forge {
            auto forge_cmd# = Command::new(cede forge_path.clone())
            auto src_str = string::from_cstr(*s)
            forge_cmd#.arg(cede src_str)
            forge_cmd#.arg(string::from("-j"))
            forge_cmd#.arg(string::from("4"))
            forge_cmd#.arg(string::from("-c"))
            forge_cmd#.arg(string::from(".forge_cache"))

            auto forge_res = forge_cmd#.status()
            if forge_res != 0 {
                auto name_str = string::from_cstr(*n)
                println("\x1b[1;31m       Error\x1b[0m forge incremental compilation failed for {} with exit code: {}", name_str, forge_res.to_string())
                return 1
            }
        }

        // Build tokac command via toka_build.py incremental manager
        auto tokac_path# = string::from("tokac")
        auto env_tokac = libc_getenv(c"TOKAC") as Addr
        if env_tokac != 0:Addr {
            tokac_path = string::from_cstr(env_tokac as *char)
        } else {
            if is_windows {
                if libc_access(c"build/bin/tokac.exe", 0) == 0 {
                    tokac_path = string::from("build\\bin\\tokac.exe")
                } else if libc_access(c"..\\build\\bin\\tokac.exe", 0) == 0 {
                    tokac_path = string::from("..\\build\\bin\\tokac.exe")
                } else if libc_access(c"..\\..\\build\\bin\\tokac.exe", 0) == 0 {
                    tokac_path = string::from("..\\..\\build\\bin\\tokac.exe")
                } else if libc_access(c"..\\..\\..\\build\\bin\\tokac.exe", 0) == 0 {
                    tokac_path = string::from("..\\..\\..\\build\\bin\\tokac.exe")
                }
            } else {
                if libc_access(c"build/bin/tokac", 0) == 0 {
                    tokac_path = string::from("build/bin/tokac")
                } else if libc_access(c"../build/bin/tokac", 0) == 0 {
                    tokac_path = string::from("../build/bin/tokac")
                } else if libc_access(c"../../build/bin/tokac", 0) == 0 {
                    tokac_path = string::from("../../build/bin/tokac")
                } else if libc_access(c"../../../build/bin/tokac", 0) == 0 {
                    tokac_path = string::from("../../../build/bin/tokac")
                }
            }
        }

        auto c_args# = string::from("")
        auto compiler_args# = Vec<string>::new()
        auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
        if toka_lib != 0:Addr {
            auto toka_lib_arg = string::from_cstr(toka_lib as *char)
            c_args#.push_str("-I ")
            c_args#.push_str(toka_lib_arg.as_str())
            c_args#.push_str(" ")
            compiler_args#.push(cede string::from("-I"))
            compiler_args#.push(cede toka_lib_arg)
        } else {
            c_args#.push_str("-I /usr/local/lib/toka ")
            compiler_args#.push(cede string::from("-I"))
            compiler_args#.push(cede string::from("/usr/local/lib/toka"))
        }
        if libc_access(c".tokapkg", 0) == 0 {
            c_args#.push_str("-I .tokapkg ")
            compiler_args#.push(cede string::from("-I"))
            compiler_args#.push(cede string::from(".tokapkg"))
        }
        auto env_pkg_args = libc_getenv(c"TOKA_PKG_ARGS") as Addr
        if env_pkg_args != 0:Addr {
            auto pkg_args = string::from_cstr(env_pkg_args as *char)
            c_args#.push_str(pkg_args.as_str())
            c_args#.push_str(" ")
            auto pkg_arg_iter = pkg_args.split(' ' as i32)
            loop !pkg_arg_iter.is_done() {
                auto pkg_arg = pkg_arg_iter#.next()
                if pkg_arg.len() > 0:usize {
                    compiler_args#.push(cede pkg_arg.clone())
                }
            }
        }

        auto is_hybrid# = false
        if c_srcs.len() > 0:usize { is_hybrid = true }
        if libs.len() > 0:usize { is_hybrid = true }
        if ldflags.len() > 0:usize { is_hybrid = true }
        if lib_dirs.len() > 0:usize { is_hybrid = true }

        if is_hybrid || is_lib_target {
            c_args#.push_str(" --emit-obj ")
            compiler_args#.push(cede string::from("--emit-obj"))
            if is_lib_target {
                c_args#.push_str(" --emit-interface ")
                compiler_args#.push(cede string::from("--emit-interface"))
            }
            c_args#.push_str(" -o target/debug/")
            c_args#.push_cstr(*n)
            c_args#.push_str(".o -O3")
            auto compiler_output# = string::from("target/debug/")
            compiler_output#.push_cstr(*n)
            compiler_output#.push_str(".o")
            compiler_args#.push(cede string::from("-o"))
            compiler_args#.push(cede compiler_output)
            compiler_args#.push(cede string::from("-O3"))
        } else {
            c_args#.push_str(" -o target/debug/")
            c_args#.push_cstr(*n)
            if is_windows {
                c_args#.push_str(".exe")
            }
            c_args#.push_str(" -O3")
            auto compiler_output# = string::from("target/debug/")
            compiler_output#.push_cstr(*n)
            if is_windows {
                compiler_output#.push_str(".exe")
            }
            compiler_args#.push(cede string::from("-o"))
            compiler_args#.push(cede compiler_output)
            compiler_args#.push(cede string::from("-O3"))
        }

        auto has_plan# = false
        auto manifest_path# = string::from(".toka/build/manifest.json")
        auto idx_arg#: i32 = 0
        loop idx_arg < env::args_count() {
            auto arg = env::get_arg(idx_arg)
            if arg.eq(string::from("--plan")) {
                has_plan = true
            }
            if arg.eq(string::from("-m")) || arg.eq(string::from("--manifest")) {
                if idx_arg + 1 < env::args_count() {
                    manifest_path = env::get_arg(idx_arg + 1)
                }
            }
            idx_arg += 1
        }

        if has_plan {
            // Run compiler dependency dump to get current graph
            auto dump_cmd# = Command::new(cede tokac_path.clone())
            dump_cmd#.arg(string::from("--dump-dependencies=json"))
            auto compiler_arg_index# = 0:usize
            loop compiler_arg_index < compiler_args.len() {
                dump_cmd#.arg(cede compiler_args.get_ref(compiler_arg_index).clone())
                compiler_arg_index += 1
            }
            auto src_str = string::from_cstr(*s)
            dump_cmd#.arg(cede src_str)

            auto build_dir = __path_canonicalize(dirname(manifest_path.clone()))
            env::set_var(string::from("TOKA_BUILD_DIR"), build_dir.clone())


            auto dump_result# = dump_cmd#.output()
            if dump_result.is_err() {
                println("error: failed to execute compiler dependency dump")
                return 1
            }
            auto dump_output = dump_result.unwrap()
            if !dump_output.status.success() {
                println("error: compiler dependency dump failed: {}", dump_output.stderr)
                return 1
            }
            auto dump_json = cede dump_output.stdout
            auto current_graph_res = __deserialize_shape<DependencyManifest>(dump_json.as_str())
            if current_graph_res.is_err() {
                println("error: failed to deserialize current graph: {}", current_graph_res.unwrap_err())
                return 1
            }
            auto current_graph = current_graph_res.unwrap()
            populate_submodule_outputs(current_graph, build_dir)

            auto old_manifest# = DependencyManifest(..)
            if exists(manifest_path.clone()) {
                auto old_json_res = read_to_string(manifest_path.clone())
                if old_json_res.is_ok() {
                    auto old_manifest_res = __deserialize_shape<DependencyManifest>(old_json_res.unwrap().as_str())
                    if old_manifest_res.is_ok() {
                        old_manifest = old_manifest_res.unwrap()
                    }
                }
            }

            auto plan# = RebuildPlan(..)
            generate_rebuild_plan(current_graph, old_manifest, plan)
            auto plan_json = plan_to_json(plan)
            println("{}", plan_json.as_str())
            return 0
        }

        // Detect driver path
        auto driver_path# = string::from("tools/scripts/toka_build.py")
        auto driver_found# = libc_access(c"tools/scripts/toka_build.py", 0) == 0
        if !driver_found {
            if libc_access(c"../tools/scripts/toka_build.py", 0) == 0 {
                driver_path = string::from("../tools/scripts/toka_build.py")
                driver_found = true
            } else if libc_access(c"../../tools/scripts/toka_build.py", 0) == 0 {
                driver_path = string::from("../../tools/scripts/toka_build.py")
                driver_found = true
            } else if libc_access(c"../../../tools/scripts/toka_build.py", 0) == 0 {
                driver_path = string::from("../../../tools/scripts/toka_build.py")
                driver_found = true
            }
        }
        if !driver_found {
            auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
            if toka_lib != 0:Addr {
                driver_path = string::from_cstr(toka_lib as *char)
                if !driver_path.ends_with("/") && !driver_path.ends_with("\\") {
                    driver_path#.push_str("/")
                }
                driver_path#.push_str("toolchain/toka_build.py")
                driver_found = libc_access(driver_path.c_str(), 0) == 0
            }
        }
        if !driver_found {
            println("error: Toka build driver not found; expected tools/scripts/toka_build.py or $TOKA_LIB/toolchain/toka_build.py")
            return 1
        }

        auto cmd1# = Command::new(string::from("python3"))
        cmd1#.arg(cede driver_path.clone())
        cmd1#.arg(string::from("--build"))
        cmd1#.arg(string::from("-m"))
        cmd1#.arg(cede manifest_path.clone())
        cmd1#.arg(string::from("--tokac"))
        cmd1#.arg(cede tokac_path.clone())
        cmd1#.arg(string::from("--compiler-args"))
        cmd1#.arg(cede c_args.clone())
        auto src_str = string::from_cstr(*s)
        cmd1#.arg(cede src_str)

        auto name_str = string::from_cstr(*n)
        auto version_str = string::from_cstr(*v)
        println("\x1b[1;32m   Compiling\x1b[0m {} v{} ...", name_str, version_str)

        // Execute compiler
        auto res1 = cmd1#.status()
        if res1 != 0 {
            auto fail_name = string::from_cstr(*n)
            println("\x1b[1;31m       Error\x1b[0m failed to compile {}", fail_name)
            return 1
        }

        if is_hybrid {
            auto *env_cxx = libc_getenv(c"CXX")
            auto cxx# = string::from("")
            if *env_cxx != (ADDR0 as *char) {
                cxx = string::from_cstr(*env_cxx)
            } else {
                if libc_access(c"/usr/bin/clang++-20", 0) == 0 {
                    cxx = string::from("/usr/bin/clang++-20")
                } else if libc_access(c"/usr/bin/clang++", 0) == 0 {
                    cxx = string::from("/usr/bin/clang++")
                } else if libc_access(c"/usr/bin/g++", 0) == 0 {
                    cxx = string::from("/usr/bin/g++")
                } else {
                    cxx = string::from("clang++")
                }
            }

            if is_lib_target {
                if c_srcs.len() > 0:usize {
                    auto c_srcs_iter = c_srcs.split(',' as i32)
                    loop {
                        auto file = c_srcs_iter#.next()
                        if file.len() == 0:usize { break }

                        auto c_compile# = Command::new(cede cxx.clone())
                        c_compile#.arg(string::from("-c"))
                        c_compile#.arg(cede file.clone())
                        c_compile#.arg(string::from("-o"))
                        auto c_object# = string::from("target/debug/")
                        auto f_stem = file_stem(file)
                        c_object#.push_str(f_stem.as_str())
                        c_object#.push_str(".o")
                        c_compile#.arg(cede c_object)

                        if c_compile#.status() != 0 {
                            println("error: failed to compile C/C++ source {}", file)
                            return 1
                        }
                    }
                }

                auto ar_cmd# = Command::new(string::from("ar"))
                if is_windows {
                    ar_cmd = Command::new(string::from("lib.exe"))
                    auto library_output# = string::from("/OUT:target\\debug\\")
                    library_output#.push_cstr(*n)
                    library_output#.push_str(".lib")
                    ar_cmd#.arg(cede library_output)
                    auto toka_object# = string::from("target\\debug\\")
                    toka_object#.push_cstr(*n)
                    toka_object#.push_str(".o")
                    ar_cmd#.arg(cede toka_object)
                } else {
                    ar_cmd#.arg(string::from("rcs"))
                    auto library_output# = string::from("target/debug/lib")
                    library_output#.push_cstr(*n)
                    library_output#.push_str(".a")
                    ar_cmd#.arg(cede library_output)
                    auto toka_object# = string::from("target/debug/")
                    toka_object#.push_cstr(*n)
                    toka_object#.push_str(".o")
                    ar_cmd#.arg(cede toka_object)
                }

                if c_srcs.len() > 0:usize {
                    auto c_srcs_iter = c_srcs.split(',' as i32)
                    loop {
                        auto file = c_srcs_iter#.next()
                        if file.len() == 0:usize { break }
                        auto f_stem = file_stem(file)
                        auto c_object# = string::from("target/debug/")
                        c_object#.push_str(f_stem.as_str())
                        c_object#.push_str(".o")
                        ar_cmd#.arg(cede c_object)
                    }
                }
                if ar_cmd#.status() != 0 {
                    println("error: failed to create library archive")
                    return 1
                }
            } else {
                auto rt_path# = string::from("")
                if is_windows {
                    if libc_access(c"lib/sys/toka_rt.obj", 0) == 0 {
                        rt_path = string::from("lib/sys/toka_rt.obj")
                    } else if libc_access(c"lib/sys/toka_rt.o", 0) == 0 {
                        rt_path = string::from("lib/sys/toka_rt.o")
                    } else if libc_access(c"../lib/sys/toka_rt.obj", 0) == 0 {
                        rt_path = string::from("../lib/sys/toka_rt.obj")
                    } else if libc_access(c"../lib/sys/toka_rt.o", 0) == 0 {
                        rt_path = string::from("../lib/sys/toka_rt.o")
                    }
                } else {
                    if libc_access(c"lib/sys/toka_rt.o", 0) == 0 {
                        rt_path = string::from("lib/sys/toka_rt.o")
                    } else if libc_access(c"../lib/sys/toka_rt.o", 0) == 0 {
                        rt_path = string::from("../lib/sys/toka_rt.o")
                    }
                }

                if rt_path.len() == 0:usize {
                    auto toka_lib = libc_getenv(c"TOKA_LIB") as Addr
                    if toka_lib != 0:Addr {
                        auto env_rt# = string::from_cstr(toka_lib as *char)
                        if !env_rt.ends_with("/") {
                            env_rt#.push_str("/")
                        }
                        if is_windows {
                            auto env_rt_obj# = env_rt.clone()
                            env_rt_obj#.push_str("sys/toka_rt.obj")
                            if libc_access(env_rt_obj.c_str(), 0) == 0 {
                                rt_path = env_rt_obj.clone()
                            }
                        }
                        if rt_path.len() == 0:usize {
                            auto env_rt_o# = env_rt.clone()
                            env_rt_o#.push_str("sys/toka_rt.o")
                            if libc_access(env_rt_o.c_str(), 0) == 0 {
                                rt_path = env_rt_o.clone()
                            }
                        }
                    }
                }
                if rt_path.len() == 0:usize {
                    if is_windows {
                        if libc_access(c"/usr/local/lib/toka/sys/toka_rt.obj", 0) == 0 {
                            rt_path = string::from("/usr/local/lib/toka/sys/toka_rt.obj")
                        }
                    }
                    if rt_path.len() == 0:usize {
                        if libc_access(c"/usr/local/lib/toka/sys/toka_rt.o", 0) == 0 {
                            rt_path = string::from("/usr/local/lib/toka/sys/toka_rt.o")
                        }
                    }
                }
                if rt_path.len() == 0:usize {
                    if is_windows {
                        rt_path = string::from("lib/sys/toka_rt.obj")
                    } else {
                        rt_path = string::from("lib/sys/toka_rt.o")
                    }
                }

                auto cmd2# = Command::new(cede cxx.clone())
                auto obj_path# = string::from("target/debug/")
                obj_path#.push_cstr(*n)
                obj_path#.push_str(".o")
                cmd2#.arg(cede obj_path)

                if c_srcs.len() > 0:usize {
                    auto c_srcs_iter = c_srcs.split(',' as i32)
                    loop {
                        auto file = c_srcs_iter#.next()
                        if file.len() == 0:usize { break }
                        cmd2#.arg(cede file.clone())
                    }
                }

                cmd2#.arg(cede rt_path.clone())

                if include_dirs.len() > 0:usize {
                    auto inc_iter = include_dirs.split(',' as i32)
                    loop {
                        auto dir = inc_iter#.next()
                        if dir.len() == 0:usize { break }
                        cmd2#.arg(string::from("-I"))
                        cmd2#.arg(cede dir.clone())
                    }
                }

                if lib_dirs.len() > 0:usize {
                    auto lib_dir_iter = lib_dirs.split(',' as i32)
                    loop {
                        auto dir = lib_dir_iter#.next()
                        if dir.len() == 0:usize { break }
                        cmd2#.arg(string::from("-L"))
                        cmd2#.arg(cede dir.clone())
                    }
                }

                if libs.len() > 0:usize {
                    auto lib_iter = libs.split(',' as i32)
                    loop {
                        auto lib = lib_iter#.next()
                        if lib.len() == 0:usize { break }
                        cmd2#.arg(string::from("-l"))
                        cmd2#.arg(cede lib.clone())
                    }
                }

                if ldflags.len() > 0:usize {
                    auto ldflag_iter = ldflags.split(' ' as i32)
                    loop !ldflag_iter.is_done() {
                        auto ldflag = ldflag_iter#.next()
                        if ldflag.len() > 0:usize {
                            cmd2#.arg(cede ldflag.clone())
                        }
                    }
                }

                if is_windows {
                    cmd2#.arg(string::from("-lws2_32"))
                    cmd2#.arg(string::from("-lshell32"))
                }

                cmd2#.arg(string::from("-o"))
                auto out_path# = string::from("target/debug/")
                out_path#.push_cstr(*n)
                if is_windows {
                    out_path#.push_str(".exe")
                }
                cmd2#.arg(cede out_path)

                auto res2 = cmd2#.status()
                if res2 != 0 {
                    auto fail_name = string::from_cstr(*n)
                    println("\x1b[1;31m       Error\x1b[0m linking failed for {}", fail_name)
                    return 1
                }

                auto rm_path# = string::from("target/debug/")
                rm_path#.push_cstr(*n)
                rm_path#.push_str(".o")
                remove_file(cede rm_path)
            }
        }

        println("\x1b[1;35m    Finished\x1b[0m release [optimized] target(s)")
        return 0
    }
}

pub fn run_build(proj: Executable) -> i32 {
    return run_build_impl(
        proj.*name,
        proj.*version,
        proj.*src,
        proj.deps.clone(),
        proj.c_srcs.clone(),
        proj.lib_dirs.clone(),
        proj.libs.clone(),
        proj.include_dirs.clone(),
        proj.ldflags.clone(),
        false
    )
}

pub fn run_build(proj: Library) -> i32 {
    return run_build_impl(
        proj.*name,
        proj.*version,
        proj.*src,
        proj.deps.clone(),
        proj.c_srcs.clone(),
        proj.lib_dirs.clone(),
        proj.libs.clone(),
        proj.include_dirs.clone(),
        string::from(""),
        true
    )
}
