// The universal fallback Error struct
pub shape Error(
    code: i32,
    message: string
)

// Minimal cross-platform I/O failure contract. `operation` is stable API
// context, `os_code` preserves the native error when one exists, and `message`
// remains suitable for direct CLI diagnostics.
pub shape IoError(
    operation: string,
    os_code: i32,
    message: string
)

// Typed context preserves the original error instead of erasing it.
pub shape ErrorContext<'E>(
    message: string,
    'source: E
)

impl Error {
    pub fn new(code: i32, msg: string) -> Error {
        return Error(code = code, message = msg.clone())
    }
}

impl IoError {
    pub fn new(operation: str, os_code: i32, message: str) -> IoError {
        return IoError(
            operation = string::from(operation),
            os_code = os_code,
            message = string::from(message)
        )
    }

    pub fn operation(self) -> string {
        return string::from(self.operation.as_str())
    }

    pub fn code(self) -> i32 {
        return self.os_code
    }

    pub fn message(self) -> string {
        return string::from(self.message.as_str())
    }
}

pub fn with_context<'T, 'E>(cede result: Result<'T, 'E>, message: string) -> Result<'T, ErrorContext<'E>> {
    match cede result {
        auto Result<'T, 'E>::Ok('value) => {
            return Result<'T, ErrorContext<'E>>::Ok(cede 'value)
        }
        auto Result<'T, 'E>::Err('error) => {
            return Result<'T, ErrorContext<'E>>::Err(
                ErrorContext<'E>(message = message.clone(), source = cede 'error)
            )
        }
        _ => {
            panic("moved Result passed to with_context")
        }
    }
}

pub fn __unused_dummy() {}
