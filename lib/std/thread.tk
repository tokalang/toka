import sys/thread::{sys_thread_spawn, sys_thread_join, sys_thread_detach, unwrap_fat_pointer, sys_alloc_thread_env, sys_free_thread_env}
import sys/libc::{libc_usleep, libc_sched_yield}
import std/error::{Error, __unused_dummy}

/// Suspends the current thread for at least the specified number of milliseconds.
pub fn sleep_ms(ms: u32) {
    unsafe {
        // libc_usleep takes microseconds
        libc_usleep(ms * 1000:u32)
    }
}

/// Voluntarily yields execution of the current thread to another.
pub fn yield_now() {
    unsafe {
        libc_sched_yield()
    }
}

/// A spawned thread consumes its callback and invokes it exactly once.  The
/// callback may require mutable access to its captured environment, but the
/// binding that transfers it does not itself require payload write authority.
pub alias ThreadClosure<'T> = dyn fn#() -> cede 'T

shape ThreadEnvReclaimer(ptr#: Addr)

impl ThreadEnvReclaimer@Encap {
    fn drop(self#) {
        if self.ptr != 0:Addr {
            sys_free_thread_env(self.ptr)
            self.ptr = 0:Addr
        }
    }
}

shape ThreadStateBox<'S, 'T>(
    'state: S,
    entry: fn('S) -> cede 'T,
    reclaimer: ThreadEnvReclaimer
)
shape StateTrampBox(f: cede fn#() -> Addr)

/// Spawns a new OS thread, running the given closure.
/// 
/// Note: To capture variables from the environment safely across threads,
/// use the `[cede ...]` capture list in the closure to consume variables
/// by value (move semantics).
pub fn thread_spawn<'T: @Send>(cede f: cede dyn fn#() -> cede 'T) -> JoinHandle<'T> {
    auto entry = { closure# =>
        return cede closure#()
    }:fn(ThreadClosure<'T>) -> cede 'T
    return thread_spawn_with_state<ThreadClosure<'T>, 'T>(
        cede f,
        entry
    )
}

/// Spawns a thread with explicitly owned state and a non-capturing entry
/// function. The state is heap-boxed, remains valid after the creator returns,
/// and is dropped exactly once after the entry function completes.
pub fn thread_spawn_with_state<'S: @Send, 'T: @Send>(
    cede 'state: S,
    entry: fn('S) -> cede 'T
) -> JoinHandle<'T> {
    unsafe {
        auto box_addr = sys_alloc_thread_env(sizeof(ThreadStateBox<'S, 'T>) as usize)
        auto *box_ptr# = (box_addr as *ThreadStateBox<'S, 'T>)
        box_ptr = ThreadStateBox<'S, 'T>(
            state = cede 'state,
            entry = entry,
            reclaimer = ThreadEnvReclaimer(ptr = box_addr)
        )

        auto captured_box = box_ptr
        auto tramp_fn = { [cede captured_box] =>
            unsafe {
                auto box = cede captured_box
                auto *ret_ptr# = (sys_alloc_thread_env(sizeof('T) as usize) as *'T)
                auto entry = box.entry
                ret_ptr = cede entry(box.state)
                return (*ret_ptr) as Addr
            }
        }:cede fn#() -> Addr

        auto *tramp_buf# = (sys_alloc_thread_env(sizeof(StateTrampBox) as usize) as *StateTrampBox)
        tramp_buf = StateTrampBox(f = cede tramp_fn)
        auto func_ptr_addr = unwrap_fat_pointer((*tramp_buf) as Addr)
        auto *invoker_ptr# = (func_ptr_addr as *Addr)
        auto real_invoker = invoker_ptr

        // `captured_box` is a payload capture, so its closure environment has
        // exactly the same layout as ThreadStateBox. The heap box itself is
        // therefore the stable environment passed to the native thread.
        auto thread_id = sys_thread_spawn(real_invoker, box_addr)
        sys_free_thread_env((*tramp_buf) as Addr)
        return JoinHandle<'T>(id = thread_id)
    }
}

pub shape JoinHandle<'T: @Send>(id: Addr)

impl<'T: @Send> JoinHandle<'T> {
    /// Detaches the thread, letting it run independently to completion.
    /// The OS guarantees reclaiming its runtime resources independently.
    pub fn detach(self#) {
        if self.id != 0:Addr {
            sys_thread_detach(self.id)
            self.id = 0:Addr
        }
    }
    

    
    /// Waits for the thread to finish and returns its yielded value or an Error if the OS join fails.
    pub fn join(self#) -> Result<'T, Error> {
        auto tid = self.id
        if tid == 0:Addr {
            auto msg = string::from("Cannot join a thread that has already been detached or joined")
            return Result<'T, Error>::Err(Error::new(1, msg))
        }
        
        // Relinquish ownership from the handle to prevent double join or drop detach
        self.id = 0:Addr
        
        unsafe {
            auto raw_res = sys_thread_join(tid)
            if raw_res == 0:Addr {
                auto msg = string::from("sys_thread_join failed to retrieve result")
                auto err = Error::new(1, msg)
                return Result<'T, Error>::Err(err)
            }
            
            // Extract the structurally boxed payload safely
            auto *box_ret = (raw_res as *'T)
            auto val = cede box_ret
            sys_free_thread_env(raw_res)
            
            return Result<'T, Error>::Ok(cede val)
        }
    }
}

impl<'T> JoinHandle<'T>@Encap {
    fn drop(self#) {
        if self.id != 0:Addr {
            sys_thread_detach(self.id)
            self.id = 0:Addr
        }
    }
    
}

fn __dummy_unused_ref() {
    if true {
        unsafe {
            sys_alloc_thread_env(0:usize)
            sys_free_thread_env(0:Addr)
            sys_thread_spawn(0:Addr, 0:Addr)
            sys_thread_join(0:Addr)
            sys_thread_detach(0:Addr)
            unwrap_fat_pointer(0:Addr)
            auto err = Error::new(0:i32, string::from("")):Error
            __unused_dummy()
            auto _ = err
        }
    }
}
