import sys/os/base as sys
import sys/os/net as sysnet
import sys/libc::{toka_resolve_ipv4}
import std/io::{@Reader, @Writer}
import std/task::{get_reactor_fd, sleep_async, register_timer_token}
import std/context::{Canceler}
import core/task as core_task

extern fn __builtin_coro_current_handle() -> *void
extern fn __builtin_coro_suspend()

// Error type for network operations
alias NetResult<T> = Result<T, string>

pub shape Ipv4Addr (
    octets: [u8; 4]
)

impl Ipv4Addr {
    pub fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        auto octets: [u8; 4] = [a, b, c, d]
        return Ipv4Addr(octets = octets)
    }

    pub fn to_u32(self) -> u32 {
        auto a = self.octets[0] as u32
        auto b = self.octets[1] as u32
        auto c = self.octets[2] as u32
        auto d = self.octets[3] as u32
        return a bor (b bshl 8) bor (c bshl 16) bor (d bshl 24)
    }

    pub fn from_u32(ip: u32) -> Ipv4Addr {
        auto a = (ip band 0xFF) as u8
        auto b = ((ip bshr 8) band 0xFF) as u8
        auto c = ((ip bshr 16) band 0xFF) as u8
        auto d = ((ip bshr 24) band 0xFF) as u8
        return Ipv4Addr::new(a, b, c, d)
    }
}

pub fn resolve_ipv4(host: string) -> Result<Ipv4Addr, string> {
    auto *host_ptr = host.c_str() as *char
    auto ip = toka_resolve_ipv4(*host_ptr)
    if ip == 0:u32 {
        return Result<Ipv4Addr, string>::Err(string::from("DNS resolution failed"))
    }
    return Result<Ipv4Addr, string>::Ok(Ipv4Addr::from_u32(ip))
}

pub shape SocketAddrV4 (
    ip: Ipv4Addr,
    port: u16
)

impl SocketAddrV4 {
    pub fn new(ip: Ipv4Addr, port: u16) -> SocketAddrV4 {
        return SocketAddrV4(ip = ip, port = port)
    }
}

// ==========================================
// UdpSocket
// ==========================================

pub shape UdpRecvInfo (
    len: usize,
    addr: SocketAddrV4
)

pub shape UdpSocket (
    fd: i32,
    closed: bool
)

impl UdpSocket@encap {
    fn drop(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }
    pub fn clone(self) = delete
}

impl UdpSocket {
    pub fn bind(addr: SocketAddrV4) -> UdpSocket {
        unsafe {
            auto fd = sysnet::net_socket_udp_impl()
            if fd < 0 {
                return UdpSocket(fd=-1, closed=true)
            }

            sysnet::net_setsockopt_reuse_impl(fd)

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_bind_impl(fd, ip_num, addr.port as i32)
            if res != 0 {
                sysnet::net_close_impl(fd)
                return UdpSocket(fd=-1, closed=true)
            }

            return UdpSocket(fd=fd, closed=false)
        }
    }

    pub fn local_port(self) -> u16 {
        auto port = sysnet::net_local_port_impl(self.fd)
        if port < 0 { return 0:u16 }
        return port as u16
    }

    pub fn send_to(self#, *buf: u8, len: usize, addr: SocketAddrV4) -> Result<usize, string> {
        unsafe {
            if self.closed {
                return Result<usize, string>::Err(string::from("Socket closed"))
            }
            auto ip_num = addr.ip.to_u32()
            auto n: i64 = sysnet::net_sendto_impl(self.fd, *buf, len, ip_num as usize, addr.port as i32)
            if n < 0:i64 {
                return Result<usize, string>::Err(string::from("send_to failed"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }

    pub fn recv_from(self#, *buf: u8, len: usize) -> Result<UdpRecvInfo, string> {
        unsafe {
            if self.closed {
                return Result<UdpRecvInfo, string>::Err(string::from("Socket closed"))
            }
            auto out_host = 0:usize
            auto out_port = 0:i32
            auto *ph = (&out_host as Addr) as *usize
            auto *pp = (&out_port as Addr) as *i32
            auto n: i64 = sysnet::net_recvfrom_impl(self.fd, *buf, len, *ph, *pp)
            if n < 0:i64 {
                return Result<UdpRecvInfo, string>::Err(string::from("recv_from failed"))
            }
            auto ip = Ipv4Addr::from_u32(out_host as u32)
            auto sender_addr = SocketAddrV4::new(ip, out_port as u16)
            return Result<UdpRecvInfo, string>::Ok(UdpRecvInfo(len = n as usize, addr = sender_addr))
        }
    }

    pub fn close(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }

    pub fn is_valid(self) -> bool {
        return self.fd >= 0
    }
}

// ==========================================
// TcpStream
// ==========================================

pub shape TcpStream (
    fd: i32,
    closed: bool
)

impl TcpStream@encap {
    fn drop(self#) {
        self#.close()
    }

    pub fn clone(self) = delete
}

impl TcpStream {
    pub fn take(self#) -> TcpStream {
        auto s = TcpStream(
            fd = self.fd,
            closed = self.closed
        )
        self.fd = -1
        self.closed = true
        return s
    }

    pub fn connect(addr: SocketAddrV4) -> TcpStream {
        unsafe {
            auto fd = sysnet::net_socket_impl()
            if fd < 0 {
                return TcpStream(fd=-1, closed=true)
            }

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_connect_impl(fd, ip_num, addr.port)
            if res != 0 {
                sysnet::net_close_impl(fd)
                return TcpStream(fd=-1, closed=true)
            }

            return TcpStream(fd=fd, closed=false)
        }
    }

    pub fn connect_async(addr: SocketAddrV4) -> async TcpStream {
        unsafe {
            auto fd = sysnet::net_socket_impl()
            if fd < 0 {
                return TcpStream(fd=-1, closed=true)
            }

            sysnet::net_set_nonblocking_impl(fd)

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_connect_impl(fd, ip_num, addr.port)

            if res == 0 {
                // Connected instantly
                sleep_async(0:i64).await
                return TcpStream(fd=fd, closed=false)
            }

            auto errno = sysnet::get_errno_impl()
            if errno != 36 && errno != 115 && errno != 10035 {
                sysnet::net_close_impl(fd)
                sleep_async(0:i64).await
                return TcpStream(fd=-1, closed=true)
            }

            if !register_async_reactor_write(__builtin_coro_current_handle() as Addr, fd) {
                sysnet::net_close_impl(fd)
                return TcpStream(fd=-1, closed=true)
            }
            __builtin_coro_suspend()

            auto get_err = sysnet::net_getsockopt_error_impl(fd)
            if get_err != 0 {
                sysnet::net_close_impl(fd)
                return TcpStream(fd=-1, closed=true)
            }

            return TcpStream(fd=fd, closed=false)
        }
    }

    pub fn read(self#, *buf: u8, len: usize) -> Result<usize, string> {
        unsafe {
            auto my_fd = self.fd
            if self.closed {
                return Result<usize, string>::Err(string::from("Stream closed"))
            }
            auto n: i64 = sysnet::net_read_impl(my_fd, *buf, len)
            if n < 0 {
                return Result<usize, string>::Err(string::from("Read error"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }

    pub fn read_exact(self#, *buf: u8, len: usize) -> Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.read(*current_ptr, len - total)
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Unexpected EOF during read_exact"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn write(self#, *buf: u8, len: usize) -> Result<usize, string> {
        unsafe {
            auto my_fd = self.fd
            if self.closed {
                return Result<usize, string>::Err(string::from("Stream closed"))
            }
            auto n: i64 = sysnet::net_write_impl(my_fd, *buf, len)
            if n < 0 {
                return Result<usize, string>::Err(string::from("Write error"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }


    // Helper to write string
    pub fn write_string(self#, s: string) -> Result<usize, string> {
        auto *ptr = s.c_str() as *u8
        return self#.write(*ptr, s.len() as usize)
    }

    pub fn write_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        return net_async_write(self, *buf, len).await
    }

    pub fn write_string_async(self#, s: string) -> async Result<usize, string> {
        auto *ptr = s.c_str() as *u8
        return self#.write_async(*ptr, s.len() as usize).await
    }

    pub fn write_view(self#, v: str) -> Result<usize, string> {
        auto *ptr = v.raw_ptr() as *u8
        return self#.write(*ptr, v.len())
    }

    pub fn write_view_async(self#, v: str) -> async Result<usize, string> {
        auto *ptr = v.raw_ptr() as *u8
        return self#.write_async(*ptr, v.len()).await
    }

    pub fn read_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        return net_async_read(self, *buf, len).await
    }

    pub fn read_exact_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.read_async(*current_ptr, len - total).await
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Unexpected EOF during read_exact_async"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn write_all_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.write_async(*current_ptr, len - total).await
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Zero byte written during write_all_async"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn close(self#) {
        unsafe {
            if !self.closed {
                sysnet::reactor_del_fd_impl(get_reactor_fd(), self.fd)
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }
    pub fn is_valid(self) -> bool {
        return self.fd >= 0
    }
}

// ==========================================
// TcpListener
// ==========================================

pub shape TcpListener (
    fd: i32,
    closed: bool
)

impl TcpListener@encap {
    fn drop(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }

    pub fn clone(self) = delete
}

impl TcpListener {
    pub fn bind(addr: SocketAddrV4) -> TcpListener {
        unsafe {
            auto fd = sysnet::net_socket_impl()
            if fd < 0 {
                return TcpListener(fd=-1, closed=true)
            }

            // SO_REUSEADDR
            sysnet::net_setsockopt_reuse_impl(fd)

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_bind_impl(fd, ip_num, addr.port)
            if res != 0 {
                sysnet::net_close_impl(fd)
                return TcpListener(fd=-1, closed=true)
            }

            auto lres = sysnet::net_listen_impl(fd)
            if lres != 0 {
                sysnet::net_close_impl(fd)
                return TcpListener(fd=-1, closed=true)
            }

            return TcpListener(fd=fd, closed=false)
        }
    }

    pub fn local_port(self) -> u16 {
        auto port = sysnet::net_local_port_impl(self.fd)
        if port < 0 { return 0:u16 }
        return port as u16
    }

    pub fn accept(self#) -> TcpStream {
        unsafe {
            if self.closed {
                 return TcpStream(fd=-1, closed=true)
            }

            auto client_fd = sysnet::net_accept_impl(self.fd)
            if client_fd < 0 {
                 return TcpStream(fd=-1, closed=true)
            }

            return TcpStream(fd=client_fd, closed=false)
        }
    }

    pub fn is_valid(self) -> bool {
        return self.fd >= 0
    }
}

fn register_async_reactor_read(coro: Addr, fd: i32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto wait_id# = 0:u32
        auto slot_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 2:u16, &wait_id as *u32, &slot_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((wait_id as u64) << 32:u64) | (slot_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(wait_id, slot_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

fn register_async_reactor_write(coro: Addr, fd: i32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto wait_id# = 0:u32
        auto slot_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 3:u16, &wait_id as *u32, &slot_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((wait_id as u64) << 32:u64) | (slot_gen as u64)
            if !sysnet::reactor_add_write_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(wait_id, slot_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

fn register_async_reactor_read_timeout(coro: Addr, fd: i32, timeout_ms: i32, *out_io_id: u32, *out_io_gen: u32, *out_tm_id: u32, *out_tm_gen: u32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto io_id# = 0:u32
        auto io_gen# = 0:u32
        auto tm_id# = 0:u32
        auto tm_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate_pair(task_id, wait_gen, 2:u16, 1:u16, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                sysnet::reactor_del_fd_impl(get_reactor_fd(), fd)
                core_task::toka_wait_registry_release(io_id, io_gen)
                core_task::toka_wait_registry_release(tm_id, tm_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            register_timer_token(tm_id, tm_gen, timeout_ms)
            auto *p0# = *out_io_id
            p0 = io_id
            auto *p1# = *out_io_gen
            p1 = io_gen
            auto *p2# = *out_tm_id
            p2 = tm_id
            auto *p3# = *out_tm_gen
            p3 = tm_gen
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

// ==== Top Level Async Helpers ====
pub fn net_async_read(stream: TcpStream, *buf: u8, len: usize) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if stream.closed {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(stream.fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(stream.fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        if !register_async_reactor_read(__builtin_coro_current_handle() as Addr, stream.fd) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_read_timeout(stream: TcpStream, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if stream.closed {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(stream.fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(stream.fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto tm_id# = 0:u32
                        auto tm_gen# = 0:u32
                        if !register_async_reactor_read_timeout(__builtin_coro_current_handle() as Addr, stream.fd, timeout_ms, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read timeout"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto is_timeout = core_task::toka_wait_registry_is_winner(tm_id, tm_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(tm_id, tm_gen)
                        if is_timeout != 0 {
                            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
                            sysnet::reactor_del_read_impl(get_reactor_fd(), stream.fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("IO operation timed out"))
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

fn register_async_reactor_read_context(coro: Addr, fd: i32, canceler: Canceler, *out_io_id: u32, *out_io_gen: u32, *out_ctx_id: u32, *out_ctx_gen: u32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto io_id# = 0:u32
        auto io_gen# = 0:u32
        auto ctx_id# = 0:u32
        auto ctx_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate_pair(task_id, wait_gen, 2:u16, 4:u16, &io_id as *u32, &io_gen as *u32, &ctx_id as *u32, &ctx_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(io_id, io_gen)
                core_task::toka_wait_registry_release(ctx_id, ctx_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            canceler.register_wait_token(ctx_id, ctx_gen)
            auto *p0# = *out_io_id
            p0 = io_id
            auto *p1# = *out_io_gen
            p1 = io_gen
            auto *p2# = *out_ctx_id
            p2 = ctx_id
            auto *p3# = *out_ctx_gen
            p3 = ctx_gen
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

pub fn net_async_read_context(stream: TcpStream, *buf: u8, len: usize, canceler: Canceler) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if stream.closed {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(stream.fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(stream.fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto ctx_id# = 0:u32
                        auto ctx_gen# = 0:u32
                        if !register_async_reactor_read_context(__builtin_coro_current_handle() as Addr, stream.fd, canceler, &io_id as *u32, &io_gen as *u32, &ctx_id as *u32, &ctx_gen as *u32) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read context"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto is_ctx = core_task::toka_wait_registry_is_winner(ctx_id, ctx_gen)
                        canceler.unregister_wait_token(ctx_id, ctx_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(ctx_id, ctx_gen)
                        if is_ctx != 0 {
                            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
                            sysnet::reactor_del_read_impl(get_reactor_fd(), stream.fd, event_key as Addr)
                            auto c_err = canceler.err()
                            if c_err.is_some() {
                                ret = Result<usize, string>::Err(c_err.unwrap())
                            } else {
                                ret = Result<usize, string>::Err(string::from("context canceled"))
                            }
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_accept(listener: TcpListener) -> async TcpStream {
    auto ret# = TcpStream(fd=-1, closed=true)
    unsafe {
        if listener.closed {
             // closed
        } else {
            sysnet::net_set_nonblocking_impl(listener.fd)

            auto done# = false
            loop !done {
                auto client_fd = sysnet::net_accept_impl(listener.fd)
                if client_fd >= 0 {
                    sysnet::net_set_nonblocking_impl(client_fd)
                    sleep_async(0:i64).await
                    ret = TcpStream(fd=client_fd, closed=false)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        if !register_async_reactor_read(__builtin_coro_current_handle() as Addr, listener.fd) {
                            ret = TcpStream(fd=-1, closed=true)
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()
                    } else {
                        sleep_async(0:i64).await
                        ret = TcpStream(fd=-1, closed=true)
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_write(stream: TcpStream, *buf: u8, len: usize) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if stream.closed {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(stream.fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_write_impl(stream.fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        if !register_async_reactor_write(__builtin_coro_current_handle() as Addr, stream.fd) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async write"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Write error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

impl TcpStream@Reader {
    pub fn read_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.read(*buf, len)
    }
}

impl TcpStream@Writer {
    pub fn write_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.write(*buf, len)
    }
}
