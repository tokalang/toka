import core/result::{Result}
import core/task as core_task
import std/error::{IoError}

extern fn __builtin_coro_current_handle() -> *void
extern fn __builtin_coro_suspend()
extern fn toka_tls_read(*handle: void, *buf: void, len: usize) -> i32
extern fn toka_tls_write(*handle: void, *buf: void, len: usize) -> i32
extern fn toka_tls_close(*handle: void)
extern fn toka_tls_context_new() -> *void
extern fn toka_tls_server_context_new() -> *void
extern fn toka_tls_server_context_new_with_cert_file(*cert: char, *key: char) -> *void
extern fn toka_tls_set_verify_mode(*handle: void, verify_peer: i32)
extern fn toka_tls_set_ca_file(*handle: void, *ca_path: char) -> i32
extern fn toka_tls_set_sni(*handle: void, *host: char) -> i32
extern fn toka_tls_connect(*handle: void, fd: i32) -> i32
extern fn toka_tls_accept(*handle: void, fd: i32) -> i32
extern fn toka_tls_backend_available() -> i32

// Error type for network operations
alias NetResult<T> = Result<T, string>

// TLS context/control adapters. The OpenSSL ABI is kept below stdx; callers
// should use TcpStream::tls_* for I/O and handshakes.
pub fn net_tls_context_new() -> *void {
    unsafe { return toka_tls_context_new() }
}

pub fn net_tls_backend_available() -> bool {
    unsafe { return toka_tls_backend_available() != 0 }
}

// Compatibility adapter. New code should use std/random directly; callers
// still receive their owned buffer back and never need to hold a pointer.
pub fn net_random_bytes(cede buffer: Vec<u8>) -> Result<Vec<u8>, string> {
    return fill_secure_random_bytes(cede buffer)
}

pub fn net_tls_server_context_new() -> *void {
    unsafe { return toka_tls_server_context_new() }
}

pub fn net_tls_server_context_new_with_cert_file(cert_path: string, key_path: string) -> *void {
    auto cert_cstr# = cert_path.clone()
    auto key_cstr# = key_path.clone()
    auto *cert_ptr# = cert_cstr.raw_ptr() as *char
    auto *key_ptr# = key_cstr.raw_ptr() as *char
    unsafe { return toka_tls_server_context_new_with_cert_file(*cert_ptr, *key_ptr) }
}

pub fn net_tls_set_verify_mode(*handle: void, verify_peer: bool) {
    unsafe {
        if verify_peer { toka_tls_set_verify_mode(*handle, 1) }
        else { toka_tls_set_verify_mode(*handle, 0) }
    }
}

pub fn net_tls_set_ca_file(*handle: void, ca_path: string) -> i32 {
    auto ca_cstr# = ca_path.clone()
    auto *ca_ptr# = ca_cstr.raw_ptr() as *char
    unsafe { return toka_tls_set_ca_file(*handle, *ca_ptr) }
}

pub fn net_tls_set_sni(*handle: void, host: string) -> i32 {
    auto host_cstr# = host.clone()
    auto *host_ptr# = host_cstr.raw_ptr() as *char
    unsafe { return toka_tls_set_sni(*handle, *host_ptr) }
}

pub fn net_tls_close(*handle: void) {
    unsafe { toka_tls_close(*handle) }
}

// Owner-carrying async buffer results. The buffer is returned on every path;
// the adapter never consumes it implicitly on timeout, cancellation, or error.
pub shape AsyncReadResult (
    buffer: Vec<u8>,
    bytes_read: usize,
    eof: bool
)

impl AsyncReadResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        return cede self.buffer
    }
}

pub shape AsyncWriteResult (
    buffer: Vec<u8>,
    bytes_written: usize,
    complete: bool
)

impl AsyncWriteResult {
    pub fn take_buffer(cede self) -> Vec<u8> {
        return cede self.buffer
    }
}

pub shape AsyncIoError (
    buffer: Vec<u8>,
    message: string
)

impl AsyncIoError {
    pub fn take_buffer(cede self) -> Vec<u8> {
        return cede self.buffer
    }
}

pub shape Ipv4Addr (
    octets: [u8; 4]
)

impl Ipv4Addr {
    pub fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        auto octets: [u8; 4] = [a, b, c, d]
        return Ipv4Addr(octets = octets)
    }

    pub fn to_u32(self) -> u32 {
        auto a = self.octets[0] as u32
        auto b = self.octets[1] as u32
        auto c = self.octets[2] as u32
        auto d = self.octets[3] as u32
        return a bor (b bshl 8) bor (c bshl 16) bor (d bshl 24)
    }

    pub fn from_u32(ip: u32) -> Ipv4Addr {
        auto a = (ip band 0xFF) as u8
        auto b = ((ip bshr 8) band 0xFF) as u8
        auto c = ((ip bshr 16) band 0xFF) as u8
        auto d = ((ip bshr 24) band 0xFF) as u8
        return Ipv4Addr::new(a, b, c, d)
    }
}

pub fn resolve_ipv4(host: string) -> Result<Ipv4Addr, string> {
    auto *host_ptr = host.c_str() as *char
    auto ip = toka_resolve_ipv4(*host_ptr)
    if ip == 0:u32 {
        return Result<Ipv4Addr, string>::Err(string::from("DNS resolution failed"))
    }
    return Result<Ipv4Addr, string>::Ok(Ipv4Addr::from_u32(ip))
}

pub shape SocketAddrV4 (
    ip: Ipv4Addr,
    port: u16
)

impl SocketAddrV4 {
    pub fn new(ip: Ipv4Addr, port: u16) -> SocketAddrV4 {
        return SocketAddrV4(ip = ip, port = port)
    }
}

// ==========================================
// UdpSocket
// ==========================================

pub shape UdpRecvInfo (
    len: usize,
    addr: SocketAddrV4
)

pub shape UdpSocket (
    fd: i32,
    closed: bool
)

impl UdpSocket@encap {
    fn drop(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }
}

impl UdpSocket {
    pub fn bind(addr: SocketAddrV4) -> UdpSocket {
        unsafe {
            auto fd = sysnet::net_socket_udp_impl()
            if fd < 0 {
                return UdpSocket(fd=-1, closed=true)
            }

            sysnet::net_setsockopt_reuse_impl(fd)

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_bind_impl(fd, ip_num, addr.port as i32)
            if res != 0 {
                sysnet::net_close_impl(fd)
                return UdpSocket(fd=-1, closed=true)
            }

            return UdpSocket(fd=fd, closed=false)
        }
    }

    pub fn local_port(self) -> u16 {
        auto port = sysnet::net_local_port_impl(self.fd)
        if port < 0 { return 0:u16 }
        return port as u16
    }

    pub fn send_to(self#, *buf: u8, len: usize, addr: SocketAddrV4) -> Result<usize, string> {
        unsafe {
            if self.closed {
                return Result<usize, string>::Err(string::from("Socket closed"))
            }
            auto ip_num = addr.ip.to_u32()
            auto n: i64 = sysnet::net_sendto_impl(self.fd, *buf, len, ip_num as usize, addr.port as i32)
            if n < 0:i64 {
                return Result<usize, string>::Err(string::from("send_to failed"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }

    pub fn recv_from(self#, *buf: u8, len: usize) -> Result<UdpRecvInfo, string> {
        unsafe {
            if self.closed {
                return Result<UdpRecvInfo, string>::Err(string::from("Socket closed"))
            }
            auto out_host = 0:usize
            auto out_port = 0:i32
            auto *ph = (&out_host as Addr) as *usize
            auto *pp = (&out_port as Addr) as *i32
            auto n: i64 = sysnet::net_recvfrom_impl(self.fd, *buf, len, *ph, *pp)
            if n < 0:i64 {
                return Result<UdpRecvInfo, string>::Err(string::from("recv_from failed"))
            }
            auto ip = Ipv4Addr::from_u32(out_host as u32)
            auto sender_addr = SocketAddrV4::new(ip, out_port as u16)
            return Result<UdpRecvInfo, string>::Ok(UdpRecvInfo(len = n as usize, addr = sender_addr))
        }
    }

    pub fn close(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }

    pub fn is_valid(self) -> bool {
        return self.fd >= 0
    }
}

// ==========================================
// TcpStream
// ==========================================

pub shape TcpStream (
    fd: i32,
    closed: bool
)

impl TcpStream@encap {
    pub fd, closed
    fn drop(self#) {
        self#.close()
    }

}

impl TcpStream {
    pub fn get_fd(self#) -> i32 {
        return self.fd
    }

    pub fn disarm(self#) {
        self.fd = -1
        self.closed = true
    }

    pub fn take(self#) -> TcpStream {
        auto s = TcpStream(
            fd = self.fd,
            closed = self.closed
        )
        self.fd = -1
        self.closed = true
        return s
    }

    pub fn try_connect(addr: SocketAddrV4) -> Result<TcpStream, IoError> {
        unsafe {
            auto fd = sysnet::net_socket_impl()
            if fd < 0 {
                return Result<TcpStream, IoError>::Err(
                    IoError::new("socket", sysnet::get_errno_impl(), "failed to create TCP socket")
                )
            }

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_connect_impl(fd, ip_num, addr.port)
            if res != 0 {
                auto os_code = sysnet::get_errno_impl()
                sysnet::net_close_impl(fd)
                return Result<TcpStream, IoError>::Err(
                    IoError::new("connect", os_code, "failed to connect TCP stream")
                )
            }

            return Result<TcpStream, IoError>::Ok(TcpStream(fd=fd, closed=false))
        }
    }

    // Compatibility constructor. New production code should use try_connect
    // when it needs the operation and native error code on failure.
    pub fn connect(addr: SocketAddrV4) -> TcpStream {
        auto connected = TcpStream::try_connect(addr)
        match cede connected {
            auto Result<TcpStream, IoError>::Ok('stream) => return 'stream
            _ => return TcpStream(fd=-1, closed=true)
        }
    }

    pub fn connect_async(cede addr: SocketAddrV4) -> async TcpStream {
        auto addr_val = cede addr
        unsafe {
            auto *fd_box# = unsafe alloc [4] byte as *[i32]
            auto *p_free# = &fd_box[0] as *void
            fd_box[0] = sysnet::net_socket_impl()
            auto raw_fd# = fd_box[0]
            if raw_fd < 0 {
                libc_free(*p_free as *void)
                return TcpStream(fd=-1, closed=true)
            }

            sysnet::net_set_nonblocking_impl(raw_fd)

            auto ip_num = addr_val.ip.to_u32()
            auto res = sysnet::net_connect_impl(raw_fd, ip_num, addr_val.port)

            if res == 0 {
                // Connected instantly
                sleep_async(0).await
                auto ret = TcpStream(fd=raw_fd, closed=false)
                raw_fd = -1
                fd_box[0] = -1
                libc_free(*p_free as *void)
                return ret
            }

            auto errno = sysnet::get_errno_impl()
            if errno != 36 && errno != 115 && errno != 10035 {
                sysnet::net_close_impl(raw_fd)
                raw_fd = -1
                fd_box[0] = -1
                libc_free(*p_free as *void)
                sleep_async(0).await
                return TcpStream(fd=-1, closed=true)
            }

            if !register_async_reactor_write(__builtin_coro_current_handle() as Addr, raw_fd) {
                sysnet::net_close_impl(raw_fd)
                raw_fd = -1
                fd_box[0] = -1
                libc_free(*p_free as *void)
                return TcpStream(fd=-1, closed=true)
            }
            __builtin_coro_suspend()

            auto *coro_handle = __builtin_coro_current_handle()
            if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                sysnet::net_close_impl(raw_fd)
                raw_fd = -1
                fd_box[0] = -1
                libc_free(*p_free as *void)
                return TcpStream(fd=-1, closed=true)
            }

            auto get_err = sysnet::net_getsockopt_error_impl(raw_fd)
            if get_err != 0 {
                sysnet::net_close_impl(raw_fd)
                raw_fd = -1
                fd_box[0] = -1
                libc_free(*p_free as *void)
                return TcpStream(fd=-1, closed=true)
            }

            auto ret = TcpStream(fd=raw_fd, closed=false)
            raw_fd = -1
            fd_box[0] = -1
            libc_free(*p_free as *void)
            return ret
        }
    }

    pub fn connect_async_timeout(cede addr: SocketAddrV4, timeout_ms: i32) -> async Result<TcpStream, string> {
        auto conn_task = TcpStream::connect_async(cede addr).start
        auto timeout_task = sleep_async(timeout_ms).start
        auto winner# = race2<TcpStream, i32>(cede conn_task, cede timeout_task).await

        match cede winner {
            auto RaceWinner<TcpStream, i32>::First('stream) => {
                if 'stream.fd < 0 {
                    return Result<TcpStream, string>::Err(string::from("Connection failed"))
                }
                return Result<TcpStream, string>::Ok(cede 'stream)
            }
            auto RaceWinner<TcpStream, i32>::Second(_delay) => {
                return Result<TcpStream, string>::Err(string::from("Connection timed out"))
            }
        }
    }

    pub fn read(self#, *buf: u8, len: usize) -> Result<usize, string> {
        unsafe {
            auto my_fd = self.fd
            if self.closed {
                return Result<usize, string>::Err(string::from("Stream closed"))
            }
            auto n: i64 = sysnet::net_read_impl(my_fd, *buf, len)
            if n < 0 {
                return Result<usize, string>::Err(string::from("Read error"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }

    pub fn read_exact(self#, *buf: u8, len: usize) -> Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.read(*current_ptr, len - total)
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Unexpected EOF during read_exact"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn write(self#, *buf: u8, len: usize) -> Result<usize, string> {
        unsafe {
            auto my_fd = self.fd
            if self.closed {
                return Result<usize, string>::Err(string::from("Stream closed"))
            }
            auto n: i64 = sysnet::net_write_impl(my_fd, *buf, len)
            if n < 0 {
                return Result<usize, string>::Err(string::from("Write error"))
            }
            return Result<usize, string>::Ok(n as usize)
        }
    }


    // Helper to write string
    pub fn write_string(self#, s: string) -> Result<usize, string> {
        auto len = s.len()
        auto *ptr = s.c_str() as *u8
        return self#.write(*ptr, len)
    }

    pub fn write_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        if self.closed || self.fd < 0 {
            return Result<usize, string>::Err(string::from("Stream closed"))
        }
        return net_async_write_fd(self.fd, *buf, len).await
    }

    // Owner-based adapter. The Vec is held by the coroutine frame while the
    // legacy pointer API is suspended and is returned on every outcome.
    pub fn write_from_async(self#, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<AsyncWriteResult, AsyncIoError> {
        auto owned# = cede owner
        auto len = owned.len()
        auto failed# = false
        auto message# = string::from("")
        auto written# = 0:usize

        if self.closed || self.fd < 0 {
            failed = true
            message = string::from("Stream closed")
        } else if len > 0:usize {
            auto *buf_ptr# = owned.unsafe_get(0)
            auto write_res = self#.write_all_async_timeout(*buf_ptr, len, timeout_ms).await
            if write_res.is_err() {
                failed = true
                message = write_res.unwrap_err()
            } else {
                written = len
            }
        }

        if failed {
            return Result<AsyncWriteResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = cede message
            ))
        }
        return Result<AsyncWriteResult, AsyncIoError>::Ok(AsyncWriteResult(
            buffer = cede owned,
            bytes_written = written,
            complete = written == len
        ))
    }

    pub fn write_string_async(self#, s: string) -> async Result<usize, string> {
        auto len = s.len()
        auto *ptr = s.c_str() as *u8
        return self#.write_async(*ptr, len).await
    }

    pub fn write_view(self#, v: str) -> Result<usize, string> {
        auto *ptr = v.raw_ptr() as *u8
        return self#.write(*ptr, v.len())
    }

    pub fn write_view_async(self#, v: str) -> async Result<usize, string> {
        auto *ptr = v.raw_ptr() as *u8
        return self#.write_async(*ptr, v.len()).await
    }

    pub fn read_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        if self.closed || self.fd < 0 {
            return Result<usize, string>::Err(string::from("Stream closed"))
        }
        return net_async_read_fd(self.fd, *buf, len).await
    }

    // Owner-based adapter. The returned Vec length is the initialized byte
    // count; capacity is retained for a subsequent read by the caller.
    pub fn read_into_async(self#, cede owner: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        auto failed# = false
        auto message# = string::from("")
        auto bytes_read# = 0:usize

        if self.closed || self.fd < 0 {
            failed = true
            message = string::from("Stream closed")
        } else if max_len > 0:usize {
            if owned.cap() < max_len {
                owned#.resize(max_len, 0:u8)
            } else {
                owned#.unsafe_set_len(max_len)
            }
            auto *buf_ptr# = owned.unsafe_get(0)
            auto read_res = self#.read_async_timeout(*buf_ptr, max_len, timeout_ms).await
            match read_res {
                auto Result<usize, string>::Ok(n) => { bytes_read = n }
                auto Result<usize, string>::Err(&e) => {
                    failed = true
                    message = e.clone()
                }
            }
        }

        if failed {
            owned#.unsafe_set_len(0:usize)
            return Result<AsyncReadResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = cede message
            ))
        }
        owned#.unsafe_set_len(bytes_read)
        return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
            buffer = cede owned,
            bytes_read = bytes_read,
            eof = bytes_read == 0:usize
        ))
    }

    pub fn read_exact_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.read_async(*current_ptr, len - total).await
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Unexpected EOF during read_exact_async"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn read_async_timeout(self#, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
        if self.closed || self.fd < 0 {
            return Result<usize, string>::Err(string::from("Stream closed"))
        }
        if timeout_ms > 0 {
            return net_async_read_timeout_fd(self.fd, *buf, len, timeout_ms).await
        }
        return net_async_read_fd(self.fd, *buf, len).await
    }

    // TLS FFI adapter. The raw handle/buffer arguments are intentionally kept
    // in std/net; stdx only delegates to these methods.
    pub fn tls_connect_async(self#, *handle: void, timeout_ms: i32) -> async Result<(), string> {
        if self.closed || self.fd < 0 {
            return Result<(), string>::Err(string::from("Stream closed"))
        }
        auto fd = self.fd
        auto start_time = current_time_ms()
        auto last_key# = 0:u64
        auto is_read_key# = false

        loop true {
            if timeout_ms > 0 {
                auto elapsed = current_time_ms() - start_time
                if elapsed >= (timeout_ms as i64) {
                    if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                    else { unregister_async_reactor_write_key(fd, last_key) }
                    return Result<(), string>::Err(string::from("TLS handshake timeout"))
                }
            }

            auto handshake = unsafe toka_tls_connect(*handle, fd)
            if handshake == 0 {
                return Result<(), string>::Ok(())
            }
            if handshake < 0 {
                return Result<(), string>::Err(string::from("TLS handshake failed"))
            }

            auto *coro_handle# = __builtin_coro_current_handle()
            if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                else { unregister_async_reactor_write_key(fd, last_key) }
                return Result<(), string>::Err(string::from("TLS handshake canceled"))
            }
            if handshake == 1 {
                is_read_key = true
                if !register_async_reactor_read_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else { __builtin_coro_suspend() }
            } else {
                is_read_key = false
                if !register_async_reactor_write_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else { __builtin_coro_suspend() }
            }
        }
        return Result<(), string>::Err(string::from("TLS handshake failed"))
    }

    pub fn tls_accept_async(self#, *handle: void, timeout_ms: i32) -> async Result<(), string> {
        if self.closed || self.fd < 0 {
            return Result<(), string>::Err(string::from("Stream closed"))
        }
        auto fd = self.fd
        auto start_time = current_time_ms()
        auto last_key# = 0:u64
        auto is_read_key# = false

        loop true {
            if timeout_ms > 0 {
                auto elapsed = current_time_ms() - start_time
                if elapsed >= (timeout_ms as i64) {
                    if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                    else { unregister_async_reactor_write_key(fd, last_key) }
                    return Result<(), string>::Err(string::from("TLS server handshake timeout"))
                }
            }

            auto handshake = unsafe toka_tls_accept(*handle, fd)
            if handshake == 0 {
                return Result<(), string>::Ok(())
            }
            if handshake < 0 {
                return Result<(), string>::Err(string::from("TLS server handshake failed"))
            }

            auto *coro_handle# = __builtin_coro_current_handle()
            if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                else { unregister_async_reactor_write_key(fd, last_key) }
                return Result<(), string>::Err(string::from("TLS server handshake canceled"))
            }
            if handshake == 1 {
                is_read_key = true
                if !register_async_reactor_read_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else { __builtin_coro_suspend() }
            } else {
                is_read_key = false
                if !register_async_reactor_write_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else { __builtin_coro_suspend() }
            }
        }
        return Result<(), string>::Err(string::from("TLS server handshake failed"))
    }

    pub fn tls_read_async(self#, *handle: void, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
        if self.closed || self.fd < 0 {
            return Result<usize, string>::Err(string::from("Stream closed"))
        }
        auto fd = self.fd
        auto start_time = current_time_ms()
        auto last_key# = 0:u64
        auto is_read_key# = false

        loop true {
            if timeout_ms > 0 {
                auto elapsed = current_time_ms() - start_time
                if elapsed >= (timeout_ms as i64) {
                    if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                    else { unregister_async_reactor_write_key(fd, last_key) }
                    return Result<usize, string>::Err(string::from("TLS read timeout"))
                }
            }

            auto n = unsafe toka_tls_read(*handle, *buf, len)
            if n > 0 { return Result<usize, string>::Ok(n as usize) }
            if n == 0 { return Result<usize, string>::Ok(0:usize) }

            auto *coro_handle# = __builtin_coro_current_handle()
            if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                else { unregister_async_reactor_write_key(fd, last_key) }
                return Result<usize, string>::Err(string::from("TLS read canceled"))
            }

            if n == -1 {
                is_read_key = true
                if !register_async_reactor_read_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else {
                    __builtin_coro_suspend()
                }
            } else if n == -2 {
                is_read_key = false
                if !register_async_reactor_write_key(*coro_handle as Addr, fd, &last_key as *u64) {
                    sleep_async(1:u64).await
                } else {
                    __builtin_coro_suspend()
                }
            } else {
                return Result<usize, string>::Err(string::from("TLS read error"))
            }
        }
        return Result<usize, string>::Err(string::from("TLS read timeout"))
    }

    pub fn write_all_async_timeout(self#, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
        if self.closed || self.fd < 0 {
            return Result<usize, string>::Err(string::from("Stream closed"))
        }
        if timeout_ms > 0 {
            return net_async_write_timeout_fd(self.fd, *buf, len, timeout_ms).await
        }
        return self#.write_all_async(*buf, len).await
    }

    pub fn tls_write_all_async(self#, *handle: void, *buf: u8, len: usize, timeout_ms: i32) -> async Result<(), string> {
        if self.closed || self.fd < 0 {
            return Result<(), string>::Err(string::from("Stream closed"))
        }
        auto total# = 0:usize
        auto fd = self.fd
        auto start_time = current_time_ms()
        auto last_key# = 0:u64
        auto is_read_key# = false

        loop total < len {
            auto cur_addr = (*buf as Addr) + (total as u64)
            auto *cur_buf# = (cur_addr as *[0]u8) as *u8
            auto write_ok# = false
            loop !write_ok {
                if timeout_ms > 0 {
                    auto elapsed = current_time_ms() - start_time
                    if elapsed >= (timeout_ms as i64) {
                        if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                        else { unregister_async_reactor_write_key(fd, last_key) }
                        return Result<(), string>::Err(string::from("TLS write_all timeout"))
                    }
                }

                auto n = unsafe toka_tls_write(*handle, *cur_buf, len - total)
                if n > 0 {
                    total = total + (n as usize)
                    write_ok = true
                    break
                }

                auto *coro_handle# = __builtin_coro_current_handle()
                if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                    if is_read_key { unregister_async_reactor_read_key(fd, last_key) }
                    else { unregister_async_reactor_write_key(fd, last_key) }
                    return Result<(), string>::Err(string::from("TLS write_all canceled"))
                }

                if n == -1 {
                    is_read_key = true
                    if !register_async_reactor_read_key(*coro_handle as Addr, fd, &last_key as *u64) {
                        sleep_async(1:u64).await
                    } else {
                        __builtin_coro_suspend()
                    }
                } else if n == -2 {
                    is_read_key = false
                    if !register_async_reactor_write_key(*coro_handle as Addr, fd, &last_key as *u64) {
                        sleep_async(1:u64).await
                    } else {
                        __builtin_coro_suspend()
                    }
                } else {
                    return Result<(), string>::Err(string::from("TLS write_all error"))
                }
            }
        }
        return Result<(), string>::Ok(())
    }

    pub fn tls_close(self#, *handle: void) {
        unsafe toka_tls_close(*handle)
    }

    pub fn write_all_async(self#, *buf: u8, len: usize) -> async Result<usize, string> {
        auto total# = 0:usize
        loop total < len {
            auto *current_ptr = (*buf as Addr + total as u64) as *u8
            auto res = self#.write_async(*current_ptr, len - total).await
            match res {
                auto Result::Ok(n) => {
                    if n == 0:usize {
                        return Result<usize, string>::Err(string::from("Zero byte written during write_all_async"))
                    }
                    total = total + n
                }
                auto Result::Err(&e) => {
                    return Result<usize, string>::Err(e.clone())
                }
            }
        }
        return Result<usize, string>::Ok(total)
    }

    pub fn close(self#) {
        unsafe {
            if !self.closed {
                auto fd = self.fd
                self.fd = -1
                self.closed = true
                if fd >= 0 {
                    sysnet::reactor_del_fd_impl(get_reactor_fd(), fd)
                    sysnet::net_close_impl(fd)
                }
            }
        }
    }
    pub fn is_valid(self) -> bool {
        return !self.closed && self.fd >= 0
    }

    pub fn get_fd(self) -> i32 {
        return self.fd
    }
}

// Opaque ownership wrapper for a TLS engine instance. The C handle never
// leaves std/net: higher layers own a TlsSession, not a raw OpenSSL pointer.
pub shape TlsSession (
    *#handle: void
)

impl TlsSession@encap {
    fn drop(self#) {
        self#.close()
    }

}

impl TlsSession {
    pub fn empty() -> TlsSession {
        auto *null_handle# = (0 as Addr) as *void
        return TlsSession(*handle = *null_handle)
    }

    pub fn client() -> TlsSession {
        auto *created# = net_tls_context_new()
        return TlsSession(*handle = *created)
    }

    pub fn server() -> TlsSession {
        auto *created# = net_tls_server_context_new()
        return TlsSession(*handle = *created)
    }

    pub fn server_with_cert_file(cert_path: string, key_path: string) -> TlsSession {
        auto *created# = net_tls_server_context_new_with_cert_file(cert_path, key_path)
        return TlsSession(*handle = *created)
    }

    pub fn is_valid(self) -> bool {
        return (self.*handle as Addr) != 0
    }

    pub fn take(self#) -> TlsSession {
        auto session = TlsSession(*handle = self.*handle)
        auto *null_handle# = (0 as Addr) as *void
        self.*handle = *null_handle
        return session
    }

    pub fn close(self#) {
        if self#.is_valid() {
            net_tls_close(self.*handle)
            auto *null_handle# = (0 as Addr) as *void
            self.*handle = *null_handle
        }
    }

    pub fn set_verify_mode(self#, verify_peer: bool) {
        if self#.is_valid() {
            net_tls_set_verify_mode(self.*handle, verify_peer)
        }
    }

    pub fn set_ca_file(self#, ca_path: string) -> i32 {
        if !self#.is_valid() { return -1 }
        return net_tls_set_ca_file(self.*handle, ca_path)
    }

    pub fn set_sni(self#, host: string) -> i32 {
        if !self#.is_valid() { return -1 }
        return net_tls_set_sni(self.*handle, host)
    }

    pub fn connect_async(self#, tcp#: TcpStream, timeout_ms: i32) -> async Result<(), string> {
        if !self#.is_valid() {
            return Result<(), string>::Err(string::from("TLS session is closed"))
        }
        return tcp#.tls_connect_async(self.*handle, timeout_ms).await
    }

    pub fn accept_async(self#, tcp#: TcpStream, timeout_ms: i32) -> async Result<(), string> {
        if !self#.is_valid() {
            return Result<(), string>::Err(string::from("TLS session is closed"))
        }
        return tcp#.tls_accept_async(self.*handle, timeout_ms).await
    }

    // Compatibility-only pointer entry points remain on TcpStream. New stdx
    // protocols use the owner-carrying methods below instead.
    pub fn read_async(self#, tcp#: TcpStream, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
        if !self#.is_valid() {
            return Result<usize, string>::Err(string::from("TLS session is closed"))
        }
        return tcp#.tls_read_async(self.*handle, *buf, len, timeout_ms).await
    }

    pub fn write_all_async(self#, tcp#: TcpStream, *buf: u8, len: usize, timeout_ms: i32) -> async Result<(), string> {
        if !self#.is_valid() {
            return Result<(), string>::Err(string::from("TLS session is closed"))
        }
        return tcp#.tls_write_all_async(self.*handle, *buf, len, timeout_ms).await
    }

    // The Vec is retained by the coroutine frame while the TLS reactor waits
    // and is returned on all outcomes, exactly like TcpStream::read_into_async.
    pub fn read_into_async(self#, tcp#: TcpStream, cede owner: Vec<u8>, max_len: usize, timeout_ms: i32) -> async Result<AsyncReadResult, AsyncIoError> {
        auto owned# = cede owner
        auto failed# = false
        auto message# = string::from("")
        auto bytes_read# = 0:usize

        if !self#.is_valid() {
            failed = true
            message = string::from("TLS session is closed")
        } else if max_len > 0:usize {
            if owned.cap() < max_len {
                owned#.resize(max_len, 0:u8)
            } else {
                owned#.unsafe_set_len(max_len)
            }
            auto *buf_ptr# = owned.unsafe_get(0)
            auto read_res = tcp#.tls_read_async(self.*handle, *buf_ptr, max_len, timeout_ms).await
            match read_res {
                auto Result<usize, string>::Ok(n) => { bytes_read = n }
                auto Result<usize, string>::Err(&e) => {
                    failed = true
                    message = e.clone()
                }
            }
        }

        if failed {
            owned#.unsafe_set_len(0:usize)
            return Result<AsyncReadResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = cede message
            ))
        }
        owned#.unsafe_set_len(bytes_read)
        return Result<AsyncReadResult, AsyncIoError>::Ok(AsyncReadResult(
            buffer = cede owned,
            bytes_read = bytes_read,
            eof = bytes_read == 0:usize
        ))
    }

    pub fn write_from_async(self#, tcp#: TcpStream, cede owner: Vec<u8>, timeout_ms: i32) -> async Result<AsyncWriteResult, AsyncIoError> {
        auto owned# = cede owner
        auto len = owned.len()
        auto failed# = false
        auto message# = string::from("")
        auto written# = 0:usize

        if !self#.is_valid() {
            failed = true
            message = string::from("TLS session is closed")
        } else if len > 0:usize {
            auto *buf_ptr# = owned.unsafe_get(0)
            auto write_res = tcp#.tls_write_all_async(self.*handle, *buf_ptr, len, timeout_ms).await
            if write_res.is_err() {
                failed = true
                message = write_res.unwrap_err()
            } else {
                written = len
            }
        }

        if failed {
            return Result<AsyncWriteResult, AsyncIoError>::Err(AsyncIoError(
                buffer = cede owned,
                message = cede message
            ))
        }
        return Result<AsyncWriteResult, AsyncIoError>::Ok(AsyncWriteResult(
            buffer = cede owned,
            bytes_written = written,
            complete = written == len
        ))
    }
}

// ==========================================
// TcpListener
// ==========================================

pub shape TcpListener (
    fd: i32,
    closed: bool
)

impl TcpListener@encap {
    fn drop(self#) {
        unsafe {
            if !self.closed {
                sysnet::net_close_impl(self.fd)
                self.closed = true
            }
        }
    }

}

impl TcpListener {
    pub fn bind(addr: SocketAddrV4) -> TcpListener {
        unsafe {
            auto fd = sysnet::net_socket_impl()
            if fd < 0 {
                return TcpListener(fd=-1, closed=true)
            }

            // SO_REUSEADDR
            sysnet::net_setsockopt_reuse_impl(fd)

            auto ip_num = addr.ip.to_u32()
            auto res = sysnet::net_bind_impl(fd, ip_num, addr.port)
            if res != 0 {
                sysnet::net_close_impl(fd)
                return TcpListener(fd=-1, closed=true)
            }

            auto lres = sysnet::net_listen_impl(fd)
            if lres != 0 {
                sysnet::net_close_impl(fd)
                return TcpListener(fd=-1, closed=true)
            }

            return TcpListener(fd=fd, closed=false)
        }
    }

    pub fn get_fd(self) -> i32 {
        return self.fd
    }

    pub fn local_port(self) -> u16 {
        auto port = sysnet::net_local_port_impl(self.fd)
        if port < 0 { return 0:u16 }
        return port as u16
    }

    pub fn accept(self#) -> TcpStream {
        unsafe {
            if self.closed {
                 return TcpStream(fd=-1, closed=true)
            }

            auto client_fd = sysnet::net_accept_impl(self.fd)
            if client_fd < 0 {
                 return TcpStream(fd=-1, closed=true)
            }

            return TcpStream(fd=client_fd, closed=false)
        }
    }

    pub fn accept_async(self#) -> async TcpStream {
        if self.closed || self.fd < 0 {
            return TcpStream(fd=-1, closed=true)
        }
        auto s# = net_async_accept_fd(self.fd).await
        return s#.take()
    }

    // Wait for listener readiness and cancellation as one WaitRegistry pair.
    // Cancellation never closes the listener behind an in-flight accept, so
    // ownership of this TcpListener remains entirely with its caller.
    pub fn accept_async_context(self#, canceler: Canceler) -> async Result<TcpStream, string> {
        if self.closed || self.fd < 0 {
            return Result<TcpStream, string>::Err(string::from("Listener closed"))
        }
        return net_async_accept_context_fd(self.fd, canceler).await
    }

    pub fn is_valid(self) -> bool {
        return self.fd >= 0
    }
}

pub fn register_async_reactor_read_key(coro: Addr, fd: i32, *out_key: u64) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto wait_id# = 0:u32
        auto slot_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 2:u16, &wait_id as *u32, &slot_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((wait_id as u64) << 32:u64) | (slot_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(wait_id, slot_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            auto *p_key# = *out_key
            p_key = event_key
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

pub fn register_async_reactor_read(coro: Addr, fd: i32) -> bool {
    auto unused_key# = 0:u64
    return register_async_reactor_read_key(coro, fd, &unused_key as *u64)
}

pub fn register_async_reactor_write_key(coro: Addr, fd: i32, *out_key: u64) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto wait_id# = 0:u32
        auto slot_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 3:u16, &wait_id as *u32, &slot_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((wait_id as u64) << 32:u64) | (slot_gen as u64)
            if !sysnet::reactor_add_write_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(wait_id, slot_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            auto *p_key# = *out_key
            p_key = event_key
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

pub fn register_async_reactor_write(coro: Addr, fd: i32) -> bool {
    auto unused_key# = 0:u64
    return register_async_reactor_write_key(coro, fd, &unused_key as *u64)
}

pub fn unregister_async_reactor_read_key(fd: i32, key: u64) {
    if key != 0:u64 {
        auto wait_id = (key >> 32:u64) as u32
        auto slot_gen = (key & 0xFFFFFFFF:u64) as u32
        sysnet::reactor_del_read_impl(get_reactor_fd(), fd, key as Addr)
        core_task::toka_wait_registry_release(wait_id, slot_gen)
    }
}

pub fn unregister_async_reactor_write_key(fd: i32, key: u64) {
    if key != 0:u64 {
        auto wait_id = (key >> 32:u64) as u32
        auto slot_gen = (key & 0xFFFFFFFF:u64) as u32
        sysnet::reactor_del_write_impl(get_reactor_fd(), fd, key as Addr)
        core_task::toka_wait_registry_release(wait_id, slot_gen)
    }
}

fn register_async_reactor_read_timeout(coro: Addr, fd: i32, timeout_ms: i32, *out_io_id: u32, *out_io_gen: u32, *out_tm_id: u32, *out_tm_gen: u32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto io_id# = 0:u32
        auto io_gen# = 0:u32
        auto tm_id# = 0:u32
        auto tm_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate_pair(task_id, wait_gen, 2:u16, 1:u16, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                sysnet::reactor_del_fd_impl(get_reactor_fd(), fd)
                core_task::toka_wait_registry_release(io_id, io_gen)
                core_task::toka_wait_registry_release(tm_id, tm_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            register_timer_token(tm_id, tm_gen, timeout_ms)
            auto *p0# = *out_io_id
            p0 = io_id
            auto *p1# = *out_io_gen
            p1 = io_gen
            auto *p2# = *out_tm_id
            p2 = tm_id
            auto *p3# = *out_tm_gen
            p3 = tm_gen
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

fn register_async_reactor_write_timeout(coro: Addr, fd: i32, timeout_ms: i32, *out_io_id: u32, *out_io_gen: u32, *out_tm_id: u32, *out_tm_gen: u32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto io_id# = 0:u32
        auto io_gen# = 0:u32
        auto tm_id# = 0:u32
        auto tm_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate_pair(task_id, wait_gen, 3:u16, 1:u16, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
            if !sysnet::reactor_add_write_impl(get_reactor_fd(), fd, event_key as Addr) {
                sysnet::reactor_del_fd_impl(get_reactor_fd(), fd)
                core_task::toka_wait_registry_release(io_id, io_gen)
                core_task::toka_wait_registry_release(tm_id, tm_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            register_timer_token(tm_id, tm_gen, timeout_ms)
            auto *p0# = *out_io_id
            p0 = io_id
            auto *p1# = *out_io_gen
            p1 = io_gen
            auto *p2# = *out_tm_id
            p2 = tm_id
            auto *p3# = *out_tm_gen
            p3 = tm_gen
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

// ==== Top Level Async Helpers ====
pub fn net_async_read(stream: TcpStream, *buf: u8, len: usize) -> async Result<usize, string> {
    if stream.closed || stream.fd < 0 {
        return Result<usize, string>::Err(string::from("Stream closed"))
    }
    return net_async_read_fd(stream.fd, *buf, len).await
}

pub fn net_async_read_timeout(stream: TcpStream, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
    if stream.closed || stream.fd < 0 {
        return Result<usize, string>::Err(string::from("Stream closed"))
    }
    return net_async_read_timeout_fd(stream.fd, *buf, len, timeout_ms).await
}

pub fn net_async_read_context(stream: TcpStream, *buf: u8, len: usize, canceler: Canceler) -> async Result<usize, string> {
    if stream.closed || stream.fd < 0 {
        return Result<usize, string>::Err(string::from("Stream closed"))
    }
    return net_async_read_context_fd(stream.fd, *buf, len, canceler).await
}

pub fn net_async_write(stream: TcpStream, *buf: u8, len: usize) -> async Result<usize, string> {
    if stream.closed || stream.fd < 0 {
        return Result<usize, string>::Err(string::from("Stream closed"))
    }
    return net_async_write_fd(stream.fd, *buf, len).await
}

pub fn net_async_accept(listener: TcpListener) -> async TcpStream {
    if listener.closed || listener.fd < 0 {
        return TcpStream(fd=-1, closed=true)
    }
    auto s# = net_async_accept_fd(listener.fd).await
    return s#.take()
}

pub fn net_async_read_fd(fd: i32, *buf: u8, len: usize) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if fd < 0 {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(fd, *buf, len)
                if n >= 0:i64 {
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto last_key# = 0:u64
                        if !register_async_reactor_read_key(__builtin_coro_current_handle() as Addr, fd, &last_key as *u64) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto *coro_handle# = __builtin_coro_current_handle()
                        if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                            unregister_async_reactor_read_key(fd, last_key)
                            ret = Result<usize, string>::Err(string::from("Read canceled"))
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_read_timeout_fd(fd: i32, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if fd < 0 {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto tm_id# = 0:u32
                        auto tm_gen# = 0:u32
                        if !register_async_reactor_read_timeout(__builtin_coro_current_handle() as Addr, fd, timeout_ms, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read timeout"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto *coro_handle# = __builtin_coro_current_handle()
                        auto is_canceled = core_task::toka_task_is_current_canceled(*coro_handle)
                        auto is_timeout = core_task::toka_wait_registry_is_winner(tm_id, tm_gen)
                        auto is_io = core_task::toka_wait_registry_is_winner(io_id, io_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(tm_id, tm_gen)

                        auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)

                        if is_canceled != 0 {
                            sysnet::reactor_del_read_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("Read canceled"))
                            done = true
                        } else if is_timeout != 0 {
                            sysnet::reactor_del_read_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("IO operation timed out"))
                            done = true
                        } else if is_io == 0 {
                            sysnet::reactor_del_read_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("Read canceled"))
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

fn register_async_reactor_read_context(coro: Addr, fd: i32, canceler: Canceler, *out_io_id: u32, *out_io_gen: u32, *out_ctx_id: u32, *out_ctx_gen: u32) -> bool {
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(coro as *void, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto io_id# = 0:u32
        auto io_gen# = 0:u32
        auto ctx_id# = 0:u32
        auto ctx_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate_pair(task_id, wait_gen, 2:u16, 4:u16, &io_id as *u32, &io_gen as *u32, &ctx_id as *u32, &ctx_gen as *u32)
        if alloc_ok != 0 {
            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
            if !sysnet::reactor_add_read_impl(get_reactor_fd(), fd, event_key as Addr) {
                core_task::toka_wait_registry_release(io_id, io_gen)
                core_task::toka_wait_registry_release(ctx_id, ctx_gen)
                core_task::toka_task_abort_suspend(coro as *void)
                return false
            }
            canceler.register_wait_token(ctx_id, ctx_gen)
            auto *p0# = *out_io_id
            p0 = io_id
            auto *p1# = *out_io_gen
            p1 = io_gen
            auto *p2# = *out_ctx_id
            p2 = ctx_id
            auto *p3# = *out_ctx_gen
            p3 = ctx_gen
            core_task::toka_task_commit_suspend(coro as *void)
            return true
        }
        core_task::toka_task_abort_suspend(coro as *void)
    }
    return false
}

pub fn net_async_read_context_fd(fd: i32, *buf: u8, len: usize, canceler: Canceler) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if fd < 0 {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_read_impl(fd, *buf, len)
                if n >= 0:i64 {
                    sleep_async(0:i64).await
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto ctx_id# = 0:u32
                        auto ctx_gen# = 0:u32
                        if !register_async_reactor_read_context(__builtin_coro_current_handle() as Addr, fd, canceler, &io_id as *u32, &io_gen as *u32, &ctx_id as *u32, &ctx_gen as *u32) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async read context"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto is_ctx = core_task::toka_wait_registry_is_winner(ctx_id, ctx_gen)
                        canceler.unregister_wait_token(ctx_id, ctx_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(ctx_id, ctx_gen)
                        if is_ctx != 0 {
                            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
                            sysnet::reactor_del_read_impl(get_reactor_fd(), fd, event_key as Addr)
                            auto c_err = canceler.err()
                            if c_err.is_some() {
                                ret = Result<usize, string>::Err(c_err.unwrap())
                            } else {
                                ret = Result<usize, string>::Err(string::from("context canceled"))
                            }
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<usize, string>::Err(string::from("Read error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

impl TcpListener {
    pub fn disarm(self#) {
        self.fd = -1
        self.closed = true
    }
}

pub fn net_async_accept_fd(listener_fd: i32) -> async TcpStream {
    unsafe {
        if listener_fd < 0 {
            return TcpStream(fd=-1, closed=true)
        } else {
            sysnet::net_set_nonblocking_impl(listener_fd)

            auto done# = false
            loop !done {
                auto client_fd = sysnet::net_accept_impl(listener_fd)
                if client_fd >= 0 {
                    sysnet::net_set_nonblocking_impl(client_fd)
                    return TcpStream(fd=client_fd, closed=false)
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        if !register_async_reactor_read(__builtin_coro_current_handle() as Addr, listener_fd) {
                            return TcpStream(fd=-1, closed=true)
                        }
                        __builtin_coro_suspend()
                    } else {
                        sleep_async(0:i64).await
                        return TcpStream(fd=-1, closed=true)
                    }
                }
            }
        }
    }
    return TcpStream(fd=-1, closed=true)
}

pub fn net_async_accept_context_fd(listener_fd: i32, canceler: Canceler) -> async Result<TcpStream, string> {
    auto ret# = Result<TcpStream, string>::Err(string::from("Unreachable"))
    unsafe {
        if listener_fd < 0 {
            ret = Result<TcpStream, string>::Err(string::from("Listener closed"))
        } else {
            sysnet::net_set_nonblocking_impl(listener_fd)

            auto done# = false
            loop !done {
                auto cancellation = canceler.err()
                if cancellation.is_some() {
                    ret = Result<TcpStream, string>::Err(cancellation.unwrap())
                    done = true
                    continue
                }

                auto client_fd = sysnet::net_accept_impl(listener_fd)
                if client_fd >= 0 {
                    // Do not hand a newly accepted connection to application
                    // code once cancellation is observable.
                    auto after_accept = canceler.err()
                    if after_accept.is_some() {
                        sysnet::net_close_impl(client_fd)
                        ret = Result<TcpStream, string>::Err(after_accept.unwrap())
                    } else {
                        sysnet::net_set_nonblocking_impl(client_fd)
                        ret = Result<TcpStream, string>::Ok(TcpStream(fd=client_fd, closed=false))
                    }
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto ctx_id# = 0:u32
                        auto ctx_gen# = 0:u32
                        if !register_async_reactor_read_context(__builtin_coro_current_handle() as Addr, listener_fd, canceler, &io_id as *u32, &io_gen as *u32, &ctx_id as *u32, &ctx_gen as *u32) {
                            ret = Result<TcpStream, string>::Err(string::from("Failed to register async accept context"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto is_ctx = core_task::toka_wait_registry_is_winner(ctx_id, ctx_gen)
                        canceler.unregister_wait_token(ctx_id, ctx_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(ctx_id, ctx_gen)

                        auto cancellation_after_wait = canceler.err()
                        if is_ctx != 0 || cancellation_after_wait.is_some() {
                            auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)
                            sysnet::reactor_del_read_impl(get_reactor_fd(), listener_fd, event_key as Addr)
                            if cancellation_after_wait.is_some() {
                                ret = Result<TcpStream, string>::Err(cancellation_after_wait.unwrap())
                            } else {
                                ret = Result<TcpStream, string>::Err(string::from("context canceled"))
                            }
                            done = true
                        }
                    } else {
                        sleep_async(0:i64).await
                        ret = Result<TcpStream, string>::Err(string::from("Accept error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_write_fd(fd: i32, *buf: u8, len: usize) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if fd < 0 {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_write_impl(fd, *buf, len)
                if n >= 0:i64 {
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto last_key# = 0:u64
                        if !register_async_reactor_write_key(__builtin_coro_current_handle() as Addr, fd, &last_key as *u64) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async write"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto *coro_handle# = __builtin_coro_current_handle()
                        if core_task::toka_task_is_current_canceled(*coro_handle) != 0 {
                            unregister_async_reactor_write_key(fd, last_key)
                            ret = Result<usize, string>::Err(string::from("Write canceled"))
                            done = true
                        }
                    } else {
                        ret = Result<usize, string>::Err(string::from("Write error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

pub fn net_async_write_timeout_fd(fd: i32, *buf: u8, len: usize, timeout_ms: i32) -> async Result<usize, string> {
    auto ret# = Result<usize, string>::Err(string::from("Unreachable"))
    unsafe {
        if fd < 0 {
            ret = Result<usize, string>::Err(string::from("Stream closed"))
        } else {
            sysnet::net_set_nonblocking_impl(fd)

            auto done# = false
            loop !done {
                auto n: i64 = sysnet::net_write_impl(fd, *buf, len)
                if n >= 0:i64 {
                    ret = Result<usize, string>::Ok(n as usize)
                    done = true
                } else {
                    auto err = sysnet::get_errno_impl()
                    auto eagain = sysnet::get_eagain_impl()

                    if err == eagain {
                        auto io_id# = 0:u32
                        auto io_gen# = 0:u32
                        auto tm_id# = 0:u32
                        auto tm_gen# = 0:u32
                        if !register_async_reactor_write_timeout(__builtin_coro_current_handle() as Addr, fd, timeout_ms, &io_id as *u32, &io_gen as *u32, &tm_id as *u32, &tm_gen as *u32) {
                            ret = Result<usize, string>::Err(string::from("Failed to register async write timeout"))
                            done = true
                            continue
                        }
                        __builtin_coro_suspend()

                        auto *coro_handle# = __builtin_coro_current_handle()
                        auto is_canceled = core_task::toka_task_is_current_canceled(*coro_handle)
                        auto is_timeout = core_task::toka_wait_registry_is_winner(tm_id, tm_gen)
                        auto is_io = core_task::toka_wait_registry_is_winner(io_id, io_gen)
                        core_task::toka_wait_registry_release(io_id, io_gen)
                        core_task::toka_wait_registry_release(tm_id, tm_gen)

                        auto event_key = ((io_id as u64) << 32:u64) | (io_gen as u64)

                        if is_canceled != 0 {
                            sysnet::reactor_del_write_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("Write canceled"))
                            done = true
                        } else if is_timeout != 0 {
                            sysnet::reactor_del_write_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("Write timeout"))
                            done = true
                        } else if is_io == 0 {
                            sysnet::reactor_del_write_impl(get_reactor_fd(), fd, event_key as Addr)
                            ret = Result<usize, string>::Err(string::from("Write canceled"))
                            done = true
                        }
                    } else {
                        ret = Result<usize, string>::Err(string::from("Write error"))
                        done = true
                    }
                }
            }
        }
    }
    return ret
}

impl TcpStream@Reader {
    pub fn read_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.read(*buf, len)
    }
}

impl TcpStream@Writer {
    pub fn write_bytes(self#, *buf: u8, len: usize) -> Result<usize, string> {
        return self#.write(*buf, len)
    }
}
