import core/types::{usize, Addr, ADDR0}
import core/traits::{@PartialOrd, @PartialEq, @Encap, @Dup}
import core/option::{Option, Option}

pub fn addr_is_null(a: Addr) -> bool {
    return (a as u64) == 0:u64
}

pub fn addr_is_not_null(a: Addr) -> bool {
    return (a as u64) != 0:u64
}

shape BTreeNode<'K, 'V> (
    len#: usize = 0,
    is_leaf#: bool = true,
    keys#: ['K; 5],
    vals#: ['V; 5],
    children#: [Addr; 6]
)

impl<'K, 'V> BTreeNode<'K, 'V> {
    pub fn destroy(node_addr: Addr) {
        unsafe {
            if addr_is_null(node_addr) { return }
            auto *n# = node_addr as *BTreeNode<'K, 'V>
            
            auto i# = 0:usize
            loop i < n.len {
                auto _k = cede n.keys[i]
                auto _v = cede n.vals[i]
                i += 1
            }
            
            if !n.is_leaf {
                auto j# = 0:usize
                loop j <= n.len {
                    auto c_addr = n.children[j]
                    if addr_is_not_null(c_addr) {
                        BTreeNode<'K, 'V>::destroy(c_addr)
                    }
                    j += 1
                }
            }
            // The initialized entries were consumed above.  Deallocate the
            // node storage without recursively dropping its fixed arrays.
            unsafe free [0] (node_addr as *[BTreeNode<'K, 'V>])
        }
    }

    pub fn new(is_leaf: bool) -> Addr {
        unsafe {
            auto node_addr = (unsafe alloc [1] BTreeNode<'K, 'V>) as Addr
            auto *node# = node_addr as *BTreeNode<'K, 'V>
            node.len = 0
            node.is_leaf = is_leaf
            
            auto i# = 0:usize
            loop i < 6 {
                node.children[i] = 0:Addr
                i += 1
            }
            return node_addr
        }
    }

    pub fn split_child(self#, i: usize) {
        unsafe {
            auto *y# = self.children[i] as *BTreeNode<'K, 'V>
            auto z_addr = BTreeNode<'K, 'V>::new(y.is_leaf)
            auto *z# = z_addr as *BTreeNode<'K, 'V>
            
            z.len = 2
            
            auto j# = 0:usize
            loop j < 2 {
                z.keys[j] = cede y.keys[j + 3]
                z.vals[j] = cede y.vals[j + 3]
                j += 1
            }
            if !y.is_leaf {
                j = 0
                loop j < 3 {
                    z.children[j] = y.children[j + 3]
                    y.children[j + 3] = 0:Addr
                    j += 1
                }
            }
            y.len = 2
            
            j = self.len
            loop j > i {
                self.children[j + 1] = self.children[j]
                j -= 1
            }
            self.children[i + 1] = z_addr
            
            j = self.len
            loop j > i {
                self.keys[j] = cede self.keys[j - 1]
                self.vals[j] = cede self.vals[j - 1]
                j -= 1
            }
            
            self.keys[i] = cede y.keys[2]
            self.vals[i] = cede y.vals[2]
            
            self.len += 1
        }
    }
}

pub fn btree_node_insert_non_full_iterative<'K: @PartialOrd, 'V>(root_addr: Addr, cede 'key: K, cede 'val: V) -> bool {
    unsafe {
        auto key_buf# = [cede 'key]
        auto val_buf# = [cede 'val]
        auto curr_addr# = root_addr
        
        loop true {
            auto *node# = curr_addr as *BTreeNode<'K, 'V>
            auto idx# = 0:usize
            
            loop idx < node.len {
                auto k_ptr_cur = node.keys[idx]
                auto tmp_k = cede key_buf[0]
                auto cmp_res = tmp_k.cmp(k_ptr_cur)
                key_buf[0] = cede tmp_k
                
                if cmp_res == 0 {
                    node.vals[idx] = cede val_buf[0]
                    auto _drop_k = cede key_buf[0]
                    return false
                }
                idx += 1
            }
            
            if node.is_leaf {
                auto j# = node.len:usize
                loop j > 0 {
                    auto k_ptr_loop = node.keys[j - 1]
                    auto tmp_k2 = cede key_buf[0]
                    auto cmp = tmp_k2.cmp(k_ptr_loop)
                    key_buf[0] = cede tmp_k2
                    if cmp < 0 {
                        node.keys[j] = cede node.keys[j - 1]
                        node.vals[j] = cede node.vals[j - 1]
                        j -= 1
                    } else {
                        break
                    }
                }
                node.keys[j] = cede key_buf[0]
                node.vals[j] = cede val_buf[0]
                node.len += 1
                return true
            } else {
                auto j# = node.len:usize
                loop j > 0 {
                    auto k_ptr_loop = node.keys[j - 1]
                    auto tmp_k3 = cede key_buf[0]
                    auto cmp = tmp_k3.cmp(k_ptr_loop)
                    key_buf[0] = cede tmp_k3
                    if cmp > 0 {
                        break
                    }
                    j -= 1
                }
                auto idx2# = j
                auto child_addr = node.children[idx2]
                auto *child# = child_addr as *BTreeNode<'K, 'V>
                if child.len == 5 {
                    node#.split_child(idx2)
                    auto new_k_ptr = node.keys[idx2]
                    auto tmp_k4 = cede key_buf[0]
                    auto cmp2 = tmp_k4.cmp(new_k_ptr)
                    key_buf[0] = cede tmp_k4
                    if cmp2 > 0 {
                        idx2 += 1
                    }
                }
                curr_addr = node.children[idx2]
            }
        }
        return false
    }
}

pub shape BTreeMap<'K: @PartialOrd, 'V> (
    root_addr#: Addr = ADDR0,
    len#: usize = 0
)

pub fn btree_node_get<'K: @PartialOrd, 'V: @Dup>(node_addr: Addr, 'key: K) -> Option<'V> {
    unsafe {
        auto current_addr# = node_addr
        loop true {
            if addr_is_null(current_addr) { return Option<'V>::None }
            auto *n# = current_addr as *BTreeNode<'K, 'V>
            auto i# = 0:usize
            loop i < n.len {
                auto k_ptr = n.keys[i]
                auto cmp_res = 'key.cmp(k_ptr)
                if cmp_res == 0 {
                    return Option<'V>::Some(n.vals[i].dup())
                }
                if cmp_res < 0 {
                    break
                }
                i += 1
            }
            if n.is_leaf {
                return Option<'V>::None
            }
            current_addr = n.children[i]
        }
        return Option<'V>::None
    }
}

pub fn btree_node_contains<'K: @PartialOrd, 'V>(node_addr: Addr, 'key: K) -> bool {
    unsafe {
        auto current_addr# = node_addr
        loop true {
            if addr_is_null(current_addr) { return false }
            auto *n# = current_addr as *BTreeNode<'K, 'V>
            auto i# = 0:usize
            loop i < n.len {
                auto cmp_res = 'key.cmp(n.keys[i])
                if cmp_res == 0 { return true }
                if cmp_res < 0 { break }
                i += 1
            }
            if n.is_leaf { return false }
            current_addr = n.children[i]
        }
        return false
    }
}

impl<'K: @PartialOrd, 'V> BTreeMap<'K, 'V> {
    pub fn new() -> BTreeMap<'K, 'V> {
        return BTreeMap<'K, 'V>(
            root_addr = BTreeNode<'K, 'V>::new(true),
            len = 0
        )
    }
}

impl<'K, 'V> BTreeMap<'K, 'V>@Encap {
    fn drop(self#) {
        unsafe {
            if addr_is_not_null(self.root_addr) {
                BTreeNode<'K, 'V>::destroy(self.root_addr)
                self.root_addr = ADDR0
                self.len = 0
            }
        }
    }
    



}

impl<'K: @PartialOrd, 'V> BTreeMap<'K, 'V> {
    pub fn is_empty(self) -> bool { return self.len == 0 }
    pub fn len(self) -> usize { return self.len }

    pub fn clear(self#) {
        unsafe {
            if addr_is_not_null(self.root_addr) {
                BTreeNode<'K, 'V>::destroy(self.root_addr)
                self.root_addr = BTreeNode<'K, 'V>::new(true)
                self.len = 0
            }
        }
    }
    pub fn insert(self#, cede 'key: K, cede 'val: V) {
        unsafe {
            auto key_buf# = [cede 'key]
            auto val_buf# = [cede 'val]
            auto old_root_addr = self.root_addr
            auto *r# = old_root_addr as *BTreeNode<'K, 'V>
            if r.len == 5 {
                auto s_addr = BTreeNode<'K, 'V>::new(false)
                auto *s# = s_addr as *BTreeNode<'K, 'V>
                self.root_addr = s_addr
                s.children[0] = old_root_addr
                s#.split_child(0)
                auto added = btree_node_insert_non_full_iterative<'K, 'V>(s_addr, cede key_buf[0], cede val_buf[0])
                if added { self.len += 1 }
            } else {
                auto added = btree_node_insert_non_full_iterative<'K, 'V>(old_root_addr, cede key_buf[0], cede val_buf[0])
                if added { self.len += 1 }
            }
        }
    }
    pub fn contains_key(self, 'key: K) -> bool {
        return btree_node_contains<'K, 'V>(self.root_addr, 'key)
    }
}

impl<'K: @PartialOrd, 'V: @Dup> BTreeMap<'K, 'V> {
    /// Duplicates the stored value. Move-only values intentionally have no
    /// by-value get surface; use a container-specific borrow or removal API.
    pub fn get(self, 'key: K) -> Option<'V> {
        return btree_node_get<'K, 'V>(self.root_addr, 'key)
    }
}
