import sys/sync::{
    sys_mutex_create, sys_mutex_lock, sys_mutex_unlock, sys_mutex_destroy,
    sys_rwlock_create, sys_rwlock_rdlock, sys_rwlock_wrlock, sys_rwlock_unlock, sys_rwlock_destroy,
    sys_cond_create, sys_cond_wait, sys_cond_signal, sys_cond_broadcast, sys_cond_destroy
}
import sys/thread::{sys_alloc_thread_env, sys_free_thread_env}
import core/result::{Result}
import core/option::{Option}
import std/error::{Error}

/// A mutual exclusion primitive useful for protecting shared data
pub shape Mutex<'T: @Send>(
    handle#: Addr,
    data_ptr#: Addr
)

impl<'T: @Send> Mutex<'T>@Sync {}
impl<'T: @Send> Mutex<'T>@Send {}

impl<'T: @Send> Mutex<'T> {
    pub fn get_handle(self) -> Addr {
        return self.handle
    }
    
    pub fn new(data: cede 'T) -> Mutex<'T> {
        unsafe {
            auto env = sys_alloc_thread_env(sizeof('T) as usize)
            auto *p# = (env as *['T])
            p[0] = cede data
            return Mutex<'T>(
                handle = sys_mutex_create(),
                data_ptr = env
            )
        }
    }
    
    /// Directly allocates and initializes a new Mutex as a shared pointer (~Mutex)
    pub fn make(data: cede 'T) -> ^Mutex<'T> {
        unsafe {
            auto env = sys_alloc_thread_env(sizeof('T) as usize)
            auto *p# = (env as *['T])
            p[0] = cede data
            return new Mutex<'T>(
                handle = sys_mutex_create(),
                data_ptr = env
            )
        }
    }

    pub fn make_shared(data: cede 'T) -> ~Mutex<'T> {
        unsafe {
            auto env = sys_alloc_thread_env(sizeof('T) as usize)
            auto *p# = (env as *['T])
            p[0] = cede data
            auto ~mutex = new Mutex<'T>(
                handle = sys_mutex_create(),
                data_ptr = env
            )
            return cede ~mutex
        }
    }
    
    pub fn lock(self) -> Result<MutexLock<'T>, Error> <- self {
        unsafe {
            auto rc = sys_mutex_lock(self.handle)
            if rc != 0 {
                auto msg# = string::from("mutex lock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<MutexLock<'T>, Error>::Err(Error::new(rc, msg))
            }
            
            auto temp_h = self.handle:Addr
            auto *p# = (self.data_ptr as *'T#)
            auto nul *tok = null:nul *byte
            
            return Result<MutexLock<'T>, Error>::Ok(MutexLock<'T>(
                handle = temp_h,
                &data = *p,
                *thread_token = *tok
            ))
        }
    }
    
    /// Unlocks the mutex implicitly yielding it to other waiting threads.
    pub fn unlock(self) -> Result<i32, Error> {
        unsafe {
            auto rc = sys_mutex_unlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("mutex unlock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<i32, Error>::Err(Error::new(rc, msg))
            }
            return Result<i32, Error>::Ok(rc)
        }
    }
}

impl<'T> Mutex<'T>@Encap {
    fn drop(self#) {
        unsafe {
            if self.data_ptr != 0:Addr {
                auto *p# = (self.data_ptr as *['T])
                {
                    auto _ = Option<'T>::Some(cede p[0])
                }
                sys_free_thread_env(self.data_ptr)
                self.data_ptr = 0:Addr
            }
            if self.handle != 0:Addr {
                sys_mutex_destroy(self.handle)
                self.handle = 0:Addr
            }
        }
    }
}

pub shape MutexLock<'T: @Send>(
    handle: Addr,
    &'data#: T,
    nul *thread_token: byte
)

impl<'T> MutexLock<'T>@Encap {
    fn drop(self#) {
        unsafe {
            if self.handle != 0:Addr {
                sys_mutex_unlock(self.handle)
                self.handle = 0:Addr
            }
        }
    }
}

impl<'T: @Send> MutexLock<'T> {
    pub fn get_ref(self) -> &'T# <- self {
        return &(self.data)
    }
}

/// A reader-writer lock
pub shape RwMutex<'T: @{Send, Sync}>(
    handle#: Addr,
    data_ptr#: Addr
)

impl<'T: @{Send, Sync}> RwMutex<'T>@Sync {}
impl<'T: @{Send, Sync}> RwMutex<'T>@Send {}

impl<'T: @{Send, Sync}> RwMutex<'T> {
    pub fn new(data: cede 'T) -> RwMutex<'T> {
        unsafe {
            auto env = sys_alloc_thread_env(sizeof('T) as usize)
            auto *p# = (env as *['T])
            p[0] = cede data
            return RwMutex<'T>(
                handle = sys_rwlock_create(),
                data_ptr = env
            )
        }
    }

    pub fn make_shared(data: cede 'T) -> ~RwMutex<'T> {
        unsafe {
            auto env = sys_alloc_thread_env(sizeof('T) as usize)
            auto *p# = (env as *['T])
            p[0] = cede data
            auto ~rwlock = new RwMutex<'T>(
                handle = sys_rwlock_create(),
                data_ptr = env
            )
            return cede ~rwlock
        }
    }
    
    pub fn read_lock(self) -> Result<RwReadLock<'T>, Error> <- self {
        unsafe {
            auto rc = sys_rwlock_rdlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("rwlock read_lock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<RwReadLock<'T>, Error>::Err(Error::new(rc, msg))
            }
            
            auto temp_h = self.handle:Addr
            auto *p = (self.data_ptr as *'T)
            auto nul *tok = null:nul *byte
            
            return Result<RwReadLock<'T>, Error>::Ok(RwReadLock<'T>(
                handle = temp_h,
                &data = *p,
                *thread_token = *tok
            ))
        }
    }
    
    pub fn write_lock(self) -> Result<RwWriteLock<'T>, Error> <- self {
        unsafe {
            auto rc = sys_rwlock_wrlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("rwlock write_lock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<RwWriteLock<'T>, Error>::Err(Error::new(rc, msg))
            }
            
            auto temp_h = self.handle:Addr
            auto *p# = (self.data_ptr as *'T#)
            auto nul *tok = null:nul *byte
            
            return Result<RwWriteLock<'T>, Error>::Ok(RwWriteLock<'T>(
                handle = temp_h,
                &data = *p,
                *thread_token = *tok
            ))
        }
    }
    
    pub fn unlock(self) -> Result<i32, Error> {
        unsafe {
            auto rc = sys_rwlock_unlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("rwlock unlock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<i32, Error>::Err(Error::new(rc, msg))
            }
            return Result<i32, Error>::Ok(rc)
        }
    }
}

impl<'T> RwMutex<'T>@Encap {
    fn drop(self#) {
        unsafe {
            if self.data_ptr != 0:Addr {
                auto *p# = (self.data_ptr as *['T])
                {
                    auto _ = Option<'T>::Some(cede p[0])
                }
                sys_free_thread_env(self.data_ptr)
                self.data_ptr = 0:Addr
            }
            if self.handle != 0:Addr {
                sys_rwlock_destroy(self.handle)
                self.handle = 0:Addr
            }
        }
    }
}

pub shape RwReadLock<'T: @{Send, Sync}>(
    handle: Addr,
    &'data: T,
    nul *thread_token: byte
)

impl<'T> RwReadLock<'T>@Encap {
    fn drop(self#) {
        unsafe {
            if self.handle != 0:Addr {
                sys_rwlock_unlock(self.handle)
                self.handle = 0:Addr
            }
        }
    }
}

impl<'T: @{Send, Sync}> RwReadLock<'T> {
    pub fn get_ref(self) -> &'T <- self {
        return &(self.data)
    }
}

pub shape RwWriteLock<'T: @{Send, Sync}>(
    handle: Addr,
    &'data#: T,
    nul *thread_token: byte
)

impl<'T> RwWriteLock<'T>@Encap {
    fn drop(self#) {
        unsafe {
            if self.handle != 0:Addr {
                sys_rwlock_unlock(self.handle)
                self.handle = 0:Addr
            }
        }
    }
}

impl<'T: @{Send, Sync}> RwWriteLock<'T> {
    pub fn get_ref(self) -> &'T# <- self {
        return &(self.data)
    }
}

/// A Condition Variable
pub shape CondVar<'T: @Send>(
    handle#: Addr
)

impl<'T: @Send> CondVar<'T>@Sync {}
impl<'T: @Send> CondVar<'T>@Send {}

impl<'T: @Send> CondVar<'T> {
    pub fn new() -> CondVar<'T> {
        return CondVar<'T>(
            handle = sys_cond_create()
        )
    }

    pub fn make() -> ^CondVar<'T> {
        return new CondVar<'T>(
            handle = sys_cond_create()
        )
    }

    pub fn wait_cond(self, lock: MutexLock<'T>) {
        unsafe {
            sys_cond_wait(self.handle, lock.handle)
        }
    }

    pub fn notify_one(self) {
        unsafe {
            sys_cond_signal(self.handle)
        }
    }

    pub fn notify_all(self) {
        unsafe {
            sys_cond_broadcast(self.handle)
        }
    }
}

impl<'T> CondVar<'T>@Encap {
    fn drop(self#) {
        unsafe {
            auto h = self.handle:Addr
            if h != 0:Addr {
                sys_cond_destroy(h)
                self.handle = 0:Addr
            }
        }
    }
}

/// A synchronization primitive that can be used to run a function exactly once.
pub shape Once(
    mutex#: Mutex<bool>,
    done#: bool
)

impl Once@Sync {}
impl Once@Send {}

impl Once {
    pub fn new() -> Once {
        return Once(
            mutex = Mutex<bool>::new(false),
            done = false
        )
    }

    pub fn make() -> ^Once {
        return new Once(
            mutex = Mutex<bool>::new(false),
            done = false
        )
    }

    pub fn call(self#, f#: fn#()) {
        auto lock = self.mutex#.lock().unwrap()
        if self.done {
            return
        }
        
        f#()
        self.done = true
    }
}

/// A WaitGroup waits for a collection of threads or tasks to finish.
pub shape WaitGroup(
    mutex#: Mutex<i32>,
    cond: CondVar<i32>
)

impl WaitGroup@Sync {}
impl WaitGroup@Send {}

impl WaitGroup {
    pub fn new() -> WaitGroup {
        return WaitGroup(
            mutex = Mutex<i32>::new(0),
            cond = CondVar<i32>::new()
        )
    }

    pub fn make() -> ^WaitGroup {
        return new WaitGroup(
            mutex = Mutex<i32>::new(0),
            cond = CondVar<i32>::new()
        )
    }

    pub fn add(self#, delta: i32) {
        auto lock = self.mutex#.lock().unwrap()
        auto &val# = lock.get_ref()
        val = val + delta
        if val <= 0 {
            self.cond.notify_all()
        }
    }

    pub fn done(self#) {
        self#.add(-1)
    }

    pub fn wait_all(self#) {
        auto lock = self.mutex#.lock().unwrap()
        auto &val = lock.get_ref()
        loop {
            if val <= 0 {
                break
            }
            self.cond.wait_cond(lock)
        }
    }
}
