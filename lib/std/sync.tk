import sys/sync::{
    sys_mutex_create, sys_mutex_lock, sys_mutex_unlock, sys_mutex_destroy,
    sys_rwlock_create, sys_rwlock_rdlock, sys_rwlock_wrlock, sys_rwlock_unlock, sys_rwlock_destroy,
    sys_cond_create, sys_cond_wait, sys_cond_signal, sys_cond_broadcast, sys_cond_destroy
}
import sys/thread::{sys_alloc_thread_env, sys_free_thread_env}
import core/result::{Result}
import core/option::{Option}
import std/error::{Error}
import sys/libc::{libc_abort}
import sys/libc::{
    libc_malloc, libc_free,
    libc_pthread_mutex_init, libc_pthread_mutex_destroy, libc_pthread_mutex_lock, libc_pthread_mutex_unlock,
    libc_pthread_rwlock_init, libc_pthread_rwlock_destroy, libc_pthread_rwlock_rdlock, libc_pthread_rwlock_wrlock, libc_pthread_rwlock_unlock,
    libc_pthread_cond_init, libc_pthread_cond_destroy, libc_pthread_cond_wait, libc_pthread_cond_signal, libc_pthread_cond_broadcast
}
extern fn libc__Exit(status: i32) -> void

// Private implementation of the accepted storage contract. Public wrappers
// remain on their existing path until exact witness publication is connected.
fn __sync_fatal() -> never {
    unsafe { libc__Exit(134) }
    unreachable
}

// The exact value returns into the caller's full-expression cleanup. This
// avoids a cloning aggregate wrapper and preserves the complete T morphology.
fn __sync_dispose_input<'T>(cede 'data: T) -> 'T {
    return cede 'data
}

// The reserves are checked against the native headers in
// toka_native_sync_layout.h; they are not inferred from a Toka shape name.
fn __sync_native_create(kind: i32) -> Addr {
    if kind < 0 || kind > 2 { __sync_fatal() }
    unsafe {
        auto bytes# = 64:usize
        if kind == 1 { bytes = 256:usize }
        auto handle = libc_malloc(bytes) as Addr
        if handle == 0:Addr { return 0:Addr }
        auto status# = 0:i32
        if kind == 0 { status = libc_pthread_mutex_init(handle, 0:Addr) }
        else if kind == 1 { status = libc_pthread_rwlock_init(handle, 0:Addr) }
        else { status = libc_pthread_cond_init(handle, 0:Addr) }
        if status != 0 {
            // Failed init never licenses native destroy.
            libc_free(handle as *void)
            return 0:Addr
        }
        return handle
    }
}

fn __sync_native_drop(handle: Addr, kind: i32) {
    if kind < 0 || kind > 2 { __sync_fatal() }
    if handle == 0:Addr { return }
    unsafe {
        auto status# = 0:i32
        if kind == 0 { status = libc_pthread_mutex_destroy(handle) }
        else if kind == 1 { status = libc_pthread_rwlock_destroy(handle) }
        else { status = libc_pthread_cond_destroy(handle) }
        if status != 0 { __sync_fatal() }
        // A failed destroy must not be followed by freeing the native object.
        libc_free(handle as *void)
    }
}

fn __sync_mutex_create<'T: @Send>(cede 'data: T) -> Mutex<'T> {
    auto storage = sys_alloc_thread_env(sizeof('T) as usize)
    if storage == 0:Addr {
        __sync_dispose_input<'T>(cede 'data)
        __sync_fatal()
    }
    auto native = __sync_native_create(0)
    if native == 0:Addr {
        __sync_dispose_input<'T>(cede 'data)
        sys_free_thread_env(storage)
        __sync_fatal()
    }
    unsafe {
        auto *slot# = sync_writable_storage<['T]>(storage)
        slot[0] = cede 'data
    }
    return Mutex<'T>(handle = native, data_ptr = storage)
}

fn __sync_rw_create<'T: @{Send, Sync}>(cede 'data: T) -> RwMutex<'T> {
    auto storage = sys_alloc_thread_env(sizeof('T) as usize)
    if storage == 0:Addr {
        __sync_dispose_input<'T>(cede 'data)
        __sync_fatal()
    }
    auto native = __sync_native_create(1)
    if native == 0:Addr {
        __sync_dispose_input<'T>(cede 'data)
        sys_free_thread_env(storage)
        __sync_fatal()
    }
    unsafe {
        auto *slot# = sync_writable_storage<['T]>(storage)
        slot[0] = cede 'data
    }
    return RwMutex<'T>(handle = native, data_ptr = storage)
}

fn __sync_mutex_drop<'T: @Send>(owner#: Mutex<'T>) {
    if owner.data_ptr != 0:Addr {
        unsafe {
            auto *slot# = sync_writable_storage<['T]>(owner.data_ptr)
            free[1] *slot
        }
        owner.data_ptr = 0:Addr
    }
    __sync_native_drop(owner.handle, 0)
    owner.handle = 0:Addr
}

fn __sync_rw_drop<'T: @{Send, Sync}>(owner#: RwMutex<'T>) {
    if owner.data_ptr != 0:Addr {
        unsafe {
            auto *slot# = sync_writable_storage<['T]>(owner.data_ptr)
            free[1] *slot
        }
        owner.data_ptr = 0:Addr
    }
    __sync_native_drop(owner.handle, 1)
    owner.handle = 0:Addr
}

fn __sync_mutex_acquire<'T: @Send>(owner: Mutex<'T>) -> Result<MutexLock<'T>, Error> <- owner {
    auto status = unsafe libc_pthread_mutex_lock(owner.handle)
    if status != 0 {
        return Result<MutexLock<'T>, Error>::Err(Error::new(status, string::from("mutex lock failed")))
    }
    unsafe {
        auto *slot# = sync_writable_storage<['T]>(owner.data_ptr)
        auto nul *token = null:nul *byte
        return Result<MutexLock<'T>, Error>::Ok(MutexLock<'T>(
            handle = owner.handle, &data = &'(slot[0]), *thread_token = *token))
    }
}

fn __sync_rw_read<'T: @{Send, Sync}>(owner: RwMutex<'T>) -> Result<RwReadLock<'T>, Error> <- owner {
    auto status = unsafe libc_pthread_rwlock_rdlock(owner.handle)
    if status != 0 {
        return Result<RwReadLock<'T>, Error>::Err(Error::new(status, string::from("rwlock read failed")))
    }
    unsafe {
        auto *slot = owner.data_ptr as *['T]
        auto nul *token = null:nul *byte
        return Result<RwReadLock<'T>, Error>::Ok(RwReadLock<'T>(
            handle = owner.handle, &data = &'(slot[0]), *thread_token = *token))
    }
}

fn __sync_rw_write<'T: @{Send, Sync}>(owner: RwMutex<'T>) -> Result<RwWriteLock<'T>, Error> <- owner {
    auto status = unsafe libc_pthread_rwlock_wrlock(owner.handle)
    if status != 0 {
        return Result<RwWriteLock<'T>, Error>::Err(Error::new(status, string::from("rwlock write failed")))
    }
    unsafe {
        auto *slot# = sync_writable_storage<['T]>(owner.data_ptr)
        auto nul *token = null:nul *byte
        return Result<RwWriteLock<'T>, Error>::Ok(RwWriteLock<'T>(
            handle = owner.handle, &data = &'(slot[0]), *thread_token = *token))
    }
}

fn __sync_mutex_release<'T: @Send>(held#: MutexLock<'T>) {
    if held.handle != 0:Addr {
        auto status = unsafe libc_pthread_mutex_unlock(held.handle)
        if status != 0 { __sync_fatal() }
        held.handle = 0:Addr
    }
}
fn __sync_rw_read_release<'T: @{Send, Sync}>(held#: RwReadLock<'T>) {
    if held.handle != 0:Addr {
        auto status = unsafe libc_pthread_rwlock_unlock(held.handle)
        if status != 0 { __sync_fatal() }
        held.handle = 0:Addr
    }
}
fn __sync_rw_write_release<'T: @{Send, Sync}>(held#: RwWriteLock<'T>) {
    if held.handle != 0:Addr {
        auto status = unsafe libc_pthread_rwlock_unlock(held.handle)
        if status != 0 { __sync_fatal() }
        held.handle = 0:Addr
    }
}
fn __sync_cond_create<'T: @Send>() -> CondVar<'T> {
    auto native = __sync_native_create(2)
    if native == 0:Addr { __sync_fatal() }
    return CondVar<'T>(handle = native)
}
fn __sync_cond_drop<'T: @Send>(owner#: CondVar<'T>) {
    __sync_native_drop(owner.handle, 2)
    owner.handle = 0:Addr
}
fn __sync_cond_wait<'T: @Send>(owner: CondVar<'T>, held: MutexLock<'T>) {
    auto status = unsafe libc_pthread_cond_wait(owner.handle, held.handle)
    if status != 0 { __sync_fatal() }
}
fn __sync_cond_signal<'T: @Send>(owner: CondVar<'T>) {
    auto status = unsafe libc_pthread_cond_signal(owner.handle)
    if status != 0 { __sync_fatal() }
}
fn __sync_cond_broadcast<'T: @Send>(owner: CondVar<'T>) {
    auto status = unsafe libc_pthread_cond_broadcast(owner.handle)
    if status != 0 { __sync_fatal() }
}

fn sync_writable_storage<'T>(address: Addr) -> *'T# {
    auto nul *candidate# = unsafe (address as nul *'T)
    if *candidate is null {
        unsafe { libc_abort() }
        unreachable
    } else {
        auto verified = unsafe *candidate as Addr
        auto *result# = unsafe (verified as *'T)
        return *result
    }
}

/// A mutual exclusion primitive useful for protecting shared data
pub shape Mutex<'T: @Send>(
    handle#: Addr,
    data_ptr#: Addr
)

impl<'T: @Send> Mutex<'T>@Sync {}
impl<'T: @Send> Mutex<'T>@Send {}

impl<'T: @Send> Mutex<'T> {
    pub fn get_handle(self) -> Addr {
        return self.handle
    }
    
    pub fn new(cede 'data: T) -> Mutex<'T> {
        return __sync_mutex_create<'T>(cede 'data)
    }
    
    /// Directly allocates and initializes a new Mutex as a shared pointer (~Mutex)
    pub fn make(cede 'data: T) -> ^Mutex<'T> {
        auto prepared = __sync_mutex_create<'T>(cede 'data)
        auto ^mutex# = new Mutex<'T>(handle = 0:Addr, data_ptr = 0:Addr)
        mutex = cede prepared
        return ^mutex
    }

    pub fn make_shared(cede 'data: T) -> ~Mutex<'T> {
        auto prepared = __sync_mutex_create<'T>(cede 'data)
        auto ~mutex# = new Mutex<'T>(handle = 0:Addr, data_ptr = 0:Addr)
        mutex = cede prepared
        return cede ~mutex
    }
    
    pub fn lock(self) -> Result<MutexLock<'T>, Error> <- self {
        return __sync_mutex_acquire<'T>(self)
    }
    
    /// Unlocks the mutex implicitly yielding it to other waiting threads.
    pub fn unlock(self) -> Result<i32, Error> {
        unsafe {
            auto rc = sys_mutex_unlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("mutex unlock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<i32, Error>::Err(Error::new(rc, msg))
            }
            return Result<i32, Error>::Ok(rc)
        }
    }
}

impl<'T> Mutex<'T>@Encap {
    fn drop(self#) {
        __sync_mutex_drop<'T>(self#)
    }
}

pub shape MutexLock<'T: @Send>(
    handle: Addr,
    &'data#: T,
    nul *thread_token: byte
)

impl<'T> MutexLock<'T>@Encap {
    fn drop(self#) {
        __sync_mutex_release<'T>(self#)
    }
}

impl<'T: @Send> MutexLock<'T> {
    pub fn borrow_mut(self) -> &'T#
    effects:
        return <- self
    {
        return self.&data
    }

}

/// A reader-writer lock
pub shape RwMutex<'T: @{Send, Sync}>(
    handle#: Addr,
    data_ptr#: Addr
)

impl<'T: @{Send, Sync}> RwMutex<'T>@Sync {}
impl<'T: @{Send, Sync}> RwMutex<'T>@Send {}

impl<'T: @{Send, Sync}> RwMutex<'T> {
    pub fn new(cede 'data: T) -> RwMutex<'T> {
        return __sync_rw_create<'T>(cede 'data)
    }

    pub fn make_shared(cede 'data: T) -> ~RwMutex<'T> {
        auto prepared = __sync_rw_create<'T>(cede 'data)
        auto ~rwlock# = new RwMutex<'T>(handle = 0:Addr, data_ptr = 0:Addr)
        rwlock = cede prepared
        return cede ~rwlock
    }
    
    pub fn read_lock(self) -> Result<RwReadLock<'T>, Error> <- self {
        return __sync_rw_read<'T>(self)
    }
    
    pub fn write_lock(self) -> Result<RwWriteLock<'T>, Error> <- self {
        return __sync_rw_write<'T>(self)
    }
    
    pub fn unlock(self) -> Result<i32, Error> {
        unsafe {
            auto rc = sys_rwlock_unlock(self.handle)
            if rc != 0 {
                auto msg# = string::from("rwlock unlock failed with error code: ")
                auto rc_str = string::from_int(rc)
                msg#.push_str(rc_str.as_str())
                
                return Result<i32, Error>::Err(Error::new(rc, msg))
            }
            return Result<i32, Error>::Ok(rc)
        }
    }
}

impl<'T> RwMutex<'T>@Encap {
    fn drop(self#) {
        __sync_rw_drop<'T>(self#)
    }
}

pub shape RwReadLock<'T: @{Send, Sync}>(
    handle: Addr,
    &'data: T,
    nul *thread_token: byte
)

impl<'T> RwReadLock<'T>@Encap {
    fn drop(self#) {
        __sync_rw_read_release<'T>(self#)
    }
}

impl<'T: @{Send, Sync}> RwReadLock<'T> {
    pub fn borrow(self) -> &'T
    effects:
        return <- self
    {
        return self.&data
    }

}

pub shape RwWriteLock<'T: @{Send, Sync}>(
    handle: Addr,
    &'data#: T,
    nul *thread_token: byte
)

impl<'T> RwWriteLock<'T>@Encap {
    fn drop(self#) {
        __sync_rw_write_release<'T>(self#)
    }
}

impl<'T: @{Send, Sync}> RwWriteLock<'T> {
    pub fn borrow_mut(self) -> &'T#
    effects:
        return <- self
    {
        return self.&data
    }

}

/// A Condition Variable
pub shape CondVar<'T: @Send>(
    handle#: Addr
)

impl<'T: @Send> CondVar<'T>@Sync {}
impl<'T: @Send> CondVar<'T>@Send {}

impl<'T: @Send> CondVar<'T> {
    pub fn new() -> CondVar<'T> {
        return __sync_cond_create<'T>()
    }

    pub fn make() -> ^CondVar<'T> {
        auto prepared = __sync_cond_create<'T>()
        auto ^condition# = new CondVar<'T>(handle = 0:Addr)
        condition = cede prepared
        return ^condition
    }

    /// Construct a shared condition owner without a unique-to-shared conversion.
    pub fn make_shared() -> ~CondVar<'T> {
        auto prepared = __sync_cond_create<'T>()
        auto ~condition# = new CondVar<'T>(handle = 0:Addr)
        condition = cede prepared
        return cede ~condition
    }

    pub fn wait_cond(self, lock: MutexLock<'T>) {
        __sync_cond_wait<'T>(self, lock)
    }

    pub fn notify_one(self) {
        __sync_cond_signal<'T>(self)
    }

    pub fn notify_all(self) {
        __sync_cond_broadcast<'T>(self)
    }
}

impl<'T> CondVar<'T>@Encap {
    fn drop(self#) {
        __sync_cond_drop<'T>(self#)
    }
}

/// A synchronization primitive that can be used to run a function exactly once.
pub shape Once(
    mutex#: Mutex<bool>,
    done#: bool
)

impl Once@Sync {}
impl Once@Send {}

impl Once {
    pub fn new() -> Once {
        return Once(
            mutex = Mutex<bool>::new(false),
            done = false
        )
    }

    pub fn make() -> ^Once {
        auto prepared = Once::new()
        auto ^owner# = new Once(mutex = Mutex<bool>(handle = 0:Addr, data_ptr = 0:Addr), done = false)
        owner = cede prepared
        return ^owner
    }

    pub fn make_shared() -> ~Once# {
        auto prepared = Once::new()
        auto ~owner# = new Once(mutex = Mutex<bool>(handle = 0:Addr, data_ptr = 0:Addr), done = false)
        owner = cede prepared
        return cede ~owner
    }

    pub fn call(self#, f#: fn#()) {
        __sync_once_call(self#, f#)
    }
}

/// A WaitGroup waits for a collection of threads or tasks to finish.
pub shape WaitGroup(
    mutex#: Mutex<i32>,
    cond: CondVar<i32>
)

impl WaitGroup@Sync {}
impl WaitGroup@Send {}

impl WaitGroup {
    pub fn new() -> WaitGroup {
        return WaitGroup(
            mutex = Mutex<i32>::new(0),
            cond = CondVar<i32>::new()
        )
    }

    pub fn make() -> ^WaitGroup {
        auto prepared = WaitGroup::new()
        auto ^owner# = new WaitGroup(mutex = Mutex<i32>(handle = 0:Addr, data_ptr = 0:Addr),
                                    cond = CondVar<i32>(handle = 0:Addr))
        owner = cede prepared
        return ^owner
    }

    pub fn make_shared() -> ~WaitGroup# {
        auto prepared = WaitGroup::new()
        auto ~owner# = new WaitGroup(mutex = Mutex<i32>(handle = 0:Addr, data_ptr = 0:Addr),
                                    cond = CondVar<i32>(handle = 0:Addr))
        owner = cede prepared
        return cede ~owner
    }

    pub fn add(self#, delta: i32) {
        __sync_waitgroup_add(self#, delta)
    }

    pub fn done(self#) {
        __sync_waitgroup_done(self#)
    }

    pub fn wait_all(self#) {
        __sync_waitgroup_wait(self#)
    }
}

// Private composition operations. Their declaration identity, complete owner
// field types and checked forwarding sites participate in the native witness;
// a similarly named user method does not acquire this contract.
fn __sync_once_call(owner#: Once, f#: fn#()) {
    auto lock = owner.mutex#.lock().unwrap()
    if owner.done { return }
    f#()
    owner.done = true
}

fn __sync_waitgroup_add(owner#: WaitGroup, delta: i32) {
    auto lock = owner.mutex#.lock().unwrap()
    auto &val# = lock.borrow_mut()
    val = val + delta
    if val <= 0 { owner.cond.notify_all() }
}

fn __sync_waitgroup_done(owner#: WaitGroup) {
    __sync_waitgroup_add(owner#, -1)
}

fn __sync_waitgroup_wait(owner#: WaitGroup) {
    auto lock = owner.mutex#.lock().unwrap()
    loop {
        {
            auto &val = lock.borrow_mut()
            if val <= 0 { break }
        }
        owner.cond.wait_cond(lock)
    }
}
