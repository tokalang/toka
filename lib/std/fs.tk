import sys/os/fs as sys
import sys/libc::{toka_dir_sync, toka_atomic_write_durable}

import std/io::{File, IoStringResult, println}
import std/env as env
import std/error::{IoError}
import core/result::{Result}
import core/option::{Option}
import core/traits::{@Iterator}
import core/str::{bytes}

/**
 * Directory Iterator
 */
pub shape ReadDir (
    handle: Addr,
    finished#: bool
)
impl ReadDir@Encap {
    pub handle
    pub finished
    
    fn drop(self#) {
        if !self.finished {
            sys::closedir_impl(self.handle)
            self.finished = true
        }
    }
    
}

impl ReadDir@Iterator {
    type Item = string

    pub fn next(self#) -> Option<Item> {
        return self#.next()
    }
}

impl ReadDir {
    /**
     * Returns the next directory entry name.
     */
    pub fn next(self#) -> Option<string> {
        loop !self.finished {
            auto name_opt = sys::readdir_impl(self.handle)
            match cede name_opt {
                auto Option<string>::Some('name) => {
                    if 'name.as_str() != "." && 'name.as_str() != ".." {
                        return Option<string>::Some(cede 'name)
                    }
                }
                Option<string>::None => {
                    self.finished = true
                    sys::closedir_impl(self.handle)
                    return Option<string>::None
                }
            }
        }
        return Option<string>::None
    }

    pub fn close(self#) {
        if !self.finished {
            sys::closedir_impl(self.handle)
            self.finished = true
        }
    }
}

/**
 * Returns an iterator over the entries in a directory.
 */
pub fn read_dir(path: string) -> ReadDir {
    auto h = sys::opendir_impl(path.c_str() as Addr)
    if h == ADDR0 {
        return ReadDir(handle = h, finished = true)
    }
    return ReadDir(
        handle = h,
        finished = false
    )
}

/**

 * Creates a new, empty directory at the provided path.
 */
pub fn create_dir(path: string) -> bool {
    return sys::mkdir_impl(path.c_str() as Addr)
}

/**
 * Removes an empty directory.
 */
pub fn remove_dir(path: string) -> bool {
    return sys::rmdir_impl(path.c_str() as Addr)
}

/**
 * Returns true if the path exists on disk and is a file or directory.
 */
pub fn exists(path: string) -> bool {
    return sys::path_exists(path.c_str() as Addr)
}

pub shape Metadata(
    len: u64,
    mode: u32,
    modified: i64
)

impl Metadata {
     pub fn is_dir(self) -> bool {
         return sys::stat_is_dir_impl(self.mode)
     }
     
     pub fn is_file(self) -> bool {
         return sys::stat_is_file_impl(self.mode)
     }
     
     pub fn len(self) -> u64 {
         return self.len
     }
     
     pub fn modified(self) -> i64 {
         return self.modified
     }
}

pub fn metadata(path: string) -> Result<Metadata, string> {
    auto handle = sys::stat_impl(path.c_str() as Addr)
    if handle == ADDR0 {
        return Result<Metadata, string>::Err(string::from("Path not found"))
    }
    
    auto m = Metadata(
        len = sys::stat_get_size_impl(handle),
        mode = sys::stat_get_mode_impl(handle),
        modified = sys::stat_get_mtime_impl(handle)
    )
    
    sys::stat_free_impl(handle)
    return Result<Metadata, string>::Ok(m)
}

/**
 * Read the entire contents of a file into a string.
 */
pub fn read_to_string(path: string) -> IoStringResult {
    auto f# = File::open(path, "r")
    if !f.is_valid() {
        return IoStringResult::Err(string::from("Failed to open file for reading"))
    }
    
    auto s_res = f#.read_to_string()
    f#.close()
    
    return s_res
}

/**
 * Write a slice as the entire contents of a file.
 */
pub fn write_string(path: string, content: str) -> Result<bool, string> {
    auto f# = File::open(path, "w")
    if !f.is_valid() {
        return Result<bool, string>::Err(string::from("Failed to open file for writing"))
    }
    
    auto write_len = f#.write(content)
    f#.close()
    
    if write_len != content.len() {
        return Result<bool, string>::Err(string::from("Failed to write all content to file"))
    }
    
    return Result<bool, string>::Ok(true)
}

/**
 * Replace a file's contents without exposing a partially-written target to
 * concurrent readers. The implementation writes a uniquely-created sibling
 * temporary file, then atomically replaces the target on supported platforms.
 *
 * This is an atomic-visibility operation, not a crash-durability guarantee.
 */
pub fn write_string_atomic(path: string, content: str) -> Result<bool, string> {
    auto owned_content = string::from(content)
    if !sys::atomic_write_string_impl(path, owned_content) {
        return Result<bool, string>::Err(string::from("Atomic file replacement is unavailable or failed"))
    }
    return Result<bool, string>::Ok(true)
}

/**
 * An exclusively-created temporary file. Its path remains available after
 * `close()` so another process can read it; dropping the resource closes and
 * removes the file if the caller has not already done so.
 */
pub shape TempFile(
    handle: Addr,
    location: string,
    opened#: bool,
    removed#: bool
)

impl TempFile@Encap {
    fn drop(self#) {
        if self.handle != ADDR0 {
            sys::temp_file_destroy_impl(self.handle)
            self.handle = ADDR0
            self.opened = false
            self.removed = true
        }
    }
}

impl TempFile {
    /** Returns an owned copy of the path created by the secure primitive. */
    pub fn path(self) -> string {
        return string::from(self.location.as_str())
    }

    /** Writes bytes through the open temporary-file handle. */
    pub fn write(self#, content: str) -> Result<usize, IoError> {
        if !self.opened || self.handle == ADDR0 {
            return Result<usize, IoError>::Err(
                IoError::new("temp_file_write", 0:i32, "temporary file is closed")
            )
        }
        auto written = sys::temp_file_write_impl(self.handle, content)
        if written < 0:i64 {
            return Result<usize, IoError>::Err(
                IoError::new("temp_file_write", 0:i32, "failed to write temporary file")
            )
        }
        return Result<usize, IoError>::Ok(written as usize)
    }

    /** Flushes and closes the writable handle while retaining the path. */
    pub fn close(self#) -> Result<bool, IoError> {
        if !self.opened {
            return Result<bool, IoError>::Ok(true)
        }
        auto status = sys::temp_file_close_impl(self.handle)
        self.opened = false
        if status != 0:i32 {
            return Result<bool, IoError>::Err(
                IoError::new("temp_file_close", 0:i32, "failed to close temporary file")
            )
        }
        return Result<bool, IoError>::Ok(true)
    }

    /** Closes, removes, and retains no filesystem entry for this resource. */
    pub fn remove(self#) -> Result<bool, IoError> {
        if self.removed {
            return Result<bool, IoError>::Ok(true)
        }
        if self.opened {
            auto closed = self#.close()
            match cede closed {
                auto Result<bool, IoError>::Err('error) => {
                    return Result<bool, IoError>::Err(cede 'error)
                }
                _ => {}
            }
        }
        if sys::temp_file_remove_impl(self.handle) != 0:i32 {
            return Result<bool, IoError>::Err(
                IoError::new("temp_file_remove", 0:i32, "failed to remove temporary file")
            )
        }
        self.removed = true
        return Result<bool, IoError>::Ok(true)
    }
}

/**
 * Securely creates an empty 0600 temporary file in `directory` using atomic
 * exclusive creation on Linux and macOS. Unsupported hosts return `Err`.
 * The returned resource owns cleanup.
 */
pub fn create_temp_file(directory: string) -> Result<TempFile, IoError> {
    auto handle = sys::temp_file_create_impl(directory)
    if handle == ADDR0 {
        return Result<TempFile, IoError>::Err(
            IoError::new("temp_file_create", 0:i32, "secure temporary-file creation is unavailable or failed")
        )
    }
    auto path_result = sys::temp_file_path_impl(handle)
    match cede path_result {
        auto Option<string>::Some('path) => {
            return Result<TempFile, IoError>::Ok(TempFile(
                handle = handle,
                location = cede 'path,
                opened = true,
                removed = false
            ))
        }
        _ => {
            sys::temp_file_destroy_impl(handle)
            return Result<TempFile, IoError>::Err(
                IoError::new("temp_file_create", 0:i32, "temporary file has no path")
            )
        }
    }
}

/**
 * Creates a secure Linux/macOS temporary file under TMPDIR, or /tmp when it
 * is unset. Unsupported hosts return `Err`.
 */
pub fn create_temp_file_system() -> Result<TempFile, IoError> {
    auto configured = env::var(string::from("TMPDIR"))
    match cede configured {
        auto Option<string>::Some('directory) => {
            if 'directory.len() > 0:usize {
                return create_temp_file('directory)
            }
        }
        _ => {}
    }
    return create_temp_file(string::from("/tmp"))
}

/**
 * Forces filesystem directory metadata to persistent storage.
 * On POSIX systems, opens the directory and performs fsync.
 * Unsupported platforms (e.g. Windows/WASI) return an unsupported IoError.
 */
pub fn sync_directory(dir_path: string) -> Result<(), IoError> {
    auto *dir_ptr# = dir_path.c_str()
    auto os_err# = 0:i32
    auto res = unsafe toka_dir_sync(*dir_ptr, &os_err as *i32)
    if res != 0:i32 {
        return Result<(), IoError>::Err(
            IoError::new("sync_directory", os_err, "failed to sync directory metadata")
        )
    }
    return Result<(), IoError>::Ok(())
}

/**
 * Performs a crash-durable atomic file replacement:
 * 1. Writes data to a sibling unique temporary file;
 * 2. Syncs temporary file data and metadata (fsync);
 * 3. Closes temporary file;
 * 4. Atomically renames temporary file over target path;
 * 5. Syncs containing parent directory metadata (fsync).
 */
pub fn atomic_write_durable(path: string, content: bytes) -> Result<(), IoError> {
    auto path_cstr# = path.clone()
    auto *path_ptr# = path_cstr.c_str()
    auto *data_ptr# = content.raw_ptr() as *u8
    auto os_err# = 0:i32
    auto res = unsafe toka_atomic_write_durable(*path_ptr, *data_ptr, content.size(), &os_err as *i32)
    if res != 0:i32 {
        return Result<(), IoError>::Err(
            IoError::new("atomic_write_durable", os_err, "failed to atomically and durably write file")
        )
    }
    return Result<(), IoError>::Ok(())
}
