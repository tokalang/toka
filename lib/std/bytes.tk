import core/types::{usize, Addr, byte}
import core/result::{Result}
import core/option::{Option}
import core/str::{bytes}
import core/memory::{copy_memory}
import std/vec::{Vec}

// Borrow a fixed byte array as a `bytes` view without allocating or copying.
// The returned view is tied to `data` and must not outlive it.
//
// `Vec<u8>` is the mutable owner used by incremental I/O. `Bytes` is the
// immutable, transferable owner used to publish or retain completed byte
// sequences without a second copy. `bytes` is the borrowed read-only view.
pub fn bytes_from_array<N_: usize>(data: [u8; N_]) -> res: bytes
effects:
    res.&buf <- data
{
    unsafe {
        if sizeof([u8; N_]) == 0:usize {
            return bytes(&buf = null as *[byte] as &[byte], len = 0)
        }
        auto base_addr = &data[0] as Addr
        auto ret = bytes(&buf = null as *[byte] as &[byte], len = sizeof([u8; N_]))
        copy_memory(&ret as Addr, &base_addr as Addr, 8)
        return ret
    }
}

pub shape Bytes (
    nul *#buf#: [u8] = null as *[u8],
    len#: usize = 0,
    cap#: usize = 0
)

impl Bytes@encap {
    fn drop(self#) {
        unsafe {
            if self.*buf != null {
                unsafe free [self.len]self.*#buf
                self.*buf = null as *[u8]
            }
        }
    }

    pub fn clone(self) -> Bytes {
        unsafe {
            if self.cap == 0 || self.len == 0 {
                return Bytes(*buf = null as *[u8], len = 0, cap = 0)
            }
            auto *new_buf# = unsafe alloc [self.cap] u8 as *[u8]
            auto i# = 0:usize
            loop i < self.len {
                new_buf[i] = self.buf[i]
                i += 1
            }
            return Bytes(*buf = *new_buf, len = self.len, cap = self.cap)
        }
    }
}

impl Bytes {
    pub fn new() -> Bytes {
        return Bytes(*buf = null as *[u8], len = 0, cap = 0)
    }

    pub fn with_capacity(cap: usize) -> Bytes {
        if cap == 0 {
            return Bytes::new()
        }
        unsafe {
            auto *p# = unsafe alloc [cap] u8 as *[u8]
            return Bytes(*buf = *p, len = 0, cap = cap)
        }
    }

    // Freeze a mutable byte buffer without copying it. The caller transfers
    // the Vec allocation and must use `into_vec` to make it mutable again.
    pub fn from_vec(cede v: Vec<u8>) -> Bytes {
        unsafe {
            auto owned# = cede v
            auto l = owned.len()
            auto c = owned.cap()
            auto *p# = owned#.unsafe_into_raw()
            return Bytes(*buf = *p, len = l, cap = c)
        }
    }

    // Thaw this owner without copying it. `self` is disarmed before return so
    // its drop implementation cannot free the transferred allocation.
    pub fn into_vec(self#) -> Vec<u8> {
        unsafe {
            auto l = self.len
            auto c = self.cap
            auto *p# = self.*buf
            self.len = 0
            self.cap = 0
            self.*buf = null as *[u8]
            return Vec<u8>(*buf = *p, len = l, cap = c)
        }
    }

    // This is only for a std-level adapter that has initialized the backing
    // storage through an FFI call. Normal code should construct Bytes from a
    // Vec and expose it through `as_slice` instead.
    pub fn unsafe_set_len(self#, new_len: usize) {
        if new_len <= self.cap {
            self.len = new_len
        }
    }

    pub fn len(self) -> usize {
        return self.len
    }

    pub fn capacity(self) -> usize {
        return self.cap
    }

    pub fn is_empty(self) -> bool {
        return self.len == 0
    }

    // Raw access is intentionally explicit: ordinary users should pass a
    // Bytes value or its borrowed `bytes` view, not retain this pointer.
    pub fn unsafe_raw_ptr(self) -> *u8 {
        unsafe {
            if self.len == 0 || self.*buf == null {
                return null as *u8
            }
            return self.*buf as *u8
        }
    }

    pub fn as_slice(self) -> bytes <- self {
        unsafe {
            if self.len == 0 || self.*buf == null {
                return bytes(&buf = null as *[byte] as &[byte], len = 0)
            }
            auto base_addr = self.*buf as Addr
            auto ret = bytes(&buf = null as *[byte] as &[byte], len = self.len)
            copy_memory(&ret as Addr, &base_addr as Addr, 8)
            return ret
        }
    }
}
