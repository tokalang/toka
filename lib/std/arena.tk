// lib/std/arena.tk
// A high-performance, elegant Arena Allocator for batch-allocated system resources.

import core/types::{usize, Addr, ADDR0}
import core/traits::{@Encap}
import sys/libc::{libc_malloc, libc_free, libc_memcpy}
import core/str::{str}

shape ArenaChunk (
    data: Addr,
    capacity: usize,
    offset#: usize,
    nul *#next: ArenaChunk = null as nul *ArenaChunk
)

pub shape Arena (
    nul *#chunks: ArenaChunk = null as nul *ArenaChunk,
    default_chunk_size: usize = 65536:usize
)

impl Arena {
    pub fn new() -> Arena {
        return Arena(
            *chunks = null as nul *ArenaChunk,
            default_chunk_size = 65536:usize
        )
    }

    pub fn new_with_capacity(capacity: usize) -> Arena {
        return Arena(
            *chunks = null as nul *ArenaChunk,
            default_chunk_size = capacity
        )
    }

    /**
     * Allocate aligned memory inside the arena chunk pool.
     * All allocations are automatically aligned to 8 bytes for 64-bit platforms.
     */
    pub fn alloc_bytes(self#, size: usize) -> Addr {
        if size == 0:usize {
            return ADDR0
        }

        // Align size to 8 bytes boundary
        auto aligned_size = (size + 7:usize) & (~ 7:usize)

        unsafe {
            // 1. Attempt to find space in existing chunks
            auto nul *#curr# = self.*chunks
            loop true {
                auto curr_addr = *curr as Addr
                if curr_addr == ADDR0 { break }
                auto *#live_curr# = curr.unwrap()

                auto available = live_curr.capacity - live_curr.offset
                if available >= aligned_size {
                    auto addr = live_curr.data + live_curr.offset
                    live_curr.offset = live_curr.offset + aligned_size
                    return addr
                }
                *curr = live_curr.*next
            }

            // 2. No chunk has enough space, allocate a new chunk
            auto chunk_size# = self.default_chunk_size
            if aligned_size > chunk_size {
                chunk_size = aligned_size
            }

            // Allocate raw memory buffer
            auto raw_data = libc_malloc(chunk_size) as Addr
            if raw_data == ADDR0 {
                return ADDR0
            }

            // Allocate the ArenaChunk structure itself
            auto *new_chunk# = (unsafe alloc [1] ArenaChunk) as *ArenaChunk
            auto new_chunk_addr = *new_chunk as Addr
            if new_chunk_addr == ADDR0 {
                libc_free(raw_data as *void)
                return ADDR0
            }

            // Construct the ArenaChunk
            new_chunk.data = raw_data
            new_chunk.capacity = chunk_size
            new_chunk.offset = aligned_size
            new_chunk.*next = self.*chunks

            self.*chunks = *new_chunk
            return raw_data
        }
    }

    /**
     * Reset the offsets of all chunks to 0 without freeing raw memory buffers.
     * This makes reuse extremely fast.
     */
    pub fn reset(self#) {
        unsafe {
            auto nul *#curr# = self.*chunks
            loop true {
                auto curr_addr = *curr as Addr
                if curr_addr == ADDR0 { break }
                auto *#live_curr# = curr.unwrap()

                live_curr.offset = 0:usize
                *curr = live_curr.*next
            }
        }
    }

    /**
     * Release all physical resources held by this Arena.
     */
    pub fn release(self#) {
        unsafe {
            auto nul *#curr# = self.*chunks
            loop true {
                auto curr_addr = *curr as Addr
                if curr_addr == ADDR0 { break }
                auto *#live_curr# = curr.unwrap()

                auto nul *next# = live_curr.*next

                libc_free(live_curr.data as *void)
                unsafe free [1] (*live_curr as *[ArenaChunk])

                *curr = *next
            }
            self.*chunks = null as nul *ArenaChunk
        }
    }
}

/**
 * Allocate generic type 'T safely and return a raw pointer to it.
 */
pub fn alloc_type<'T>(arena#: Arena) -> nul *'T {
    auto size = sizeof('T)
    auto addr = arena#.alloc_bytes(size)
    return addr as nul *'T
}

/**
 * Allocate an array of generic type 'T inside the arena chunk pool.
 */
pub fn alloc_array<'T>(arena#: Arena, count: usize) -> nul *'T {
    auto size = sizeof('T) * count
    auto addr = arena#.alloc_bytes(size)
    return addr as nul *'T
}

/**
 * Copy a string view into the arena chunk pool, returning a new str that persists.
 */
pub fn alloc_str(arena#: Arena, s: str) -> str <- arena | s {
    if s.len() == 0:usize {
        return s.clone()
    }
    auto addr = arena#.alloc_bytes(s.len())
    if addr == ADDR0 {
        return s.clone()
    }
    unsafe {
        libc_memcpy(addr as *void, s.raw_ptr() as *void, s.len())
        auto ret# = s.clone()
        auto ptr_addr = addr
        libc_memcpy(&ret as *void, &ptr_addr as *void, 8)
        return ret
    }
}


impl Arena@Encap {
    fn drop(self#) {
        self#.release()
    }

}

impl ArenaChunk@Encap {
    fn drop(self#) {
        // ArenaChunk does not own its memory; the Arena does.
    }

}

impl ArenaChunk {
    pub fn clone(self) -> ArenaChunk {
        return ArenaChunk(
            data = self.data,
            capacity = self.capacity,
            offset = self.offset,
            *next = self.*next
        )
    }
}
