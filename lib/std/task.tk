// std/task.tk
// This file provides the runtime task scheduler and synchronization context.

import std/vec::{Vec}
import std/io::{println}
import sys/libc::{libc_usleep}
import sys/sync as sys_sync
import std/time::{Instant}
import core/task::{TaskHandle, __toka_coro_resume, __toka_coro_done, __toka_coro_destroy}
import sys/os/net as sysnet

pub fn current_time_ms() -> i64 {
    auto inst = Instant::now()
    return inst.duration_since_boot.as_millis() as i64
}

pub shape TaskPtr(addr: Addr)

import core/option::{Option}

shape TimerEntry(
    addr: Addr, // coro handle
    expire_at: i64
)

shape TimerHeap(
    data#: Vec<TimerEntry>
)

impl TimerHeap {
    pub fn push(self#, item: TimerEntry) {
        self.data#.push(item)
        self#.sift_up(self.data.len() - 1)
    }

    pub fn pop(self#) -> Option<TimerEntry> {
        if self.data.is_empty() { return Option<TimerEntry>::None() }
        auto last_idx = self.data.len() - 1
        if last_idx == 0 {
            auto ret = self.data.get(0)
            self.data#.pop()
            return Option<TimerEntry>::Some(ret)
        }
        auto ret = self.data.get(0)
        auto last_item = self.data.get(last_idx)
        self.data#.set(0:usize, last_item)
        self.data#.pop()
        self#.sift_down(0:usize)
        return Option<TimerEntry>::Some(ret)
    }

    pub fn peek(self) -> Option<TimerEntry> {
        if self.data.is_empty() { return Option<TimerEntry>::None() }
        return Option<TimerEntry>::Some(self.data.get(0))
    }

    pub fn len(self) -> usize { return self.data.len() }

    fn sift_up(self#, idx: usize) {
        auto current# = idx
        loop current > 0 {
            auto parent = (current - 1) / 2
            auto c_item = self.data.get(current)
            auto p_item = self.data.get(parent)
            if c_item.expire_at < p_item.expire_at {
                self.data#.set(current, p_item)
                self.data#.set(parent, c_item)
                current = parent
            } else { break }
        }
    }

    fn sift_down(self#, idx: usize) {
        auto current# = idx
        auto len = self.data.len()
        loop true {
            auto left = 2 * current + 1
            auto right = 2 * current + 2
            auto smallest# = current
            
            if left < len {
                if self.data.get(left).expire_at < self.data.get(smallest).expire_at {
                    smallest = left
                }
            }
            if right < len {
                if self.data.get(right).expire_at < self.data.get(smallest).expire_at {
                    smallest = right
                }
            }
            if smallest != current {
                auto c_item = self.data.get(current)
                auto s_item = self.data.get(smallest)
                self.data#.set(current, s_item)
                self.data#.set(smallest, c_item)
                current = smallest
            } else { break }
        }
    }

    pub fn remove(self#, handle_addr: usize) -> bool {
        auto temp_vec# = Vec<TimerEntry>::new()
        auto found# = false
        auto idx# = 0:usize
        auto len = self.data.len()
        loop idx < len {
            auto entry = self.data.get(idx)
            if entry.addr as usize == handle_addr {
                found = true
            } else {
                temp_vec#.push(entry)
            }
            idx += 1
        }
        if found {
            self.data#.clear()
            auto j# = 0:usize
            auto temp_len = temp_vec.len()
            loop j < temp_len {
                self#.push(temp_vec.get(j))
                j += 1
            }
        }
        return found
    }
}

// ==========================================
// Global Ready Task Queue (based on underlying inline pthread_mutex + Vec)
// ==========================================
auto g_task_queue# = Vec<TaskPtr>(*buf=null, len=0, cap=0)
auto g_timer_queue# = TimerHeap(data=Vec<TimerEntry>(*buf=null, len=0, cap=0))

auto g_mutex_ptr#: Addr = 0:Addr
auto g_mutex_init#: bool = false
auto g_reactor_fd#: i32 = -1

pub fn get_reactor_fd() -> i32 {
    if g_reactor_fd == -1 {
        g_reactor_fd = sysnet::reactor_create_impl()
    }
    return g_reactor_fd
}

fn lock_queue() {
    if !g_mutex_init {
        g_mutex_ptr = sys_sync::sys_mutex_create()
        g_mutex_init = true
    }
    sys_sync::sys_mutex_lock(g_mutex_ptr)
}

fn unlock_queue() {
    sys_sync::sys_mutex_unlock(g_mutex_ptr)
}

pub fn __toka_spawn(*task: void) {
    if *task != null {
        // tokac has the suspend_never initial execution behavior, meaning it runs synchronously until the first await.
        // If the task is alive here, it must have been mounted somewhere else (e.g. Timer Queue or another Promise's awaiter).
        // Forcibly pushing to g_task_queue would cause unexpected immediate double resumption and crash.
    }
}

pub fn __toka_detach_task(*task: void) {
    // Detached task lifecycles are automatically managed by LLVM native coroutine frame splits.
}

pub fn __toka_register_timer(*task: void, ms: i32) {
    if *task != null {
        println("  [register_timer] task: {}, ms: {}", *task as usize, ms)
        auto expire_time = current_time_ms() + (ms as i64)
        lock_queue()
        g_timer_queue#.push(TimerEntry(addr=*task as Addr, expire_at=expire_time))
        unlock_queue()
    }
}

pub fn dequeue_task_handle(handle_addr: usize) -> bool {
    lock_queue()
    auto idx# = 0:usize
    auto len = g_task_queue.len()
    auto found# = false
    loop idx < len {
        auto item = g_task_queue.get(idx)
        if item.addr as usize == handle_addr {
            auto k# = idx + 1
            loop k < len {
                g_task_queue#.set(k - 1, g_task_queue.get(k))
                k += 1
            }
            g_task_queue#.pop()
            found = true
            break
        }
        idx += 1
    }
    unlock_queue()
    return found
}

pub fn dequeue_timer_handle(handle_addr: usize) -> bool {
    lock_queue()
    auto temp_vec# = Vec<TimerEntry>::new()
    auto found# = false
    auto idx# = 0:usize
    auto len = g_timer_queue.data.len()
    loop idx < len {
        auto entry = g_timer_queue.data.get(idx)
        if entry.addr as usize == handle_addr {
            found = true
        } else {
            temp_vec#.push(entry)
        }
        idx += 1
    }
    if found {
        auto new_heap# = TimerHeap(data=temp_vec)
        g_timer_queue = new_heap
        println("  [dequeue_timer] found and rebuilt! new len: {}", g_timer_queue.data.len())
    }
    unlock_queue()
    return found
}



// Spawn loop for blocking environments
pub fn __toka_spawn_blocking(*task: void) {
    if *task == null { return }
    __toka_spawn(*task)
    
    // Start blocking spin until task enters done state and suspended queues are completely emptied
    loop true {
        lock_queue()
        auto task_q_len = g_task_queue.len()
        auto timer_q_len = g_timer_queue.len()
        unlock_queue()

        if __toka_coro_done(*task) && task_q_len == 0 && timer_q_len == 0 {
            break
        }
        
        lock_queue()
        auto now = current_time_ms()
        
        // Timer Queue check and release expired suspended coroutines to Task Queue
        loop true {
            auto top_opt = g_timer_queue.peek()
            if top_opt.is_none() { break }
            auto t = top_opt.unwrap()
            if now >= t.expire_at {
                println("  [scheduler] Time reached for timer handle, pushing to task queue!")
                g_task_queue#.push(TaskPtr(addr=t.addr))
                g_timer_queue#.pop()
            } else {
                break
            }
        }
        
        // Attempt to consume coroutines from the ready queue
        if g_task_queue.len() > 0 {
            auto tl = g_task_queue.len()
            auto popped = g_task_queue.get(0)
            auto k#: usize = 1
            loop k < tl {
                g_task_queue#.set(k - 1, g_task_queue.get(k))
                k += 1
            }
            g_task_queue#.pop()
            unlock_queue()
            
            auto addr = popped.addr
            println("  [scheduler] Resuming task from queue!")
            __toka_coro_resume(addr as *void)
            println("  [scheduler] Task yielded back!")
            continue
        }
        unlock_queue()
        
        // Garbage Collector for dropped TaskHandles

        
        if g_reactor_fd == -1 {
            g_reactor_fd = sysnet::reactor_create_impl()
        }

        // Calculate next timeout based on `g_timer_queue`
        auto timeout_ms# = 100 // default max delay
        lock_queue()
        if !g_timer_queue.data.is_empty() {
            auto min_expire = g_timer_queue.peek().unwrap().expire_at
            auto wait_time# = min_expire - current_time_ms()
            if wait_time < 0:i64 { wait_time = 0:i64 }
            if wait_time < timeout_ms as i64 {
                timeout_ms = wait_time as i32
            }
        }
        unlock_queue()
        
        if timeout_ms < 0 { timeout_ms = 0 }

        println("  [scheduler] Entering reactor_wait_impl with timeout: {}", timeout_ms)
        // Block on the reactor
        unsafe {
            auto events_buf = [0:Addr; 64]
            auto *events_ptr = &events_buf[0] as *Addr
            
            auto n = sysnet::reactor_wait_impl(g_reactor_fd, timeout_ms, *events_ptr, 64)
            println("  [scheduler] reactor_wait_impl returned: {}", n)
            
            if n > 0 {
                lock_queue()
                auto i# = 0
                loop i < n {
                    auto handle = events_buf[i]
                    g_task_queue#.push(TaskPtr(addr=handle))
                    i += 1
                }
                unlock_queue()
            }
        }
    }
}

// === Thread & Time Utilities ===
extern fn __toka_get_coro_handle(*handle: void) -> *void
extern fn __builtin_coro_current_handle() -> *void
extern fn __builtin_coro_suspend()

pub fn sleep_async(ms: i32) -> async i32 {
    auto *handle = __builtin_coro_current_handle()
    __toka_register_timer(*handle, ms)
    __builtin_coro_suspend()
    return 0
}

pub fn sleep(ms: i32) {
    libc_usleep(ms * 1000)
}

// Event loop, blocks until the specified main coroutine enters the done state
pub fn block_on<T>(handle#: TaskHandle<T>) -> T {
    __toka_spawn_blocking(handle.*coro_handle)
    return handle.wait
}

pub fn detach_forget<T>(handle#: TaskHandle<T>) {
    handle.*coro_handle = null as *void
}

pub shape TaskGroup (
    child_handles#: Vec<usize> = Vec<usize>::new(),
    cancelled#: bool = false
)

impl TaskGroup {
    pub fn new() -> TaskGroup {
        return TaskGroup(
            child_handles = Vec<usize>::new(),
            cancelled = false
        )
    }

    pub fn cancel_all(self#) {
        if self.cancelled { return }
        self.cancelled = true

        auto i# = 0:usize
        auto len = self.child_handles.len()
        loop i < len {
            auto handle_addr = self.child_handles.get(i)
            if handle_addr != 0:usize {
                dequeue_task_handle(handle_addr)
                dequeue_timer_handle(handle_addr)
                
                __toka_coro_destroy(handle_addr as *void)
                println("cancel_all: after __toka_coro_destroy")
            }
            i += 1
        }
        self.child_handles#.clear()
    }
}

pub fn spawn_task<T>(group#: TaskGroup, handle#: TaskHandle<T>) {
    auto *coro = __toka_get_coro_handle(*handle)
    if *coro != null {
        group.child_handles#.push(*coro as usize)
        handle.*coro_handle = null as *void
    }
}

pub fn get_handle_addr<T>(handle: TaskHandle<T>) -> usize {
    auto *coro = __toka_get_coro_handle(*handle)
    println("  [get_handle_addr] handle.*coro_handle = {}, *coro = {}", handle.*coro_handle as usize, *coro as usize)
    return *coro as usize
}

// TaskGroup is a pure container shape that is manually controlled via cancel_all.
// The @encap drop is omitted to prevent compiler coroutine-suspend scope-destruction bugs.
