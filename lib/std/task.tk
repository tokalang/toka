// std/task.tk
// This file provides the runtime task scheduler and synchronization context.

import std/vec::{Vec}
import sys/libc::{libc_usleep}
import sys/sync as sys_sync
import std/time::{Instant}
import core/task as core_task
import core/task::{TaskHandle, __toka_coro_resume, __toka_coro_done, __toka_coro_destroy, task_get_coro_handle, toka_task_request_cancel, toka_task_is_cancel_requested, toka_task_subscribe_completion}
import sys/os/net as sysnet
import core/result::{Result}
import std/channel::{channel, Sender, Receiver}
import std/error::{Error}

pub fn current_time_ms() -> i64 {
    auto inst = Instant::now()
    return inst.duration_since_boot.as_millis() as i64
}

pub shape TaskPtr(addr: Addr)

import core/option::{Option}

// A host source is synchronously pumped by the thread that calls
// `pump_with_host`.  It is intentionally not retained, registered globally,
// or required to be Send: GUI adapters can therefore preserve UI affinity.
pub shape HostEventPoll (
    Event = 1 |
    Idle = 2 |
    Stopped = 3
)

pub trait @HostEventSource {
    pub fn poll_events(self#, timeout_millis: i32) -> Result<HostEventPoll, string>
}

// The inbox is bound to the thread that creates it.  It deliberately has no
// Send implementation, so worker code can transfer only its sender half.
shape HostThreadAffinity (
    *marker: void = null as *void
)

impl HostThreadAffinity@Encap {
    fn drop(self#) {}
}

// Values move from workers to the host thread.  They must be Send, but the
// sender cannot carry a UI object or a borrowed closure across the boundary.
pub shape HostMailboxSender<'T: @Send> (
    sender#: Sender<'T>
)

impl<'T: @Send> HostMailboxSender<'T>@Send {}

impl<'T: @Send> HostMailboxSender<'T> {
    pub fn clone(self#) -> HostMailboxSender<'T> {
        return HostMailboxSender<'T>(sender = cede self.sender#.clone())
    }

    pub fn post(self#, message: cede 'T) -> Result<(), string> {
        auto sent = self.sender#.send(cede message)
        match cede sent {
            auto Result<(), Error>::Ok(_) => return Result<(), string>::Ok(())
            auto Result<(), Error>::Err('error) => {
                return Result<(), string>::Err(cede 'error.message)
            }
            _ => return Result<(), string>::Err(string::from("invalid host mailbox send result"))
        }
    }
}

pub shape HostMailboxPoll<'T: @Send> (
    Message('T) = 1 |
    Empty = 2 |
    Closed = 3
)

pub shape HostMailboxInbox<'T: @Send> (
    receiver#: Receiver<'T>,
    thread_affinity: HostThreadAffinity
)

impl<'T: @Send> HostMailboxInbox<'T> {
    // This is non-blocking so applications can drain it after every bounded
    // host/executor turn without introducing a second wait loop.
    pub fn try_next(self#) -> Result<HostMailboxPoll<'T>, string> {
        auto received = self.receiver#.try_recv()
        match cede received {
            auto Result<Option<Option<'T> >, Error>::Err('error) => {
                return Result<HostMailboxPoll<'T>, string>::Err(cede 'error.message)
            }
            auto Result<Option<Option<'T> >, Error>::Ok('state) => {
                match cede 'state {
                    auto Option<Option<'T> >::None() => {
                        return Result<HostMailboxPoll<'T>, string>::Ok(HostMailboxPoll<'T>::Empty)
                    }
                    auto Option<Option<'T> >::Some('item) => {
                        match cede 'item {
                            auto Option<'T>::Some('message) => {
                                return Result<HostMailboxPoll<'T>, string>::Ok(
                                    HostMailboxPoll<'T>::Message(cede 'message)
                                )
                            }
                            auto Option<'T>::None() => {
                                return Result<HostMailboxPoll<'T>, string>::Ok(HostMailboxPoll<'T>::Closed)
                            }
                        }
                    }
                }
            }
            _ => return Result<HostMailboxPoll<'T>, string>::Err(string::from("invalid host mailbox receive result"))
        }
    }
}

pub shape HostMailbox<'T: @Send> (
    sender#: HostMailboxSender<'T>,
    inbox#: HostMailboxInbox<'T>
)

// Construct this beside the host event source.  Moving HostMailboxInbox into
// a worker is rejected by its HostThreadAffinity member; move or clone only
// HostMailboxSender when a worker must publish an owned update.
pub fn host_mailbox<'T: @Send>() -> HostMailbox<'T> {
    auto pair = channel<'T>()
    return HostMailbox<'T>(
        sender = HostMailboxSender<'T>(sender = cede pair.tx),
        inbox = HostMailboxInbox<'T>(
            receiver = cede pair.rx,
            thread_affinity = HostThreadAffinity(*marker = null as *void)
        )
    )
}

pub shape ExecutorPump (
    ready_tasks: i32,
    timer_wakes: i32,
    reactor_events: i32,
    host_poll: HostEventPoll
)

shape TimerEntry(
    wait_id: u32,
    slot_gen: u32,
    expire_at: i64
)

shape TimerHeap(
    data#: Vec<TimerEntry>
)

impl TimerHeap {
    pub fn push(self#, item: TimerEntry) {
        self.data#.push(item)
        self#.sift_up(self.data.len() - 1)
    }

    pub fn pop(self#) -> Option<TimerEntry> {
        if self.data.is_empty() { return Option<TimerEntry>::None() }
        auto last_idx = self.data.len() - 1
        if last_idx == 0 {
            auto ret = self.data.get(0)
            self.data#.pop()
            return Option<TimerEntry>::Some(ret)
        }
        auto ret = self.data.get(0)
        auto last_item = self.data.get(last_idx)
        self.data#.set(0:usize, last_item)
        self.data#.pop()
        self#.sift_down(0:usize)
        return Option<TimerEntry>::Some(ret)
    }

    pub fn peek(self) -> Option<TimerEntry> {
        if self.data.is_empty() { return Option<TimerEntry>::None() }
        return Option<TimerEntry>::Some(self.data.get(0))
    }

    pub fn len(self) -> usize { return self.data.len() }

    fn sift_up(self#, idx: usize) {
        auto current# = idx
        loop current > 0 {
            auto parent = (current - 1) / 2
            auto c_item = self.data.get(current)
            auto p_item = self.data.get(parent)
            if c_item.expire_at < p_item.expire_at {
                self.data#.set(current, p_item)
                self.data#.set(parent, c_item)
                current = parent
            } else { break }
        }
    }

    fn sift_down(self#, idx: usize) {
        auto current# = idx
        auto len = self.data.len()
        loop true {
            auto left = 2 * current + 1
            auto right = 2 * current + 2
            auto smallest# = current

            if left < len {
                if self.data.get(left).expire_at < self.data.get(smallest).expire_at {
                    smallest = left
                }
            }
            if right < len {
                if self.data.get(right).expire_at < self.data.get(smallest).expire_at {
                    smallest = right
                }
            }
            if smallest != current {
                auto c_item = self.data.get(current)
                auto s_item = self.data.get(smallest)
                self.data#.set(current, s_item)
                self.data#.set(smallest, c_item)
                current = smallest
            } else { break }
        }
    }

}

// ==========================================
// Global Ready Task Queue (based on underlying inline pthread_mutex + Vec)
// ==========================================
auto g_task_queue# = Vec<TaskPtr>(*buf=null, len=0, cap=0)
auto g_timer_queue# = TimerHeap(data=Vec<TimerEntry>(*buf=null, len=0, cap=0))
auto g_detached_tasks# = Vec<TaskPtr>(*buf=null, len=0, cap=0)

auto g_mutex_ptr# = 0:Addr
auto g_mutex_init# = false:bool
auto g_reactor_fd# = -1:i32

pub fn get_reactor_fd() -> i32 {
    if g_reactor_fd == -1 {
        g_reactor_fd = sysnet::reactor_create_impl()
    }
    return g_reactor_fd
}

fn lock_queue() {
    if !g_mutex_init {
        g_mutex_ptr = sys_sync::sys_mutex_create()
        g_mutex_init = true
    }
    sys_sync::sys_mutex_lock(g_mutex_ptr)
}

fn unlock_queue() {
    sys_sync::sys_mutex_unlock(g_mutex_ptr)
}

pub fn register_timer_token(wait_id: u32, slot_gen: u32, ms: i32) {
    auto expire_time = current_time_ms() + (ms as i64)
    lock_queue()
    g_timer_queue#.push(TimerEntry(wait_id=wait_id, slot_gen=slot_gen, expire_at=expire_time))
    unlock_queue()
}

pub fn __toka_spawn(*task: void) {
    if *task != null {
        core_task::toka_task_start(*task)
    }
}

import core/task::{TaskHandle, __toka_coro_resume, __toka_coro_done, __toka_coro_destroy, task_get_coro_handle, toka_task_request_cancel, toka_task_is_cancel_requested, toka_task_subscribe_completion, toka_task_unsubscribe_completion, toka_task_retain, toka_tcb_is_canceled, toka_task_clear_current}

pub fn task_cancel<'T>(handle: TaskHandle<'T>) {
    auto *tcb = task_get_coro_handle<'T>(handle)
    if *tcb != null {
        toka_task_request_cancel(*tcb)
    }
}

pub fn task_is_cancel_requested<'T>(handle: TaskHandle<'T>) -> bool {
    auto *tcb = task_get_coro_handle<'T>(handle)
    if *tcb != null {
        return toka_task_is_cancel_requested(*tcb) != 0
    }
    return false
}

pub fn task_is_canceled<'T>(handle: TaskHandle<'T>) -> bool {
    auto *tcb = task_get_coro_handle<'T>(handle)
    if *tcb != null {
        return toka_tcb_is_canceled(*tcb)
    }
    return false
}

pub fn task_subscribe_completion<'T>(handle: TaskHandle<'T>, wait_id: u32, slot_gen: u32) -> bool {
    auto *tcb = task_get_coro_handle<'T>(handle)
    if *tcb != null {
        return toka_task_subscribe_completion(*tcb, wait_id, slot_gen) != 0
    }
    return false
}

pub fn task_unsubscribe_completion<'T>(handle: TaskHandle<'T>, wait_id: u32, slot_gen: u32) -> bool {
    auto *tcb = task_get_coro_handle<'T>(handle)
    if *tcb != null {
        return toka_task_unsubscribe_completion(*tcb, wait_id, slot_gen) != 0
    }
    return false
}

pub fn __toka_detach_task(*task: void) {
    if *task != null {
        core_task::toka_task_detach(*task)
    }
}

fn collect_detached_tasks() {
    auto completed# = Vec<TaskPtr>::new()
    lock_queue()
    auto i# = 0:usize
    loop i < g_detached_tasks.len() {
        auto task = g_detached_tasks.get(i)
        if __toka_coro_done(task.addr as *void) {
            completed#.push(task)
            auto len = g_detached_tasks.len()
            auto k# = i + 1
            loop k < len {
                g_detached_tasks#.set(k - 1, g_detached_tasks.get(k))
                k += 1
            }
            g_detached_tasks#.pop()
        } else {
            i += 1
        }
    }
    unlock_queue()

    auto j# = 0:usize
    loop j < completed.len() {
        __toka_coro_destroy(completed.get(j).addr as *void)
        j += 1
    }
}

fn drain_ready_tasks() -> i32 {
    auto task_id# = 0:u64
    auto task_gen# = 0:u64
    auto tcb_addr# = 0:Addr
    auto resumed# = 0:i32

    loop true {
        auto popped = core_task::toka_task_pop_ready(&task_id as *u64, &task_gen as *u64, &tcb_addr as *Addr)
        if popped == 0 { break }
        if tcb_addr != 0:Addr {
            auto frame_addr = core_task::toka_tcb_get_coro_frame(tcb_addr as *void) as Addr
            if frame_addr != 0:Addr {
                __toka_coro_resume(frame_addr as *void)
                resumed += 1:i32
            }
            core_task::toka_task_clear_current(tcb_addr as *void)
            core_task::toka_task_release(tcb_addr as *void)
        }
    }
    return resumed
}

fn release_expired_timers() -> i32 {
    auto scheduled# = 0:i32
    lock_queue()
    auto now = current_time_ms()
    loop true {
        auto top_opt = g_timer_queue.peek()
        if top_opt.is_none() { break }
        auto timer = top_opt.unwrap()
        if now < timer.expire_at { break }
        g_timer_queue#.pop()
        auto outcome = core_task::toka_wait_registry_try_wake(timer.wait_id, timer.slot_gen)
        if outcome == 1:i32 || outcome == 2:i32 {
            scheduled += 1:i32
        } else if outcome == 4:i32 {
            core_task::toka_wait_registry_release(timer.wait_id, timer.slot_gen)
        }
    }
    unlock_queue()
    return scheduled
}

fn next_wait_timeout(max_wait_millis: i32) -> i32 {
    auto timeout# = max_wait_millis
    lock_queue()
    if !g_timer_queue.data.is_empty() {
        auto min_expire = g_timer_queue.peek().unwrap().expire_at
        auto remaining# = min_expire - current_time_ms()
        if remaining < 0:i64 { remaining = 0:i64 }
        if remaining < timeout as i64 { timeout = remaining as i32 }
    }
    unlock_queue()
    return timeout
}

fn poll_reactor(timeout_millis: i32) -> i32 {
    if g_reactor_fd == -1 {
        g_reactor_fd = sysnet::reactor_create_impl()
    }

    unsafe {
        auto events_buf = [0:Addr; 64]
        auto *events_ptr = &events_buf[0] as *Addr
        auto count = sysnet::reactor_wait_impl(g_reactor_fd, timeout_millis, *events_ptr, 64)
        if count <= 0 { return 0:i32 }

        auto i# = 0
        loop i < count {
            auto event_key = events_buf[i] as u64
            auto wait_id = (event_key >> 32:u64) as u32
            auto slot_gen = (event_key & 0xFFFFFFFF:u64) as u32
            auto outcome = core_task::toka_wait_registry_try_wake(wait_id, slot_gen)
            if outcome == 4:i32 {
                core_task::toka_wait_registry_release(wait_id, slot_gen)
            }
            i += 1
        }
        return count
    }
}

// Execute one bounded host/executor turn on the caller's current thread.
// The host source is not retained and never crosses a thread boundary.
pub fn pump_with_host<'H: @HostEventSource>(host#: H, max_wait_millis: i32) -> Result<ExecutorPump, string> {
    if max_wait_millis < 0:i32 {
        return Result<ExecutorPump, string>::Err(string::from("host wait timeout must not be negative"))
    }

    collect_detached_tasks()
    auto ready_count# = drain_ready_tasks()
    auto timer_count# = release_expired_timers()
    ready_count += drain_ready_tasks()

    auto host_timeout# = 0:i32
    if ready_count == 0:i32 && timer_count == 0:i32 {
        host_timeout = next_wait_timeout(max_wait_millis)
    }

    auto host_result = host#.poll_events(host_timeout)
    match cede host_result {
        auto Result<HostEventPoll, string>::Err('error) => {
            return Result<ExecutorPump, string>::Err(cede 'error)
        }
        auto Result<HostEventPoll, string>::Ok('host_poll) => {
            // A host wait may have crossed a timer deadline.  Socket readiness
            // is collected non-blockingly so ready continuations run this turn.
            timer_count += release_expired_timers()
            auto reactor_count = poll_reactor(0:i32)
            ready_count += drain_ready_tasks()
            collect_detached_tasks()
            return Result<ExecutorPump, string>::Ok(
                ExecutorPump(ready_tasks = ready_count,
                             timer_wakes = timer_count,
                             reactor_events = reactor_count,
                             host_poll = 'host_poll)
            )
        }
        _ => return Result<ExecutorPump, string>::Err(string::from("invalid host event result"))
    }
}

pub fn __toka_register_timer(*task: void, ms: i32) {
    if *task != null {
        auto task_id# = 0:u64
        auto wait_gen# = 0:u64
        auto ok = core_task::toka_task_prepare_suspend(*task, &task_id as *u64, &wait_gen as *u64)
        if ok != 0 {
            auto wait_id# = 0:u32
            auto slot_gen# = 0:u32
            auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 1:u16, &wait_id as *u32, &slot_gen as *u32)
            if alloc_ok != 0 {
                auto expire_time = current_time_ms() + (ms as i64)
                lock_queue()
                g_timer_queue#.push(TimerEntry(wait_id=wait_id, slot_gen=slot_gen, expire_at=expire_time))
                unlock_queue()
                core_task::toka_task_commit_suspend(*task)
            }
        }
    }
}

// Spawn loop for blocking environments
pub fn __toka_spawn_blocking(*task: void) {
    if *task == null { return }
    core_task::toka_task_start(*task)

    loop true {
        collect_detached_tasks()
        drain_ready_tasks()

        if core_task::toka_tcb_is_done(*task) && core_task::toka_task_active_detached_count() == 0:u32 {
            break
        }

        if release_expired_timers() > 0:i32 {
            continue
        }

        poll_reactor(next_wait_timeout(100:i32))
    }
}

// === Thread & Time Utilities ===
extern fn __builtin_coro_current_handle() -> *void
extern fn __builtin_coro_suspend() -> void

pub fn sleep_async(ms: i32) -> async i32 {
    auto *handle = __builtin_coro_current_handle()
    if core_task::toka_task_is_current_canceled(*handle) != 0 {
        return -1
    }
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64
    auto ok = core_task::toka_task_prepare_suspend(*handle, &task_id as *u64, &wait_gen as *u64)
    if ok != 0 {
        auto wait_id# = 0:u32
        auto slot_gen# = 0:u32
        auto alloc_ok = core_task::toka_wait_registry_allocate(task_id, wait_gen, 1:u16, &wait_id as *u32, &slot_gen as *u32)
        if alloc_ok != 0 {
            auto expire_time = current_time_ms() + (ms as i64)
            lock_queue()
            g_timer_queue#.push(TimerEntry(wait_id=wait_id, slot_gen=slot_gen, expire_at=expire_time))
            unlock_queue()
            core_task::toka_task_commit_suspend(*handle)
        }
    }
    __builtin_coro_suspend()
    if core_task::toka_task_is_current_canceled(*handle) != 0 {
        return -1
    }
    return 0
}

pub fn sleep(ms: i32) {
    libc_usleep(ms * 1000)
}

// Event loop, blocks until the specified main coroutine enters the done state
pub fn block_on<T>(handle: TaskHandle<T>) -> T {
    __toka_spawn_blocking(handle.*coro_handle)
    return handle.wait
}

pub fn detach_forget<T>(cede handle: TaskHandle<T>) {
    auto owned_handle# = cede handle
    if owned_handle.*coro_handle != null {
        __toka_detach_task(owned_handle.*coro_handle)
    }
    owned_handle.*coro_handle = null as *void
}
