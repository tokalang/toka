import core/types::{usize, Addr, ADDR0}
import core/traits::{@Copy, @Dup, @Encap, @Iterable, @Iterator, @IntoIterable, @BorrowIterator}
import sys/libc::*
import core/option::{Option}


// Helper for mutable iteration
shape Counter(val: usize)
impl Counter {
    fn inc(self#) {
        self.val += 1
    }
}

// Module-level factory functions removed. using static methods.

pub shape Vec<'T> (
    nul *#buf#: ['T] = null as nul *['T],
    len#: usize = 0,
    cap#: usize = 0
)

// Explictly bypass raw-pointer structural block by declaring Vec is Send/Sync when its payload is
impl<'T: @Send> Vec<'T> @Send {}
impl<'T: @Sync> Vec<'T> @Sync {}

// `clone` remains as a compatibility spelling, but duplication is provided by
// the explicit @Dup capability. Copy types receive the intrinsic Dup witness;
// resource types must provide their own source-preserving duplication recipe.
impl<'T: @Dup> Vec<'T> {
    pub fn clone(self) -> Vec<'T> {
        unsafe {
            if self.cap == 0 {
                return Vec<'T>(*buf=null, len=0, cap=0)
            }
            auto *new_buf# = unsafe alloc [self.cap] 'T
            auto ctr# = Counter(val=0)
            loop ctr.val < self.len {
                new_buf[ctr.val] = self.buf[ctr.val].dup()
                ctr#.inc()
            }
            return Vec<'T>(*buf=*new_buf, len=self.len, cap=self.cap)
        }
    }
}

impl<'T: @Dup> Vec<'T>@Dup {
    pub fn dup(self) -> Self {
        return self.clone()
    }
}

// Duplication operations are intentionally kept out of the move-only core impl.
// Vec itself remains a capsule; these APIs are ordinary library operations.
impl<'T: @Dup> Vec<'T> {
    // Get element at index by duplication.
    pub fn get(self, index: usize) -> 'T {
        unsafe {
             if index >= self.len {
                 libc_exit(1)
             }
             return self.buf[index].dup()
        }
    }

    // Alias to get
    pub fn at(self, index: usize) -> 'T {
        return self.get(index)
    }

    // Safe get
    pub fn get_opt(self, index: usize) -> Option<'T> {
        unsafe {
             if index >= self.len {
                 return Option<'T>::None
             }
             return Option<'T>::Some(self.buf[index].dup())
        }
    }

}

impl<'T> Vec<'T>@Encap {
    pub buf, len, cap
    fn drop(self#) {
        unsafe {
            if self.*buf != null {
                unsafe free [self.len]self.*#buf
                self.*buf = null
            }
        }
    }

}

impl<'T> Vec<'T> {
    // Getters for length and capacity
    pub fn len(self) -> usize {
        return self.len
    }

    pub fn cap(self) -> usize {
        return self.cap
    }

    pub fn is_empty(self) -> bool {
        return self.len == 0
    }

    pub fn clear(self#) {
        unsafe {
            loop self.len > 0 {
                self.len -= 1
                auto _old = Option<'T>::Some(cede self.buf[self.len])
            }
        }
    }

    pub fn insert(self#, index: usize, cede 'val: T) {
        if index > self.len {
            unsafe {
                libc_printf(c"[Vec] panic: insert index out of bounds\n")
                libc_abort()
            }
        }
        if self.len == self.cap {
            self#.grow()
        }
        unsafe {
            auto i# = self.len
            loop i > index {
                self.buf[i] = cede self.buf[i - 1]
                i -= 1
            }
            self.buf[index] = cede 'val
            self.len += 1
        }
    }

    pub fn remove(self#, index: usize) -> Option<'T> {
        if index >= self.len {
            return Option<'T>::None
        }
        unsafe {
            auto ret = Option<'T>::Some(cede self.buf[index])
            auto i# = index
            loop i < self.len - 1 {
                self.buf[i] = cede self.buf[i + 1]
                i += 1
            }
            self.len -= 1
            return cede ret
        }
    }
    
    // Create empty vector (Static Method)
    pub fn new() -> Vec<'T> {
        // Implicit conversation works for assignment/init of pointer variable
        return Vec<'T>(*buf=null, len=0, cap=0)
    }

    // Create vector with capacity (Static Method)
    pub fn with_capacity(capacity: usize) -> Vec<'T> {
        unsafe {
            if capacity == 0 {
                return Vec<'T>(*buf=null, len=0, cap=0)
            }
            // alloc array syntax
            auto *_new_buf# = unsafe alloc [capacity] 'T
            return Vec<'T>(*buf=*_new_buf, len=0, cap=capacity)
        }
    }

    // Push element to end
    pub fn push(self#, cede 'val: T) {
        unsafe {
            if self.len == self.cap {
                self#.grow()
            }
            
            // Pointer indexing handles
            // *self.buf provides the handle.
            self.buf[self.len] = cede 'val
            self.len += 1
        }
    }
    
    // Pop element from end
    pub fn pop(self#) -> Option<'T> {
        unsafe {
            if self.len == 0 {
                return Option<'T>::None
            }
            
            self.len -= 1
            // Copy out (move out since pop destroys it)
            auto 'val = cede self.buf[self.len]
            return Option<'T>::Some(cede 'val)
        }
    }

    /// Moves the backing allocation and all initialized elements into a new
    /// Vec, leaving this Vec empty and immediately reusable.
    pub fn take(self#) -> Vec<'T> {
        unsafe {
            auto nul *taken_buf = self.*buf
            auto taken_len = self.len
            auto taken_cap = self.cap
            self.*buf = null
            self.len = 0
            self.cap = 0
            return Vec<'T>(*buf = *taken_buf, len = taken_len, cap = taken_cap)
        }
    }

    /// Returns a shared element borrow tied to the lifetime of this Vec.
    pub fn borrow(self, index: usize) -> &item: T
    effects:
        &item <- self
    {
        if index >= self.len {
            unsafe {
                libc_printf(c"[Vec] panic: borrow index out of bounds\n")
                libc_abort()
            }
        }
        unsafe {
            return &self.buf[index]
        }
    }

    /// Returns an exclusive element borrow tied to the lifetime of this Vec.
    pub fn borrow_mut(self#, index: usize) -> &item#: T
    effects:
        &item <- self
    {
        if index >= self.len {
            unsafe {
                libc_printf(c"[Vec] panic: mutable borrow index out of bounds\n")
                libc_abort()
            }
        }
        unsafe {
            return &self.buf[index]
        }
    }
    
    pub fn from_raw(nul *buf: ['T], len: usize, cap: usize) -> Vec<'T> {
        return Vec<'T>(
            *buf=*buf,
            len=len,
            cap=cap
        )
    }

    pub fn unsafe_forget(self#) {
        unsafe {
            self.*buf = null
            self.cap = 0
            self.len = 0
        }
    }

    pub fn unsafe_as_raw(self) -> nul *['T] {
        return self.*buf
    }

    pub fn unsafe_into_raw(self#) -> nul *['T] {
        unsafe {
            // Nullify buffer to prevent drop from freeing it
            // This is used when ownership is manually transferred
            auto nul *ptr = self.*buf
            self.*buf = null
            self.cap = 0
            self.len = 0
            return *ptr
        }
    }

    // Helper: Grow buffer
    fn grow(self#) {
        unsafe {
            // Determine new capacity
            auto new_cap = self.cap * 2
            
            if new_cap == 0 {
                // Initial allocation case
                auto cap = 4 : usize
                auto *_new_buf# = unsafe alloc [4] 'T
                
                // Fields
                self.*buf = *_new_buf
                self.cap = cap
            } else {
                // Growth case
                auto *new_buf# = unsafe alloc [new_cap] 'T
                
                // Move initialized elements; the old backing allocation is
                // then released with free[0], so it cannot drop stale copies.
                auto ctr# = Counter(val=0)
                loop ctr.val < self.len {
                    new_buf[ctr.val] = cede self.buf[ctr.val]
                    ctr#.inc()
                }
                
                // Free old buffer
                if self.*buf != null {
                    unsafe free [0]self.*#buf
                }
                
                // Update fields
                self.*buf = *new_buf
                self.cap = new_cap
            }
        }
    }

    // Set the logical length without initializing or moving elements.
    // This is restricted to buffer adapters that initialize the selected range
    // through an FFI read before exposing it to safe code.
    pub fn unsafe_set_len(self#, new_len: usize) {
        unsafe {
            if new_len <= self.cap {
                self.len = new_len
            }
        }
    }

    // Set value at index
    pub fn set(self#, index: usize, cede 'val: T) {
        unsafe {
             if index < self.len {
                 auto _old = Option<'T>::Some(cede self.buf[index])
                 self.buf[index] = cede 'val
             } else {
                 auto _unused = Option<'T>::Some(cede 'val)
             }
        }
    }

}

impl<'T: @Copy> Vec<'T> {
    // Resize vector by cloning the fill value into each new element.
    pub fn resize(self#, new_len: usize, 'val: T) {
        unsafe {
            if new_len > self.cap {
                 loop self.cap < new_len {
                     self#.grow()
                 }
            }
            auto i# = self.len
            loop i < new_len {
                self.buf[i] = 'val
                i += 1
            }
            self.len = new_len
        }
    }
}

impl<'T> Vec<'T>
where:
    'T: morphology raw_extendable
{
    pub fn unsafe_get(self, index: usize) -> *'T {
        unsafe {
            auto *ptr = self.*buf.unwrap() as *['T]
            return *ptr[index]
        }
    }
}

pub shape VecIterator<'T> (
    &buf: ['T],
    len#: usize = 0,
    pos#: usize = 0
)

// Owned iteration is separate from VecIterator: the latter is a borrowed
// cursor returned by @Iterable::iter and therefore carries a source
// dependency. VecIntoIterator owns the Vec and may move each element out.
pub shape VecIntoIterator<'T> (
    source#: Vec<'T>
)

impl<'T> VecIntoIterator<'T>@Encap {
    fn drop(self#) {}
}

impl<'T> Vec<'T>@IntoIterable {
    type IntoIter = VecIntoIterator<'T>

    pub fn into_iter(cede self) -> IntoIter {
        return VecIntoIterator<'T>(source = cede self)
    }
}

impl<'T> VecIntoIterator<'T>@Iterator {
    type Item = 'T

    // Vec::remove(0) keeps the public consuming order identical to ordinary
    // Vec iteration. A future storage-level drain cursor may optimize this
    // without changing the owned-iterator protocol.
    pub fn next(self#) -> Option<Item> {
        return self.source#.remove(0)
    }
}

impl<'T> Vec<'T>@Iterable {
    type Iter = VecIterator<'T>

    pub fn iter(self) -> Iter <- self {
        unsafe {
            return VecIterator<'T>(
                &buf = (self.*buf as &[T]),
                len = self.len,
                pos = 0
            )
        }
    }
}

impl<'T> VecIterator<'T>@Encap {
    fn drop(self#) {}
}

impl<'T> VecIterator<'T> {
    pub fn clone(self) -> VecIterator<'T> <- self {
        return VecIterator<'T>(
             &buf = self.&buf,
             len = self.len,
             pos = self.pos
        )
    }
}

// Concrete Implementation
impl<'T: @Copy> VecIterator<'T>@Iterator {
    type Item = 'T

    pub fn next(self#) -> Option<Item> {
        if self.pos >= self.len {
            return Option<Item>::None
        }

        self.pos += 1
        unsafe {
            return Option<Item>::Some(self.buf[self.pos - 1])
        }
    }
}

impl<'T> VecIterator<'T>@BorrowIterator {
    type BorrowedItem = &'T

    pub fn next_ref(self#) -> Option<BorrowedItem> <- self {
        if self.pos >= self.len {
            return Option<BorrowedItem>::None
        }

        self.pos += 1
        unsafe {
            return Option<BorrowedItem>::Some(&'(self.buf[self.pos - 1]))
        }
    }
}
