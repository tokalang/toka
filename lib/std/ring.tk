import core/types::{usize}
import core/traits::{@Encap, @Dup}
import core/option::{Option}
import std/vec::{Vec}

// Logical order is reverse(front) followed by back. Every element is a
// complete value owned by exactly one Vec, never a Ring-managed raw slot.
// Refill an empty side with half of the other side, avoiding repeated full
// reversals when callers alternate pop_front/pop_back.
fn ring_refill<'T>(source#: Vec<'T>, target#: Vec<'T>) {
    auto keep = source.len() / 2
    auto saved# = Vec<'T>::with_capacity(keep)
    loop saved.len() < keep {
        auto 'value = source#.pop().unwrap()
        saved#.push(cede 'value)
    }
    loop !source.is_empty() {
        auto 'value = source#.pop().unwrap()
        target#.push(cede 'value)
    }
    loop !saved.is_empty() {
        auto 'value = saved#.pop().unwrap()
        source#.push(cede 'value)
    }
}

pub shape RingCore<'T> (
    front#: Vec<'T> = Vec<'T>::new(),
    back#: Vec<'T> = Vec<'T>::new()
)

impl<'T: @Send> RingCore<'T>@Send {}

impl<'T> RingCore<'T> {
    pub fn new() -> RingCore<'T> {
        return RingCore<'T>(front = Vec<'T>::new(), back = Vec<'T>::new())
    }

    pub fn len(self) -> usize {
        return self.front.len() + self.back.len()
    }

    pub fn is_empty(self) -> bool {
        return self.front.is_empty() && self.back.is_empty()
    }

    pub fn clear(self#) {
        self.front#.clear()
        self.back#.clear()
    }

    pub fn push_back(self#, cede 'val: T) {
        self.back#.push(cede 'val)
    }

    pub fn push_front(self#, cede 'val: T) {
        self.front#.push(cede 'val)
    }

    pub fn pop_back(self#) -> Option<'T> {
        if self.back.is_empty() && !self.front.is_empty() {
            ring_refill(self.front#, self.back#)
        }
        auto outcome = self.back#.pop()
        return cede outcome
    }

    pub fn pop_front(self#) -> Option<'T> {
        if self.front.is_empty() && !self.back.is_empty() {
            ring_refill(self.back#, self.front#)
        }
        auto outcome = self.front#.pop()
        return cede outcome
    }
}

impl<'T: @Dup> RingCore<'T> {
    /// Duplicates an element without removing it.
    pub fn get(self, index: usize) -> Option<'T> {
        if index >= self.len() {
            auto outcome = Option<'T>::None
            return cede outcome
        }
        if index < self.front.len() {
            return self.front.get_opt(self.front.len() - 1 - index)
        }
        return self.back.get_opt(index - self.front.len())
    }
}

impl<'T> RingCore<'T>@Encap {
    // Both Vec fields retain their ordinary cleanup responsibilities.
    fn drop(self#) {}
}
