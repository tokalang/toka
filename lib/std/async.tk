// std/async.tk
// High-level async combinators and structured concurrency.

import core/task::{TaskHandle, task_get_coro_handle, toka_task_prepare_suspend, toka_task_commit_suspend, toka_wait_registry_allocate_pair, toka_wait_registry_is_winner, toka_wait_registry_release, toka_task_request_cancel, toka_task_register_cancel_child, toka_task_unregister_cancel_child, toka_tcb_is_done, toka_task_retain, toka_task_release, toka_task_start};
import core/marker::{@Dup};
import std/task::{current_time_ms, sleep_async, task_cancel, task_is_cancel_requested, task_subscribe_completion, task_unsubscribe_completion};
import std/vec::{Vec};
import std/io::{println};

extern fn __builtin_coro_current_handle() -> *void
extern fn __builtin_coro_suspend()

pub shape RaceWinner<'T1, 'T2> (
    First('T1) = 1 |
    Second('T2) = 2
)

pub fn race2<'T1, 'T2>(cede first: TaskHandle<'T1>, cede second: TaskHandle<'T2>) -> async RaceWinner<'T1, 'T2> {
    auto owned_first# = cede first
    auto owned_second# = cede second

    auto *coro_handle = __builtin_coro_current_handle()
    auto task_id# = 0:u64
    auto wait_gen# = 0:u64

    auto id1# = 0:u32
    auto gen1# = 0:u32
    auto id2# = 0:u32
    auto gen2# = 0:u32

    auto prep_ok = toka_task_prepare_suspend(*coro_handle, &task_id as *u64, &wait_gen as *u64)
    if prep_ok != 0 {
        auto alloc_ok = toka_wait_registry_allocate_pair(task_id, wait_gen, 1:u16, 2:u16, &id1 as *u32, &gen1 as *u32, &id2 as *u32, &gen2 as *u32)
        if alloc_ok == 0 {
            assert(false, "WaitRegistry pair allocation failed in race2")
        }

        // Subscribe completion notifications for first and second tasks
        auto sub1 = task_subscribe_completion<'T1>(owned_first, id1, gen1)
        auto sub2 = task_subscribe_completion<'T2>(owned_second, id2, gen2)

        if !sub1 || !sub2 {
            if sub1 { task_unsubscribe_completion<'T1>(owned_first, id1, gen1) }
            if sub2 { task_unsubscribe_completion<'T2>(owned_second, id2, gen2) }
            toka_wait_registry_release(id1, gen1)
            toka_wait_registry_release(id2, gen2)
            assert(false, "Completion subscription failed in race2")
        }

        // Completion subscriptions are installed before activation so even
        // cold tasks that complete immediately cannot lose their wakeup.
        auto *first_start_tcb = task_get_coro_handle<'T1>(owned_first)
        auto *second_start_tcb = task_get_coro_handle<'T2>(owned_second)
        auto registered_first# = false
        auto registered_second# = false
        if *first_start_tcb != null {
            registered_first = toka_task_register_cancel_child(*coro_handle, *first_start_tcb) != 0
        }
        if *second_start_tcb != null {
            registered_second = toka_task_register_cancel_child(*coro_handle, *second_start_tcb) != 0
        }
        if !registered_first || !registered_second {
            assert(false, "Cancellation-child registration failed in race2")
        }
        if *first_start_tcb != null {
            toka_task_start(*first_start_tcb)
        }
        if *second_start_tcb != null {
            toka_task_start(*second_start_tcb)
        }

        toka_task_commit_suspend(*coro_handle)
    }

    __builtin_coro_suspend()

    // Check which slot won
    auto winner1 = toka_wait_registry_is_winner(id1, gen1) != 0

    if winner1 {
        // First task won: cancel second task
        task_cancel<'T2>(owned_second)
        auto *second_tcb = task_get_coro_handle<'T2>(owned_second)
        if *second_tcb != null {
            toka_task_retain(*second_tcb)
            loop !toka_tcb_is_done(*second_tcb) {
                sleep_async(1).await
            }
            toka_task_release(*second_tcb)
        }
        auto *first_cleanup_tcb = task_get_coro_handle<'T1>(owned_first)
        auto *second_cleanup_tcb = task_get_coro_handle<'T2>(owned_second)
        if *first_cleanup_tcb != null {
            toka_task_unregister_cancel_child(*coro_handle, *first_cleanup_tcb)
        }
        if *second_cleanup_tcb != null {
            toka_task_unregister_cancel_child(*coro_handle, *second_cleanup_tcb)
        }
        toka_wait_registry_release(id1, gen1)
        toka_wait_registry_release(id2, gen2)
        auto res1 = owned_first.await
        return RaceWinner<'T1, 'T2>::First(cede res1)
    } else {
        // Second task won: cancel first task
        task_cancel<'T1>(owned_first)
        auto *first_tcb = task_get_coro_handle<'T1>(owned_first)
        if *first_tcb != null {
            toka_task_retain(*first_tcb)
            loop !toka_tcb_is_done(*first_tcb) {
                sleep_async(1).await
            }
            toka_task_release(*first_tcb)
        }
        auto *first_cleanup_tcb = task_get_coro_handle<'T1>(owned_first)
        auto *second_cleanup_tcb = task_get_coro_handle<'T2>(owned_second)
        if *first_cleanup_tcb != null {
            toka_task_unregister_cancel_child(*coro_handle, *first_cleanup_tcb)
        }
        if *second_cleanup_tcb != null {
            toka_task_unregister_cancel_child(*coro_handle, *second_cleanup_tcb)
        }
        toka_wait_registry_release(id1, gen1)
        toka_wait_registry_release(id2, gen2)
        auto res2 = owned_second.await
        return RaceWinner<'T1, 'T2>::Second(cede res2)
    }
}

pub shape TaskRef (
    *#tcb: void
)

impl TaskRef@encap {
    pub tcb
    fn drop(self#) {
        if self.*tcb != null {
            toka_task_release(self.*tcb)
            self.*tcb = null as *void
        }
    }

}

// Retaining the task-control block creates a second owning reference and is
// therefore an explicit duplication capability, never an implicit copy.
impl TaskRef@Dup {
    pub fn dup(self) -> TaskRef {
        if self.*tcb != null {
            toka_task_retain(self.*tcb)
        }
        return TaskRef(*tcb = self.*tcb)
    }
}

pub fn task_ref_from_handle<'T>(cede handle: TaskHandle<'T>) -> TaskRef {
    auto owned# = cede handle
    auto *tcb_ptr = task_get_coro_handle<'T>(owned)
    if *tcb_ptr != null as *void {
        toka_task_retain(*tcb_ptr)
        return TaskRef(*tcb = *tcb_ptr)
    }
    return TaskRef(*tcb = null as *void)
}

impl TaskRef {
    pub fn from_handle<'T>(cede handle: TaskHandle<'T>) -> TaskRef {
        return task_ref_from_handle<'T>(cede handle)
    }

    pub fn is_done(self) -> bool {
        if self.*tcb != null {
            return toka_tcb_is_done(self.*tcb)
        }
        return true
    }

    pub fn request_cancel(self) {
        if self.*tcb != null {
            toka_task_request_cancel(self.*tcb)
        }
    }

    pub fn release(self#) {
        if self.*tcb != null {
            toka_task_release(self.*tcb)
            self.*tcb = null as *void
        }
    }
}

pub shape TaskScope (
    refs: Vec<TaskRef>
)

impl TaskScope {
    pub fn new() -> TaskScope {
        return TaskScope(refs = Vec<TaskRef>::new())
    }

    pub fn track_ref(self#, cede tr: TaskRef) {
        if tr.*tcb != null as *void {
            toka_task_start(tr.*tcb)
        }
        self.refs#.push(cede tr)
    }

    pub fn track<'T>(self#, cede handle: TaskHandle<'T>) {
        auto tr = task_ref_from_handle<'T>(cede handle)
        if tr.*tcb != null as *void {
            toka_task_start(tr.*tcb)
        }
        self.refs#.push(cede tr)
    }

    pub fn cancel_all(self#) {
        auto i# = 0:usize
        loop i < self.refs.len() {
            auto tr = self.refs.get(i)
            tr.request_cancel()
            i += 1
        }
    }

    pub fn is_done(self) -> bool {
        auto i# = 0:usize
        loop i < self.refs.len() {
            auto tr = self.refs.get(i)
            if !tr.is_done() {
                return false
            }
            i += 1
        }
        return true
    }

    // Release completed task references during long-lived service operation.
    // Pending tasks stay tracked for later cancellation and join.  The vector
    // order is not semantically observable by TaskScope.
    pub fn reap_finished(self#) -> usize {
        auto live# = Vec<TaskRef>::new()
        auto reaped# = 0:usize
        loop self.refs.len() > 0:usize {
            auto tr# = self.refs#.pop().unwrap()
            if tr.is_done() {
                tr#.release()
                reaped += 1
            } else {
                live#.push(cede tr)
            }
        }
        self.refs = cede live
        return reaped
    }

    pub fn join_async(self#) -> async void {
        loop !self.is_done() {
            sleep_async(1:i32).await
        }
    }

    // Returns true when every task completed during the drain window.  A
    // timeout requests cancellation only after the normal drain has elapsed,
    // then joins every retained task before returning false.
    pub fn shutdown_async(self#, drain_timeout_ms: i32) -> async bool {
        auto deadline = current_time_ms() + (drain_timeout_ms as i64)
        loop !self.is_done() {
            if drain_timeout_ms <= 0:i32 || current_time_ms() >= deadline {
                self#.cancel_all()
                self#.join_async().await
                return false
            }
            sleep_async(1:i32).await
        }
        return true
    }

    pub fn close(cede self) -> async void {
        auto scope# = cede self
        scope#.cancel_all()
        scope#.join_async().await
    }
}

// Consume a typed task into a scope without exposing its TCB or requiring the
// caller to name its result type. Generic deduction recovers 'T from the
// TaskHandle wrapper at this call boundary.
pub fn spawn_into<'T>(scope#: TaskScope, cede task: TaskHandle<'T>) {
    scope#.track_ref(cede task_ref_from_handle<'T>(cede task))
}
